# OpenAI-compatible chat-completions provider used by ChatOpenAI.
AGENT_LLM_BASE_URL=http://127.0.0.1:15721/v1
AGENT_LLM_API_KEY=replace-me
AGENT_LLM_MODEL=replace-me

# SiliconFlow embeddings；不与 AGENT_LLM_* 共用
AGENT_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AGENT_EMBEDDING_API_KEY=replace-with-siliconflow-api-key
AGENT_EMBEDDING_MODEL=BAAI/bge-m3
AGENT_EMBEDDING_BATCH_SIZE=16
AGENT_EMBEDDING_CONCURRENCY=8
AGENT_EMBEDDING_TIMEOUT=8
AGENT_EMBEDDING_RETRIES=1
# AGENT_VECTOR_ROOT=C:/path/to/output/assets/knowledge/embeddings

# Server defaults.
AGENT_HOST=127.0.0.1
AGENT_PORT=8123
AGENT_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# Optional. Defaults to apps/agent-ui/.cache and must remain outside source data.
# AGENT_CACHE_DIR=C:/path/to/project/apps/agent-ui/.cache
