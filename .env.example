# Copy these values into your shell environment or a private local launcher.
# Do not commit a real database password.
SHIXING_MYSQL_HOST=127.0.0.1
SHIXING_MYSQL_PORT=3306
SHIXING_MYSQL_USER=root
SHIXING_MYSQL_PASSWORD=replace-with-local-password
SHIXING_MYSQL_DATABASE=shixing_wanli

# Optional OpenAI-compatible endpoint for evidence-only background extraction.
# Keep the real key in your private shell environment.
BACKGROUND_LLM_BASE_URL=https://api.deepseek.com
BACKGROUND_LLM_API_KEY=replace-with-private-api-key
BACKGROUND_LLM_MODEL=deepseek-v4-flash

# Agent UI + 诗词知识库的可选 OpenAI-compatible 模型。
# 未配置时仍可构建和检索本地 rules 基线；不要提交真实密钥。
AGENT_LLM_BASE_URL=https://PROVIDER.example/v1
AGENT_LLM_API_KEY=replace-with-private-api-key
AGENT_LLM_MODEL=replace-with-chat-model

# 可选；默认为 output/assets/knowledge/poetry_knowledge.sqlite3
AGENT_KB_PATH=

# SiliconFlow embeddings（与聊天模型配置分离；密钥只放本地环境变量）
AGENT_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AGENT_EMBEDDING_API_KEY=replace-with-siliconflow-api-key
AGENT_EMBEDDING_MODEL=BAAI/bge-m3
AGENT_EMBEDDING_BATCH_SIZE=16
AGENT_EMBEDDING_CONCURRENCY=8
AGENT_EMBEDDING_TIMEOUT=8
AGENT_EMBEDDING_RETRIES=1
# 可选；默认 output/assets/knowledge/embeddings
AGENT_VECTOR_ROOT=
