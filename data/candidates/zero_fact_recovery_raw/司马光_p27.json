{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":81382,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"次韵和韩子华寒食休沐与诸公同会赵令园暮归马上偶成"},"Clauses":[{"Content":"冠盖连翩陌上来，"},{"Content":"风光烂漫拥楼台。"},{"Content":"玉卮贮酒随宜饮，"},{"Content":"绮席寻花触处开。"},{"Content":"小雨前宵先拨火，"},{"Content":"季春明日又吹灰。"},{"Content":"须知胜集人间少，"},{"Content":"惆怅金羁容易回。"}]},{"Id":80913,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"和吴仲庶寄吴瑛比部安道之子壮年致政归隐蕲春"},"Clauses":[{"Content":"负米承亲愿已赊，","Comments":[{"Content":"自注：遭母忧，服除，遂致仕。","Type":"Text","Index":7}]},{"Content":"耻随鸡鹜啄泥沙。"},{"Content":"一朝投绂真高士，"},{"Content":"万卷藏书旧世家。"},{"Content":"齿发未衰非药物，"},{"Content":"山林不返为云霞。"},{"Content":"庞眉尚有郎潜者，"},{"Content":"徇禄忧生直可嗟。"}]},{"Id":80865,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"苏才翁子美有赠扶沟白鹤观黄道士诗纪于屋壁岁久漫灭今县宰周同年得完本于民间抵予求诗"},"Clauses":[{"Content":"潦倒黄冠无足论，"},{"Content":"白头嗜酒住荒村。"},{"Content":"狂名偶为留诗著，"},{"Content":"陈迹仍因好事存。"},{"Content":"金石锵洋虚殿寂，"},{"Content":"龙蛇洒落古墙昏。"},{"Content":"飞黄灭没浮云外，"},{"Content":"疲马何能望骏奔。"}]},{"Id":80955,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"和景仁琼林席上偶成","Comments":[{"Content":"时康与禹玉、景仁、次道之子同时登科，在席","Type":"Text","Index":9}]},"Clauses":[{"Content":"念昔琼林赐宴归，"},{"Content":"䌽衣绿绶正相宜。"},{"Content":"将雏虽复慰心喜，"},{"Content":"负米翻成触目悲。"},{"Content":"殿角花犹红胜火，"},{"Content":"樽前发自白如丝。"},{"Content":"桂林衰朽何须恨，"},{"Content":"幸有新枝续旧枝。"}]},{"Id":80780,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"文","Title":{"Content":"长安送李尧夫同年"},"Clauses":[{"Content":"昔岁琼林花气曛，"},{"Content":"今朝长乐柳梢春。"},{"Content":"事随流水滔滔度，"},{"Content":"鬓结繁霜戢戢新。"},{"Content":"世路饱谙都是梦，"},{"Content":"人生可贵莫如身。"},{"Content":"会须筑室临清洛，"},{"Content":"相与携筇戴葛巾。"}]},{"Id":80848,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"初到洛中书怀"},"Clauses":[{"Content":"三十馀年西复东，"},{"Content":"劳生薄宦等飞蓬。"},{"Content":"所存旧业惟清白，"},{"Content":"不负明君有朴忠。"},{"Content":"早避喧烦真得策，"},{"Content":"未逢危辱好收功。"},{"Content":"太平触处农桑满，"},{"Content":"赢取闾阎鹤发翁。"}]},{"Id":81454,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"12","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"和邵尧夫秋霁登石阁"},"Clauses":[{"Content":"飞檐危槛出林端，"},{"Content":"王屋嵩丘咫尺间。"},{"Content":"独爱高明游佛阁，"},{"Content":"岂知忧喜满尘寰。"},{"Content":"目穷莽苍纤毫尽，"},{"Content":"身得逍遥万象闲。"},{"Content":"暇日登临无厌数，"},{"Content":"悲风残叶已珊珊。","Comments":[{"Content":"自注：先生冬夏俱不出。","Type":"Text","Index":7}]}]},{"Id":80933,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"和邵尧夫年老逢春"},"Clauses":[{"Content":"年老逢春春莫咍，"},{"Content":"朱颜不肯似春回。"},{"Content":"酒因多病无心醉，"},{"Content":"花不解愁随意开。"},{"Content":"荒径倦游从碧草，"},{"Content":"空庭慵扫自苍苔。"},{"Content":"相逢谈笑犹能在，"},{"Content":"坐待牵车陌上来。"}]},{"Id":80944,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"和范景仁谢寄西游行记"},"Clauses":[{"Content":"洛川秦野郁相望，"},{"Content":"风物山河旧帝乡。"},{"Content":"涧底逢人问樵径，"},{"Content":"松间系马宿僧房。"},{"Content":"恨无同好携三雅，"},{"Content":"共讲前闻醉百场。","Comments":[{"Content":"自注：李白诗：痛扫鹦鹉洲，与君醉百场。","Type":"Text","Index":7}]},{"Content":"历遍胜游翻怅望，"},{"Content":"日边回首远烟苍。"}]},{"Id":80943,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"和范景仁谢寄西游行记"},"Clauses":[{"Content":"八水三川路渺茫，"},{"Content":"翠微深处白云乡。"},{"Content":"目■懒拭如松液，","Comments":[{"Content":"嗤口=目","Type":"Text","Index":2}]},{"Content":"领发频抓似栗房。"},{"Content":"林壑不嫌无用物，"},{"Content":"形骸难入少年场。"},{"Content":"缘苔蹑蔓知多少，"},{"Content":"千里归来屐齿苍。"}]},{"Id":80814,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"再和邵尧夫年老逢春"},"Clauses":[{"Content":"年老逢春犹解狂，"},{"Content":"行歌南陌上东冈。"},{"Content":"晴云高鸟各自得，"},{"Content":"白日游丝相与长。"},{"Content":"草色无情尽眼绿，"},{"Content":"花林多思袭人香。"},{"Content":"吾侪幸免簪裾累，"},{"Content":"痛饮闲吟乐未央。"}]},{"Id":80745,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"又和来韵"},"Clauses":[{"Content":"年老逢春无用惊，"},{"Content":"对花弄笔眼犹明。"},{"Content":"不嫌贫舍旧来燕，"},{"Content":"唤起醉眠何处莺。"},{"Content":"一仆相随幅巾出，"},{"Content":"群童聚看小车行。"},{"Content":"人间万事都损去，"},{"Content":"莫遣胸中气不平。"}]},{"Id":80932,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"和邵尧夫安乐窝中职事吟"},"Clauses":[{"Content":"灵台无事日休休，"},{"Content":"安乐由来不外求。"},{"Content":"细雨寒风宜独坐，"},{"Content":"暖天佳景即闲游。"},{"Content":"松篁亦足开青眼，"},{"Content":"桃李何妨插白头。"},{"Content":"我以著书为职业，"},{"Content":"为君偷暇上高楼。"}]},{"Id":80952,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"和景仁卜居许下","Comments":[{"Content":"景仁顷见许居洛，今而倍之，故诗中颇致其怨","Type":"Text","Index":7}]},"Clauses":[{"Content":"壮齿相知约岁寒，"},{"Content":"索居今日鬓俱斑。"},{"Content":"拂衣已解虞卿印，"},{"Content":"筑室何须谢傅山。"},{"Content":"许下田园虽有素，"},{"Content":"洛中花卉足供闲。"},{"Content":"他年决意归何处，"},{"Content":"便见交情厚薄间。"}]},{"Id":80968,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"奉同运使陈殿丞惜洛阳牡丹为霜风所损","Comments":[{"Content":"知俭，字公廙","Type":"Text","Index":7}]},"Clauses":[{"Content":"名花多种欲纷敷，"},{"Content":"一夕霜风非所虞。"},{"Content":"节物偶然何足道，"},{"Content":"人情遗恨不能无。"},{"Content":"飘飖健笔诗千首，"},{"Content":"惆怅东风酒百壶。"},{"Content":"纵使前春满朱槛，"},{"Content":"使车那复滞西都。"}]},{"Id":80867,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"还陈殿丞原人论","Comments":[{"Content":"宗密所撰，破自然、破元气、破天命、明佛性","Type":"Text","Index":7}]},"Clauses":[{"Content":"品物芸芸游太虚，"},{"Content":"不知谁氏宰洪炉。"},{"Content":"一株花落分荣辱，"},{"Content":"万窍风号见有无。"},{"Content":"觉后共占犹是梦，"},{"Content":"衣中所得亦非珠。"},{"Content":"何如鼓瑟浴沂水，"},{"Content":"春服成时咏舞雩。"}]},{"Id":81419,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"和王秀才以光始自陜右游山归复将登少室为诗见寄","Comments":[{"Content":"虞仲，字道济","Type":"Text","Index":4}]},"Clauses":[{"Content":"瘦马飘飖屡往还，"},{"Content":"疲劳专为访名山。"},{"Content":"须知筋力行将老，"},{"Content":"渐恐峰峦不可攀。"},{"Content":"蜡屐早能寻胜概，"},{"Content":"弹冠悔更落尘寰。"},{"Content":"幸依贤者为东道，"},{"Content":"大得逍遥水石间。","Comments":[{"Content":"自注：道济居缑氏。","Type":"Text","Index":7}]}]},{"Id":80974,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"和景仁西湖泛舟"},"Clauses":[{"Content":"满船歌吹拂春湾，"},{"Content":"天外晴霞水底斑。"},{"Content":"谁信飞觞临绮席，"},{"Content":"独能回首望青山。"},{"Content":"东门车马匆匆别，"},{"Content":"西洛风烟寂寂闲。"},{"Content":"叠石溪头应更好，"},{"Content":"却输野叟坐林间。"}]},{"Id":81230,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"新买叠石溪庄再用前韵招景仁"},"Clauses":[{"Content":"一溪清水佩声寒，"},{"Content":"两岸莓苔锦绣斑。"},{"Content":"三径谁来卜邻舍，"},{"Content":"千峰我已作家山。"},{"Content":"鹿裘藜杖偏宜老，"},{"Content":"紫陌红尘不称闲。"},{"Content":"早挈琴书远相就，"},{"Content":"放歌烂醉白云间。"}]},{"Id":80897,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"和宇文公南涂中见寄"},"Clauses":[{"Content":"骢马乌纱游洛尘，"},{"Content":"未能全得自由身。"},{"Content":"深惭白首恋微禄，"},{"Content":"不向青山为散人。"},{"Content":"斥鴳卑飞聊取适，"},{"Content":"冥鸿高举益难亲。"},{"Content":"蜀都迢递千馀里，"},{"Content":"徒诵新诗妙入神。"}]}],"Count":1270,"PageNo":27,"PageSize":20}