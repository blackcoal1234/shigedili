{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80818,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"同宋次道陪宴琼林","Comments":[{"Content":"校勘宋敏求","Type":"Text","Index":8}]},"Clauses":[{"Content":"冠盖连翩数里尘，"},{"Content":"帝家全借上林春。"},{"Content":"鹓行不动烟霞秀，"},{"Content":"龙角正高雷雨新。"},{"Content":"喜气晴曛宫树绿，"},{"Content":"飞花醉堕玉卮频。"},{"Content":"蒲萄卢橘应相识，"},{"Content":"半是当年举酒人。","Comments":[{"Content":"自注：是日，在席同年七人。","Type":"Text","Index":7}]}]},{"Id":80754,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"子高有徐浩诗碑昌言借摹其文甫及数本石有微衅惧而归之子高答简有碎珊瑚之戏昌言以诗赠子高同舍皆和","Comments":[{"Content":"司谏钱彦远","Type":"Text","Index":46}]},"Clauses":[{"Content":"徐公精笔老生神，"},{"Content":"石刻犹能妙夺真。"},{"Content":"几为通书翻丧宝，"},{"Content":"愈令好事惜传人。"},{"Content":"锋铓半折犹能健，"},{"Content":"圭璧微瑕自足珍。"},{"Content":"直使尽随如意碎，"},{"Content":"石家玉树未全贫。","Comments":[{"Content":"自注：昌言家图书所收最多。","Type":"Text","Index":7}]}]},{"Id":81051,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"送冲卿通判河中府","Comments":[{"Content":"校理吴充","Type":"Text","Index":8}]},"Clauses":[{"Content":"闻道名都行有期，"},{"Content":"依然想见昔游时。"},{"Content":"寒光一曲秋河转，"},{"Content":"翠岭三条夕照移。"},{"Content":"孤竹旧风民有让，","Comments":[{"Content":"原缺，据陈本、四库本补","Type":"Text","Index":4}]},{"Content":"重华馀教俗无疵。"},{"Content":"不须到日方登历，"},{"Content":"已在君家十二诗。"}]},{"Id":81166,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"寄题李舍人蒲中新斋","Comments":[{"Content":"伟","Type":"Text","Index":5}]},"Clauses":[{"Content":"陇上家声勇气殊，"},{"Content":"边庭卧鼓欲安居。"},{"Content":"非同王剪私求宅，"},{"Content":"更似甘宁晚好书。"},{"Content":"剑倚寒窗风淅沥，"},{"Content":"门无杂客柳萧疏。"},{"Content":"蒲州风土平生爱，"},{"Content":"为问旁邻地有馀。"}]},{"Id":81083,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"送沈寺丞知南昌县","Comments":[{"Content":"绅","Type":"Text","Index":4},{"Content":"字公仪","Type":"Text","Index":8}]},"Clauses":[{"Content":"长江湛湛带枫林，"},{"Content":"古木寒云县寺深。"},{"Content":"老吏不能容狡狯，"},{"Content":"细民无复有冤侵。"},{"Content":"洪崖丹井闻犹在，"},{"Content":"徐孺衡门说可寻。"},{"Content":"宁复淹留如宝剑，"},{"Content":"更令牛斗气沈沈。"}]},{"Id":80960,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"和道粹雪夜直宿","Comments":[{"Content":"检讨王纯臣","Type":"Text","Index":3}]},"Clauses":[{"Content":"天禄凝严近紫台，"},{"Content":"书帏夜对雪华开。"},{"Content":"层楼直倚寒空出，"},{"Content":"清漏还从深殿来。"},{"Content":"薄梦不成冰柱折，"},{"Content":"晓光先到玉花催。"},{"Content":"兔园终是诸侯事，"},{"Content":"虚费相如能赋才。"}]},{"Id":80902,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"和次道大庆殿上元迎驾"},"Clauses":[{"Content":"凤律年华到尚新，"},{"Content":"九重气象已成春。"},{"Content":"晓云低拂羽林仗，"},{"Content":"宿雨先清紫陌尘。"},{"Content":"玉殿鸣鞘传警跸，"},{"Content":"彤庭委佩集簪绅。"},{"Content":"阙前无复鱼龙戏，"},{"Content":"自有驩谣亿万人。"}]},{"Id":81103,"Classes":["軍旅 戍守","軍旅 送行","軍旅 出鎮"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"送茹屯田知无为军","Comments":[{"Content":"孝标","Type":"Text","Index":4}]},"Clauses":[{"Content":"叠鼓鸣铙迎候新，"},{"Content":"军牙孑孑倚淮津。"},{"Content":"聊应衣绣过乡曲，"},{"Content":"不作引章惊故人。"},{"Content":"荻迸短芽淝水暖，"},{"Content":"荷浮圆叶漅湖春。"},{"Content":"使君此去荣多少，"},{"Content":"犹是当年书剑身。"}]},{"Id":80777,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"田横墓","Comments":[{"Content":"偃师西","Type":"Text","Index":3}]},"Clauses":[{"Content":"昔时南面并称孤，"},{"Content":"今日还为绛灌徒。"},{"Content":"忍死祗能添屈辱，"},{"Content":"偷生不足爱须臾。"},{"Content":"一朝从殉倾群客，"},{"Content":"千古生风激懦夫。"},{"Content":"直使强颜臣汉帝，"},{"Content":"韩彭未必免同诛。"}]},{"Id":80935,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"和国子夏主簿李花","Comments":[{"Content":"有章","Type":"Text","Index":8}]},"Clauses":[{"Content":"儒宫岑寂觉春闲，"},{"Content":"仙李繁花重压栏。"},{"Content":"碎锦不飞蒙树合，"},{"Content":"素云攲亚举枝难。"},{"Content":"能诗此日当推谢，"},{"Content":"捧赐他年足继桓。"},{"Content":"更约雕盘荐秋实，"},{"Content":"岂徒秾艳一朝看。"}]},{"Id":81453,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"Title":{"Content":"和邵兴宗秋夜学舍宿直"},"Clauses":[{"Content":"直舍逍遥度清夜，"},{"Content":"暂投逢掖解儒冠。"},{"Content":"高楼影背星河转，"},{"Content":"疏竹气兼风露寒。"},{"Content":"篱下黄花新蕊乱，"},{"Content":"门边碧柳旧株残。"},{"Content":"折腰把板今无有，"},{"Content":"勿似陶潜遂弃官。"}]},{"Id":80778,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"月下小饮"},"Clauses":[{"Content":"美景赏心相值难，"},{"Content":"良宵四座尽儒冠。"},{"Content":"月华过冷衣襟润，"},{"Content":"酒力易消樽俎寒。"},{"Content":"自有笑谈供逸气，"},{"Content":"不须丝竹借馀欢。"},{"Content":"坊楼五鼓欲催曙，"},{"Content":"桂影长先高兴阑。"}]},{"Id":81548,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"送王太祝知伊阙","Comments":[{"Content":"豫","Type":"Text","Index":4}]},"Clauses":[{"Content":"百里驩迎新令贤，"},{"Content":"儒经吏术尽家传。"},{"Content":"天开岭阜竦双阙，"},{"Content":"地杂桑麻隘一川。"},{"Content":"锦雉驯飞春陌上，"},{"Content":"雪凫高去夕岚边。"},{"Content":"长才久屈君无限，"},{"Content":"所惜斯民受赐偏。"}]},{"Id":81139,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"留别逢吉"},"Clauses":[{"Content":"君念承明臭味稀，"},{"Content":"相逢惜别重依依。"},{"Content":"会稽太守方坐啸，"},{"Content":"东郭先生还步归。","Comments":[{"Content":"自注：严助、朱买臣皆为会稽守。东郭先生，孝武时待诏公车。","Type":"Text","Index":7}]},{"Content":"乐饮林塘留节物，"},{"Content":"饯行里舍动光辉。"},{"Content":"双旌回去行人发，"},{"Content":"一带长皋烟雨微。"}]},{"Id":81076,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"青","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"送张秘校知分宁","Comments":[{"Content":"献臣父","Type":"Text","Index":7}]},"Clauses":[{"Content":"百里大夫官不轻，"},{"Content":"莫嗟领上发垂星。"},{"Content":"人生谷禄偏宜晚，"},{"Content":"世路艰难不厌经。"},{"Content":"数曲秋江萦县白，"},{"Content":"几峰霁色入帘青。"},{"Content":"于公向日多阴德，"},{"Content":"已有鹓雏在帝庭。"}]},{"Id":81236,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"酬师道雪夜见寄"},"Clauses":[{"Content":"玉树交横雪后天，"},{"Content":"银河沉着斗栏干。"},{"Content":"笔峰微结冰丝涩，"},{"Content":"灯晕初成花烬残。"},{"Content":"太学先生毡苦薄，"},{"Content":"公车倦客履仍单。"},{"Content":"欲吟佳句到清晓，"},{"Content":"夜寂愁闻金石寒。"}]},{"Id":81082,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"送杨秘丞通判扬州","Comments":[{"Content":"秉","Type":"Text","Index":4}]},"Clauses":[{"Content":"苦闻小杜说扬都，"},{"Content":"当昔豪华今在无。"},{"Content":"江势横来控南楚，"},{"Content":"地形前不瞰东吴。"},{"Content":"万商落日船交尾，"},{"Content":"一市春风酒并垆。"},{"Content":"得意莫忘京国友，"},{"Content":"踏尘冲雪奉朝趋。","Comments":[{"Content":"原作满，据陈本、四库本改","Type":"Text","Index":1}]}]},{"Id":81050,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"送光禄王卿致仕归荆南","Comments":[{"Content":"周","Type":"Text","Index":5}]},"Clauses":[{"Content":"九列谁云非显涂，"},{"Content":"人生已不负为儒。"},{"Content":"拂衣长揖夔龙贵，"},{"Content":"散发还为黄绮徒。"},{"Content":"白鹤归飞心自远，"},{"Content":"青霞高举势何孤。"},{"Content":"千金尽与乡人费，"},{"Content":"不向江头买木奴。"}]},{"Id":80886,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"和子渊除夜"},"Clauses":[{"Content":"缇室重飞玉琯灰，"},{"Content":"物华全与斗杓回。"},{"Content":"依依残腊无情别，"},{"Content":"历历新春满眼来。"},{"Content":"强取酒卮浮翠柏，"},{"Content":"懒开粽叶觅杨梅。"},{"Content":"男儿努力平生志，","Comments":[{"Content":"原作主，据陈本、四库本改","Type":"Text","Index":6}]},{"Content":"肯使功名落草莱。"}]},{"Id":80885,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"齐","Rank":0,"FirstClauseRhyme":"齐","Title":{"Content":"和子渊元夕"},"Clauses":[{"Content":"神岳嶕峣阙角齐，"},{"Content":"银蟾无影玉绳低。"},{"Content":"风传丝管交加发，"},{"Content":"灯滉星河上下迷。"},{"Content":"清醴横飞金凿落，"},{"Content":"香尘不染锦障泥。"},{"Content":"谁知此夕斋祠客，"},{"Content":"近在宫城槐柳西。"}]}],"Count":1270,"PageNo":24,"PageSize":20}