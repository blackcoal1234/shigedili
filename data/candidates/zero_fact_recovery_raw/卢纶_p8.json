{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11317,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"晚次新丰北野老家书事呈赠韩质明府"},"Clauses":[{"Content":"机鸣舂响日暾暾，"},{"Content":"鸡犬相和汉古村。"},{"Content":"数派清泉黄菊盛，"},{"Content":"一林寒露紫梨繁。"},{"Content":"衰翁正席矜新社，"},{"Content":"稚子齐襟读古论。"},{"Content":"共说年来但无事，"},{"Content":"不知何者是君恩。"}]},{"Id":11224,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"春日卧病示赵季黄","Comments":[{"Content":"时陷在贼中","Type":"Text","Index":8}]},"Clauses":[{"Content":"病中饶泪眼常昏，"},{"Content":"闻说花开亦闭门。"},{"Content":"语少渐知琴思苦，"},{"Content":"卧多唯觉鸟声喧。"},{"Content":"黄埃满市图书贱，"},{"Content":"黑雾连山虎豹尊。"},{"Content":"今日支离顾形影，"},{"Content":"向君凡在几重恩。"}]},{"Id":11232,"Allusions":[{"AllusionIndex":8580,"AllusionKey":"王粲","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"秋中过独孤郊居","Comments":[{"Content":"即公主子","Type":"Text","Index":7}]},"Clauses":[{"Content":"开园过水到郊居，","Comments":[{"Content":"一作闲","Type":"Text","Index":1}]},{"Content":"共引家童拾野蔬。"},{"Content":"高树夕阳连古巷，"},{"Content":"菊花梨叶满荒渠。"},{"Content":"秋山近处行过寺，"},{"Content":"夜雨寒时起读书。"},{"Content":"帝里诸亲别来久，"},{"Content":"岂知王粲爱樵渔。","Comments":[{"Content":"王粲","Type":"AllusionKey","Index":4}]}]},{"Id":11227,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"春日题杜叟山下别业"},"Clauses":[{"Content":"白鸟群飞山半晴，"},{"Content":"渚田相接有泉声。"},{"Content":"园中晓露青丛合，"},{"Content":"桥上春风绿野明。"},{"Content":"云影断来峰影出，"},{"Content":"林花落尽草花生。"},{"Content":"今朝醉舞同君乐，"},{"Content":"始信幽人不爱荣。"}]},{"Id":11343,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"题贾山人园林"},"Clauses":[{"Content":"竹影朦胧松影长，"},{"Content":"素琴清簟好风凉。"},{"Content":"连春诗会烟花满，"},{"Content":"半夜酒醒兰蕙香。"},{"Content":"五字每将称玉友，"},{"Content":"一尊曾不顾金囊。"},{"Content":"长沙流谪君非远，"},{"Content":"莫遣英名负洛阳。"}]},{"Id":11166,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"九日奉陪侍郎登白楼","Comments":[{"Content":"一作陪浑侍中","Type":"Text","Index":6}]},"Clauses":[{"Content":"碧霄孤鹤发清音，"},{"Content":"上宰因添望阙心。"},{"Content":"睥睨三层连步障，"},{"Content":"茱萸一朵映华簪。"},{"Content":"红霞似绮河如带，"},{"Content":"白露团珠菊散金。"},{"Content":"此日所从何所问，"},{"Content":"俨然冠剑拥成林。","Comments":[{"Content":"一作盖","Type":"Text","Index":4}]}]},{"Id":11226,"Allusions":[{"AllusionIndex":214,"AllusionKey":"獬豸冠","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"春日喜雨奉和马侍中宴白楼"},"Clauses":[{"Content":"鹳鹤相呼绿野宽，"},{"Content":"鼎臣闲倚玉栏干。"},{"Content":"洪河拥沫流仍急，"},{"Content":"苍岭和云色更寒。"},{"Content":"艳艳风光呈瑞岁，"},{"Content":"泠泠歌颂振雕盘。"},{"Content":"今朝醉舞共乡老，","Comments":[{"Content":"一作同","Type":"Text","Index":5}]},{"Content":"不觉倾欹獬豸冠。","Comments":[{"Content":"一作频","Type":"Text","Index":3},{"Content":"一作斜","Type":"Text","Index":4},{"Content":"獬豸冠","Type":"AllusionKey","Index":7}]}]},{"Id":11338,"Allusions":[{"AllusionIndex":4040,"AllusionKey":"壶中","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"题天华观"},"Clauses":[{"Content":"峰嶂徘徊霞景新，"},{"Content":"一潭寒水绝纤鳞。"},{"Content":"朱字灵书千万轴，","Comments":[{"Content":"一作卷","Type":"Text","Index":7}]},{"Content":"苍髯道士两三人。"},{"Content":"芝童解说壶中事，","Comments":[{"Content":"壶中","Type":"AllusionKey","Index":6}]},{"Content":"玉管能留天上春。"},{"Content":"眼见仙丹求不得，"},{"Content":"汉家簪绂在羸身。","Comments":[{"Content":"一作绶","Type":"Text","Index":4}]}]},{"Id":11310,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"青","Title":{"Content":"宿石瓮寺"},"Clauses":[{"Content":"殿有寒灯草有萤，"},{"Content":"千林万壑寂无声。"},{"Content":"烟凝积水龙蛇蛰，"},{"Content":"露湿空山星汉明。"},{"Content":"昏霭雾中悲世界，"},{"Content":"曙霞光里见王城。"},{"Content":"回瞻相好因垂泪，"},{"Content":"苦海波涛何日平。"}]},{"Id":11178,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"同王员外雨后登开元寺南楼因寄西岩警上人","Comments":[{"Content":"一作䛒","Type":"Text","Index":17}]},"Clauses":[{"Content":"过雨开楼看晚虹，"},{"Content":"白云相逐水相通。"},{"Content":"寒蝉噪暮野无日，"},{"Content":"古树伤秋天有风。"},{"Content":"数穗远烟凝垄上，"},{"Content":"一枝繁果忆山中。"},{"Content":"何言暂别东林友，"},{"Content":"惆怅人间事不同。"}]},{"Id":11181,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"同赵进马元阳春日登长春宫古城望河中因寄郑损仓曹","Comments":[{"Content":"损，进马之舅。","Type":"Text","Index":23}]},"Clauses":[{"Content":"城头春霭晓濛濛，"},{"Content":"指望关桥满袖风。"},{"Content":"云骑闲嘶宫柳外，"},{"Content":"玉人愁立草花中。"},{"Content":"钟分寺路山光绿，"},{"Content":"河绕军州日气红。"},{"Content":"迹忝已成方恋赏，","Comments":[{"Content":"一本此二字缺","Type":"Text","Index":4}]},{"Content":"此时离恨与君同。"}]},{"Id":11172,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"长安春望"},"Clauses":[{"Content":"东风吹雨过青山，"},{"Content":"却望千门草色闲。","Comments":[{"Content":"一作柳","Type":"Text","Index":5}]},{"Content":"家在梦中何日到，"},{"Content":"春生江上几人还。","Comments":[{"Content":"一作归，又作来","Type":"Text","Index":2}]},{"Content":"川原缭绕浮云外，"},{"Content":"宫阙参差落照间。"},{"Content":"谁念为儒逢世难，","Comments":[{"Content":"一作多失意","Type":"Text","Index":7}]},{"Content":"独将衰鬓客秦关。"}],"Comments":[{"Book":"《瀛奎律髓》","Content":"能言久客都城之意。","IsComment":false,"FullPath":"《瀛奎律髓》"},{"Book":"《唐诗品汇》","Content":"刘云：三、四自在。","IsComment":false,"FullPath":"《唐诗品汇》"},{"Book":"《批点唐音》","Content":"中唐中宽徐者（首二句下）。","IsComment":false,"FullPath":"《批点唐音》"},{"Book":"《唐诗解》","Content":"此长安遭吐蕃之乱，代宗幸陕，纶时在京而作。","IsComment":false,"FullPath":"《唐诗解》"},{"Book":"《唐诗训解》","Content":"伤乱之意，溢于言外。","IsComment":false,"FullPath":"《唐诗训解》"},{"Book":"《唐诗镜》","Content":"三、四语，初盛人不出。此岑参“愁窥白发羞微禄，悔别青山忆故蹊”，隐隐已开大历之渐。","IsComment":false,"FullPath":"《唐诗镜》"},{"Book":"《唐诗选》","Content":"以淡致胜。","IsComment":false,"FullPath":"《唐诗选》"},{"Book":"《唐诗选脉会通评林》","Content":"何新之列此诗为“奇隽体”。周敬曰：起得自在，颔联情妙。王子安诗“山川云雾里，游子几时还”，何如此二句有言不尽意之巧！唐汝询曰：首联与右丞“秋槐”之句一般凄楚。“浮云”、“落照”，意甚不浅。周珽曰：无意求工，自能追雅，盛唐人不过此。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗评选》","Content":"好！七言须有此，方不昧所自来（“家在梦中”联下）。不纤（“川原缭绕”联下）。一结本色尽露。","IsComment":false,"FullPath":"《唐诗评选》"},{"Book":"《贯华堂选批唐才子诗》","Content":"“东风”七字，人谓只是写春，不知便是写望，如云此雨自我家中来也。“闲”字骂草，妙！如云无谓也，扯淡也。三恨自不得归，四又妒他人得归，活写尽不归人心口咄咄也。“川原”七字中有无数亲故，“宫阙”七字中止夕阳一人。“谁”字便是无数亲故也，“独”字便是夕阳一人也。","IsComment":false,"FullPath":"《贯华堂选批唐才子诗》"},{"Book":"《五朝诗善鸣集》","Content":"不愧为大历十才子之冠。","IsComment":false,"FullPath":"《五朝诗善鸣集》"},{"Book":"《唐诗摘钞》","Content":"起调和缓，接联警亮，五、六悲壮，结处点明情事，终含凄怨之声。布格调律，盛唐不过也。五、六写景，初嫌其宽泛，不知此二句深寓乱后之感；调愈壮，气愈悲。且隐隐接出“世难”，局不伤促，词不伤露耳。起联即老杜“城春草木深”意，五、六即老杜“国破山河在”意。诗尾见地点，醒一篇之意。","IsComment":false,"FullPath":"《唐诗摘钞》"},{"Book":"《初白庵唐诗评》","Content":"大历中诗家只是平稳。","IsComment":false,"FullPath":"《初白庵唐诗评》"},{"Book":"《删订唐诗解》","Content":"三、四得自然之趣。","IsComment":false,"FullPath":"《删订唐诗解》"},{"Book":"《唐诗贯珠》","Content":"飘然而起，一一四神情俊逸。","IsComment":false,"FullPath":"《唐诗贯珠》"},{"Book":"《唐诗成法》","Content":"句虽熟滑，情真挚可耐。","IsComment":false,"FullPath":"《唐诗成法》"},{"Book":"《唐诗笺要》","Content":"结句怨悱不怨，其味深长，或谓能言久客之意，犹属皮相。","IsComment":false,"FullPath":"《唐诗笺要》"},{"Book":"《唐诗别裁》","Content":"遭乱意，上皆蕴含，至末点出。夷犹绰约，风致天成（末句下）。人诗贵一语百媚，大历十才子也；尤贵一语百情，少陵、摩洁是也。","IsComment":false,"FullPath":"《唐诗别裁》"},{"Book":"《山满楼笺注唐诗七言律》","Content":"山外雨痕，门前草色，总是望中所见，却分上下两截，句法使然也。一“闲”字，写雨中草色，妙得其神，不必强疏作“世难后千门皆空”也。","IsComment":false,"FullPath":"《山满楼笺注唐诗七言律》"},{"Book":"《历代诗法》","Content":"不以纤巧取胜，伤乱之意溢于言外。","IsComment":false,"FullPath":"《历代诗法》"},{"Book":"《网师园唐诗笺》","Content":"绰约多姿（“家在梦中”联下）。首联点题，三、四言情，五、六正写“望”字，末二句总收。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"《瀛奎律髓汇评》","Content":"纪昀；诗至大历十子，浑厚之气渐尽，惟风调胜后人耳。此诗格虽不高，而情韵特佳。","IsComment":false,"FullPath":"《瀛奎律髓汇评》"},{"Book":"《唐诗选胜直解》","Content":"末句正见春望感怀之意。为儒而逢世难，已足悲矣，衰白客途，可胜悼哉！","IsComment":false,"FullPath":"《唐诗选胜直解》"},{"Book":"《北江诗话》","Content":"（盛唐七律）门径始开，尚未极其变也。至大历十数子，对偶始参以活句，尽变化错综之妙。如卢纶“家在梦中何日到？春来江上几人还”……开后人多少法门。","IsComment":false,"FullPath":"《北江诗话》"},{"Book":"《昭昧詹言》","Content":"此诗用意，全在三、四，梦家未还，为一诗关键主意。起与五、六，平平常语。收句承明三、四，尚沉足。","IsComment":false,"FullPath":"《昭昧詹言》"}]},{"Id":11199,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"冬","Rank":0,"FirstClauseRhyme":"冬","Title":{"Content":"陈翃中丞东斋赋白玉簪"},"Clauses":[{"Content":"美矣新成太华峰，"},{"Content":"翠莲枝折叶重重。"},{"Content":"松阴满涧闲飞鹤，"},{"Content":"潭影通云暗上龙。"},{"Content":"漠漠水香风颇馥，"},{"Content":"涓涓乳溜味何浓。"},{"Content":"因声远报浮丘子，"},{"Content":"不奏登封时不容。"}]},{"Id":11316,"Classes":["軍旅 要地"],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"晚次鄂州","Comments":[{"Content":"至德中作","Type":"Text","Index":4}]},"Clauses":[{"Content":"云开远见汉阳城，"},{"Content":"犹是孤帆一日程。"},{"Content":"估客昼眠知浪静，"},{"Content":"舟人夜语觉潮生。"},{"Content":"三湘衰鬓逢秋色，","Comments":[{"Content":"一作愁","Type":"Text","Index":3}]},{"Content":"万里归心对月明。"},{"Content":"旧业已随征战尽，"},{"Content":"更堪江上鼓鼙声。"}],"Comments":[{"Book":"《艇斋诗话》","Content":"“估客”一联，曲尽江行之景，真善写物也。予每诵之。","IsComment":false,"FullPath":"《艇斋诗话》"},{"Book":"《批点唐诗》","Content":"第四句尤妙，但对上句却浅。五、六迥别。结宛转，极悲。","IsComment":false,"FullPath":"《批点唐诗》"},{"Book":"《唐诗正声》","Content":"旲逸一评：次联老江湖语，三联语忽不测，结悲，酷入情。","IsComment":false,"FullPath":"《唐诗正声》"},{"Book":"《批选唐诗》","Content":"清通熟爽，是近体佳篇。","IsComment":false,"FullPath":"《批选唐诗》"},{"Book":"《唐诗选脉会通评林》","Content":"何景明曰：二联妙。田艺衡曰：乱后之辞，可怜。陈继湍曰：旅思动人。伤感却不作异调，故佳。郭浚曰：情景不堪萧瑟。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗鼓吹笺注》","Content":"总是彻夜未眠急归情绪也，后四句一气赶下，是倒卷（“估客昼眠”二句下）。","IsComment":false,"FullPath":"《唐诗鼓吹笺注》"},{"Book":"《唐风定》","Content":"初联世所共称，不知次联更胜。","IsComment":false,"FullPath":"《唐风定》"},{"Book":"《贯华堂选批唐才子诗》","Content":"前解写尽急归神理。言望见汉阳，便欲如隼疾飞，立抵汉阳，而无奈计其远近，尚必再须一日也。三、四承之，言虽明知再须一日，而又心头眼底，不沉忽忽欲云。于是厌他估客，胡故昼眠；喜他舟人，斗地夜语。盖昼眠，便是不思速归之人，夜语，便有可以速云之理也。若只作写景读之，则既云“浪静”，又云“潮生”，此成何等文法哉！后解言吾今欲归所以如此急者，实为鬓对三湘，心驰万里，传闻旧业，已无可归，而连日江行，鼓鼙不歇，谁复能遣？尚堪一朝乎哉！","IsComment":false,"FullPath":"《贯华堂选批唐才子诗》"},{"Book":"《五朝诗善鸣集》","Content":"诗有高静之气，故白描而绝远于俚。","IsComment":false,"FullPath":"《五朝诗善鸣集》"},{"Book":"《唐诗贯珠》","Content":"“浪静”映“公开”，“夜语”由于“晚次”。三、四构句，曲尽水程情景，气度大方精妙。","IsComment":false,"FullPath":"《唐诗贯珠》"},{"Book":"《唐三体诗评》","Content":"问焯云：惊魂不定，贪程难待，合下四句读之，其意味更长。","IsComment":false,"FullPath":"《唐三体诗评》"},{"Book":"《唐律偶评》","Content":"前半极写归心之迫，却不露所以“次”之故，至结解码器方说明，读之但沉其如画耳。浪静则可以兼程，潮生更宜夜发，乃胡为淹此留也？发“次”字，暗呼起江上兵阻，非无眼之铺叙。","IsComment":false,"FullPath":"《唐律偶评》"},{"Book":"《唐体肤诠》","Content":"屈复云：一归心急，二有咫尺千里意。中四“衰鬓”、“归心”，人眼中耳中无限悲凉，故客眠人语，秋色月明，种种堪愁。用意深妙，全以神行，若无题无涉者，结言归亦无益，将来不知作何景象，愁无已时也。","IsComment":false,"FullPath":"《唐体肤诠》"},{"Book":"《大历诗略》","Content":"有情景，有声调，气势亦足，大历名篇。","IsComment":false,"FullPath":"《大历诗略》"},{"Book":"《山满楼笺注唐诗七言律》","Content":"第六句中“归心”二字，是一篇之眼。前五句写归心之急，后二句写归心所以如此急之故。“万进而逢秋色”则愁鬓不胜憔悴。“对月明”则归心愈觉凄惶，字字真情，字字实理。","IsComment":false,"FullPath":"《山满楼笺注唐诗七言律》"},{"Book":"《网师园唐诗笺》","Content":"写景亲切（“舟人夜语”句下）。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"《昭昧詹言》","Content":"起句点题。次句缩转。用笔转折有势。三、四兴在象外，卓然名句，五、六亦兼情景，而平平无奇。收切鄂州，有远想。","IsComment":false,"FullPath":"《昭昧詹言》"},{"Book":"《诗境浅说》","Content":"作客途诗，起笔须切合所在之境，而能领起全篇，乃为合作。此诗前半首尤佳。其起句言：江天浩莽，已远见汉阳城郭，而江阔帆迟，尚费行程竟日，情景真切，句法亦纡徐有致。三句言：浪平舟稳，估客高眠。丹在湍急处行舟，篙舻声终日不绝，唯江上扬帆，但闻船唇啮浪，吞吐作声，四十我人语，水窗倚枕，不沉寐之酣也。四句言：野岸维舟，夜静闻舟人相唤，加缆扣舷。众声杂作，不闻而知为夜潮来矣。诵此二句，宛若身在江船容与之中。可见诗贵天然，不在专工雕琢。","IsComment":false,"FullPath":"《诗境浅说》"},{"Book":"唐诗鉴赏辞典","Content":"这首诗写的是流离之情，行舟的情景写得生动细致，并对战乱不断发出无奈的感叹。<br /><br />《全唐诗》于本篇题下注“至德中作”，时当在安史之乱的前期。由于战乱，诗人被迫浪迹异乡，流徙不定。在南行途中，他写了这首诗。<br /><br />首联写“晚次鄂州”的心情。浓云散开，江天晴明，举目远眺，汉阳城依稀可见，因为“远”，还不可及，船行尚须一天。这样，今晚就不得不在鄂州停泊了。诗人由江西溯长江而上，必须经过鄂州（治所在今湖北武汉市武昌），直抵湖南。汉阳城在汉水北岸，鄂州之西。起句即点题，述说心情的喜悦，次句突转，透露沉郁的心情，用笔腾挪跌宕，使平淡的语句体现微妙的思致。诗人在战乱中风波漂泊，对行旅生涯早已厌倦，巴不得早些得个安憩之所。因此，一到云开雾散，见到汉阳城时，怎能不喜。“犹是”两字，突显诗人感情的骤落。这二句，看似平常叙事，却仿佛使人听到诗人在拨动着哀婉缠绵的琴弦，倾诉着孤凄苦闷的心曲，透纸贯耳，情韵不匮。<br /><br />次联写“晚次鄂州”的景况。诗人简笔勾勒船舱中所见所闻：同船的商贾白天水窗倚枕，不觉酣然入梦，不言而喻，此刻江上扬帆，风平浪静；夜深人静，忽闻船夫相唤，杂着加缆扣舷之声，不问而知夜半涨起江潮来了。诗人写的是船中常景，然而笔墨中却透露出他昼夜不宁的纷乱思绪。所以尽管这些看惯了的舟行生活，似乎也在给他平增枯涩乏味的生活感受。<br /><br />三联写“晚次鄂州”的联想。诗人情来笔至，借景抒怀：时值寒秋，正是令人感到悲凉的季节，无限的惆怅已使我两鬓如霜了；我人往三湘去，心却驰故乡，独对明月，归思更切！“三湘”，指湖南境内，即诗人此行的目的地。而诗人的家乡则在万里之遥的蒲州（今山西永济）。秋风起，落叶纷下，秋霜落，青枫凋，诗人无赏异地的秋色之心，却有思久别的故乡之念。一个“逢”字，将诗人的万端愁情与秋色的万般凄凉联系起来，移愁情于秋色，妙合无垠。“万里归心对月明”，其中不尽之意见于言外，有迢迢万里不见家乡的悲悲戚戚，亦有音书久滞萦怀妻儿的凄凄苦苦，真可谓愁肠百结，煞是动人肺腑。<br /><br />末联写“晚次鄂州”的感慨。为何诗人有家不可归，只得在异域他乡颠沛奔波呢？最后二句，把忧心愁思更深入一层：田园家计，事业功名，都随着不停息的战乱丧失殆尽，而烽火硝烟未灭，江上不是仍然传来干戈鸣响，战鼓声声？诗人虽然远离了沦为战场的家乡，可是他所到之处又无不是战云密布，这就难怪他愁上加愁了。诗的最后两句，把思乡之情与忧国愁绪结合起来，使本诗具有更大的社会意义。<br /><br />这首诗，诗人只不过截取了飘泊生涯中的一个片断，却反映了广阔的社会背景，写得连环承转，意脉相连，而且迂徐从容，曲尽情致。在构思上，不用典故来支撑诗架；在语言上，不用艳藻来求其绮丽；在抒情上，不用泼墨来露出筋骨。全诗淡雅而含蓄，平易而炽热，读来觉得舒畅自若，饶有韵味。<br /><br />（周溶泉 徐应佩）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]},{"Id":11211,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"夜投丰德寺谒海上人","Comments":[{"Content":"一本有终南二字","Type":"Text","Index":2},{"Content":"一作液","Type":"Text","Index":7},{"Content":"一作李端诗","Type":"Text","Index":9}]},"Clauses":[{"Content":"半夜中峰有磬声，"},{"Content":"偶逢樵者问山名。"},{"Content":"上方月晓闻僧语，","Comments":[{"Content":"一作话","Type":"Text","Index":7}]},{"Content":"下路林疏见客行。","Comments":[{"Content":"一作界","Type":"Text","Index":2}]},{"Content":"野鹤巢边松最老，"},{"Content":"毒龙潜处水偏清。"},{"Content":"愿得远公知姓字，"},{"Content":"焚香洗钵过浮生。"}],"Comments":[{"Book":"《云溪友议》","Content":"卢员外纶作拟僧之诗，僧清江作七夕之咏，刘随州有眼作无眼之句，宋雍无眼作有眼之诗。诗流以为四背，或云四倒，然辞意悉为佳致乎！","IsComment":false,"FullPath":"《云溪友议》"},{"Book":"《东岩草堂评订唐诗鼓吹》","Content":"玩首二句，不特不知有上人，并不知有寺。若闻磬声而知有寺，问樵夫而知有山，入寺中而知有上人，见上人而始动其愿也。前四句，写夜投丰德寺，后四句，写谒液上人。","IsComment":false,"FullPath":"《东岩草堂评订唐诗鼓吹》"},{"Book":"《唐诗选脉会通评林》","Content":"周珽曰：非有慧心静理者难言。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐风定》","Content":"幽细又极闲雅。","IsComment":false,"FullPath":"《唐风定》"},{"Book":"《瀛奎律髓汇评》","Content":"纪昀：清妥。四句在僧一边眼中写出。","IsComment":false,"FullPath":"《瀛奎律髓汇评》"},{"Book":"《唐诗成法》","Content":"非闻磬声，半夜中何处投寺？非偶逢，半夜中安得有樵者？下字斟酌，意深法密，气味深厚。","IsComment":false,"FullPath":"《唐诗成法》"},{"Book":"《大历诗略》","Content":"起结具乏风调，而品格自高。","IsComment":false,"FullPath":"《大历诗略》"},{"Book":"《小清华园诗谈》","Content":"诗明净。","IsComment":false,"FullPath":"《小清华园诗谈》"},{"Book":"《诗境浅说》","Content":"上句言山头孤存，万籁沈沈，晓风残月之时，惟闻僧语；下句言俯视下方，偶于林隙见早行之客，此言山巅寺院之高也。苏颋诗“宫中下见南山尽，城上平临北斗悬”，乃言长安城阙之高。元稹诗“星河似向檐前落，鼓角惊从地底回”，乃言越中州宅之高。同一登临之作，所在之地不同，各写其见闻也（“上方月晓”二句下）。","IsComment":false,"FullPath":"《诗境浅说》"}]},{"Id":11331,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"詶李端公野寺病居见寄","Comments":[{"Content":"一本无端字","Type":"Text","Index":4}]},"Clauses":[{"Content":"野寺钟昏山正阴，","Comments":[{"Content":"一作昏钟","Type":"Text","Index":4}]},{"Content":"乱藤高竹水声深。","Comments":[{"Content":"一作下","Type":"Text","Index":4}]},{"Content":"田夫就饷还依草，"},{"Content":"野雉惊飞不过林。"},{"Content":"斋沫暂思同静室，"},{"Content":"清羸已觉助禅心。"},{"Content":"寂寞日长谁问疾，"},{"Content":"料君惟取古方寻。"}],"Comments":[{"Book":"《三体唐诗》","Content":"前实后虚体。","IsComment":false,"FullPath":"《三体唐诗》"},{"Book":"《唐音癸签》","Content":"盛唐人和诗不和韵……至大历中，李端、卢纶《野寺病居》酬答，始有次韵。","IsComment":false,"FullPath":"《唐音癸签》"},{"Book":"《唐诗选脉会通评林》","Content":"周敬曰：起调绝似嘉州；中联新响，右丞不能多让。如此等诗，何分中、盛？顾璘曰：次联几近有道。三联苦思方得，又复平易。周珽曰：铲除魔气，洗涤尘腔，有独啖胡麻、不屑俗糗之致。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗贯珠》","Content":"韵调与李相类，总之大历十才子气味，而卢比原唱更增色泽、精劲少许。上解写“野”字，下解兼“病”、“寺”串合，所以尤觉灵活。而起处亦自不同：山中岚雾多昏，所以呼下“阴”字。“就饷”，用餐也；“还依草”，即藉地而坐。极平常事，然有意无意，自觉清韵。且“就”字早先引下，妙。“不过林”，得雉飞之情。善写淡处，晚唐不能及，便费力，落二义耳。病则静摄，如同斋沐，所居亦“同静室”。病体“清赢”，诸念不起，已“助禅心”耳。两句俱双关“野寺病居”，更入腻境，高出一层，妙。","IsComment":false,"FullPath":"《唐诗贯珠》"}]},{"Id":11311,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"宿定陵寺","Comments":[{"Content":"寺在陵内","Type":"Text","Index":4}]},"Clauses":[{"Content":"古塔荒台出禁墙，"},{"Content":"磬声初尽漏声长。"},{"Content":"云生紫殿幡花湿，"},{"Content":"月照青山松柏香。"},{"Content":"禅室夜闻风过竹，"},{"Content":"奠筵朝启露沾裳。"},{"Content":"谁悟威灵同寂灭，"},{"Content":"更堪砧杵发昭阳。"}]},{"Id":11272,"Allusions":[{"AllusionIndex":4389,"AllusionKey":"嵇康","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"送李缃"},"Clauses":[{"Content":"旧国仍连五将营，"},{"Content":"儒衣何处谒公卿。"},{"Content":"波翻远水蒹葭动，"},{"Content":"路入寒村机杼鸣。"},{"Content":"嵇康书论多归兴，","Comments":[{"Content":"嵇康","Type":"AllusionKey","Index":2}]},{"Content":"谢氏家风有学名。"},{"Content":"为问西来雨中客，"},{"Content":"空山几处是前程。"}]},{"Id":11250,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"送内弟韦宗仁归信州觐省"},"Clauses":[{"Content":"常嗟外族弟兄稀，"},{"Content":"转觉心孤是送归。"},{"Content":"醉掩壶觞人有泪，"},{"Content":"梦惊波浪日无辉。","Comments":[{"Content":"一作愁穿魂萝月","Type":"Text","Index":5}]},{"Content":"烹鱼绿岸烟浮草，","Comments":[{"Content":"一作迷","Type":"Text","Index":6}]},{"Content":"摘橘青溪露湿衣。","Comments":[{"Content":"一作采","Type":"Text","Index":1}]},{"Content":"闻说江楼长卷幔，"},{"Content":"几回风起望胡威。"}]},{"Id":11291,"Allusions":[{"AllusionIndex":8964,"AllusionKey":"五马","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"送崔琦赴宣州幕"},"Clauses":[{"Content":"五马临流待幕宾，","Comments":[{"Content":"五马","Type":"AllusionKey","Index":2}]},{"Content":"羡君谈笑出风尘。"},{"Content":"身闲就养宁辞远，"},{"Content":"世难移家莫厌贫。"},{"Content":"天际晓山三峡路，"},{"Content":"津头腊市九江人。"},{"Content":"何处遥知最惆怅，"},{"Content":"满湖青草雁声春。"}]}],"Count":337,"PageNo":8,"PageSize":20}