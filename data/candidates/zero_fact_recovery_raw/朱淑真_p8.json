{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":536047,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"早秋"},"Clauses":[{"Content":"一痕雨过湿秋光，"},{"Content":"纨扇初抛自有凉。"},{"Content":"雾影乍随山影薄，"},{"Content":"蛩声偏接漏声长。"}]},{"Id":536048,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"青","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"秋日登楼"},"Clauses":[{"Content":"梧影萧疏弄晚晴，","Comments":[{"Content":"原作套，据武林本改","Type":"Text","Index":5}]},{"Content":"残蝉凄楚不堪听。"},{"Content":"楼高望极秋山去，"},{"Content":"溢眼重重叠叠青。","Comments":[{"Content":"武林本作满","Type":"Text","Index":1}]}]},{"Id":536049,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"秋夜杂书二首"},"Clauses":[{"Content":"雨过凉生枕簟秋，"},{"Content":"楼头新月挂银钩。"},{"Content":"且无挥扇劳纤手，"},{"Content":"只好烧香伴酒瓯。","Comments":[{"Content":"元刻本作恰好添","Type":"Text","Index":3}]}]},{"Id":536050,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"秋夜杂书二首"},"Clauses":[{"Content":"窗外蛩吟解说秋，"},{"Content":"迢迢清夜惜前游。","Comments":[{"Content":"元刻本作忆","Type":"Text","Index":5}]},{"Content":"月华飞过西楼上，"},{"Content":"添起离人一段愁。","Comments":[{"Content":"元刻本作得","Type":"Text","Index":2}]}]},{"Id":96259,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"秋夜二首"},"Clauses":[{"Content":"夜久无眠秋气清，"},{"Content":"烛花频剪欲三更。","Comments":[{"Content":"原作光，据元刻本改","Type":"Text","Index":2}]},{"Content":"铺床凉满梧桐月，"},{"Content":"月在梧桐缺处明。"}]},{"Id":536051,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"秋夜二首"},"Clauses":[{"Content":"凉天如水夜澄鲜，","Comments":[{"Content":"原作汀，据元刻本改","Type":"Text","Index":6}]},{"Content":"桂子风清嫩去眠。"},{"Content":"多谢嫦娥知我意，"},{"Content":"中秋未到月先圆。"}]},{"Id":536052,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"Title":{"Content":"秋夜闻雨三首"},"Clauses":[{"Content":"似箭撩风穿帐幕，"},{"Content":"如倾凉雨咽更筹。"},{"Content":"冷怀攲枕人无寐，"},{"Content":"铁石肝肠也泪流。"}]},{"Id":536053,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"秋夜闻雨三首"},"Clauses":[{"Content":"竹窗萧索镇如秋，"},{"Content":"雨滴檐花夜不休。"},{"Content":"独宿广寒多少恨，"},{"Content":"一时分付我心头。"}]},{"Id":536054,"GroupIndex":3,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"Title":{"Content":"秋夜闻雨三首"},"Clauses":[{"Content":"似篾身材无事瘦，"},{"Content":"如丝肠肚怎禁愁。"},{"Content":"鸣窗更听芭蕉雨，"},{"Content":"一叶中藏万斛愁。"}]},{"Id":96260,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"秋夜有感"},"Clauses":[{"Content":"哭损双眸断尽肠，"},{"Content":"怕黄昏后到昏黄。"},{"Content":"更堪细雨新秋夜，"},{"Content":"一点残灯伴夜长。"}]},{"Id":536055,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"文","Rank":0,"Title":{"Content":"中夜"},"Clauses":[{"Content":"冯夷捧出一轮月，"},{"Content":"河伯吹开万里云。"},{"Content":"寥廓无尘河汉远，"},{"Content":"水光天影接清芬。"}]},{"Id":536056,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"蒸","Title":{"Content":"月夜"},"Clauses":[{"Content":"灯花鹊喜两无凭，"},{"Content":"那更清宵梦不成。"},{"Content":"月上楼头天似洗，"},{"Content":"愁人别是一般情。"}]},{"Id":96190,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"Title":{"Content":"长宵"},"Clauses":[{"Content":"月转西窗斗帐深，"},{"Content":"灯昏香烬拥寒衾。"},{"Content":"魂飞何处临风笛，"},{"Content":"肠断谁家捣夜砧。"}]},{"Id":96201,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"对景漫成"},"Clauses":[{"Content":"半窗残照一帘风，"},{"Content":"小小池亭竹径通。"},{"Content":"枫叶醉红秋色里，"},{"Content":"两三行雁夕阳中。"}]},{"Id":536057,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"七夕"},"Clauses":[{"Content":"拜月亭前梧叶稀，"},{"Content":"穿针楼上觉秋迟。"},{"Content":"天孙正好贪欢笑，"},{"Content":"那得工夫赐巧丝。"}]},{"Id":96227,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"豪","Rank":0,"FirstClauseRhyme":"萧","Title":{"Content":"闷怀二首"},"Clauses":[{"Content":"黄昏院落雨潇潇，"},{"Content":"独对孤灯恨气高。"},{"Content":"针钱懒拈肠自断，"},{"Content":"梧桐叶叶剪风刀。"}]},{"Id":536060,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"闷怀二首"},"Clauses":[{"Content":"秋雨沉沉滴夜长，"},{"Content":"梦难成处转凄凉。"},{"Content":"芭蕉叶上梧桐里，"},{"Content":"点点声声有断肠。"}]},{"Id":536061,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"湖上闲望二首"},"Clauses":[{"Content":"照水芙蓉入眼明，"},{"Content":"败荷枯草闹秋声。"},{"Content":"疏云不雨阴长定，"},{"Content":"唤起诗怀酒兴清。"}]},{"Id":536062,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"湖上闲望二首"},"Clauses":[{"Content":"薄云疏日弄阴晴，"},{"Content":"山秀湖平眼界清。"},{"Content":"不必西风吹叶下，"},{"Content":"愁人满耳是秋声。"}]},{"Id":96270,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"中秋闻笛"},"Clauses":[{"Content":"谁家横笛弄轻清，"},{"Content":"唤起离人枕上情。"},{"Content":"自是断肠听不得，"},{"Content":"非干吹出断肠声。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》前集卷五，总题秋景","Type":"Text","Index":7}]}],"Comments":[{"Book":"朱淑真集","Content":"[朱淑真集]题作《中秋闻笛》<br />【校】[题]《千家诗选》作[笛]。","IsComment":false,"FullPath":"朱淑真集"}]}],"Count":367,"PageNo":8,"PageSize":20}