{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":96271,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"黄花"},"Clauses":[{"Content":"土花能白又能红，"},{"Content":"晚节由能爱此工。"},{"Content":"宁可抱香枝上老，"},{"Content":"不随黄叶舞秋风。","Comments":[{"Content":"以上明潘是仁《宋元诗·断肠诗集》卷四","Type":"Text","Index":7}]}]},{"Id":96229,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"画眉"},"Clauses":[{"Content":"晓来偶意画愁眉，"},{"Content":"种种新妆试略施。"},{"Content":"堪笑时人争彷佛，"},{"Content":"满城将谓是时宜。","Comments":[{"Content":"影印《诗渊》册一页二六","Type":"Text","Index":7}]}]},{"Id":536187,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"微","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"咏柳二首"},"Clauses":[{"Content":"长丝袅娜拂溪垂，"},{"Content":"乳絮风吹漠漠飞。"},{"Content":"全惜东风与为主，"},{"Content":"年年先占得韶晖。"}]},{"Id":536188,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"Title":{"Content":"咏柳二首"},"Clauses":[{"Content":"风牵袅袅摇无定，"},{"Content":"翠影侵阶已午天。"},{"Content":"花发鸟歌春景媚，"},{"Content":"好看柔软吐香绵。","Comments":[{"Content":"同上书册二页一一三四","Type":"Text","Index":7}]}]},{"Id":536189,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"桃花"},"Clauses":[{"Content":"每对春风竞吐芳，"},{"Content":"胭脂颜色更浓妆。"},{"Content":"含羞自是不言者，"},{"Content":"从此成蹊入醉乡。","Comments":[{"Content":"同上书册二页一一六八","Type":"Text","Index":7}]}]},{"Id":536190,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"李花二首"},"Clauses":[{"Content":"满园花发白于梅，"},{"Content":"又与红桃并候开。"},{"Content":"可口直须成实后，"},{"Content":"莫将苦种路旁栽。"}]},{"Id":536191,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"0","Rank":0,"Title":{"Content":"李花二首"},"Clauses":[{"Content":"小小琼英舒嫩白，"},{"Content":"未饶深紫与轻红。"},{"Content":"无言路侧谁知味，"},{"Content":"惟有寻芳蝶与蜂。","Comments":[{"Content":"同上书册二页一一七三","Type":"Text","Index":7}]}]},{"Id":536192,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"梅"},"Clauses":[{"Content":"雪格冰姿蜡蒂红，"},{"Content":"水边山畔淡烟笼。"},{"Content":"江风也似知人意，"},{"Content":"密递清香到室中。","Comments":[{"Content":"同上书册二页一一七六","Type":"Text","Index":7}]}]},{"Id":536194,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"蜡梅"},"Clauses":[{"Content":"天然金蕊冠群英，"},{"Content":"谁信鹅黄染得成。"},{"Content":"昨夜南枝报春信，"},{"Content":"摘来香露月中清。","Comments":[{"Content":"同上书册四页二四三三","Type":"Text","Index":7}]}]},{"Id":536196,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"观燕"},"Clauses":[{"Content":"深闺寂寞带斜晖，"},{"Content":"又是黄昏半掩扉。"},{"Content":"燕子不知人意思，"},{"Content":"檐前故作一双飞。"}]},{"Id":536197,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"齐","Rank":0,"FirstClauseRhyme":"齐","Title":{"Content":"送燕"},"Clauses":[{"Content":"见尔来齐去亦齐，"},{"Content":"空巢零落屋庐低。"},{"Content":"更无心记衔泥处，"},{"Content":"花絮春风小院西。","Comments":[{"Content":"以上同上书册四页二八一九","Type":"Text","Index":7}]}]},{"Id":724166,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"七夕"},"Clauses":[{"Content":"金井西风梧叶稀，"},{"Content":"穿针楼上月光微。"},{"Content":"天孙也赴今宵约，"},{"Content":"不赐人间巧样机。"}]},{"Id":724602,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"枫叶"},"Clauses":[{"Content":"江空木落雁声悲，"},{"Content":"霜入丹枫百草萎。"},{"Content":"蝴蝶不知身是梦，"},{"Content":"又随春色上寒枝。"}]},{"Id":536031,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"苦热闻田夫语有感"},"Clauses":[{"Content":"日轮推火烧长空，"},{"Content":"正是六月三伏中。"},{"Content":"旱云万叠赤不雨，"},{"Content":"地裂河枯尘起风。"},{"Content":"农忧田亩死禾黍，"},{"Content":"车水救田无暂处。"},{"Content":"日长饥渴喉咙焦，"},{"Content":"汗血勤劳谁与语。"},{"Content":"播插耕耘功已足，"},{"Content":"尚愁秋晚无成熟。"},{"Content":"云霓不至空自忙，"},{"Content":"恨不抬头向天哭。"},{"Content":"寄语豪家轻薄儿，"},{"Content":"纶巾羽扇将何为。"},{"Content":"田中青稻半黄槁，"},{"Content":"安坐高堂知不知。"}]},{"Id":536041,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"喜雨"},"Clauses":[{"Content":"赤日炎炎烧八荒，"},{"Content":"田中无雨苗半黄。"},{"Content":"天工不放老龙懒，"},{"Content":"赤电驱雷云四方。"},{"Content":"琼瑰万斛写碧落，"},{"Content":"陂塘池沼皆泱泱。"},{"Content":"高田低田尽沾泽，"},{"Content":"农喜禾无可槁伤。"},{"Content":"我皇圣德布寰宇，"},{"Content":"六月青天降甘雨。"},{"Content":"四海咸蒙滂沛恩，"},{"Content":"九州尽解焦熬苦。"},{"Content":"倾盆势歇尘点无，"},{"Content":"衣袂生凉罢挥羽。"},{"Content":"江上数峰天外青，"},{"Content":"眼界增明快心腑。"},{"Content":"炎热一洗无留迹，"},{"Content":"顿觉好风生雨腋。"},{"Content":"纱厨湘簟爽气新，"},{"Content":"沉李削瓜浮玉液。"},{"Content":"傍池占得秋意多，"},{"Content":"尚馀珠点缀圆荷。"},{"Content":"楼头月上云散尽，"},{"Content":"远水连天天接波。"}]},{"Id":96328,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"春日行"},"Clauses":[{"Content":"春云漠漠连春空，"},{"Content":"映阶草色绿茸茸。"},{"Content":"不寒不暖雨新霁，"},{"Content":"满城佳气浮葱葱。"},{"Content":"岸柳依依微烟笼，"},{"Content":"园林淡荡催花风。"},{"Content":"东君造化一何工，"},{"Content":"施青绘紫复匀红。"},{"Content":"多少闲花与凡卉，"},{"Content":"不论妍丑争夭秾。","Comments":[{"Content":"原作浓，据武林本改","Type":"Text","Index":7}]},{"Content":"燕舞莺歌昼晷永，"},{"Content":"帘幕无人门宇静。"},{"Content":"何处飞来双蛱蝶，"},{"Content":"翻翻飞入寻香径。"},{"Content":"可怜春色都九旬，"},{"Content":"朝欢暮宴归王孙。"},{"Content":"秃毫写纸属诗人，"},{"Content":"长歌短什劳精神。"},{"Content":"长歌短什聊自适，"},{"Content":"岂有佳句生阳春。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[夭秾]底本作[夭浓]《武林》本改。[秃毫句] 《武林》本作[秃毫属纸写诗人。]","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":536124,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"7","Rank":0,"Title":{"Content":"秋日行"},"Clauses":[{"Content":"萧瑟西风起何处，"},{"Content":"庭前叶叶惊梧树。"},{"Content":"万物收成天地肃，"},{"Content":"田家芋栗初登圃。"},{"Content":"杳杳高穹片水清，"},{"Content":"一点秋雕翥云路。"},{"Content":"凄凄空旷雨初晴，"},{"Content":"凉飙动地收残暑。"},{"Content":"高楼玉笛应清商，"},{"Content":"天外数声新雁度。"},{"Content":"园林草木半含黄，"},{"Content":"篱菊黄金花正吐。"},{"Content":"池上枯杨噪晚蝉，"},{"Content":"愁莲蔌蔌啼残露。"},{"Content":"可怜秋色与春风，"},{"Content":"几度荣枯新复故。"}]},{"Id":536135,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"31","Rank":0,"Title":{"Content":"湖上咏月"},"Clauses":[{"Content":"清宵三五凉风发，"},{"Content":"湖上闲吟步明月。"},{"Content":"涓涓流水浅又清，"},{"Content":"皎洁长空纤霭灭。"},{"Content":"水光月色环相连，"},{"Content":"可怜清景两奇绝。"}]},{"Id":96193,"Classes":["題畫 蘭竹"],"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"代谢人见惠墨竹","Comments":[{"Content":"《名媛诗归》作人谢","Type":"Text","Index":3}]},"Clauses":[{"Content":"纷纷桃李皆凡俗，"},{"Content":"四时之中惟有竹。"},{"Content":"非惟苍翠列风轻，"},{"Content":"对之自觉清人肉。"},{"Content":"羡君年少多才艺，"},{"Content":"笔墨潜偷造化力。"},{"Content":"扫出一枝爰惠我，"},{"Content":"清阴翠色惊满幅。"},{"Content":"嗟我得之喜何以，"},{"Content":"贪夫忽获珠盈斛。"},{"Content":"朝夕捧玩不知疲，"},{"Content":"如在太白楼上宿。"},{"Content":"遽令标轴挂壁间，"},{"Content":"劲节直日长目前。","Comments":[{"Content":"武林本作身","Type":"Text","Index":4}]},{"Content":"不必溪边寻六逸，"},{"Content":"不必林间访七贤。"},{"Content":"岂使阎本与王维，"},{"Content":"独擅古念称神师。"},{"Content":"又有屏间名浪得，"},{"Content":"误墨成形何足奇。"},{"Content":"未若一笔扫一枝，"},{"Content":"渭川移来人莫疑。"},{"Content":"珍藏欲默默不得，"},{"Content":"命笺索笔成新诗。"},{"Content":"诗穷纸满意不尽，"},{"Content":"阁笔无语愧才稀。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》后集卷八，总题杂咏","Type":"Text","Index":7}]}],"Comments":[{"Book":"朱淑真集","Content":"【校】[惊]《名媛诗归》作[及]。[直日] 《武林》本作[直身]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96346,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"圈儿词"},"Clauses":[{"Content":"相思欲寄无从寄，"},{"Content":"画个圈儿替。"},{"Content":"话在圈儿外，"},{"Content":"心在圈儿里。"},{"Content":"单圈儿是我，"},{"Content":"双圈儿是你。"},{"Content":"你心中有我，"},{"Content":"我心中有你。"},{"Content":"月缺了会圆，"},{"Content":"月圆了会缺。"},{"Content":"整圆儿是团圆，"},{"Content":"半圈儿是别离。"},{"Content":"我密密加圈，"},{"Content":"你须密密知我意。"},{"Content":"还有数不尽的相思情，"},{"Content":"我一路圈儿圈到底。"}]}],"Count":367,"PageNo":16,"PageSize":20}