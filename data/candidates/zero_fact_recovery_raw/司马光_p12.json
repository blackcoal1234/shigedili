{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":81087,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"送昌言舍人得告还蜀三首"},"Clauses":[{"Content":"悽怆怀桑梓，"},{"Content":"劬劳咏蓼莪。"},{"Content":"树风今远矣，"},{"Content":"鼎食奈悲何。"},{"Content":"剑阁登车近，"},{"Content":"秦关屈指过。"},{"Content":"腾装才首路，"},{"Content":"夕梦已江沱。"}]},{"Id":81086,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"送昌言舍人得告还蜀三首"},"Clauses":[{"Content":"富贵动归思，"},{"Content":"由来光里闾。"},{"Content":"戒门羞主父，"},{"Content":"负弩笑相如。"},{"Content":"外物有荣悴，"},{"Content":"中心无戚疏。"},{"Content":"遥知见亲旧，"},{"Content":"不改布衣初。"}]},{"Id":80839,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"祁国正献公挽歌三首","Comments":[{"Content":"杜相","Type":"Text","Index":9}]},"Clauses":[{"Content":"舟楫才猷大，"},{"Content":"冰霜德操坚。"},{"Content":"陶钧成茂业，"},{"Content":"书史乐高年。"},{"Content":"瞻望簪绅共，"},{"Content":"吁嗟馆舍捐。"},{"Content":"举时无异论，"},{"Content":"方信令名全。"}]},{"Id":80838,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"祁国正献公挽歌三首","Comments":[{"Content":"杜相","Type":"Text","Index":9}]},"Clauses":[{"Content":"钧玉吴台旧，"},{"Content":"诛茅梁苑新。"},{"Content":"位登华衮贵，"},{"Content":"家似布衣贫。"},{"Content":"直道高当世，"},{"Content":"清风遗后人。"},{"Content":"千秋寒照目，"},{"Content":"竹帛不栖尘。"}]},{"Id":80837,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"祁国正献公挽歌三首","Comments":[{"Content":"杜相","Type":"Text","Index":9}]},"Clauses":[{"Content":"先子同乌府，"},{"Content":"知音诚皦然。"},{"Content":"脱缞来拜伏，"},{"Content":"抚首辱哀怜。"},{"Content":"迨此泉扃掩，"},{"Content":"空悲尘网牵。"},{"Content":"无由怀酒絮，"},{"Content":"撇涕望新阡。"}]},{"Id":81000,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"冬","Rank":0,"Title":{"Content":"侍读王文公挽歌二首"},"Clauses":[{"Content":"石室书编富，"},{"Content":"金华讲席重。"},{"Content":"荐神归博洽，"},{"Content":"鸣玉称雍容。"},{"Content":"贰负累囚象，"},{"Content":"尸臣古瑑踪。"},{"Content":"老成今已矣，"},{"Content":"咨访欲谁从。"}]},{"Id":80999,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"侍读王文公挽歌二首"},"Clauses":[{"Content":"杖底潜蛇影，"},{"Content":"门阴集戴鵀。"},{"Content":"玉楼新记就，"},{"Content":"石椁旧铭沈。"},{"Content":"箧有封峦札，"},{"Content":"籯无遗子金。"},{"Content":"寂寥封马鬣，"},{"Content":"秋色净松林。"}]},{"Id":81016,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"盐","Rank":0,"Title":{"Content":"相国广平文简程公挽歌二首"},"Clauses":[{"Content":"明直君臣合，"},{"Content":"安危将相兼。"},{"Content":"金章四辅贵，"},{"Content":"玉帐万兵严。"},{"Content":"御侮长城隐，"},{"Content":"临繁利刃铦。"},{"Content":"南山霣岩石，"},{"Content":"何以慰民瞻。"}]},{"Id":81015,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"青","Rank":0,"Title":{"Content":"相国广平文简程公挽歌二首"},"Clauses":[{"Content":"帝诰封泥紫，"},{"Content":"皇坟杀简青。"},{"Content":"坐谈安玉垒，"},{"Content":"专对詟龙庭。"},{"Content":"黼黻昭文理，"},{"Content":"冰霜莹典刑。"},{"Content":"英灵入箕尾，"},{"Content":"终古作天星。"}]},{"Id":81037,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"送王书记之官永兴","Comments":[{"Content":"申，迈应辰","Type":"Text","Index":4}]},"Clauses":[{"Content":"白发添新镊，"},{"Content":"红尘满弊衣。"},{"Content":"人生适未值，"},{"Content":"吾道岂云非。"},{"Content":"巩洛风烟远，"},{"Content":"函秦草树微。"},{"Content":"长安春酒美，"},{"Content":"行乐勿令希。"}]},{"Id":81135,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"青","Rank":0,"Title":{"Content":"晓思"},"Clauses":[{"Content":"束带朝尚早，"},{"Content":"蓬门未脱扃。"},{"Content":"短篱潜落月，"},{"Content":"老树带孤星。"},{"Content":"隐几貂裘黑，"},{"Content":"开编竹简青。"},{"Content":"子云非执戟，"},{"Content":"何以得穷经。"}]},{"Id":81062,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"送朱职方提举江淮运盐","Comments":[{"Content":"处仁，字表臣","Type":"Text","Index":4}]},"Clauses":[{"Content":"熬漉沧波耗，"},{"Content":"征输泽国贫。"},{"Content":"婴罗矜赤子，"},{"Content":"运筴借能臣。"},{"Content":"拜手觚棱晓，","Comments":[{"Content":"四库本作晚","Type":"Text","Index":5}]},{"Content":"浮舟狼汤春。","Comments":[{"Content":"自注：狼音浪，汤音宕。见《地理志》荥阳。","Type":"Text","Index":4}]},{"Content":"东南待苏息，"},{"Content":"别酒莫逡巡。"}]},{"Id":81063,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"送次道知太平州"},"Clauses":[{"Content":"狼汤春流满，"},{"Content":"芜湖候吏迎。"},{"Content":"旌旟晓日丽，"},{"Content":"钲鼓野风清。"},{"Content":"暂喜红尘远，"},{"Content":"休嗟素发生。"},{"Content":"专城方四十，"},{"Content":"自古以为荣。"}]},{"Id":81084,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"送苏屯田知单州","Comments":[{"Content":"采，字公佐","Type":"Text","Index":4},{"Content":"苏先君尝知单父县","Type":"Text","Index":7}]},"Clauses":[{"Content":"佳郡望都城，"},{"Content":"相闻击柝声。"},{"Content":"宾朋才执别，"},{"Content":"耆旧已前迎。"},{"Content":"䌽服当年戏，"},{"Content":"骊驹此日荣。"},{"Content":"弦歌应尽在，"},{"Content":"琴调不须更。"}]},{"Id":81193,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"喜张圣民得登州"},"Clauses":[{"Content":"昼日少闲暇，","Comments":[{"Content":"陈本作尽","Type":"Text","Index":1}]},{"Content":"中宵梦亦劳。"},{"Content":"符移空浩浩，"},{"Content":"榜楚镇謷謷。"},{"Content":"敢说今求郡，"},{"Content":"番思昔坐曹。","Comments":[{"Content":"陈本作翻","Type":"Text","Index":1}]},{"Content":"羡君乘五马，"},{"Content":"东去一何高。"}]},{"Id":80986,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"诗寄云夫处士老兄兼呈知府待制八丈"},"Clauses":[{"Content":"一鹗曾飞奏，"},{"Content":"中林下鹤书。"},{"Content":"今乘使君马，"},{"Content":"重到逸人居。"},{"Content":"松竹过从久，"},{"Content":"闾阎惠爱馀。"},{"Content":"只应棠树影，"},{"Content":"比旧更扶疏。"}]},{"Id":81079,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"送李学士使北","Comments":[{"Content":"及之，字公元","Type":"Text","Index":4}]},"Clauses":[{"Content":"征盖霜空迥，"},{"Content":"飘飘迎塞鸿。"},{"Content":"虏牙侵海角，"},{"Content":"汉节下天中。"},{"Content":"酒薄阴山雪，"},{"Content":"裘寒易水风。"},{"Content":"边声不可听，"},{"Content":"归思浩无穷。"}]},{"Id":81121,"Classes":["軍旅 送行","軍旅 赴任"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"送薛水部十丈通判并州"},"Clauses":[{"Content":"十万貔貅士，"},{"Content":"旌旗晋水阳。"},{"Content":"元戎倚耆硕，"},{"Content":"别乘选才良。"},{"Content":"秀直寒松节，"},{"Content":"精明利剑铓。"},{"Content":"知君留滞久，"},{"Content":"从此欲腾骧。"}]},{"Id":81228,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"感兴寄聂之美"},"Clauses":[{"Content":"平生百无可，"},{"Content":"强为一官縻。"},{"Content":"世味偏予薄，"},{"Content":"心期独子知。"},{"Content":"林猿愁玉琐，"},{"Content":"枥马患金羁。"},{"Content":"年事今华发，"},{"Content":"求荣欲为谁。"}]},{"Id":80737,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"八月七日夜省直苦雨三首"},"Clauses":[{"Content":"夜色槐阴重，"},{"Content":"雨声官舍寒。"},{"Content":"野农安敢问，"},{"Content":"环堵未能完。"},{"Content":"尽日流云度，"},{"Content":"何时大块乾。"},{"Content":"正愁开霁晚，"},{"Content":"霜雾满红栏。","Comments":[{"Content":"原作露，据陈本改","Type":"Text","Index":2}]}]}],"Count":1270,"PageNo":12,"PageSize":20}