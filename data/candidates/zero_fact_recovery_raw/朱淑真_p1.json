{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":96319,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"除夜"},"Clauses":[{"Content":"休叹流光去，"},{"Content":"看看春欲回。"},{"Content":"椒盘卷红烛，"},{"Content":"柏酒溢金杯。"},{"Content":"残腊馀更尽，"},{"Content":"新年晓角催。"},{"Content":"争先何物早，"},{"Content":"唯有后园梅。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》后集卷四，总题冬景","Type":"Text","Index":5}]}],"Comments":[{"Book":"朱淑真集","Content":"【校】[馀更]《千家诗选》作[更筹]　 铁琴　剑楼钞本作[更馀]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96284,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"代送人赴召司农"},"Clauses":[{"Content":"当年持节使，"},{"Content":"宽厚出诚心。"},{"Content":"郡国承风远，"},{"Content":"朝廷注意深。"},{"Content":"十行初下诏，"},{"Content":"四海望为霖。"},{"Content":"几夜台星转，"},{"Content":"光侵九棘林。"}]},{"Id":536176,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"题斗野亭"},"Clauses":[{"Content":"高亭忽登览，"},{"Content":"豁尔思无穷。"},{"Content":"访古多遣迹，"},{"Content":"留题有钜公。"},{"Content":"地分吴楚界，"},{"Content":"人在斗牛中。"},{"Content":"不是乘槎客，"},{"Content":"那知此路通。"}]},{"Id":96321,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"寄大人二首"},"Clauses":[{"Content":"去家千里外，"},{"Content":"飘泊若为心。"},{"Content":"诗诵南陔句，"},{"Content":"琴歌陟岵音。"},{"Content":"承颜故国远，"},{"Content":"举目白云深。"},{"Content":"欲识归宁意，"},{"Content":"三年数岁阴。"}]},{"Id":96322,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"寄大人二首"},"Clauses":[{"Content":"极目思乡国，"},{"Content":"千山更万津。"},{"Content":"庭闱劳梦寐，"},{"Content":"道路厌埃尘。"},{"Content":"诗礼闻相远，"},{"Content":"琴樽谁是亲。"},{"Content":"愁看罗袖上，"},{"Content":"长揾泪痕新。"}]},{"Id":96293,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"和前韵见寄"},"Clauses":[{"Content":"忽得南来信，"},{"Content":"殷勤慰我心。"},{"Content":"新诗怜后逸，"},{"Content":"清论忆容音。"},{"Content":"目断乡程远，"},{"Content":"楼高客恨深。"},{"Content":"三年重会合，"},{"Content":"依旧见荆阴。"}]},{"Id":96294,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"和前韵见寄"},"Clauses":[{"Content":"忆昔江头别，"},{"Content":"相看对古津。"},{"Content":"去来分橹棹，"},{"Content":"南北隔音尘。"},{"Content":"把酒何时共，"},{"Content":"论文几日亲。"},{"Content":"归宁知有约，"},{"Content":"䌽服共争新。"}]},{"Id":536195,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"夏萤"},"Clauses":[{"Content":"熠熠迎宵上，"},{"Content":"林间点点光。"},{"Content":"初疑星错落，"},{"Content":"浑讶火荧煌。"},{"Content":"著雨藏花坞，"},{"Content":"随风入画堂。"},{"Content":"儿童竞追扑，"},{"Content":"照字集书囊。","Comments":[{"Content":"同上书册四页二七六九","Type":"Text","Index":5}]}]},{"Id":536001,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"佳","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"立春古律"},"Clauses":[{"Content":"停杯不饮待春来，"},{"Content":"和气先春动六街。"},{"Content":"生菜乍挑宜卷饼，"},{"Content":"罗幡旋剪称联钗。"},{"Content":"休论残腊千重恨，"},{"Content":"管入新年百事谐。"},{"Content":"从此对花并对景，"},{"Content":"尽拘风月入诗怀。"}]},{"Id":96314,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"春霁"},"Clauses":[{"Content":"淡薄轻寒雨后天，"},{"Content":"柳丝无力带朝烟。","Comments":[{"Content":"元刻本作妥","Type":"Text","Index":5}]},{"Content":"弄晴莺舌于中巧，"},{"Content":"著雨花枝分外妍。"},{"Content":"消破旧愁冯酒盏，"},{"Content":"去除新恨赖诗篇。"},{"Content":"年年来到梨花月，","Comments":[{"Content":"武林本作对","Type":"Text","Index":4}]},{"Content":"瘦不胜衣怯杜鹃。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[题]《千家诗选》作[春晴]。[淡薄]《宋元百家诗》　《名媛诗归》　《古今女史》作[淡淡]。[妥]《宋元百家诗》　《名媛诗归》　《古今女史》作[带]。[凭]《千家诗选》作[还]。[年年]《宋元百家诗》作[频]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96326,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"新春"},"Clauses":[{"Content":"楼台影里荡春风，"},{"Content":"协气融怡物物同。"},{"Content":"草色乍翻新样绿，"},{"Content":"花容不减旧时红。"},{"Content":"莺唇小巧轻烟里，"},{"Content":"蝶翅轻便细雨中。"},{"Content":"聊把新诗记风景，"},{"Content":"休嗟万事转头空。"}]},{"Id":536002,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"晴和"},"Clauses":[{"Content":"海棠深院雨初收，"},{"Content":"苔径无风蝶自由。"},{"Content":"百结丁香誇美丽，"},{"Content":"三眠杨柳弄轻柔。"},{"Content":"小桃酒腻红尤浅，"},{"Content":"芳草寒馀绿渐稠。"},{"Content":"寂寂珠廉归燕未，"},{"Content":"子规啼处一春愁。"}]},{"Id":96305,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"春阴古律二首"},"Clauses":[{"Content":"薄云笼日弄轻阴，"},{"Content":"试与诗工略话春。"},{"Content":"蠢蠢绿杨初学线，"},{"Content":"茸茸碧草渐成茵。"},{"Content":"园林深寂撩私恨，"},{"Content":"山水昏明恼暗颦。","Comments":[{"Content":"原作脑，据元刻本改","Type":"Text","Index":5}]},{"Content":"芳意被他寒约住，"},{"Content":"天应知有惜花人。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[题]《宋元百家诗》无[古律]二字。[学线]《宋元百家诗》　《名媛诗归》 　《古今女史》作[绩线]。[蠢蠢]《宋元百家诗》　《名媛诗归》 　《古今女史》作[蠢尔]。[茸茸]《宋元百家诗》　《名媛诗归》 　《古今女史》作[蒙茸]。[园林]《名媛诗归》 　《古今女史》作[园亭]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96306,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"春阴古律二首"},"Clauses":[{"Content":"陡觉湘裙剩带围，"},{"Content":"情怀常是被春欺。"},{"Content":"半檐落日飞花后，"},{"Content":"一阵轻寒微雨时。"},{"Content":"幽谷想应莺出晚，","Comments":[{"Content":"原作晚出，据元刻本乙","Type":"Text","Index":7}]},{"Content":"旧巢应怪燕归迟。","Comments":[{"Content":"《历朝名媛诗词》卷八作却","Type":"Text","Index":3}]},{"Content":"间关几许伤怀处，"},{"Content":"悒悒柔情不自持。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[出晚]艺芸书舍影元钞本作[晚出]。[却怪]《名媛诗归》作[应怪]，上句[应]字复，据《名媛诗归》改。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":536003,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"问春古律"},"Clauses":[{"Content":"春到休论旧日情，"},{"Content":"风光还是一番新。"},{"Content":"莺花有恨偏供我，"},{"Content":"桃李无言祇恼人。"},{"Content":"粉泪洗干清瘦面，"},{"Content":"带围宽尽小腰身。"},{"Content":"东君负我春三月，"},{"Content":"我负东君三月春。"}]},{"Id":536004,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"诉春"},"Clauses":[{"Content":"十二栏杆锁画楼，"},{"Content":"春风吹损上帘钩。"},{"Content":"花心柳眼从教放，"},{"Content":"蝶意蜂情一任休。"},{"Content":"残滞酒怀消旧恨，"},{"Content":"禁持诗句遣新愁。"},{"Content":"东君若也怜孤独，"},{"Content":"莫使韶光便似秋。"}]},{"Id":96282,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"中春书事"},"Clauses":[{"Content":"乍暖还寒二月天，"},{"Content":"酿红酝绿斗新鲜。"},{"Content":"日烘春色成和气，"},{"Content":"风弄花香作瑞烟。"},{"Content":"莺舌似簧初学语，"},{"Content":"柳条如线未飞绵。"},{"Content":"金杯满酌黄封酒，"},{"Content":"欲劝东君莫放权。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[题]《千家诗选》作[春]，《宋元百家诗》　《名媛诗归》　《古今女史》作[仲春书事]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96302,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"歌","Rank":0,"Title":{"Content":"春日即事"},"Clauses":[{"Content":"轻寒噤㾕花期晚，"},{"Content":"皱绿差鳞接远波。"},{"Content":"跃藻白鱼翻玉尺，"},{"Content":"穿林黄鸟度金梭。"},{"Content":"闲将诗草临轩读，"},{"Content":"静听渔船隔岸歌。"},{"Content":"尽日倚窗情脉脉，"},{"Content":"眼前无事奈春何。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[诗草]《古今女史》作[花草]，误。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96308,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"春词二首"},"Clauses":[{"Content":"屋嗔柳叶噪春鸦，"},{"Content":"帘幕风轻燕翅斜。"},{"Content":"芳草池塘初梦断，"},{"Content":"海棠庭院正愁加。"},{"Content":"几声娇巧黄鹂舌，"},{"Content":"数朵柔纤小杏花。"},{"Content":"独倚庄窗梳洗倦，"},{"Content":"只惭辜负好年华。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[妆窗]《名媛诗归》 　《古今女史》作[小窗]。[祗惭]《名媛诗归》 　《古今女史》作[自惭]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96309,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"春词二首"},"Clauses":[{"Content":"屈指清明数日期，"},{"Content":"纷纷红紫竞芳菲。"},{"Content":"池塘水暖鹣鹣并，"},{"Content":"巷陌风轻燕燕飞。"},{"Content":"柳带万条笼淑景，"},{"Content":"游丝千尺网晴晖。"},{"Content":"人间何处无春色，"},{"Content":"祇是西楼人未归。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[竞]《武林》本作[竟]。[网]《宋元百家诗》《名媛诗归》 　《古今女史》作[舞]。[晴晖]《武林》本作[清辉]。[西楼]原缺，据艺芸书舍本　延客堂钞本补。铁琴　剑楼钞本作[天涯]，《武林》本作[团圆]。","IsComment":false,"FullPath":"朱淑真集"}]}],"Count":367,"PageNo":1,"PageSize":20}