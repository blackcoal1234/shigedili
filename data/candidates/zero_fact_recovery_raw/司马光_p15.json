{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80767,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"仁宗皇帝挽歌词二首"},"Clauses":[{"Content":"雾晓铜鱼跃，"},{"Content":"霜寒阊阖开。"},{"Content":"哀声际海发，"},{"Content":"灵仗拂天来。"},{"Content":"别寝严虚位，"},{"Content":"重阍閟夜台。"},{"Content":"柏城空有路，"},{"Content":"无复属车回。"}]},{"Id":81005,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"故相国颍公挽歌辞三首"},"Clauses":[{"Content":"儒衣临绝塞，"},{"Content":"庙略运奇兵。"},{"Content":"缓带羌尘静，"},{"Content":"灵旗海雾清。"},{"Content":"公心结明主，"},{"Content":"阴德庇群生。"},{"Content":"名遂身仍退，"},{"Content":"人间五福并。"}]},{"Id":81004,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"故相国颍公挽歌辞三首"},"Clauses":[{"Content":"铭旌远明灭，"},{"Content":"骑吹去低昂。","Comments":[{"Content":"原作次，据四库本改","Type":"Text","Index":2}]},{"Content":"三鼎功名大，"},{"Content":"重泉日月长。"},{"Content":"鹤飞来吊客，"},{"Content":"牛卧卜连冈。"},{"Content":"车马还城郭，"},{"Content":"悲风满白杨。"}]},{"Id":81003,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"故相国颍公挽歌辞三首"},"Clauses":[{"Content":"沧波与邓林，"},{"Content":"鱼鸟久飞沉。"},{"Content":"一旦成陈迹，"},{"Content":"何人识寸心。"},{"Content":"高山亡景行，"},{"Content":"流水失知音。"},{"Content":"泪尽离东阁，"},{"Content":"归来破故琴。","Comments":[{"Content":"以上《温国文正司马公文集》卷一○","Type":"Text","Index":5}]}]},{"Id":81162,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"寄题兴州晁都官东沼沼上有唐郑都官诗刻石","Comments":[{"Content":"仲约","Type":"Text","Index":7}]},"Clauses":[{"Content":"名郎游胜地，"},{"Content":"心迹继风流。"},{"Content":"昔为题诗著，"},{"Content":"今因好事修。"},{"Content":"四山相照映，"},{"Content":"五马屡淹留。"},{"Content":"想见波光净，"},{"Content":"依然一片秋。","Comments":[{"Content":"自注：郑诗云彻底千峰影，无风一片秋。","Type":"Text","Index":5}]}]},{"Id":81565,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"送周密学真定安抚使","Comments":[{"Content":"沆，字子真","Type":"Text","Index":4}]},"Clauses":[{"Content":"玉帐前茅举，","Comments":[{"Content":"原作牙，据陈本改","Type":"Text","Index":4}]},{"Content":"铜鱼左契分。"},{"Content":"平生公望著，"},{"Content":"期月政声闻。"},{"Content":"陌上壶浆溢，"},{"Content":"潭边花气曛。"},{"Content":"遥知待新将，"},{"Content":"民物两欣欣。"}]},{"Id":81258,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"赠狄节推","Comments":[{"Content":"国宾，梁公之孙","Type":"Text","Index":4}]},"Clauses":[{"Content":"天马云孙在，"},{"Content":"终然骨相奇。"},{"Content":"泥涂辱虽久，"},{"Content":"霜雪志难移。"},{"Content":"白发无嗟老，"},{"Content":"青衫莫厌卑。"},{"Content":"为山已九仞，"},{"Content":"高节肯中衰。"}]},{"Id":81029,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"送丁正臣知蔡州"},"Clauses":[{"Content":"䟃𧽼汝水滨，"},{"Content":"千骑拥朱轮。"},{"Content":"悬瓠遗基古，"},{"Content":"鞶囊吉梦新。"},{"Content":"丹心留紫闼，"},{"Content":"清耳远红尘。"},{"Content":"须识明君意，"},{"Content":"先应试治民。"}]},{"Id":81632,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"青","Rank":0,"Title":{"Content":"感春"},"Clauses":[{"Content":"积草满春庭，"},{"Content":"衡门永昼扃。"},{"Content":"波头何事白，"},{"Content":"柳眼为谁青。"},{"Content":"荣落浮云度，"},{"Content":"悲欢熟醉醒。"},{"Content":"繁华非我物，"},{"Content":"随意任飘零。"}]},{"Id":80812,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"光皇祐二年谒告归乡里至治平二年方得再来怆然感怀诗以纪事"},"Clauses":[{"Content":"十六载重归，"},{"Content":"顺涂歌式微。"},{"Content":"青松弊庐在，"},{"Content":"白首故人稀。"},{"Content":"外饰服章改，"},{"Content":"流光颜貌非。"},{"Content":"巫咸旧山色，"},{"Content":"相见尚依依。"}]},{"Id":81232,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"辞坟","Comments":[{"Content":"嘉祐元年，光通判并州，因公事至此，私（原作今，据四库本改）归拜祭，不敢至夏县而去，于今十年矣","Type":"Text","Index":2}]},"Clauses":[{"Content":"十年一展墓，"},{"Content":"旬浃复东旋。"},{"Content":"岂负襁褓爱，"},{"Content":"横遭章绶缠。"},{"Content":"更来知几日，"},{"Content":"遗恨恐终天。"},{"Content":"恸哭出松径，"},{"Content":"悲风为飒然。"}]},{"Id":81607,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"谒三门禹祠"},"Clauses":[{"Content":"信矣禹功美，"},{"Content":"独兼人鬼谋。"},{"Content":"长山忽中断，"},{"Content":"巨浸失横流。"},{"Content":"迹与天地久，"},{"Content":"民无鱼鳖忧。"},{"Content":"谁能报盛德，"},{"Content":"空尔荐醪羞。"}]},{"Id":499432,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"谒三门禹祠"},"Clauses":[{"Content":"赑屃青崖裂，"},{"Content":"喧豗白浪豪。"},{"Content":"客舟浮木叶，"},{"Content":"生理脱鸿毛。"},{"Content":"柏映孤峰短，","Comments":[{"Content":"自注：水际孤峰甚细而高，上有小柏，耆旧相传不知几何年矣，而止长尺馀，人莫测其理。","Type":"Text","Index":5}]},{"Content":"铭书绝壁高。","Comments":[{"Content":"自注：唐太宗刻铭砥柱之阴，魏郑公撰。字几盈尺，残缺仅可读。","Type":"Text","Index":5}]},{"Content":"河师不耕织，"},{"Content":"容易戏风涛。"}]},{"Id":81213,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"游三门开化寺"},"Clauses":[{"Content":"山石古来色，"},{"Content":"河流无尽声。"},{"Content":"行船自往返，"},{"Content":"群木几枯荣。"},{"Content":"狂象调难伏，"},{"Content":"空华灭复生。"},{"Content":"我来何所得，"},{"Content":"聊此濯尘缨。"}]},{"Id":81117,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"送僧归吴"},"Clauses":[{"Content":"高枕聊成梦，"},{"Content":"晴空忽见花。"},{"Content":"浮生尽是客，"},{"Content":"何处得为家。"},{"Content":"旅食帝城久，"},{"Content":"归舟泽国赊。"},{"Content":"勿因菰菜味，"},{"Content":"回首浩无涯。"}]},{"Id":81106,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"送晁秘丞通判雄州","Comments":[{"Content":"端彦，字长子","Type":"Text","Index":4}]},"Clauses":[{"Content":"少傅名德重，"},{"Content":"蔚然人物师。"},{"Content":"群孙满丹穴，"},{"Content":"嘉瑞尽长离。"},{"Content":"勿叹毛羽短，"},{"Content":"已惊文采奇。"},{"Content":"勉哉勤志业，"},{"Content":"馀庆未应衰。"}]},{"Id":80811,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"光顷为诸生常受经于钱丈学赋于张丈今乃叨忝同为侍臣蒙钱丈置酒张丈赐诗不胜愧悚之深言志为谢"},"Clauses":[{"Content":"畴昔胜冠日，"},{"Content":"曾为绛帐生。"},{"Content":"九言闻至教，"},{"Content":"一顾得虚声。"},{"Content":"不意叨严近，"},{"Content":"于今接老成。"},{"Content":"宁须诗酒赐，"},{"Content":"侍坐导知荣。"}]},{"Id":80857,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"宋相国公挽辞二首"},"Clauses":[{"Content":"仁圣初承绪，"},{"Content":"敷天吁隽贤。"},{"Content":"得人兹最盛，"},{"Content":"射策独居先。"},{"Content":"禁省英声远，"},{"Content":"岩廊至化宣。"},{"Content":"辞荣还故第，"},{"Content":"三事究高年。"}]},{"Id":80856,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"宋相国公挽辞二首"},"Clauses":[{"Content":"邦光华衮襚，","Comments":[{"Content":"陈本作补","Type":"Text","Index":5}]},{"Content":"家宝素书陈。"},{"Content":"东阁簪裾散，"},{"Content":"西芒宅兆新。"},{"Content":"泉台无复晓，"},{"Content":"柏径不知春。"},{"Content":"独有高文在，"},{"Content":"芬芳继古人。"}]},{"Id":80984,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"冬","Rank":0,"Title":{"Content":"英宗皇帝挽歌辞三首"},"Clauses":[{"Content":"盛德师尧舜，"},{"Content":"英姿肖祖宗。"},{"Content":"太阳光遍照，"},{"Content":"沧海量兼容。"},{"Content":"鸿业知能继，"},{"Content":"齐民望可封。"},{"Content":"如何未五载，"},{"Content":"已上鼎湖龙。"}]}],"Count":1270,"PageNo":15,"PageSize":20}