{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80884,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"和子骏新荷"},"Clauses":[{"Content":"懒不窥园久，"},{"Content":"元非效仲舒。"},{"Content":"新荷满沼密，","Comments":[{"Content":"原作绿，据陈本改","Type":"Text","Index":5}]},{"Content":"蓝舁出门疏。"},{"Content":"借问含烟晚，"},{"Content":"能胜裛露初。"},{"Content":"愧无鱼戏句，"},{"Content":"弄翰白纷如。"}]},{"Id":80795,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"司徒开府韩国富公挽辞四首"},"Clauses":[{"Content":"天祐休明祚，"},{"Content":"时生隽杰臣。"},{"Content":"贤科首多士，"},{"Content":"宰府泽生民。"},{"Content":"焕烂三台正，"},{"Content":"冲融四海春。"},{"Content":"欲知甄冶力，"},{"Content":"试问白头人。"}]},{"Id":80794,"Classes":["軍旅"],"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"司徒开府韩国富公挽辞四首"},"Clauses":[{"Content":"松漠骄无信，"},{"Content":"渔阳广聚兵。"},{"Content":"移书侮中国，"},{"Content":"决意背齐盟。"},{"Content":"直气轻轺入，"},{"Content":"英辞左衽惊。"},{"Content":"虏归烽火灭，"},{"Content":"宇县复升平。"}]},{"Id":80793,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"司徒开府韩国富公挽辞四首"},"Clauses":[{"Content":"大吕功名重，"},{"Content":"鸿毛轩冕轻。"},{"Content":"闲居客愈盛，"},{"Content":"暂出市皆倾。"},{"Content":"溟海涵容大，"},{"Content":"龙门谒见荣。"},{"Content":"谦光俨在目，","Comments":[{"Content":"原作内，据陈本改","Type":"Text","Index":5}]},{"Content":"恸哭望佳城。"}]},{"Id":80792,"GroupIndex":4,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"司徒开府韩国富公挽辞四首"},"Clauses":[{"Content":"杖屦还私第，"},{"Content":"精诚在本朝。"},{"Content":"爱君老不懈，"},{"Content":"忧国没方昭。"},{"Content":"东阁秋牢落，"},{"Content":"西芒夜寂寥。"},{"Content":"只应忠亮志，"},{"Content":"气运不能消。"}]},{"Id":81247,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"臧郎中挽歌二首"},"Clauses":[{"Content":"积庆承前烈，"},{"Content":"呈才会圣时。"},{"Content":"践杨朝有籍，"},{"Content":"治行吏为师。"},{"Content":"僚友皆亲誉，"},{"Content":"黎民每去思。"},{"Content":"惜哉违世早，"},{"Content":"志业未全施。"}]},{"Id":81246,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"臧郎中挽歌二首"},"Clauses":[{"Content":"素履存诚厚，"},{"Content":"虚怀待物真。"},{"Content":"乡闾昔相接，"},{"Content":"朋友世弥亲。"},{"Content":"遗札蝇头细，"},{"Content":"长阡马鬣新。"},{"Content":"九原那可作，"},{"Content":"空复想音尘。"}]},{"Id":80882,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"和子骏约游一二园亭看花遇雨而止"},"Clauses":[{"Content":"行乐及佳时，"},{"Content":"官闲无所羁。"},{"Content":"只知花正发，"},{"Content":"不共雨为期。"},{"Content":"浅草碧无际，"},{"Content":"浓云冷四垂。"},{"Content":"陪游兴未尽，"},{"Content":"安得不相思。","Comments":[{"Content":"自注：来诗云人寻载酒地，雨破看花期。又云感公行乐处，蚤莫得相思。","Type":"Text","Index":5}]}]},{"Id":80827,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"戏呈尧夫"},"Clauses":[{"Content":"近来朝野客，"},{"Content":"无坐不谈禅。"},{"Content":"顾我何为者，"},{"Content":"逢人独懵然。"},{"Content":"羡君诗既好，"},{"Content":"说佛众谁先。"},{"Content":"只恐前身是，"},{"Content":"东都白乐天。"}]},{"Id":81149,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"陪子华燕醮厅酒半过赵中令园","Comments":[{"Content":"原作听，据陈本、四库本改","Type":"Text","Index":6}]},"Clauses":[{"Content":"簪裾丞相阁，"},{"Content":"林沼令君家。"},{"Content":"烟曲香寻篆，"},{"Content":"杯深酒过花。"},{"Content":"霏微烬沈水，"},{"Content":"馥郁渍榠柤。"},{"Content":"愧乏相如赋，"},{"Content":"陪游托后车。"}]},{"Id":81152,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"陪致政开府太师留守相公致政内翰燕集辄歌盛美为三公寿皆用公字为韵 太师"},"Clauses":[{"Content":"独佐成康世，"},{"Content":"高年有毕公。"},{"Content":"神心降维岳，"},{"Content":"龟兆告非熊。"},{"Content":"黄阁遵成范，"},{"Content":"太常书茂功。"},{"Content":"归来保眉寿，"},{"Content":"恩礼享优隆。"}]},{"Id":81153,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"陪致政开府太师留守相公致政内翰燕集辄歌盛美为三公寿皆用公字为韵 相公"},"Clauses":[{"Content":"东阁延髦士，"},{"Content":"西都守别宫。"},{"Content":"不忘如卫武，"},{"Content":"难老似僖公。"},{"Content":"位貌今虽远，"},{"Content":"官僚旧忝同。"},{"Content":"开怀尽卮酒，"},{"Content":"足以厚时风。"}]},{"Id":81151,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"陪致政开府太师留守相公致政内翰燕集辄歌盛美为三公寿皆用公字为韵 内翰"},"Clauses":[{"Content":"眉似高僧秀，"},{"Content":"颜如童子红。"},{"Content":"忠纯汲长孺，"},{"Content":"高洁夏黄公。"},{"Content":"矫矫辽东鹤，"},{"Content":"冥冥塞北鸿。"},{"Content":"自誇新酒量，"},{"Content":"像想百分空。"}]},{"Id":80996,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"复用三公燕集韵酬子骏尧夫"},"Clauses":[{"Content":"官闲虚室白，"},{"Content":"粟饱太仓红。"},{"Content":"朝夕扫三径，"},{"Content":"往来从二公。"},{"Content":"蒹葭徒倚玉，"},{"Content":"燕雀岂知鸿。"},{"Content":"相遇辄同醉，","Comments":[{"Content":"陈本作过","Type":"Text","Index":2}]},{"Content":"惟愁樽酒空。"}]},{"Id":81058,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"送尧夫知河中府二首"},"Clauses":[{"Content":"耆老承风旧，"},{"Content":"丝纶锡命新。"},{"Content":"展禽安屡黜，"},{"Content":"原宪乐常贫。"},{"Content":"执志穷通壹，"},{"Content":"论交表里真。"},{"Content":"但祈深自重，"},{"Content":"膏泽望斯民。"}]},{"Id":81057,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"送尧夫知河中府二首"},"Clauses":[{"Content":"河抱城根曲，"},{"Content":"山侵地势斜。"},{"Content":"周馀古楼观，"},{"Content":"舜俗旧人家。"},{"Content":"回首游从阔，"},{"Content":"装怀牒诉哗。"},{"Content":"何时重载酒，"},{"Content":"同醉洛阳花。"}]},{"Id":80824,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"青","Rank":0,"Title":{"Content":"安之朝议哀辞二首"},"Clauses":[{"Content":"场屋推声价，"},{"Content":"朝绅仰典型。"},{"Content":"朱衣老卿列，"},{"Content":"白首恋亲庭。"},{"Content":"舟壑一朝失，"},{"Content":"泉台万古扃。"},{"Content":"音容宛在目，"},{"Content":"争免净飘零。"}]},{"Id":80823,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"安之朝议哀辞二首"},"Clauses":[{"Content":"乐易春阳暖，"},{"Content":"孤高秋气清。"},{"Content":"老惟知自适，"},{"Content":"贫不问为生。"},{"Content":"京兆开阡贵，"},{"Content":"延陵题墓荣。"},{"Content":"如何帝师笔，"},{"Content":"纯孝纪名卿。"}]},{"Id":80900,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"和尧夫见寄"},"Clauses":[{"Content":"志趣苦难合，"},{"Content":"伥伥何所依。"},{"Content":"逢君始相照，"},{"Content":"知我信为稀。"},{"Content":"忽报除书下，"},{"Content":"徒瞻征盖飞。"},{"Content":"相思千里远，"},{"Content":"洛浦又春归。"}]},{"Id":80899,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"和尧夫见寄"},"Clauses":[{"Content":"仁政如慈父，"},{"Content":"蒲人得所依。"},{"Content":"教条前后接，"},{"Content":"风迹古今稀。"},{"Content":"试郡才书最，"},{"Content":"还朝必奋飞。"},{"Content":"西台旧班列，"},{"Content":"犹望绣衣归。"}]}],"Count":1270,"PageNo":22,"PageSize":20}