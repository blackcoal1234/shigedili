{"Authors":{"Names":["司空曙"],"AuthorIds":[13632],"Dynasties":["Tang"]},"ShiData":[{"Id":43788,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"送王闰","Comments":[{"Content":"（一作润）。（一作耿湋诗）","Type":"Text","Index":3}]},"Clauses":[{"Content":"相送临汉水，","Comments":[{"Content":"一作寒","Type":"Text","Index":4}]},{"Content":"怆然望故关。"},{"Content":"江芜连梦泽，"},{"Content":"楚雪入商山。"},{"Content":"语我他年旧，"},{"Content":"看君此日还。"},{"Content":"因将自悲泪，"},{"Content":"一洒别离间。"}],"Comments":[{"Book":"《唐诗镜》","Content":"后四语写意流动。","IsComment":false,"FullPath":"《唐诗镜》"},{"Book":"《唐诗矩》","Content":"梦泽分手之地，商山所归之地，“楚雪入商山”写一路有雪，语特深秀。送人还乡，本不当坠泪，却因自己不得还乡，不禁悲泪流涟，用意最是曲折。","IsComment":false,"FullPath":"《唐诗矩》"},{"Book":"《删正二冯先生评定才调集》","Content":"纪云：一气浑成，风骨绝高，于此书为别调。","IsComment":false,"FullPath":"《删正二冯先生评定才调集》"}]},{"Id":12271,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"新蝉","Comments":[{"Content":"一作耿湋诗","Type":"Text","Index":2}]},"Clauses":[{"Content":"今朝蝉忽鸣，"},{"Content":"迁客若为情。","Comments":[{"Content":"一作羁","Type":"Text","Index":1}]},{"Content":"便觉一年老，","Comments":[{"Content":"一作渐","Type":"Text","Index":1},{"Content":"一作谢","Type":"Text","Index":5}]},{"Content":"能令万感生。"},{"Content":"微风方满树，","Comments":[{"Content":"一作初","Type":"Text","Index":3}]},{"Content":"落日稍沈城。"},{"Content":"为问同怀者，"},{"Content":"凄凉听几声。"}]},{"Id":12230,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"送永阳崔明府"},"Clauses":[{"Content":"古国群舒地，"},{"Content":"前当桐柏关。"},{"Content":"连绵江上雨，"},{"Content":"稠叠楚南山。"},{"Content":"沙馆行帆息，"},{"Content":"枫洲候吏还。","Comments":[{"Content":"一作州，一作舟","Type":"Text","Index":2}]},{"Content":"乘篮若有暇，"},{"Content":"精舍在林间。"}]},{"Id":12248,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"送曹三同猗游山寺","Comments":[{"Content":"一作原","Type":"Text","Index":4},{"Content":"一作桐椅","Type":"Text","Index":5}]},"Clauses":[{"Content":"山蹋青芜尽，"},{"Content":"凉秋古寺深。"},{"Content":"何时得连策，"},{"Content":"此夜更闻琴。"},{"Content":"穷水云同穴，"},{"Content":"过僧虎共林。"},{"Content":"殷勤如念我，"},{"Content":"遗尔挂冠心。"}]},{"Id":12247,"Classes":["軍旅 送行"],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"送崔校书赴梓幕"},"Clauses":[{"Content":"碧峰天柱下，"},{"Content":"鼓角镇南军。"},{"Content":"管记催飞檄，"},{"Content":"蓬莱辍校文。"},{"Content":"栈霜朝似雪，"},{"Content":"江雾晚成云。"},{"Content":"想出褒中望，"},{"Content":"巴庸方路分。"}]},{"Id":12255,"Allusions":[{"AllusionIndex":1414,"AllusionKey":"来云去雨","SentenceIndex":2},{"AllusionIndex":5641,"AllusionKey":"两岐歌","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"送夔州班使君"},"Clauses":[{"Content":"鱼国巴庸路，","Comments":[{"Content":"一作蜀","Type":"Text","Index":1}]},{"Content":"麾幢汉守过。"},{"Content":"晓樯争市隘，"},{"Content":"夜鼓祭神多。"},{"Content":"云白当山雨，"},{"Content":"风清满峡波。"},{"Content":"夷陵旧人吏，"},{"Content":"犹诵两岐歌。","Comments":[{"Content":"两岐歌","Type":"AllusionKey","Index":5}]}]},{"Id":12250,"Allusions":[{"AllusionIndex":9548,"AllusionKey":"浔阳隐","SentenceIndex":3},{"AllusionIndex":10823,"AllusionKey":"洙泗","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"送菊潭王明府"},"Clauses":[{"Content":"业成洙泗客，","Comments":[{"Content":"洙泗","Type":"AllusionKey","Index":4}]},{"Content":"皓发著儒衣。"},{"Content":"一与游人别，"},{"Content":"仍闻带印归。"},{"Content":"林多宛地古，"},{"Content":"云尽汉山稀。"},{"Content":"莫爱浔阳隐，","Comments":[{"Content":"浔阳隐","Type":"AllusionKey","Index":5}]},{"Content":"嫌官计亦非。"}]},{"Id":12222,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"送太易上人赴东洛"},"Clauses":[{"Content":"遥见登山处，"},{"Content":"青芜雪后春。"},{"Content":"云深岳庙火，"},{"Content":"寺宿洛阳人。"},{"Content":"饵药将斋折，"},{"Content":"唯诗与道亲。"},{"Content":"凡经几回别，"},{"Content":"麈尾不离身。"}]},{"Id":12196,"Allusions":[{"AllusionIndex":2965,"AllusionKey":"闻笛","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"冬夜耿拾遗王秀才就宿因伤故人"},"Clauses":[{"Content":"旧时闻笛泪，","Comments":[{"Content":"闻笛","Type":"AllusionKey","Index":4}]},{"Content":"今夜重沾衣。"},{"Content":"方恨同人少，","Comments":[{"Content":"一作袍","Type":"Text","Index":4}]},{"Content":"何堪相见稀。"},{"Content":"竹烟凝涧壑，"},{"Content":"林雪似芳菲。"},{"Content":"多谢劳车马，"},{"Content":"应怜独掩扉。"}]},{"Id":12200,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"早春游慈恩南池","Comments":[{"Content":"一作报","Type":"Text","Index":4}]},"Clauses":[{"Content":"山寺临池水，"},{"Content":"春愁望远生。"},{"Content":"蹋桥逢鹤起，"},{"Content":"寻竹值泉横。"},{"Content":"新柳丝犹短，"},{"Content":"轻蘋叶未成。","Comments":[{"Content":"一作柔","Type":"Text","Index":1}]},{"Content":"还如虎溪上，"},{"Content":"日暮伴僧行。"}]},{"Id":12214,"Allusions":[{"AllusionIndex":9339,"AllusionKey":"谢文学","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"雨夜见投之作"},"Clauses":[{"Content":"出户繁星尽，"},{"Content":"池塘暗不开。"},{"Content":"动衣凉气度，"},{"Content":"遰树远声来。"},{"Content":"灯外初行电，"},{"Content":"城隅偶隐雷。","Comments":[{"Content":"一作忽","Type":"Text","Index":3}]},{"Content":"因知谢文学，","Comments":[{"Content":"谢文学","Type":"AllusionKey","Index":5}]},{"Content":"晓望比尘埃。"}]},{"Id":12198,"Allusions":[{"AllusionIndex":2265,"AllusionKey":"今古一南楼","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"龙池寺望月寄韦使君阎别驾"},"Clauses":[{"Content":"清光此夜中，"},{"Content":"万古望应同。"},{"Content":"当野山沈雾，"},{"Content":"低城树有风。"},{"Content":"花宫纷共邃，"},{"Content":"水府皓相空。"},{"Content":"遥想高楼上，"},{"Content":"唯君对庾公。","Comments":[{"Content":"一作望","Type":"Text","Index":3}]}]},{"Id":12219,"Allusions":[{"AllusionIndex":4342,"AllusionKey":"惠休","SentenceIndex":3},{"AllusionIndex":8612,"AllusionKey":"右军","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"秋夜忆兴善院寄苗发"},"Clauses":[{"Content":"右军多住寺，","Comments":[{"Content":"右军","Type":"AllusionKey","Index":2}]},{"Content":"此夜后池秋。"},{"Content":"自与山僧伴，"},{"Content":"那因洛客愁。"},{"Content":"卷帘霜霭霭，"},{"Content":"满目水悠悠。"},{"Content":"若有诗相赠，"},{"Content":"期君忆惠休。","Comments":[{"Content":"惠休","Type":"AllusionKey","Index":5}]}]},{"Id":12257,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"病中寄郑十六兄","Comments":[{"Content":"一本题下有概字","Type":"Text","Index":7}]},"Clauses":[{"Content":"倦枕欲徐行，"},{"Content":"开帘秋月明。"},{"Content":"手便筇杖冷，"},{"Content":"头喜葛巾轻。"},{"Content":"绿草前侵水，"},{"Content":"黄花半上城。"},{"Content":"虚消此尘景，"},{"Content":"不见十年兄。"}]},{"Id":12191,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"卫明府寄枇杷叶以诗荅"},"Clauses":[{"Content":"倾筐呈绿叶，"},{"Content":"重叠色何鲜。"},{"Content":"讵是秋风里，"},{"Content":"犹如晓露前。","Comments":[{"Content":"一作传","Type":"Text","Index":5}]},{"Content":"仙方当见重，"},{"Content":"消疾本应便。"},{"Content":"全胜甘蕉赠，"},{"Content":"空投谢氏篇。"}]},{"Id":12205,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"过庆宝寺","Comments":[{"Content":"一作耿湋诗，题作废宝光寺。","Type":"Text","Index":4}]},"Clauses":[{"Content":"黄叶前朝寺，"},{"Content":"无僧寒殿开。","Comments":[{"Content":"一作闲","Type":"Text","Index":3}]},{"Content":"池晴龟出曝，"},{"Content":"松暮鹤飞回。","Comments":[{"Content":"一作暝","Type":"Text","Index":2}]},{"Content":"古井碑横草，","Comments":[{"Content":"一作砌","Type":"Text","Index":2}]},{"Content":"阴廊画杂苔。"},{"Content":"禅宫亦销歇，","Comments":[{"Content":"一作衰","Type":"Text","Index":4}]},{"Content":"尘世转堪哀。"}],"Comments":[{"Book":"《瀛奎律髓》","Content":"此必武宗废寺之后有此诗。句句工，尾句尤不露。","IsComment":false,"FullPath":"《瀛奎律髓》"},{"Book":"《唐诗品汇》","Content":"刘云：起结皆好。","IsComment":false,"FullPath":"《唐诗品汇》"},{"Book":"《载酒园诗话》","Content":"“池晴龟出曝，松瞑鹤飞翔”，写景亦佳。","IsComment":false,"FullPath":"《载酒园诗话》"},{"Book":"《瀛奎律髓汇评》","Content":"冯舒：首联“经废”。何义门：此假废寺以寓天宝乱后，两都禾黍，百姓虫沙。落句即仲宣之《七哀》也。文明，大历才子，当论其世。纪昀：六句如画。结拓开，好。","IsComment":false,"FullPath":"《瀛奎律髓汇评》"},{"Book":"《诗式》","Content":"发句切废寺入，上句“黄叶”，下句“无僧”，系从废寺设想。颔联赋物，“龟出曝”、“鹤飞回”见寺已废，不见人，只见池上龟、松间鹤而已，句奇而趣。颈联赋寺宇，“碑横草”、“画杂苔”见一种圮毁之象。落句有凭吊之意，上句是进一步写法，言寺本方外所居，何与人间事，而亦有废兴之感；下句是放一句结法，言寺犹如此，尘世之盛衰不重堪叹耶？“转”宇与上“亦”字对照。[品]感慨。","IsComment":false,"FullPath":"《诗式》"}]},{"Id":12213,"Allusions":[{"AllusionIndex":1422,"AllusionKey":"荷衣","SentenceIndex":1},{"AllusionIndex":5719,"AllusionKey":"铃阁","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"奉和张大夫酬高山人"},"Clauses":[{"Content":"野客居铃阁，","Comments":[{"Content":"铃阁","Type":"AllusionKey","Index":5}]},{"Content":"重门将校稀。"},{"Content":"豸冠亲谷弁，"},{"Content":"龟印识荷衣。","Comments":[{"Content":"荷衣","Type":"AllusionKey","Index":5}]},{"Content":"座右寒飙爽，","Comments":[{"Content":"一作坐久","Type":"Text","Index":2},{"Content":"一作泉","Type":"Text","Index":4}]},{"Content":"谈馀暮角微。"},{"Content":"苍生须太傅，"},{"Content":"山在岂容归。"}]},{"Id":12235,"Allusions":[{"AllusionIndex":1792,"AllusionKey":"三户","SentenceIndex":0},{"AllusionIndex":2011,"AllusionKey":"鄂君船","SentenceIndex":3},{"AllusionIndex":5777,"AllusionKey":"一钱","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"送严使君游山"},"Clauses":[{"Content":"家楚依三户，","Comments":[{"Content":"三户","Type":"AllusionKey","Index":5}]},{"Content":"辞州选一钱。","Comments":[{"Content":"一钱","Type":"AllusionKey","Index":5}]},{"Content":"酒杯同寄世，"},{"Content":"客棹任销年。"},{"Content":"赤烧兼山远，"},{"Content":"青芜与浪连。"},{"Content":"青春明月夜，"},{"Content":"知上鄂君船。","Comments":[{"Content":"鄂君船","Type":"AllusionKey","Index":5}]}]},{"Id":12243,"Allusions":[{"AllusionIndex":766,"AllusionKey":"先鞭","SentenceIndex":2},{"AllusionIndex":1463,"AllusionKey":"登榻","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"送柳震归蜀"},"Clauses":[{"Content":"白日双流静，"},{"Content":"西看蜀国春。"},{"Content":"桐花能乳鸟，"},{"Content":"竹节竞祠神。"},{"Content":"蹇步徒相望，"},{"Content":"先鞭不可亲。","Comments":[{"Content":"先鞭","Type":"AllusionKey","Index":2}]},{"Content":"知从江仆射，"},{"Content":"登榻更何人。","Comments":[{"Content":"登榻","Type":"AllusionKey","Index":2}]}]},{"Id":12312,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"送乐平苗明府"},"Clauses":[{"Content":"天际山多处，"},{"Content":"东安古邑深。","Comments":[{"Content":"一作邑更","Type":"Text","Index":4}]},{"Content":"绿田通竹里，"},{"Content":"白浪隔枫林。"},{"Content":"诗有江僧和，"},{"Content":"门唯越客寻。"},{"Content":"应将放鱼化，"},{"Content":"一境表吾心。"}]}],"Count":165,"PageNo":0,"PageSize":20}