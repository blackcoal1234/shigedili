{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80734,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"八月五日夜省直"},"Clauses":[{"Content":"大火已西落，"},{"Content":"温风犹袭人。"},{"Content":"留连惜纨扇，"},{"Content":"散诞脱纱巾。"},{"Content":"蟾影夜色浅，"},{"Content":"蛩声秋意新。"},{"Content":"图书足自适，"},{"Content":"何物更关身。"}]},{"Id":81041,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"送王著作西京签判","Comments":[{"Content":"慥","Type":"Text","Index":4}]},"Clauses":[{"Content":"古来都邑美，"},{"Content":"孰与雒阳先。"},{"Content":"况复元侯贵，"},{"Content":"兼之从事贤。"},{"Content":"玦离横阙塞，"},{"Content":"珠曲逗伊川。"},{"Content":"慰眼登临乐，"},{"Content":"送君空惘然。"}]},{"Id":81180,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"梅圣俞挽歌二首"},"Clauses":[{"Content":"兵形穷胜负，"},{"Content":"史法贯兴衰。"},{"Content":"落落虽殊众，"},{"Content":"恂恂不迕时。"},{"Content":"位卑名自重，"},{"Content":"才大命须奇。"},{"Content":"世俗那能识，"},{"Content":"伤嗟止为诗。","Comments":[{"Content":"原作正，据陈本改","Type":"Text","Index":3}]}]},{"Id":81179,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"梅圣俞挽歌二首"},"Clauses":[{"Content":"漆灯无复曙，"},{"Content":"柏径不知春。"},{"Content":"南纪光华减，"},{"Content":"中朝俊秀贫。"},{"Content":"凄清千古韵，"},{"Content":"寂寞一丘尘。"},{"Content":"异日昭亭下，"},{"Content":"方多沥酒人。"}]},{"Id":81119,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"送裴中舍赴太原幕府","Comments":[{"Content":"士杰","Type":"Text","Index":4}]},"Clauses":[{"Content":"元戎台鼎旧，"},{"Content":"大府节旄新。"},{"Content":"边候正无事，"},{"Content":"宾筵况得人。"},{"Content":"山寒太行晓，"},{"Content":"水碧晋祠春。"},{"Content":"斋酿蒲萄熟，"},{"Content":"飞觞不厌频。"}]},{"Id":81146,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"郭氏园送张仲通出刺棣州","Comments":[{"Content":"得朝字","Type":"Text","Index":11}]},"Clauses":[{"Content":"名园送嘉客，"},{"Content":"冠盖去倾朝。"},{"Content":"小雨尘微敛，"},{"Content":"馀寒酒易消。"},{"Content":"雁归春近塞，"},{"Content":"日上海生潮。"},{"Content":"北道平如掌，"},{"Content":"东风五马骄。"}]},{"Id":81073,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"送宋郎中知凤翔府"},"Clauses":[{"Content":"昔解陈仓印，"},{"Content":"于今二十秋。"},{"Content":"双凫久东上，"},{"Content":"五马重西游。"},{"Content":"铙骑行关外，"},{"Content":"壶浆拥道周。"},{"Content":"民心已化服，"},{"Content":"条教不更修。"}]},{"Id":81609,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"喜李侍郎得西京留台","Comments":[{"Content":"东之","Type":"Text","Index":4}]},"Clauses":[{"Content":"贱子何为者，"},{"Content":"栖栖今二毛。"},{"Content":"沧波浮片叶，"},{"Content":"大块载秋毫。"},{"Content":"利物物何补，"},{"Content":"营身身已劳。"},{"Content":"羡君遗世网，"},{"Content":"脱屣一何高。"}]},{"Id":80976,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"始平公新作双樗庵命光为诗"},"Clauses":[{"Content":"间气生王佐，"},{"Content":"多才秉国钧。"},{"Content":"栋隆凭杞梓，"},{"Content":"节劲仰松筠。"},{"Content":"底绩承平业，"},{"Content":"遗荣寿考身。"},{"Content":"结庐依散木，"},{"Content":"退让乐天真。"}]},{"Id":80978,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"忝职谏垣日负忧畏缅思云夫处士老兄萧然物外何乐如之因成浮槎诗寄献以抒鄙怀"},"Clauses":[{"Content":"秋水浮槎客，"},{"Content":"漂如一叶轻。"},{"Content":"鸥群须仗信，"},{"Content":"鲸口几忘生。"},{"Content":"耿耿天津阔，"},{"Content":"滔滔海浪惊。"},{"Content":"何时还故土，"},{"Content":"怀糈问君平。"}]},{"Id":81036,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"送元待制出牧福唐","Comments":[{"Content":"绛，字厚之","Type":"Text","Index":4}]},"Clauses":[{"Content":"瓯越东南美，"},{"Content":"田肥果稼饶。"},{"Content":"况怀新赐绶，"},{"Content":"重过旧题桥。"},{"Content":"食足奸回熄，"},{"Content":"风移狱犴销。"},{"Content":"长才报政速，"},{"Content":"铃阁日逍遥。"}]},{"Id":81070,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"送吴驾部知真州","Comments":[{"Content":"处厚","Type":"Text","Index":4}]},"Clauses":[{"Content":"向托屏星驾，"},{"Content":"同随丞相车。"},{"Content":"终朝容懒拙，"},{"Content":"经岁庇迂疏。"},{"Content":"共此趋云阙，"},{"Content":"旋闻建隼旟。"},{"Content":"江淮一都会，"},{"Content":"游刃必多馀。"}]},{"Id":81169,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"寄题钱君倚明州重修众乐亭"},"Clauses":[{"Content":"横桥通废岛，"},{"Content":"华宇出荒榛。"},{"Content":"风日逢知已，"},{"Content":"湖山得主人。"},{"Content":"使君如独乐，"},{"Content":"众庶必深颦。"},{"Content":"何以知家给，"},{"Content":"笙歌满水滨。"}]},{"Id":80859,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"张元常挽歌二首"},"Clauses":[{"Content":"为吏文无害，"},{"Content":"临民政不苛。"},{"Content":"浑金生自美，"},{"Content":"古井澹无波。"},{"Content":"方喜风鹏举，"},{"Content":"旋闻隙驷过。"},{"Content":"善人宜寿考，"},{"Content":"报施定如何。"}]},{"Id":80858,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"张元常挽歌二首"},"Clauses":[{"Content":"秀眉无足验，"},{"Content":"结轖遽为灾。"},{"Content":"乡曲三年别，"},{"Content":"江山万里回。"},{"Content":"林闾飞旐入，"},{"Content":"书剑逐舟来。"},{"Content":"坟草枯还绿，"},{"Content":"重泉不复开。"}]},{"Id":81348,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"冬夜"},"Clauses":[{"Content":"冬夜何其永，"},{"Content":"寒光四泬寥。"},{"Content":"雁横星历历，"},{"Content":"人静漏迢迢。"},{"Content":"破屋霜应重，"},{"Content":"荒庭雪未消。"},{"Content":"不眠何所念，"},{"Content":"达晓思无憀。"}]},{"Id":80973,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"奉和御制龙图等阁观三圣御书","Comments":[{"Content":"嘉祐七年十二月十七日上（注原缺，据陈本、四库本补）","Type":"Text","Index":13}]},"Clauses":[{"Content":"积厚丕丕业，"},{"Content":"重光郁郁文。"},{"Content":"宝书垂列宿，"},{"Content":"玉字切浮云。"},{"Content":"散帙鸣銮驻，"},{"Content":"充庭杂佩分。"},{"Content":"愿移天纵艺，"},{"Content":"似续圣功勤。"}]},{"Id":80747,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"又和雪霁"},"Clauses":[{"Content":"南宫来几时，"},{"Content":"挟纩易春衣。"},{"Content":"意谓花将晚，"},{"Content":"何言雪尚飞。"},{"Content":"夜声通旅枕，"},{"Content":"晓色弄晴晖。"},{"Content":"继日劳王事，"},{"Content":"离离雁已归。"}]},{"Id":80741,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"又和二月五日夜风雪"},"Clauses":[{"Content":"春风正豪怒，"},{"Content":"夜雪复飘扬。"},{"Content":"勿使羁愁乱，"},{"Content":"自知清兴长。"},{"Content":"帘疏声淅沥，"},{"Content":"灯冷晕微茫。"},{"Content":"此夕牛衣客，"},{"Content":"成名不可忘。"}]},{"Id":80768,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"仁宗皇帝挽歌词二首"},"Clauses":[{"Content":"声教万馀里，"},{"Content":"文明四十春。"},{"Content":"茂勋留信史，"},{"Content":"盛德满生民。"},{"Content":"共适禽鱼乐，"},{"Content":"安知橐籥仁。"},{"Content":"百年龙驭远，"},{"Content":"空复仰威神。"}]}],"Count":1270,"PageNo":14,"PageSize":20}