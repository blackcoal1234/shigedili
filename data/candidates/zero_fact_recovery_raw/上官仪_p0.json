es":[{"Content":"木落园林旷，"},{"Content":"庭虚风露寒。"},{"Content":"北里清音绝，"},{"Content":"南陔芳草残。","Comments":[{"Content":"南陔","Type":"AllusionKey","Index":2}]},{"Content":"远气犹标剑，"},{"Content":"浮云尚写冠。"},{"Content":"寂寂琴台晚，"},{"Content":"秋阴入井干。"}]},{"Id":4777,"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"高密长公主挽歌"},"Clauses":[{"Content":"湘渚韬灵迹，"},{"Content":"娥台静瑞音。"},{"Content":"凤逐清箫远，"},{"Content":"鸾随幽镜沈。"},{"Content":"霜处华芙落，","Comments":[{"Content":"一作英","Type":"Text","Index":4}]},{"Content":"风前银烛侵。"},{"Content":"寂寞平阳宅，","Comments":[{"Content":"一作馆","Type":"Text","Index":5}]},{"Content":"月冷洞房深。"}]},{"Id":826996,"GroupIndex":1,"Froms":["全唐诗续补遗"],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"五言奉和咏棋应诏"},"Clauses":[{"Content":"宝局光仙岫，"},{"Content":"瑶棋掩帝台。"},{"Content":"图云双阵起，"},{"Content":"雁写两行开。"},{"Content":"固节修常道，"},{"Content":"侵边慎祸胎。"},{"Content":"□□□储妙，"},{"Content":"空挹季长才。"}]},{"Id":826997,"GroupIndex":2,"Froms":["全唐诗续补遗"],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"五言奉和咏棋应诏"},"Clauses":[{"Content":"定位资裨将，"},{"Content":"制变伫中权。"},{"Content":"重关□宿立，"},{"Content":"六出带花圆。"},{"Content":"引寇疏疑绝，"},{"Content":"窥强怯未前。"},{"Content":"金枰自韫粹，"},{"Content":"玉帐岂能传。","Comments":[{"Content":"同前","Type":"Text","Index":5}]}]},{"Id":827000,"Froms":["全唐诗续补遗"],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"五言侍宴延庆殿同赋别离得凌霜雁应诏"},"Clauses":[{"Content":"凉沙起关塞，"},{"Content":"候雁下江干。"},{"Content":"流声度迥月，"},{"Content":"浮影入长澜。"},{"Content":"系书天路远，"},{"Content":"避缴晓风寒。"},{"Content":"□□□□曲，"},{"Content":"先惊霜翮残。","Comments":[{"Content":"同前","Type":"Text","Index":5}]}]},{"Id":4773,"Classes":["題畫 仕女"],"Froms":["御定历代题画诗类卷六十 仕女类"],"Allusions":[{"AllusionIndex":1414,"AllusionKey":"行雨","SentenceIndex":3},{"AllusionIndex":1494,"AllusionKey":"凌波","SentenceIndex":3}],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"Title":{"Content":"咏画障"},"Clauses":[{"Content":"芳晨丽日桃花浦，"},{"Content":"珠帘翠帐凤凰楼。"},{"Content":"蔡女菱歌移锦缆，"},{"Content":"燕姬春望上琼钩。"},{"Content":"新妆漏影浮轻扇，"},{"Content":"冶袖飘香入浅流。"},{"Content":"未减行雨荆台下，","Comments":[{"Content":"一作云","Type":"Text","Index":4},{"Content":"行雨","Type":"AllusionKey","Index":4}]},{"Content":"自比凌波洛浦游。","Comments":[{"Content":"凌波","Type":"AllusionKey","Index":4}]}]},{"Id":4769,"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"入朝洛堤步行"},"Clauses":[{"Content":"脉脉广川流，"},{"Content":"驱马历长洲。"},{"Content":"鹊飞山月曙，"},{"Content":"蝉噪野风秋。"}],"Comments":[{"Book":"《隋唐嘉话》","Content":"高宗承贞观之后，天下无事。上官侍郎仪独持国政，尝凌晨入朝，巡洛水堤，步月徐辔，咏诗云：“脉脉广川流，驱马历长洲。鹊飞山月晓，蝉噪野风秋。”音韵清亮，群公望之，犹神仙焉。","IsComment":false,"FullPath":"《隋唐嘉话》"},{"Book":"《唐音癸签》","Content":"上官仪“鹊飞山月晓，蝉噪野风秋”，率尔出风致语，佳耳。张说“雁飞江月冷，猿啸野风秋”，似有意学之，那得佳？欧公力拟温飞卿警联不及，亦同此。","IsComment":false,"FullPath":"《唐音癸签》"},{"Book":"《唐诗观澜集》","Content":"“雀飞山月曙，蝉噪野风秋”，徐、庾遗响。","IsComment":false,"FullPath":"《唐诗观澜集》"},{"Book":"《唐人万首绝句选评》","Content":"景语神采，在王、裴上。写景沉着，格调亦雍容满足。","IsComment":false,"FullPath":"《唐人万首绝句选评》"},{"Book":"《诗境浅说续编》","Content":"此早朝途中所作。“鹊飞”、“蝉噪”二句，写洛堤晓行，风景如画，诗句复清远而有神韵。昔张文潜举昌黎、柳州五言佳句，以韩之“清雨卷归旗”一联、柳之“门掩候虫秋”一联为压卷，上官之作，可方美韩、柳矣。","IsComment":false,"FullPath":"《诗境浅说续编》"},{"Book":"国学网站","Content":"上官仪是初唐宫廷作家，齐梁余风的代表诗人，其词绮错婉媚，有“上官体”之称。刘饣束《隋唐嘉话》载，唐高宗“承贞观之后，天下无事。仪独持国政。尝凌晨入朝，巡洛水堤，步月徐辔，”即兴吟咏了这首诗。当时一起等候入朝的官僚们，觉得“音韵清亮”，“望之犹神仙焉”。可<br/>知这诗是上官仪为宰相时所作，在唐高宗龙朔年间（661－663），正是他最得意之际。<br/><br/>这首诗是写他在东都洛阳皇城外等候入宫朝见时的情怀。唐初，百官上早朝并没有待漏院可供休息，必须在破晓前赶到皇城外等着。东都洛阳的皇城，傍洛水，城门外便是天津桥。唐代宫禁戒严，天津桥入夜落锁，断绝交通，到天明才开锁放行。所以上早朝的百官都在桥下洛堤上隔水等候<br/>放行入宫，宰相亦然。不过宰相毕竟是百官之首，虽然一例等候洛堤，但气派自非他官可比。<br/><br/>诗的前二句写驱马沿洛堤来到皇城外等候。“广川”指洛水，“长洲”谓洛堤。洛堤是官道，以便车马通行，故喻称“长洲”。首句不仅以洛水即景起兴，谓洛水含情不语地流着；更是化用《古诗·迢迢牵牛星》“盈盈一水间，脉脉不得语”，以男女喻君臣，暗示皇帝对自己的信任，流露<br/>首承恩得意的神气。因而接着写驱马洛堤，用一个“历”字，表现出一种心意悠然、镇定自若的风度。<br/><br/>后二句是即景抒怀。这是秋天的一个凌晨，曙光已见，月挂西山，宿鸟出林，寒蝉嘶鸣，野外晨风吹来，秋意更盛。在写景中，这位宰相巧用了两个前人的诗意。第三句写凌晨，用了曹操《短歌行》：“月明星稀，乌鹊南飞，绕树三匝，何枝可依。山不厌高，海不厌深，周公吐哺，天下归<br/>心。”原意是借夜景以忧虑天下士人不安，要礼贤下士以揽人心。这里取其意而谓曙光已见，鹊飞报喜，见出天下太平景象，又流露着自己执政治世的气魄。末句写秋意，用了陈朝张正见《赋得寒树晚蝉疏》：“寒蝉噪杨柳，朔吹犯梧桐。……还因摇落处，寂寞尽秋风。”原意讽喻寒士失<br/>意不平，这里借以暗示在野失意者的不平之鸣，为这太平盛世带来噪音，而令这位宰相略有不安，稍露不悦。<br/><br/>总起来看，这诗确属上官仪得意时的精心之作。它的意境和情调都不高，在得意倨傲、自尊自贵之中，于帝王婉转献媚，对贫寒作势利眼。不过，它也有认识意义，倒是真实地为这类得势汉权的宫廷文人留下一幅生动写照。从艺术上看，这寥寥二十字，不只是“音韵清亮”，谐律上口，而<br/>且巧二构思，善于用事，精心修辞，把当时的得意神气表现得相当突出，难怪那些有幸亲聆的官僚们“望之犹神仙焉”。<br/>（倪其心）","IsComment":false,"FullPath":"国学网站"}]},{"Id":4770,"Allusions":[{"AllusionIndex":7355,"AllusionKey":"塞上翁","SentenceIndex":1}],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"Title":{"Content":"从驾闾山咏马"},"Clauses":[{"Content":"桂香尘处减，"},{"Content":"练影月前空。"},{"Content":"定惑由关吏，","Comments":[{"Content":"一作乏函","Type":"Text","Index":3}]},{"Content":"徒嗟塞上翁。","Comments":[{"Content":"塞上翁","Type":"AllusionKey","Index":5}]}]},{"Id":827001,"Froms":["全唐诗续补遗"],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"真","Rank":0,"Title":{"Content":"假作屏风诗"},"Clauses":[{"Content":"绿叶霜中夏，"},{"Content":"红花雪里春。"},{"Content":"去马不移迹，","Comments":[{"Content":"《诗格》作「足」","Type":"Text","Index":5}]},{"Content":"来车岂动轮。","Comments":[{"Content":"《诗格》作「尘」。此首为直言志","Type":"Text","Index":5}]}]},{"Id":827002,"Froms":["全唐诗续补遗"],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"齐","Rank":0,"Title":{"Content":"假作赠别诗"},"Clauses":[{"Content":"离情弦上急，","Comments":[{"Content":"《诗格》作「怨」","Type":"Text","Index":5}]},{"Content":"别曲雁边嘶。"},{"Content":"低云百种郁，","Comments":[{"Content":"一作「千过」","Type":"Text","Index":4}]},{"Content":"垂露几行啼。","Comments":[{"Content":"一作「千」","Type":"Text","Index":3},{"Content":"此首为比附志。","Type":"Text","Index":5}]}]},{"Id":827003,"Froms":["全唐诗续补遗"],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"Title":{"Content":"假作幽兰诗"},"Clauses":[{"Content":"日月虽不照，"},{"Content":"馨香要自丰。","Comments":[{"Content":"一作「多」","Type":"Text","Index":2}]},{"Content":"有怨生幽地，"},{"Content":"无由逐远风。","Comments":[{"Content":"《诗格》作「情」","Type":"Text","Index":2},{"Content":"此首为寄怀志。","Type":"Text","Index":5}]}]},{"Id":827004,"Froms":["全唐诗续补遗"],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"鱼","Rank":0,"Title":{"Content":"假作赋得鲁司寇诗"},"Clauses":[{"Content":"隐见通荣辱，"},{"Content":"行藏备卷舒。"},{"Content":"避席谈曾子，"},{"Content":"趋庭诲伯鱼。","Comments":[{"Content":"此首为起赋志。","Type":"Text","Index":5}]}]},{"Id":827005,"Froms":["全唐诗续补遗"],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"庚","Rank":0,"Title":{"Content":"假作田家诗"},"Clauses":[{"Content":"有意嫌千石，"},{"Content":"无心羡九卿。"},{"Content":"且悦丘园好，","Comments":[{"Content":"《诗格》作「死」","Type":"Text","Index":5}]},{"Content":"何论冠盖生。","Comments":[{"Content":"《诗格》作「未甘冠盖荣」。此首为贬毁志。","Type":"Text","Index":5}]}]},{"Id":4779,"Allusions":[{"AllusionIndex":2047,"AllusionKey":"大风曲","SentenceIndex":3},{"AllusionIndex":3800,"AllusionKey":"汉筑","SentenceIndex":3}],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"排律","TypeDetail":"WuPai","Rhyme":"尤","Rank":0,"Title":{"Content":"奉和过旧宅应制"},"Clauses":[{"Content":"石关清晚夏，"},{"Content":"璇舆御早秋。"},{"Content":"神麾飏珠雨，"},{"Content":"仙吹响飞流。"},{"Content":"沛水祥云泛，"},{"Content":"宛郊瑞气浮。"},{"Content":"大风迎汉筑，","Comments":[{"Content":"一作凝","Type":"Text","Index":3},{"Content":"一作筑","Type":"Text","Index":5},{"Content":"汉筑","Type":"AllusionKey","Index":5}]},{"Content":"丛烟入舜球。"},{"Content":"翠梧临凤邸，"},{"Content":"滋兰带鹤舟。"},{"Content":"偃伯歌玄化，"},{"Content":"扈跸颂王游。"},{"Content":"遗簪谬昭奖，","Comments":[{"Content":"一作诏","Type":"Text","Index":4}]},{"Content":"珥笔荷恩休。"}]},{"Id":4778,"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"排律","TypeDetail":"WuPai","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"安德山池宴集"},"Clauses":[{"Content":"上路抵平津，"},{"Content":"后堂罗荐陈。"},{"Content":"缔交开狎赏，"},{"Content":"丽席展芳辰。"},{"Content":"密树风烟积，"},{"Content":"回塘荷芰新。"},{"Content":"雨霁虹桥晚，"},{"Content":"花落凤台春。"},{"Content":"翠钗低舞席，"},{"Content":"文杏散歌尘。"},{"Content":"方惜流觞满，"},{"Content":"夕鸟已城闉。"}]},{"Id":4780,"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"排律","TypeDetail":"WuPai","Rhyme":"阳","Rank":0,"Title":{"Content":"奉和秋日即目应制"},"Clauses":[{"Content":"上苑通平乐，"},{"Content":"神池迩建章。"},{"Content":"楼台相掩映，"},{"Content":"城阙互相望。"},{"Content":"缇油泛行幔，"},{"Content":"箫吹转浮梁。"},{"Content":"晚云含朔气，"},{"Content":"斜照荡秋光。","Comments":[{"Content":"一作阳","Type":"Text","Index":2}]},{"Content":"落叶飘蝉影，"},{"Content":"平流写雁行。"},{"Content":"槿散凌风缛，"},{"Content":"荷销裛露香。"},{"Content":"仙歌临枍诣，"},{"Content":"玄豫历长杨。"},{"Content":"归路乘明月，"},{"Content":"千门开未央。"}]},{"Id":4783,"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"陌","Rank":0,"Title":{"Content":"早春桂林殿应诏"},"Clauses":[{"Content":"步辇出披香，"},{"Content":"清歌临太液。"},{"Content":"晓树流莺满，"},{"Content":"春堤芳草积。"},{"Content":"风光翻露文，","Comments":[{"Content":"一作色","Type":"Text","Index":2}]},{"Content":"雪华上空碧。"},{"Content":"花蝶来未已，"},{"Content":"山光暧将夕。"}],"Comments":[{"Book":"《唐诗观澜集》","Content":"“晓树流莺满，春堤芳草积”，已开韦公门径。","IsComment":false,"FullPath":"《唐诗观澜集》"}]}],"Count":30,"PageNo":0,"PageSize":20}