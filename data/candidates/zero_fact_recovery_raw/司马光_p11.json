{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":499429,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"坐船"},"Clauses":[{"Content":"使君张皂盖，"},{"Content":"高宴碧湖心。"},{"Content":"苒蒻牵菱蔓，"},{"Content":"夷犹泊柳阴。"},{"Content":"晚风侵坐冷，"},{"Content":"春浪没篙深。"},{"Content":"倒载归何晚，"},{"Content":"波间夕照沈。"}]},{"Id":80980,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"Title":{"Content":"枇杷洲"},"Clauses":[{"Content":"周官敛珍味，","Comments":[{"Content":"自注：场人掌国之场圃，而树之果蓏。珍异之物以时敛而藏之。郑康成曰：珍异，蒲桃、枇杷之属。","Type":"Text","Index":5}]},{"Content":"汉苑结芳根。","Comments":[{"Content":"自注：初修上林苑，群臣远方各献名果异树，有枇杷十株。","Type":"Text","Index":5}]},{"Content":"何意荒洲上，"},{"Content":"犹馀嘉树存。"},{"Content":"犯寒花已发，"},{"Content":"迎暑实尤繁。"},{"Content":"愿逐蒲萄使，"},{"Content":"离宫奉至尊。"}]},{"Id":81201,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"齐","Rank":0,"Title":{"Content":"寓泊郑圃寄献昌言舍人"},"Clauses":[{"Content":"旅食缁衣馆，"},{"Content":"飘蓬恍自迷。"},{"Content":"树横寒雾远，"},{"Content":"山隐古原低。"},{"Content":"愁暮空庭雀，"},{"Content":"惊晨别墅鸡。"},{"Content":"故人何处在，"},{"Content":"依约玉绳西。"}]},{"Id":80746,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"又和留题定襄驿"},"Clauses":[{"Content":"按节羊肠阪，"},{"Content":"褰帷并塞州。"},{"Content":"仁风熙爱日，"},{"Content":"清德凛高秋。"},{"Content":"甘泽随征盖，"},{"Content":"华星近戍楼。"},{"Content":"佗年叱驭事，"},{"Content":"直笔寄歆彪。"}]},{"Id":80748,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"又寄献"},"Clauses":[{"Content":"承明共直庐，"},{"Content":"瞬息八年馀。"},{"Content":"幸托屏星驾，"},{"Content":"前迎使者车。"},{"Content":"迹虽殊贵贱，"},{"Content":"心不置亲疏。"},{"Content":"青眼披情素，"},{"Content":"犹如相见初。"}]},{"Id":80841,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"自嘲"},"Clauses":[{"Content":"英名愧终贾，"},{"Content":"高节谢巢由。"},{"Content":"直取云山笑，"},{"Content":"空为簪组羞。"},{"Content":"浮沈乖俗好，"},{"Content":"隐显拙身谋。"},{"Content":"惆怅临清鉴，"},{"Content":"霜毛不待秋。"}]},{"Id":81134,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"晋阳三月未有春色"},"Clauses":[{"Content":"天心均煦妪，"},{"Content":"物态异芬芳。"},{"Content":"上国花应烂，"},{"Content":"边城柳未黄。"},{"Content":"清明空改火，"},{"Content":"元已漫浮觞。"},{"Content":"仍说秋寒早，"},{"Content":"年年八月霜。"}]},{"Id":81012,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"柳溪对雪"},"Clauses":[{"Content":"春风不胜雪，"},{"Content":"散漫度龙沙。","Comments":[{"Content":"原作芜，据陈本、四库本改","Type":"Text","Index":4}]},{"Content":"密映缘溪柳，"},{"Content":"争飞乱眼花。"},{"Content":"鸱夷赊美酒，"},{"Content":"油壁系轻车。"},{"Content":"塞下芳菲晚，"},{"Content":"聊将当物华。"}]},{"Id":81234,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"酪羹"},"Clauses":[{"Content":"军厨重羊酪，"},{"Content":"飨士旧风传。"},{"Content":"不数紫莼滑，"},{"Content":"徒誇素鲔鲜。"},{"Content":"𤐣蠡烦挏取，","Comments":[{"Content":"原作同，据陈本、四库本改","Type":"Text","Index":5}]},{"Content":"勺药助烹煎。"},{"Content":"莫与吴儿说，"},{"Content":"还令笑茂先。"}]},{"Id":80969,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"奉同道矩谢始平公惠砚"},"Clauses":[{"Content":"爵台今已倾，"},{"Content":"飘瓦出芜城。"},{"Content":"还入缣缃用，"},{"Content":"尤资笔墨精。"},{"Content":"相君怜古物，"},{"Content":"内史擅书名。"},{"Content":"聊用飞军檄，"},{"Content":"何愁楯鼻平。"}]},{"Id":81040,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"送王都官官满还都","Comments":[{"Content":"淑，字元之","Type":"Text","Index":4}]},"Clauses":[{"Content":"粹美清庙器，"},{"Content":"可嗟沉下僚。"},{"Content":"优游仲举坐，"},{"Content":"洋溢海沂谣。"},{"Content":"奏课应居首，"},{"Content":"知音况满朝。"},{"Content":"从今黄鹄举，"},{"Content":"眼冷看青霄。","Comments":[{"Content":"陈本作合望","Type":"Text","Index":3}]}]},{"Id":80879,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"到并州已复数月率尔成诗"},"Clauses":[{"Content":"忽忽此何地，"},{"Content":"经时更自猜。"},{"Content":"深疑醉里得，"},{"Content":"复似梦中来。"},{"Content":"薄宦真何益，"},{"Content":"浮生信可咍。"},{"Content":"鹏蜩定有分，"},{"Content":"不若寸心灰。"}]},{"Id":80787,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"北轩老杏其大十围春色向晚止开一花予悯其憔悴作诗嘲之"},"Clauses":[{"Content":"春木争秀发，"},{"Content":"嗟君独不材。"},{"Content":"须惭一花少，"},{"Content":"强逐众芳开。"},{"Content":"顽艳人谁采，"},{"Content":"微香蝶不来。"},{"Content":"直为无用物，"},{"Content":"空尔费栽培。"}]},{"Id":80861,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"Title":{"Content":"杏解嘲"},"Clauses":[{"Content":"造物本非我，"},{"Content":"荣枯那足言。"},{"Content":"但馀良干在，"},{"Content":"何必艳花繁。"},{"Content":"壮丽华林苑，"},{"Content":"欢娱梓泽园。"},{"Content":"芳菲如可采，"},{"Content":"岂得侍君轩。"}]},{"Id":81158,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"寄陜西提刑江学士"},"Clauses":[{"Content":"明主于庶狱，","Comments":[{"Content":"四库本作矜","Type":"Text","Index":3}]},{"Content":"选才从本朝。"},{"Content":"酂侯三尺律，"},{"Content":"汉使一封轺。"},{"Content":"郡国清名满，"},{"Content":"关河古意饶。"},{"Content":"凄凉乘障客，"},{"Content":"华发日萧萧。"}]},{"Id":80891,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"和乐道自河外南辕过宜芳雨晴和气景物可爱马上偶成"},"Clauses":[{"Content":"京洛春应老，"},{"Content":"河边初解颜。"},{"Content":"碧浮烟际草，"},{"Content":"翠滴雨馀山。"},{"Content":"目极褰帷外，"},{"Content":"诗成揽辔间。"},{"Content":"满川桃李色，"},{"Content":"共喜传车还。"}]},{"Id":81131,"Classes":["軍旅"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"夏日"},"Clauses":[{"Content":"穷边已深夏，"},{"Content":"气色耿清秋。"},{"Content":"鲜旭开山郭，"},{"Content":"凉烟澹戍楼。"},{"Content":"兜铃烽火息，"},{"Content":"区脱虏尘收。"},{"Content":"迨此军中暇，"},{"Content":"无妨文雅游。"}]},{"Id":81075,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"青","Title":{"Content":"送张学士两浙提点刑狱","Comments":[{"Content":"师中，字吉老","Type":"Text","Index":4},{"Content":"赋得清字","Type":"Text","Index":10}]},"Clauses":[{"Content":"朝家重典刑，"},{"Content":"书府借时英。"},{"Content":"钲鼓喧江下，"},{"Content":"云山拂眼清。"},{"Content":"秋风鲈鲙美，"},{"Content":"书日锦衣荣。"},{"Content":"勿似朱翁子，"},{"Content":"空令守邸惊。"}]},{"Id":81160,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"青","Rank":0,"Title":{"Content":"寄聂之美","Comments":[{"Content":"之美时监韶州钱监","Type":"Text","Index":4}]},"Clauses":[{"Content":"去岁双毛白，"},{"Content":"今春一齿零。"},{"Content":"人生浮似叶，"},{"Content":"客宦泛如萍。"},{"Content":"塞上貂裘弊，"},{"Content":"天涯海气腥。"},{"Content":"何当占箕颍，"},{"Content":"萧散并柴扃。"}]},{"Id":81088,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"送昌言舍人得告还蜀三首"},"Clauses":[{"Content":"迢递铜梁道，"},{"Content":"凝严青琐闱。"},{"Content":"负书当日去，"},{"Content":"鸣玉此时归。"},{"Content":"乡树迎朱毂，"},{"Content":"江花照锦衣。"},{"Content":"临邛不足并，"},{"Content":"荣耀古今稀。"}]}],"Count":1270,"PageNo":11,"PageSize":20}