{"Authors":{"Names":["晏殊"],"AuthorIds":[27290],"Dynasties":["Song"]},"ShiData":[{"Id":198354,"GroupIndex":47,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"句","TypeDetail":"Others","Rhyme":"豪","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"未暇南浮海，"},{"Content":"何妨夜把螯。"}]},{"Id":198315,"GroupIndex":48,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"句","TypeDetail":"Others","Rhyme":"尤","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"蟹螯今在左，"},{"Content":"欲拍酒船浮。","Comments":[{"Content":"以上同上书卷三","Type":"Text","Index":5}]}]},{"Id":198355,"GroupIndex":49,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"句","TypeDetail":"Others","Rhyme":"东","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"春寒欲尽复未尽，"},{"Content":"二十四番花信风。","Comments":[{"Content":"宋高似孙《纬略》卷六","Type":"Text","Index":7}]}]},{"Id":198319,"GroupIndex":50,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"句","TypeDetail":"Others","Rhyme":"支","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"青帝回风初习习，"},{"Content":"黄人捧日故迟迟。","Comments":[{"Content":"同上书卷八","Type":"Text","Index":7}]}]},{"Id":198368,"GroupIndex":51,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"句","TypeDetail":"Others","Rhyme":"先","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"竹醉人还醉，"},{"Content":"蚕眠我亦眠。","Comments":[{"Content":"宋陈元靓《岁时广记》卷二","Type":"Text","Index":5}]}]},{"Id":198326,"GroupIndex":52,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"句","TypeDetail":"Others","Rhyme":"真","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"主父仲舒容不得，"},{"Content":"未知宾阁是何人。","Comments":[{"Content":"宋刘克庄《后村大全集》卷一七四","Type":"Text","Index":7}]}]},{"Id":198325,"GroupIndex":53,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"句","TypeDetail":"Others","Rhyme":"文","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"澹澹梳妆薄薄文。","Comments":[{"Content":"《后村千家诗》卷一六","Type":"Text","Index":7}]}]},{"Id":198349,"GroupIndex":54,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"句","TypeDetail":"Others","Rhyme":"齐","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"遥想江南此时节，"},{"Content":"小梅黄熟子规啼。","Comments":[{"Content":"宋曾季狸《艇斋诗话》","Type":"Text","Index":7}]}]},{"Id":198359,"GroupIndex":56,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"句","TypeDetail":"Others","Rhyme":"先","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"二龙骖夏服，"},{"Content":"双鹤记尧年。","Comments":[{"Content":"以上宋王应鳞《困学纪闻》卷一八","Type":"Text","Index":5}]}]},{"Id":198338,"GroupIndex":57,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"句","TypeDetail":"Others","Rhyme":"先","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"琼字金扉迥倚天，"},{"Content":"南齐七志罕遗逸，"},{"Content":"西汉九流咸粲然。","Comments":[{"Content":"和阅书歌","Type":"Text","Index":7}]}],"Note":"按：王应麟《玉海》卷二七"},{"Id":198351,"GroupIndex":58,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"句","TypeDetail":"Others","Rhyme":"阳","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"秦声未觉朱弦润，"},{"Content":"楚梦先知菹叶凉。","Comments":[{"Content":"明胡应麟《诗薮》外编卷五","Type":"Text","Index":7}]}]},{"Id":1154694,"Froms":["全宋文卷三九七","《元献遗文补编》卷一","《皇朝文鉴》卷二"],"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"AuthorDate":"1029年","AuthorPlace":"CN4102","Type":"辞赋","TypeDetail":"Fu","Rank":0,"Title":{"Content":"中园赋"},"Clauses":[{"Content":"在昔公仪，"},{"Content":"身居鼎轴。"},{"Content":"念家食之凭厚，"},{"Content":"斥芳蔬之荐蔌。"},{"Content":"粤有仲子，"},{"Content":"坚辞廪禄。"},{"Content":"率齐体于中野，"},{"Content":"灌百畦而是足。"},{"Content":"惟二哲之高矩，"},{"Content":"蔼千龄之信牍。"},{"Content":"虽显晦之非偶，"},{"Content":"谅谟猷而可复。"},{"Content":"岂不以崇高宅乎富贵，"},{"Content":"声教移乎风俗？"},{"Content":"四民谨旧德之业，"},{"Content":"百乘鄙盗臣之畜。"},{"Content":"义利愧于交战，"},{"Content":"矛盾蚩兮并鬻。"},{"Content":"代工而治兮戒在贪竞，"},{"Content":"付物以能兮使其茂育。"},{"Content":"斯有位之良训，"},{"Content":"乃群伦之所属。"},{"Content":"天地闭兮贤隐，"},{"Content":"罝网张兮兽伏。"},{"Content":"怖炎火之焚石，"},{"Content":"恧东龟之毁椟。"},{"Content":"甘田亩以昏作，"},{"Content":"晦膏兰而择福。"},{"Content":"我负子戴兮终年靡劳，"},{"Content":"夏葛冬裘兮匪躬是辱。"},{"Content":"斯遁世之攸处，"},{"Content":"讵纷华之可渎？"},{"Content":"眷予生兮曷为？"},{"Content":"幸亲逢乎盛时。"},{"Content":"进宽大治之责，"},{"Content":"退有尚农之赀。"},{"Content":"求中道于先民，"},{"Content":"乐鸿钧于圣期。"},{"Content":"寓垣屋于穷僻，"},{"Content":"敞林峦于蔽亏。"},{"Content":"朝青阁以夙退，"},{"Content":"饬两骖兮独归。"},{"Content":"窈蔼郊园，"},{"Content":"扶疏町畦。"},{"Content":"解巾组以遨游，"},{"Content":"饬壶觞而宴嬉。"},{"Content":"幼子蓬鬓，"},{"Content":"孺人布衣。"},{"Content":"啸傲蘅畹，"},{"Content":"留连渚湄。"},{"Content":"或捕雀以承蜩，"},{"Content":"或摘芳而玩蕤。"},{"Content":"食周粟以勿践，"},{"Content":"咏尧年而不知。"},{"Content":"琴风飒以解愠，"},{"Content":"田雨滂兮及私。"},{"Content":"尔乃坛杏蒙金，"},{"Content":"蹊桃衒碧。"},{"Content":"李杂红缥，"},{"Content":"柰分丹白。"},{"Content":"梨誇大谷之种，"},{"Content":"梅骋含章之饰。"},{"Content":"乌勃旁挺，"},{"Content":"来禽外植。"},{"Content":"樱胡品糅而形别，"},{"Content":"堂棣名同而实析。"},{"Content":"大椑朱柿兮骈发，"},{"Content":"梬枣安榴兮閒折。"},{"Content":"榠楂以馨烈蒙采，"},{"Content":"枳椇以甘芳见识。"},{"Content":"援蘡薁于林际，"},{"Content":"架葡萄于沼侧。"},{"Content":"况夫霜薤含润，"},{"Content":"露葵荐泽。"},{"Content":"芹自南楚，"},{"Content":"蒜来西域。"},{"Content":"苏荏抽颖，"},{"Content":"蓼荽凝液。"},{"Content":"堇荠更茂，"},{"Content":"菲葑代殖。"},{"Content":"苜蓿丽筛，"},{"Content":"蘘荷幂历。"},{"Content":"钟山之菘韭早晚，"},{"Content":"吴郡之苋茄紫白。"},{"Content":"织女耀而瓜荐，"},{"Content":"大昴中而芋食。"},{"Content":"匏瓠在格以增衍，"},{"Content":"藜藿缘阴而可摘。"},{"Content":"若其愈疾栽菊，"},{"Content":"忘忧树萱。"},{"Content":"香珍绿蕙，"},{"Content":"媚服崇兰。"},{"Content":"玉蕊金䔲，"},{"Content":"相思杜鹃。"},{"Content":"辛夷袭紫，"},{"Content":"芍药含丹。"},{"Content":"游龙出隰，"},{"Content":"芳苡生原。"},{"Content":"篱槿彫暮，"},{"Content":"宫槐合昏。"},{"Content":"四衢绮错，"},{"Content":"五出星联。"},{"Content":"蓑蓑落蕊，"},{"Content":"纂纂初妍。"},{"Content":"护台香而蝶乱，"},{"Content":"聚崖蜜以蜂喧。"},{"Content":"与夫猪苓马勃，"},{"Content":"泽茝溪荪。"},{"Content":"荔芸御冻，"},{"Content":"椒桂含温。"},{"Content":"萸房入佩，"},{"Content":"菰首登飧。"},{"Content":"薜荔成帷，"},{"Content":"昔邪在垣。"},{"Content":"独椹除渴，"},{"Content":"酸浆治烦。"},{"Content":"菖蒲感于百阴，"},{"Content":"葶苈萌于大寒。"},{"Content":"卷施心拔而不死，"},{"Content":"虎藟蔓生而自悬。"},{"Content":"彘首牛唇之夥，"},{"Content":"鸡肠乌喙之繁。"},{"Content":"红鬓缃肤，"},{"Content":"丹房碧延。"},{"Content":"或山经之号著，","Comments":[{"Content":"《","Type":"Text","Index":1},{"Content":"》","Type":"Text","Index":3}]},{"Content":"或药录之名传。","Comments":[{"Content":"《","Type":"Text","Index":1},{"Content":"》","Type":"Text","Index":3}]},{"Content":"至夫松桧被径，"},{"Content":"梧楸荫轩。"},{"Content":"江蕉凝绿，"},{"Content":"海柏浑圆。"},{"Content":"石南荟蔚，"},{"Content":"扶老萦缠。"},{"Content":"矗嶰筠之东美，"},{"Content":"垂溪柳之三眠。"},{"Content":"或后彫而秀出，"},{"Content":"或总翠以相先。"},{"Content":"丛灌骈滋，"},{"Content":"翾飞所据。"},{"Content":"验九扈以农正，"},{"Content":"察五鸠而民聚。"},{"Content":"戴鵀兴蚕织之候，"},{"Content":"布谷起耕耘之务。"},{"Content":"当陆成而鶗鴂云止，"},{"Content":"麰麦秀而仓庚始翥。"},{"Content":"伯劳惊于早寒，"},{"Content":"盍旦戒乎将曙。"},{"Content":"晨风不系而逐雀，"},{"Content":"斲木无声而食蠹。"},{"Content":"鷮介立以擅泽，"},{"Content":"乌群嗷而反哺。"},{"Content":"鹪匪陋于荆棘，"},{"Content":"鴳无营于钟鼓。"},{"Content":"顺时律以弄吭，"},{"Content":"乐天和而命侣。"},{"Content":"燕溢溢以交贺，"},{"Content":"鹊翛翛而告语。"},{"Content":"既罿罻之不设，"},{"Content":"在橧巢而可俯。"},{"Content":"谈王道于樵子，"},{"Content":"接欢歌于壤父。"},{"Content":"凿坎井之凝冽，"},{"Content":"决清渠而灌注。"},{"Content":"愚抱瓮以殚力，"},{"Content":"智设槔而尽虑。"},{"Content":"咸不病于夏畦，"},{"Content":"各无忧于捽茹。"},{"Content":"懿夫！"},{"Content":"观品汇之零茂，"},{"Content":"识元精之所存。"},{"Content":"睹百嘉之穰俭，"},{"Content":"明四序之无愆。"},{"Content":"动植飞潜兮，"},{"Content":"得宜乃悦；"},{"Content":"雨旸寒燠兮，"},{"Content":"协度而蕃。"},{"Content":"且复谕名花于君子，"},{"Content":"兴瑶草于王孙。"},{"Content":"采家臣之秋实，"},{"Content":"歌上瑞之丰年。"},{"Content":"资旨蓄而御冬，"},{"Content":"撷众芳而鍊颜。"},{"Content":"至若严客幸临，"},{"Content":"良辰是遘。"},{"Content":"载扫危榭，"},{"Content":"爰张宴豆。"},{"Content":"蒙山骑火之茗，"},{"Content":"豫北酿花之酎。"},{"Content":"或秋弈以当局，"},{"Content":"或唐弓而在彀。"},{"Content":"哨壶枉矢之设，"},{"Content":"博簺樗蒲之侑。"},{"Content":"诚一笑兮相乐，"},{"Content":"亦千金而为寿。"},{"Content":"洒毫牍以摛思，"},{"Content":"极朋情而卜昼。"},{"Content":"送归鸿兮海壖，"},{"Content":"揳鸣琴兮宾右。"},{"Content":"舞长袖兮相属，"},{"Content":"命欢谣兮递奏。"},{"Content":"无取次公之狂，"},{"Content":"不遗椒举之旧。"},{"Content":"春晼晚兮气佳，"},{"Content":"临高台兮淑华。"},{"Content":"夏恢台兮日永，"},{"Content":"荫茂林兮修迥。"},{"Content":"凉月皎兮钟漏寂，"},{"Content":"朔霰飞兮天宇夐。"},{"Content":"廓丹府以惩忿，"},{"Content":"悦灵龟而缮性。"},{"Content":"兹所谓袪鲁相之介节，"},{"Content":"略于陵之独行。"},{"Content":"却园夫之利兮取彼閒适，"},{"Content":"荷王国之宠兮遂夫游泳。"},{"Content":"禽托薮以思鹜，"},{"Content":"兽安林而获骋。"},{"Content":"倡佯乎大小之隐，"},{"Content":"放旷乎遭随之命。"},{"Content":"庶几育于嘉运，"},{"Content":"契哲人之养正。"}]},{"Id":1154695,"Froms":["全宋文卷三九七","《元献遗文补编》卷一","《玉海》卷三四"],"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"AuthorDate":"1042年","AuthorPlace":"CN4102","Type":"辞赋","TypeDetail":"Fu","Rank":0,"Title":{"Content":"飞白书赋"},"Clauses":[{"Content":"昔在轩后，"},{"Content":"旁罗俊英。"},{"Content":"乃有苍颉，"},{"Content":"思周神明。"},{"Content":"下侔羽族之迹，"},{"Content":"上法奎圜之精。"},{"Content":"始造古文，"},{"Content":"播于寰瀛。"},{"Content":"爰及东汉，"},{"Content":"纪年熹平。"},{"Content":"其臣蔡邕，"},{"Content":"誉闻帝庭。"},{"Content":"瞩鸿都之蒇役，"},{"Content":"扫垩帚而字成。"},{"Content":"寓物增华，"},{"Content":"穷幽洞灵。"},{"Content":"肇此一体，"},{"Content":"用飞白而为名。"},{"Content":"饰宫阙之题署，"},{"Content":"助圣贤之艺能。"},{"Content":"厥后累朝之臣，"},{"Content":"习此奇迹。"},{"Content":"代百名系，"},{"Content":"存乎简籍。"},{"Content":"然犹献之白而不飞，"},{"Content":"子云飞而不白。"},{"Content":"伊唐二叶，"},{"Content":"迨及高宗。"},{"Content":"咸所留意，"},{"Content":"亦云尽工。"},{"Content":"分赐宰弼，"},{"Content":"涣扬古风。"},{"Content":"若乃宫砚沉碧，"},{"Content":"山炉泛清，"},{"Content":"恣冲襟之悦穆，"},{"Content":"拂神翰以纵横。"},{"Content":"空濛蝉翼之状，"},{"Content":"宛转蚪骖之形。"},{"Content":"烂皎月而霞薄，"},{"Content":"飏珍林而雾轻。"},{"Content":"曳彩绡兮泉客之府，"},{"Content":"列纤缟兮夏王之庭。"},{"Content":"仙风助其缥渺，"},{"Content":"辰象供其粹凝。"},{"Content":"信一人之妙用，"},{"Content":"非末学之能称。"},{"Content":"而况取象八分，"},{"Content":"资妍小篆。"},{"Content":"玉洁冰润，"},{"Content":"龙骧虎变。"},{"Content":"合心手以冥运，"},{"Content":"体乾坤之壮观。"}]},{"Id":1154696,"Froms":["全宋文卷三九七","《玉海》卷三四"],"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"AuthorDate":"1042年","AuthorPlace":"CN4102","Type":"辞赋","TypeDetail":"Fu","Rank":0,"Title":{"Content":"御飞白书扇赋"},"Clauses":[{"Content":"骛思三云，"},{"Content":"洒回春之藻翰，"},{"Content":"成变楷之奇文。"},{"Content":"婉结无方，"},{"Content":"轻浓有制。"},{"Content":"该笔苑之遒润，"},{"Content":"集书林之妍媚。"},{"Content":"标王字于日中，"},{"Content":"湛金波于月际。"},{"Content":"六艺之逸品。"},{"Content":"在昔贞观之隆，"},{"Content":"文皇念功，"},{"Content":"时则有无忌师道沐鸾蚪之班诏；","Comments":[{"Content":"、","Type":"Text","Index":5}]},{"Content":"咸亨以还，"},{"Content":"高宗礼贤，"},{"Content":"时则有至德处俊荷楫翼之垂训。","Comments":[{"Content":"、","Type":"Text","Index":5}]},{"Content":"亦有攀车受贶，"},{"Content":"登床被恩，"},{"Content":"一言蒙鲁衮之厚，"},{"Content":"八体著羲图之则。"},{"Content":"五明在手，"},{"Content":"于以见虞帝达聪之勤；"},{"Content":"四座生风，"},{"Content":"于以彰武王救暍之德。"}]},{"Id":1154697,"Froms":["全宋文卷三九七","《国朝二百家名贤文粹》卷一七六"],"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"辞赋","TypeDetail":"Fu","Rank":0,"Title":{"Content":"雪赋"},"Clauses":[{"Content":"元圣善谋，"},{"Content":"时寒顺之。"},{"Content":"若六出之嘉贶，"},{"Content":"乃玉精之所滋。"},{"Content":"生积润于重坎，"},{"Content":"发萌生于后祇。"},{"Content":"克肇阴阳之序，"},{"Content":"用成天地之宜。"},{"Content":"观夫玄律行周，"},{"Content":"愁云亟积。"},{"Content":"北陆司纪，"},{"Content":"青女蒇职。"},{"Content":"驱屏翳兮涓洒，"},{"Content":"仗飞廉兮扫涤。"},{"Content":"初晻暧以蓬勃，"},{"Content":"倏森严而悄寂。"},{"Content":"随蠛蠓以汎汎，"},{"Content":"径扶摇而弈弈。"},{"Content":"乍拂庑兮荣树，"},{"Content":"忽穿窗兮逗隙。"},{"Content":"压丛竹之虚籁，"},{"Content":"点乔松之秀色。"},{"Content":"委岩穴以含垢，"},{"Content":"赴波澜而灭迹。"},{"Content":"兽族处兮休影，"},{"Content":"鸟归栖兮接翼。"},{"Content":"原野漫其一平，"},{"Content":"羲舒为之双匿。"},{"Content":"昼黮䨴以迷昏，"},{"Content":"夕精荧兮误晨。"},{"Content":"导和气于葭縠，"},{"Content":"茁幽芳于荔芸。"},{"Content":"晦金炉之郁郁，"},{"Content":"混缥瓦之鳞鳞。"},{"Content":"疑月桂之飘荡，"},{"Content":"惑星榆之纠纷。"},{"Content":"酌冻醑兮杯蚁滟，"},{"Content":"缓清歌兮眉粟嚬。"},{"Content":"拂纨袖兮多思，"},{"Content":"照琼颜兮有神。"},{"Content":"尔乃邃馆曾台，"},{"Content":"彤墀紫闼。"},{"Content":"垂壶之漏方耿，"},{"Content":"程石之书未彻。"},{"Content":"惊扣砌之葱郁，"},{"Content":"讶绮疏之骚屑。"},{"Content":"龙衔烛兮昆峤，"},{"Content":"鲛泣珠兮贝阙。"},{"Content":"冕藻井之窕菂，"},{"Content":"夺琁题之皎月。"},{"Content":"絮非柳以摇飏，"},{"Content":"木先梅而罅发。"},{"Content":"旌冯豹之奏事，"},{"Content":"纳晏婴之进说。"},{"Content":"覆衾被兮臣款忠，"},{"Content":"出衣裘兮民感悦。"},{"Content":"息黄竹之哀思，"},{"Content":"略嵰州之奇绝。"},{"Content":"至如藻扃绣户，"},{"Content":"金屋兰堂，"},{"Content":"或端居而悯默，"},{"Content":"或惨别以悽伤。"},{"Content":"讽班姬之比物，"},{"Content":"吟谢媪之联章。"},{"Content":"炳明烛兮萧寂，"},{"Content":"俪幽兰兮抑扬。"},{"Content":"杂风流之雅舞，"},{"Content":"映拂额之残妆。"},{"Content":"缄锦字兮途远，"},{"Content":"数琼签兮夜长。"},{"Content":"玉为田兮蓝水，"},{"Content":"银作宫兮鲸海光。"},{"Content":"叹川路兮难越，"},{"Content":"念音尘兮不忘。"},{"Content":"又如葱极西遐，"},{"Content":"龙城北距。"},{"Content":"班晋钺以命将，"},{"Content":"约齐瓜而遣戍。"},{"Content":"伏瓯脱兮穷徼，"},{"Content":"望兜零兮薄暮。"},{"Content":"始粲粲于林莽，"},{"Content":"渐瀌瀌于陇路。"},{"Content":"浮塞草以横绝，"},{"Content":"卷碛沙而径度。"},{"Content":"骇罽幕之无色，"},{"Content":"眩龙堆之失素。"},{"Content":"杖汉节兮毛尽，"},{"Content":"击燕歌兮泪注。"},{"Content":"生赎罪兮窦宪，"},{"Content":"没思归兮温序。"},{"Content":"禅姑衍兮何日，"},{"Content":"焚谷蠡兮未遇。"},{"Content":"天山极目兮同缟，"},{"Content":"昆岫亘空兮连璐。"},{"Content":"咏雅什之来思，"},{"Content":"怆他乡而永慕。"},{"Content":"则有地分上下，"},{"Content":"亩号南东。"},{"Content":"竞寸阴而昏作，"},{"Content":"祀先啬以勤农。"},{"Content":"利铫耨于平日，"},{"Content":"饬畎畦于凛冬。"},{"Content":"既淅沥兮蠲渴，"},{"Content":"复连翩兮降衷。"},{"Content":"愿体足兮沾洽，"},{"Content":"庆存瘥兮不逢。"},{"Content":"睹盈尺之储瑞，"},{"Content":"识载涂之兆丰。"},{"Content":"验郭履于阡陌，"},{"Content":"辨蕉庐于灌丛。"},{"Content":"初见睍以消解，"},{"Content":"遂膏腴而液融。"},{"Content":"蔺弱土兮疆畔，"},{"Content":"渍原野兮稑穜。"},{"Content":"振袯襫以增气，"},{"Content":"沐薹簦而动容。"},{"Content":"嗿其馌兮胥悦，"},{"Content":"耦而耕兮必躬。"},{"Content":"巾屦惰民，"},{"Content":"圭符假守。"},{"Content":"临涣水之封域，"},{"Content":"访梁台之苑囿。"},{"Content":"玩圭屑之华楚，"},{"Content":"感密荣之纷糅。"},{"Content":"赧尸素兮重席，"},{"Content":"寄欢康兮旨酒。"},{"Content":"轸潜恩于天末，"},{"Content":"续长谣于客右。"},{"Content":"歌曰："},{"Content":"北风凉兮霙霰飞，"},{"Content":"露同甘兮阳共晞。"},{"Content":"沼有蘋兮山有薇，"},{"Content":"道攸长兮谁与归？"}]},{"Id":1154698,"Froms":["全宋文卷三九七","《玉海》卷一二九"],"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"AuthorDate":"天禧二年二月","AuthorPlace":"CN4102","Type":"辞赋","TypeDetail":"Fu","Rank":0,"Title":{"Content":"亲贤进封赋"},"Clauses":[{"Content":"燕禖启兆，"},{"Content":"熊梦开祥；"},{"Content":"分晖日域，"},{"Content":"禀秀星潢。"},{"Content":"陪汉幄以遵礼，"},{"Content":"奉尧闱而中式。"},{"Content":"寝门屡至，"},{"Content":"足见于纯诚；"},{"Content":"吏牍遥观，"},{"Content":"盖彰乎敏识。"},{"Content":"接申白以谈经，","Comments":[{"Content":"、","Type":"Text","Index":2}]},{"Content":"越应刘而振藻。","Comments":[{"Content":"、","Type":"Text","Index":2}]}]},{"Id":1154699,"Froms":["全宋文卷三九七","《玉海》卷一二九"],"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"AuthorDate":"大中祥符八年十二月","AuthorPlace":"CN4102","Type":"辞赋","TypeDetail":"Fu","Rank":0,"Title":{"Content":"皇子冠礼赋"},"Clauses":[{"Content":"辟崇贤而毓德，"},{"Content":"御宣猷而待宾。"},{"Content":"东明之银榜弥高，"},{"Content":"西海之瑶山特峻。"}]},{"Id":1154700,"Froms":["全宋文卷三九七","《宋朝事实类苑》卷二九","《韵语阳秋》卷一六"],"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"辞赋","TypeDetail":"Fu","Rhyme":"10","Rank":0,"Title":{"Content":"西掖植紫微赋"},"Clauses":[{"Content":"得自羊墅，"},{"Content":"来从召园。"},{"Content":"有昔日之绛老，"},{"Content":"无当时之仲文。"},{"Content":"观茂悦以怀旧，"},{"Content":"指蔽芾以思人。"}]},{"Id":1154701,"Froms":["全宋文卷三九七"],"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"AuthorDate":"1034年","AuthorPlace":"CN3416","Type":"辞赋","TypeDetail":"Fu","Rhyme":"29","Rank":0,"Title":{"Content":"傀儡赋"},"Clauses":[{"Content":"外眩刻雕，"},{"Content":"内牵缠索。"},{"Content":"朱紫坌并，"},{"Content":"银黄煜爚。"},{"Content":"生杀自口，"},{"Content":"荣枯在握。"}],"Note":"按：《韵语阳秋》卷一七，上海古籍出版社一九八四年影印宋刻本。"},{"Id":1154702,"Froms":["全宋文卷三九七"],"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"AuthorDate":"1033年","AuthorPlace":"CN3416","Type":"辞赋","TypeDetail":"Fu","Rhyme":"霁","Rank":0,"Title":{"Content":"蜩蛙赋"},"Clauses":[{"Content":"匿蕞质以潜进，"},{"Content":"跳轻躯而猛噬。"},{"Content":"虽多口而连获，"},{"Content":"终扼腕而弗制。"}],"Note":"按：《避暑录话》卷四，津逮秘书本。"}],"Count":360,"PageNo":17,"PageSize":20}