{"Authors":{"Names":["李益"],"AuthorIds":[15274],"Dynasties":["Tang"]},"ShiData":[{"Id":28385,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"乐府曲辞","TypeDetail":"YueFu","Rhyme":"霰","Rank":0,"Title":{"Content":"杂曲歌辞 游子吟"},"Clauses":[{"Content":"女羞夫婿薄，"},{"Content":"客耻主人贱。"},{"Content":"遭遇同众流，"},{"Content":"低回愧相见。"},{"Content":"君非青铜镜，"},{"Content":"何事空照面。"},{"Content":"莫以衣上尘，"},{"Content":"不谓心如练。"},{"Content":"人生当荣盛，"},{"Content":"待士勿言倦。"},{"Content":"君看白日驰，"},{"Content":"何异弦上箭。"}]},{"Id":28376,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"乐府曲辞","TypeDetail":"YueFu","Rhyme":"元","Rank":0,"Title":{"Content":"杂曲歌辞 轻薄篇"},"Clauses":[{"Content":"豪不必驰千骑，"},{"Content":"雄不在垂双鞬。"},{"Content":"天生俊气自相逐，"},{"Content":"出与雕鹗同飞翻。"},{"Content":"朝行九衢不得意，"},{"Content":"下鞭走马城西原。"},{"Content":"忽闻燕雁一声去，"},{"Content":"回鞍挟弹平陵园。"},{"Content":"归来青楼曲未半，","Comments":[{"Content":"一作卒","Type":"Text","Index":7}]},{"Content":"美人玉色当金尊。"},{"Content":"淮阴少年不相下，"},{"Content":"酒酣半笑倚市门。"},{"Content":"安知我有不平色，"},{"Content":"白日欲落红尘昏。"},{"Content":"死生容易如反掌，"},{"Content":"得意失意由一言。"},{"Content":"少年但饮莫相问，"},{"Content":"此中报雠亦报恩。","Comments":[{"Content":"一作兼","Type":"Text","Index":5}]}]},{"Id":28361,"Allusions":[{"AllusionIndex":5191,"AllusionKey":"绝驰道","SentenceIndex":3},{"AllusionIndex":8193,"AllusionKey":"嬉戏冠沐猿","SentenceIndex":6},{"AllusionIndex":10050,"AllusionKey":"优孟","SentenceIndex":6}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"乐府曲辞","TypeDetail":"YueFu","Rank":0,"Title":{"Content":"杂曲歌辞 汉宫少年行"},"Clauses":[{"Content":"君不见上宫警夜营八屯，"},{"Content":"鼕鼕街鼓朝朱轩。"},{"Content":"玉阶霜仗拥未合，"},{"Content":"少年排入铜龙门。"},{"Content":"暗闻弦管九天上，"},{"Content":"宫漏沈沈清吹繁。"},{"Content":"平明走马绝驰道，","Comments":[{"Content":"绝驰道","Type":"AllusionKey","Index":7}]},{"Content":"呼鹰挟弹通缭垣。"},{"Content":"玉笼金锁养黄口，"},{"Content":"探雏取卵伴王孙。"},{"Content":"分曹陆博快一掷，"},{"Content":"迎欢先意笑语喧。"},{"Content":"巧为柔媚学优孟，","Comments":[{"Content":"优孟","Type":"AllusionKey","Index":7}]},{"Content":"儒衣嬉戏冠沐猿。","Comments":[{"Content":"嬉戏冠沐猿","Type":"AllusionKey","Index":7}]},{"Content":"晚来香街经柳市，"},{"Content":"行过倡舍宿桃根。"},{"Content":"相逢杯酒一言失，","Comments":[{"Content":"一作酒后","Type":"Text","Index":4}]},{"Content":"回朱点白闻至尊。"},{"Content":"金张许史伺颜色，"},{"Content":"王侯将相莫敢论。"},{"Content":"岂知人事无定势，"},{"Content":"朝欢暮戚如掌翻。"},{"Content":"椒房宠移子爱夺，"},{"Content":"一夕秋风生戾园。"},{"Content":"徒用黄金将买赋，"},{"Content":"宁知白玉暗成痕。"},{"Content":"持杯收水水已覆，"},{"Content":"徙薪避火火更燔。"},{"Content":"欲求四老张丞相，"},{"Content":"南山如天不可上。"}]},{"Id":28263,"Classes":["軍旅"],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"乐府曲辞","TypeDetail":"YueFu","Rhyme":"阳","Rank":0,"Title":{"Content":"杂曲歌辞 婆罗门"},"Clauses":[{"Content":"回乐峰前沙似雪，","Comments":[{"Content":"一作烽","Type":"Text","Index":3}]},{"Content":"受降城下月如霜。","Comments":[{"Content":"一作上，一作外","Type":"Text","Index":4}]},{"Content":"不知何处吹芦管，","Comments":[{"Content":"一作笛","Type":"Text","Index":7}]},{"Content":"一夜征人尽望乡。"}],"Comments":[{"Book":"《艺苑卮言》","Content":"绝句李益为胜，韩翃次之。……“回乐烽前”一宁，何必王龙标、李供奉？","IsComment":false,"FullPath":"《艺苑卮言》"},{"Book":"《唐诗训解》","Content":"起语雄壮悲切，末接便。","IsComment":false,"FullPath":"《唐诗训解》"},{"Book":"《全唐风雅》","Content":"此首显说。","IsComment":false,"FullPath":"《全唐风雅》"},{"Book":"《增订唐诗摘钞》","Content":"沙飞月皎，举目凄其，下此而闻笳声，安有不思乡念切者。","IsComment":false,"FullPath":"《增订唐诗摘钞》"},{"Book":"《唐诗笺注》","Content":"李君虞绝句，专以此擅场，所谓率真语，天然画也。","IsComment":false,"FullPath":"《唐诗笺注》"},{"Book":"《历代诗法》","Content":"如空谷流泉，调高响逸。","IsComment":false,"FullPath":"《历代诗法》"},{"Book":"《网师园唐诗笺》","Content":"蕴藉宛转，乐府绝唱。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"《诗法易简录》","Content":"征人望乡，只加一“尽”字，耐征戍之苦，离乡之久，胥包孕在内矣。","IsComment":false,"FullPath":"《诗法易简录》"},{"Book":"《唐绝诗钞注略》","Content":"首二句写景，已为“望乡”二字钩魂摄魄，是争上流法，亦倒装法。","IsComment":false,"FullPath":"《唐绝诗钞注略》"},{"Book":"《越缦堂读书简端记》","Content":"高格、高韵、高调，司空侍郎所谓“反虚入浑”者。下“天山雪后海风寒”一首，佳处正同。","IsComment":false,"FullPath":"《越缦堂读书简端记》"},{"Book":"《诗境浅说续编》","Content":"对苍茫之夜月，登绝塞之孤城，沙明讶雪，月冷疑霜，是何等悲凉之境！起句以对句写之，弥见雄厚。后二句申足上意，言荒沙万静中，闻芦管之声，随朔风而起，防秋多少征人，乡愁齐赴，则己之郁伊善感，不待言矣。李诗又有《从军北行》……意境略同。但前诗有夷宕之音，北征诗用抗爽之笔，均佳构也。","IsComment":false,"FullPath":"《诗境浅说续编》"},{"Content":"受降城：贞观二十年，唐太宗亲临灵州接受突厥一部的投降，“受降城”之名即由此而来。但此诗的受降城所在地说法不一。回乐：县名，故址在今宁夏回族自治区灵武县西南。回乐峰：回乐县附近的山峰。<br/><br/>【简析】：<br/>这首七绝是历来传诵的名篇。霜月、芦笛、乡思，构成一幅思乡图，意境感人。","IsComment":false}]},{"Id":28339,"Classes":["軍旅 英雄"],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"乐府曲辞","TypeDetail":"YueFu","Rhyme":"齐","Rank":0,"Title":{"Content":"横吹曲辞 紫骝马","Comments":[{"Content":"一作紫骝马","Type":"Text","Index":8}]},"Clauses":[{"Content":"争场看斗鸡，"},{"Content":"白鼻紫騧嘶。","Comments":[{"Content":"一作骝","Type":"Text","Index":4}]},{"Content":"漳水春归晚，"},{"Content":"丛台日向低。"},{"Content":"歇鞍珠作汗，"},{"Content":"试剑玉如泥。"},{"Content":"为谢红梁燕，"},{"Content":"年年妾独栖。"}]},{"Id":28360,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"乐府曲辞","TypeDetail":"YueFu","Rhyme":"先","Rank":0,"Title":{"Content":"杂曲歌辞 古别离"},"Clauses":[{"Content":"双剑欲别风凄然，","Comments":[{"Content":"一作心","Type":"Text","Index":5}]},{"Content":"雌沈水底雄上天。"},{"Content":"江回汉转两不见，"},{"Content":"云交雨合知何年。"},{"Content":"古来万事皆由命，"},{"Content":"何用临岐苦涕涟。","Comments":[{"Content":"一作涕苦相连","Type":"Text","Index":7}]}]},{"Id":28251,"GroupIndex":1,"Allusions":[{"AllusionIndex":4836,"AllusionKey":"金谷园","SentenceIndex":0}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"乐府曲辞","TypeDetail":"YueFu","Rhyme":"萧","Rank":0,"Title":{"Content":"杂曲歌辞"},"SubTitle":{"Content":"祓禊曲","Comments":[{"Content":"汉宫三月上巳，张乐于流水，晋宋已后皆因之，至唐传以为曲。","Type":"Text","Index":3}]},"Clauses":[{"Content":"金谷园中柳，","Comments":[{"Content":"金谷园","Type":"AllusionKey","Index":3}]},{"Content":"春来已舞腰。","Comments":[{"Content":"一作自，一作学","Type":"Text","Index":3}]},{"Content":"那堪好风景，"},{"Content":"独上洛阳桥。"}],"Comments":[{"Book":"唐诗鉴赏辞典","Content":"“洛桥”，一作“上洛桥”，即天津桥，在唐代河南府河南县（今河南洛阳市）。当大唐盛世，阳春时节，这里是贵达士女云集游春的繁华胜地。但在安、史乱后，已无往日盛况。河南县还有一处名园遗址，即西晋门阀豪富石崇的别庐金谷园，在洛桥北望，约略可见。诗人春日独上洛阳桥，北望金谷园，即景咏怀，以寄感慨。<br /><br />它先写目中景。眺望金谷园遗址，只见柳条在春风中摆动，婀娜多姿，仿佛一群苗条的伎女在翩翩起舞，一派春色繁荣的好风景。然后写心中情。面对这一派好景，今日只有诗人孤零零地站在往昔繁华的洛阳桥上，觉得分外冷落，不胜感慨系之。<br /><br />显然，诗的主题思想是抒发好景不常、繁华消歇的历史盛衰的感慨，新意无多。它的妙处在于艺术构思和表现手法所造成的独特意境和情调。以金谷园引出洛阳桥，用消失了的历史豪奢比照正在消逝的今日繁华，这样的构思是为了激 发人们对现实的关注，而不陷于历史的感慨，发人深省。用柳姿舞腰的轻快形象起兴，仿佛要引起人们对盛世欢乐的神往，却以独上洛桥的忧伤，切实引起人们对时世衰微的关切，这样的手法是含蓄深长的。换句话说，它从现实看历史，以历史照现实，从欢乐到忧伤，由轻快入深沉，巧妙地把历史的一时繁华和大自然的眼前春色溶为一体，意境浪漫而真实，情调遐远而深峻，相当典型地表现出由盛入衰的中唐时代脉搏。应当说，在中唐前期的山水诗中，它是别具一格的即兴佳作。<br /><br />（倪其心）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]},{"Id":28252,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"乐府曲辞","TypeDetail":"YueFu","Rhyme":"微","Rank":0,"Title":{"Content":"杂曲歌辞 鹧鸪词"},"Clauses":[{"Content":"湘江斑竹枝，"},{"Content":"锦翼鹧鸪飞。"},{"Content":"处处湘阴合，"},{"Content":"郎从何处归。"}]},{"Id":1369412,"Froms":["全唐文卷四百八十一"],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"辞赋","TypeDetail":"Fu","Rank":0,"Title":{"Content":"诗有六义赋","Comments":[{"Content":"以风雅比兴自家成国为韵","Type":"Text","Index":5}]},"Clauses":[{"Content":"夫圣人之理。"},{"Content":"原于始而执其中。"},{"Content":"观天文以审于王事。"},{"Content":"观人文而知其国风。"},{"Content":"故每岁孟春。"},{"Content":"采诗于道路。"},{"Content":"而献之泮宫。"},{"Content":"有以知下之化。"},{"Content":"达人之穷。"},{"Content":"发于关雎之首。"},{"Content":"及乎王道之终。"},{"Content":"故曰天明自人而视。"},{"Content":"天听自人而聪。"},{"Content":"所谓政于内系一人之本。"},{"Content":"动于外形四方之风。"},{"Content":"始于风。"},{"Content":"成于雅。"},{"Content":"失其道或天方荐瘥。"},{"Content":"得其宜或锡之纯嘏。"},{"Content":"是人情之大窦。"},{"Content":"未有不由于斯者。"},{"Content":"尔其德以颂宣。"},{"Content":"事以类比。"},{"Content":"陈之于学校。"},{"Content":"将可以反正辍淫。"},{"Content":"播之于丝桐。"},{"Content":"何有于剪商变徵。"},{"Content":"属辞庶因于劝戒。"},{"Content":"缘情孰多夫绮靡。"},{"Content":"嘉鱼作而贤者进焉。"},{"Content":"驺虞废而王道缺矣。"},{"Content":"至于诗之为称。"},{"Content":"言以全兴。"},{"Content":"诗之为志。"},{"Content":"赋以明类。"},{"Content":"亦有感于鬼神。"},{"Content":"岂止明夫礼义。"},{"Content":"王泽竭而诗不作。"},{"Content":"周道微而兴以刺。"},{"Content":"俾乃审音之人。"},{"Content":"于以知风之自。"},{"Content":"洎夫代见更改也。"},{"Content":"运历于诗亡。"},{"Content":"自天未丧斯文也。"},{"Content":"以至于皇唐。"},{"Content":"于是抑文尚质。"},{"Content":"崇俭去奢。"},{"Content":"振六艺以补化。"},{"Content":"秉一言之无邪。"},{"Content":"不然。"},{"Content":"何以天地奉若。"},{"Content":"而不兴云汉之嗟。"},{"Content":"用能德馨而蘋蘩可荐。"},{"Content":"诚达而来麰降生。"},{"Content":"虽九重岁招其谏诤。"},{"Content":"而九有日闻其颂声。"},{"Content":"且君非五谏兮何弼。"},{"Content":"诗匪六义兮何成。"},{"Content":"我皇乃以诗而条之国政。"},{"Content":"本乎人情。"},{"Content":"故得行于蛮貊。"},{"Content":"岂独用之邦国。"},{"Content":"修之身则寿考不忘。"},{"Content":"垂乎后则子孙千亿。"},{"Content":"乃知诗之为教。"},{"Content":"盖亦王猷之至极。"}]}],"Count":169,"PageNo":8,"PageSize":20}