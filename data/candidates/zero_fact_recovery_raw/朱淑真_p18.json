{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":96330,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"词","TypeDetail":"Ci","Rhyme":"梗","Rank":0,"Title":{"Content":"卜算子 咏梅"},"TuneId":{"Id":110},"Clauses":[{"Content":"竹里一枝梅，"},{"Content":"映带林逾静。"},{"Content":"雨后清奇画不成，"},{"Content":"浅水横疏影。","BreakAfter":"1"},{"Content":"吹彻小单于，"},{"Content":"心事思重省。"},{"Content":"拂拂风前度暗香，"},{"Content":"月色侵花冷。"}]},{"Id":96340,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"词","TypeDetail":"Ci","Rhyme":"31","Rank":0,"Title":{"Content":"念奴娇"},"SubTitle":{"Content":"二首催雪"},"TuneId":{"Id":614},"Clauses":[{"Content":"冬晴无雪，"},{"Content":"是天心未肯，"},{"Content":"化工非拙。"},{"Content":"不放玉花飞堕地，"},{"Content":"留在广寒宫阙。"},{"Content":"云欲同时，"},{"Content":"霰将集处，"},{"Content":"红日三竿揭。"},{"Content":"六花剪就，"},{"Content":"不知何处施设。","BreakAfter":"1"},{"Content":"应念陇首寒梅，"},{"Content":"花开无伴，"},{"Content":"对景真愁绝。"},{"Content":"待出和羹金鼎手，"},{"Content":"为把玉盐飘撒。"},{"Content":"沟壑皆平，"},{"Content":"乾坤如画，"},{"Content":"更吐冰轮洁。"},{"Content":"梁园燕客，"},{"Content":"夜明不怕灯灭。"}]},{"Id":96350,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"词","TypeDetail":"Ci","Rank":0,"Title":{"Content":"菩萨蛮 咏梅"},"TuneId":{"Id":105},"Clauses":[{"Content":"湿云不渡溪桥冷，"},{"Content":"嫩寒初破东风影。"},{"Content":"溪下水声长，"},{"Content":"一枝和月香。","BreakAfter":"1"},{"Content":"人怜花似旧，"},{"Content":"花不知人瘦。"},{"Content":"独自倚阑干，"},{"Content":"夜深花正寒。"}],"Note":"按：此首一作苏东坡词。"},{"Id":96341,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"词","TypeDetail":"Ci","Rhyme":"30","Rank":0,"Title":{"Content":"念奴娇"},"SubTitle":{"Content":"催雪"},"TuneId":{"Id":614},"Clauses":[{"Content":"鹅毛细剪，"},{"Content":"是琼珠密洒，"},{"Content":"一时堆积。"},{"Content":"斜倚东风浑漫漫，"},{"Content":"顷刻也须盈尺。"},{"Content":"玉作楼台，"},{"Content":"铅镕天地，"},{"Content":"不见遥岑碧。"},{"Content":"佳人作戏，"},{"Content":"碎揉些子抛掷。","BreakAfter":"1"},{"Content":"争奈好景难留，"},{"Content":"风僝雨僽，"},{"Content":"打碎光凝色。"},{"Content":"总有十分轻妙态，"},{"Content":"谁似旧时怜惜。"},{"Content":"担阁梁吟，"},{"Content":"寂寥楚舞，"},{"Content":"笑捏狮儿只。"},{"Content":"梅花依旧，"},{"Content":"岁寒松竹三益。"}]},{"Id":96339,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"词","TypeDetail":"Ci","Rhyme":"12","Rank":0,"Title":{"Content":"西江月 春半"},"TuneId":{"Id":190},"Clauses":[{"Content":"办取舞裙歌扇，"},{"Content":"赏春只怕春寒。"},{"Content":"卷帘无语对南山，"},{"Content":"已觉绿肥红浅。","BreakAfter":"1"},{"Content":"去去惜花心懒，"},{"Content":"踏青闲步江干。"},{"Content":"恰如飞鸟倦知还，"},{"Content":"澹荡梨花深院。"}]},{"Id":96332,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"词","TypeDetail":"Ci","Rhyme":"药","Rank":0,"Title":{"Content":"月华清 梨花"},"TuneId":{"Id":608},"Clauses":[{"Content":"雪压庭春，"},{"Content":"香浮花月，"},{"Content":"揽衣还怯单薄。"},{"Content":"欹枕裴回，"},{"Content":"又听一声乾鹊。"},{"Content":"粉泪共宿雨阑干，","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"清梦与寒云寂寞。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"除却，"},{"Content":"是江梅曾许，"},{"Content":"诗人吟作。"},{"Content":"长恨晓风漂泊，"},{"Content":"且莫遣香肌，"},{"Content":"瘦减如削。"},{"Content":"深杏夭桃，"},{"Content":"端的为谁零落。"},{"Content":"况天气妆点清明，","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"对美景不妨行乐。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"拌着，"},{"Content":"向花时取，"},{"Content":"一杯独酌。"}]},{"Id":96257,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"词","TypeDetail":"Ci","Rhyme":"东","Rank":0,"Title":{"Content":"杨柳枝"},"TuneId":{"Id":37},"Clauses":[{"Content":"高缕千丝纤暖风，"},{"Content":"带烟笼雾市桥东。"},{"Content":"绾成幽恨斜阳里，"},{"Content":"折断离情细雨中。"}]}],"Count":367,"PageNo":18,"PageSize":20}