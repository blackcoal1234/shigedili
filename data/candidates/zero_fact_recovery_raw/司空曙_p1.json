{"Authors":{"Names":["司空曙"],"AuthorIds":[13632],"Dynasties":["Tang"]},"ShiData":[{"Id":12284,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"赠送郑钱二郎中"},"Clauses":[{"Content":"梅含柳已动，"},{"Content":"昨日起东风。"},{"Content":"惆怅心徒壮，"},{"Content":"无如鬓作翁。"},{"Content":"百年飘若水，"},{"Content":"万绪尽归空。"},{"Content":"何可宗禅客，"},{"Content":"迟回岐路中。"}]},{"Id":12275,"Allusions":[{"AllusionIndex":1121,"AllusionKey":"郗超","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"酬郑十四望驿不得同宿见赠因寄张参军"},"Clauses":[{"Content":"逢君喜成泪，"},{"Content":"暂似故乡中。"},{"Content":"谪宦犹多惧，"},{"Content":"清宵不得终。"},{"Content":"月烟高有鹤，"},{"Content":"宿草净无虫。","Comments":[{"Content":"一作霜","Type":"Text","Index":1}]},{"Content":"明日郗超会，","Comments":[{"Content":"郗超","Type":"AllusionKey","Index":4}]},{"Content":"应思下客同。"}]},{"Id":12277,"Allusions":[{"AllusionIndex":251,"AllusionKey":"白社","SentenceIndex":2}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"暮春野望寄钱起","Comments":[{"Content":"一作耿湋诗","Type":"Text","Index":7}]},"Clauses":[{"Content":"草长花落树，"},{"Content":"羸病强寻春。"},{"Content":"无复少年意，"},{"Content":"空馀华发新。"},{"Content":"青原高见水，","Comments":[{"Content":"一见晴","Type":"Text","Index":3}]},{"Content":"白社静逢人。","Comments":[{"Content":"白社","Type":"AllusionKey","Index":2}]},{"Content":"寄谢南宫客，"},{"Content":"轩车不可亲。","Comments":[{"Content":"一作见","Type":"Text","Index":4}]}]},{"Id":12224,"Allusions":[{"AllusionIndex":1101,"AllusionKey":"蔡廓","SentenceIndex":1},{"AllusionIndex":6643,"AllusionKey":"佩觿","SentenceIndex":0},{"AllusionIndex":10474,"AllusionKey":"张冯","SentenceIndex":1}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"送王使君小子孝廉登科归省"},"Clauses":[{"Content":"年少通经学，"},{"Content":"登科尚佩觿。","Comments":[{"Content":"佩觿","Type":"AllusionKey","Index":5}]},{"Content":"张冯本名士，","Comments":[{"Content":"张冯","Type":"AllusionKey","Index":2}]},{"Content":"蔡廓是佳儿。","Comments":[{"Content":"蔡廓","Type":"AllusionKey","Index":2}]},{"Content":"鞍马临岐路，"},{"Content":"龙钟对别离。"},{"Content":"寄书胡太守，"},{"Content":"请与故人知。","Comments":[{"Content":"一作清","Type":"Text","Index":1}]}]},{"Id":12192,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"云阳寺石竹花"},"Clauses":[{"Content":"一自幽山别，"},{"Content":"相逢此寺中。"},{"Content":"高低俱出叶，","Comments":[{"Content":"一作有","Type":"Text","Index":4}]},{"Content":"深浅不分丛。"},{"Content":"野蝶难争白，"},{"Content":"庭榴暗让红。"},{"Content":"谁怜芳最久，"},{"Content":"春露到秋风。"}]},{"Id":12246,"Allusions":[{"AllusionIndex":770,"AllusionKey":"兴比乘舟访","SentenceIndex":2},{"AllusionIndex":2204,"AllusionKey":"倒屣","SentenceIndex":2}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"送高胜重谒曹王"},"Clauses":[{"Content":"江上青枫岸，","Comments":[{"Content":"一作水","Type":"Text","Index":2}]},{"Content":"阴阴万里春。"},{"Content":"朝辞郢城酒，"},{"Content":"暮见洞庭人。"},{"Content":"兴比乘舟访，","Comments":[{"Content":"兴比乘舟访","Type":"AllusionKey","Index":5}]},{"Content":"恩怀倒屣亲。","Comments":[{"Content":"倒屣","Type":"AllusionKey","Index":4}]},{"Content":"想君登旧榭，"},{"Content":"重喜扫芳尘。"}]},{"Id":12208,"Allusions":[{"AllusionIndex":770,"AllusionKey":"寻戴","SentenceIndex":1}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"闲园书事招畅当"},"Clauses":[{"Content":"闻蝉昼眠后，"},{"Content":"欹枕对蓬蒿。"},{"Content":"羸病懒寻戴，","Comments":[{"Content":"寻戴","Type":"AllusionKey","Index":5}]},{"Content":"田园方咏陶。"},{"Content":"傍檐虫挂静，"},{"Content":"出树蝶飞高。"},{"Content":"惆怅临清镜，"},{"Content":"思君见鬓毛。"}]},{"Id":12207,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"过钱员外"},"Clauses":[{"Content":"为郎头已白，"},{"Content":"迹向市朝稀。"},{"Content":"移病居荒宅，"},{"Content":"安贫著败衣。"},{"Content":"野园随客醉，"},{"Content":"雪寺伴僧归。"},{"Content":"自说东峰下，"},{"Content":"松萝满故扉。"}]},{"Id":12285,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"赠庾侍御"},"Clauses":[{"Content":"年少身无累，"},{"Content":"相逢忆此时。"},{"Content":"雪过云寺宿，"},{"Content":"酒向竹园期。"},{"Content":"白发今催老，"},{"Content":"清琴但起悲。"},{"Content":"唯应逐宗炳，"},{"Content":"内学愿为师。"}]},{"Id":12283,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"赠李端"},"Clauses":[{"Content":"共忆南浮日，","Comments":[{"Content":"一作楼","Type":"Text","Index":4}]},{"Content":"登高望若何。"},{"Content":"楚田湖草远，"},{"Content":"江寺海榴多。"},{"Content":"载酒寻山宿，"},{"Content":"思人带雪过。"},{"Content":"东西几回别，"},{"Content":"此会各蹉跎。"}]},{"Id":12245,"Allusions":[{"AllusionIndex":317,"AllusionKey":"石郎神","SentenceIndex":1},{"AllusionIndex":3009,"AllusionKey":"枫子鬼","SentenceIndex":1}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"送流人"},"Clauses":[{"Content":"闻说南中事，"},{"Content":"悲君重窜身。"},{"Content":"山村枫子鬼，","Comments":[{"Content":"枫子鬼","Type":"AllusionKey","Index":5}]},{"Content":"江庙石郎神。","Comments":[{"Content":"石郎神","Type":"AllusionKey","Index":5}]},{"Content":"童稚留荒宅，"},{"Content":"图书托故人。"},{"Content":"青门好风景，"},{"Content":"为尔一沾巾。"}]},{"Id":12206,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"过胡居士睹王右丞遗文","Comments":[{"Content":"一作湖上","Type":"Text","Index":4}]},"Clauses":[{"Content":"旧日相知尽，"},{"Content":"深居独一身。"},{"Content":"闭门空有雪，","Comments":[{"Content":"一作唯","Type":"Text","Index":3}]},{"Content":"看竹永无人。"},{"Content":"每许前山隐，"},{"Content":"曾怜陋巷贫。"},{"Content":"题诗今尚在，"},{"Content":"暂为拂流尘。","Comments":[{"Content":"一作留","Type":"Text","Index":4}]}]},{"Id":12239,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"送郎使君赴郢州"},"Clauses":[{"Content":"使君持节去，"},{"Content":"云水满前程。"},{"Content":"楚寺多连竹，"},{"Content":"江樯远映城。"},{"Content":"登楼向月望，"},{"Content":"赛庙傍山行。"},{"Content":"若动思乡咏，"},{"Content":"应贻谢步兵。"}]},{"Id":12258,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"贼平后送人北归"},"Clauses":[{"Content":"世乱同南去，"},{"Content":"时清独北还。"},{"Content":"他乡生白发，"},{"Content":"旧国见青山。"},{"Content":"晓月过残垒，"},{"Content":"繁星宿故关。"},{"Content":"寒禽与衰草，"},{"Content":"处处伴愁颜。"}],"Comments":[{"Book":"《唐诗分类绳尺》","Content":"中唐雅调。颔联甚不费力，甚不浅促。观其结句，犹不免有悲伤之意，其与《诗经》“鸿雁于飞，哀鸣嗷嗷”，同一用意。","IsComment":false,"FullPath":"《唐诗分类绳尺》"},{"Book":"《唐诗选脉会通评林》","Content":"此与“旧时闻笛泪”一章，悲调自饶神韵，不必深远。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗别裁》","Content":"四语与“残阳见旧山”同妙（末句下）。","IsComment":false,"FullPath":"《唐诗别裁》"},{"Book":"《增订唐诗摘钞》","Content":"刘文房《穆陵关作》独三、四两语居胜，全首雅润，尚不及此篇。","IsComment":false,"FullPath":"《增订唐诗摘钞》"}]},{"Id":12203,"Classes":["軍旅 遊獵"],"Allusions":[{"AllusionIndex":4251,"AllusionKey":"金埒","SentenceIndex":2},{"AllusionIndex":4381,"AllusionKey":"霍家亲","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"观猎骑","Comments":[{"Content":"一作公子行","Type":"Text","Index":3}]},"Clauses":[{"Content":"缠臂绣纶巾，"},{"Content":"貂裘窄称身。"},{"Content":"射禽风助箭，"},{"Content":"走马雪翻尘。","Comments":[{"Content":"一作骤","Type":"Text","Index":1},{"Content":"一作飞","Type":"Text","Index":4}]},{"Content":"金埒争开道，","Comments":[{"Content":"金埒","Type":"AllusionKey","Index":2}]},{"Content":"香车为驻轮。"},{"Content":"翩翩不知处，"},{"Content":"传是霍家亲。","Comments":[{"Content":"一作应","Type":"Text","Index":1},{"Content":"霍家亲","Type":"AllusionKey","Index":5}]}]},{"Id":12199,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"同苗员外宿荐福常师房","Comments":[{"Content":"一作秋喜卢纶同宿寺","Type":"Text","Index":10}]},"Clauses":[{"Content":"浮生共多故，"},{"Content":"聚宿喜君同。"},{"Content":"人息时闻磬，"},{"Content":"灯摇乍有风。"},{"Content":"霜阶疑水际，","Comments":[{"Content":"一作寒霜凝","Type":"Text","Index":3}]},{"Content":"夜木似山中。"},{"Content":"一愿持如意，","Comments":[{"Content":"一作投","Type":"Text","Index":3}]},{"Content":"长来事远公。"}]},{"Id":12231,"Allusions":[{"AllusionIndex":5378,"AllusionKey":"东堂桂","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"送乔广下第归淮南"},"Clauses":[{"Content":"遥想长淮尽，"},{"Content":"荒堤楚路斜。"},{"Content":"戍旌标白浪，"},{"Content":"罟网入青葭。"},{"Content":"啼鸟仍临水，","Comments":[{"Content":"一作归","Type":"Text","Index":1}]},{"Content":"愁人更见花。","Comments":[{"Content":"一作看","Type":"Text","Index":4}]},{"Content":"东堂一枝在，"},{"Content":"为子惜年华。"}]},{"Id":12195,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"风筝"},"Clauses":[{"Content":"高风吹玉柱，"},{"Content":"万籁忽齐飘。"},{"Content":"飒树迟难度，"},{"Content":"萦空细渐销。"},{"Content":"松泉鹿门夜，"},{"Content":"笙鹤洛滨朝。"},{"Content":"坐与真僧听，"},{"Content":"支颐向寂寥。"}]},{"Id":12210,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"闲居寄苗发"},"Clauses":[{"Content":"渐向浮生老，"},{"Content":"前期竟若何。"},{"Content":"独身居处静，"},{"Content":"永夜坐时多。"},{"Content":"厌逐青林客，"},{"Content":"休吟白雪歌。"},{"Content":"支公有遗寺，"},{"Content":"重与谢安过。","Comments":[{"Content":"一作戴","Type":"Text","Index":3}]}]},{"Id":12223,"Allusions":[{"AllusionIndex":2841,"AllusionKey":"济南生","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"送王先生归南山"},"Clauses":[{"Content":"儒中年最老，"},{"Content":"独有济南生。","Comments":[{"Content":"济南生","Type":"AllusionKey","Index":5}]},{"Content":"爱子方传业，"},{"Content":"无官自耦耕。"},{"Content":"竹通山舍远，"},{"Content":"云接雪田平。","Comments":[{"Content":"一作玉","Type":"Text","Index":3}]},{"Content":"愿作门人去，"},{"Content":"相随隐姓名。"}]}],"Count":165,"PageNo":1,"PageSize":20}