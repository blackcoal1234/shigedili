{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":536098,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"无寐二首"},"Clauses":[{"Content":"吹彻云箫夜未赊，"},{"Content":"梨花带月映窗纱。"},{"Content":"休将往事思量遍，"},{"Content":"潋滟新愁乱似麻。"}]},{"Id":536099,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"无寐二首"},"Clauses":[{"Content":"背弹珠泪暗伤神，"},{"Content":"挑尽寒灯睡不成。"},{"Content":"卸却凤钗寻睡去，"},{"Content":"上床开眼到天明。"}]},{"Id":536100,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"蒸","Rank":0,"FirstClauseRhyme":"蒸","Title":{"Content":"酒醒"},"Clauses":[{"Content":"梦回酒醒嚼盂冰，"},{"Content":"侍女贪眠唤不应。"},{"Content":"瘦㾪江梅知我意，"},{"Content":"隔窗和月谩腾腾。"}]},{"Id":536101,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"冬","Rank":0,"Title":{"Content":"睡起二首"},"Clauses":[{"Content":"起来不喜匀红粉，"},{"Content":"强把菱花照病容。"},{"Content":"腰瘦故知闲事恼，"},{"Content":"泪多只为别情浓。"}]},{"Id":536102,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"睡起二首"},"Clauses":[{"Content":"懒对妆台指黛眉，"},{"Content":"任他双鬓向烟垂。"},{"Content":"侍儿全不知人意，"},{"Content":"犹把梅花插一枝。"}]},{"Id":536103,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"清瘦"},"Clauses":[{"Content":"春花秋月若浮沤，"},{"Content":"怎得心如不系舟。"},{"Content":"肌骨大都无一把，"},{"Content":"可怜禁驾许多愁。"}]},{"Id":536104,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"闷书"},"Clauses":[{"Content":"泪粉匀开满镜愁，"},{"Content":"麝煤拂断远山秋。"},{"Content":"一痕心寄银屏上，"},{"Content":"不见人来竹叶舟。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》前集卷九，总题闺怨","Type":"Text","Index":7}]}]},{"Id":536105,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"掬水月在手"},"Clauses":[{"Content":"无事江头弄碧波，"},{"Content":"分明掌上见嫦娥。"},{"Content":"不知李谪仙人在，"},{"Content":"曾向江头捉得么。"}]},{"Id":536106,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"微","Rank":0,"Title":{"Content":"弄花香满衣"},"Clauses":[{"Content":"艳红影里撷芳回，"},{"Content":"沾惹春风两袖归。"},{"Content":"夹路露桃浑欲笑，"},{"Content":"不禁蜂蝶绕人飞。"}]},{"Id":96205,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"微","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"会魏夫人席上命小鬟妙舞曲终求诗于予以飞雪满群山为韵作五绝"},"Clauses":[{"Content":"管弦催上锦裀时，"},{"Content":"体段轻盈祇欲飞。"},{"Content":"若使明皇当日见，"},{"Content":"阿蛮无计况杨妃。"}]},{"Id":96206,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"屑","Rank":0,"Title":{"Content":"会魏夫人席上命小鬟妙舞曲终求诗于予以飞雪满群山为韵作五绝"},"Clauses":[{"Content":"香茵稳衬半钩月，"},{"Content":"来往淩波云影灭。"},{"Content":"弦催紧拍捉将遍，","Comments":[{"Content":"元刻本作促","Type":"Text","Index":5}]},{"Content":"两袖翻然做回雪。"}]},{"Id":96207,"GroupIndex":3,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"旱","Rank":0,"Title":{"Content":"会魏夫人席上命小鬟妙舞曲终求诗于予以飞雪满群山为韵作五绝"},"Clauses":[{"Content":"柳腰不被春拘管，"},{"Content":"凤转鸾回霞袖缓。","Comments":[{"Content":"原作莺，据元刻本改","Type":"Text","Index":3}]},{"Content":"舞彻伊州力不禁，"},{"Content":"筵前扑簌花飞满。"}]},{"Id":96209,"GroupIndex":4,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"文","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"会魏夫人席上命小鬟妙舞曲终求诗于予以飞雪满群山为韵作五绝"},"Clauses":[{"Content":"占断京华第一春，"},{"Content":"清歌妙舞实超群。"},{"Content":"只愁到晓人星散，"},{"Content":"化作巫山一段云。"}]},{"Id":96208,"GroupIndex":5,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"会魏夫人席上命小鬟妙舞曲终求诗于予以飞雪满群山为韵作五绝"},"Clauses":[{"Content":"烛花影里粉姿闲，"},{"Content":"一点愁侵两点山。"},{"Content":"不怕带他飞燕妒，"},{"Content":"无言相逐省弓弯。"}]},{"Id":96267,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"读史"},"Clauses":[{"Content":"笔头去取万千端，"},{"Content":"后世遭它恣意瞒。"},{"Content":"王霸谩分心与迹，"},{"Content":"到成功处一般难。"}]},{"Id":96266,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"Title":{"Content":"圆子"},"Clauses":[{"Content":"轻圆绝胜鸡头肉，"},{"Content":"滑腻偏宜蟹眼汤。"},{"Content":"纵有风流无处说，"},{"Content":"已输汤饼试何郎。"}]},{"Id":96225,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"即事"},"Clauses":[{"Content":"旋妆冷火试龙涎，"},{"Content":"香绕屏山不动烟。"},{"Content":"帘幕半垂灯烛暗，"},{"Content":"酒阑时节未忺眠。"}]},{"Id":96215,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"Title":{"Content":"自责二首"},"Clauses":[{"Content":"女子弄文诚可罪，"},{"Content":"那堪咏月更吟风。"},{"Content":"磨穿铁砚成何事，","Comments":[{"Content":"元刻本作非吾","Type":"Text","Index":6}]},{"Content":"绣折金针却有功。"}]},{"Id":96216,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"自责二首"},"Clauses":[{"Content":"闷无消遣只看诗，"},{"Content":"又见诗中话别离。"},{"Content":"添得情怀转萧索，"},{"Content":"如知伶俐不如痴。"}]},{"Id":536107,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"浴罢"},"Clauses":[{"Content":"浴罢云鬟乱不梳，"},{"Content":"清癯无力气方苏。"},{"Content":"坐来始觉神魂定，"},{"Content":"尚怯凉风到坐隅。"}]}],"Count":367,"PageNo":11,"PageSize":20}