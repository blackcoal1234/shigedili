{"Authors":{"Names":["钱惟演"],"AuthorIds":[34195],"Dynasties":["Song"]},"ShiData":[{"Id":203135,"GroupIndex":25,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rhyme":"真","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"金牛此地通巴栈，"},{"Content":"黄鸟当时颂汉臣。","Comments":[{"Content":"章南郑","Type":"Text","Index":7}]}],"Note":"按：宋陈应行《吟窗杂录》卷三六"},{"Id":203129,"GroupIndex":26,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rhyme":"先","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"五马持山节，"},{"Content":"三衣对水田。","Comments":[{"Content":"春日郡斋","Type":"Text","Index":5}]}]},{"Id":203147,"GroupIndex":27,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"画凤仙楹远，"},{"Content":"涂雌郡阁閒。","Comments":[{"Content":"送王滁州","Type":"Text","Index":5}]}],"Note":"按：以上宋谢维新《古今合璧事类备要》后集卷七三"},{"Id":203148,"GroupIndex":28,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rhyme":"先","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"刘伶醉夜梅花地，"},{"Content":"海客仙槎粉水天。"}]},{"Id":203151,"GroupIndex":29,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rhyme":"蒸","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"已回邻面三年粉，"},{"Content":"又结寒丝几茧冰。","Comments":[{"Content":"以上宋《锦绣万花谷》前集卷二","Type":"Text","Index":7}]}]},{"Id":203141,"GroupIndex":30,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"云容忽变千峰险，"},{"Content":"草色相沿百带长。","Comments":[{"Content":"同上书卷三","Type":"Text","Index":7}]}]},{"Id":203146,"GroupIndex":31,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rhyme":"东","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"平河千里经春雪，"},{"Content":"广陌三条尽日风。","Comments":[{"Content":"同上书卷七","Type":"Text","Index":7}]}]},{"Id":203139,"GroupIndex":32,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rhyme":"灰","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"朱饰两轮巡属邑，"},{"Content":"案留双笔在中台。"}]},{"Id":203156,"GroupIndex":33,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rhyme":"尤","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"鹤伴鸣琴公事晚，"},{"Content":"鸟惊调角戍城秋。","Comments":[{"Content":"以上同上书卷一三","Type":"Text","Index":7}]}]},{"Id":203149,"GroupIndex":35,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rhyme":"寒","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"捲衲城钟断，"},{"Content":"支筇岳雨寒。","Comments":[{"Content":"以上同上书卷二九","Type":"Text","Index":5}]}]},{"Id":1149081,"Froms":["全宋文卷一九四","《皇朝文鉴》卷一"],"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"辞赋","TypeDetail":"Fu","Rank":0,"Title":{"Content":"春雪赋"},"Clauses":[{"Content":"癸亥岁二月晦讫季春旦，"},{"Content":"雾，"},{"Content":"霰雪杂下，"},{"Content":"平地二尺。"},{"Content":"寒威于是凌厉，"},{"Content":"阳和为之潜伏。"},{"Content":"问诸农，"},{"Content":"曰："},{"Content":"田有伤矣。","Comments":[{"Content":"「","Type":"Text","Index":0},{"Content":"」","Type":"Text","Index":4}]},{"Content":"问诸圃，"},{"Content":"曰："},{"Content":"果不实矣。","Comments":[{"Content":"「","Type":"Text","Index":0},{"Content":"」","Type":"Text","Index":4}]},{"Content":"考诸史，"},{"Content":"曰："},{"Content":"阴阳戾矣。","Comments":[{"Content":"「","Type":"Text","Index":0},{"Content":"」","Type":"Text","Index":4}]},{"Content":"予守土者，"},{"Content":"岂不以民为心？"},{"Content":"因怆然而赋：","BreakAfter":"1"},{"Content":"春阳已中，"},{"Content":"百昌俱作。"},{"Content":"彼阴冷而忽兴，"},{"Content":"何飞霙之骤落？"},{"Content":"始蒙蔽于阳乌，"},{"Content":"遂潜藏于天幕。"},{"Content":"冰霰杂下，"},{"Content":"温寒相搏。"},{"Content":"才衮衮而纷揉，"},{"Content":"更霏霏而交错。"},{"Content":"因方就圆，"},{"Content":"填溪满壑。"},{"Content":"迷匹练于素鹇，"},{"Content":"混高云于皓鹤。"},{"Content":"七盘顿失乎巇崄，"},{"Content":"二室仅存乎峎崿。"},{"Content":"我有爰田，"},{"Content":"既锄既耰；"},{"Content":"我有条桑，"},{"Content":"且桋且柔。"},{"Content":"岂灭裂而是取？"},{"Content":"顾沃若之待收。"},{"Content":"罹此暴殄，"},{"Content":"予心则忧。"},{"Content":"亦有庶草群木，"},{"Content":"千芳万琲，"},{"Content":"粉落絮起，"},{"Content":"珠倾玉碎。"},{"Content":"建森纚之高牙，"},{"Content":"垂陆离之长佩。"},{"Content":"掩藩匽之郁栖，"},{"Content":"覆台塘之畏隹。"},{"Content":"病李僵于井干，"},{"Content":"芳兰沉于林会。"},{"Content":"有奔夐夐，"},{"Content":"有鸣嘤嘤。"},{"Content":"趋荐草以无所，"},{"Content":"恋危巢之欲倾。"},{"Content":"顾泽中而罢钓，"},{"Content":"之垄上而辍耕。"},{"Content":"手足瘒瘃，"},{"Content":"吾道不行。"},{"Content":"吾乃诗叹麻衣，"},{"Content":"歌悲黄竹。"},{"Content":"兔园靡召于游客，"},{"Content":"钘山遂仆于王属。"},{"Content":"隔瑶水之来使，"},{"Content":"没骚人之行毂。"},{"Content":"东郭叹不完之衣，"},{"Content":"梁山作思归之曲。"},{"Content":"岂由汉女之冤，"},{"Content":"遂至卫民之哭？"},{"Content":"已而违时令，"},{"Content":"反天常，"},{"Content":"气虽凄而不烈，"},{"Content":"风虽暴而不扬。"},{"Content":"忽曜灵之委照，"},{"Content":"伫消释于辉光。"}]}],"Count":111,"PageNo":5,"PageSize":20}