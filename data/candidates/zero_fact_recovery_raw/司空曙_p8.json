{"Authors":{"Names":["司空曙"],"AuthorIds":[13632],"Dynasties":["Tang"]},"ShiData":[{"Id":12311,"Allusions":[{"AllusionIndex":2965,"AllusionKey":"山阳笛","SentenceIndex":5},{"AllusionIndex":4836,"AllusionKey":"金谷","SentenceIndex":5},{"AllusionIndex":9277,"AllusionKey":"谢朓","SentenceIndex":9}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"残莺百啭歌同王员外耿拾遗吉中孚李端游慈恩各赋一物"},"Clauses":[{"Content":"残莺一何怨，"},{"Content":"百啭相寻续。"},{"Content":"始辨下将高，"},{"Content":"稍分长复促。"},{"Content":"绵蛮巧状语，"},{"Content":"机节终如曲。"},{"Content":"野客赏应迟，"},{"Content":"幽僧闻讵足。"},{"Content":"禅斋深树夏阴清，"},{"Content":"零落空馀三两声。"},{"Content":"金谷筝中传不似，","Comments":[{"Content":"金谷","Type":"AllusionKey","Index":2}]},{"Content":"山阳笛里写难成。","Comments":[{"Content":"山阳笛","Type":"AllusionKey","Index":3}]},{"Content":"忆昨乱啼无远近，"},{"Content":"晴宫晓色偏相引。"},{"Content":"送暖初随柳色来，"},{"Content":"辞芳暗逐花枝尽。"},{"Content":"歌残莺，"},{"Content":"歌残莺，"},{"Content":"悠然万感生。"},{"Content":"谢朓羁怀方一听，","Comments":[{"Content":"谢朓","Type":"AllusionKey","Index":2}]},{"Content":"何郎闲吟本多情。"},{"Content":"乃知众鸟非俦比，"},{"Content":"暮噪晨鸣倦人耳。"},{"Content":"共爱奇音那可亲，"},{"Content":"年年出谷待新春。"},{"Content":"此时断绝为君惜，"},{"Content":"明日玄蝉催发白。"}]},{"Id":12316,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"送程秀才"},"Clauses":[{"Content":"悠悠多路岐，"},{"Content":"相见又别离。"},{"Content":"东风催节换，"},{"Content":"燄燄春阳散。"},{"Content":"楚草渐烟绵，"},{"Content":"江云亦芜漫。"},{"Content":"送子恨何穷，"},{"Content":"故关如梦中。"},{"Content":"游人尽还北，"},{"Content":"旅雁辞南国。"},{"Content":"枫树几回青，"},{"Content":"逐臣归不得。"}]},{"Id":12300,"Allusions":[{"AllusionIndex":594,"AllusionKey":"墨子悲","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"长林令卫象饧丝结歌"},"Clauses":[{"Content":"主人雕盘盘素丝，"},{"Content":"寒女眷眷墨子悲。","Comments":[{"Content":"墨子悲","Type":"AllusionKey","Index":7}]},{"Content":"乃言假使饧为之，","Comments":[{"Content":"一作答乃","Type":"Text","Index":2}]},{"Content":"八珍重沓失颜色，"},{"Content":"手援玉箸不敢持。"},{"Content":"始状芙蓉新出水，"},{"Content":"仰坼重衣倾万蕊。"},{"Content":"又如合欢交乱枝，"},{"Content":"红茸向暮花参差。"},{"Content":"吴蚕络茧抽尚绝，"},{"Content":"细缕纤毫看欲灭。"},{"Content":"雪发羞垂倭堕鬟，"},{"Content":"绣囊畏并茱萸结。"},{"Content":"我爱此丝巧，"},{"Content":"妙绝世间无，"},{"Content":"为君作歌陈座隅。"}]},{"Id":12211,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"灰","Rank":0,"Title":{"Content":"和卢校书文若早入使院书事","Comments":[{"Content":"第六句缺一字","Type":"Text","Index":12}]},"Clauses":[{"Content":"解带独裴回，"},{"Content":"秋风如水来。"},{"Content":"轩墀湿繁露，"},{"Content":"琴几拂轻埃。"},{"Content":"晨鸟犹在叶，"},{"Content":"夕虫馀囗苔。"},{"Content":"苍然发高兴，"},{"Content":"相仰坐难陪。"}]},{"Id":12303,"Classes":["軍旅 戍守"],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"乐府曲辞","TypeDetail":"YueFu","Rhyme":"30","Rank":0,"Title":{"Content":"关山月"},"Clauses":[{"Content":"苍茫明月上，"},{"Content":"夜久光如积。"},{"Content":"野幕冷胡霜，"},{"Content":"关楼宿边客。"},{"Content":"陇头秋露暗，"},{"Content":"碛外寒沙白。"},{"Content":"唯有故乡人，"},{"Content":"沾裳此闻笛。"}],"Comments":[{"Book":"《大历诗略》","Content":"五言小古锻琢太工，便非高品。","IsComment":false,"FullPath":"《大历诗略》"}]}],"Count":165,"PageNo":8,"PageSize":20}