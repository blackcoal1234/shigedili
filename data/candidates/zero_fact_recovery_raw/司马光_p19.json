{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":81025,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"秋雨新霁游水北马上偶成"},"Clauses":[{"Content":"秋色与秋声，"},{"Content":"萧然满洛城。"},{"Content":"未霜林叶赤，"},{"Content":"新雨野风清。"},{"Content":"水气侵肌冷，"},{"Content":"岚光刮眼明。"},{"Content":"谁云景如画，"},{"Content":"但恐画难成。"}]},{"Id":80866,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"运使虞部按行洛西诸县因游所过名山有诗百馀首合为一编蒙赐宠示俾之继作一首"},"Clauses":[{"Content":"属城穷僻地，"},{"Content":"揽辔遍周流。"},{"Content":"弊政已更化，"},{"Content":"名山不废游。"},{"Content":"鸣驺留谷口，"},{"Content":"轻屐历岩幽。"},{"Content":"聚看官仪者，"},{"Content":"相扶半白头。"}]},{"Id":80820,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"吕宣徽挽歌二首"},"Clauses":[{"Content":"奕世台衡贵，"},{"Content":"盈门绂冕荣。"},{"Content":"遐方流惠化，"},{"Content":"殊俗詟威声。"},{"Content":"宥密资忠力，"},{"Content":"安平寄老成。"},{"Content":"遽骑箕尾去，"},{"Content":"何以慰苍生。"}]},{"Id":80819,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"吕宣徽挽歌二首"},"Clauses":[{"Content":"维岳人皆仰，"},{"Content":"长城众所依。"},{"Content":"远猷方克壮，"},{"Content":"昭世忽长违。"},{"Content":"象设俨如在，"},{"Content":"英灵窅不归。"},{"Content":"唯应令名久，"},{"Content":"竹素蔼馀辉。"}]},{"Id":80910,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"和君贶暮秋四日登石家寺阁晓泛洛舟 登阁"},"Clauses":[{"Content":"嬉游乘晓霁，"},{"Content":"登览犯秋寒。"},{"Content":"不出埃尘外，"},{"Content":"安知在壤宽。"},{"Content":"宫前断山碧，"},{"Content":"林表落霞丹。"},{"Content":"欲下惜佳趣，"},{"Content":"相留更倚栏。"}]},{"Id":80742,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"又和六日四老会","Comments":[{"Content":"并宋子才大监、李几先将军","Type":"Text","Index":7}]},"Clauses":[{"Content":"萸房迎令节，"},{"Content":"菊蕊入芳筵。"},{"Content":"华烛初长夜，"},{"Content":"清霜未冷天。"},{"Content":"悲风咽横吹，"},{"Content":"骤雨送繁弦。"},{"Content":"聊附邹枚客，"},{"Content":"敢希园绮贤。"}]},{"Id":81116,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"送雷章秘丞知芮城"},"Clauses":[{"Content":"西伯昔断讼，"},{"Content":"令名存迄今。"},{"Content":"南临大河曲，"},{"Content":"北倚首阳岑。"},{"Content":"俗被圣贤化，"},{"Content":"人多礼让心。"},{"Content":"夫君老经术，"},{"Content":"终日想鸣琴。"}]},{"Id":80925,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"和张文裕初寒十首"},"Clauses":[{"Content":"何处初寒好，"},{"Content":"初寒郏鄏城。"},{"Content":"垂绅多俊彦，"},{"Content":"列第尽公卿。"},{"Content":"裘马过从盛，"},{"Content":"门阑洒扫清。"},{"Content":"谁家拥兽炭，"},{"Content":"尽日管弦声。"}]},{"Id":80924,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"和张文裕初寒十首"},"Clauses":[{"Content":"何处初寒好，"},{"Content":"初寒洛汭宫。"},{"Content":"翠华虽脉脉，"},{"Content":"佳气自葱葱。"},{"Content":"阙角月华白，"},{"Content":"苑墙霜叶红。"},{"Content":"都人心望幸，"},{"Content":"注目不离东。"}]},{"Id":80923,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"和张文裕初寒十首"},"Clauses":[{"Content":"何处初寒好，"},{"Content":"初寒洛水桥。"},{"Content":"沙痕水清浅，"},{"Content":"风叶柳萧条。"},{"Content":"关塞长涂直，"},{"Content":"嵩丘倒影遥。"},{"Content":"凤楼虽在北，"},{"Content":"车马不尘嚣。"}]},{"Id":80922,"GroupIndex":4,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"和张文裕初寒十首"},"Clauses":[{"Content":"何处初寒好，"},{"Content":"初寒太室山。"},{"Content":"晴空烟澹泊，"},{"Content":"返照雪孱颜。"},{"Content":"极目雁稍没，"},{"Content":"无心云自还。"},{"Content":"犹馀拜表累，"},{"Content":"不得坐松间。","Comments":[{"Content":"自注：嵩山去洛近二百里，五日仅能往还。以妨拜表，未果往。","Type":"Text","Index":5}]}]},{"Id":80921,"GroupIndex":5,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"Title":{"Content":"和张文裕初寒十首"},"Clauses":[{"Content":"何处初寒好，"},{"Content":"初寒禹凿门。"},{"Content":"遥天露崖口，"},{"Content":"轻浪漱山根。"},{"Content":"万佛龛苔老，"},{"Content":"一灯林霭昏。"},{"Content":"渔梁杳相望，"},{"Content":"石濑夜声喧。"}]},{"Id":80920,"GroupIndex":6,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"和张文裕初寒十首"},"Clauses":[{"Content":"何处初寒好，"},{"Content":"初寒喷玉泉。"},{"Content":"折冰流谷口，"},{"Content":"飞溜落云边。"},{"Content":"雀噪聚林杪，"},{"Content":"樵歌下石巅。"},{"Content":"寻幽不思返，"},{"Content":"坐啸夕阳偏。"}]},{"Id":80919,"GroupIndex":7,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"齐","Rank":0,"Title":{"Content":"和张文裕初寒十首"},"Clauses":[{"Content":"何处初寒好，"},{"Content":"初寒叠石溪。"},{"Content":"山斜改昏晓，"},{"Content":"路曲失东西。"},{"Content":"拾栗走村稚，"},{"Content":"凿垣巢乳鸡。"},{"Content":"我来闲拥褐，"},{"Content":"曝背草檐低。"}]},{"Id":80918,"GroupIndex":8,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"和张文裕初寒十首"},"Clauses":[{"Content":"何处初寒好，"},{"Content":"初寒肃政台。"},{"Content":"官闲免簿领，"},{"Content":"门静少尘埃。"},{"Content":"天借风霜气，"},{"Content":"人无鹰隼猜。"},{"Content":"庭荒馀老柏，"},{"Content":"尚有夕乌来。"}]},{"Id":80917,"GroupIndex":9,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"Title":{"Content":"和张文裕初寒十首"},"Clauses":[{"Content":"何处初寒好，"},{"Content":"初寒游弈园。"},{"Content":"林间叶未尽，"},{"Content":"篱底菊犹存。"},{"Content":"结竹为庵小，"},{"Content":"开炉构火温。"},{"Content":"谁言处城市，"},{"Content":"岑寂似丘樊。"}]},{"Id":80916,"GroupIndex":10,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"和张文裕初寒十首"},"Clauses":[{"Content":"何处初寒好，"},{"Content":"初寒福善居。"},{"Content":"长宵对灯火，"},{"Content":"满室聚诗书。"},{"Content":"暂息登山屐，"},{"Content":"休脂下泽车。"},{"Content":"所安容膝地，"},{"Content":"何必更多馀。","Comments":[{"Content":"自注：游弈、福善皆坊名。","Type":"Text","Index":5}]}]},{"Id":81163,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"寄题刁景纯藏春坞","Comments":[{"Content":"景纯致政归京口，治其所居，命曰藏春坞。前有一冈皆松林，命曰万松岭","Type":"Text","Index":8}]},"Clauses":[{"Content":"藏春在何许，"},{"Content":"郁郁万松林。"},{"Content":"永日门阑静，"},{"Content":"东风花木深。"},{"Content":"主公今素发，"},{"Content":"野服遂初心。"},{"Content":"时与乡人醉，"},{"Content":"高歌散百金。"}]},{"Id":81315,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"又和岳祠谢雪题岳寺平法华庵"},"Clauses":[{"Content":"宴坐几何年，"},{"Content":"庭芜与砌连。"},{"Content":"焚修真谛苦，"},{"Content":"功行得无圆。"},{"Content":"阙里诗三百，"},{"Content":"赖乡文五千。"},{"Content":"厌烦犹不读，"},{"Content":"何况淤泥莲。","Comments":[{"Content":"自注：平住庵不出，近四十年，日诵《法华经》数十卷。","Type":"Text","Index":5}]}]},{"Id":81178,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"FirstClauseRhyme":"豪","Title":{"Content":"望日示康广宏","Comments":[{"Content":"原注：此诗旧在第十卷《司马公诗序》后。康、广、宏即司马公三子名。此诗又见《范忠宣公集》卷五","Type":"Text","Index":6}]},"Clauses":[{"Content":"清晨三绿袍，"},{"Content":"罗拜北堂高。"},{"Content":"积善因先烈，"},{"Content":"馀光及尔曹。"},{"Content":"勿矜从事早，"},{"Content":"当念起家劳。"},{"Content":"修立皆由己，"},{"Content":"何人可佩刀。"}]}],"Count":1270,"PageNo":19,"PageSize":20}