{"Authors":{"Names":["晏殊"],"AuthorIds":[27290],"Dynasties":["Song"]},"ShiData":[{"Id":198118,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"冬","Rank":0,"Title":{"Content":"和宋子京召还学士院"},"Clauses":[{"Content":"网索轩窗邃，"},{"Content":"銮坡羽卫重。"},{"Content":"鹢舟还下濑，"},{"Content":"星使出飞龙。"},{"Content":"赋待三英集，"},{"Content":"词须五吏供。"},{"Content":"会看边燧息，"},{"Content":"横霈紫泥封。"}]},{"Id":198117,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"和宋子京召还学士院"},"Clauses":[{"Content":"暮召三山峻，"},{"Content":"晨趋一节回。"},{"Content":"乍维青雀舫，"},{"Content":"还直右银台。"},{"Content":"陟降丹涂密，"},{"Content":"论思武帐开。"},{"Content":"欲谈当世务，"},{"Content":"元藉轶群才。","Comments":[{"Content":"以上同上书卷二○引《复斋漫录》","Type":"Text","Index":5}]}]},{"Id":198139,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"送董信州"},"Clauses":[{"Content":"凤阙承丹诏，"},{"Content":"麟符得旧乡。"},{"Content":"雨中吴岫碧，"},{"Content":"林罅楚梅黄。"},{"Content":"使节江湖外，"},{"Content":"城楼翼轸旁。"},{"Content":"吾知召南树，"},{"Content":"从此接维桑。","Comments":[{"Content":"宋王象之《舆地纪胜》卷二一《江南东路·信州》","Type":"Text","Index":5}]}]},{"Id":198140,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"送僧归护国寺"},"Clauses":[{"Content":"海峤黄金刹，"},{"Content":"安禅不记秋。"},{"Content":"来膺臣宰召，"},{"Content":"归泛越人舟。"},{"Content":"达性融三界，"},{"Content":"随缘极四流。"},{"Content":"还持双股锡，"},{"Content":"拂藓坐岩幽。"}]},{"Id":198132,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"奉和真宗御制后苑杂花海棠"},"Clauses":[{"Content":"太液波才绿，"},{"Content":"灵和絮未飘。"},{"Content":"霞文光启旦，"},{"Content":"珠琲密封条。"},{"Content":"积润涵仙露，"},{"Content":"浓英夺海绡。"},{"Content":"九阳资造化，"},{"Content":"天意属乔繇。"}]},{"Id":198143,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"Title":{"Content":"海棠"},"Clauses":[{"Content":"杳霭何惊目，"},{"Content":"鲜妍欲荡魂。"},{"Content":"向人无限思，"},{"Content":"当昼不胜繁。"},{"Content":"浩露晴方浥，"},{"Content":"游蜂暖更喧。"},{"Content":"只应春有意，"},{"Content":"留赠子山园。"}]},{"Id":198119,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"和枢密侍郎因看海棠忆禁苑此花最盛"},"Clauses":[{"Content":"青琐曾留眄，"},{"Content":"珍丛宛未移。"},{"Content":"幸分霖雨润，"},{"Content":"犹见艳阳姿。"},{"Content":"岸帻来朱槛，"},{"Content":"攀条忆绛蕤。"},{"Content":"能令人爱树，"},{"Content":"不独召南诗。","Comments":[{"Content":"以上宋陈思《海棠谱》卷中","Type":"Text","Index":5}]}]},{"Id":198126,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"奉和圣制元日"},"Clauses":[{"Content":"夏正标吉朔，","Comments":[{"Content":"原作告，据四库本改","Type":"Text","Index":4}]},{"Content":"尧历载初辰。"},{"Content":"柏叶清樽举，"},{"Content":"椒花绮颂陈。"},{"Content":"年芳随律盛，"},{"Content":"皇泽与时均。"},{"Content":"共有华封意，"},{"Content":"升平亿兆民。"}]},{"Id":198128,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"奉和圣制立春日"},"Clauses":[{"Content":"紫宙星回后，"},{"Content":"青郊斗建时。","Comments":[{"Content":"四库本作转","Type":"Text","Index":4}]},{"Content":"上林莺啭早，"},{"Content":"南亩雪消迟。"},{"Content":"云矞千祥集，"},{"Content":"风条万类滋。"},{"Content":"皇情同率土，"},{"Content":"黔首颂昌期。"}]},{"Id":198124,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"奉和圣制上元夜"},"Clauses":[{"Content":"勾芒司节令，"},{"Content":"鹑火中星规。"},{"Content":"广陌消尘雾，"},{"Content":"重城集宴嬉。"},{"Content":"仙韶闻玉琯，"},{"Content":"宝焰列琼枝。"},{"Content":"万国同嘉会，"},{"Content":"胥庭即此时。"}]},{"Id":198123,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"奉和圣制上元"},"Clauses":[{"Content":"协风阳律应，"},{"Content":"满砌荚蓂新。"},{"Content":"绛阙罗千卫，"},{"Content":"华灯曜百轮。"},{"Content":"悠悠未央夜，"},{"Content":"粲粲彼都人。"},{"Content":"万宇今无外，"},{"Content":"登台共乐春。"}]},{"Id":198121,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"奉和圣制上元"},"Clauses":[{"Content":"凤掖千门迥，"},{"Content":"金缸四照然。"},{"Content":"市阛通夜阙，"},{"Content":"歌肆与云连。"},{"Content":"叠鼓迷清漏，"},{"Content":"游车际晓天。"},{"Content":"泛膏仍洁祀，"},{"Content":"蚕麦伫登年。"}]},{"Id":198122,"GroupIndex":3,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"奉和圣制上元"},"Clauses":[{"Content":"鹑火告中时，"},{"Content":"皇州盛若兹。"},{"Content":"九阳同化洽，"},{"Content":"万汇得春熙。"},{"Content":"楼月将收晚，"},{"Content":"歌云度欲迟。","Comments":[{"Content":"四库本作欲度","Type":"Text","Index":4}]},{"Content":"布和周海域，"},{"Content":"翾蠕遂收宜。"}]},{"Id":198103,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"Title":{"Content":"上元夕次韵答张谏议"},"Clauses":[{"Content":"歌吹欢娱夕，"},{"Content":"衡门可属垣。"},{"Content":"九城寒漏彻，"},{"Content":"三市宝灯繁。"},{"Content":"酒想嵇山醉，"},{"Content":"诗惭谢乐翻。","Comments":[{"Content":"四库本作浅","Type":"Text","Index":3}]},{"Content":"如容陪后乘，"},{"Content":"那避八驺喧。"}]},{"Id":198111,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"次韵和天章范待制上元从幸会灵观"},"Clauses":[{"Content":"春莺欲满枝，"},{"Content":"荷橐从游时。"},{"Content":"旭日生华盖，"},{"Content":"灵风入羽旗。"},{"Content":"酒含雕玉浅，"},{"Content":"香度博山迟。"},{"Content":"共识天颜近，"},{"Content":"都忘昼漏移。"}]},{"Id":198120,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"奉和圣制上巳日"},"Clauses":[{"Content":"青阳三巳日，"},{"Content":"佳气九城中。"},{"Content":"洛饮传周俗，"},{"Content":"溱诗载郑风。"},{"Content":"停轮浮桂醑，","Comments":[{"Content":"补编作醴","Type":"Text","Index":5}]},{"Content":"解袂泛兰丛。"},{"Content":"选胜开慈宴，"},{"Content":"多欢组绶同。"}]},{"Id":198104,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"中秋月","Comments":[{"Content":"与通判徐仲谋、谯县李宗易、将作监主簿张彭同赋","Type":"Text","Index":3}]},"Clauses":[{"Content":"三十六旬内，"},{"Content":"此时心赏并。"},{"Content":"中分九秋夜，"},{"Content":"占断百宵明。"},{"Content":"冷照兰闺澈，"},{"Content":"光含绮席清。"},{"Content":"谁知沧海曲，"},{"Content":"珠蚌最盈盈。"}]},{"Id":198105,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"中秋月"},"Clauses":[{"Content":"天时与人意，"},{"Content":"龃龉旧无疑。"},{"Content":"坐久翻遗恨，"},{"Content":"光来已后期。"},{"Content":"行云凝黛色，"},{"Content":"见跋费金枝。"},{"Content":"况复输来夜，"},{"Content":"笙歌继夕曦。","Comments":[{"Content":"以上同上书卷三一","Type":"Text","Index":5}]}]},{"Id":198102,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"八日菊","Comments":[{"Content":"是日与集贤彭秘书乘、集贤王寺丞琪、良水富监丞弼、王进士许西园会饮，同赋此题洎《酒胡》一章。薄暮，王殿中轸见访，因亦与会","Type":"Text","Index":3}]},"Clauses":[{"Content":"瑞蓂才半折，"},{"Content":"金蕊已争妍。"},{"Content":"幸得重阳近，"},{"Content":"贪为一日先。"},{"Content":"登高谋宿约，"},{"Content":"泛酒试芳筵。"},{"Content":"诘旦寻馀馥，"},{"Content":"明知赏爱偏。"}]},{"Id":198141,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"重阳夕内宿"},"Clauses":[{"Content":"把菊醒陶酒，"},{"Content":"扬鞭入汉闱。"},{"Content":"聚蚊秋未息，","Comments":[{"Content":"原作蛟，据四库本改","Type":"Text","Index":2}]},{"Content":"独鸟暮先归。"},{"Content":"世有凉暄隔，"},{"Content":"人无今昨非。"},{"Content":"悠然倒冠佩，","Comments":[{"Content":"四库本作馆","Type":"Text","Index":4}]},{"Content":"频梦北山薇。"}]}],"Count":360,"PageNo":0,"PageSize":20}