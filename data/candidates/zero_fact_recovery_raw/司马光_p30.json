{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80901,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"和尧夫首尾吟"},"Clauses":[{"Content":"尧夫非是爱吟诗，"},{"Content":"安乐窝中无所为。"},{"Content":"古道白头无外用，"},{"Content":"今时青眼几人知。"},{"Content":"嵩山洛水长相见，"},{"Content":"秋月春风不失期。"},{"Content":"筋力虽衰才思壮，"},{"Content":"递年比较未尝亏。","Comments":[{"Content":"同上书卷二○附","Type":"Text","Index":7}]}]},{"Id":81204,"Classes":["軍旅 要地","軍旅 太平","軍旅 出鎮","軍旅 送行"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"御筵送李宣徽知真定府","Comments":[{"Content":"昭亮","Type":"Text","Index":6}]},"Clauses":[{"Content":"秋风萧瑟引华旌，"},{"Content":"祖宴高张出斗城。"},{"Content":"玉馔芳菲罗百铁，"},{"Content":"绣衣照耀拥千兵。"},{"Content":"骊歌未阕长杨苑，"},{"Content":"骑吹先临细柳营。"},{"Content":"雨露醲恩何以报，"},{"Content":"沙场不惜树功名。","Comments":[{"Content":"《永乐大典》卷一○九九九","Type":"Text","Index":7}]}]},{"Id":81231,"Classes":["題畫 故實"],"Froms":["御定历代题画诗类卷四十一 故实类"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"睢阳五老图"},"Clauses":[{"Content":"图谋已就乐时闲，"},{"Content":"晓向田园喜脱冠。"},{"Content":"心志不灰犹有策，"},{"Content":"星长还在尚无桓。"},{"Content":"朝阳鸣凤身轻暖，"},{"Content":"赴壑刚蛇齿健寒。"},{"Content":"仪表珍藏传不朽，"},{"Content":"每于清士敬持看。","Comments":[{"Content":"清陈邦《御定历代题画诗类》卷四一","Type":"Text","Index":7}]}]},{"Id":81173,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"悼静照堂僧"},"Clauses":[{"Content":"宝阁灰寒静照新，"},{"Content":"马啼从此踏京尘。"},{"Content":"金门乞得诗千首，"},{"Content":"萧寺归时老一身。"},{"Content":"弟子去来浑领袖，"},{"Content":"交朋存殁半簪绅。"},{"Content":"西风又剪梧桐叶，"},{"Content":"不见蒲团旧主人。","Comments":[{"Content":"清沈季友《槜李诗系》卷三七","Type":"Text","Index":7}]}]},{"Id":80836,"Classes":["題畫 故實"],"Froms":["御定历代题画诗类卷四十一 故实类"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"次韵谢杜祁公借观五老图"},"Clauses":[{"Content":"脱遗轩冕就安闲，"},{"Content":"笑傲丘园纵倒冠。"},{"Content":"白发忧民虽种种，"},{"Content":"丹心许国尚桓桓。"},{"Content":"鸿冥得路高难慕，"},{"Content":"松老无风韵自寒。"},{"Content":"闻说优游多唱和，"},{"Content":"新篇何惜画图看。","Comments":[{"Content":"清厉鹗《宋诗纪事》卷一四引《铁网珊瑚》","Type":"Text","Index":7}]}]},{"Id":81367,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"删","Rank":0,"Title":{"Content":"华州祗役往冯翊留别楚正叔","Comments":[{"Content":"建中","Type":"Text","Index":12}]},"Clauses":[{"Content":"芳菲不得驻，"},{"Content":"会取馀春还。"},{"Content":"欲知回首处，"},{"Content":"渭曲苍茫间。"}]},{"Id":80514,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"有","Rank":0,"Title":{"Content":"何秀才郊园五首","Comments":[{"Content":"汉伦","Type":"Text","Index":3}]},"Clauses":[{"Content":"主人耽诗书，"},{"Content":"乐道深居久。"},{"Content":"挟策往来游，"},{"Content":"东冈复南亩。"}]},{"Id":80513,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"先","Rank":0,"Title":{"Content":"何秀才郊园五首","Comments":[{"Content":"汉伦","Type":"Text","Index":3}]},"Clauses":[{"Content":"浊酒不取味，"},{"Content":"素琴无复弦。"},{"Content":"何须更清论，"},{"Content":"相见自萧然。"}]},{"Id":80512,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"寒","Rank":0,"Title":{"Content":"何秀才郊园五首","Comments":[{"Content":"汉伦","Type":"Text","Index":3}]},"Clauses":[{"Content":"苍苍竹林暝，"},{"Content":"郁郁松气寒。"},{"Content":"纵横兴来笔，"},{"Content":"攲侧醉中冠。"}]},{"Id":80511,"GroupIndex":4,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"Title":{"Content":"何秀才郊园五首","Comments":[{"Content":"汉伦","Type":"Text","Index":3}]},"Clauses":[{"Content":"褰裳涉幽涧，"},{"Content":"日落烟岩空。"},{"Content":"踌躇待新月，"},{"Content":"长啸来清风。"}]},{"Id":80510,"GroupIndex":5,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"霰","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"何秀才郊园五首","Comments":[{"Content":"汉伦","Type":"Text","Index":3}]},"Clauses":[{"Content":"夏木绕茅庐，"},{"Content":"棋酒资清宴。"},{"Content":"密叶绿藏枝，"},{"Content":"空闻黄鸟啭。"}]},{"Id":80581,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"寘","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"奉和经略庞龙图延州南城八咏"},"SubTitle":{"Content":"迎薰亭"},"Clauses":[{"Content":"华馆压清波，"},{"Content":"坐待南风至。"},{"Content":"须知明牧贤，"},{"Content":"善达吾君意。"}]},{"Id":81501,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"霰","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"奉和经略庞龙图延州南城八咏"},"SubTitle":{"Content":"供兵硙"},"Clauses":[{"Content":"晨暮响寒泉，"},{"Content":"飞轮驶风转。"},{"Content":"士饱气益振，"},{"Content":"轻与先零战。"}]},{"Id":81502,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"梗","Rank":0,"Title":{"Content":"奉和经略庞龙图延州南城八咏"},"SubTitle":{"Content":"柳湖"},"Clauses":[{"Content":"依依烟未歇，"},{"Content":"漠漠风初静。"},{"Content":"浮花满波面，"},{"Content":"不见参差影。"}]},{"Id":81499,"GroupIndex":4,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"灰","Rank":0,"Title":{"Content":"奉和经略庞龙图延州南城八咏"},"SubTitle":{"Content":"飞盖园"},"Clauses":[{"Content":"军中富馀暇，"},{"Content":"飞盖南城隈。"},{"Content":"雍容陪后乘，"},{"Content":"一一应刘才。"}]},{"Id":80582,"GroupIndex":5,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"先","Rank":0,"Title":{"Content":"奉和经略庞龙图延州南城八咏"},"SubTitle":{"Content":"翠漪亭"},"Clauses":[{"Content":"雕檐日华动，"},{"Content":"滉瀁照漪涟。"},{"Content":"四月芰荷满，"},{"Content":"不似在穷边。"}]},{"Id":81500,"GroupIndex":6,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"5","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"奉和经略庞龙图延州南城八咏"},"SubTitle":{"Content":"延利渠"},"Clauses":[{"Content":"枝分清浅流，"},{"Content":"纵横贯城市。"},{"Content":"还如恩在人，"},{"Content":"润泽无终既。"}]},{"Id":81503,"GroupIndex":7,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"药","Rank":0,"FirstClauseRhyme":"咸","Title":{"Content":"奉和经略庞龙图延州南城八咏"},"SubTitle":{"Content":"缘云轩"},"Clauses":[{"Content":"逼汉敞高岩，"},{"Content":"缘云结飞阁。"},{"Content":"东山草树曛，"},{"Content":"致足登临乐。"}]},{"Id":80583,"GroupIndex":8,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"奉和经略庞龙图延州南城八咏"},"SubTitle":{"Content":"禊堂"},"Clauses":[{"Content":"箫鼓震阳休，"},{"Content":"组练照芳洲。"},{"Content":"意气坐中客，"},{"Content":"羞笑山阴游。"}]},{"Id":81407,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"药","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"和之美舟行杂诗八首"},"SubTitle":{"Content":"舟中夜坐"},"Clauses":[{"Content":"风柳动萧疏，"},{"Content":"寒星浸寥落。"},{"Content":"中宵四寂然，"},{"Content":"时有游鱼跃。"}]}],"Count":1270,"PageNo":30,"PageSize":20}