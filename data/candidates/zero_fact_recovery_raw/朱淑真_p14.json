{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":536149,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"围炉"},"Clauses":[{"Content":"昨夜霜风透胆寒，"},{"Content":"围炉漫意昔年欢。"},{"Content":"如今独坐无人说，"},{"Content":"拨闷惟凭酒力宽。"}]},{"Id":536150,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"海棠"},"Clauses":[{"Content":"天与娇娆缀作花，"},{"Content":"更于枝上散馀霞。"},{"Content":"少陵漫道多诗兴，"},{"Content":"不得当时一句誇。"}]},{"Id":536151,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"芍药"},"Clauses":[{"Content":"芬芳红紫间成丛，"},{"Content":"独占花王品第中。"},{"Content":"到底只留为谑赠，"},{"Content":"更劳国史刺民风。"}]},{"Id":536152,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"牡丹"},"Clauses":[{"Content":"娇娆万态逞殊芳，"},{"Content":"花品名中占得王。"},{"Content":"莫把倾城比颜色，"},{"Content":"从来家国为伊亡。"}]},{"Id":536153,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"黄芙蓉"},"Clauses":[{"Content":"如何天赋与芬芳，"},{"Content":"徒作佳人淡伫妆。"},{"Content":"试倩东风一为主，"},{"Content":"轻黄应不让姚黄。"}]},{"Id":96189,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"Title":{"Content":"长春花","Comments":[{"Content":"一作董嗣杲诗","Type":"Text","Index":3}]},"Clauses":[{"Content":"一枝才谢一枝殷，"},{"Content":"自是春工不与闲。"},{"Content":"纵使牡丹称绝艳，"},{"Content":"到头荣瘁片时间。"}]},{"Id":536154,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"蔷薇花"},"Clauses":[{"Content":"飞葩散乱拥栏香，"},{"Content":"万朵千枝不计行。"},{"Content":"烂漫初开向清昼，"},{"Content":"会稽太守乍还乡。"}]},{"Id":96226,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"蔷薇花"},"Clauses":[{"Content":"满地红影蘸秋光，","Comments":[{"Content":"元刻本作池","Type":"Text","Index":2}]},{"Content":"始觉芙蓉植在旁。"},{"Content":"赖有佳人频醉赏，"},{"Content":"和将红粉更施妆。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[在旁]《武林》本作[在傍]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":536155,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"樱桃"},"Clauses":[{"Content":"为花结实自殊常，"},{"Content":"摘下盘中颗颗香。"},{"Content":"味重不容轻众口，"},{"Content":"独于寝庙荐先尝。"}]},{"Id":536156,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"梅花二首"},"Clauses":[{"Content":"园林萧索未迎春，"},{"Content":"独尔花开处处新。"},{"Content":"只有官娃无一事，"},{"Content":"每将施额斗妆匀。"}]},{"Id":536157,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"梅花二首"},"Clauses":[{"Content":"消得骚人几许时，"},{"Content":"疏篱淡月著横枝。"},{"Content":"破荒的皪香随马，"},{"Content":"春信先教驿使知。","Comments":[{"Content":"此句原缺，据《诗渊》册二补","Type":"Text","Index":7}]}]},{"Id":536160,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"腊月踯躅一枝独开"},"Clauses":[{"Content":"园林经腊正彫残，"},{"Content":"独尔花开烂漫鲜。"},{"Content":"借问陇梅知幸否，"},{"Content":"得陪春卉共时妍。"}]},{"Id":96337,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"青","Title":{"Content":"后庭花"},"Clauses":[{"Content":"岂意为花属后庭，"},{"Content":"荒迷亡国自兹生。"},{"Content":"至今犹恨隔江唱，"},{"Content":"可惜当时枉用情。"}]},{"Id":536161,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"佳","Rank":0,"Title":{"Content":"乞兰"},"Clauses":[{"Content":"幽芳别得化工栽，"},{"Content":"红紫纷纷莫与偕。"},{"Content":"珍重故人培养厚，"},{"Content":"真香独许寄庭阶。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》后集卷五，总题花木类","Type":"Text","Index":7}]}]},{"Id":536162,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"项羽二首"},"Clauses":[{"Content":"自古兴亡本自天，"},{"Content":"岂容人力预其间。"},{"Content":"非凭天与凭骓逝，"},{"Content":"骓不前兮战已闲。"}]},{"Id":536163,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"项羽二首"},"Clauses":[{"Content":"盖世英雄力拔山，"},{"Content":"岂知天意在西关。","Comments":[{"Content":"元刻本作主","Type":"Text","Index":5}]},{"Content":"范增可用非能用，"},{"Content":"徒叹身亡顷刻间。"}]},{"Id":536164,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"韩信"},"Clauses":[{"Content":"男儿忍辱志长存，"},{"Content":"出胯曾无怨一言。"},{"Content":"漂母人亡石空在，"},{"Content":"不知还肯念王孙。"}]},{"Id":536165,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"张良"},"Clauses":[{"Content":"功成名遂便归休，"},{"Content":"天道分明不与留。"},{"Content":"果可人间恋驹隙，"},{"Content":"何心愿学赤松游。"}]},{"Id":536166,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"陆贾"},"Clauses":[{"Content":"汉方扰扰袭秦风，"},{"Content":"勇士相高马上功。"},{"Content":"惟有君侯守奇节，"},{"Content":"能将新语悟宸衷。"}]},{"Id":536167,"Classes":["軍旅"],"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"遇","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"贾生"},"Clauses":[{"Content":"文帝为君固有馀，"},{"Content":"岂容流涕复长吁。"},{"Content":"单于可击非无策，"},{"Content":"表饵陈来术已疏。"}]}],"Count":367,"PageNo":14,"PageSize":20}