{"Authors":{"Names":["祖咏"],"AuthorIds":[18935],"Dynasties":["Tang"]},"ShiData":[{"Id":41264,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"谒河上公庙"},"Clauses":[{"Content":"河上公遗迹，"},{"Content":"迹凉在道边。"},{"Content":"草生空庙里，"},{"Content":"□□□□□。"},{"Content":"□□□知圣，"},{"Content":"腾空更表仙。"},{"Content":"孝文皇帝后，"},{"Content":"章句至今传。","Comments":[{"Content":"《","Type":"Text","Index":0},{"Content":"》","Type":"Text","Index":2}]}]},{"Id":41262,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"扈从御宿池","Comments":[{"Content":"一本题作兰峰题张中丞九皋","Type":"Text","Index":5}]},"Clauses":[{"Content":"君王既巡狩，"},{"Content":"辇道入秦京。","Comments":[{"Content":"一作路","Type":"Text","Index":2}]},{"Content":"远树低枪垒，"},{"Content":"孤峰入幔城。","Comments":[{"Content":"一作山","Type":"Text","Index":2}]},{"Content":"寒疏清禁漏，"},{"Content":"夜警羽林兵。"},{"Content":"谁念迷方客，"},{"Content":"长怀魏阙情。"}]},{"Id":41268,"Allusions":[{"AllusionIndex":853,"AllusionKey":"茂陵病","SentenceIndex":3}],"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"赠苗发员外","Comments":[{"Content":"一作李端诗","Type":"Text","Index":5}]},"Clauses":[{"Content":"宿雨朝来歇，"},{"Content":"空山天气清。"},{"Content":"盘云双鹤下，"},{"Content":"隔水一蝉鸣。"},{"Content":"古道黄花落，"},{"Content":"平芜赤烧生。"},{"Content":"茂陵虽有病，"},{"Content":"犹得伴君行。"}]},{"Id":41265,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"答王维留宿"},"Clauses":[{"Content":"四年不相见，"},{"Content":"相见复何为。"},{"Content":"握手言未毕，"},{"Content":"却令伤别离。"},{"Content":"升堂还驻马，"},{"Content":"酌醴便呼儿。"},{"Content":"语嘿自相对，"},{"Content":"安用傍人知。"}]},{"Id":41250,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"长乐驿留别卢象裴总"},"Clauses":[{"Content":"朝来已握手，"},{"Content":"宿别更伤心。"},{"Content":"灞水行人渡，","Comments":[{"Content":"一作绝","Type":"Text","Index":5}]},{"Content":"商山驿路深。"},{"Content":"故情君且足，"},{"Content":"谪宦我难任。"},{"Content":"直道皆如此，"},{"Content":"谁能泪满襟。","Comments":[{"Content":"前四句，洪迈取为绝句","Type":"Text","Index":5}]}]},{"Id":41259,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"送刘高邮棁使入都"},"Clauses":[{"Content":"常闻积归思，"},{"Content":"昨夜又兼秋。"},{"Content":"乡路京华远，"},{"Content":"王程江水流。"},{"Content":"吴歌喧两岸，"},{"Content":"楚客醉孤舟。"},{"Content":"渐觉潮初上，"},{"Content":"悽然多暮愁。"}]},{"Id":41260,"Allusions":[{"AllusionIndex":2867,"AllusionKey":"西园","SentenceIndex":3}],"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"宴吴王宅"},"Clauses":[{"Content":"吴王承国宠，"},{"Content":"列第禁城东。"},{"Content":"连夜徵词客，"},{"Content":"当春试舞童。"},{"Content":"砌分池水岸，"},{"Content":"窗度竹林风。"},{"Content":"更待西园月，","Comments":[{"Content":"西园","Type":"AllusionKey","Index":4}]},{"Content":"金尊乐未终。"}]},{"Id":41253,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"观华岳"},"Clauses":[{"Content":"西入秦关口，"},{"Content":"南瞻驿路连。"},{"Content":"彩云生阙下，"},{"Content":"松树到祠边。"},{"Content":"作镇当官道，"},{"Content":"雄都俯大川。","Comments":[{"Content":"一作为雄控","Type":"Text","Index":3}]},{"Content":"莲峰径上处，","Comments":[{"Content":"一作危","Type":"Text","Index":1}]},{"Content":"彷佛有神仙。"}]},{"Id":41258,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"泗上冯使君南楼作"},"Clauses":[{"Content":"井邑连淮泗，"},{"Content":"南楼向晚过。"},{"Content":"望滩沙鹭起，"},{"Content":"寻岸浴童歌。"},{"Content":"近海云偏出，"},{"Content":"兼秋雨更多。"},{"Content":"明晨拟回棹，"},{"Content":"乡思恨风波。","Comments":[{"Content":"一作归","Type":"Text","Index":1}]}]},{"Id":41255,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"苏氏别业"},"Clauses":[{"Content":"别业居幽处，"},{"Content":"到来生隐心。"},{"Content":"南山当户牖，"},{"Content":"沣水映园林。"},{"Content":"屋覆经冬雪，","Comments":[{"Content":"一作竹","Type":"Text","Index":1}]},{"Content":"庭昏未夕阴。"},{"Content":"寥寥人境外，"},{"Content":"闲坐听春禽。"}],"Comments":[{"Book":"《唐诗镜》","Content":"景趣幽绝。","IsComment":false,"FullPath":"《唐诗镜》"},{"Book":"《唐诗归》","Content":"谭云：才“生隐心”妙（“到来”句下）！钟云：“未夕”，“未”字生得，有景（“庭昏”句下）。钟云：静（末句下）。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗选脉会通评林》","Content":"蒋一葵曰：似有得者之谈。吴国伦曰：结联有洒乐无边景象。徐中行曰：结别有幽致。徐用吾曰：王维《河北城楼》诗“寂寥天地暮，心与广川平”，与此诗结皆萧洒出尘。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗选》","Content":"玉遮曰：“生隐心”句有清致。","IsComment":false,"FullPath":"《唐诗选》"},{"Book":"《唐诗摘钞》","Content":"起联总冒格。一二平直，三四雄浑，五六精工，七八渊水。五律调法匀称无逾此篇。","IsComment":false,"FullPath":"《唐诗摘钞》"},{"Book":"《增订唐诗摘钞》","Content":"通篇以“生隐心”作骨，而所以生隐心，则在一“幽”字，故中二联极力写“幽”字。","IsComment":false,"FullPath":"《增订唐诗摘钞》"},{"Book":"《唐贤三昧集笺注》","Content":"宛然仙境，使人神思清旷。","IsComment":false,"FullPath":"《唐贤三昧集笺注》"},{"Book":"《唐诗合选详解》","Content":"王一士曰：前以“幽”、“隐”二字伏根，以下俱描写幽隐。","IsComment":false,"FullPath":"《唐诗合选详解》"},{"Book":"《唐宋诗举要》","Content":"吴曰：中四语极力出奇。","IsComment":false,"FullPath":"《唐宋诗举要》"},{"Content":"（1）隐心：隐居之心。（2）牖[音：“有”]：窗户。（3）沣[音“丰”]水：水名，发源于秦岭，经户县、西安入渭水。（4）未夕：还未到黄昏。","IsComment":false}]},{"Id":41251,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"汝坟别业"},"Clauses":[{"Content":"失路农为业，"},{"Content":"移家到汝坟。"},{"Content":"独愁常废卷，"},{"Content":"多病久离群。"},{"Content":"鸟雀垂窗柳，"},{"Content":"虹霓出涧云。"},{"Content":"山中无外事，"},{"Content":"樵唱有时闻。"}]},{"Id":41256,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"陆浑水亭"},"Clauses":[{"Content":"昼眺伊川曲，","Comments":[{"Content":"一作水","Type":"Text","Index":5}]},{"Content":"岩间霁色明。"},{"Content":"浅沙平有路，","Comments":[{"Content":"一作明","Type":"Text","Index":3}]},{"Content":"流水漫无声。"},{"Content":"浴鸟沿波聚，"},{"Content":"潜鱼触钓惊。"},{"Content":"更怜春岸绿，"},{"Content":"幽意满前楹。","Comments":[{"Content":"一作兴","Type":"Text","Index":2}]}],"Comments":[{"Book":"《唐诗解》","Content":"真五律，真盛唐。","IsComment":false,"FullPath":"《唐诗解》"},{"Book":"《唐诗归》","Content":"钟云：四句静心细语（按指“浅沙”以下四句），","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗选脉会通评林》","Content":"薛蕙曰：平易景，道人所不道。徐用吾曰：景兴少许自足。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗绪笺》","Content":"平旷静定之怀可掬，是有道气象。","IsComment":false,"FullPath":"《唐诗绪笺》"}]},{"Id":41254,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"过郑曲"},"Clauses":[{"Content":"路向荣川谷，","Comments":[{"Content":"一作夕","Type":"Text","Index":5}]},{"Content":"晴来望尽通。"},{"Content":"细烟生水上，"},{"Content":"圆月在舟中。"},{"Content":"岸势迷行客，"},{"Content":"秋声乱草虫。"},{"Content":"旅怀劳自慰，"},{"Content":"淅淅有凉风。"}],"Comments":[{"Book":"《唐诗归》","Content":"谭云：“劳自慰”三字，一时看不出妙处，凄凉中生出游戏来（“旅怀”句下）。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐风定》","Content":"微开浪仙一派。","IsComment":false,"FullPath":"《唐风定》"},{"Book":"《唐诗评选》","Content":"祖诗往往露刻画痕，如“海色晴看雨”竟以名世，要不足取。此作安静，迥异他篇。","IsComment":false,"FullPath":"《唐诗评选》"}]},{"Id":41261,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"宿陈留李少府揆厅"},"Clauses":[{"Content":"相知有叔卿，","Comments":[{"Content":"一作李","Type":"Text","Index":4}]},{"Content":"讼简夜弥清。"},{"Content":"旅泊倦愁卧，","Comments":[{"Content":"一作宿","Type":"Text","Index":2}]},{"Content":"堂空闻曙更。"},{"Content":"风帘摇烛影，","Comments":[{"Content":"一作檐","Type":"Text","Index":2},{"Content":"一作竹","Type":"Text","Index":4}]},{"Content":"秋雨带虫声。"},{"Content":"归思那堪说，"},{"Content":"悠悠限洛城。","Comments":[{"Content":"中四句，洪迈作绝句","Type":"Text","Index":5}]}]},{"Id":41267,"Allusions":[{"AllusionIndex":733,"AllusionKey":"武陵趣","SentenceIndex":3},{"AllusionIndex":7682,"AllusionKey":"梅福","SentenceIndex":0}],"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"题韩少府水亭"},"Clauses":[{"Content":"梅福幽栖处，","Comments":[{"Content":"梅福","Type":"AllusionKey","Index":2}]},{"Content":"佳期不忘还。"},{"Content":"鸟吟当户竹，","Comments":[{"Content":"一作啼","Type":"Text","Index":2}]},{"Content":"花绕傍池山。"},{"Content":"水气侵阶冷，"},{"Content":"松阴覆座闲。","Comments":[{"Content":"一作藤","Type":"Text","Index":1}]},{"Content":"宁知武陵趣，","Comments":[{"Content":"武陵趣","Type":"AllusionKey","Index":5}]},{"Content":"宛在市朝间。"}]},{"Id":41266,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"题远公经台"},"Clauses":[{"Content":"兰若无人到，"},{"Content":"真僧出复稀。"},{"Content":"苔侵行道席，"},{"Content":"云湿坐禅衣。"},{"Content":"涧鼠缘香案，"},{"Content":"山蝉噪竹扉。"},{"Content":"世间长不见，"},{"Content":"宁止暂忘归。"}]},{"Id":41252,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"江南旅情"},"Clauses":[{"Content":"楚山不可极，"},{"Content":"归路但萧条。","Comments":[{"Content":"一作客自","Type":"Text","Index":3}]},{"Content":"海色晴看雨，"},{"Content":"江声夜听潮。"},{"Content":"剑留南斗近，"},{"Content":"书寄北风遥。"},{"Content":"为报空潭橘，"},{"Content":"无媒寄洛桥。","Comments":[{"Content":"一作赠","Type":"Text","Index":3}]}],"Comments":[{"Book":"《唐诗训解》","Content":"起洒而朗。","IsComment":false,"FullPath":"《唐诗训解》"},{"Book":"《唐诗归》","Content":"谭云：“看”字属人说，妙，妙（“海色”句下）。谭云：报橘妙，妙（“为报”句下）。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗选脉会通评林》","Content":"杨慎曰：次联须亲历此景，方知佳趣。宗臣曰：起联洒而朗。颔联幽而雅，颈联奇而秀。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗摘钞》","Content":"八句重一“寄”字，后人以“赠”字易之，然唐人只欲句格之老，正不琐琐邂忌，但后人不可为法耳。","IsComment":false,"FullPath":"《唐诗摘钞》"},{"Book":"《闻鹤轩初盛唐近体读本》","Content":"三四秀稳，唐人正调。第五述情，使古语得害异。对语亦超。","IsComment":false,"FullPath":"《闻鹤轩初盛唐近体读本》"},{"Content":"（1）楚山：楚地之山。（2）南斗：星名，南斗六星，即斗宿。古人有“南斗在吴”的说法。（3）潭橘：吴潭的橘子。（4）洛桥：洛阳天津桥，此代指洛阳。","IsComment":false}]},{"Id":41257,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"泊扬子津","Comments":[{"Content":"一作岸","Type":"Text","Index":4}]},"Clauses":[{"Content":"才入维扬郡，"},{"Content":"乡关此路遥。","Comments":[{"Content":"一作山","Type":"Text","Index":2},{"Content":"一作地","Type":"Text","Index":4}]},{"Content":"林藏初过雨，","Comments":[{"Content":"一作残","Type":"Text","Index":2},{"Content":"一作霁","Type":"Text","Index":4}]},{"Content":"风退欲归潮。"},{"Content":"江火明沙岸，"},{"Content":"云帆碍浦桥。"},{"Content":"客衣今日薄，","Comments":[{"Content":"一作正","Type":"Text","Index":4}]},{"Content":"寒气近来饶。","Comments":[{"Content":"一作夜","Type":"Text","Index":2},{"Content":"一作昨","Type":"Text","Index":3}]}],"Comments":[{"Book":"《唐诗镜》","Content":"次联苦思，然却少色。故景有所不赋者，此类是也。","IsComment":false,"FullPath":"《唐诗镜》"},{"Book":"《唐诗归》","Content":"钟云：“藏”字微矣，说“初过雨”尤妙（“林藏”句下）。谭云：二句皆妙，出尤胜（“风退”句下）。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗选脉会通评林》","Content":"周珽曰：风生潮涨，潮落风微，势原递相鼓动，用“欲归”二字，多少神思！","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗矩》","Content":"尾联见意格。此路去乡文已远，然犹才入维扬郡，则前途尚莫知纪极，回顾乡关，真是日望日远，无限悲酸俱在言外。结叹客衣之薄，所谓冷暖自知也，寓思乡之意更浑。","IsComment":false,"FullPath":"《唐诗矩》"},{"Book":"《唐三体诗评》","Content":"中四句细写不泊。落句以归里之迫，反收“泊”字。妙在发端“才人”字、“遥”字，便已见更不容于淹泊也。","IsComment":false,"FullPath":"《唐三体诗评》"},{"Book":"《唐诗成法》","Content":"“才入”者，甫离乡关而来此也。三妙在“藏”字，四妙在“欲”字；雨惟“初过林”乃能藏，潮非“欲归风”不能退。五江夜远景，六津夜近景；“碍”字妙，若无浦桥，则云帆远去而不泊矣。七结一二，八结中四。","IsComment":false,"FullPath":"《唐诗成法》"},{"Book":"《近体秋阳》","Content":"“明”、“碍”两皆炼字。“明”字人人解得，亦人人道得；“碍”字人人解得，却人人道不得（“江火”二句下）。","IsComment":false,"FullPath":"《近体秋阳》"}]},{"Id":41248,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"七夕"},"Clauses":[{"Content":"闺女求天女，"},{"Content":"更阑意未阑。"},{"Content":"玉庭开粉席，"},{"Content":"罗袖捧金盘。"},{"Content":"向月穿针易，"},{"Content":"临风整线难。"},{"Content":"不知谁得巧，"},{"Content":"明旦试相看。"}],"Comments":[{"Book":"《近体秋阳》","Content":"清浅确当，只在眼前口头，浅者不能，探者不肯，所以为佳。又曰：此诗大有初气。","IsComment":false,"FullPath":"《近体秋阳》"}]},{"Id":41263,"Classes":["軍旅 要地","軍旅 從軍"],"Allusions":[{"AllusionIndex":437,"AllusionKey":"投笔","SentenceIndex":3},{"AllusionIndex":1366,"AllusionKey":"请长缨","SentenceIndex":3}],"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"望蓟门"},"Clauses":[{"Content":"燕台一望客心惊，","Comments":[{"Content":"一作去","Type":"Text","Index":4}]},{"Content":"箫鼓喧喧汉将营。"},{"Content":"万里寒光生积雪，"},{"Content":"三边曙色动危旌。","Comments":[{"Content":"一作行","Type":"Text","Index":6}]},{"Content":"沙场烽火连胡月，"},{"Content":"海畔云山拥蓟城。"},{"Content":"少小虽非投笔吏，","Comments":[{"Content":"投笔","Type":"AllusionKey","Index":6}]},{"Content":"论功还欲请长缨。","Comments":[{"Content":"请长缨","Type":"AllusionKey","Index":7}]}],"Comments":[{"Book":"《批点唐诗正声》","Content":"壮健之气，直欲与卫、霍同出塞上。","IsComment":false,"FullPath":"《批点唐诗正声》"},{"Book":"《唐诗直解》","Content":"调高语壮，“生”、“动”、“连”、“拥”四字犯。","IsComment":false,"FullPath":"《唐诗直解》"},{"Book":"《批选唐诗》","Content":"此等诗全不著事理，直以声华胜，近体多类此。","IsComment":false,"FullPath":"《批选唐诗》"},{"Book":"《唐诗分类绳尺》","Content":"善状物色，清兴洒然。","IsComment":false,"FullPath":"《唐诗分类绳尺》"},{"Book":"《唐诗训解》","Content":"此因临边而有志于立功也。次联语顿挫又雄壮。","IsComment":false,"FullPath":"《唐诗训解》"},{"Book":"《唐风定》","Content":"整峻高亮。睥睨王、李。","IsComment":false,"FullPath":"《唐风定》"},{"Book":"《诗源辨体》","Content":"“燕台一去”一篇，实为于鳞诸子鼻祖。","IsComment":false,"FullPath":"《诗源辨体》"},{"Book":"《汇编唐诗十集》","Content":"唐云：调高语壮，是盛唐最上格。","IsComment":false,"FullPath":"《汇编唐诗十集》"},{"Book":"《唐诗选脉会通评林》","Content":"周珽曰：起寓讥边将，便有耻为碌碌尸素之想。中四句极状边庭之景。未以班超、终军自许，树勋报国之志挺然。蒋一梅曰：气象朗开。结壮。薛蕙曰：铺叙得体，词意正大。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《贯华堂选批唐才子诗》","Content":"此诗已是异样神彩，乃读末句，又见特添“少小”二字，便觉神彩再加十倍。","IsComment":false,"FullPath":"《贯华堂选批唐才子诗》"},{"Book":"《唐诗绎》","Content":"此诗见蓟城为防胡险要之地，望之动立功塞上之思。一气旋转，浑成无迹。","IsComment":false,"FullPath":"《唐诗绎》"},{"Book":"《删订唐诗解》","Content":"气象自佳，而中四句太相似。","IsComment":false,"FullPath":"《删订唐诗解》"},{"Book":"《唐诗贯珠笺释》","Content":"通首有气色，是盛唐格调。","IsComment":false,"FullPath":"《唐诗贯珠笺释》"},{"Book":"《唐贤三昧集笺注》","Content":"亦是盛唐正声。气格雄浑，以为盛唐正声洵然。","IsComment":false,"FullPath":"《唐贤三昧集笺注》"},{"Book":"《唐诗成法》","Content":"法亦紧严。中四句法稍同，亦是小疵。通首雄丽，读之生人壮心。","IsComment":false,"FullPath":"《唐诗成法》"},{"Book":"《历代诗法》","Content":"高响不浮。","IsComment":false,"FullPath":"《历代诗法》"},{"Book":"《网师园唐诗笺》","Content":"悲壮称题（“万里”一联下）。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"《唐诗笺要》","Content":"格调高秀，自不待言。“生”、“动”、“侵”、“拥”，皆炼第五字。","IsComment":false,"FullPath":"《唐诗笺要》"},{"Book":"《山满楼笺注唐诗七言律》","Content":"开口先补出“燕台”二字，此身便有着落。“客心惊”，一“惊”字包得下文七句之义；而“汉将营”三字，又七句中之提纲也。","IsComment":false,"FullPath":"《山满楼笺注唐诗七言律》"},{"Book":"《读雪山房唐诗序例》","Content":"调高气厚，为七言律正始之音，惜不多见。","IsComment":false,"FullPath":"《读雪山房唐诗序例》"},{"Book":"《唐诗三百首》","Content":"字字是“望”，非泛咏蓟门也。","IsComment":false,"FullPath":"《唐诗三百首》"},{"Book":"《唐诗五七言近体五七言绝句选评》","Content":"黄钟大吕，音响铿锵。","IsComment":false,"FullPath":"《唐诗五七言近体五七言绝句选评》"},{"Book":"《昭昧詹言》","Content":"六句写蓟城之险，而以首句一“望”字包之，收托意，有澄清之志。岂是时范阳已有萌芽耶？","IsComment":false,"FullPath":"《昭昧詹言》"},{"Book":"潘德舆评点《唐贤三昧集》","Content":"通体遒俊。三四尤得穷边陈垒情色。","IsComment":false,"FullPath":"潘德舆评点《唐贤三昧集》"},{"Book":"《唐诗近体》","Content":"“望”字空洞。","IsComment":false,"FullPath":"《唐诗近体》"},{"Book":"《唐宋诗举要》","Content":"吴曰：前六句皆写边隅景象，盖自恨来此穷裔，故云“客心惊”也，而末句乃掉转，意思故佳。","IsComment":false,"FullPath":"《唐宋诗举要》"},{"Book":"唐诗鉴赏辞典","Content":"唐代的范阳道，以今北京西南的幽州为中心，统率十六州，为东北边防重镇。它主要的防御对象是契丹。玄宗开元二年，即以并州长史薛讷为同紫薇黄门三品，将兵御契丹；二十二年，幽州节度使张守圭斩契丹王屈烈及可突干。这首诗的写作时期，大约在这二十年之间，其时祖咏当系游宦范阳。<br />燕台原为战国时燕昭王所筑的黄金台，这里代称燕地，用以泛指平卢、范阳这一带。“燕台一去”犹说“一到燕台”，四字倒装，固然是诗律中平仄声排列的要求，更重要的是，起笔即用一个壮大的地名，能增加全诗的气势。诗人初来闻名已久的边塞重镇，游目纵观，眼前是辽阔的天宇，险要的山川，不禁激情满怀。一个“惊”字，道出他这个远道而来的客子的特有感受。这是前半首主意所在，开出下文三句。<br />客心因何而惊呢？首先是因为汉家大将营中，吹笳击鼓，喧声重迭。此句运用南朝梁人曹景宗的诗意：“去时儿女悲，归来笳鼓竞。借问行路人，何如霍去病？”表现军营中号令之严肃。但仅仅如此，还未足以体现这个“惊”字。三四两句更进一步，写这笳鼓之声，是在严冬初晓之时发出的。冬季本已甚寒，何况又下雪，何况又是多少天来的积雪，何况又不止一处两处的雪，而是连绵千万里的雪；这些雪下得如此之广，又积得如此之厚，不说它是怎样的冷了，就是雪上反映出的寒光，也足以令人两眼生花。“万里寒光生积雪”这一句就这样分作四层，来托出一个“惊”字。这是往远处望。至于向高处望，则见朦胧曙色中，一切都显得模模糊糊，唯独高悬的旗帜在半空中猎猎飘扬。这种肃穆的景象，暗写出汉将营中庄重的气派和严整的军容。边防地带如此的形势和气氛，自然令诗人心灵震撼了。<br />以上四句已将“惊”字写足，五六两句便转。处在条件如此艰苦。责任如此重大的情况下，边防军队却是意气昂扬。笳鼓喧喧已显出军威赫然，而况烽火燃处，紧与胡地月光相连，雪光、月光、火光三者交织成一片，不仅没有塞上苦寒的悲凉景象，而且壮伟异常。这是向前方望。“沙场烽火连胡月”是进攻的态势。诗人又向周围望：“海畔云山拥蓟城”，又是那么稳如磐石。蓟门的南侧是渤海，北翼是燕山山脉，带山襟海，就象天生是来拱卫大唐的边疆重镇的。这是说防守的形势。这两句，一句写攻，一句说守；一句人事，一句地形。在这样有力有利气势的感染下，便从惊转入不惊，于是领出下面两句，写“望”后之感。诗人虽则早年并不如东汉时定远侯班超初为佣书吏（在官府中抄写公文），后来投笔从戎，定西域三十六国，可是见此三边壮气，却也雄心勃勃，要学西汉时济南书生终军，向皇帝请发长缨，缚番王来朝，立一下奇功了。末二句一反起句的“客心惊”，水到渠成，完满地结束全诗。<br />这首诗从军事上落笔，着力勾画山川形胜，意象雄伟阔大。全诗紧扣一个“望”字，写望中所见，抒望中所感，格调高昂，感奋人心。诗中多用实字，全然没有堆砌凑泊之感；意转而辞句中却不露转折之痕，于笔仗端凝之中，有气脉空灵之妙。此即骈文家所谓“潜气内转”，亦即古文家所谓“突接”，正是盛唐诗人的绝技。<br />〔注〕①三边：古称幽、并、凉为三边。这里泛指当时东北、北方、西北边防地带。<br />(沈熙乾)","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]}],"Count":38,"PageNo":0,"PageSize":20}