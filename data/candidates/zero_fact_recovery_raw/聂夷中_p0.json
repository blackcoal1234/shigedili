{"Authors":{"Names":["聂夷中"],"AuthorIds":[19238],"Dynasties":["Tang"]},"ShiData":[{"Id":43897,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"闻人说海北事有感"},"Clauses":[{"Content":"故乡归路隔高雷，"},{"Content":"见说年来事可哀。"},{"Content":"村落日中眠虎豹，"},{"Content":"田园雨后长蒿莱。"},{"Content":"海隅久已无春色，"},{"Content":"地底真成有劫灰。"},{"Content":"荆棘满山行不得，"},{"Content":"不知当日是谁栽。"}]},{"Id":43892,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"皓","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"公子家","Comments":[{"Content":"一作长安花，一作公子行。","Type":"Text","Index":3}]},"Clauses":[{"Content":"种花满西园，","Comments":[{"Content":"一作田","Type":"Text","Index":4}]},{"Content":"花发青楼道。"},{"Content":"花下一禾生，"},{"Content":"去之为恶草。"}],"Comments":[{"Book":"《北梦琐言》","Content":"（夷中）少贫苦，精于古体。有《公子家》诗……所谓言近意远，合《三百篇》之旨也。","IsComment":false,"FullPath":"《北梦琐言》"},{"Book":"《唐诗真趣编》","Content":"不加勘断，棒痕已深。","IsComment":false,"FullPath":"《唐诗真趣编》"},{"Book":"《唐人绝句精华》","Content":"此讥富豪子弟之无知也。","IsComment":false,"FullPath":"《唐人绝句精华》"}]},{"Id":370555,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"杂怨 其一","Comments":[{"Content":"一作征妇怨，孟郊诗，后四句倒在前","Type":"Text","Index":2}]},"Clauses":[{"Content":"生在绮罗下，"},{"Content":"岂识渔阳道。"},{"Content":"良人自戍来，"},{"Content":"夜夜梦中到。"},{"Content":"渔阳万里远，"},{"Content":"近于中门限。"},{"Content":"中门逾有时，"},{"Content":"渔阳常在眼。"}],"Comments":[{"Book":"《唐诗归》","Content":"谭云：“下”字妙（首句下）。钟云：此首见孟郊集，而用孟诗后四句倒在前，遂觉意味深永，此诗家取势法也，于此可悟其妙。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗选脉会通评林》","Content":"周敬曰：汉魏遗韵。梦生于想，想极魂随心至，故觉中门远于渔阳。彼曰“梦魂不怕险，长得到关西”，又“梦里分明见关塞，不知何路向金微”，皆此意也。前四句，犹属虚想，后四句全成真梦矣。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗归折衷》","Content":"唐云：摹写戍妇专一之思，与《葛生》“归于其居”，《伯兮》“使我心痗”，摘词则异，注想则同。","IsComment":false,"FullPath":"《唐诗归折衷》"}]},{"Id":43906,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"0","Rank":0,"Title":{"Content":"杂兴"},"Clauses":[{"Content":"两叶能蔽目，"},{"Content":"双豆能塞聪。"},{"Content":"理身不知道，"},{"Content":"将为天地聋。"},{"Content":"扰扰造化内，"},{"Content":"茫茫天地中。"},{"Content":"苟或有所愿，"},{"Content":"毛发亦不容。"}]},{"Id":43915,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"28","Rank":0,"Title":{"Content":"咏田家","Comments":[{"Content":"一作伤田家","Type":"Text","Index":3}]},"Clauses":[{"Content":"二月卖新丝，"},{"Content":"五月粜新谷。"},{"Content":"医得眼前疮，"},{"Content":"剜却心头肉。"},{"Content":"我愿君王心，"},{"Content":"化作光明烛。"},{"Content":"不照绮罗筵，"},{"Content":"只照逃亡屋。"}],"Comments":[{"Book":"《资治通鉴》","Content":"上（后唐明宗）又问（冯）道：“今岁虽丰，百姓赡足否？”道曰：“农家岁凶则死于流殍，岁丰则伤于谷贱；丰凶皆病者，唯农家为然。臣记进士聂夷中诗云：‘二月卖新丝……’语虽鄙俚，曲尽田家之情状。农于四人之中最为勤苦，人主不可不知也。”上悦，命左右录其诗，常讽诵之。","IsComment":false,"FullPath":"《资治通鉴》"},{"Book":"《诗史》","Content":"（夷中）有诗曰：“二月卖新丝……”孙光宪谓有《三百篇》之旨，此亦为诗史。","IsComment":false,"FullPath":"《诗史》"},{"Book":"《唐诗镜》","Content":"唐人入古，便少雅趣，所以为难。惟韩昌黎“青青水中蒲”最绝。","IsComment":false,"FullPath":"《唐诗镜》"},{"Book":"《五朝诗善鸣集》","Content":"烂熟不可删去。","IsComment":false,"FullPath":"《五朝诗善鸣集》"},{"Book":"《柳亭诗话》","Content":"聂夷中诗：“二月卖新丝，五月粜新谷。”或谓：“二月蚕尚未生，新丝乌有？”何燕泉曰：“盖谓贫民预指丝谷作借贷之资耳。至丝谷出时，俱是他人之物，故谓‘医得眼前疮，剜却心头肉’也。”……陆宣公奏议曰：“蚕事方毕，已输缣税；农功未艾，遽敛谷租。有者急卖而耗其半直，无者求假而费其倍酬。”夷中盖用其意。","IsComment":false,"FullPath":"《柳亭诗话》"},{"Book":"《网师园唐诗笺》","Content":"《国风》乎？《小雅》乎？悱恻乃尔（末四句下）。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"唐诗鉴赏辞典","Content":"作者极力描写田家生活的穷困，寅吃卯粮，痛苦万分，借以讽刺当政者不知民间疾苦。<br /><br />唐末广大农村破产，农民遭受的剥削更加惨重，至于颠沛流离，无以生存。在这样的严酷背景上，产生了可与李绅《悯农》二首前后辉映的聂夷中《伤田家》。有人甚至将此诗与柳宗元《捕蛇者说》并论，以为「言简意足，可匹柳文」（《唐诗别裁集》）。<br /><br />开篇就揭露封建社会农村一种典型「怪」事：二月蚕种始生，五月秧苗始插，哪有丝卖？哪有谷粜（出卖粮食）？居然「二月卖新丝，五月粜新谷」。这乃是「卖青」──将尚未产出的农产品预先贱价抵押。正用血汗喂养、栽培的东西，是一年衣食，是心头肉呵，但被挖去了。两言卖「新」，令人悲酸。卖青是迫于生计，而首先是迫于赋敛。一本将「父耕原上田，子斸山下荒。六月禾未秀，官家已修仓」四句与此诗合并，就透露出个中消息。这使人联想到民谣：「新禾不入箱，新麦不登场。殆及八九月，狗吠空垣墙。」（《高宗永淳中童谣》）明年衣食将何如，已在不言之中。紧接二句用一个形象比喻：「医得眼前疮，剜却心头肉。」它通俗、平易、恰切。「眼前疮」固然比喻眼前急难，「心头肉」固然比喻丝谷等农家命根，但这比喻所取得的惊人效果决非「顾得眼前顾不了将来」的概念化表述能及万一。「挖肉补疮」，这是何等惨痛的形象！唯其能入骨三分地揭示那血淋淋的现实，叫人一读就铭刻在心，永志不忘。诚然，挖肉补疮，自古未闻，但如此写来最能尽情，既深刻又典型，因而成为千古传诵的名句。<br /><br />「我愿君王心」以下是诗人陈情，表达改良现实的愿望，颇合新乐府倡导者提出的「惟歌生民病，愿得天子知」（白居易《寄唐生》）的精神。这里寄希望于君主开明固然有其历史局限性，但作者用意主要是讽刺与谲谏。「我愿君王心，化为光明烛」，即委婉指出当时君王之心还不是「光明烛」；望其「不照绮罗筵，只照逃亡屋」，即客观反映其一向只代表豪富的利益而不恤民病，不满之意见于言外，妙在运用反笔揭示皇帝昏聩，世道不公。「绮罗筵」与「逃亡屋」构成鲜明对比，反映出两极分化的尖锐阶级对立的社会现实，增强了批判性。它形象地暗示出农家卖青破产的原因，又由「逃亡」二字点出其结果必然是：「殚其地之出，竭其庐之入，呼号而转徙，饥渴而顿踣」，「非死而徙尔」（《捕蛇者说》），充满作者对田家的同情，可谓「言简意足」。<br /><br />胡震亨论唐诗，认为聂夷中等人「洗剥到极净极省，不觉自成一体」，而「夷中诗尤关教化」（《唐音癸签》），从此诗即可看出。其所以如此，与语言的朴素凝炼同取材造境的典型都是分不开的。<br /><br />（周啸天）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]},{"Id":43926,"GroupIndex":1,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"马","Rank":0,"Title":{"Content":"燕台二首"},"Clauses":[{"Content":"燕台累黄金，"},{"Content":"上欲招儒雅。"},{"Content":"贵得贤士来，"},{"Content":"更下于隗者。"},{"Content":"自然乐毅徒，"},{"Content":"趋风走天下。"},{"Content":"何必驰凤书，"},{"Content":"旁求向林野。"}]},{"Id":43927,"GroupIndex":2,"Allusions":[{"AllusionIndex":10515,"AllusionKey":"章华宴","SentenceIndex":-1}],"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"庚","Rank":0,"Title":{"Content":"燕台二首"},"Clauses":[{"Content":"燕台高百尺，"},{"Content":"燕灭台亦平。"},{"Content":"一种是亡国，"},{"Content":"犹得礼贤名。"},{"Content":"何似章华畔，"},{"Content":"空馀禾黍生。"}]},{"Id":43902,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"宋","Rank":0,"Title":{"Content":"古兴"},"Clauses":[{"Content":"片玉一尘轻，"},{"Content":"粒粟山丘重。"},{"Content":"唐虞贵民食，"},{"Content":"秪是勤播种。"},{"Content":"前圣后圣同，"},{"Content":"今人古人共。"},{"Content":"一岁如苦饥，"},{"Content":"金玉何所用。","Comments":[{"Content":"一作将何","Type":"Text","Index":4}]}]},{"Id":43901,"GroupIndex":2,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"歌","Rank":0,"Title":{"Content":"劝酒二首"},"Clauses":[{"Content":"灞上送行客，"},{"Content":"听唱行客歌。"},{"Content":"适来桥下水，"},{"Content":"已作渭川波。"},{"Content":"人间荣乐少，"},{"Content":"四海别离多。"},{"Content":"但恐别离泪，"},{"Content":"自成苦水河。","Comments":[{"Content":"一作浩","Type":"Text","Index":3}]},{"Content":"劝尔一杯酒，"},{"Content":"所赠无馀多。"}]},{"Id":43899,"GroupIndex":1,"Allusions":[{"AllusionIndex":1311,"AllusionKey":"驻白日","SentenceIndex":7},{"AllusionIndex":2569,"AllusionKey":"飞琼","SentenceIndex":6},{"AllusionIndex":6500,"AllusionKey":"南威","SentenceIndex":4}],"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"公子行二首"},"Clauses":[{"Content":"汉代多豪族，"},{"Content":"恩深益骄逸。"},{"Content":"走马踏杀人，"},{"Content":"街吏不敢诘。"},{"Content":"红楼宴青春，"},{"Content":"数里望云蔚。"},{"Content":"金缸焰胜昼，","Comments":[{"Content":"一作艳","Type":"Text","Index":3}]},{"Content":"不畏落晖疾。"},{"Content":"美人尽如月，"},{"Content":"南威莫能匹。","Comments":[{"Content":"一作不敢","Type":"Text","Index":4},{"Content":"南威","Type":"AllusionKey","Index":2}]},{"Content":"芙蓉自天来，"},{"Content":"不向水中出。"},{"Content":"飞琼奏云和，","Comments":[{"Content":"一作绮席戛","Type":"Text","Index":3},{"Content":"飞琼","Type":"AllusionKey","Index":2}]},{"Content":"碧箫吹凤质。"},{"Content":"唯恨鲁阳死，"},{"Content":"无人驻白日。","Comments":[{"Content":"驻白日","Type":"AllusionKey","Index":5}]}],"Comments":[{"Book":"《中晚唐诗叩弹集》","Content":"诏按：《淮南子》：鲁阳公与韩构难，战酣日暮，援戈而㧑之，日为之退三舍。末二语似与第四联背，殊不知前言卜昼卜夜，为乐何极，末乃言更无他忧，惟去日苦多，力莫能挽耳。","IsComment":false,"FullPath":"《中晚唐诗叩弹集》"}]},{"Id":43900,"GroupIndex":2,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"尤","Rank":0,"Title":{"Content":"公子行二首"},"Clauses":[{"Content":"花树出墙头，"},{"Content":"花里谁家楼。"},{"Content":"一行书不读，"},{"Content":"身封万户侯。"},{"Content":"美人楼上歌，"},{"Content":"不是古凉州。"}],"Comments":[{"Book":"《升庵诗话》","Content":"“花枝满墙头，花里谁家楼？美人楼上歌，不是古《梁州》。”伤新声日繁，古调日微也。","IsComment":false,"FullPath":"《升庵诗话》"}]},{"Id":43912,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"10","Rank":0,"Title":{"Content":"过比干墓","Comments":[{"Content":"（一作吊比干墓）。（一作孟郊诗）","Type":"Text","Index":4}]},"Clauses":[{"Content":"殷辛帝天下，"},{"Content":"厌为天下尊。"},{"Content":"乾纲既一断，"},{"Content":"贤愚无二门。"},{"Content":"佞是福身本，"},{"Content":"忠作丧己源。"},{"Content":"饿虎不食子，"},{"Content":"人无骨肉恩。"},{"Content":"日影不入地，"},{"Content":"下埋冤死魂。"},{"Content":"腐骨不为土，","Comments":[{"Content":"一作肉","Type":"Text","Index":2}]},{"Content":"应作石木根。","Comments":[{"Content":"一作直","Type":"Text","Index":3}]},{"Content":"余来过此乡，"},{"Content":"下马吊此坟。"},{"Content":"静念君臣间，"},{"Content":"有道谁敢论。","Comments":[{"Content":"一作有谁敢抗","Type":"Text","Index":4}]}]},{"Id":43913,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"5","Rank":0,"Title":{"Content":"住京寄同志"},"Clauses":[{"Content":"在京如在道，"},{"Content":"日日先鸡起。","Comments":[{"Content":"一作夜夜","Type":"Text","Index":2}]},{"Content":"不离十二街，"},{"Content":"日行一百里。"},{"Content":"役役大块上，"},{"Content":"周朝复秦市。"},{"Content":"贵贱与贤愚，"},{"Content":"古今同一轨。"},{"Content":"白兔落天西，"},{"Content":"赤鸦飞海底。"},{"Content":"一日复一日，"},{"Content":"日日无终始。"},{"Content":"自嫌性如石，"},{"Content":"不达荣辱理。"},{"Content":"试问九十翁，"},{"Content":"吾今尚如此。"}]},{"Id":43928,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"28","Rank":0,"Title":{"Content":"赠农","Comments":[{"Content":"一作孟郊诗","Type":"Text","Index":2}]},"Clauses":[{"Content":"劝尔勤耕田，"},{"Content":"盈尔仓中粟。"},{"Content":"劝尔无伐桑，"},{"Content":"减尔身上服。"},{"Content":"清霜一委地，"},{"Content":"万草色不绿。"},{"Content":"狂风一飘林，"},{"Content":"万叶不著木。"},{"Content":"青春如不耕，"},{"Content":"何以自拘束。"}]},{"Id":43917,"Allusions":[{"AllusionIndex":246,"AllusionKey":"三刖","SentenceIndex":-1},{"AllusionIndex":2123,"AllusionKey":"戴盆","SentenceIndex":5},{"AllusionIndex":4993,"AllusionKey":"填海","SentenceIndex":8}],"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"20","Rank":0,"Title":{"Content":"客有追叹后时者作诗勉之"},"Clauses":[{"Content":"后达多晚荣，"},{"Content":"速得多疾倾。"},{"Content":"君看构大厦，"},{"Content":"何曾一日成。"},{"Content":"在暖须在桑，"},{"Content":"在饱须在耕。"},{"Content":"君子贵弘道，"},{"Content":"道弘无不亨。"},{"Content":"太阳垂好光，"},{"Content":"毛发悉见形。"},{"Content":"我亦二十年，"},{"Content":"直似戴盆行。","Comments":[{"Content":"戴盆","Type":"AllusionKey","Index":4}]},{"Content":"荆山产美玉，"},{"Content":"石石皆坚贞。"},{"Content":"未必尽有玉，"},{"Content":"玉且间石生。"},{"Content":"精卫一微物，"},{"Content":"犹恐填海平。","Comments":[{"Content":"填海","Type":"AllusionKey","Index":4}]}]},{"Id":43905,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"20","Rank":0,"Title":{"Content":"早发邺北经古城"},"Clauses":[{"Content":"微月东南明，"},{"Content":"双牛耕古城。"},{"Content":"但耕古城地，"},{"Content":"不知古城名。"},{"Content":"当昔置此城，"},{"Content":"岂料今日耕。","Comments":[{"Content":"一作人","Type":"Text","Index":4}]},{"Content":"蔓草已离披，"},{"Content":"狐兔何纵横。"},{"Content":"秋云零落散，"},{"Content":"秋风萧条生。","Comments":[{"Content":"一作风雨","Type":"Text","Index":2}]},{"Content":"对古良可叹，"},{"Content":"念今转伤情。"},{"Content":"古人已冥冥，"},{"Content":"今人又营营。"},{"Content":"不知马蹄下，"},{"Content":"谁家旧台亭。"}]},{"Id":43925,"Allusions":[{"AllusionIndex":733,"AllusionKey":"武陵","SentenceIndex":8},{"AllusionIndex":7000,"AllusionKey":"彭泽横琴","SentenceIndex":6},{"AllusionIndex":8951,"AllusionKey":"五君咏","SentenceIndex":3}],"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"0","Rank":0,"Title":{"Content":"题贾氏林泉"},"Clauses":[{"Content":"市朝束名利，"},{"Content":"林泉系清通。"},{"Content":"岂知黄尘内，"},{"Content":"迥有白云踪。"},{"Content":"轻流逗密蓧，"},{"Content":"直干入宽空。","Comments":[{"Content":"一作高","Type":"Text","Index":4}]},{"Content":"高吟五君咏，","Comments":[{"Content":"五君咏","Type":"AllusionKey","Index":5}]},{"Content":"疑对九华峰。"},{"Content":"我知种竹心，"},{"Content":"欲扇清凉风。"},{"Content":"我知决泉意，"},{"Content":"将明济物功。","Comments":[{"Content":"一作欲","Type":"Text","Index":1}]},{"Content":"有琴不张弦，"},{"Content":"众星列梧桐。","Comments":[{"Content":"一作落","Type":"Text","Index":3}]},{"Content":"须知澹泊听，"},{"Content":"声在无声中。"},{"Content":"地非樵者路，"},{"Content":"武陵又何逢。","Comments":[{"Content":"武陵","Type":"AllusionKey","Index":2}]},{"Content":"祗虑迷所归，"},{"Content":"池上日西东。"}]},{"Id":43919,"Allusions":[{"AllusionIndex":10373,"AllusionKey":"云门","SentenceIndex":3}],"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"觉","Rank":0,"Title":{"Content":"秋夕","Comments":[{"Content":"（一作君子勿郁郁士有谤毁者作诗以赠之 二）。（一作孟郊诗）","Type":"Text","Index":2}]},"Clauses":[{"Content":"日往无复见，"},{"Content":"秋堂暮乃学。"},{"Content":"玄发不知白，"},{"Content":"晓入寒铜觉。"},{"Content":"为才未离群，","Comments":[{"Content":"一作辞树","Type":"Text","Index":5}]},{"Content":"有玉犹在璞。"},{"Content":"谁把碧桐枝，"},{"Content":"刻作云门乐。","Comments":[{"Content":"云门","Type":"AllusionKey","Index":4}]}]},{"Id":43921,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"8","Rank":0,"Title":{"Content":"哭刘驾博士"},"Clauses":[{"Content":"出门四顾望，"},{"Content":"此日何徘徊。"},{"Content":"终南旧山色，"},{"Content":"夫子安在哉。"},{"Content":"君诗如门户，"},{"Content":"夕闭昼还开。"},{"Content":"君名如四时，"},{"Content":"春尽夏复来。"},{"Content":"原野多丘陵，"},{"Content":"累累如高台。"},{"Content":"君坟须数尺，"},{"Content":"谁与夫子偕。"}]},{"Id":43903,"GroupIndex":1,"Dynasty":"晚唐","Author":"聂夷中","AuthorId":19238,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"阳","Rank":0,"Title":{"Content":"田家二首"},"Clauses":[{"Content":"父耕原上田，"},{"Content":"子斸山下荒。","Comments":[{"Content":"一作锄","Type":"Text","Index":2}]},{"Content":"六月禾未秀，"},{"Content":"官家已修仓。"}],"Comments":[{"Book":"《唐诗镜》","Content":"聂夷中诗第可作诗中之话，若竟作诗，未见有佳处，以意尽而无馀韵也。","IsComment":false,"FullPath":"《唐诗镜》"},{"Book":"《唐诗选脉会通评林》","Content":"周敬曰：坦之贫苦，精于古诗，此言近意远，有合《三百篇》之旨。非熟谙世故，深鉴民情，安得痛心入骨之语！真一声一泪，一字一金。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗别裁》","Content":"唐时尚有采诗之役，故诗家每陈下民苦情，如柳州《捕蛇者说》亦其一也。此诗言简意足，可匹柳文。","IsComment":false,"FullPath":"《唐诗别裁》"},{"Book":"《唐诗归折衷》","Content":"吴逸一云：由仁爱中写出，精透可怜，安得与风月语同看！","IsComment":false,"FullPath":"《唐诗归折衷》"},{"Book":"《唐人绝句精华》","Content":"此诗刺剥削者不知人民劳苦，但知夺取人民辛勤之果实也。夷中又有五古《咏田家》一首……尤为沉痛。","IsComment":false,"FullPath":"《唐人绝句精华》"},{"Content":"中晚唐为数众多的悯农诗中，短小精悍之作首推李绅《 悯农二首 》，下来就要算聂夷中《田家》了。乍看去，此诗的内容之平淡、语言之明白、字句之简单，几乎没什么奥妙可言，但它能以最少的文字取得了很大的效果，显得十分耐读，这又决不是偶然的。封建时代农民遭受剥削的主要的形式便是地租 。在唐末那样的乱世 ，封建国家开支甚巨而资用缺乏，必然加重对农民的榨取。此诗的写作目的就在于揭露这样的黑暗现实。如果正面从收租情事落笔，所费笔墨必多而实际效果未必就好。此诗的写作特点之一就在于抛开这种正面的描写 ，而只选取收租的题前之景，即农夫辛勤耕作而官家等待收租情况 ，“官家已仓”句点到为止 ，修仓干什么，农夫的命运将怎样，一应留待读者去想。作者省却许多气力，却“不著一字，尽得风流。”<br/>论者往往知道诗歌语言的具体形象之美，不知道亦有概括抽象之妙 。“春种一粒粟，秋收万颗子”的诗句 ，就好在用泛写的方式 ，概括了一般丰年的情事，并不以具体形象见长。此诗前二句也一样 ，“父耕原上田，子斸山下荒 ”，并不仅仅是只写一家父子的事件，而是高度概括了千千万万个农民的家庭，所谓“夜半呼儿趁晓耕，羸牛无力渐艰行 ”，正是农家普遍的情事；而“原上田”、“山下荒”也并不特指某山某原，而泛指已耕的熟田和待垦的荒地，从耕田写到开荒，简洁有力地刻划出农家一年到头的辛苦，几乎没有空闲可言 。十个字具有高度的涵盖力 ，增加了诗意的典型性。几乎成为封建社会农村生活的一个缩影。<br/>在揭露讽刺的时候 ，诗人不发议论而重在摆事实 ，发人深省。“六月禾未秀”一句不单指庄稼未成熟 。按正常的情况 ，四五月麦苗就该扬花（“秀”），“六月”应已收割而“ 禾未秀 ”，当是遇到了旱情，暗示着欠收。而按唐时两税法，六月正是应该交纳夏税的时节 ，所以“官家已修仓。”官家修仓，本身就暗示着对农民劳动成果的窥伺和即将予以剥夺，而这种窥伺出现在“六月禾未秀”之际 ，更觉意味深长。“禾未秀”而仓“已修”，一“未”一“已”，二字呼应。农家望成的焦灼如焚，官家收租的追不及待，及统治者的不恤民情，种种事实，俱在其中，作者的忧民悯农之心亦跃然纸上。<br/>题前摄景，洗炼概括，融情入事，其中任何一种手法都可以收到言简意长的效果。而此诗恰当地同时运用这三种手法，艺术效果也就更加显著了。","IsComment":false}]}],"Count":30,"PageNo":0,"PageSize":20}