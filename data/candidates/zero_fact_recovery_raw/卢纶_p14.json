mments":[{"Content":"五云车","Type":"AllusionKey","Index":5}]},{"Content":"访世山空在，","Comments":[{"Content":"一作傲","Type":"Text","Index":1}]},{"Content":"观棋日未斜。","Comments":[{"Content":"观棋","Type":"AllusionKey","Index":2}]},{"Content":"不知尘俗士，"},{"Content":"谁解种胡麻。"}]},{"Id":11382,"Allusions":[{"AllusionIndex":196,"AllusionKey":"雪满琴","SentenceIndex":4}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"题金吾郭将军石伏茅堂","Comments":[{"Content":"一作常衮诗","Type":"Text","Index":10}]},"Clauses":[{"Content":"云戟曙沈沈，"},{"Content":"轩墀清且深。"},{"Content":"家传成栋美，"},{"Content":"尧宠结茅心。"},{"Content":"玉佩多依石，"},{"Content":"油幢亦在林。"},{"Content":"炉香诸洞暖，"},{"Content":"殿影众山阴。"},{"Content":"草奏风生笔，"},{"Content":"筵开雪满琴。","Comments":[{"Content":"雪满琴","Type":"AllusionKey","Index":5}]},{"Content":"客从龙阙至，"},{"Content":"僧自虎溪寻。"},{"Content":"萧洒延清赏，"},{"Content":"风流会素襟。"},{"Content":"终朝息尘步，"},{"Content":"一醉间华簪。"}]},{"Id":11395,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"20","Rank":0,"Title":{"Content":"奉陪侍中春日过武安君庙"},"Clauses":[{"Content":"长裾间貔虎，"},{"Content":"遗庙盛攀登。"},{"Content":"白羽三千骑，"},{"Content":"红林一万层。"},{"Content":"元臣达幽契，"},{"Content":"祝史告明徵。"},{"Content":"抚坐悲今古，"},{"Content":"瞻容感废兴。"},{"Content":"回风卷丛柏，"},{"Content":"骤雨湿诸陵。"},{"Content":"倏忽烟花霁，"},{"Content":"当营看月生。"}]},{"Id":11349,"Allusions":[{"AllusionIndex":5378,"AllusionKey":"桂树","SentenceIndex":6},{"AllusionIndex":5828,"AllusionKey":"柳吴兴","SentenceIndex":7}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"蒸","Rank":0,"FirstClauseRhyme":"蒸","Title":{"Content":"早春游樊川野居却寄李端校书兼呈崔峒补阙司空曙主簿耿湋拾遗"},"Clauses":[{"Content":"白水遍沟塍，"},{"Content":"青山对杜陵。"},{"Content":"晴明人望鹤，"},{"Content":"旷野鹿随僧。"},{"Content":"古柳连巢折，"},{"Content":"荒堤带草崩。"},{"Content":"阴桥全覆雪，"},{"Content":"瀑溜半垂冰。","Comments":[{"Content":"一作深","Type":"Text","Index":1}]},{"Content":"斗鼠摇松影，"},{"Content":"游龟落石层。"},{"Content":"韶光偏不待，"},{"Content":"衰败巧相仍。"},{"Content":"桂树曾争折，","Comments":[{"Content":"桂树","Type":"AllusionKey","Index":2}]},{"Content":"龙门几共登。"},{"Content":"琴师阮校尉，"},{"Content":"诗和柳吴兴。","Comments":[{"Content":"柳吴兴","Type":"AllusionKey","Index":5}]},{"Content":"舐笔求书扇，"},{"Content":"张屏看画蝇。"},{"Content":"卜邻空遂约，"},{"Content":"问卦独无徵。"},{"Content":"投足经危路，"},{"Content":"收才遇直绳。"},{"Content":"守农穷自固，"},{"Content":"行乐病何能。"},{"Content":"掩帙蓬蒿晚，"},{"Content":"临川景气澄。"},{"Content":"飒然成一叟，"},{"Content":"谁更慕鶱腾。"}]},{"Id":11370,"Allusions":[{"AllusionIndex":255,"AllusionKey":"俗书博白鹅","SentenceIndex":4},{"AllusionIndex":2039,"AllusionKey":"大被","SentenceIndex":5},{"AllusionIndex":2230,"AllusionKey":"吟絮","SentenceIndex":4}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"宴赵氏昆季书院因与会文并率尔投赠"},"Clauses":[{"Content":"诗礼挹馀波，"},{"Content":"相欢在琢磨。"},{"Content":"琴尊方会集，"},{"Content":"珠玉忽骈罗。"},{"Content":"谢族风流盛，"},{"Content":"于门福庆多。"},{"Content":"花攒骐骥枥，"},{"Content":"锦绚凤凰窠。"},{"Content":"咏雪因饶妹，"},{"Content":"书经为爱鹅。"},{"Content":"仍闻广练被，"},{"Content":"更有远儒过。"}]},{"Id":11362,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"奉和李益游栖岩寺","Comments":[{"Content":"一作登西岩寺，一作常衮诗。","Type":"Text","Index":8}]},"Clauses":[{"Content":"林香雨气新，"},{"Content":"山寺绿无尘。"},{"Content":"遂结云外赏，","Comments":[{"Content":"一作侣","Type":"Text","Index":5}]},{"Content":"共游天上春。"},{"Content":"鹤鸣金阙丽，","Comments":[{"Content":"一作阁","Type":"Text","Index":4}]},{"Content":"僧语竹房邻。","Comments":[{"Content":"一作话","Type":"Text","Index":2}]},{"Content":"待月水流急，"},{"Content":"惜花风起频。"},{"Content":"何方非坏境，"},{"Content":"此地有归人。"},{"Content":"回首空门路，"},{"Content":"皤然一幻身。","Comments":[{"Content":"一作皓","Type":"Text","Index":1}]}]},{"Id":11361,"Allusions":[{"AllusionIndex":7117,"AllusionKey":"琼玖","SentenceIndex":7},{"AllusionIndex":9324,"AllusionKey":"谢宅","SentenceIndex":1}],"Dynasty":"中唐","Au