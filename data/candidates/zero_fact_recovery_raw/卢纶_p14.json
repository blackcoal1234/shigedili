:"东","Title":{"Content":"宝泉寺送李益端公归邠宁幕"},"Clauses":[{"Content":"参差岩障东，"},{"Content":"云日晃龙宫。"},{"Content":"石净非因雨，"},{"Content":"松凉不为风。"},{"Content":"恋泉将鹤并，"},{"Content":"偷果与猿同。"},{"Content":"眼界尘虽染，"},{"Content":"心源蔽已通。","Comments":[{"Content":"一作路","Type":"Text","Index":3}]},{"Content":"莲花国何限，"},{"Content":"贝叶字无穷。"},{"Content":"早晚登麟阁，","Comments":[{"Content":"麟阁","Type":"AllusionKey","Index":5}]},{"Content":"慈门欲付公。"}]},{"Id":11368,"Allusions":[{"AllusionIndex":7648,"AllusionKey":"射虎","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"先","Rank":0,"Title":{"Content":"送彭开府往云中觐使君兄"},"Clauses":[{"Content":"一门三代贵，"},{"Content":"非是主恩偏。"},{"Content":"破虏山铭在，"},{"Content":"承家剑艺全。"},{"Content":"夺旗貂帐侧，"},{"Content":"射虎雪林前。","Comments":[{"Content":"射虎","Type":"AllusionKey","Index":2}]},{"Content":"雁塞逢兄弟，"},{"Content":"云州发管弦。"},{"Content":"冻河光带日，"},{"Content":"枯草净无烟。"},{"Content":"儒者曾修武，","Comments":[{"Content":"一作亲","Type":"Text","Index":4}]},{"Content":"因贻上将篇。"}]},{"Id":11369,"Classes":["軍旅 出鎮","軍旅 送行"],"Allusions":[{"AllusionIndex":621,"AllusionKey":"北门忧","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"送鲍中丞赴太原"},"Clauses":[{"Content":"分路引鸣驺，"},{"Content":"喧喧似陇头。"},{"Content":"暂移西掖望，"},{"Content":"全解北门忧。","Comments":[{"Content":"北门忧","Type":"AllusionKey","Index":5}]},{"Content":"专幕临都护，"},{"Content":"分曹制督邮。","Comments":[{"Content":"一作亲","Type":"Text","Index":1}]},{"Content":"积冰营不下，"},{"Content":"盛雪猎方休。"},{"Content":"白草连胡帐，"},{"Content":"黄云拥戍楼。"},{"Content":"今朝送旌旆，"},{"Content":"一减鲁儒羞。"}]},{"Id":11373,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"元","Rank":0,"Title":{"Content":"晚到盩厔耆老家"},"Clauses":[{"Content":"老翁曾旧识，"},{"Content":"相引出柴门。"},{"Content":"苦话别时事，"},{"Content":"因寻溪上村。"},{"Content":"数年何处客，"},{"Content":"近日几家存。"},{"Content":"冒雨看禾黍，"},{"Content":"逢人忆子孙。"},{"Content":"乱藤穿井口，"},{"Content":"流水到篱根。"},{"Content":"惆怅不堪住，"},{"Content":"空山月又昏。"}],"Comments":[{"Book":"《唐诗分类绳尺》","Content":"叙事道情，甚不费力。","IsComment":false,"FullPath":"《唐诗分类绳尺》"},{"Book":"《唐诗归》","Content":"钟云：（起数语）只似一句。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗选脉会通评林》","Content":"周珽曰：允言诗识见卓而渊，气脉沉而粹。此与《酬李叔度》篇俱妙在一气呵成。唐汝询曰：寄慨浑雄，未落浅调。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"}]}],"Count":337,"PageNo":14,"PageSize":20}