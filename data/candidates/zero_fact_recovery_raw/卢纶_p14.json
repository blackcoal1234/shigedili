{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11364,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"鱼","Rank":0,"Title":{"Content":"郊居对雨寄赵涓给事包佶郎中"},"Clauses":[{"Content":"暑雨青山里，"},{"Content":"随风到野居。"},{"Content":"乱沤浮曲砌，"},{"Content":"悬溜响前除。","Comments":[{"Content":"一作滴","Type":"Text","Index":3}]},{"Content":"尘镜愁多掩，"},{"Content":"蓬头懒更梳。"},{"Content":"夜窗凄枕席，"},{"Content":"阴壁润图书。"},{"Content":"萧飒宜新竹，","Comments":[{"Content":"一作移","Type":"Text","Index":3}]},{"Content":"龙钟拾野蔬。"},{"Content":"石泉空自咽，"},{"Content":"药圃不堪锄。"},{"Content":"浊水淙深辙，"},{"Content":"荒兰拥败渠。"},{"Content":"繁枝留宿鸟，"},{"Content":"碎浪出寒鱼。","Comments":[{"Content":"一作隐游，一作隐行","Type":"Text","Index":4}]},{"Content":"桑屐时登望，","Comments":[{"Content":"一作履","Type":"Text","Index":2}]},{"Content":"荷衣自卷舒。"},{"Content":"应怜在泥滓，"},{"Content":"无路托高车。"}]},{"Id":11375,"Classes":["軍旅 將帥"],"Allusions":[{"AllusionIndex":1061,"AllusionKey":"梦笔","SentenceIndex":5},{"AllusionIndex":10552,"AllusionKey":"赵张","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"雪谤后书事上皇甫大夫"},"Clauses":[{"Content":"盛德总群英，"},{"Content":"高标仰国桢。"},{"Content":"独安巡狩日，"},{"Content":"曾掩赵张名。","Comments":[{"Content":"赵张","Type":"AllusionKey","Index":4}]},{"Content":"业就难辞宠，"},{"Content":"朝回更授兵。"},{"Content":"晓川分牧马，"},{"Content":"夜雪覆连营。"},{"Content":"长策威殊俗，"},{"Content":"嘉谋翊圣明。"},{"Content":"画图规阵势，"},{"Content":"梦笔纪山行。","Comments":[{"Content":"梦笔","Type":"AllusionKey","Index":2}]},{"Content":"绶拂池中影，"},{"Content":"珂摇竹外声。"},{"Content":"赐欢徵妓乐，"},{"Content":"陪醉问公卿。","Comments":[{"Content":"一作见","Type":"Text","Index":3}]},{"Content":"却忆经前事，"},{"Content":"翻疑得此生。"},{"Content":"分深存没感，"},{"Content":"恩在子孙荣。"},{"Content":"览镜愁将老，"},{"Content":"扪心喜复惊。"},{"Content":"岂言沈族重，"},{"Content":"但觉杀身轻。"},{"Content":"有泪沾坟典，"},{"Content":"无家集弟兄。"},{"Content":"东西遭世难，"},{"Content":"流浪识交情。"},{"Content":"阅古宗文举，"},{"Content":"推才慕正平。"},{"Content":"应怜守贫贱，"},{"Content":"又欲事躬耕。"}]},{"Id":11353,"Allusions":[{"AllusionIndex":86,"AllusionKey":"二毛","SentenceIndex":2},{"AllusionIndex":1221,"AllusionKey":"腐叶","SentenceIndex":12},{"AllusionIndex":4589,"AllusionKey":"倚玉","SentenceIndex":10},{"AllusionIndex":5815,"AllusionKey":"刘桢病","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"尤","Rank":0,"Title":{"Content":"卧病寓居龙兴观枉冯十七著作书知罢摄洛阳赴缑氏因题十四韵寄冯生并赠乔尊师","Comments":[{"Content":"时予罢推官","Type":"Text","Index":35}]},"Clauses":[{"Content":"乞假依山宅，"},{"Content":"蹉跎属岁周。"},{"Content":"弱荑轻采拾，"},{"Content":"钝质称归休。"},{"Content":"潘岳衰将至，"},{"Content":"刘桢病未瘳。","Comments":[{"Content":"刘桢病","Type":"AllusionKey","Index":3}]},{"Content":"步迟乘羽客，"},{"Content":"起晏滞书邮。"},{"Content":"幸以编方验，"},{"Content":"终贻骨肉忧。"},{"Content":"灼龟炉气冷，"},{"Content":"曝药树阴稠。"},{"Content":"语命心堪醉，"},{"Content":"伤离梦亦愁。"},{"Content":"荤膻居已绝，"},{"Content":"鸾鹤见无由。"},{"Content":"世累如尘积，"},{"Content":"年光剧水流。"},{"Content":"蹑云知有路，"},{"Content":"济海岂无舟。"},{"Content":"倚玉翻成难，","Comments":[{"Content":"倚玉","Type":"AllusionKey","Index":2}]},{"Content":"投砖敢望詶。"},{"Content":"卑栖君就禄，"},{"Content":"羸惫我逢秋。"},{"Content":"腐叶填荒辙，","Comments":[{"Content":"腐叶","Type":"AllusionKey","Index":2}]},{"Content":"阴萤出古沟。"},{"Content":"依然在遐想，"},{"Content":"愿子励风猷。"}]},{"Id":11344,"Allusions":[{"AllusionIndex":1531,"AllusionKey":"将军桃李","SentenceIndex":4},{"AllusionIndex":10625,"AllusionKey":"芝兰室","SentenceIndex":4}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"书情上大尹十兄"},"Clauses":[{"Content":"紫陌绝纤埃，"},{"Content":"油幢千骑来。"},{"Content":"剖辞纷若雨，"},{"Content":"奔吏殷成雷。"},{"Content":"圣泽初忧壅，"},{"Content":"群心本在台。"},{"Content":"海鳞方泼剌，"},{"Content":"云翼暂徘徊。"},{"Content":"芳室芝兰茂，"},{"Content":"春蹊桃李开。"},{"Content":"江湖馀派少，"},{"Content":"鸿雁远声哀。"},{"Content":"命厌蓍龟诱，"},{"Content":"年惊弟侄催。"},{"Content":"磨铅惭砥砺，"},{"Content":"挥策愧驽骀。"},{"Content"