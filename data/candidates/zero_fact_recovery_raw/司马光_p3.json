{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80753,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"之美举进士寓京师此诗寄之"},"Clauses":[{"Content":"结发声华盛，"},{"Content":"无疑屈未伸。"},{"Content":"何妨久垂翅，"},{"Content":"从此欲惊人。"},{"Content":"鹰击天风壮，"},{"Content":"鹏飞海浪春。"},{"Content":"行当解故褐，"},{"Content":"不惜化京尘。"}]},{"Id":80782,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"风雪数日不见叔度晚约公明共诣之"},"Clauses":[{"Content":"云雪连朝闇，"},{"Content":"朋从叹坐违。"},{"Content":"临文与谁共，"},{"Content":"开卷为君稀。"},{"Content":"趣扫六花散，"},{"Content":"聊通一径微。"},{"Content":"当携兔园赋，"},{"Content":"同映读书帏。"}]},{"Id":81347,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"风雪数日不见叔度晚约公明共诣之"},"Clauses":[{"Content":"南荣卮酒罢，"},{"Content":"君返道东居。"},{"Content":"坐作三朝别，"},{"Content":"杳疑千里馀。"},{"Content":"闲门嗟雀网，"},{"Content":"深泞怯柴车。"},{"Content":"向晚开帘喜，"},{"Content":"彤云稍觉疏。"}]},{"Id":80765,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"五哀诗 屈平"},"Clauses":[{"Content":"白玉徒为洁，"},{"Content":"幽兰未谓芳。"},{"Content":"穷羞事令尹，"},{"Content":"疏不忘怀王。"},{"Content":"冤骨消寒渚，"},{"Content":"忠魂失旧乡。"},{"Content":"空馀楚辞在，"},{"Content":"犹与日争光。"}]},{"Id":80764,"Classes":["軍旅 將帥"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"五哀诗 李牧"},"Clauses":[{"Content":"椎牛飨壮士，"},{"Content":"拔距养奇材。"},{"Content":"虏帐方惊避，"},{"Content":"秦金已闇来。"},{"Content":"旌旗移幕府，"},{"Content":"荆棘蔓丛台。"},{"Content":"部曲依稀在，"},{"Content":"犹能话郭开。"}]},{"Id":80766,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"五哀诗 晁大夫"},"Clauses":[{"Content":"人主恩犹盛，"},{"Content":"谗夫弄舌端。"},{"Content":"旋闻就斧质，"},{"Content":"不得解衣冠。"},{"Content":"反贼齿才冷，"},{"Content":"谋臣心尽寒。"},{"Content":"晁宗噍类尽，"},{"Content":"汉室泰山安。"}]},{"Id":80763,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"五哀诗 马伏波"},"Clauses":[{"Content":"汉令班南海，"},{"Content":"蛮兵避郁林。"},{"Content":"天涯柱分界，"},{"Content":"徼外贡输金。"},{"Content":"坐失奸臣意，"},{"Content":"谁明报国心。"},{"Content":"一棺忠勇骨，"},{"Content":"漂泊瘴烟深。"}]},{"Id":81175,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"五哀诗 斛律丞相"},"Clauses":[{"Content":"君臣日荒宴，"},{"Content":"歌舞讳言愁。"},{"Content":"老相犹当国，"},{"Content":"强邻不敢谋。"},{"Content":"谣言虽未出，"},{"Content":"奸谤已先流。"},{"Content":"谁察忠臣意，"},{"Content":"通宵抱膝忧。"}]},{"Id":81127,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"哭马承之"},"Clauses":[{"Content":"平生千里别，"},{"Content":"书问亦常来。"},{"Content":"隼拂秋云击，"},{"Content":"鸾兼霏雾回。"},{"Content":"向无高世艺，"},{"Content":"安见出伦才。"},{"Content":"有纸盈箱箧，"},{"Content":"扃封不忍开。"}]},{"Id":80781,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"冬","Rank":0,"Title":{"Content":"风"},"Clauses":[{"Content":"陇首红旌急，"},{"Content":"樽前翠幕重。"},{"Content":"林端翻远刹，"},{"Content":"花外转疏钟。","Comments":[{"Content":"原作在，据陈本、四库本改","Type":"Text","Index":1}]},{"Content":"夜寂清机发，"},{"Content":"春阑别意浓。"},{"Content":"如何玉琴韵，"},{"Content":"并欲在青松。"}]},{"Id":81043,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"送王殿丞知眉山县","Comments":[{"Content":"景阳","Type":"Text","Index":4},{"Content":"先公与秘阁府君相继为利州路转运使，予与眉山同年登第","Type":"Text","Index":8}]},"Clauses":[{"Content":"畴昔侍严亲，"},{"Content":"俱为䌽服人。"},{"Content":"游兰已多益，"},{"Content":"得桂复同春。"},{"Content":"风树悲欢异，"},{"Content":"萍波聚散频。"},{"Content":"峡中尽遗事，"},{"Content":"何处不沾巾。"}]},{"Id":81551,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"4","Rank":0,"Title":{"Content":"送王殿丞知眉山县","Comments":[{"Content":"景阳","Type":"Text","Index":4},{"Content":"先公与秘阁府君相继为利州路转运使，予与眉山同年登第","Type":"Text","Index":8}]},"Clauses":[{"Content":"君行杳何许，"},{"Content":"万里蜀云西。"},{"Content":"野色春期近，"},{"Content":"林烟晓意迷。"},{"Content":"天藏巴峡小，"},{"Content":"星逼剑关低。"},{"Content":"莫使乡愁乱，"},{"Content":"咬咬信子规。"}]},{"Id":81191,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"佳","Rank":0,"Title":{"Content":"黄甘"},"Clauses":[{"Content":"黄金缀缥蒂，"},{"Content":"摇落楚江涯。"},{"Content":"采助杯盘胜，"},{"Content":"羞将橘柚偕。"},{"Content":"时移香不变，"},{"Content":"物远味尤佳。"},{"Content":"欲种沧洲树，"},{"Content":"何年此意谐。"}]},{"Id":81200,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"寒食南宫夜饮"},"Clauses":[{"Content":"积旬留省署，"},{"Content":"容易度春华。"},{"Content":"芳草踏青晚，"},{"Content":"长楸行乐赊。"},{"Content":"云疏时送雨，"},{"Content":"风细暗飞花。"},{"Content":"直有黄金百，"},{"Content":"无因过酒家。"}]},{"Id":81045,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"Title":{"Content":"送冯状元归鄂州","Comments":[{"Content":"京","Type":"Text","Index":4}]},"Clauses":[{"Content":"夙昔负奇节，"},{"Content":"琅然为众殊。"},{"Content":"下鞲连得俊，"},{"Content":"出手尽成卢。"},{"Content":"喜气兼邻曲，"},{"Content":"荣名溢道涂。"},{"Content":"风云俱动色，"},{"Content":"非复旧江湖。"}]},{"Id":81118,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"京送僧聪归蜀"},"Clauses":[{"Content":"翠柏老精舍，"},{"Content":"红尘倦帝城。"},{"Content":"千山一锡远，"},{"Content":"万里片云轻。"},{"Content":"江栈纡还直，"},{"Content":"天星纵复横。"},{"Content":"听猿应更喜，"},{"Content":"还是故乡声。"}]},{"Id":81046,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"冬","Rank":0,"Title":{"Content":"送史馆任祠部河东转运使","Comments":[{"Content":"颛","Type":"Text","Index":6}]},"Clauses":[{"Content":"问望簪绅旧，"},{"Content":"恩华雨露重。"},{"Content":"图书周内史，"},{"Content":"汾浍晋全封。"},{"Content":"秀发千寻壁，"},{"Content":"寒生百鍊锋。"},{"Content":"归时门有戟，"},{"Content":"惜别更从容。"}]},{"Id":81008,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"故翰林彭学士挽歌","Comments":[{"Content":"乘","Type":"Text","Index":6}]},"Clauses":[{"Content":"夙昔游清贯，"},{"Content":"时流籍重名。"},{"Content":"雠书石渠秘，"},{"Content":"视草玉堂荣。"},{"Content":"吉兆虚三鳝，"},{"Content":"凶期告两楹。"},{"Content":"子云思故国，"},{"Content":"坟树必西倾。"}]},{"Id":81522,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"故翰林彭学士挽歌","Comments":[{"Content":"乘","Type":"Text","Index":6}]},"Clauses":[{"Content":"平生对交旧，"},{"Content":"万日正如初。"},{"Content":"不复知荣贱，"},{"Content":"都能忘戚疏。"},{"Content":"遗灵瞻素几，"},{"Content":"伪物屏涂车。"},{"Content":"家事何萧索，"},{"Content":"空馀万卷书。"}]},{"Id":81007,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"故翰林彭学士挽歌","Comments":[{"Content":"乘","Type":"Text","Index":6}]},"Clauses":[{"Content":"祖奠垂将撤，"},{"Content":"笳箫俨欲行。"},{"Content":"野寒嘶故马，"},{"Content":"树转出新旌。"},{"Content":"泉路幽无底，"},{"Content":"鱼灯暧不明。"},{"Content":"如何赍美志，"},{"Content":"郁郁向佳城。"}]}],"Count":1270,"PageNo":3,"PageSize":20}