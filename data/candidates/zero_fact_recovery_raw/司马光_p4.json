{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":81208,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"景福东厢诗 夜意"},"Clauses":[{"Content":"清夜四无哗，"},{"Content":"深严上帝家。"},{"Content":"星翻珠网白，"},{"Content":"斗挂玉楼斜。"},{"Content":"风静虚成韵，"},{"Content":"霜轻未作花。"},{"Content":"还疑汉津客，"},{"Content":"浩荡寄流槎。"}]},{"Id":81615,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"Title":{"Content":"景福东厢诗 即日","Comments":[{"Content":"依韵","Type":"Text","Index":8}]},"Clauses":[{"Content":"枍栺留深殿，"},{"Content":"仓琅秘九门。"},{"Content":"日长人对直，"},{"Content":"风迥燕高翻。"},{"Content":"林有萧疏意，"},{"Content":"云无片缕痕。"},{"Content":"钧天真自到，"},{"Content":"不独暂飞魂。"}]},{"Id":81617,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"景福东厢诗 柏","Comments":[{"Content":"寒","Type":"Text","Index":7}]},"Clauses":[{"Content":"落落抱高节，"},{"Content":"秀出青云端。"},{"Content":"无言涧谷幽，"},{"Content":"自致宫庭难。"},{"Content":"芳风袭玉宇，"},{"Content":"馀露分铜槃。"},{"Content":"不使万年木，"},{"Content":"嘉名高岁寒。"}]},{"Id":81211,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"御沟","Comments":[{"Content":"秋","Type":"Text","Index":2}]},"Clauses":[{"Content":"万户郁相钩，"},{"Content":"枝分瑟瑟流。"},{"Content":"萦纡通桂观，"},{"Content":"隐见带龙楼。"},{"Content":"碧映千林曙，"},{"Content":"红飘一叶秋。"},{"Content":"寒波长不竭，"},{"Content":"岁岁奉宸游。"}]},{"Id":81212,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"御沟 赐酒","Comments":[{"Content":"秋","Type":"Text","Index":2},{"Content":"霜","Type":"Text","Index":5}]},"Clauses":[{"Content":"和气盈金榼，"},{"Content":"恩光湛玉觞。"},{"Content":"应知北山羽，"},{"Content":"犹怯上林霜。"},{"Content":"醇味回秋色，"},{"Content":"清都近醉乡。"},{"Content":"山茅沾雨露，"},{"Content":"誓极寸心长。"}]},{"Id":81210,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"御沟 菊","Comments":[{"Content":"秋","Type":"Text","Index":2}]},"Clauses":[{"Content":"琐琐南阳菊，"},{"Content":"秋潭岁自开。"},{"Content":"孤根拥红叶，"},{"Content":"落蕊媚苍苔。"},{"Content":"正以参灵药，"},{"Content":"因之植紫台。"},{"Content":"愿兼金掌露，"},{"Content":"同入柏梁杯。"}]},{"Id":81209,"Classes":["軍旅 謀略"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"御沟 读武士策","Comments":[{"Content":"秋","Type":"Text","Index":2},{"Content":"风","Type":"Text","Index":7}]},"Clauses":[{"Content":"汉家求猛士，"},{"Content":"云集未央宫。"},{"Content":"天外朝星淡，","Comments":[{"Content":"四库本作胡","Type":"Text","Index":3}]},{"Content":"山西将种空。"},{"Content":"奇谋纷并进，"},{"Content":"壮节凛生风。"},{"Content":"八阵纵横势，"},{"Content":"依然见目中。"}]},{"Id":81074,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"送张寺丞知富顺监","Comments":[{"Content":"觐","Type":"Text","Index":4}]},"Clauses":[{"Content":"汉家五尺道，"},{"Content":"置吏抚南夷。"},{"Content":"欲使文翁教，"},{"Content":"兼令孟获知。"},{"Content":"盘羞蒟酱实，"},{"Content":"歌杂竹枝辞。"},{"Content":"取酒须勤醉，"},{"Content":"乡关不可思。"}]},{"Id":81253,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"赠太子太傅康靖李公挽歌词二首"},"Clauses":[{"Content":"黄发今彫丧，"},{"Content":"苍生欲奈何。"},{"Content":"散金才极乐，"},{"Content":"曳杖已成歌。"},{"Content":"十郡馀恩在，"},{"Content":"三台故吏多。"},{"Content":"位崇仍有后，"},{"Content":"五福更为多。"}]},{"Id":81252,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"赠太子太傅康靖李公挽歌词二首"},"Clauses":[{"Content":"卤簿去悠悠，"},{"Content":"西郊乱叶秋。"},{"Content":"旐翻寒日薄，"},{"Content":"笳咽断云愁。"},{"Content":"吊客门飞鹤，"},{"Content":"佳城山卧牛。"},{"Content":"灵车今不返，"},{"Content":"洧水日东流。","Comments":[{"Content":"自注：葬新郑。","Type":"Text","Index":5}]}]},{"Id":81031,"Classes":["軍旅 送行"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"送二同年使北 吕济叔"},"Clauses":[{"Content":"华缨下玉除，"},{"Content":"天子宠匈奴。"},{"Content":"虽复夷风陋，"},{"Content":"犹知汉使殊。"},{"Content":"夜烽沈不举，"},{"Content":"秋柝寂无虞。"},{"Content":"何必燕然刻，"},{"Content":"苍生肝脑涂。"}]},{"Id":81032,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"青","Rank":0,"FirstClauseRhyme":"青","Title":{"Content":"送二同年使北 李公素"},"Clauses":[{"Content":"云愁雪欲零，"},{"Content":"四牡出郊坰。"},{"Content":"古塞烟华紫，"},{"Content":"寒沙日气青。"},{"Content":"金门秘鸡树，"},{"Content":"朱节耀龙庭。"},{"Content":"几夜天街北，"},{"Content":"遥占汉使星。"}]},{"Id":81235,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"酬不疑雪中书怀见寄","Comments":[{"Content":"校理邵必","Type":"Text","Index":9}]},"Clauses":[{"Content":"直道免三黜，"},{"Content":"敢云羞小官。"},{"Content":"盘餐红粟涩，"},{"Content":"衣桁黑貂寒。"},{"Content":"画府容身易，"},{"Content":"侯门曲意难。"},{"Content":"荆扉盈尺雪，"},{"Content":"有客问袁安。"}]},{"Id":81039,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"送王校理守琅琊","Comments":[{"Content":"怿，字公和","Type":"Text","Index":4},{"Content":"沂公兄子，为公后","Type":"Text","Index":7}]},"Clauses":[{"Content":"金门倦鸣玉，"},{"Content":"千骑出东方。"},{"Content":"封略依沧海，"},{"Content":"枌榆近故乡。"},{"Content":"秦碑苔蚀字，"},{"Content":"鄅稻日翻芒。"},{"Content":"国吏遥应识，"},{"Content":"当年丞相郎。"}]},{"Id":81130,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"哭尚颍","Comments":[{"Content":"字公楚","Type":"Text","Index":3}]},"Clauses":[{"Content":"操业五常备，"},{"Content":"艰难六极全。"},{"Content":"仲尼难语命，"},{"Content":"裨灶不知天。"},{"Content":"弱女飘何许，"},{"Content":"遗文散莫传。"},{"Content":"官轻史不录，"},{"Content":"后世孰称贤。"}]},{"Id":81002,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"故侍读学士张公哀辞二首"},"Clauses":[{"Content":"喜愠与荣枯，"},{"Content":"居之悉晏如。"},{"Content":"稍门多执笔，"},{"Content":"至老不抛书。"},{"Content":"常愧无能极，"},{"Content":"曾沾清论馀。"},{"Content":"秋风郭门外，"},{"Content":"雨泣望丧车。"}]},{"Id":81001,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"故侍读学士张公哀辞二首"},"Clauses":[{"Content":"凶梦歌洹水，"},{"Content":"妖巢集戴鵀。"},{"Content":"未尝馀俸禄，"},{"Content":"无以具衣衾。"},{"Content":"袁涣分仓谷，"},{"Content":"翁归赐府金。"},{"Content":"佗年纯固传，"},{"Content":"宁使令名沈。","Comments":[{"Content":"自注：朝廷以公清贫，赠赙有加。","Type":"Text","Index":5}]}]},{"Id":81148,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"钱子高挽歌二首"},"Clauses":[{"Content":"炜烨传家学，"},{"Content":"连翩射策荣。"},{"Content":"走丸过省阁，"},{"Content":"破竹取公卿。"},{"Content":"埋玉嗟何早，"},{"Content":"为山惜未成。"},{"Content":"空令泽宫友，"},{"Content":"相顾泪纵横。","Comments":[{"Content":"自注：同年致祭者二十二人。","Type":"Text","Index":5}]}]},{"Id":81147,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"钱子高挽歌二首"},"Clauses":[{"Content":"象设如平昔，"},{"Content":"升堂不见君。"},{"Content":"尚疑言笑在，"},{"Content":"忽念死生分。"},{"Content":"清论千秋雪，"},{"Content":"浮荣一片云。"},{"Content":"泉台多少路，"},{"Content":"何处复修文。"}]},{"Id":81249,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"齐","Title":{"Content":"题杨中正供奉洗心堂","Comments":[{"Content":"原作王，据陈本改","Type":"Text","Index":4},{"Content":"崇勋之孙","Type":"Text","Index":9}]},"Clauses":[{"Content":"阀阅盛山西，"},{"Content":"朱门飏戟衣。"},{"Content":"雅知名教乐，"},{"Content":"深笑宴游非。"},{"Content":"一室琴书隘，"},{"Content":"三年园圃稀。"},{"Content":"异时论事业，"},{"Content":"肯复让轻肥。"}],"Note":"按：《永乐大典》卷七二四○作吕天策诗。"}],"Count":1270,"PageNo":4,"PageSize":20}