{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":536122,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"夏日游水阁"},"Clauses":[{"Content":"淡红衫子透肌肤，"},{"Content":"夏日初长水阁虚。"},{"Content":"独自凭阑无个事，"},{"Content":"水风凉处读文书。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》后集卷二，总题夏景","Type":"Text","Index":7}]}]},{"Id":536125,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"Title":{"Content":"秋日偶题"},"Clauses":[{"Content":"芙蓉斜倚胭脂脸，"},{"Content":"岩桂轻摇金粟花。"},{"Content":"愁思不知秋浩荡，"},{"Content":"一鞭逸兴绕天涯。"}]},{"Id":536127,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"微","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"七夕口占"},"Clauses":[{"Content":"三秋灵匹此宵期，"},{"Content":"万古传闻果是非。"},{"Content":"免俗未能还自笑，"},{"Content":"金针乞得巧丝归。"}]},{"Id":96279,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"新秋"},"Clauses":[{"Content":"一夜凉风动扇愁，"},{"Content":"背时容易入新秋。"},{"Content":"桃花脸上汪汪泪，"},{"Content":"忍到更深枕上流。"}]},{"Id":96222,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"初秋雨晴"},"Clauses":[{"Content":"雨后风凉暑气收，"},{"Content":"庭梧叶叶报初秋。"},{"Content":"浮云尽逐黄昏去，"},{"Content":"楼角新蟾挂玉钩。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[风凉] 《武林》本作[凉风]。[庭梧]《武林》本作[梧桐]。[楼角]《宋元百家诗》　《古今女史》作[楼馈]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":536128,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"Title":{"Content":"早秋有感"},"Clauses":[{"Content":"西风淅淅收残暑，"},{"Content":"庭竹萧疏报早秋。"},{"Content":"砌下黄昏微雨后，"},{"Content":"幽蛩唧唧使人愁。","Comments":[{"Content":"原作人，据武林本改","Type":"Text","Index":2}]}]},{"Id":96200,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"对秋有感"},"Clauses":[{"Content":"风倍凄凉月倍明，"},{"Content":"人间占得十分清。"},{"Content":"可怜宋玉多才子，"},{"Content":"只为多情苦怆情。"}]},{"Id":536130,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"秋夜舟行宿前江"},"Clauses":[{"Content":"扁舟夜泊月明秋，"},{"Content":"水面鱼游趁闸流。"},{"Content":"更作娇痴儿女态，"},{"Content":"笑将竿竹掷丝钩。"}]},{"Id":536132,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"中秋夜不见月"},"Clauses":[{"Content":"不许蟾蜍此夜明，"},{"Content":"始知天意是无情。"},{"Content":"何当拔去闲云雾，"},{"Content":"放出光辉万里清。"}]},{"Id":536133,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"中秋月"},"Clauses":[{"Content":"杳杳长空敛雾烟，"},{"Content":"冰输都胜别时圆。"},{"Content":"风传漏报天将晓，","Comments":[{"Content":"原作晚，据元刻本、武林本改","Type":"Text","Index":7}]},{"Content":"惆怅婵娟又隔年。"}]},{"Id":536139,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"秋深偶作"},"Clauses":[{"Content":"生杀循环本自然，"},{"Content":"可堪肃肃出乎天。"},{"Content":"休嗟物理易彫瘁，"},{"Content":"好看西成报有年。"}]},{"Id":536140,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"暮秋"},"Clauses":[{"Content":"潇潇风雨暗残秋，"},{"Content":"忍见黄生满径幽。"},{"Content":"恰似楚人情太苦，"},{"Content":"年年对景倍添愁。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》后集卷三，总题秋景","Type":"Text","Index":7}]}]},{"Id":536141,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"新冬"},"Clauses":[{"Content":"日一北而万物生，"},{"Content":"始知天意在收成。"},{"Content":"愚民未论祁寒理，"},{"Content":"往往相为嗟怨声。"}]},{"Id":536142,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"霜夜"},"Clauses":[{"Content":"彤云黯黯暮天寒，"},{"Content":"半卷珠帘未欲眠。"},{"Content":"独坐小窗无伴侣，"},{"Content":"可怜霜月向人圆。"}]},{"Id":536143,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"歌","Rank":0,"Title":{"Content":"探梅"},"Clauses":[{"Content":"温温天气似春和，"},{"Content":"试探寒梅已满坡。"},{"Content":"笑折一枝插云鬓，"},{"Content":"问人潇洒似谁么。"}]},{"Id":536144,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"观雪偶成"},"Clauses":[{"Content":"凭阑观雪独徘徊，"},{"Content":"欲赋惭无咏絮才。"},{"Content":"盐撒空中如可用，"},{"Content":"收藏聊与赠羹梅。"}]},{"Id":96198,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"冬夜不寐"},"Clauses":[{"Content":"推枕鸳帏不奈寒，"},{"Content":"起来霜月转阑干。"},{"Content":"闷怀脉脉与谁说，"},{"Content":"泪滴罗衣不忍看。"}]},{"Id":536146,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"青","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"雪夜赓笔"},"Clauses":[{"Content":"夜雪飞花似月明，"},{"Content":"交连寒影透门庭。"},{"Content":"只宜挟策临窗坐，"},{"Content":"免用辛勤更聚萤。"}]},{"Id":536147,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"江上雪霁"},"Clauses":[{"Content":"江水冰消起绿鳞，"},{"Content":"川原荡涤少烟尘。"},{"Content":"风吹南北溪桥畔，"},{"Content":"柳色参差欲漏春。"}]},{"Id":536148,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"赏雪"},"Clauses":[{"Content":"朱帘暮卷绮筵开，"},{"Content":"风雪纷纷入酒杯。"},{"Content":"对景恨无飞絮句，"},{"Content":"从今羞见谢娘才。"}]}],"Count":367,"PageNo":13,"PageSize":20}