{"Authors":{"Names":["祖咏"],"AuthorIds":[18935],"Dynasties":["Tang"]},"ShiData":[{"Id":41283,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"别怨"},"Clauses":[{"Content":"送别到中流，"},{"Content":"秋船倚渡头。"},{"Content":"相看尚不远，"},{"Content":"未可即回舟。"}],"Comments":[{"Book":"《唐诗归》","Content":"钟云：多情（末句下）。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗真趣编》","Content":"写“怨”字入微。佛云：“别离者，疗痴之良药，割爱之慧刀。”谁能棒下觉悟？刘仲肩曰：从《邶风》“汎汎其景”、“汎汎其逝”八字化出。","IsComment":false,"FullPath":"《唐诗真趣编》"}]},{"Id":41247,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"寒","Rank":0,"Title":{"Content":"终南望馀雪","Comments":[{"Content":"有司试此题，咏赋四句即纳，或诘之，曰意尽。","Type":"Text","Index":5}]},"Clauses":[{"Content":"终南阴岭秀，"},{"Content":"积雪浮云端。"},{"Content":"林表明霁色，"},{"Content":"城中增暮寒。"}],"Comments":[{"Book":"《唐诗纪事》","Content":"有司试《终南山望馀雪》诗，咏赋……四句，即纳于有司。或诘之，咏曰“意尽”。","IsComment":false,"FullPath":"《唐诗纪事》"},{"Book":"《增订评注唐诗正声》","Content":"凛凛有寒色。","IsComment":false,"FullPath":"《增订评注唐诗正声》"},{"Book":"《唐诗分类绳尺》","Content":"结句有讽。","IsComment":false,"FullPath":"《唐诗分类绳尺》"},{"Book":"《唐诗训解》","Content":"已霁犹寒，越见积雪。","IsComment":false,"FullPath":"《唐诗训解》"},{"Book":"《唐诗归》","Content":"钟云：说得缥缈森秀。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗选》","Content":"玉遮曰：“浮”字极好，诗亦佳绝，但只赋得积雪，不赋得馀雪。","IsComment":false,"FullPath":"《唐诗选》"},{"Book":"《诗绎》","Content":"庸手必刻画残雪正面矣，作者三四只用托笔写意，体格高浑。","IsComment":false,"FullPath":"《诗绎》"},{"Book":"《唐诗归折衷》","Content":"吴敬夫云：可见诗不论何体，终期意尽而止。凡绝句意不尽者，皆未成之律诗也。","IsComment":false,"FullPath":"《唐诗归折衷》"},{"Book":"《此木轩论诗汇编》","Content":"如此不拘，诗安得不高？意尽即不须续，更难在举场中作如此事。","IsComment":false,"FullPath":"《此木轩论诗汇编》"},{"Book":"《而庵说唐诗》","Content":"此首须看其安放题面次第，如月吐层云，光明渐现，闭目犹觉宛然也。此诗处处针线细密，真绣鸳鸯手也。……此外真更不能添一语也。","IsComment":false,"FullPath":"《而庵说唐诗》"},{"Book":"《网师园唐诗笺》","Content":"写“残”字高浑。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"《岘佣说诗》","Content":"苍秀之笔，与韦相近。","IsComment":false,"FullPath":"《岘佣说诗》"},{"Book":"《唐宋诗举要》","Content":"《渔洋诗话》（卷上）曰：古今雪诗，惟羊孚一赞及陶渊明“倾耳无希声，在目皓已洁”，及祖咏“终南阴岭秀”一篇，右丞“洒空深巷静，积素广庭宽”，韦左司“门对寒流雪满山”句，最佳。","IsComment":false,"FullPath":"《唐宋诗举要》"},{"Book":"《诗境浅说续编》","Content":"咏高山积雪，若从正面着笔，不过言山之高，雪之色，及空翠与皓素相映发耳。此诗从侧面着想，言遥望雪后南山，如开霁色，而长安万户，便觉生寒，则终南之高寒可想。用流水对句，弥见诗心灵活。且以霁色为喻，确是积雪，而非飞雪，取譬殊工。","IsComment":false,"FullPath":"《诗境浅说续编》"},{"Book":"唐诗鉴赏辞典","Content":"据《唐诗纪事》卷二十记载，这首诗是祖咏在长安应试时作的。按照规定，应该作成一首六韵十二句的五言排律，但他只写了这四句就交卷。有人问他为什么，他说：“意思已经完满了。”这真是无话即短，不必画蛇添足。<br />题意是望终南馀雪。从长安城中遥望终南山，所见的自然是它的“阴岭”（山北叫“阴”）；而且，惟其“阴”，才有“馀雪”。“阴”字下得很确切。“秀”是望中所得的印象，既赞颂了终南山，又引出下句。“积雪浮云端”，就是“终南阴岭秀”的具体内容。这个“浮”字下得多生动！自然，积雪不可能浮在云端。这是说：终南山的阴岭高出云端，积雪未化。云，总是流动的；而高出云端的积雪又在阳光照耀下寒光闪闪，不正给人以“浮”的感觉吗？读者也许要说：“这里并没有提到阳光呀！”是的，这里是没有提，但下句却作了补充。“林表明霁色”中的“霁色”，指的就是雨雪初晴时的阳光给“林表”涂上的色彩。<br />“明”字当然下得好，但“霁”字更重要。作者写的是从长安遥望终南馀雪的情景。终南山距长安城南约六十华里，从长安城中遥望终南山，阴天固然看不清，就是在大晴天，一般看到的也是笼罩终南山的蒙蒙雾霭；只有在雨雪初晴之时，才能看清它的真面目。贾岛的《望（终南）山》诗里是这样写的：“日日雨不断，愁杀望山人。天事不可长，劲风来如奔。阴霾一似扫，浩翠泻国门。长安百万家，家家张屏新。”久雨新晴，终南山翠色欲流，长安百万家，家家门前张开一面新崭崭的屏风，多好看！唐时如此，现在仍如此，久住西安的人，都有这样的经验。所以，如果写从长安城中望终南馀雪而不用一个“霁”字，却说望见终南阴岭的馀雪如何如何，那就不是客观真实了。<br />祖咏不仅用了“霁”，而且选择的是夕阳西下之时的“霁”。怎见得？他说“林表明霁色”，而不说山脚、山腰或林下“明霁色”，这是很费推敲的。“林表”承“终南阴岭”而来，自然在终南高处。只有终南高处的林表才明霁色，表明西山已衔半边日，落日的馀光平射过来，染红了林表，不用说也照亮了浮在云端的积雪。而结句的“暮”字，也已经呼之欲出了。<br />前三句，写“望”中所见；末一句，写“望”中所感。俗谚有云：“下雪不冷消雪冷”；又云：“日暮天寒”。一场雪后，只有终南阴岭尚馀积雪，其他地方的雪正在消融，吸收了大量的热，自然要寒一些；日暮之时，又比白天寒；望终南馀雪，寒光闪耀，就令人更增寒意。做望终南馀雪的题目，写到因望馀雪而增加了寒冷的感觉，意思的确完满了；何必死守清规戎律，再凑几句呢？<br />王士稹在《渔洋诗话》卷上里，把这首诗和陶潜的“倾耳无希声，在目皓已洁”、王维的“洒空深巷静，积素广庭宽”等并列，称为咏雪的“最佳”作，不算过誉。<br />(霍松林)","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]},{"Id":41269,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"排律","TypeDetail":"WuPai","Rhyme":"支","Rank":0,"Title":{"Content":"归汝坟山庄留别卢象"},"Clauses":[{"Content":"淹留岁将晏，"},{"Content":"久废南山期。"},{"Content":"旧业不见弃，"},{"Content":"还山从此辞。"},{"Content":"沤麻入南涧，"},{"Content":"刈麦向东菑。","Comments":[{"Content":"一作越楚","Type":"Text","Index":2}]},{"Content":"对酒鸡黍熟，"},{"Content":"闭门风雪时。"},{"Content":"非君一延首，"},{"Content":"谁慰遥相思。","Comments":[{"Content":"沤麻四句，洪迈取为绝句","Type":"Text","Index":5}]}]},{"Id":41270,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"排律","TypeDetail":"WuPai","Rhyme":"元","Rank":0,"Title":{"Content":"田家即事"},"Clauses":[{"Content":"旧居东皋上，"},{"Content":"左右俯荒村。"},{"Content":"樵路前傍岭，"},{"Content":"田家遥对门。"},{"Content":"欢娱始披拂，"},{"Content":"惬意在郊原。"},{"Content":"馀霁荡川雾，"},{"Content":"新秋仍昼昏。"},{"Content":"攀条憩林麓，"},{"Content":"引水开泉源。"},{"Content":"稼穑岂云倦，"},{"Content":"桑麻今正繁。"},{"Content":"方求静者赏，"},{"Content":"偶与潜夫论。"},{"Content":"鸡黍何必具，"},{"Content":"吾心知道尊。"}]},{"Id":41272,"Allusions":[{"AllusionIndex":6011,"AllusionKey":"陆沈","SentenceIndex":5}],"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"排律","TypeDetail":"WuPai","Rhyme":"侵","Rank":0,"Title":{"Content":"家园夜坐寄郭微"},"Clauses":[{"Content":"前阶微雨歇，"},{"Content":"开户散窥林。"},{"Content":"月出夜方浅，"},{"Content":"水凉池更深。"},{"Content":"馀风生竹树，"},{"Content":"清露薄衣襟。"},{"Content":"遇物遂遥叹，"},{"Content":"怀人滋远心。"},{"Content":"依稀成梦想，"},{"Content":"影响绝徽音。"},{"Content":"谁念穷居者，"},{"Content":"明时嗟陆沈。","Comments":[{"Content":"陆沈","Type":"AllusionKey","Index":5}]}]},{"Id":41274,"Allusions":[{"AllusionIndex":4572,"AllusionKey":"洛阳人","SentenceIndex":1},{"AllusionIndex":10059,"AllusionKey":"游梁","SentenceIndex":1}],"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"排律","TypeDetail":"WuPai","Rhyme":"真","Rank":0,"Title":{"Content":"酬汴州李别驾赠"},"Clauses":[{"Content":"秋风多客思，"},{"Content":"行旅厌艰辛。"},{"Content":"自洛非才子，"},{"Content":"游梁得主人。","Comments":[{"Content":"游梁","Type":"AllusionKey","Index":2}]},{"Content":"文章参末议，"},{"Content":"荣贱岂同伦。"},{"Content":"叹逝逢三演，","Comments":[{"Content":"一作世同王衍","Type":"Text","Index":5}]},{"Content":"怀贤忆四真。","Comments":[{"Content":"一作法","Type":"Text","Index":4}]},{"Content":"情因恩旧好，"},{"Content":"契托死生亲。"},{"Content":"所愧能投赠，"},{"Content":"清言益润身。"}]},{"Id":41273,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"排律","TypeDetail":"WuPai","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"清明宴司勋刘郎中别业"},"Clauses":[{"Content":"田家复近臣，"},{"Content":"行乐不违亲。","Comments":[{"Content":"一作遗","Type":"Text","Index":4}]},{"Content":"霁日园林好，"},{"Content":"清明烟火新。"},{"Content":"以文长会友，"},{"Content":"唯德自成邻。"},{"Content":"池照窗阴晚，"},{"Content":"杯香药味春。"},{"Content":"檐前花覆地，"},{"Content":"竹外鸟窥人。"},{"Content":"何必桃源里，"},{"Content":"深居作隐沦。"}]},{"Id":41271,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"排律","TypeDetail":"WuPai","Rhyme":"支","Rank":0,"Title":{"Content":"汝坟秋同仙州王长史翰闻百舌鸟"},"Clauses":[{"Content":"秋天闻好鸟，"},{"Content":"惊起出帘帷。"},{"Content":"却念殊方月，"},{"Content":"能鸣已后时。"},{"Content":"迁乔诚可早，"},{"Content":"出谷此何迟。"},{"Content":"顾影惭无对，"},{"Content":"怀群空所思。","Comments":[{"Content":"一作增","Type":"Text","Index":3}]},{"Content":"凄凉岁欲晚，"},{"Content":"萧索燕将辞。","Comments":[{"Content":"一作路","Type":"Text","Index":3}]},{"Content":"留听未终曲，"},{"Content":"弥令心独悲。"},{"Content":"高飞凭力致，"},{"Content":"巧啭任天姿。"},{"Content":"返覆知而静，"},{"Content":"间关断若遗。"},{"Content":"花繁上林路，","Comments":[{"Content":"一作苑","Type":"Text","Index":4}]},{"Content":"霜落汝川湄。"},{"Content":"且长凌风翮，"},{"Content":"乘春自有期。"}]},{"Id":41275,"Allusions":[{"AllusionIndex":156,"AllusionKey":"八龙","SentenceIndex":1},{"AllusionIndex":451,"AllusionKey":"老莱衣","SentenceIndex":3},{"AllusionIndex":2667,"AllusionKey":"潘岳貌","SentenceIndex":3},{"AllusionIndex":4573,"AllusionKey":"三虎","SentenceIndex":1}],"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"排律","TypeDetail":"WuPai","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"赠苗发员外","Comments":[{"Content":"（一作奉赠苗员外）。（一作李端诗）","Type":"Text","Index":5}]},"Clauses":[{"Content":"朱户敞高扉，"},{"Content":"青槐碍落晖。"},{"Content":"八龙乘庆重，","Comments":[{"Content":"八龙","Type":"AllusionKey","Index":2}]},{"Content":"三虎递朝归。","Comments":[{"Content":"一作地","Type":"Text","Index":3},{"Content":"三虎","Type":"AllusionKey","Index":2}]},{"Content":"坐竹人声绝，"},{"Content":"横琴鸟语稀。"},{"Content":"花惭潘岳貌，","Comments":[{"Content":"潘岳貌","Type":"AllusionKey","Index":5}]},{"Content":"年称老莱衣。","Comments":[{"Content":"老莱衣","Type":"AllusionKey","Index":5}]},{"Content":"叶暗朱樱熟，"},{"Content":"丝长粉蝶飞。"},{"Content":"应怜鲁儒贱，"},{"Content":"空与故山违。"}]},{"Id":41277,"GroupIndex":1,"Allusions":[{"AllusionIndex":3076,"AllusionKey":"夫差","SentenceIndex":0}],"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"古意二首"},"Clauses":[{"Content":"夫差日淫放，","Comments":[{"Content":"夫差","Type":"AllusionKey","Index":2}]},{"Content":"举国求妃嫔。"},{"Content":"自谓得王宠，"},{"Content":"代间无美人。"},{"Content":"碧罗象天阁，","Comments":[{"Content":"一作蒙","Type":"Text","Index":3}]},{"Content":"坐辇乘芳春。"},{"Content":"宫女数千骑，"},{"Content":"常游江水滨。"},{"Content":"年深玉颜老，"},{"Content":"时薄花妆新。"},{"Content":"拭泪下金殿，"},{"Content":"娇多不顾身。"},{"Content":"生前妒歌舞，"},{"Content":"死后同灰尘。"},{"Content":"冢墓令人哀，"},{"Content":"哀于铜雀台。"}]},{"Id":41278,"GroupIndex":2,"Allusions":[{"AllusionIndex":1414,"AllusionKey":"神女","SentenceIndex":3}],"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"古意二首","Comments":[{"Content":"（一作古意三首 三）。（一作常建诗）","Type":"Text","Index":4}]},"Clauses":[{"Content":"楚王竟何去，"},{"Content":"独自留巫山。"},{"Content":"偏使世人见，"},{"Content":"迢迢江汉间。","Comments":[{"Content":"一作水","Type":"Text","Index":4}]},{"Content":"驻舟春溪里，","Comments":[{"Content":"一作泽","Type":"Text","Index":4}]},{"Content":"誓愿拜灵颜。"},{"Content":"梦寐睹神女，","Comments":[{"Content":"神女","Type":"AllusionKey","Index":5}]},{"Content":"金沙鸣佩环。"},{"Content":"闲艳绝世姿，"},{"Content":"令人气力微。"},{"Content":"含笑默不语，","Comments":[{"Content":"一作竟","Type":"Text","Index":3}]},{"Content":"化作朝云飞。"}]},{"Id":41282,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"语","Rank":0,"Title":{"Content":"渡淮河寄平一"},"Clauses":[{"Content":"天色混波涛，"},{"Content":"岸阴匝村墅。"},{"Content":"微微汉祖庙，"},{"Content":"隐隐江陵渚。"},{"Content":"云树森已重，"},{"Content":"时明郁相拒。"}]},{"Id":41276,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"纸","Rank":0,"Title":{"Content":"夕次圃田店"},"Clauses":[{"Content":"前路入郑郊，","Comments":[{"Content":"一作程","Type":"Text","Index":2}]},{"Content":"尚经百馀里。"},{"Content":"马烦时欲歇，"},{"Content":"客归程未已。"},{"Content":"落日桑柘阴，"},{"Content":"遥村烟火起。","Comments":[{"Content":"一作林","Type":"Text","Index":2}]},{"Content":"西还不遑宿，"},{"Content":"中夜渡泾水。"}]},{"Id":41280,"Allusions":[{"AllusionIndex":3025,"AllusionKey":"献赋","SentenceIndex":0}],"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"先","Rank":0,"Title":{"Content":"送丘为下第","Comments":[{"Content":"（一作送丘为下第归苏州）。（一作严维诗）","Type":"Text","Index":5}]},"Clauses":[{"Content":"沧江一身客，"},{"Content":"献赋空十年。","Comments":[{"Content":"献赋","Type":"AllusionKey","Index":2}]},{"Content":"明主岂能好，"},{"Content":"今人谁举贤。"},{"Content":"国门税征驾，"},{"Content":"旅食谋归旋。"},{"Content":"皦日媚春水，"},{"Content":"绿蘋香客船。"},{"Content":"无媒既不达，"},{"Content":"予亦思归田。"}]},{"Id":41281,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"寒","Rank":0,"Title":{"Content":"寄王长史"},"Clauses":[{"Content":"汝颍俱宿好，"},{"Content":"往来托层峦。"},{"Content":"终日何寂寞，"},{"Content":"绕篱生蕙兰。"}]},{"Id":41279,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"纸","Rank":0,"Title":{"Content":"尚书省门吟","Comments":[{"Content":"开元中，进士唱第尚书省，落第者至省门散去，咏吟云云。","Type":"Text","Index":5}]},"Clauses":[{"Content":"落去他，"},{"Content":"两两三三戴帽子。"},{"Content":"日暮祖侯吟一声，"},{"Content":"长安竹柏皆枯死。"}]},{"Id":41284,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"句","TypeDetail":"Others","Rhyme":"尤","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"不知叠嶂夜来雨，"},{"Content":"清晓石楠花乱流。"}]},{"Id":41285,"Dynasty":"唐","Author":"祖咏","AuthorId":18935,"Type":"句","TypeDetail":"Others","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"支颐笑来客，"},{"Content":"头上有朝簪。"}],"Note":"按：（《诗式》卷四）。"}],"Count":38,"PageNo":1,"PageSize":20}