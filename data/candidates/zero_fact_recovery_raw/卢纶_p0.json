{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11292,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"送惟良上人归江南","Comments":[{"Content":"一作郢上人","Type":"Text","Index":8}]},"Clauses":[{"Content":"落日映危樯，"},{"Content":"归僧向岳阳。"},{"Content":"注瓶寒浪静，"},{"Content":"读律夜船香。"},{"Content":"苦雾沈山影，"},{"Content":"阴霾发海光。","Comments":[{"Content":"一作霞","Type":"Text","Index":2}]},{"Content":"群生一何负，"},{"Content":"多病礼医王。","Comments":[{"Content":"一作临","Type":"Text","Index":1},{"Content":"一作别","Type":"Text","Index":3}]}]},{"Id":11298,"Classes":["軍旅 送行"],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"送韩都护还边"},"Clauses":[{"Content":"好勇知名早，"},{"Content":"争雄上将间。"},{"Content":"战多春入塞，"},{"Content":"猎惯夜登山。","Comments":[{"Content":"一作烧","Type":"Text","Index":4}]},{"Content":"阵合龙蛇动，"},{"Content":"军移草木闲。"},{"Content":"今来部曲尽，"},{"Content":"白首过萧关。"}],"Comments":[{"Book":"《瀛奎律髓》","Content":"诗律响亮整齐。","IsComment":false,"FullPath":"《瀛奎律髓》"},{"Book":"《瀛奎律髓汇评》","Content":"纪昀：意注末二句，前六句反面烘托，便回身一掉，倍为凄惋耳。何以“响亮整齐”取之，殊失作者之意。","IsComment":false,"FullPath":"《瀛奎律髓汇评》"}]},{"Id":11280,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"Title":{"Content":"送姨弟裴均尉诸暨","Comments":[{"Content":"此子先君元相旧判官","Type":"Text","Index":8}]},"Clauses":[{"Content":"相悲得成长，"},{"Content":"同是外家恩。"},{"Content":"旧业废三亩，"},{"Content":"弱年成一门。","Comments":[{"Content":"一作承","Type":"Text","Index":3}]},{"Content":"城开山日早，"},{"Content":"吏散渚禽喧。"},{"Content":"东阁谬容止，"},{"Content":"予心君冀言。"}]},{"Id":11285,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"送盐铁裴判官入蜀"},"Clauses":[{"Content":"传诏收方贡，"},{"Content":"登车著赐衣。"},{"Content":"榷商蛮客富，"},{"Content":"税地芋田肥。"},{"Content":"云白风雷歇，"},{"Content":"林清洞穴稀。"},{"Content":"炎凉君莫问，"},{"Content":"见即在忘归。"}]