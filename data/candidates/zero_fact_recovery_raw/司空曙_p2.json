{"Authors":{"Names":["司空曙"],"AuthorIds":[13632],"Dynasties":["Tang"]},"ShiData":[{"Id":12260,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"寄天台秀师"},"Clauses":[{"Content":"天台瀑布寺，"},{"Content":"传有白头师。"},{"Content":"幻迹示羸病，","Comments":[{"Content":"一作是","Type":"Text","Index":3}]},{"Content":"空门无住持。"},{"Content":"雪晴看鹤去，"},{"Content":"海夜与龙期。"},{"Content":"永愿亲瓶屦，"},{"Content":"呈功得问疑。","Comments":[{"Content":"一作澄心","Type":"Text","Index":2}]}]},{"Id":12244,"Allusions":[{"AllusionIndex":9277,"AllusionKey":"玄晖","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"送夏侯审赴宁国"},"Clauses":[{"Content":"青圻连白浪，"},{"Content":"晓日渡南津。"},{"Content":"山叠陵阳树，"},{"Content":"舟多建业人。"},{"Content":"烟霞高占寺，","Comments":[{"Content":"一作古","Type":"Text","Index":4}]},{"Content":"枫竹暗停神。","Comments":[{"Content":"一作亭","Type":"Text","Index":4}]},{"Content":"如接玄晖集，","Comments":[{"Content":"玄晖","Type":"AllusionKey","Index":4}]},{"Content":"江丞独见亲。","Comments":[{"Content":"一作城犹","Type":"Text","Index":3}]}]},{"Id":12193,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"云阳馆与韩绅宿别","Comments":[{"Content":"一作韩升卿","Type":"Text","Index":6}]},"Clauses":[{"Content":"故人江海别，"},{"Content":"几度隔山川。"},{"Content":"乍见翻疑梦，"},{"Content":"相悲各问年。"},{"Content":"孤灯寒照雨，"},{"Content":"湿竹暗浮烟。"},{"Content":"更有明朝恨，"},{"Content":"离杯惜共传。"}],"Comments":[{"Book":"《对床夜语》","Content":"“故人江海别，几度隔山川……”、“暮蝉不可听，落叶岂堪闻……”，前一首司空曙，后一首郎士元，皆前虚后实之格，今之言唐诗者多尚此。","IsComment":false,"FullPath":"《对床夜语》"},{"Book":"《瀛奎律髓》","Content":"三、四一联，乃久别忽逢之绝唱也。","IsComment":false,"FullPath":"《瀛奎律髓》"},{"Book":"《四溟诗话》","Content":"诗有简而妙者……戴叔伦“还作江南会，翻疑梦里逢”，不如司空曙“乍见翻疑梦”。","IsComment":false,"FullPath":"《四溟诗话》"},{"Book":"《诗镜总论》","Content":"司空曙“相悲各问年”，更自应手犀快。风尘阅历，有此苦语。","IsComment":false,"FullPath":"《诗镜总论》"},{"Book":"《全唐风雅》","Content":"黄云：叙别后再会之情，且悲且喜，宛然在目。","IsComment":false,"FullPath":"《全唐风雅》"},{"Book":"《唐诗解》","Content":"此诗本中唐绝唱，然江海、山川未免重叠。","IsComment":false,"FullPath":"《唐诗解》"},{"Book":"《唐诗成法》","Content":"情景兼写，不失古法。","IsComment":false,"FullPath":"《唐诗成法》"},{"Book":"《唐诗别裁》","Content":"三、四写别久忽遇之情，五、六夜中共宿之景，通体一气，无饾饤习，尔时已为高格矣。","IsComment":false,"FullPath":"《唐诗别裁》"},{"Book":"《大历诗略》","Content":"真情实语，故自动人。","IsComment":false,"FullPath":"《大历诗略》"},{"Book":"《网师园唐诗笺》","Content":"真景真情（“乍见”一联下）。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"《瀛奎律髓汇评》","Content":"纪昀：四句更胜。","IsComment":false,"FullPath":"《瀛奎律髓汇评》"},{"Book":"《唐宋诗举要》","Content":"吴北江曰：三、四千古名句，能传久别初见之神。","IsComment":false,"FullPath":"《唐宋诗举要》"},{"Book":"《诗式》","Content":"发句先叙别况，曰“几度”，见柏见之难矣。颔联叙相见：曰“乍见”，言别久忽见也；曰“翻疑梦”，言未信为真，反疑是梦也；曰“相悲”，言相叙别情，不觉悲感也；曰“各问年”，言别久人亦老大，不能记其年岁，故各须相问也。颈联写云阳馆之景况。夜本凄清，况是孤灯，又相照附中乎？故曰“寒”。夜本迷茫，况是深竹，何能见烟浮乎？故曰“暗”。落句想到又别日，更有系缴上意，言此情此景，相对本是寡欢，况来朝又欲别乎？故更添恨事，今夜传杯相劝，即是离杯，只共惜离情而已。落到题后，尤妙在托空也。[品]悲慨。","IsComment":false,"FullPath":"《诗式》"},{"Book":"唐诗鉴赏辞典","Content":"云阳，县名，县治在今陕西泾阳县西北。韩绅，《全唐诗》注：“一作韩升卿。”韩愈四叔名绅卿，与司空曙同时，曾在泾阳任县令，可能即为其人。<br /><br />这是首惜别诗，但一开始却从上次的别离说起，接写此次相会，然后才写到叙谈和惜别，描写曲折，富有情致。<br /><br />上次别后，已历数年，山川阻隔，相会不易，其间的相思，自在言外。正因为相会不易，相思心切，所以才生发出此次相见时的“疑梦”和惜别的感伤心情来，首联和颔联，恰成因果关系。江海，指上次的分别地，也可理解为泛指江海天涯，相隔遥远。几度，几次，此处犹言几年，下文的“问年”，正与此呼应。<br /><br />“乍见”二句是传诵的名句，人到情极处，往往以假为真，以真作假。久别相逢，乍见以后，反疑为梦境，正说明了上次别后的相思心切和此次相会不易。假如别后没有牵情，相逢以后便会平平淡淡，不会有“翻疑梦”的情景出现了。“翻疑梦”，不仅情真意切，而且把诗人欣喜、惊奇的神态表现得维妙维肖，十分传神。即使说久别初见时悲喜交集的心情神态，尽见于三字之中，也是不为过的。杜甫《羌村三首》云：“夜阑更秉烛，相对如梦寐”，是写乱离中回家后和妻子儿女相见时的心情。“乍见”二句，和杜诗的用意相仿。“乍见”，不仅是说刚刚相见，而且还含有出乎意料、突然相见的意思。由于别后相会不易，所以见后才喜极生悲；由于别后时间隔得太长，所以相见以后才互问年龄。“各问年”，不仅在感叹年长容衰，也在以实证虚，说明“翻疑梦”的境真情真。<br /><br />颈联和尾联接写深夜在馆中叙谈的情景。相逢已难，又要离别，其间千言万语，不是片时所能说完的，所以诗人避实就虚，只以景象渲染映衬，以景寓情了。寒夜里，一束暗淡的灯火映照着蒙蒙的夜雨，竹林深处，似飘浮着片片烟云。孤灯、寒雨、浮烟、湿竹，景象是多么凄凉。诗人写此景正是借以渲染伤别的气氛。其中的孤、寒、湿、暗、浮诸字，都是得力的字眼，不仅渲染映衬出诗人悲凉暗淡的心情，也象征着人事的浮游不定。二句既是描写实景，又是虚写人的心情。<br /><br />结处表面上是劝饮离怀，实际上却是总写伤别。用一“更”字，就点明了即将再次离别的伤痛。“离怀惜共传”，在惨淡的灯光下，两位友人举杯劝饮，表现出彼此珍惜情谊和恋恋不舍的离情。惜，珍惜。诗人用在此处，自有不尽的情意。综观全诗，中四句语极工整，写悲喜感伤，笼罩寒夜，几乎不可收拾。但于末二句，却能轻轻收结，略略冲淡。这说明诗人能运笔自如，具有重抹轻挽的笔力。<br /><br />（孙其芳）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]},{"Id":12226,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"送卢使君赴夔州","Comments":[{"Content":"一作刘驾诗","Type":"Text","Index":7}]},"Clauses":[{"Content":"铙管随旌旆，"},{"Content":"高秋远上巴。"},{"Content":"白波连雾雨，"},{"Content":"青壁断蒹葭。"},{"Content":"凭几双童静，"},{"Content":"登楼万井斜。"},{"Content":"政成知变俗，"},{"Content":"当应画轮车。"}]},{"Id":12212,"Allusions":[{"AllusionIndex":257,"AllusionKey":"苏君","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"夜闻回雁"},"Clauses":[{"Content":"雁响天边过，"},{"Content":"高高望不分。"},{"Content":"飕飗传细雨，"},{"Content":"嘹唳隔长云。"},{"Content":"散向谁家尽，"},{"Content":"归来几客闻。"},{"Content":"还将今夜意，"},{"Content":"西海话苏君。","Comments":[{"Content":"苏君","Type":"AllusionKey","Index":5}]}]},{"Id":12268,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"赋得的的帆向浦"},"Clauses":[{"Content":"向浦参差去，"},{"Content":"随波远近还。"},{"Content":"初移芳草里，"},{"Content":"正在夕阳间。"},{"Content":"隐映回孤驿，"},{"Content":"微明出乱山。"},{"Content":"向空看不尽，"},{"Content":"归思满江关。"}]},{"Id":12220,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"秋思呈尹植裴说","Comments":[{"Content":"一本题下有郑洞二字","Type":"Text","Index":7}]},"Clauses":[{"Content":"静向懒相偶，"},{"Content":"年将衰共催。"},{"Content":"前途欢不集，","Comments":[{"Content":"一作未","Type":"Text","Index":4}]},{"Content":"往事恨空来。"},{"Content":"昼景委红叶，"},{"Content":"月华销绿苔。","Comments":[{"Content":"一作铺","Type":"Text","Index":3}]},{"Content":"沈思竟何有，"},{"Content":"坐结玉琴哀。"}]},{"Id":12216,"Allusions":[{"AllusionIndex":3265,"AllusionKey":"秦镜","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"故郭婉仪挽歌"},"Clauses":[{"Content":"一日辞秦镜，","Comments":[{"Content":"秦镜","Type":"AllusionKey","Index":5}]},{"Content":"千秋别汉宫。"},{"Content":"岂唯泉路掩，"},{"Content":"长使月轮空。"},{"Content":"苦色凝朝露，"},{"Content":"悲声切暝风。"},{"Content":"婉仪馀旧德，"},{"Content":"仍载礼经中。"}]},{"Id":12253,"Allusions":[{"AllusionIndex":7260,"AllusionKey":"日边","SentenceIndex":0},{"AllusionIndex":7989,"AllusionKey":"司空羡","SentenceIndex":1},{"AllusionIndex":8165,"AllusionKey":"太尉","SentenceIndex":1}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"蒸","Rank":0,"Title":{"Content":"送翰林张学士岭南勒圣碑"},"Clauses":[{"Content":"汉恩天外洽，"},{"Content":"周颂日边称。","Comments":[{"Content":"日边","Type":"AllusionKey","Index":4}]},{"Content":"文独司空羡，","Comments":[{"Content":"司空羡","Type":"AllusionKey","Index":5}]},{"Content":"书兼太尉能。","Comments":[{"Content":"太尉","Type":"AllusionKey","Index":4}]},{"Content":"出关逢北雁，"},{"Content":"度岭逐南鹏。"},{"Content":"使者翰林客，"},{"Content":"馀春归灞陵。"}]},{"Id":12233,"Allusions":[{"AllusionIndex":10957,"AllusionKey":"子猷","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"送吉校书东归"},"Clauses":[{"Content":"少年芸阁吏，"},{"Content":"罢直暂归休。"},{"Content":"独与亲知别，"},{"Content":"行逢江海秋。"},{"Content":"听猿看楚岫，"},{"Content":"随雁到吴洲。"},{"Content":"处处园林好，"},{"Content":"何人待子猷。","Comments":[{"Content":"子猷","Type":"AllusionKey","Index":5}]}]},{"Id":12241,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"送郑明府贬岭南"},"Clauses":[{"Content":"青枫江色晚，"},{"Content":"楚客独伤春。"},{"Content":"共对一尊酒，"},{"Content":"相看万里人。"},{"Content":"猜嫌成谪宦，"},{"Content":"正直不防身。"},{"Content":"莫畏炎方久，"},{"Content":"年年雨露新。"}]},{"Id":12263,"Allusions":[{"AllusionIndex":2132,"AllusionKey":"凤池","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"晚秋西省寄上李韩二舍人"},"Clauses":[{"Content":"昼漏传清唱，"},{"Content":"天恩禁旅秋。","Comments":[{"Content":"一作隅，一本缺","Type":"Text","Index":2}]},{"Content":"雁亲承露掌，"},{"Content":"砧隔曝衣楼。"},{"Content":"赐膳中人送，"},{"Content":"馀香侍女收。"},{"Content":"仍闻劳上直，"},{"Content":"晚步凤池头。","Comments":[{"Content":"凤池","Type":"AllusionKey","Index":4}]}]},{"Id":12189,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"下武昌江行望涔阳"},"Clauses":[{"Content":"悠悠次楚乡，","Comments":[{"Content":"一作向","Type":"Text","Index":3}]},{"Content":"楚口下涔阳。","Comments":[{"Content":"一作樊","Type":"Text","Index":1}]},{"Content":"雪隐洲渚暗，"},{"Content":"沙高芦荻黄。"},{"Content":"渔人共留滞，"},{"Content":"水鸟自喧翔。"},{"Content":"怀土年空尽，"},{"Content":"春风又淼茫。"}]},{"Id":12228,"Allusions":[{"AllusionIndex":1414,"AllusionKey":"云雨","SentenceIndex":1}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"Title":{"Content":"送史申之峡州"},"Clauses":[{"Content":"峡口巴江外，","Comments":[{"Content":"一作水","Type":"Text","Index":5}]},{"Content":"无风浪亦翻。"},{"Content":"蒹葭新有雁，"},{"Content":"云雨不离猿。","Comments":[{"Content":"云雨","Type":"AllusionKey","Index":2}]},{"Content":"行客思乡远，"},{"Content":"愁人赖酒昏。"},{"Content":"檀郎好联句，"},{"Content":"共滞谢家门。","Comments":[{"Content":"一作莫","Type":"Text","Index":1}]}]},{"Id":12202,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"江园书事寄卢纶"},"Clauses":[{"Content":"种柳南江边，"},{"Content":"闭门三四年。"},{"Content":"艳花那胜竹，","Comments":[{"Content":"一作俗人","Type":"Text","Index":2}]},{"Content":"凡鸟不如蝉。"},{"Content":"嗜酒渐婴渴，","Comments":[{"Content":"一作思","Type":"Text","Index":4}]},{"Content":"读书多欲眠。"},{"Content":"平生故交在，"},{"Content":"白首远相怜。"}]},{"Id":12240,"Allusions":[{"AllusionIndex":1463,"AllusionKey":"一榻依陈","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"送郑况往淮南"},"Clauses":[{"Content":"西楚见南关，"},{"Content":"苍苍落日间。"},{"Content":"云离大雷树，"},{"Content":"潮入秣陵山。"},{"Content":"登戍因高望，"},{"Content":"停桡放溜闲。"},{"Content":"陈公有贤榻，"},{"Content":"君去岂空还。"}]},{"Id":12278,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"题江陵临沙驿楼"},"Clauses":[{"Content":"江天清更愁，"},{"Content":"风柳入江楼。"},{"Content":"雁惜楚山晚，"},{"Content":"蝉知秦树秋。"},{"Content":"凄凉多独醉，"},{"Content":"零落半同游。"},{"Content":"岂复平生意，","Comments":[{"Content":"一作获","Type":"Text","Index":2}]},{"Content":"苍然兰杜洲。"}]},{"Id":12237,"Allusions":[{"AllusionIndex":1463,"AllusionKey":"置榻","SentenceIndex":2},{"AllusionIndex":6009,"AllusionKey":"鲁诸生","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"送张弋"},"Clauses":[{"Content":"拥棹江天旷，"},{"Content":"苍然下郢城。"},{"Content":"冰霜葭菼变，"},{"Content":"云泽鹧鸪鸣。"},{"Content":"酒倦临流醉，"},{"Content":"人逢置榻迎。","Comments":[{"Content":"置榻","Type":"AllusionKey","Index":4}]},{"Content":"尝闻藉东观，"},{"Content":"不独鲁诸生。","Comments":[{"Content":"鲁诸生","Type":"AllusionKey","Index":5}]}]},{"Id":12252,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"送僧无言归山"},"Clauses":[{"Content":"袈裟出尘外，"},{"Content":"山径几盘缘。"},{"Content":"人到白云树，"},{"Content":"鹤沈青草田。"},{"Content":"龛泉朝请盥，"},{"Content":"松籁夜和禅。"},{"Content":"自昔闻多学，"},{"Content":"逍遥注一篇。"}]},{"Id":12229,"Allusions":[{"AllusionIndex":452,"AllusionKey":"湘君","SentenceIndex":1},{"AllusionIndex":9277,"AllusionKey":"谢朓","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"送史泽之长沙"},"Clauses":[{"Content":"谢朓怀西府，","Comments":[{"Content":"谢朓","Type":"AllusionKey","Index":2}]},{"Content":"单车触火云。"},{"Content":"野蕉依戍客，"},{"Content":"庙竹映湘君。","Comments":[{"Content":"湘君","Type":"AllusionKey","Index":5}]},{"Content":"梦渚巴山断，"},{"Content":"长沙楚路分。"},{"Content":"一杯从别后，"},{"Content":"风月不相闻。"}],"Comments":[{"Book":"《瀛奎律髓》","Content":"两司空所言永嘉、长沙风土（按另一首指司空图《寄永嘉崔道融》各极新丽。所联二联，又皆下句胜。凡诗以下句胜上句为作家，先一句好而后一句弱，或不称，则败兴矣。","IsComment":false,"FullPath":"《瀛奎律髓》"},{"Book":"《唐诗镜》","Content":"三、四清颖，下语更炼。","IsComment":false,"FullPath":"《唐诗镜》"},{"Book":"《近体秋阳》","Content":"四句一气。七句一刀截断，藏凄恋意于丈夫气概中，直欲举袂掩面矣。","IsComment":false,"FullPath":"《近体秋阳》"},{"Book":"《唐诗矩》","Content":"四与“湘娥倚暮花”同妙。七、八言从此别后，纵有好风凉月，两地不复相闻，能不为我尽此一杯乎？读此，觉“劝君更进一杯酒，西处阳关无故人”语直率矣。千古留彼遗此，为之一叹。","IsComment":false,"FullPath":"《唐诗矩》"},{"Book":"《瀛奎律髓汇评》","Content":"纪昀：结句似相忆不似相送，病在“从”字。","IsComment":false,"FullPath":"《瀛奎律髓汇评》"}]}],"Count":165,"PageNo":2,"PageSize":20}