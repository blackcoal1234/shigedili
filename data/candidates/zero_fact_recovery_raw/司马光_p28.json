{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80888,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"和王少卿十日与留台国子监崇福宫诸官赴王尹赏菊之会","Comments":[{"Content":"尚恭，字汝之","Type":"Text","Index":4}]},"Clauses":[{"Content":"儒衣武弁聚华轩，"},{"Content":"尽是西都冷落官。"},{"Content":"莫叹黄花过佳节，"},{"Content":"且将素发共清欢。"},{"Content":"红牙板急弦声咽，"},{"Content":"白玉舟横酒量宽。"},{"Content":"青眼主公情不薄，"},{"Content":"一如省闼要人看。"}]},{"Id":80893,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"和白都官见赠","Comments":[{"Content":"序","Type":"Text","Index":4}]},"Clauses":[{"Content":"齿疏鬓白两眸昏，"},{"Content":"万事无堪老病身。"},{"Content":"脱粟犹沾太仓禄，"},{"Content":"法官仍忝外台臣。"},{"Content":"直缘迂僻求闲地，"},{"Content":"岂是孤高慕古人。"},{"Content":"英俊满朝皆稷契，"},{"Content":"太山何少一飞尘。"}]},{"Id":81048,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"送白都官归长安"},"Clauses":[{"Content":"丈夫那肯浪低眉，"},{"Content":"薄宦空添鬓里丝。"},{"Content":"泸水归来山浩荡，"},{"Content":"都门辞去菊离披。"},{"Content":"黄鸡白酒五陵乐，"},{"Content":"杜曲樊川九谷宜。"},{"Content":"复见夫君行直道，"},{"Content":"崆峒气俗未应衰。"}]},{"Id":81243,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"酬邵尧夫见示安乐窝中打乖吟"},"Clauses":[{"Content":"安乐窝中自在身，"},{"Content":"犹嫌名字落红尘。"},{"Content":"醉吟终日不知老，"},{"Content":"经史满堂谁道贫。"},{"Content":"长掩柴荆避寒暑，"},{"Content":"只将花卉记冬春。"},{"Content":"料非空处打乖客，"},{"Content":"乃是清朝避世人。"}]},{"Id":80904,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"和邠守宋度支来卜居与南园为邻","Comments":[{"Content":"迪","Type":"Text","Index":6}]},"Clauses":[{"Content":"弱冠交游鬓发苍，"},{"Content":"饱谙官况好深藏。"},{"Content":"闲居共买一廛地，"},{"Content":"尽老常依数仞墙。"},{"Content":"虽喜卜邻同晏子，"},{"Content":"尚惭推宅异周郎。"},{"Content":"何时税此凭熊驾，"},{"Content":"倚仗相迎立路傍。"}]},{"Id":80907,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"和君贶少林寺"},"Clauses":[{"Content":"达磨自云传佛心，"},{"Content":"绪言迷世到于今。"},{"Content":"既携只履归西域，"},{"Content":"安得遗灵在少林。"},{"Content":"孤月正明高殿冷，"},{"Content":"清风不断老松深。"},{"Content":"谢公自爱山泉美，"},{"Content":"肯为幽禅此访寻。"}]},{"Id":80911,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"Title":{"Content":"和君贶题潞公东庄"},"Clauses":[{"Content":"嵩峰远叠千重雪，"},{"Content":"伊浦低临一片天。"},{"Content":"百顷平皋连别馆，"},{"Content":"两行疏柳拂清泉。"},{"Content":"国须柱石扶丕构，"},{"Content":"人待楼航济巨川。"},{"Content":"萧相方如左右手，"},{"Content":"且于穷僻置闲田。"}]},{"Id":80909,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"和君贶任少师园赏梅"},"Clauses":[{"Content":"寒压春头草未芽，"},{"Content":"喜闻置酒赏新葩。"},{"Content":"官仪赫奕三川守，"},{"Content":"野意萧疏四皓家。"},{"Content":"不用管弦妨淡泊，"},{"Content":"岂容桃李竞繁华。"},{"Content":"昏鸦散乱传呼出，"},{"Content":"归路林间烛影斜。"}]},{"Id":80851,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"别韵一首"},"Clauses":[{"Content":"风日虽寒昼景长，"},{"Content":"探春远访白莲庄。"},{"Content":"岸冰犹在水先绿，"},{"Content":"柳叶未生条已黄。"},{"Content":"老木根侵苔径窄，"},{"Content":"新梅花入酒卮香。"},{"Content":"天真不必人修饰，"},{"Content":"得趣勿嫌台馆荒。"}]},{"Id":80887,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"和公廙喜雪","Comments":[{"Content":"用庄字韵","Type":"Text","Index":5}]},"Clauses":[{"Content":"向来河洛久愆阳，"},{"Content":"祷祀徒劳罄肃庄。"},{"Content":"林雪飞花欣暂白，"},{"Content":"麦田濡叶未全黄。"},{"Content":"城中稍觉桑薪贵，"},{"Content":"村外时闻社瓮香。"},{"Content":"八使孜孜悯茕独，"},{"Content":"斯民那复畏凶荒。"}]},{"Id":80892,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"和史诚之谢送张明叔梅台三种梅花"},"Clauses":[{"Content":"别后相惊两鬓霜，"},{"Content":"可怜梅蕊为谁芳。"},{"Content":"台头日暖分三色，"},{"Content":"林下风清共一香。","Comments":[{"Content":"原作材，据陈本改","Type":"Text","Index":1}]},{"Content":"正烂漫时游不足，"},{"Content":"忽离披去乐难常。"},{"Content":"慇勤手折遥相赠，"},{"Content":"不欲花前独举觞。"}]},{"Id":80908,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"和君贶寄河阳侍中牡丹"},"Clauses":[{"Content":"真宰无私妪煦同，"},{"Content":"洛花何事占全功。"},{"Content":"山河势胜帝王宅，"},{"Content":"寒暑气和天地中。"},{"Content":"尽日玉盘堆秀色，"},{"Content":"满城绣毂走香风。"},{"Content":"谢公高兴看春物，"},{"Content":"倍忆清伊与碧嵩。"}]},{"Id":80744,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"歌","Rank":0,"Title":{"Content":"又和安国寺及诸园赏牡丹"},"Clauses":[{"Content":"洛邑牡丹天下最，"},{"Content":"西南土沃得春多。"},{"Content":"一城奇品推安国，"},{"Content":"四面名园接月波。"},{"Content":"山相著书称上药，"},{"Content":"翰林弄笔作新歌。"},{"Content":"人间朱粉无因学，"},{"Content":"浪把菱花百遍磨。"}]},{"Id":81245,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"酬仲通初提举崇福宫见寄"},"Clauses":[{"Content":"富寿安民旧学违，"},{"Content":"符移拥笔素心非。"},{"Content":"青云有路那足顾，"},{"Content":"白发满头胡不归。"},{"Content":"永日杜门无俗客，"},{"Content":"临风隐几得天机。"},{"Content":"西山爽气秋应好，"},{"Content":"恨不相从上翠微。"}]},{"Id":80790,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"去春与景仁同至河阳谒晦叔馆于府之后园既去晦叔名其馆曰礼贤梦得作诗以纪其事光虽愧其名亦作诗以继之"},"Clauses":[{"Content":"蓬飞匏系十馀年，"},{"Content":"并荫华榱出偶然。"},{"Content":"郭隗金台虽见礼，"},{"Content":"华歆龙尾岂能贤。"},{"Content":"浮云世味闲先薄，","Comments":[{"Content":"陈本作尤","Type":"Text","Index":6}]},{"Content":"寒柏交情老更坚。"},{"Content":"明日河梁即分首，"},{"Content":"人生乐事信难全。"}]},{"Id":80751,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"萧","Rank":0,"FirstClauseRhyme":"萧","Title":{"Content":"与乐道约会超化寺比至乐道以疾先归涂中有诗见寄"},"Clauses":[{"Content":"颠毛种种齿浮摇，"},{"Content":"屈指交游渐寂寥。"},{"Content":"时较半朝非是晚，"},{"Content":"路无数里不为遥。"},{"Content":"子猷垂到复归去，"},{"Content":"安道虽知未易邀。"},{"Content":"古寺徘徊久东望，"},{"Content":"青春云日冷萧萧。"}]},{"Id":80890,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"和乐道再以诗见寄"},"Clauses":[{"Content":"谏垣簪笔接英游，"},{"Content":"今日华颠昔日忧。"},{"Content":"邂逅升沈皆是命，"},{"Content":"逍遥出处本无愁。"},{"Content":"衡门不羡金门贵，"},{"Content":"藿食焉知肉食谋。"},{"Content":"溟海榆枋各安分，"},{"Content":"蓬莱未必胜嵩丘。"}]},{"Id":81240,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"酬宋叔达卜居洛城见寄","Comments":[{"Content":"道，复古之兄","Type":"Text","Index":4}]},"Clauses":[{"Content":"离群四十一春风，"},{"Content":"纵有相逢似梦中。"},{"Content":"幸得相逢作邻舍，"},{"Content":"但嗟彼此是衰翁。"},{"Content":"汉文前席人将去，","Comments":[{"Content":"自注：复古谪官，不日牵复。","Type":"Text","Index":7}]},{"Content":"庾信诛茅橐未充。","Comments":[{"Content":"自注：来诗云自笑颠穷（陈本作狂）便归去，并无穿系买山钱。","Type":"Text","Index":7}]},{"Content":"怅望金堤碧芜阔，"},{"Content":"杖藜携手几时同。"}]},{"Id":80914,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"和吴辨叔知凤翔见寄"},"Clauses":[{"Content":"岐阳府舍始相逢，"},{"Content":"四十馀春屈指中。"},{"Content":"昔日布衣今露冕，"},{"Content":"当时小吏亦衰翁。"},{"Content":"醉吟久作藏身计，"},{"Content":"条教应多及物功。"},{"Content":"惟是䌽衣难再著，"},{"Content":"长林极目起悲风。"}]},{"Id":80895,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"和刘伯寿陪潞公禊饮"},"Clauses":[{"Content":"旌幢车骑满沙头，"},{"Content":"鼓吹喧繁画鹢浮。"},{"Content":"十里罗纨光照地，"},{"Content":"千家帘幕远临流。"},{"Content":"觞随洛水周公事，"},{"Content":"月映凤楼裴相游。"},{"Content":"令典久堕今更举，","Comments":[{"Content":"自注：火规切。","Type":"Text","Index":4}]},{"Content":"行闻美俗遍中州。"}]}],"Count":1270,"PageNo":28,"PageSize":20}