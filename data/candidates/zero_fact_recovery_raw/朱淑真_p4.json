{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":96286,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"冬至"},"Clauses":[{"Content":"黄钟应律好风吹，","Comments":[{"Content":"元刻本作催","Type":"Text","Index":7}]},{"Content":"阴伏阳升淑气回。"},{"Content":"葵影便移日长至，","Comments":[{"Content":"元刻本作长至日","Type":"Text","Index":7}]},{"Content":"梅花先趁小寒开。"},{"Content":"八神表日占和岁，"},{"Content":"六琯飞葭动细灰。"},{"Content":"已有岸旁迎腊柳，"},{"Content":"参差又欲领春来。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[催]《千家诗选》　《武林》本作[吹]。[便] 《武林》本作[便移]。[飞葭]《千家诗选》　铁琴铜剑楼钞本作[吹葭]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":536145,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"咏雪"},"Clauses":[{"Content":"六出飞花四面来，"},{"Content":"连山连水皓皑皑。","Comments":[{"Content":"元刻本作接","Type":"Text","Index":3}]},{"Content":"玲珑天地苍茫合，"},{"Content":"的皪园林烂漫开。"},{"Content":"庾岭腊梅寒散乱，"},{"Content":"章台风柳絮萦回。"},{"Content":"自言空有孤吟癖，"},{"Content":"览景惭无谢氏才。"}]},{"Id":167873,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"对雪","Comments":[{"Content":"《沅湘耆旧集》前编卷二八作易祓妻诗","Type":"Text","Index":2}]},"Clauses":[{"Content":"纷纷瑞雪压山河，"},{"Content":"特出新奇和郢歌。"},{"Content":"乐道幽人方闭户，"},{"Content":"高歌渔父正披蓑。"},{"Content":"自嗟老景光阴速，"},{"Content":"谁使佳时感怆多。"},{"Content":"更念鳏居憔悴客，"},{"Content":"映书无寐奈愁何。"}]},{"Id":536159,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"文","Title":{"Content":"荷花"},"Clauses":[{"Content":"暑气炎炎正若焚，"},{"Content":"荷花于此见天真。"},{"Content":"香房馥郁随风拆，"},{"Content":"笑脸妖娆映水新。"},{"Content":"间叶浅深殷似点，"},{"Content":"满池繁媚丽于春。"},{"Content":"年年占得馀芳在，"},{"Content":"几见当时步步人。"}]},{"Id":536172,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"题王氏必兴轩"},"Clauses":[{"Content":"福有根基善有源，"},{"Content":"必兴缘此敞新轩。"},{"Content":"埋蛇入相真堪慕，"},{"Content":"屠狗封侯岂足论。"},{"Content":"未必芝兰偏谢砌，"},{"Content":"好看车马集于门。"},{"Content":"从来天报无先后，"},{"Content":"不在其身在子孙。"}]},{"Id":536173,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"题余氏攀鳞轩"},"Clauses":[{"Content":"潇洒新轩傍翠岑，"},{"Content":"攀鳞勃勃此潜心。"},{"Content":"易惊谁羡叶公室，"},{"Content":"入梦当为傅说霖。"},{"Content":"变化一身雷霹远，"},{"Content":"腾凌千里海波深。"},{"Content":"卧庐曾比崇高志，"},{"Content":"肯忆当时梁父吟。"}]},{"Id":96317,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"贺人移学东轩"},"Clauses":[{"Content":"一轩潇洒正东偏，"},{"Content":"屏弃嚣尘聚简编。"},{"Content":"美璞莫辞彫作器，"},{"Content":"涓流终见积成渊。"},{"Content":"谢班难继予惭甚，"},{"Content":"颜孟堪睎子勉旃。"},{"Content":"鸿鹄羽仪当养就，"},{"Content":"飞腾早晚看冲天。"}]},{"Id":536174,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"送人赴试礼部"},"Clauses":[{"Content":"春闱报罢已三年，"},{"Content":"又向西风促去鞭。"},{"Content":"屡鼓莫嫌非作气，"},{"Content":"一飞当自卜冲天。"},{"Content":"贾生少达终何遇，"},{"Content":"马援才高老更坚。"},{"Content":"大抵功名无早晚，"},{"Content":"平津今见起菑川。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》后集卷七","Type":"Text","Index":7}]}]},{"Id":96289,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"次韵见赠兼简吴夫人"},"Clauses":[{"Content":"南北常嗟见未因，"},{"Content":"停舟今喜笑谈亲。"},{"Content":"张姬淑德同冰玉，"},{"Content":"李白高吟泣鬼神。"},{"Content":"和管幸听鸣凤侣，"},{"Content":"滥竽还愧赏音人。"},{"Content":"佳篇奖拂还过实，"},{"Content":"班卫声名岂易伦。"}]},{"Id":536175,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"题四并楼"},"Clauses":[{"Content":"华榜危楼岂浪名，","Comments":[{"Content":"原作杨，据元刻本，武林本改","Type":"Text","Index":2}]},{"Content":"人间四者此环并。"},{"Content":"日知光景无虚度，"},{"Content":"时觉清风满座生。"},{"Content":"庾亮据床谈兴逸，"},{"Content":"仲宣倚槛客愁轻。","Comments":[{"Content":"原作荷，据元刻本、武林本改","Type":"Text","Index":3}]},{"Content":"眼前此乐难兼得，"},{"Content":"许我登临载酒行。"}]},{"Id":536181,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"竹"},"Clauses":[{"Content":"一径浓阴影覆墙，"},{"Content":"含烟敲雨暑天凉。"},{"Content":"猗猗肯羡夭桃艳，"},{"Content":"凛凛终同劲柏刚。"},{"Content":"风籁入时添细韵，"},{"Content":"月华临处送清光。"},{"Content":"凌冬不改青坚节，"},{"Content":"冒雪何伤色转苍。"}]},{"Id":536182,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"江上阻风"},"Clauses":[{"Content":"正阻行程江岸间，"},{"Content":"江头三日系归船。"},{"Content":"水光激浪高翻雪，"},{"Content":"风力推沙远涨烟。"},{"Content":"拔闷喜陪尊有酒，"},{"Content":"供厨不虑食无钱。"},{"Content":"雕章见及唯虚辱，"},{"Content":"勉强赓酬愧斐然。","Comments":[{"Content":"同上书卷一二","Type":"Text","Index":7}]}]},{"Id":536198,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"游旷写亭有作"},"Clauses":[{"Content":"旷写亭高四望中，"},{"Content":"楼台城郭正春风。"},{"Content":"笙歌富庶千门乐，"},{"Content":"市井喧哗百货通。"},{"Content":"叠叠民居还瓦屋，"},{"Content":"纷纷游蝶乱花丛。"},{"Content":"凭栏忽念非吾土，"},{"Content":"目断白云心莫穷。","Comments":[{"Content":"同上书册五页三四七八","Type":"Text","Index":7}]}]},{"Id":536065,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"尤","Rank":0,"Title":{"Content":"秋日述怀"},"Clauses":[{"Content":"妇人虽软眼，"},{"Content":"泪不等闲流。"},{"Content":"我因无好况，"},{"Content":"挥断五湖秋。"}]},{"Id":96188,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"齐","Rank":0,"Title":{"Content":"书窗即事二首"},"Clauses":[{"Content":"花落春无语，"},{"Content":"春归鸟自啼。"},{"Content":"多情是蜂蝶，"},{"Content":"飞过粉墙西。"}],"Comments":[{"Content":"这首诗写春去夏来的景色，后两句借蜜蜂蝴蝶飞来飞去，烘托出一种生机活跃、令人欢悦的气氛。【解释】①书窗即事--就书窗外的事物写成诗。②春归--春天去了。","IsComment":false}]},{"Id":536085,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"Title":{"Content":"书窗即事二首"},"Clauses":[{"Content":"一阵催花雨，","Comments":[{"Content":"元刻本作挫","Type":"Text","Index":3}]},{"Content":"高低飞落红。"},{"Content":"榆钱空万叠，"},{"Content":"买不住春风。"}]},{"Id":536121,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"西楼纳凉"},"Clauses":[{"Content":"小阁对芙蕖，"},{"Content":"嚣尘一点无。"},{"Content":"水风凉枕罩，"},{"Content":"雪葛爽肌肤。"}]},{"Id":536129,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"秋楼晚望"},"Clauses":[{"Content":"凉吹晚飕飕，"},{"Content":"芦花两岸秋。"},{"Content":"夕阳楼上望，"},{"Content":"独倚泪偷流。"}]},{"Id":96191,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"寒","Rank":0,"Title":{"Content":"长宵"},"Clauses":[{"Content":"霜月照人悄，"},{"Content":"迢迢夜未阑。"},{"Content":"鸳帏梦展转，"},{"Content":"珠泪向谁弹。"}]},{"Id":536158,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"侵","Rank":0,"Title":{"Content":"直竹","Comments":[{"Content":"题原缺，据《后村千家诗》卷一一补","Type":"Text","Index":2}]},"Clauses":[{"Content":"劲直忠臣节，"},{"Content":"孤高列女心。"},{"Content":"四时同一色，"},{"Content":"霜雪不能侵。"}]}],"Count":367,"PageNo":4,"PageSize":20}