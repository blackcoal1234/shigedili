{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":536168,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"董生"},"Clauses":[{"Content":"秦火经来道失真，"},{"Content":"下帷发愤每劳神。"},{"Content":"谁知异日为无得，"},{"Content":"只听平津一老臣。"}]},{"Id":536169,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"晁错"},"Clauses":[{"Content":"七国绵延蔓草图，"},{"Content":"一言请削独干诛。"},{"Content":"扬雄自负功名志，"},{"Content":"犹罪当时太失愚。"}]},{"Id":536170,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"刘向二首","Comments":[{"Content":"题原缺，且诗误置后集卷七。今据诗意补题并移此，以符本卷总题，“咏史十首”之数","Type":"Text","Index":4}]},"Clauses":[{"Content":"洽闻博识似君难，"},{"Content":"况复腾凌宗室间。"},{"Content":"屡谏不容甘畎亩，"},{"Content":"七侯同日亦何颜。"}]},{"Id":536171,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"刘向二首","Comments":[{"Content":"题原缺，且诗误置后集卷七。今据诗意补题并移此，以符本卷总题，“咏史十首”之数","Type":"Text","Index":4}]},"Clauses":[{"Content":"王氏滔天擅国权，"},{"Content":"可堪恭显厕其间。"},{"Content":"屡形天谴君非悟，"},{"Content":"徒使宗臣每犯颜。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》后集卷六，总题咏史十首","Type":"Text","Index":7}]}]},{"Id":96221,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"4","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"舟行即事七首"},"Clauses":[{"Content":"帆高风顺疾如飞，"},{"Content":"天阔波平远又低。"},{"Content":"山色水光随地改，"},{"Content":"共谁裁剪入新诗。"}]},{"Id":536177,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"舟行即事七首"},"Clauses":[{"Content":"扁舟欲发意何如，"},{"Content":"回望乡关万里馀。"},{"Content":"谁识此情肠断处，"},{"Content":"白云遥处有亲庐。"}]},{"Id":96219,"GroupIndex":3,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"青","Title":{"Content":"舟行即事七首"},"Clauses":[{"Content":"画舸寒江江上亭，"},{"Content":"行舟来去泛纵横。"},{"Content":"无端添起思乡意，"},{"Content":"一字天边归雁声。"}]},{"Id":96217,"GroupIndex":4,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"舟行即事七首"},"Clauses":[{"Content":"满江流水万重波，"},{"Content":"未似幽怀别恨多。"},{"Content":"目断亲闱瞻不到，"},{"Content":"临风挥沔独悲歌。"}]},{"Id":96218,"GroupIndex":5,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"佳","Title":{"Content":"舟行即事七首"},"Clauses":[{"Content":"对景如何可遣怀，"},{"Content":"与谁江上共诗裁。"},{"Content":"江长景好是难尽，"},{"Content":"每自临风愧乏才。"}]},{"Id":96220,"GroupIndex":6,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"舟行即事七首"},"Clauses":[{"Content":"岁暮天涯客异乡，"},{"Content":"扁舟今又度潇湘。"},{"Content":"颦眉独坐水窗下，"},{"Content":"泪滴罗衣暗断肠。"}]},{"Id":536178,"GroupIndex":7,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"佳","Title":{"Content":"舟行即事七首"},"Clauses":[{"Content":"岁节将残恼闷怀，"},{"Content":"庭闱献寿阻传杯。"},{"Content":"此愁此恨人谁见，"},{"Content":"镇日柔肠自九回。"}]},{"Id":536179,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"卧龙"},"Clauses":[{"Content":"角莹纤琼鳞粲金，"},{"Content":"拥珠闲卧紫渊深。"},{"Content":"时来天地云雷举，","Comments":[{"Content":"原作与，据武林本改","Type":"Text","Index":7}]},{"Content":"起作人间救旱霖。"}]},{"Id":536180,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"惜花"},"Clauses":[{"Content":"病眼看花似梦中，"},{"Content":"一番次第又飞空。"},{"Content":"朝来不忍倚树立，"},{"Content":"倚树恐摇枝上红。","Comments":[{"Content":"宋刘克庄《后村千家诗》卷七","Type":"Text","Index":7}]}]},{"Id":96199,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"齐","Rank":0,"Title":{"Content":"竹"},"Clauses":[{"Content":"百竿直节拂云霁，","Comments":[{"Content":"《诗渊》册四作高","Type":"Text","Index":3}]},{"Content":"千亩谁人羡渭溪。"},{"Content":"燕雀谩教来唧噪，"},{"Content":"虚心终待凤凰栖。","Comments":[{"Content":"同上书卷一一","Type":"Text","Index":7}]}]},{"Id":82343,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"雪晴二首","Comments":[{"Content":"一作白玉蟾诗","Type":"Text","Index":4}]},"Clauses":[{"Content":"桃李无言蜂蝶忙，"},{"Content":"晓寒未肯放春光。"},{"Content":"花将计会千山日，","Comments":[{"Content":"一作雪","Type":"Text","Index":7}]},{"Content":"风为栽埋一夜霜。"}]},{"Id":82342,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"雪晴二首","Comments":[{"Content":"一作白玉蟾诗","Type":"Text","Index":4}]},"Clauses":[{"Content":"早上新莺语尚蛮，"},{"Content":"花无气力倚雕栏。"},{"Content":"幸蒙残雪回头早，"},{"Content":"又遣东风薄倖寒。","Comments":[{"Content":"同上书卷一三","Type":"Text","Index":7}]}]},{"Id":536183,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"冬","Title":{"Content":"笔"},"Clauses":[{"Content":"双毫五彩兔狸锋，"},{"Content":"珍与欧阳象管同。"},{"Content":"多谢寄来情意重，"},{"Content":"从今敢废墨池工。","Comments":[{"Content":"同上书卷一七","Type":"Text","Index":7}]}]},{"Id":536184,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"莺"},"Clauses":[{"Content":"野花啼鸟喜新晴，"},{"Content":"湖上波光漾日明。"},{"Content":"底事伤春心绪懒，"},{"Content":"不堪愁里听莺声。","Comments":[{"Content":"同上书卷一九","Type":"Text","Index":7}]}]},{"Id":536185,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"齐","Rank":0,"FirstClauseRhyme":"齐","Title":{"Content":"三月三日"},"Clauses":[{"Content":"林花落尽草初齐，"},{"Content":"客里萧条思欲迷。"},{"Content":"又是春光去时节，"},{"Content":"满城飞絮乱莺啼。"}]},{"Id":536186,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"清明游饮少湖庄"},"Clauses":[{"Content":"清明玩赏正繁华，"},{"Content":"今日林梢落尽花。"},{"Content":"人散酒阑春已去，"},{"Content":"一泓初涨满池蛙。"}]}],"Count":367,"PageNo":15,"PageSize":20}