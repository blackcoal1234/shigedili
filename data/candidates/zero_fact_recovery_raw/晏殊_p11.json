{"Authors":{"Names":["晏殊"],"AuthorIds":[27290],"Dynasties":["Song"]},"ShiData":[{"Id":198190,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"20","Rank":0,"Title":{"Content":"长生乐"},"TuneId":{"Id":395},"Clauses":[{"Content":"阆苑神仙平地见，"},{"Content":"碧海架蓬瀛。"},{"Content":"洞门相向，"},{"Content":"倚金铺微明。"},{"Content":"处处天花撩乱，"},{"Content":"飘散歌声。"},{"Content":"装真筵寿，"},{"Content":"赐与流霞满瑶觥。","BreakAfter":"1"},{"Content":"红鸾翠节，"},{"Content":"紫凤银笙。"},{"Content":"玉女双来近彩云。"},{"Content":"随步朝夕拜三清。"},{"Content":"为传王母金箓，"},{"Content":"祝千岁长生。"}]},{"Id":198215,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"10","Rank":0,"Title":{"Content":"拂霓裳"},"TuneId":{"Id":434},"Clauses":[{"Content":"庆生辰。"},{"Content":"庆生辰是百千春。"},{"Content":"开雅宴，"},{"Content":"画堂高会有诸亲。"},{"Content":"钿函封大国，"},{"Content":"玉色受丝纶。"},{"Content":"感皇恩。"},{"Content":"望九重天上拜尧云。","Comments":[{"Content":"、","Type":"Text","Index":3}],"BreakAfter":"1"},{"Content":"今朝祝寿，"},{"Content":"祝寿数，"},{"Content":"比松椿。"},{"Content":"斟美酒，"},{"Content":"至心如对月中人。"},{"Content":"一声檀板动，"},{"Content":"一炷蕙香焚。"},{"Content":"祷仙真。"},{"Content":"愿年年今日喜长新。","Comments":[{"Content":"、","Type":"Text","Index":5}]}]},{"Id":198217,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"20","Rank":0,"Title":{"Content":"拂霓裳"},"TuneId":{"Id":434},"Clauses":[{"Content":"喜秋成。"},{"Content":"见千门万户乐升平。"},{"Content":"金风细，"},{"Content":"玉池波浪縠文生。"},{"Content":"宿露沾罗幕，"},{"Content":"微凉入画屏。"},{"Content":"张绮宴，"},{"Content":"傍熏炉蕙炷和新声。","Comments":[{"Content":"、","Type":"Text","Index":5}],"BreakAfter":"1"},{"Content":"神仙雅会，"},{"Content":"会此日，"},{"Content":"象蓬瀛。"},{"Content":"管弦清，"},{"Content":"旋翻红袖学飞琼。"},{"Content":"光阴无暂住，"},{"Content":"欢醉有闲情。"},{"Content":"祝辰星。"},{"Content":"愿百千为寿献瑶觥。","Comments":[{"Content":"、","Type":"Text","Index":5}]}]},{"Id":198216,"GroupIndex":3,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"12","Rank":0,"Title":{"Content":"拂霓裳"},"TuneId":{"Id":434},"Clauses":[{"Content":"乐秋天。"},{"Content":"晚荷花缀露珠圆。"},{"Content":"风日好，"},{"Content":"数行新雁贴寒烟。"},{"Content":"银簧调脆管，"},{"Content":"琼柱拨清弦。"},{"Content":"捧觥船。"},{"Content":"一声声齐唱太平年。","Comments":[{"Content":"、","Type":"Text","Index":3}],"BreakAfter":"1"},{"Content":"人生百岁，"},{"Content":"离别易，"},{"Content":"会逢难。"},{"Content":"无事日，"},{"Content":"剩呼宾友启芳筵。"},{"Content":"星霜催绿鬓，"},{"Content":"风露损朱颜。"},{"Content":"惜清欢。"},{"Content":"又何妨沈醉玉尊前。","Comments":[{"Content":"、","Type":"Text","Index":3}]}]},{"Id":198282,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rank":0,"Title":{"Content":"菩萨蛮"},"TuneId":{"Id":105},"Clauses":[{"Content":"芳莲九蕊开新艳。"},{"Content":"轻红淡白匀双脸。"},{"Content":"一朵近华堂。"},{"Content":"学人宫样妆。","BreakAfter":"1"},{"Content":"看时斟美酒。"},{"Content":"共祝千年寿。"},{"Content":"销得曲中誇。"},{"Content":"世间无此花。"}]},{"Id":198281,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rank":0,"Title":{"Content":"菩萨蛮"},"TuneId":{"Id":105},"Clauses":[{"Content":"秋花最是黄葵好。"},{"Content":"天然嫩态迎秋早。"},{"Content":"染得道家衣。"},{"Content":"淡妆梳洗时。","BreakAfter":"1"},{"Content":"晓来清露滴。"},{"Content":"一一金杯侧。"},{"Content":"插向绿云鬟。"},{"Content":"便随王母仙。"}]},{"Id":198279,"GroupIndex":3,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rank":0,"Title":{"Content":"菩萨蛮"},"TuneId":{"Id":105},"Clauses":[{"Content":"人人尽道黄葵淡。"},{"Content":"侬家解说黄葵艳。"},{"Content":"可喜万般宜。"},{"Content":"不劳朱粉施。","BreakAfter":"1"},{"Content":"摘承金盏酒。"},{"Content":"劝我千长寿。"},{"Content":"擎作女真冠。"},{"Content":"试伊娇面看。"}]},{"Id":198280,"GroupIndex":4,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rank":0,"Title":{"Content":"菩萨蛮"},"TuneId":{"Id":105},"Clauses":[{"Content":"高梧叶下秋光晚。"},{"Content":"珍丛化出黄金盏。"},{"Content":"还似去年时。"},{"Content":"傍阑三两枝。","BreakAfter":"1"},{"Content":"人情须耐久。"},{"Content":"花面长依旧。"},{"Content":"莫学蜜蜂儿。"},{"Content":"等闲悠飏飞。"}]},{"Id":198230,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"23","Rank":0,"Title":{"Content":"秋蕊香"},"TuneId":{"Id":152},"Clauses":[{"Content":"梅蕊雪残香瘦。"},{"Content":"罗幕轻寒微透。"},{"Content":"多情只是春杨柳。"},{"Content":"占断可怜时候。","BreakAfter":"1"},{"Content":"萧娘劝我杯中酒。"},{"Content":"翻红袖。"},{"Content":"金乌玉兔长飞走。"},{"Content":"争得朱颜依旧。"}]},{"Id":198231,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"5","Rank":0,"Title":{"Content":"秋蕊香"},"TuneId":{"Id":152},"Clauses":[{"Content":"向晓雪花呈瑞。"},{"Content":"飞遍玉城瑶砌。"},{"Content":"何人剪碎天边桂。"},{"Content":"散作瑶田琼蕊。","BreakAfter":"1"},{"Content":"萧娘敛尽双蛾翠。"},{"Content":"回香袂。"},{"Content":"今朝有酒今朝醉。"},{"Content":"遮莫更长无睡。"}]},{"Id":198227,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"庚","Rank":0,"Title":{"Content":"相思儿令"},"TuneId":{"Id":140},"Clauses":[{"Content":"昨日探春消息，"},{"Content":"湖上绿波平。"},{"Content":"无奈绕堤芳草，"},{"Content":"还向旧痕生。","BreakAfter":"1"},{"Content":"有酒且醉瑶觥。"},{"Content":"更何妨檀板新声。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"谁教杨柳千丝，"},{"Content":"就中牵系人情。"}]},{"Id":198229,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"歌","Rank":0,"Title":{"Content":"相思儿令"},"TuneId":{"Id":140},"Clauses":[{"Content":"春色渐芳菲也，"},{"Content":"迟日满烟波。"},{"Content":"正好艳阳时节，"},{"Content":"争奈落花何。","BreakAfter":"1"},{"Content":"醉来拟恣狂歌。"},{"Content":"断肠中赢得愁多。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"不如归傍纱窗，"},{"Content":"有人重画双蛾。"}]},{"Id":198225,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"20","Rank":0,"Title":{"Content":"临江仙"},"TuneId":{"Id":246},"Clauses":[{"Content":"资善堂中三十载，"},{"Content":"旧人多是凋零。"},{"Content":"与君相见最伤情。"},{"Content":"一尊如旧，"},{"Content":"聊且话平生。","BreakAfter":"1"},{"Content":"此别要知须强饮，"},{"Content":"雪残风细长亭。"},{"Content":"待君归觐九重城。"},{"Content":"帝宸思旧，"},{"Content":"朝夕奉皇明。"}]},{"Id":198294,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"30","Rank":0,"Title":{"Content":"睿恩新"},"TuneId":{"Id":264},"Clauses":[{"Content":"芙蓉一朵霜秋色。"},{"Content":"迎晓露依依先拆。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"似佳人独立倾城，","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"傍朱槛暗传消息。","Comments":[{"Content":"、","Type":"Text","Index":3}],"BreakAfter":"1"},{"Content":"静对西风脉脉。"},{"Content":"金蕊绽粉红如滴。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"向兰堂莫厌重新，","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"免清夜微寒渐逼。","Comments":[{"Content":"、","Type":"Text","Index":3}]}]},{"Id":198295,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"5","Rank":0,"Title":{"Content":"睿恩新"},"TuneId":{"Id":264},"Clauses":[{"Content":"红丝一曲傍阶砌。"},{"Content":"珠露下独呈纤丽。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"剪鲛绡碎作香英，","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"分彩线簇成娇蕊。","Comments":[{"Content":"、","Type":"Text","Index":3}],"BreakAfter":"1"},{"Content":"向晚群花新悴。"},{"Content":"放朵朵似延秋意。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"待佳人插向钗头，","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"更袅袅低临凤髻。","Comments":[{"Content":"、","Type":"Text","Index":3}]}]},{"Id":198256,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"31","Rank":0,"Title":{"Content":"望汉月/忆汉月"},"TuneId":{"Id":189},"Clauses":[{"Content":"千缕万条堪结。"},{"Content":"占断好风良月。"},{"Content":"谢娘春晚先多愁，"},{"Content":"更撩乱絮飞如雪。","Comments":[{"Content":"、","Type":"Text","Index":3}],"BreakAfter":"1"},{"Content":"短亭相送处，"},{"Content":"长忆得醉中攀折。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"年年岁岁好时节。"},{"Content":"怎奈尚有人离别。","Comments":[{"Content":"、","Type":"Text","Index":3}]}]},{"Id":198193,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rank":0,"Title":{"Content":"玉堂春"},"TuneId":{"Id":322},"Clauses":[{"Content":"帝城春暖。"},{"Content":"御柳暗遮空苑。"},{"Content":"海燕双双，"},{"Content":"拂飏帘栊。"},{"Content":"女伴相携共绕林间路，","Comments":[{"Content":"、","Type":"Text","Index":4}]},{"Content":"折得樱桃插髻红。","BreakAfter":"1"},{"Content":"昨夜临明微雨，"},{"Content":"新英遍旧丛。"},{"Content":"宝马香车欲傍西池看，","Comments":[{"Content":"、","Type":"Text","Index":4}]},{"Content":"触处杨花满袖风。"}]},{"Id":198192,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rank":0,"Title":{"Content":"玉堂春"},"TuneId":{"Id":322},"Clauses":[{"Content":"后园春早。"},{"Content":"残雪尚濛烟草。"},{"Content":"数树寒梅，"},{"Content":"欲绽香英。"},{"Content":"小妹无端折尽钗头朵，","Comments":[{"Content":"、","Type":"Text","Index":4}]},{"Content":"满把金尊细细倾。","BreakAfter":"1"},{"Content":"忆得往年同伴，"},{"Content":"沈吟无限情。"},{"Content":"恼乱东风莫便吹零落，","Comments":[{"Content":"、","Type":"Text","Index":4}]},{"Content":"惜取芳菲眼下明。"}]},{"Id":198194,"GroupIndex":3,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rank":0,"Title":{"Content":"玉堂春"},"TuneId":{"Id":322},"Clauses":[{"Content":"斗城池馆。"},{"Content":"二月风和烟暖。"},{"Content":"绣户珠帘，"},{"Content":"日影初长。"},{"Content":"玉辔金鞍缭绕沙堤路，","Comments":[{"Content":"、","Type":"Text","Index":4}]},{"Content":"几处行人映绿杨。","BreakAfter":"1"},{"Content":"小槛朱阑回倚，"},{"Content":"千花浓露香。"},{"Content":"脆管清弦欲奏新翻曲，","Comments":[{"Content":"、","Type":"Text","Index":4}]},{"Content":"依约林间坐夕阳。"}]},{"Id":198247,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"庚","Rank":0,"Title":{"Content":"破阵子 春景"},"TuneId":{"Id":326},"Clauses":[{"Content":"燕子来时新社，"},{"Content":"梨花落后清明。"},{"Content":"池上碧苔三四点，"},{"Content":"叶底黄鹂一两声，"},{"Content":"日长飞絮轻。","BreakAfter":"1"},{"Content":"巧笑东邻女伴，"},{"Content":"采桑径里逢迎。"},{"Content":"疑怪昨宵春梦好，"},{"Content":"元是今朝斗草赢，"},{"Content":"笑从双脸生。"}],"Comments":[{"Content":"此词通过清明时节的一个生活片断，反映出少女身上显示的青春活力，充满着一种欢乐的气氛。全词纯用白描，笔调活泼，风格朴实，形象生动，展示了少女的纯洁心灵。<br />二十四节气，春分连接清明，正是一年春光最堪留恋的时节。春已中分，新燕将至，此时恰值社日也将到来，古人称燕子为社燕，以为它常是春社来，秋社去。词人所说的新社，指的即是春社了。那时每年有春秋两个社日 ，而尤重春社 ，邻里聚会，酒食分餐 ，赛会欢腾 ，极一时一地之盛 。闺中少女 ，也“放”了“假”，正所谓“问知社日停针线”，连女红也是可以放下的，呼姊唤妹，门外游玩。词篇开头一句，其精神全在于此。<br />按民族“花历”，又有二十四番花信风，自小寒至谷雨 ，每五日为一花信，每节应三信有三芳开放；按春分节的三信，正是海棠花、梨花、木兰花。梨花落后，清明在望。词人写时序风物，一丝不苟。当此季节，气息芳润，池畔苔生鲜翠，林丛鹂啭清音。春光已是苒苒而近晚了，神情更在言外。清明的花信三番又应在何处？那就是桐花、麦花与柳花。所以词人接着写的就是“日长飞絮轻”。古有诗云：“落尽海棠飞尽絮，困人天气日初长”，可以合看。文学评论家于此必曰：写景；状物！而不知时序推迁，触人思绪也。<br />当此良辰佳节之际，则有二少女，出现于词人笔下：在采桑的路上，她们正好遇着；一见面，西邻女就问东邻女：“你怎么今天这么高兴？夜里做了什么好梦了吧！快说来听听！”东邻笑道：“莫胡说！人家刚才和她们斗草来着，得了彩头呢！”<br />“笑从双脸生”五字，再难另找一句更好的写少女笑吟吟的句子来替换。何谓双脸？盖脸本从眼际得义 ，而非后人混指“嘴巴”也。故此词，美在情景，其用笔明丽清婉 ，秀润无伦，而别无奇特可寻之迹；迨至末句，收足全篇，神理尽出，天时人事，物态心情，全归于此。","IsComment":false}]}],"Count":360,"PageNo":11,"PageSize":20}