:"知子当元老，"},{"Content":"为臣饯二疏。","Comments":[{"Content":"二疏","Type":"AllusionKey","Index":5}]},{"Content":"执圭期已迫，"},{"Content":"捧膳步宁徐。","Comments":[{"Content":"捧膳","Type":"AllusionKey","Index":2}]},{"Content":"而我诚愚者，"},{"Content":"夫君岂病诸。"},{"Content":"探题多决胜，"},{"Content":"馔玉每分馀。"},{"Content":"荣比成功后，"},{"Content":"恩同造化初。"},{"Content":"甑尘方欲合，","Comments":[{"Content":"甑尘","Type":"AllusionKey","Index":2}]},{"Content":"笼翮或将舒。"},{"Content":"榆荚钱难比，"},{"Content":"杨花雪不如。"},{"Content":"明朝古堤路，"},{"Content":"心断玉人车。","Comments":[{"Content":"玉人车","Type":"AllusionKey","Index":5}]}]},{"Id":11346,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"东潭宴饯河南赵少府"},"Clauses":[{"Content":"十载奉戎轩，"},{"Content":"日闻君子言。"},{"Content":"方将贺荣爵，"},{"Content":"遽乃怆离尊。"},{"Content":"岸转台阁丽，"},{"Content":"潭清弦管繁。"},{"Content":"松篁难晦节，"},{"Content":"雨露不私恩。"},{"Content":"坐使吏相勉，"},{"Content":"居为儒所尊。"},{"Content":"可怜桃李树，"},{"Content":"先发信陵门。"}]},{"Id":11376,"Allusions":[{"AllusionIndex":86,"AllusionKey":"二毛","SentenceIndex":8},{"AllusionIndex":4389,"AllusionKey":"嵇康","SentenceIndex":8}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"落第后归山下旧居留别刘起居昆季"},"Clauses":[{"Content":"寂寞过朝昏，"},{"Content":"沈忧岂易论。"},{"Content":"有时空卜命，"},{"Content":"无事可酬恩。"},{"Content":"寄食依邻里，"},{"Content":"成家望子孙。"},{"Content":"风尘知世路，"},{"Content":"衰贱到君门。"},{"Content":"醉里因多感，"},{"Content":"愁中欲强言。"},{"Content":"花林逢废井，"},{"Content":"战地识荒园。"},{"Content":"怅别临晴野，"},{"Content":"悲春上古原。"},{"Content":"鸟归山外树，"},{"Content":"人过水边村。"},{"Content":"潘岳方称老，"},{"Content":"嵇康本厌喧。","Comments":[{"Content":"嵇康","Type":"AllusionKey","Index":2}]},{"Content":"谁堪将落羽，"},{"Content":"回首仰飞翻。"}]},{"Id":11380,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"寒","Rank":0,"Title":{"Content":"虢州逢侯钊同寻南观因赠别","Comments":[{"Content":"时居停务","Type":"Text","Index":12}]},"Clauses":[{"Content":"相见翻惆怅，"},{"Content":"应怜责废官。"},{"Content":"过深惭禄在，"},{"Content":"识浅赖刑宽。"},{"Content":"独失耕农业，"},{"Content":"同思弟侄欢。"},{"Content":"衰贫羞客过，"},{"Content":"卑束会君难。"},{"Content":"放鹤登云壁，"},{"Content":"浇花绕石坛。"},{"Content":"兴远江海上，"},{"Content":"迹在是非端。"},{"Content":"林密风声细，","Comments":[{"Content":"一作结","Type":"Text","Index":5}]},{"Content":"山高雨色寒。","Comments":[{"Content":"一作气","Type":"Text","Index":4}]},{"Content":"悠然此中别，"},{"Content":"宾仆亦阑干。","Comments":[{"Content":"一作珊","Type":"Text","Index":5}]}]},{"Id":11360,"Allusions":[{"AllusionIndex":2047,"AllusionKey":"守四方","SentenceIndex":4},{"AllusionIndex":4314,"AllusionKey":"一面施罗","SentenceIndex":4}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"奉和圣制麟德殿宴百僚","Comments":[{"Content":"（一作奉和圣制麟德殿燕百僚应制）。（一作常衮诗）","Type":"Text","Index":10}]},"Clauses":[{"Content":"云辟御筵张，","Comments":[{"Content":"一作阙","Type":"Text","Index":2}]},{"Content":"山呼圣寿长。"},{"Content":"玉栏丰瑞草，"},{"Content":"金陛立神羊。"},{"Content":"台鼎资庖膳，"},{"Content":"天星奉酒浆。"},{"Content":"蛮夷陪作位，"},{"Content":"犀象舞成行。"},{"Content":"网已祛三面，"},{"Content":"歌因守四方。","Comments":[{"Content":"守四方","Type":"AllusionKey","Index":5}]},{"Content":"千秋不可极，"},{"Content":"花发满宫香。"}]},{"Id":11355,"Allusions":[{"AllusionIndex":5741,"AllusionKey":"谢公","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"东","Rank":0,"Title":{"Content":"和考功王员外杪秋忆终南旧居","Comments":[{"Content":"一作和大理裴卿杪秋忆山下旧居，一作岑参诗，一作常衮诗。","Type":"Text","Index":13}]},"Clauses":[{"Content":"静忆溪边宅，"},{"Content":"知君许谢公。","Comments":[{"Content":"谢公","Type":"AllusionKey","Index":5}]},{"Content":"晓霜凝耒耜，"},{"Content":"初日照梧桐。"},{"Content":"涧鼠喧藤蔓，"},{"Content":"山禽窜石丛。"},{"Content":"白云当岭雨，"},{"Content":"黄叶绕阶风。"},{"Content":"野果垂桥上，"},{"Content":"高泉落水中。"},{"Content":"欢荣来自间，"},{"Content":"羸贱赏曾同。","Comments":[{"Content":"一作往","Type":"Text","Index":3},{"Content":"一作难","Type":"Text","Index":4}]},{"Content":"月满珠藏海，"},{"Content":"天晴鹤在笼。"},{"Content":"馀阴如可寄，"},{"Content":"愿得隐墙东。"}]},{"Id":11378,"Allusions":[{"AllusionIndex":2751,"AllusionKey":"学稼","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"侵","Rank":0,"Title":{"Content":"詶李端长安寓居偶咏见寄","Comments":[{"Content":"一本作酬畅当寻嵩山麻道士见寄第二首","Type":"Text","Index":11}]},"Clauses":[{"Content":"自别前峰隐，"},{"Content":"同为外累侵。"},{"Content":"几年亲酒会，"},{"Content":"此日有僧寻。"},{"Content":"学稼功还弃，","Comments":[{"Content":"学稼","Type":"AllusionKey","Index":2}]},{"Content":"论边事亦沈。"},{"Content":"众欢徒满目，"},{"Content":"专爱久离心。"},{"Content":"览鬓丝垂镜，"},{"Content":"弹琴泪洒襟。","Comments":[{"Content":"一作弦","Type":"Text","Index":2},{"Content":"一作琴","Type":"Text","Index":5}]},{"Content":"访田悲洛下，"},{"Content":"寄宅忆山阴。"},{"Content":"薄溜漫青石，"},{"Content":"横云架碧林。"},{"Content":"坏檐藤障密，"},{"Content":"衰菜棘篱深。","Comments":[{"Content":"一作楝","Type":"Text","Index":2}]},{"Content":"流散俱多故，"},{"Content":"忧伤并在今。"},{"Content":"唯当俟高躅，"},{"Content":"归止共抽簪。"}]},{"Id":11358,"Allusions":[{"AllusionIndex":531,"AllusionKey":"麟笔","SentenceIndex":4},{"AllusionIndex":1112,"AllusionKey":"蔡家残史","SentenceIndex":5},{"AllusionIndex":9542,"AllusionKey":"荀勖定汲书","SentenceIndex":5}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"和常舍人晚秋集贤院即事十二韵寄赠江南徐薛二侍郎"},"Clauses":[{"Content":"纶阁九华前，"},{"Content":"森沈䌽仗连。","Comments":[{"Content":"一作绮","Type":"Text","Index":3}]},{"Content":"洞门开旭日，"},{"Content":"清禁肃秋天。"},{"Content":"霜满朝容备，"},{"Content":"钟馀漏唱传。","Comments":[{"Content":"一作晓","Type":"Text","Index":3}]},{"Content":"摇珰陪羽扇，"},{"Content":"端弁入炉烟。"},{"Content":"麟笔删金篆，","Comments":[{"Content":"麟笔","Type":"AllusionKey","Index":2}]},{"Content":"龙绡荐玉编。"},{"Content":"汲书荀勖定，"},{"Content":"汉史蔡邕专。"},{"Content":"御竹潜通笋，"},{"Content":"宫池暗泻泉。"},{"Content":"乱丛萦弱蕙，"},{"Content":"堕叶洒枯莲。"},{"Content":"列署齐游日，"},{"Content":"重江并谪年。"},{"Content":"登封思议草，"},{"Content":"侍讲忆同筵。"},{"Content":"沧海风涛广，"},{"Content":"黝山瘴雨偏。"},{"Content":"唯应缄上宝，"},{"Content":"赠远一呈妍。"}]},{"Id":11354,"Allusions":[{"AllusionIndex":592,"AllusionKey":"宋玉伤怀","SentenceIndex":7},{"AllusionIndex":6610,"AllusionKey":"潘岳赋","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"和太常王卿立秋日即事"},"Clauses":[{"Content":"嵩高云日明，","Comments":[{"Content":"一作山","Type":"Text","Index":1}]},{"Content":"潘岳赋初成。","Comments":[{"Content":"潘岳赋","Type":"AllusionKey","Index":3}]},{"Content":"篱槿花无色，"},{"Content":"阶桐叶有声。"},{"Content":"绛纱垂簟净，"},{"Content":"白羽拂衣轻。"},{"Content":"鸿雁悲天远，"},{"Content":"龟鱼觉水清。"},{"Content":"别弦添楚思，"},{"Content":"牧马动边情。"},{"Content":"田雨农官问，"},{"Content":"林风苑吏惊。"},{"Content":"松篁终茂盛，","Comments":[{"Content":"一作盛茂","Type":"Text","Index":5}]},{"Content":"蓬艾自衰荣。"},{"Content":"遥仰凭轩夕，"},{"Content":"惟应喜宋生。","Comments":[{"Content":"一作善，一作苦","Type":"Text","Index":3}]}]},{"Id":11357,"Classes":["軍旅 要地"],"Allusions":[{"AllusionIndex":2263,"AllusionKey":"登龙客","SentenceIndex":5}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"删","Rank":0,"Title":{"Content":"和李使君三郎早秋城北亭楼宴崔司士因寄关中弟张评事时遇","Comments":[{"Content":"（一作和李使君三郎早秋城北亭宴崔司士因寄关中张评事）。（一作吕温诗）","Type":"Text","Index":26}]},"Clauses":[{"Content":"黄花古城路，"},{"Content":"上尽见青山。"},{"Content":"桑柘晴川口，"},{"Content":"牛羊落照间。"},{"Content":"野情随卷幔，"},{"Content":"军士隔重关。","Comments":[{"Content":"一作事","Type":"Text","Index":2}]},{"Content":"道合偏多赏，"},{"Content":"官微独不闲。"},{"Content":"鹤分琴久罢，"},{"Content":"书到雁应还。"},{"Content":"为谢登龙客，","Comments":[{"Content":"登龙客","Type":"AllusionKey","Index":5}]},{"Content":"琼枝寄一攀。"}]},{"Id":11359,"Allusions":[{"AllusionIndex":11,"AllusionKey":"鹏抟","SentenceIndex":4},{"AllusionIndex":3292,"AllusionKey":"龙卧","SentenceIndex":4},{"AllusionIndex":4764,"AllusionKey":"竹林期","SentenceIndex":5}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"奉和户曹叔夏夜寓直寄呈同曹诸公并见示"},"Clauses":[{"Content":"敛板捧清词，"},{"Content":"恭闻侍直时。"},{"Content":"暮尘归众骑，"},{"Content":"邃宇舍诸司。"},{"Content":"华月先灯至，"},{"Content":"清风与簟随。"},{"Content":"乱萤光熠熠，"},{"Content":"行树影离离。"},{"Content":"龙卧人宁识，","Comments":[{"Content":"龙卧","Type":"AllusionKey","Index":2}]},{"Content":"鹏抟鴳岂知。","Comments":[{"Content":"鹏抟","Type":"AllusionKey","Index":2}]},{"Content":"便因当五夜，"},{"Content":"敢望竹林期。","Comments":[{"Content":"竹林期","Type":"AllusionKey","Index":5}]}]},{"Id":11356,"Allusions":[{"AllusionIndex":7682,"AllusionKey":"梅生","SentenceIndex":7}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"鱼","Rank":0,"Title":{"Content":"和李中丞詶万年房署少府过汾州景云观因以寄上房与李早年同居此观"},"Clauses":[{"Content":"显晦澹无迹，"},{"Content":"贤哉常晏如。"},{"Content":"如何警孤鹤，"},{"Content":"忽乃传双鱼。"},{"Content":"叙以泉石旧，"},{"Content":"怅然风景馀。"},{"Content":"低回青油幕，"},{"Content":"梦寐白云居。"},{"Content":"玉洞桂香满，"},{"Content":"雪坛松影疏。"},{"Content":"沈思瞩仙侣，"},{"Content":"纾组正军书。"},{"Content":"积学早成道，"},{"Content":"感恩难遂初。"},{"Content":"梅生谅多感，","Comments":[{"Content":"梅生","Type":"AllusionKey","Index":2}]},{"Content":"归止岂吾庐。","Comments":[{"Content":"一作无","Type":"Text","Index":4}]}]},{"Id":11379,"Allusions":[{"AllusionIndex":2404,"AllusionKey":"东床","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"鱼","Rank":0,"Title":{"Content":"詶陈翃郎中冬至携柳郎窦郎归河中旧居见寄"},"Clauses":[{"Content":"三旬一休沐，"},{"Content":"清景满林庐。"},{"Content":"南郭群儒从，"},{"Content":"东床两客居。","Comments":[{"Content":"东床","Type":"AllusionKey","Index":2}]},{"Content":"烧烟浮雪野，","Comments":[{"Content":"一作晨","Type":"Text","Index":1}]},{"Content":"麦陇润冰渠。"},{"Content":"班白皆持酒，"},{"Content":"蓬茅尽有书。"},{"Content":"终期买寒渚，"},{"Content":"同此利蒲鱼。"}]},{"Id":11377,"Allusions":[{"AllusionIndex":3380,"AllusionKey":"弦惊","SentenceIndex":7}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"詶李叔度秋夜喜相遇因伤关东僚友丧逝见赠"},"Clauses":[{"Content":"寒月照秋城，"},{"Content":"秋风泉涧鸣。"},{"Content":"过时见兰蕙，"},{"Content":"独夜感衰荣。"},{"Content":"酒散同移疾，","Comments":[{"Content":"一作病","Type":"Text","Index":5}]},{"Content":"心悲似远行。"},{"Content":"以愚求作友，"},{"Content":"何德敢称兄。"},{"Content":"谷变波长急，"},{"Content":"松枯药未成。"},{"Content":"恐看新鬓色，"},{"Content":"怯问故人名。"},{"Content":"野泽云阴散，"},{"Content":"荒原日气生。"},{"Content":"羁飞本难定，"},{"Content":"非是恶弦惊。","Comments":[{"Content":"弦惊","Type":"AllusionKey","Index":5}]}]},{"Id":11345,"Classes":["軍旅 從軍"],"Allusions":[{"AllusionIndex":2482,"AllusionKey":"李陵","SentenceIndex":5}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"从军行","Comments":[{"Content":"一作李端诗，题云塞上。","Type":"Text","Index":3}]},"Clauses":[{"Content":"二十在边城，"},{"Content":"军中得勇名。"},{"Content":"卷旗收败马，","Comments":[{"Content":"一作争","Type":"Text","Index":3}]},{"Content":"占碛拥残兵。","Comments":[{"Content":"一作断","Type":"Text","Index":1},{"Content":"一作护","Type":"Text","Index":3}]},{"Content":"覆阵乌鸢起，"},{"Content":"烧山草木明。","Comments":[{"Content":"一作鸣","Type":"Text","Index":5}]},{"Content":"塞闲思远猎，"},{"Content":"师老厌分营。"},{"Content":"雪岭无人迹，"},{"Content":"冰河足雁声。"},{"Content":"李陵甘此没，","Comments":[{"Content":"李陵","Type":"AllusionKey","Index":2}]},{"Content":"惆怅汉公卿。"}],"Comments":[{"Book":"《诗人玉屑》","Content":"寒苦（“雪岭”二句下）。","IsComment":false,"FullPath":"《诗人玉屑》"},{"Book":"《唐诗解》","Content":"唐人赋从军，不述思家，必称许国。此独为叛将之辞，语讥藩镇，非泛然作也。“败马”、“残兵”，下字不苟。","IsComment":false,"FullPath":"《唐诗解》"},{"Book":"《唐诗选脉会通评林》","Content":"吴山民曰：“师老戒分营”，五字有用。结有深意。陆时雍曰：三、四语有气决。周珽曰：德宗之世，内多奸小，边臣解体，藩镇之祸日盛。此篇疑时有覆军之将，收其残兵啸聚边地，故允言述其意以为词。“思远猎”、“戒分营”确得战守之策。末以李陵甘没虏廷为况，见在朝公卿忌功，致边地有不还之将，深可“惆怅”者也。讥刺之词，甚于刑讨。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《诗源辨体》","Content":"论五言排律有《从军行》，在中唐颇为矫俊。","IsComment":false,"FullPath":"《诗源辨体》"},{"Book":"《唐诗笺要》","Content":"古题出以时调，唐数百年边陲矜张情状已尽毫端。“烧山草木鸣”，恰是中唐妙手。","IsComment":false,"FullPath":"《唐诗笺要》"}]},{"Id":11347,"Classes":["軍旅 將軍"],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"代员将军罢战后归旧里赠朔北故人","Comments":[{"Content":"一作地","Type":"Text","Index":13},{"Content":"一作常衮诗","Type":"Text","Index":15}]},"Clauses":[{"Content":"结发事疆场，"},{"Content":"全生俱到乡。","Comments":[{"Content":"一作到海","Type":"Text","Index":4}]},{"Content":"连云防铁岭，"},{"Content":"同日破渔阳。"},{"Content":"牧马胡天晚，","Comments":[{"Content":"一作晓","Type":"Text","Index":5}]},{"Content":"移军碛路长。"},{"Content":"枕戈眠古戍，"},{"Content":"吹角立繁霜。"},{"Content":"归老勋仍在，"},{"Content":"酬恩虏未亡。","Comments":[{"Content":"一作虑","Type":"Text","Index":3},{"Content":"一作忘","Type":"Text","Index":5}]},{"Content":"独行过邑里，","Comments":[{"Content":"一作愁","Type":"Text","Index":2}]},{"Content":"多病对农桑。"},{"Content":"雄剑依尘橐，","Comments":[{"Content":"一作席","Type":"Text","Index":5}]},{"Content":"阴符寄药囊。","Comments":[{"Content":"一作兵","Type":"Text","Index":1}]},{"Content":"空馀麾下将，","Comments":[{"Content":"一作士","Type":"Text","Index":5}]},{"Content":"犹逐羽林郎。"}],"Comments":[{"Book":"《唐诗选脉会通评林》","Content":"周珽曰：此诗与《从军行》篇，奇藻异想，如波翻浪叠，总厥体中之铿锵者。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"}]},{"Id":11350,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"阳","Rank":0,"Title":{"Content":"江北忆崔汶"},"Clauses":[{"Content":"夜问江西客，"},{"Content":"还知在楚乡。"},{"Content":"全身出部伍，"},{"Content":"尽室逐渔商。"},{"Content":"晴日游瓜步，"},{"Content":"新年对汉阳。"},{"Content":"月昏惊浪白，"},{"Content":"瘴起觉云黄。"},{"Content":"望岭家何处，"},{"Content":"登山泪几行。"},{"Content":"闽中传有雪，"},{"Content":"应且住南康。"}]},{"Id":11365,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"齐","Rank":0,"FirstClauseRhyme":"齐","Title":{"Content":"客舍苦雨即事寄钱起郎士元二员外"},"Clauses":[{"Content":"积雨暮凄凄，"},{"Content":"羁人状鸟栖。","Comments":[{"Content":"一作独自","Type":"Text","Index":4}]},{"Content":"响空宫树接，"},{"Content":"覆水野云低。"},{"Content":"穴蚁多随草，"},{"Content":"巢蜂半坠泥。"},{"Content":"绕池墙藓合，"},{"Content":"拥溜瓦松齐。"},{"Content":"旧圃平如海，"},{"Content":"新沟曲似溪。"},{"Content":"坏阑留众蝶，"},{"Content":"欹栋止群鸡。","Comments":[{"Content":"一作上","Type":"Text","Index":3}]},{"Content":"莠盛终无实，"},{"Content":"槎枯返有荑。","Comments":[{"Content":"一作遂","Type":"Text","Index":3}]},{"Content":"绿萍藏废井，"},{"Content":"黄叶隐危堤。"},{"Content":"闾里欢将绝，"},{"Content":"朝昏望亦迷。"},{"Content":"不知霄汉侣，"},{"Content":"何路可相携。","Comments":[{"Content":"一作事攀跻","Type":"Text","Index":5}]}]}],"Count":337,"PageNo":13,"PageSize":20}