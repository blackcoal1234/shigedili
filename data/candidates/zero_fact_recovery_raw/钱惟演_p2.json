{"Authors":{"Names":["钱惟演"],"AuthorIds":[34195],"Dynasties":["Song"]},"ShiData":[{"Id":203077,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"此夕"},"Clauses":[{"Content":"曲琼斜挂影沉沉，"},{"Content":"火齐屏风六曲深。"},{"Content":"春瘦已宽连理带，"},{"Content":"夜长谁有辟寒金。"},{"Content":"珠抛月浦空涵泪，"},{"Content":"琴怨兰堂漫寄心。","Comments":[{"Content":"王注本作到","Type":"Text","Index":2}]},{"Content":"碧玉可能攀贵德，"},{"Content":"阮郎追骑更骎骎。","Comments":[{"Content":"王注本作已","Type":"Text","Index":5}]}]},{"Id":203078,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"Title":{"Content":"灯夕寄献内翰虢略公"},"Clauses":[{"Content":"峣阙翚飞河汉傍，"},{"Content":"钩陈遥认赭袍光。"},{"Content":"九枝火树连金狄，","Comments":[{"Content":"《宋朝事实类苑》作千","Type":"Text","Index":1}]},{"Content":"万里霜轮上碧珰。"},{"Content":"匝地行车珠网细，"},{"Content":"照天晨燎紫沉香。"},{"Content":"祇闻鳌岭神仙客，"},{"Content":"再拜云边捧寿觞。"}]},{"Id":203083,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"怀旧居"},"Clauses":[{"Content":"武夷仙坛接里闾，","Comments":[{"Content":"四库本、王注本作祀","Type":"Text","Index":2}]},{"Content":"琴堂水阁半凌虚。"},{"Content":"竹林旧享铜盘食，"},{"Content":"门巷今容驷马车。"},{"Content":"楚国大言登宋玉，"},{"Content":"汉家答诏用相如。"},{"Content":"未知笳鼓归何日，"},{"Content":"空锁鳣庭春草疏。"}]},{"Id":203079,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"青","Rank":0,"FirstClauseRhyme":"青","Title":{"Content":"许洞归吴中"},"Clauses":[{"Content":"草薰风暖接长亭，"},{"Content":"一曲骊歌倒醁醽。"},{"Content":"怀古更投玄石赋，"},{"Content":"舣舟闲采紫茎萍。"},{"Content":"醉抛隋岸杨花白，"},{"Content":"吟过淮山桂树青。"},{"Content":"可使长离终铩羽，"},{"Content":"渊云辞藻掞天庭。"}]},{"Id":203091,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"苦热"},"Clauses":[{"Content":"赫日烘霞斗晓光，"},{"Content":"双文桃簟碧牙床。"},{"Content":"频倾蜜勺宁蠲渴，"},{"Content":"久捧冰壶未觉凉。"},{"Content":"雪岭却思随博望，"},{"Content":"风窗犹欲傲羲皇。"},{"Content":"更怜乳燕翻飞处，"},{"Content":"深入卢家白玉堂。"}]},{"Id":203096,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"送高学士知越"},"Clauses":[{"Content":"粉署为郎鬓雪侵，"},{"Content":"酒酣风驶惜分襟。"},{"Content":"云迷水馆春旗润，"},{"Content":"树绕山城暝角深。"},{"Content":"下担挂钩传密意，"},{"Content":"渡江桃叶听遗音。"},{"Content":"孤莺啼罢芳心歇，"},{"Content":"倦翼因君忆故林。","Comments":[{"Content":"同上书卷一一","Type":"Text","Index":7}]}]},{"Id":203100,"GroupIndex":2,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"送僧归护国寺"},"Clauses":[{"Content":"白道萦回彻上方，"},{"Content":"薰然风信满归航。"},{"Content":"五芝岩秀经行熟，"},{"Content":"千柰园深宴坐凉。"},{"Content":"吟久半轩移海日，"},{"Content":"定回诸壑散天香。"},{"Content":"忘年宝契由来厚，"},{"Content":"终谢繁缨捧钵囊。"}]},{"Id":203056,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"又赠一绝"},"Clauses":[{"Content":"唾露金销月似霜，"},{"Content":"云屏玉簟剩清光。"},{"Content":"不如谁有高唐梦，"},{"Content":"翠被华灯彻曙香。"}]},{"Id":203058,"GroupIndex":1,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"文","Title":{"Content":"戊申年七夕五绝"},"Clauses":[{"Content":"乌鹊飞来接断云，"},{"Content":"祇贪清浅渡星津。"},{"Content":"不知一夜支机石，"},{"Content":"却属乘槎上汉人。"}]},{"Id":203059,"GroupIndex":2,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"戊申年七夕五绝"},"Clauses":[{"Content":"玉露金河颢气凉，"},{"Content":"辛夷车转桂旗香。"},{"Content":"嫦娥可是多猜忌，"},{"Content":"不驻琼轮放夜长。"}]},{"Id":203060,"GroupIndex":3,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"戊申年七夕五绝"},"Clauses":[{"Content":"一岁佳期一夕过，"},{"Content":"羽旗云盖涉微波。"},{"Content":"明朝若寄相思泪，"},{"Content":"玉枕金茎得最多。"}]},{"Id":203061,"GroupIndex":4,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"文","Title":{"Content":"戊申年七夕五绝"},"Clauses":[{"Content":"青鸟当时下紫云，"},{"Content":"绮囊书秘露桃新。"},{"Content":"莫嫌夜半移床远，"},{"Content":"朱雀窗中别有人。"}]},{"Id":203057,"GroupIndex":5,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"戊申年七夕五绝"},"Clauses":[{"Content":"骊阜凌云对玉钩，"},{"Content":"千门高切绛河秋。"},{"Content":"欲闻天语犹嫌远，"},{"Content":"更结三层乞巧楼。"}]},{"Id":203063,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"赋竹寄李和文公"},"Clauses":[{"Content":"瘦玉萧萧伊水头，"},{"Content":"风宜清夜露宜秋。"},{"Content":"更教仙骥傍边立，"},{"Content":"尽是人间第一流。","Comments":[{"Content":"宋吴曾《能改斋漫录》卷一一","Type":"Text","Index":7}]}]},{"Id":203062,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"雪夕奉陪天台明照禅师拥炉闲话"},"Clauses":[{"Content":"藜烛薝香夜幄清，"},{"Content":"朔风窗际激飞英。"},{"Content":"凤梨鸱芋煨将熟，"},{"Content":"坐拥丰貂话赤城。","Comments":[{"Content":"以上同上书卷二","Type":"Text","Index":7}]}]},{"Id":203114,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"排律","TypeDetail":"WuPai","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"夜宴"},"Clauses":[{"Content":"昨夜宴南堂，"},{"Content":"华灯烛九光。"},{"Content":"削青争落笔，"},{"Content":"举白斗飞觞。"},{"Content":"祇觉辉裴玉，"},{"Content":"宁思梦谢塘。"},{"Content":"解烦多蜜勺，"},{"Content":"藉俎半兰芳。"},{"Content":"促席风弦怨，"},{"Content":"开帘月露凉。"},{"Content":"酡颜君莫诉，"},{"Content":"西北转银潢。"}]},{"Id":203115,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"排律","TypeDetail":"WuPai","Rhyme":"支","Rank":0,"Title":{"Content":"宣曲二十二韵"},"Clauses":[{"Content":"绛缕初分后，"},{"Content":"银镮未解时。"},{"Content":"已障纨扇笑，"},{"Content":"犹捧玉壶悲。"},{"Content":"乞巧长生殿，"},{"Content":"迎风太液池。"},{"Content":"雕屏涵火齐，"},{"Content":"宝帐隔琉璃。"},{"Content":"欲买词人赋，"},{"Content":"空传狎客诗。"},{"Content":"蔗浆销内热，"},{"Content":"琼蕊疗朝饥。"},{"Content":"绮蒂桃初熟，"},{"Content":"红心草欲披。"},{"Content":"凌波渡罗袜，"},{"Content":"向日翳华芝。"},{"Content":"素脸分丹柰，","Comments":[{"Content":"原作禁，据四库本、清注本、王注本改","Type":"Text","Index":5}]},{"Content":"香津滴紫梨。"},{"Content":"龙梭随振素，"},{"Content":"獭髓补凝脂。"},{"Content":"蓬饵重阳节，"},{"Content":"金针七夕期。"},{"Content":"玉膏尝滵溢，"},{"Content":"翠盖逐葳蕤。"},{"Content":"弦急哀随指，"},{"Content":"歌长恨入眉。"},{"Content":"青鸾惟有舞，"},{"Content":"赤凤可能疑。"},{"Content":"下蔡迷还易，"},{"Content":"平阳破未知。"},{"Content":"髻高钗自坠，"},{"Content":"腰细佩长垂。"},{"Content":"出恐严钟晚，","Comments":[{"Content":"四库本、王注本作妆","Type":"Text","Index":4}]},{"Content":"归嫌钿幰迟。"},{"Content":"辘轳惊晓梦，","Comments":[{"Content":"原作晚，据清注本、王注本改","Type":"Text","Index":4}]},{"Content":"鹦鹉漏春思。"},{"Content":"魂怨惟愁断，"},{"Content":"肠柔已自危。","Comments":[{"Content":"清注本作祇","Type":"Text","Index":3}]},{"Content":"璧珰萤影度，"},{"Content":"琼户藓花滋。"},{"Content":"掩鼻谗难诉，"},{"Content":"披图悔岂追。"},{"Content":"祇应金带枕，"},{"Content":"聊为达微辞。","Comments":[{"Content":"清注本作一","Type":"Text","Index":1}]}]},{"Id":203113,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"排律","TypeDetail":"WuPai","Rhyme":"阳","Rank":0,"Title":{"Content":"别墅"},"Clauses":[{"Content":"别馆斗城傍，"},{"Content":"斜轩映曲房。"},{"Content":"苍头冠绿帻，"},{"Content":"中妇织流黄。"},{"Content":"复道登平乐，"},{"Content":"期门集未央。"},{"Content":"意钱梁冀宅，"},{"Content":"挟瑟莫愁堂。"},{"Content":"走马章台柳，"},{"Content":"停车陌上桑。"},{"Content":"彀弓随宝障，"},{"Content":"投辖付银床。"},{"Content":"出戴繁星急，"},{"Content":"归冲细雨忙。"},{"Content":"曾过阿君宿，"},{"Content":"醉舞起跳梁。"}]},{"Id":203119,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"排律","TypeDetail":"WuPai","Rhyme":"萧","Rank":0,"FirstClauseRhyme":"萧","Title":{"Content":"荷花"},"Clauses":[{"Content":"水阔雨萧萧，"},{"Content":"风微影自摇。"},{"Content":"徐娘羞半面，"},{"Content":"楚女妒纤腰。"},{"Content":"别恨抛深浦，"},{"Content":"遗香逐画桡。"},{"Content":"华灯连雾夕，"},{"Content":"钿合映霞朝。"},{"Content":"泪有鲛人见，"},{"Content":"魂须宋玉招。"},{"Content":"凌波终未渡，"},{"Content":"疑待鹊为桥。"}