{"Authors":{"Names":["晏几道"],"AuthorIds":[27313],"Dynasties":["Song"]},"ShiData":[{"Id":197987,"GroupIndex":1,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"11","Rank":0,"Title":{"Content":"踏莎行"},"TuneId":{"Id":295},"Clauses":[{"Content":"柳上烟归，"},{"Content":"池南雪尽，"},{"Content":"东风渐有繁华信。"},{"Content":"花开花谢蝶应知，"},{"Content":"春来春去莺能问。","BreakAfter":"1"},{"Content":"梦意犹疑，"},{"Content":"心期欲近，"},{"Content":"云笺字字萦方寸。"},{"Content":"宿妆曾比杏腮红，"},{"Content":"忆人细把香英认。"}]},{"Id":197988,"GroupIndex":2,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"21","Rank":0,"Title":{"Content":"踏莎行"},"TuneId":{"Id":295},"Clauses":[{"Content":"宿雨收尘，"},{"Content":"朝霞破暝，"},{"Content":"风光暗许花期定。"},{"Content":"玉人呵手试妆时，"},{"Content":"粉香帘幕阴阴静。","BreakAfter":"1"},{"Content":"斜雁朱弦，"},{"Content":"孤鸾绿镜，"},{"Content":"伤春误了寻芳信。"},{"Content":"去年今日杏墙西，"},{"Content":"啼莺唤得闲愁醒。"}]},{"Id":197989,"GroupIndex":3,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"5","Rank":0,"Title":{"Content":"踏莎行"},"TuneId":{"Id":295},"Clauses":[{"Content":"绿径穿花，"},{"Content":"红楼压水，"},{"Content":"寻芳误到蓬莱地。"},{"Content":"玉颜人是蕊珠仙，"},{"Content":"相逢展尽双蛾翠。","BreakAfter":"1"},{"Content":"梦草闲眠，"},{"Content":"流觞浅醉，"},{"Content":"一春总见瀛洲事。"},{"Content":"别来双燕又西飞，"},{"Content":"无端不寄相思字。"}]},{"Id":197990,"GroupIndex":4,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"1","Rank":0,"Title":{"Content":"踏莎行"},"TuneId":{"Id":295},"Clauses":[{"Content":"雪尽寒轻，"},{"Content":"月斜烟重，"},{"Content":"清欢犹记前时共。"},{"Content":"迎风朱户背灯开，"},{"Content":"拂檐花影侵帘动。","BreakAfter":"1"},{"Content":"绣枕双鸳，"},{"Content":"香苞翠凤，"},{"Content":"从来往事都如梦。"},{"Content":"伤心最是醉归时，"},{"Content":"眼前少个人人送。"}]},{"Id":197942,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"13","Rank":0,"Title":{"Content":"清商怨"},"TuneId":{"Id":103},"Clauses":[{"Content":"庭花香信尚浅，"},{"Content":"最玉楼先暖。"},{"Content":"梦觉春衾，"},{"Content":"江南依旧远。","BreakAfter":"1"},{"Content":"回纹锦字暗剪，"},{"Content":"谩寄与也应归晚。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"要问相思，"},{"Content":"天涯犹自短。"}]},{"Id":197916,"GroupIndex":1,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"5","Rank":0,"Title":{"Content":"留春令"},"TuneId":{"Id":192},"Clauses":[{"Content":"画屏天畔，"},{"Content":"梦回依约，"},{"Content":"十洲云水。"},{"Content":"手撚红笺寄人书，"},{"Content":"写无限伤春事。","Comments":[{"Content":"、","Type":"Text","Index":3}],"BreakAfter":"1"},{"Content":"别浦高楼曾漫倚，"},{"Content":"对江南千里。"},{"Content":"楼下分流水声中，"},{"Content":"有当日凭高泪。","Comments":[{"Content":"、","Type":"Text","Index":3}]}],"Comments":[{"Content":"这首词写一个女子伤春怀人的情思。杨慎在《词品》中说，晏几道此词全用晁元忠诗：“安得龙湖潮，驾回安河水 ，水从楼前来 ，中有美人泪。人生高唐观，有情何能己 ！”词的上片说梦中追寻到天边，到了人迹罕至的海上十洲，醒来把无限的情思都写到了信中 。起首三句，想象奇特而瑰丽，落笔颇为不俗：近在咫尺的屏风，在迷离中居然看成像天般遥远。一实一虚，一近一远，通过这强烈的对比，表达了对情人远别的怀思 。“十洲 ”，是仙人所居、人迹罕至之地。托名为汉东方朔撰的《十洲记》载，在八方大海中 ，有祖洲、瀛洲、玄洲、炎洲、长洲、元洲 、流洲、生洲、凤麟洲、聚窟洲。词中例以美人为仙，美人所居为仙境，暗指所思念的人的居处。十洲是仙灵境界 ，凡人无法到达 ，只有在梦中才能前往。梦醒后 ，看到屏风上画着的山山水水，犹疑是梦中所历，更写出梦境的虚幻和醒后的怅惘，真是妙有远神，令人掩抑低徊不已。歇拍两句写词人手执着写有无限伤春心事的红笺准备寄给美人书信，此二句把寄人的红笺与十洲的残梦联系起来 ，创造出情景交融的境界，表现了词人苦恋的情怀，具有很强的艺术感染力。<br />下片是对往事的回忆，写抒情主人公曾无聊地独倚高楼——正在两人分别的水边，面对着辽阔的千里江南之地。这里所写的不是昔时相聚的欢娱，而是别后的思念，脱出词家惯常用的上下片对比的手法，感情便越觉沉厚 。结拍两句，进一步写倚楼时的怀思。<br />此处着意在“分流”二字。古乐府《白头吟》：“蹀躞御沟上，沟水东西流 。”以水东西分流，喻人们一别之后不再相见。人倚高楼，念远之泪却滴向楼下分流的水中，将离愁别绪与怀人立情抒写得深婉曲折而又缠绵悱恻，具有感人至深的艺术力量。","IsComment":false}]},{"Id":197915,"GroupIndex":2,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"5","Rank":0,"Title":{"Content":"留春令"},"TuneId":{"Id":192},"Clauses":[{"Content":"采莲舟上，"},{"Content":"夜来陡觉，"},{"Content":"十分秋意。"},{"Content":"懊恼寒花暂时香，"},{"Content":"与情浅人相似。","Comments":[{"Content":"、","Type":"Text","Index":3}],"BreakAfter":"1"},{"Content":"玉蕊歌清招晚醉，"},{"Content":"恋小桥风细。"},{"Content":"水湿红裙酒初消，"},{"Content":"又记得南溪事。","Comments":[{"Content":"、","Type":"Text","Index":3}]}]},{"Id":197917,"GroupIndex":3,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"翰","Rank":0,"Title":{"Content":"留春令"},"TuneId":{"Id":192},"Clauses":[{"Content":"海棠风横，"},{"Content":"醉中吹落，"},{"Content":"香红强半。"},{"Content":"小粉多情怨杨花，"},{"Content":"仔细把残春看。","Comments":[{"Content":"、","Type":"Text","Index":3}],"BreakAfter":"1"},{"Content":"一抹浓檀秋水畔，"},{"Content":"缕金衣新换。"},{"Content":"鹦鹉杯深艳歌迟，"},{"Content":"更莫放人肠断。","Comments":[{"Content":"、","Type":"Text","Index":3}]}]},{"Id":197880,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"30","Rank":0,"Title":{"Content":"思远人"},"TuneId":{"Id":224},"Clauses":[{"Content":"红叶黄花秋意晚，"},{"Content":"千里念行客。"},{"Content":"飞云过尽，"},{"Content":"归鸿无信，"},{"Content":"何处寄书得。"},{"Content":"泪弹不尽临窗滴，"},{"Content":"就砚旋研墨。"},{"Content":"渐写到别来，"},{"Content":"此情深处，"},{"Content":"红笺为无色。"}],"Comments":[{"Content":"此词就“寄书”二字发挥，写以泪研墨，泪滴红笺，情愈悲而泪愈多，竟至笺上的红字褪尽。用夸张的手法表情达意，写出感情发展的历程，是此词艺术上的突出特点。<br />起首两句，写女主人公因悲秋而怀远，既点明时令、环境，又点染烘托主题。一“晚”字，暗示别离之久，“千里”，点明相隔之远。两句交代了时间和空间，给下文留了铺展的余地。“飞云过尽，归鸿无信”两句是客 ；“何处寄书得”一句是主。鸿雁，随着天际的浮云，自北向南飞去。闺中人遥望渺渺长空，盼望归鸿带来游子的音信。“过尽”，已极写其失望之意了，由于“无信 ”，便不知游子而今所在，自己纵欲寄书也无从寄与。<br />过片词意陡转：弹洒不尽的那两行珠泪，还当窗滴下来，并滴进了砚台中，就用它来研磨香墨。下片出人意表，另开思路。正因无处寄书，更增悲感而弹泪，泪弹不尽，而临窗滴下，有砚承泪，遂以研墨作书 。故而虽为转折，却也顺理成章了 。明知书不得寄 ，仍是要写，一片痴情 ，惘惘不甘，用意尤其深厚。语本孟郊《归信吟 》“泪墨洒为书”一句，而情真意足，写出小儿女的情态，巧而不纤，较诸“和泪濡墨”的套语自有深浅真伪之别 。“渐写到别来，此情深处，红笺为无色 。”收语写闺人此时作书，纯是自我遣怀 ，她把自己全部的内心本质力量投进其中，感情也升华到物我两忘的境界。对此，陈匪石《宋词举》有一段极为透辟的分析：“‘渐’字极宛转，却激切。‘写到别来、此情深处’，墨中纸上，情与泪粘合为一，不辨何者为泪，何者为情。故不谓笺色之红因泪而淡，却谓红笺之色因情深而无。”无论是泪、墨、红笺，都融进闺人的深情之中，物与情已浑然一体。<br />这首词与小晏惯常的“情溢词外，未能意蕴其中”这一风格不同 。全词用笔甚曲 ，下字甚丽，宛转入微，味深意厚，堪称小晏词中别出机杼的异调。","IsComment":false}]},{"Id":197777,"GroupIndex":1,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"阳","Rank":0,"Title":{"Content":"风入松"},"TuneId":{"Id":389},"Clauses":[{"Content":"柳阴庭院杏梢墙。"},{"Content":"依旧巫阳。"},{"Content":"凤箫已远青楼在，"},{"Content":"水沈难复暖前香。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"临镜舞鸾离照，"},{"Content":"倚筝飞雁辞行。","BreakAfter":"1"},{"Content":"坠鞭人意自凄凉。"},{"Content":"泪眼回肠。"},{"Content":"断云残雨当年事，"},{"Content":"到如今几处难忘。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"两袖晓风花陌，"},{"Content":"一帘夜月兰堂。"}]},{"Id":197776,"GroupIndex":2,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"0","Rank":0,"Title":{"Content":"风入松"},"TuneId":{"Id":389},"Clauses":[{"Content":"心心念念忆相逢。"},{"Content":"别恨谁浓。"},{"Content":"就中懊恼难拚处，"},{"Content":"是擘钗分钿匆匆。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"却似桃源路失，"},{"Content":"落花空记前踪。","BreakAfter":"1"},{"Content":"彩笺书尽浣溪红。"},{"Content":"深意难通。"},{"Content":"强欢殢酒图消遣，"},{"Content":"到醒来愁闷还重。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"若是初心未改，"},{"Content":"多应此意须同。"}]},{"Id":197971,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"13","Rank":0,"Title":{"Content":"碧牡丹"},"TuneId":{"Id":387},"Clauses":[{"Content":"翠袖疏纨扇。"},{"Content":"凉叶催归燕。"},{"Content":"一夜西风，"},{"Content":"几处伤高怀远。"},{"Content":"细菊枝头，"},{"Content":"开嫩香还遍。"},{"Content":"月痕依旧庭院。","BreakAfter":"1"},{"Content":"事何限。"},{"Content":"怅望秋意晚。"},{"Content":"离人鬓华将换。"},{"Content":"静忆天涯，"},{"Content":"路比此情犹短。"},{"Content":"试约鸾笺，"},{"Content":"传素期良愿。"},{"Content":"南云应有新雁。"}]},{"Id":197888,"GroupIndex":1,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"23","Rank":0,"Title":{"Content":"秋蕊香"},"TuneId":{"Id":152},"Clauses":[{"Content":"池苑清阴欲就，"},{"Content":"还傍送春时候。"},{"Content":"眼中人去难欢偶，"},{"Content":"谁共一杯芳酒。","BreakAfter":"1"},{"Content":"朱阑碧砌皆如旧，"},{"Content":"记携手。"},{"Content":"有情不管别离久，"},{"Content":"情在相逢终有。"}]},{"Id":197887,"GroupIndex":2,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"15","Rank":0,"Title":{"Content":"秋蕊香"},"TuneId":{"Id":152},"Clauses":[{"Content":"歌彻郎君秋草，"},{"Content":"别恨远山眉小。"},{"Content":"无情莫把多情恼，"},{"Content":"第一归来须早。","BreakAfter":"1"},{"Content":"红尘自古长安道，"},{"Content":"故人少。"},{"Content":"相思不比相逢好，"},{"Content":"此别朱颜应老。"}]},{"Id":197775,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"支","Rank":0,"Title":{"Content":"长相思"},"TuneId":{"Id":67},"Clauses":[{"Content":"长相思，"},{"Content":"长相思，"},{"Content":"若问相思甚了期。"},{"Content":"除非相见时。","BreakAfter":"1"},{"Content":"长相思，"},{"Content":"长相思，"},{"Content":"欲把相思说似谁。"},{"Content":"浅情人不知。"}],"Comments":[{"Content":"此词纯用民歌形式，上下片均以“长相思”迭起，上片言只有相见才得终了相思之情；下片言由于不得相见，相思之情无处诉说，以浅情人不能理解自己的心情反衬自己一往而情深。<br />词的上片，一气流出，情溢乎辞，不加修饰。“若问”两句，自问自答，痴人痴语。要说“相见”是解决“相思”的唯一办法 ，这纯是痴语，痴心，可是，小晏却认认真真地把它说了出来，正是如黄庭坚《小山词序》所云“其痴亦自绝人”。<br />结句非同凡响，抒写了比相思不相见更大的悲哀。“说似谁 ”，犹言说与谁、向谁说。纵使把相思之情说了出来，那浅情的人儿终是不能体会。浅情是深情的对面，多情的小晏却总是碰到那样的人，可是，当那人交暂情浅，别后又杳无音信，辜负了自己的刻骨相思时，词人依然是一往情深，不疑不恨，只是独自伤心而已。下片四句，以“浅情人”反衬小晏相思苦恋之情。<br />此词为作者词中别调，语极浅近，情极深挚，在朴直中自饶婉曲之致，缠绵往复，姿态多变，回肠荡气，音节尤美。","IsComment":false}]},{"Id":197922,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"30","Rank":0,"Title":{"Content":"望仙楼"},"TuneId":{"Id":153},"Clauses":[{"Content":"小春花信日边来，"},{"Content":"未上江梅先坼。"},{"Content":"今岁东君消息，"},{"Content":"还自南枝得。","BreakAfter":"1"},{"Content":"素衣染尽天香，"},{"Content":"玉酒添成国色。"},{"Content":"一自故溪疏隔，"},{"Content":"肠断长相忆。"}]},{"Id":197760,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"13","Rank":0,"Title":{"Content":"凤孤飞"},"TuneId":{"Id":180},"Clauses":[{"Content":"一曲画楼钟动，"},{"Content":"宛转歌声缓。"},{"Content":"绮席飞尘满，"},{"Content":"更少待金蕉暖。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"细雨轻寒今夜短，"},{"Content":"依前是粉墙别馆。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"端的欢期应未晚，"},{"Content":"奈归云难管。"}]},{"Id":197992,"GroupIndex":1,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"31","Rank":0,"Title":{"Content":"醉落魄"},"TuneId":{"Id":288},"Clauses":[{"Content":"满街斜月，"},{"Content":"垂鞭自唱阳关彻。"},{"Content":"断尽柔肠思归切，"},{"Content":"都为人人，"},{"Content":"不许多时别。","BreakAfter":"1"},{"Content":"南桥昨夜风吹雪，"},{"Content":"短长亭下征尘歇。"},{"Content":"归时定有梅堪折。"},{"Content":"欲把离愁，"},{"Content":"细捻花枝说。"}]},{"Id":197991,"GroupIndex":2,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"屑","Rank":0,"Title":{"Content":"醉落魄"},"TuneId":{"Id":288},"Clauses":[{"Content":"鸾孤月缺，"},{"Content":"两春惆怅音尘绝。"},{"Content":"如今若负当时节，"},{"Content":"信道欢缘，"},{"Content":"枉向衣襟结。","BreakAfter":"1"},{"Content":"若问相思何处歇，"},{"Content":"相逢便是相思彻。"},{"Content":"尽饶别后留心别，"},{"Content":"也待相逢，"},{"Content":"细把相思说。"}]},{"Id":197994,"GroupIndex":3,"Dynasty":"北宋","Author":"晏几道","AuthorId":27313,"Type":"词","TypeDetail":"Ci","Rhyme":"药","Rank":0,"Title":{"Content":"醉落魄/一斛珠"},"TuneId":{"Id":288},"Clauses":[{"Content":"天教命薄。"},{"Content":"青楼占得声名恶。"},{"Content":"对酒当歌寻思著。"},{"Content":"月户星窗，"},{"Content":"多少旧期约。","BreakAfter":"1"},{"Content":"相逢细语初心错。"},{"Content":"两行红泪尊前落。"},{"Content":"霞觞且共深深酌。"},{"Content":"恼乱春宵，"},{"Content":"翠被都闲却。"}]}],"Count":264,"PageNo":10,"PageSize":20}