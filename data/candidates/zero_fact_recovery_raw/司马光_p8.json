{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":81141,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"致政杨侍郎挽歌"},"Clauses":[{"Content":"时论归清德，"},{"Content":"皇心重老臣。"},{"Content":"祖风终鲠直，"},{"Content":"家学本深淳。"},{"Content":"便殿谈经久，"},{"Content":"安车就第新。"},{"Content":"如何金未尽，"},{"Content":"奄忽弃乡人。"}]},{"Id":81140,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"致政杨侍郎挽歌"},"Clauses":[{"Content":"忧国心如石，"},{"Content":"当朝有古风。"},{"Content":"挂冠虽在远，"},{"Content":"遗札不忘忠。"},{"Content":"飞旐西归洛，"},{"Content":"新阡背倚嵩。"},{"Content":"还令往来客，"},{"Content":"下马白杨中。"}]},{"Id":81059,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"送师道知长溪因归觐省"},"Clauses":[{"Content":"羁旅帝城久，"},{"Content":"逢人青眼稀。"},{"Content":"闻君又当去，"},{"Content":"使我益思归。"},{"Content":"佳色邻乡树，"},{"Content":"高堂望䌽衣。"},{"Content":"春流先自疾，"},{"Content":"心出片帆飞。"}]},{"Id":81052,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"送刘仪先辈大名尉"},"Clauses":[{"Content":"潭潭相府开，"},{"Content":"旌骑拥三台。"},{"Content":"闻道廷中吏，"},{"Content":"无非天下才。"},{"Content":"策名新振拔，"},{"Content":"把板尚低回。"},{"Content":"勿为卑飞困，"},{"Content":"青冥尽此来。"}]},{"Id":81101,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"送皇甫寺丞知蓝田县","Comments":[{"Content":"穆","Type":"Text","Index":5}]},"Clauses":[{"Content":"南山三辅剧，"},{"Content":"百里古诸侯。"},{"Content":"谁为弦歌小，"},{"Content":"不分宵旰忧。"},{"Content":"烟横辋川暝，"},{"Content":"云照武关秋。"},{"Content":"安得无羁束，"},{"Content":"从君一纵游。"}]},{"Id":81556,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"送祁峤颍阳主簿"},"Clauses":[{"Content":"苍山临县郭，"},{"Content":"云木冷萧骚。"},{"Content":"人有渔樵乐，"},{"Content":"官无簿领劳。"},{"Content":"垂天起肤寸，"},{"Content":"合抱本纤毫。"},{"Content":"志意诚脩立，"},{"Content":"归飞羽翼高。"}]},{"Id":81564,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"送李尉以监丞致仕归闽中"},"Clauses":[{"Content":"行行歌式微，"},{"Content":"浩叹返荆扉。"},{"Content":"却著登山屐，"},{"Content":"尽焚趋府衣。"},{"Content":"溪清鱼影乱，"},{"Content":"竹闇笋牙肥。"},{"Content":"应悔浮名误，"},{"Content":"空将白发归。"}]},{"Id":80906,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"和伯镇再入馆"},"Clauses":[{"Content":"甘泉献赋人，"},{"Content":"流落浙江滨。"},{"Content":"自叹三年谪，"},{"Content":"归来万事新。"},{"Content":"铨衡时进对，"},{"Content":"户牖日相亲。"},{"Content":"明主方思贾，"},{"Content":"非徒问鬼神。"}]},{"Id":80896,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"和同舍对菊无酒"},"Clauses":[{"Content":"黄花倚秋色，"},{"Content":"晔晔为谁开。"},{"Content":"更使窥残榼，"},{"Content":"空令洗旧杯。"},{"Content":"嗅香行缭绕，"},{"Content":"撚蕊立徘徊。"},{"Content":"尽日柴门外，"},{"Content":"白衣来不来。"}]},{"Id":80776,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"文太师挽歌三首","Comments":[{"Content":"文潞公父","Type":"Text","Index":7}]},"Clauses":[{"Content":"汾晋地形美，"},{"Content":"古今多钜贤。"},{"Content":"况承勋烈后，"},{"Content":"宜有庆灵传。"},{"Content":"著位登朝古，"},{"Content":"声华出众先。"},{"Content":"起家从此始，"},{"Content":"圭组遂蝉联。"}]},{"Id":80775,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"文太师挽歌三首","Comments":[{"Content":"文潞公父","Type":"Text","Index":7}]},"Clauses":[{"Content":"美化流民物，"},{"Content":"薰然遗爱多。"},{"Content":"栾公当日社，"},{"Content":"邵父至今歌。"},{"Content":"庭有三鳣集，"},{"Content":"门容驷马过。"},{"Content":"欲知馀庆在，"},{"Content":"公鼎格平和。"}]},{"Id":80774,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"文太师挽歌三首","Comments":[{"Content":"文潞公父","Type":"Text","Index":7}]},"Clauses":[{"Content":"夏屋封何处，"},{"Content":"山田有卧牛。"},{"Content":"蟠根走伊水，"},{"Content":"回首负嵩丘。"},{"Content":"忠孝家风备，"},{"Content":"哀荣礼秩优。"},{"Content":"龙鸾舞宸翰，"},{"Content":"万古照松楸。"}]},{"Id":81563,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"送李祠部知滑州","Comments":[{"Content":"复圭，字审言","Type":"Text","Index":4}]},"Clauses":[{"Content":"东郡堤繇苦，"},{"Content":"向来烟火疏。"},{"Content":"提封百里远，"},{"Content":"生齿万家馀。"},{"Content":"贤守车才下，"},{"Content":"疲人意已纾。"},{"Content":"行闻谣五裤，"},{"Content":"京廪满郊墟。"}]},{"Id":80958,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"和王道粹垂拱早朝王范二直阁班列在前戏成小诗"},"Clauses":[{"Content":"霁日扶霜仗，"},{"Content":"祥烟覆晓班。"},{"Content":"帝居回北斗，"},{"Content":"天阙竦南山。"},{"Content":"紫殿鸿鸾肃，"},{"Content":"金门虎豹环。"},{"Content":"蓬莱两仙伯，"},{"Content":"迥立白云间。"}]},{"Id":81047,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"FirstClauseRhyme":"豪","Title":{"Content":"送田校理知晋州","Comments":[{"Content":"谅，字仲孚","Type":"Text","Index":4},{"Content":"前判吏部南曹","Type":"Text","Index":7}]},"Clauses":[{"Content":"铨筦萃贤豪，"},{"Content":"夫君主剧曹。"},{"Content":"长才沛馀裕，"},{"Content":"众论蔚推高。"},{"Content":"逮此分符贵，"},{"Content":"知无顿刃劳。"},{"Content":"公卿如有缺，"},{"Content":"不独赐金褒。"}]},{"Id":81356,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"正月三日与广渊同出南薰门分趋斋宫涂中有作"},"Clauses":[{"Content":"并辔出都门，"},{"Content":"葱茏日欲昕。"},{"Content":"野寒馀宿雪，"},{"Content":"树闇湿春云。"},{"Content":"未望郊宫近，"},{"Content":"先愁马首分。"},{"Content":"一朝犹恋恋，"},{"Content":"可复久离群。"}]},{"Id":81033,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"送人为闽宰"},"Clauses":[{"Content":"万里东瓯外，"},{"Content":"溪山秀出群。"},{"Content":"乡人皆嗜学，"},{"Content":"太守复工文。"},{"Content":"正用慈良化，"},{"Content":"居无牒诉纷。"},{"Content":"谁云远京国，"},{"Content":"佳政日相闻。"}]},{"Id":81034,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"送才元守广安军归成都觐省","Comments":[{"Content":"四库本作知","Type":"Text","Index":4}]},"Clauses":[{"Content":"皂盖五骅骝，"},{"Content":"今来异昔游。"},{"Content":"箪壶交里舍，"},{"Content":"铙吹下瀛州。"},{"Content":"寿酒行当举，"},{"Content":"归鞭不可留。"},{"Content":"春光久相待，"},{"Content":"先在锦江头。"}]},{"Id":81547,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"送上雒王推官","Comments":[{"Content":"经臣","Type":"Text","Index":6}]},"Clauses":[{"Content":"墨绶百里宰，"},{"Content":"红蕖幕府僚。"},{"Content":"民淳无斗辩，"},{"Content":"地胜得逍遥。"},{"Content":"日上云未散，"},{"Content":"春深雪不消。"},{"Content":"知音已交荐，"},{"Content":"勿茹紫芝苗。"}]},{"Id":81122,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"送瀛州签判苏秘丞","Comments":[{"Content":"采","Type":"Text","Index":8}]},"Clauses":[{"Content":"高阳十万兵，"},{"Content":"幕府藉时英。"},{"Content":"塞上风犹劲，"},{"Content":"关南春未生。"},{"Content":"投壶边柝静，"},{"Content":"倚马檄书成。"},{"Content":"不忘尘中客，"},{"Content":"征鸿可寄声。"}]}],"Count":1270,"PageNo":8,"PageSize":20}