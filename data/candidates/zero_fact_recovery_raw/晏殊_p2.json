{"Authors":{"Names":["晏殊"],"AuthorIds":[27290],"Dynasties":["Song"]},"ShiData":[{"Id":198166,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"Title":{"Content":"奉和御制社日"},"Clauses":[{"Content":"天官考历占元日，"},{"Content":"浃宇祈农协盛时。"},{"Content":"芟柞尚传周室颂，"},{"Content":"枌榆仍秩汉家祠。"},{"Content":"三农普遂耕耘乐，"},{"Content":"万象均承雨露滋。","Comments":[{"Content":"四库本作室","Type":"Text","Index":2}]},{"Content":"推策授人敷景化，"},{"Content":"穰穰喜贶亿年期。"}]},{"Id":198146,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"寒食游王氏城东园林因寄王虞部"},"Clauses":[{"Content":"谢墅林亭汴水滨，"},{"Content":"偶携佳客共寻春。"},{"Content":"看花纵拟思君子，","Comments":[{"Content":"四库本作便","Type":"Text","Index":3}]},{"Content":"对竹何曾问主人。"},{"Content":"促席正逢羲日缓，","Comments":[{"Content":"四库本作暖","Type":"Text","Index":7}]},{"Content":"酡颜仍有郢醪醇。"},{"Content":"朝中九列无闲暇，"},{"Content":"愿作新诗赠季伦。"}]},{"Id":198100,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"七夕"},"Clauses":[{"Content":"百子池深涨绿苔，"},{"Content":"九光灯迥绿浮埃。","Comments":[{"Content":"补编作照","Type":"Text","Index":5}]},{"Content":"天孙宝驾何年驻，"},{"Content":"阿母飙轮此夜来。"},{"Content":"空外粉筵和露湿，"},{"Content":"静中珠幌彻明开。"},{"Content":"秋河不断长相望，"},{"Content":"岂独人间事可哀。","Comments":[{"Content":"自注：帝武夷山歌唱人间可哀之曲。","Type":"Text","Index":7}]}],"Note":"按：同上书卷二七"},{"Id":198112,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"次韵和王校勘中秋月"},"Clauses":[{"Content":"广寒仙署惬心期，"},{"Content":"秋半梧台木叶稀。"},{"Content":"有客正吟星北共，"},{"Content":"何人重赋鹊南飞。"},{"Content":"光含绮席传三雅，"},{"Content":"影逗兰房撤九微。","Comments":[{"Content":"原作围，据四库本改","Type":"Text","Index":7}]},{"Content":"趋府逸才过鲍掾，"},{"Content":"不辞终夕赏清晖。"}]},{"Id":198157,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"九日北郡登高见寄"},"Clauses":[{"Content":"前日登高泛玉卮，"},{"Content":"击铜赓唱有新辞。"},{"Content":"如何偶作销魂别，"},{"Content":"又复重吟把菊诗。"},{"Content":"上苑盍簪延景刻，"},{"Content":"北都投辖盛官仪。"},{"Content":"烦君见想欢言者，"},{"Content":"可奈衡门绝贡綦。","Comments":[{"Content":"自注：近日谏臣请二府罢接宾客以专论。执政奏许休务日见客，常日则门无车马矣。","Type":"Text","Index":7}]}]},{"Id":198101,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"九日宴集和徐通判韵"},"Clauses":[{"Content":"散插黄花两佩萸，"},{"Content":"粉饘蓬饵釂觞初。"},{"Content":"清歌咽后云生袂，"},{"Content":"妙舞翻时雪满裾。"},{"Content":"上客采香逢木密，"},{"Content":"佳人投钓得王馀。"},{"Content":"秋光屈指犹三七，"},{"Content":"莫向宾朋绮宴疏。"}]},{"Id":198113,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"次韵和史馆吕相公九日偶成","Comments":[{"Content":"时史馆充大内修葺使，罢重阳苑宴","Type":"Text","Index":12}]},"Clauses":[{"Content":"凤阙千门制不奢，"},{"Content":"上公精意在朝家。"},{"Content":"重阳蜜饵承班诏，"},{"Content":"西苑璆樽辍泛花。"},{"Content":"萧相未央功已半，"},{"Content":"汉皇宣室宴非赊。"},{"Content":"由来位极妨行乐，"},{"Content":"目断黄垆酒旆斜。"}]},{"Id":198116,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"和至日北园宴集"},"Clauses":[{"Content":"清晓融风肃桂堂，"},{"Content":"郡寮多暇舞筵张。","Comments":[{"Content":"自注：时日太傅（四库本作守）命宾。","Type":"Text","Index":7}]},{"Content":"台高已验云容媚，"},{"Content":"日暖悬知刻漏长。"},{"Content":"溪子弩寒千命中，"},{"Content":"兰英酒熟百传觞。"},{"Content":"官曹事集神都近，"},{"Content":"预拜需函庆一阳。","Comments":[{"Content":"原作觞，据四库本改","Type":"Text","Index":7}]}]},{"Id":198131,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"Title":{"Content":"奉和圣制除夜"},"Clauses":[{"Content":"秘掖楯轩严万户，"},{"Content":"庆宵躔次会三辰。"},{"Content":"丹闱肃穆犹凝夕，"},{"Content":"佳气葱珑渐报春。"},{"Content":"调历自将穹厚永，"},{"Content":"圣辞常与岁时新。"},{"Content":"送寒旁磔迎和令，"},{"Content":"率土群生仰昊旻。"}]},{"Id":198135,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"春阴"},"Clauses":[{"Content":"十二重环閟洞房，"},{"Content":"愔愔危树俯回塘。"},{"Content":"风迷戏蝶闲无绪，"},{"Content":"露裛幽花冷自香。"},{"Content":"绮席醉吟销桂酌，"},{"Content":"玉台愁作涩银簧。"},{"Content":"梅青麦绿江城路，"},{"Content":"更与登高望楚乡。","Comments":[{"Content":"元方回《瀛奎律髓》卷一○","Type":"Text","Index":7}]}]},{"Id":198149,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"赋得秋雨"},"Clauses":[{"Content":"点滴行云覆苑墙，"},{"Content":"飘萧微影度回塘。"},{"Content":"秦声未觉朱弦润，"},{"Content":"楚梦先知薤叶凉。"},{"Content":"野水有波增澹碧，"},{"Content":"霜林无韵湿疏黄。"},{"Content":"萤稀燕寂高窗暮，"},{"Content":"正是西风玉漏长。","Comments":[{"Content":"同上书卷一七","Type":"Text","Index":7}]}]},{"Id":198137,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"送凌侍郎归乡"},"Clauses":[{"Content":"江南藩郡古宣城，"},{"Content":"碧落神仙拥使旌。"},{"Content":"津吏戒船东下稳，"},{"Content":"悬僚负弩昼归荣。"},{"Content":"江山谢守高吟地，"},{"Content":"风月朱公故里情。"},{"Content":"曾预汉庭三独坐，"},{"Content":"府中谁敢伴飞觥。","Comments":[{"Content":"元富大用《事文类聚》外集卷一○","Type":"Text","Index":7}]}]},{"Id":198163,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"张太傅生日诗"},"Clauses":[{"Content":"三陟槐庭二将坛，"},{"Content":"册书文武载勋贤。"},{"Content":"辞荣尚峻经邦秩，"},{"Content":"养素方临钓渭年。"},{"Content":"清会别开金谷墅，"},{"Content":"新吟多杂蕊珠篇。"},{"Content":"惊姜今日增华耀，"},{"Content":"海内簪绅共祝延。","Comments":[{"Content":"李校作筵","Type":"Text","Index":7}]}],"Note":"按：同上书新集卷二"},{"Id":198162,"Classes":["題畫 故實"],"Froms":["御定历代题画诗类卷四十一 故实类"],"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"次韵谢借观五老图"},"Clauses":[{"Content":"道明回诏乐清闲，"},{"Content":"便向中朝脱冕冠。"},{"Content":"百日秉枢登相府，"},{"Content":"千年青史表旌桓。"},{"Content":"泰运正隆嫌气热，"},{"Content":"乾纲初整畏冰寒。","Comments":[{"Content":"原作刚，据《历代题画诗类》改","Type":"Text","Index":2}]},{"Content":"逍遥唱和多高致，"},{"Content":"仪象霜风俾后看。","Comments":[{"Content":"同上书卷一三","Type":"Text","Index":7}]}]},{"Id":198148,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"棋盘石","Comments":[{"Content":"《诗渊》作石棋盘","Type":"Text","Index":3}]},"Clauses":[{"Content":"洞仙遗下石棋盘，"},{"Content":"人到壶天静处看。"},{"Content":"十九路谁弹黑界，","Comments":[{"Content":"《诗渊》作墨","Type":"Text","Index":6}]},{"Content":"几千年自带云寒。"},{"Content":"面平可步流星势，","Comments":[{"Content":"《诗渊》作足","Type":"Text","Index":3}]},{"Content":"尘净元无旧藓瘢。"},{"Content":"乾雹声中闻子响，"},{"Content":"不知还许采樵观。","Comments":[{"Content":"明徐表然《武夷山志略》","Type":"Text","Index":7}]}]},{"Id":198107,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"忆临川旧游"},"Clauses":[{"Content":"仲子幽居杳蔼间，"},{"Content":"回环十亩尽林峦。"},{"Content":"游鱼倒溯清泉急，"},{"Content":"乳雉惊飞夕烧乾。","Comments":[{"Content":"李校作照","Type":"Text","Index":6}]},{"Content":"系马短亭乘草茁，"},{"Content":"携壶芳榭值梅酸。"},{"Content":"浮生莫道今如昨，"},{"Content":"曷月朋簪争此欢。","Comments":[{"Content":"清胡亦堂《元献遗文》","Type":"Text","Index":7}]}]},{"Id":198150,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"题东湖涵虚阁"},"Clauses":[{"Content":"水有支流树有孙，"},{"Content":"重重门巷挂朱轩。"},{"Content":"三君雅望标人杰，"},{"Content":"千里澄波隔世喧。"},{"Content":"西对户庭徐孺宅，"},{"Content":"北传钟梵给孤园。"},{"Content":"欲知嗣续无穷胜，"},{"Content":"两两荣归汉使轓。","Comments":[{"Content":"劳格《元献遗文补编》引《江西诗话》","Type":"Text","Index":7}]}]},{"Id":198027,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"寒","Rank":0,"Title":{"Content":"中书即事"},"Clauses":[{"Content":"惨惨高槐落，"},{"Content":"凄凄馀菊寒。"},{"Content":"粉墙多记墨，"},{"Content":"聊为拂尘看。"}]},{"Id":198049,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"支","Rank":0,"Title":{"Content":"竹醉日"},"Clauses":[{"Content":"苒苒渭滨族，"},{"Content":"萧萧尘外姿。"},{"Content":"如能乐封殖，"},{"Content":"何必醉中移。","Comments":[{"Content":"同上书卷三一引《艺苑雌黄》","Type":"Text","Index":5}]}]},{"Id":198067,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"寒","Rank":0,"Title":{"Content":"盂兰盆"},"Clauses":[{"Content":"红白薇英落，"},{"Content":"朱黄槿艳残。"},{"Content":"家人愁溽暑，"},{"Content":"计日望盂兰。","Comments":[{"Content":"宋陆游《老学庵笔记》卷七","Type":"Text","Index":5}]}]}],"Count":360,"PageNo":2,"PageSize":20}