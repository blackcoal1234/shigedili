{"Authors":{"Names":["司空曙"],"AuthorIds":[13632],"Dynasties":["Tang"]},"ShiData":[{"Id":12168,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"麻","Rank":0,"Title":{"Content":"玩花与卫象同醉","Comments":[{"Content":"一作卫长林","Type":"Text","Index":5}]},"Clauses":[{"Content":"衰鬓千茎雪，","Comments":[{"Content":"一作白","Type":"Text","Index":5}]},{"Content":"他乡一树花。"},{"Content":"今朝与君醉，"},{"Content":"忘却在长沙。"}],"Comments":[{"Book":"《批点唐音》","Content":"便胜仲文《伤秋》之作，为其宛转耳。","IsComment":false,"FullPath":"《批点唐音》"}]},{"Id":12154,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"Title":{"Content":"为李魏公赋谢汧公"},"Clauses":[{"Content":"白雪高吟际，"},{"Content":"青霄远望中。"},{"Content":"谁言路遐旷，"},{"Content":"宫徵暗相通。"}]},{"Id":12167,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"咏古寺花"},"Clauses":[{"Content":"共爱芳菲此树中，"},{"Content":"千跗万萼裹枝红。","Comments":[{"Content":"一作蕊","Type":"Text","Index":4},{"Content":"一作裛","Type":"Text","Index":5}]},{"Content":"迟迟欲去犹回望，"},{"Content":"覆地无人满寺风。"}],"Comments":[{"Book":"《竹庄诗话》","Content":"《瑶溪集》云：《古寺花》一首，见爱慕佳景之情。","IsComment":false,"FullPath":"《竹庄诗话》"}]},{"Id":12155,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"文","Rank":0,"FirstClauseRhyme":"文","Title":{"Content":"发渝州却寄韦判官"},"Clauses":[{"Content":"红烛津亭夜见君，"},{"Content":"繁弦急管两纷纷。"},{"Content":"平明分手空江转，","Comments":[{"Content":"一作携","Type":"Text","Index":3}]},{"Content":"唯有猿声满水云。","Comments":[{"Content":"一作啸","Type":"Text","Index":5}]}]},{"Id":12175,"Allusions":[{"AllusionIndex":3660,"AllusionKey":"郭细侯","SentenceIndex":1}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"送卢彻之太原谒马尚书"},"Clauses":[{"Content":"榆落雕飞关塞秋，"},{"Content":"黄云画角见并州。"},{"Content":"翩翩羽骑双旌后，"},{"Content":"上客亲随郭细侯。","Comments":[{"Content":"一作新","Type":"Text","Index":3},{"Content":"郭细侯","Type":"AllusionKey","Index":7}]}]},{"Id":12170,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"峡口送友人"},"Clauses":[{"Content":"峡口花飞欲尽春，"},{"Content":"天涯去住泪沾巾。"},{"Content":"来时万里同为客，"},{"Content":"今日翻成送故人。"}],"Comments":[{"Book":"《批点唐诗正声》","Content":"气格丧尽。盛唐后每以如此声调为佳，世运使然耳，司空此诗更堕晚唐矣。","IsComment":false,"FullPath":"《批点唐诗正声》"},{"Book":"《唐诗训解》","Content":"“翻成”二字当味。","IsComment":false,"FullPath":"《唐诗训解》"},{"Book":"《唐诗别裁》","Content":"客中送客，自难为情，况又“万里”之远耶，况又“同为客”耶？","IsComment":false,"FullPath":"《唐诗别裁》"},{"Book":"《诗境浅说续编》","Content":"唐人送友诗最善言情；诵之觉言愁欲愁。司空此作于后二句作折笔，……其诗境转深一层，情味弥永。","IsComment":false,"FullPath":"《诗境浅说续编》"}]},{"Id":12185,"Allusions":[{"AllusionIndex":2262,"AllusionKey":"堕泪岘山","SentenceIndex":1}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"登岘亭"},"Clauses":[{"Content":"岘山回首望秦关，"},{"Content":"南向荆州几日还。","Comments":[{"Content":"一作一身放放向荆蛮，平楚茫茫失路关","Type":"Text","Index":7}]},{"Content":"今日登临唯有泪，"},{"Content":"不知风景在何山。"}]},{"Id":12160,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"江村即事"},"Clauses":[{"Content":"钓罢归来不系船，"},{"Content":"江村月落正堪眠。"},{"Content":"纵然一夜风吹去，"},{"Content":"只在芦花浅水边。"}],"Comments":[{"Book":"《唐诗解》","Content":"全篇皆从“不系船”三字翻出，语极浅，兴味自在。","IsComment":false,"FullPath":"《唐诗解》"},{"Book":"《唐诗归》","Content":"钟云：达甚。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗归折衷》","Content":"唐云：兴趣可嘉，不止于达。敬夫云：不言乐，其乐无穷矣。","IsComment":false,"FullPath":"《唐诗归折衷》"},{"Book":"《历代诗法》","Content":"口头语，意趣自别。","IsComment":false,"FullPath":"《历代诗法》"},{"Book":"《诗式》","Content":"首句以“罢钓”二字作主，则以下纯从“罢钓”着笔。顾“罢钓”以后，从何处着笔？盖从钓船言，既已罢钓，正当系船，乃以“不系船”三字承之，则诗境翻空，出人意外。二句值江村月落之时，眠于船上，任其所之，便有洒然无拘滞之意。……凡做诗，意贵翻陈出新，如此首是。若于“不系船”三字，非著一“不”字，则“罢钓”以后，便系船矣，以下无论如何刻划，总落恒蹊，断难如此灵妙。[品]超诣。","IsComment":false,"FullPath":"《诗式》"},{"Book":"《唐人绝句精华》","Content":"此渔家乐也。诗语得自在之趣。","IsComment":false,"FullPath":"《唐人绝句精华》"},{"Book":"唐诗鉴赏辞典","Content":"这首诗写江村眼前情事，但诗人并不铺写村景江色，而是通过江上钓鱼者的一个细小动作及心理活动，反映江村生活的一个侧面，写出真切而又恬美的意境。<br /><br />“钓罢归来不系船”，首句写渔翁夜钓回来，懒得系船，而让渔船任意飘荡。“不系船”三字为全诗关键，以下诗句全从这三字生出。“江村月落正堪眠”，第二句上承起句，点明“钓罢归来”的地点、时间及人物的行动、心情。船停靠在江村，时已深夜，月亮落下去了，人也已经疲倦，该睡觉了，因此连船也懒得系。但是，不系船能安然入睡吗？这就引出了下文：<br /><br />“纵然一夜风吹去，只在芦花浅水边。”这两句紧承第二句，回答了上面的问题。“纵然”、“只在”两个关联词前后呼应，一放一收，把意思更推进一层：且不说夜里不一定起风，即使起风，没有缆住的小船也至多被吹到那长满芦花的浅水边，又有什么关系呢？这里，诗人并没有刻画幽谧美好的环境，然而钓者悠闲的生活情趣和江村宁静优美的景色跃然纸上。<br /><br />这首小诗善于以个别反映一般，通过“钓罢归来不系船”这样一件小事，刻画江村情事，由小见大，就比泛泛描写江村的表面景象要显得生动新巧，别具一格。诗在申明“不系船”的原因时，不是直笔到底，一览无余，而是巧用“纵然”“只在”等关联词，以退为进，深入一步，使诗意更见曲折深蕴，笔法更显腾挪跌宕。诗的语言真率自然，清新俊逸，和富有诗情画意的幽美意境十分和谐。<br /><br />（吴小林）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]},{"Id":12172,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"秋园","Comments":[{"Content":"一本题下有戏题二字","Type":"Text","Index":2}]},"Clauses":[{"Content":"伤秋不是惜年华，"},{"Content":"别忆春风碧玉家。"},{"Content":"强向衰丛见芳意，"},{"Content":"茱萸红实似繁花。"}]},{"Id":12171,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"春送郭大之官"},"Clauses":[{"Content":"明府之官官舍春，"},{"Content":"春风辞我两三人。"},{"Content":"可怜江县闲无事，"},{"Content":"手板支颐独咏贫。"}]},{"Id":12177,"Allusions":[{"AllusionIndex":10587,"AllusionKey":"征南","SentenceIndex":1}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"覃","Rank":0,"Title":{"Content":"送郑锡","Comments":[{"Content":"曙曾事此公季父","Type":"Text","Index":3}]},"Clauses":[{"Content":"汉阳云树清无极，"},{"Content":"蜀国风烟思不堪。"},{"Content":"莫怪别君偏有泪，"},{"Content":"十年曾事晋征南。","Comments":[{"Content":"征南","Type":"AllusionKey","Index":7}]}]},{"Id":12174,"Allusions":[{"AllusionIndex":3084,"AllusionKey":"伏波","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"送人归黔府"},"Clauses":[{"Content":"伏波箫鼓水云中，","Comments":[{"Content":"伏波","Type":"AllusionKey","Index":2}]},{"Content":"长戟如霜大旆红。"},{"Content":"油幕晓开飞鸟绝，"},{"Content":"翩翩上将独趋风。"}]},{"Id":12158,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"杂兴"},"Clauses":[{"Content":"月没辽城暗出师，"},{"Content":"双龙金角晓天悲。"},{"Content":"黄尘满目随风散，"},{"Content":"不认将军燕尾旗。"}]},{"Id":12157,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"职","Rank":0,"Title":{"Content":"岁暮怀崔峒耿湋"},"Clauses":[{"Content":"腊月江天见春色，"},{"Content":"白花青柳疑寒食。"},{"Content":"洛阳旧社各东西，"},{"Content":"楚国游人不相识。"}]},{"Id":12162,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"观妓"},"Clauses":[{"Content":"翠蛾红脸不胜情，"},{"Content":"管绝弦馀发一声。"},{"Content":"银烛摇摇尘暗下，"},{"Content":"却愁红粉泪痕生。"}]},{"Id":12163,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"过长林湖西酒家"},"Clauses":[{"Content":"湖草青青三两家，"},{"Content":"门前桃杏一般花。"},{"Content":"迁人到处唯求醉，"},{"Content":"闻说渔翁有酒赊。"}]},{"Id":12165,"Allusions":[{"AllusionIndex":10468,"AllusionKey":"张邴","SentenceIndex":1}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"Title":{"Content":"过阎采病居"},"Clauses":[{"Content":"每逢佳节何曾坐，"},{"Content":"唯有今年不得游。"},{"Content":"张邴卧来休送客，","Comments":[{"Content":"张邴","Type":"AllusionKey","Index":2}]},{"Content":"菊花枫叶向谁秋。"}]},{"Id":12178,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"送皋法师"},"Clauses":[{"Content":"江草知寒柳半衰，"},{"Content":"行吟怨别独迟迟。"},{"Content":"何人讲席投如意，"},{"Content":"唯有东林远法师。"}]},{"Id":12176,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"送郑佶归洛阳"},"Clauses":[{"Content":"苍苍楚色水云间，"},{"Content":"一醉春风送尔还。"},{"Content":"何处乡心最堪羡，"},{"Content":"汝南初见洛阳山。"}]},{"Id":12182,"GroupIndex":1,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"豪","Rank":0,"FirstClauseRhyme":"豪","Title":{"Content":"雪二首"},"Clauses":[{"Content":"乐游春苑望鹅毛，"},{"Content":"宫殿如星树似毫。"},{"Content":"漫漫一川横渭水，"},{"Content":"太阳初出五陵高。"}]}],"Count":165,"PageNo":6,"PageSize":20}