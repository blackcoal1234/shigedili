{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":81172,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"寄题傅钦之济源别业"},"Clauses":[{"Content":"县郭遥相望，"},{"Content":"脩篁百亩馀。"},{"Content":"林间清济水，"},{"Content":"门外太行车。"},{"Content":"道胜随宜足，"},{"Content":"身闲与世疏。"},{"Content":"何时容命驾，"},{"Content":"采蕨钓肥鱼。"}]},{"Id":81216,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"游李卫公平泉庄"},"Clauses":[{"Content":"相国已何在，"},{"Content":"空山馀故林。"},{"Content":"向时堪炙手，"},{"Content":"今日但伤心。"},{"Content":"陵谷尚未改，"},{"Content":"门阑不可寻。"},{"Content":"谁知荆棘地，"},{"Content":"鹤盖旧成阴。"}]},{"Id":81257,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"赠河中通判朱郎中","Comments":[{"Content":"寿昌侍郎巽之子。襁抱中母刘氏被出，寿昌长而访之，不能得。熙宁中，知广德军。年五十三，乃乞寻医，身自访求，得于同州，为民党氏妻。迎以归，奏授封邑。寿昌，扬州人，以其母子孙俱在同州，故折资通判河中","Type":"Text","Index":8}]},"Clauses":[{"Content":"陟屺今将老，"},{"Content":"扶床昔未行。"},{"Content":"旨甘无所展，"},{"Content":"朱紫不为荣。"},{"Content":"里巷传呼入，"},{"Content":"比邻失涕惊。"},{"Content":"方知贯金石，"},{"Content":"何以易精诚。"}]},{"Id":81165,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"寄题李水部浐水别业","Comments":[{"Content":"庠","Type":"Text","Index":5}]},"Clauses":[{"Content":"茅茨临素浐，"},{"Content":"沃野带长林。"},{"Content":"日永一堂静，"},{"Content":"草生三径深。"},{"Content":"消忧何用酒，"},{"Content":"为乐不须琴。"},{"Content":"扰扰市朝客，"},{"Content":"无人知此心。"}]},{"Id":81013,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"泉水诗送吴都官分司归和州","Comments":[{"Content":"大元，字一翁","Type":"Text","Index":7}]},"Clauses":[{"Content":"泉水出幽谷，"},{"Content":"原流本自清。"},{"Content":"萦回遍中国，"},{"Content":"浩荡入东瀛。"},{"Content":"峡口春雷怒，"},{"Content":"潭心晓鉴平。"},{"Content":"悠悠随所值，"},{"Content":"行止两无情。","Comments":[{"Content":"以上《温国文正司马公文集》卷一一","Type":"Text","Index":5}]}]},{"Id":81217,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"游瀍上刘氏园"},"Clauses":[{"Content":"日暖孤台迥，"},{"Content":"露浓幽径微。"},{"Content":"茅斋举白饮，"},{"Content":"沙溆踏青归。"},{"Content":"照水清满眼，"},{"Content":"穿林香湿衣。"},{"Content":"莫言春尚浅，"},{"Content":"已有杏花飞。"}]},{"Id":81251,"Classes":["軍旅"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"题致仕李太傅园亭"},"Clauses":[{"Content":"汉家飞将种，"},{"Content":"气概耿清秋。"},{"Content":"解去金貂贵，"},{"Content":"来从洛社游。"},{"Content":"清商拥高宴，"},{"Content":"华馆带长流。"},{"Content":"可笑班超老，"},{"Content":"崎岖万里侯。"}]},{"Id":80828,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"早行"},"Clauses":[{"Content":"寒犬吠柴门，"},{"Content":"荒鸡鸣远村。"},{"Content":"河声空自急，"},{"Content":"月影不曾浑。"},{"Content":"木末星犹白，"},{"Content":"榛中露已繁。"},{"Content":"客心独惆怅，"},{"Content":"四顾与谁言。"}]},{"Id":81091,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"送罗郎中管勾玉局观","Comments":[{"Content":"登","Type":"Text","Index":4}]},"Clauses":[{"Content":"官名为玉局，"},{"Content":"已与俗尘疏。"},{"Content":"钟出寒松迥，"},{"Content":"香疑古殿虚。"},{"Content":"乡闾非甚远，"},{"Content":"俸禄岂无馀。"},{"Content":"谁道神仙乐，"},{"Content":"神仙恐不如。"}]},{"Id":81244,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"酬终南阎谏议见寄","Comments":[{"Content":"询，字议道","Type":"Text","Index":6}]},"Clauses":[{"Content":"齿衰心力耗，"},{"Content":"揣分乞西台。"},{"Content":"微禄供多病，","Comments":[{"Content":"以上三句原缺，据陈本、四库本补","Type":"Text","Index":5}]},{"Content":"闲官养不才。"},{"Content":"弊庐容啸傲，"},{"Content":"清洛伴归来。"},{"Content":"故友犹相念，"},{"Content":"寒光生死灰。"}]},{"Id":81156,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"寄成都吴龙图同年"},"Clauses":[{"Content":"照席烛花暖，"},{"Content":"随车剑骑寒。"},{"Content":"江山资秀句，"},{"Content":"风月助清欢。"},{"Content":"政简坤维静，"},{"Content":"仁深井络安。"},{"Content":"行歌与独酌，"},{"Content":"岂得并闲官。"}]},{"Id":80864,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"花庵独坐"},"Clauses":[{"Content":"荒园才一亩，"},{"Content":"意足已为多。"},{"Content":"虽不居丘壑，"},{"Content":"常如隐薜萝。"},{"Content":"忘机林鸟下，"},{"Content":"极目塞鸿过。"},{"Content":"为问市朝客，"},{"Content":"红尘深几何。"}]},{"Id":81023,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"秋夜"},"Clauses":[{"Content":"浮云一消散，"},{"Content":"星斗粲长天。"},{"Content":"浩露洒翠柏，"},{"Content":"清香生白莲。"},{"Content":"体凉犹衣葛，"},{"Content":"耳静已无蝉。"},{"Content":"坐久群动息，"},{"Content":"秋空唯寂然。"}]},{"Id":80797,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"平日游园常策筇杖秋来发箧复出貂褥二物皆景仁所贶睹物思人斐然成诗"},"Clauses":[{"Content":"筇杖携已久，"},{"Content":"貂褥展犹新。"},{"Content":"渐染岷山雪，"},{"Content":"拂除京国尘。"},{"Content":"危扶醉归路，"},{"Content":"稳称病来身。"},{"Content":"赖此斋中物，"},{"Content":"时如见故人。"}]},{"Id":81328,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"云"},"Clauses":[{"Content":"晴空碧于水，"},{"Content":"那得片云飞。"},{"Content":"映日成丹凤，"},{"Content":"随风变白衣。"},{"Content":"去来皆绝迹，"},{"Content":"隐显两忘机。"},{"Content":"天理谁能测，"},{"Content":"终然何所归。"}]},{"Id":80873,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"闲来"},"Clauses":[{"Content":"闲来观万物，"},{"Content":"在处可逍遥。"},{"Content":"鱼为贪钩得，"},{"Content":"蛾因赴火焦。"},{"Content":"碧梧饥鸑鷟，"},{"Content":"白粒饱鹪鹩。"},{"Content":"带索谁家子，"},{"Content":"行歌复采樵。"}]},{"Id":80863,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"花庵多牵牛清晨始开日出已瘁花虽甚美而不堪留赏"},"Clauses":[{"Content":"望远云凝岫，"},{"Content":"妆馀黛散钿。"},{"Content":"缥囊承晓露，"},{"Content":"翠盖拂秋烟。"},{"Content":"响慕非葵比，"},{"Content":"彫零在槿先。"},{"Content":"才供少顷玩，"},{"Content":"空废日高眠。"}]},{"Id":81053,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"蒸","Rank":0,"Title":{"Content":"送刘仲通赴京师"},"Clauses":[{"Content":"圣朝方考牧，"},{"Content":"蕃育寄才能。"},{"Content":"屡别良可叹，"},{"Content":"闲游不复曾。"},{"Content":"行尘遵洛汭，"},{"Content":"朝骑对觚棱。"},{"Content":"瀍上秋台迥，"},{"Content":"归来正好登。"}]},{"Id":81123,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"送稻醴与子才"},"Clauses":[{"Content":"昔贤尊道谊，"},{"Content":"置醴待嘉宾。"},{"Content":"今我乐闲放，"},{"Content":"提壶饷故人。"},{"Content":"蚁浮杯面白，","Comments":[{"Content":"原作同，据陈本改","Type":"Text","Index":4}]},{"Content":"味撇瓮头醇。"},{"Content":"何以助高兴，"},{"Content":"篱边菊蕊新。"}]},{"Id":80930,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"和杨卿中秋月"},"Clauses":[{"Content":"秋气平分夜，"},{"Content":"沈阴乍散天。"},{"Content":"窥林初淡薄，"},{"Content":"照席忽孤圆。"},{"Content":"泠入诗毫健，"},{"Content":"光浮醉弁偏。"},{"Content":"嘉宾勿轻去，"},{"Content":"桂影正娟娟。"}]}],"Count":1270,"PageNo":17,"PageSize":20}