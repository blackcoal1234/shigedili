{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11327,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"蓝溪期萧道士采药不至"},"Clauses":[{"Content":"春风生百药，","Comments":[{"Content":"一作草","Type":"Text","Index":5}]},{"Content":"几处术苗香。"},{"Content":"人远花空落，"},{"Content":"溪深日复长。"},{"Content":"病多知药性，"},{"Content":"老近忆仙方。"},{"Content":"清节何由见，","Comments":[{"Content":"一作青","Type":"Text","Index":1}]},{"Content":"三山桂自芳。"}]},{"Id":11236,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"FirstClauseRhyme":"文","Title":{"Content":"秋夜寄冯著作"},"Clauses":[{"Content":"河汉净无云，"},{"Content":"鸿声此夜闻。"},{"Content":"素心难比石，","Comments":[{"Content":"一作虽","Type":"Text","Index":3}]},{"Content":"苍鬓欲如君。"},{"Content":"露槿月中落，"},{"Content":"风萤池上分。"},{"Content":"何言千载友，","Comments":[{"Content":"一作十","Type":"Text","Index":3}]},{"Content":"同迹不同群。"}]},{"Id":11210,"Allusions":[{"AllusionIndex":4572,"AllusionKey":"贾傅","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"夜中得循州赵司马侍郎书因寄回使"},"Clauses":[{"Content":"瘴海寄双鱼，"},{"Content":"中宵达我居。"},{"Content":"两行灯下泪，"},{"Content":"一纸岭南书。"},{"Content":"地说炎蒸极，"},{"Content":"人称老病馀。"},{"Content":"殷勤报贾傅，","Comments":[{"Content":"一作祝","Type":"Text","Index":3},{"Content":"贾傅","Type":"AllusionKey","Index":5}]},{"Content":"莫共酒杯疏。"}],"Comments":[{"Book":"《风骚旨格》","Content":"诗有四十门：……三曰悲喜，诗云：“两行灯下泪，一纸岭南书。”","IsComment":false,"FullPath":"《风骚旨格》"},{"Book":"《对床夜语》","Content":"诗在意远，固不以词语丰约为拘。然开元以后五言，未始不自古诗中流出。虽无穷之意，严有限之字，而视大篇长什，其实一也。如“旧里多青草，新知尽白头”，又“两行灯下泪，一纸岭南书”，则久别乍归之感，恩远怀旧之悲，隐然无穷。","IsComment":false,"FullPath":"《对床夜语》"},{"Book":"《唐诗选脉会通评林》","Content":"何新之列此诗为“平淡体”。徐用吾曰：次联口头语，不难亦不易。周珽曰：五、六即书中寄语，所以中宵灯下闻之，不胜悲泪。结以贾傅比赵，欲其孤开怀抱，勿以瘅地恶劣、宦游衰病自苦也。允言诗朴厚浑雅，辄多悲调。摹情处如“两行灯下泪，一纸岭南书”，已极伤心。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《全唐风雅》","Content":"黄绍夫云：故人迁谪之情，哀老久别之感，万里愿望之意，于数句内尽之，可谓能言其所欲言矣。","IsComment":false,"FullPath":"《全唐风雅》"},{"Book":"《大历诗略》","Content":"如题赶上，无一语溢出。","IsComment":false,"FullPath":"《大历诗略》"},{"Book":"《唐诗笺注》","Content":"不假雕镂，如同话语，诗到真率处自然有味。","IsComment":false,"FullPath":"《唐诗笺注》"},{"Book":"《网师园唐诗笺》","Content":"情至语，出于自然（“两行”联下）。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"《诗式》","Content":"发句上句从赵司马寄书起，此乃对面著笔；下句言得书，而又切“夜中”。颔联写情，上句承发句下句，切“夜”字；下句承发句上句，切“循州”。颈联写事，述书中所云者，上句就地说，下句就人说。落句上句以贾傅比赵司马，下句言交情。前半首写得赵司马书，带定“夜”字；后半首写书中语，而以酒杯结“疏”字，妙！惟迹疏，故用书，以所谓得题之神者。[品]温厚。","IsComment":false,"FullPath":"《诗式》"}]},{"Id":11399,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"10","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"春思贻李方陵","Comments":[{"Content":"一本无陵字","Type":"Text","Index":6}]},"Clauses":[{"Content":"长安三月春，"},{"Content":"难别复难亲。"},{"Content":"不识冶游伴，"},{"Content":"多逢憔悴人。"},{"Content":"渐知欢澹薄，"},{"Content":"转觉老殷勤。"},{"Content":"去矣尽如此，"},{"Content":"此辞悲未陈。"}]},{"Id":11222,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"春日书情赠别司空曙"},"Clauses":[{"Content":"壮志随年尽，"},{"Content":"谋身意未安。","Comments":[{"Content":"一作独，一作觉，一作竟","Type":"Text","Index":3}]},{"Content":"风尘交契阔，","Comments":[{"Content":"一作绝","Type":"Text","Index":5}]},{"Content":"老大别离难。"},{"Content":"腊近晴多暖，"},{"Content":"春迟夜却寒。"},{"Content":"谁堪少兄弟，","Comments":[{"Content":"一作怜","Type":"Text","Index":2}]},{"Content":"三十又无官。","Comments":[{"Content":"一作复","Type":"Text","Index":3},{"Content":"一作五十未为官","Type":"Text","Index":5}]}]},{"Id":11175,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"冬晓呈邻里"},"Clauses":[{"Content":"终夜寝衣冷，"},{"Content":"开门思曙光。"},{"Content":"空阶一丛叶，"},{"Content":"华室四邻霜。"},{"Content":"望阙觉天迥，"},{"Content":"忆山愁路荒。"},{"Content":"途中一留滞，","Comments":[{"Content":"一作中途","Type":"Text","Index":2}]},{"Content":"双鬓飒然苍。"}]},{"Id":11306,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"首冬寄河东昭德里书事贻郑损仓曹"},"Clauses":[{"Content":"清冬和暖天，"},{"Content":"老钝昼多眠。"},{"Content":"日爱闾巷静，"},{"Content":"每闻官吏贤。"},{"Content":"寒菹供家食，"},{"Content":"腐叶宿厨烟。","Comments":[{"Content":"一作药","Type":"Text","Index":2}]},{"Content":"且复执杯酒，"},{"Content":"无烦轻议边。"}]},{"Id":11314,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"寄赠畅当山居"},"Clauses":[{"Content":"古村荒石路，"},{"Content":"岁晏独言归。"},{"Content":"山雪厚三尺，"},{"Content":"社榆粗十围。"},{"Content":"虬龙宁守蛰，"},{"Content":"鸾鹤岂矜飞。"},{"Content":"君子固安分，"},{"Content":"毋听劳者讥。"}]},{"Id":11309,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"偶宿山中忆畅当"},"Clauses":[{"Content":"深山夜雪晴，"},{"Content":"坐忆晓山明。"},{"Content":"读易罢三卷，"},{"Content":"弹琴当五更。"},{"Content":"薜萝枯有影，"},{"Content":"嵓壑冻无声。"},{"Content":"此夕一相望，"},{"Content":"君应知我诚。"}]},{"Id":11194,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"行药前轩呈董山人"},"Clauses":[{"Content":"不觉老将至，"},{"Content":"瘦来方自惊。"},{"Content":"朝昏多病色，"},{"Content":"起坐有劳声。"},{"Content":"腠暖苦肌痒，","Comments":[{"Content":"一作体缓","Type":"Text","Index":2},{"Content":"一作睛","Type":"Text","Index":4}]},{"Content":"藏虚唯耳鸣。"},{"Content":"桑公富灵术，"},{"Content":"一为保馀生。"}]},{"Id":11325,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"新移北厅因贻同院诸公兼呈畅博士"},"Clauses":[{"Content":"华轩迩台座，"},{"Content":"顾影忝时伦。"},{"Content":"弱质偃弥旷，"},{"Content":"清风来亦频。"},{"Content":"恩辉坐凌迈，"},{"Content":"景物恣芳新。"},{"Content":"终乃愧吾友，"},{"Content":"无容私此身。"}]},{"Id":11319,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"喜从弟激初至"},"Clauses":[{"Content":"儒服策羸车，"},{"Content":"惠然过我庐。"},{"Content":"叙年惭已长，"},{"Content":"称从意何疏。"},{"Content":"作吏清无比，"},{"Content":"为文丽有馀。"},{"Content":"应嗤受恩者，"},{"Content":"头白读兵书。"}]},{"Id":11186,"Allusions":[{"AllusionIndex":255,"AllusionKey":"右军鹅","SentenceIndex":1},{"AllusionIndex":11048,"AllusionKey":"左慈","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"寻贾尊师"},"Clauses":[{"Content":"玉洞秦时客，"},{"Content":"焚香映绿萝。"},{"Content":"新传左慈诀，","Comments":[{"Content":"左慈","Type":"AllusionKey","Index":4}]},{"Content":"曾与右军鹅。","Comments":[{"Content":"右军鹅","Type":"AllusionKey","Index":5}]},{"Content":"井臼阴苔遍，"},{"Content":"方书古字多。"},{"Content":"成都今日雨，"},{"Content":"应与酒相和。"}]},{"Id":11312,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"宿澄上人院"},"Clauses":[{"Content":"竹窗闻远水，"},{"Content":"月出似溪中。"},{"Content":"香覆经年火，"},{"Content":"幡飘后夜风。"},{"Content":"性昏知道晚，"},{"Content":"学浅喜言同。"},{"Content":"一悟归身处，"},{"Content":"何山路不通。"}]},{"Id":11340,"Allusions":[{"AllusionIndex":9324,"AllusionKey":"谢家","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"题李沆林园"},"Clauses":[{"Content":"古巷牛羊出，"},{"Content":"重门接柳阴。"},{"Content":"闲看入竹路，"},{"Content":"自有向山心。"},{"Content":"种药齐幽石，"},{"Content":"耕田到远林。"},{"Content":"愿同词赋客，"},{"Content":"得兴谢家深。","Comments":[{"Content":"一作与","Type":"Text","Index":2},{"Content":"谢家","Type":"AllusionKey","Index":4}]}]},{"Id":11197,"Allusions":[{"AllusionIndex":2251,"AllusionKey":"德璋","SentenceIndex":3},{"AllusionIndex":10506,"AllusionKey":"张掾","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"过司空曙村居","Comments":[{"Content":"（一作冬夜宿司空曙野居因寄酬赠）。（一作韦应物诗）","Type":"Text","Index":6}]},"Clauses":[{"Content":"南北与山邻，"},{"Content":"蓬庵庇一身。"},{"Content":"繁霜疑有雪，"},{"Content":"枯草似无人。"},{"Content":"遂性在耕稼，","Comments":[{"Content":"一作存","Type":"Text","Index":3}]},{"Content":"所交唯贱贫。"},{"Content":"何言张掾傲，","Comments":[{"Content":"张掾","Type":"AllusionKey","Index":4}]},{"Content":"每重德璋亲。","Comments":[{"Content":"德璋","Type":"AllusionKey","Index":4}]}]},{"Id":11341,"Allusions":[{"AllusionIndex":726,"AllusionKey":"三径","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"蒸","Rank":0,"Title":{"Content":"题杨虢县竹亭"},"Clauses":[{"Content":"夜宿密公室，"},{"Content":"话馀将昼兴。"},{"Content":"绕阶三径雪，","Comments":[{"Content":"三径","Type":"AllusionKey","Index":4}]},{"Content":"当户一池冰。"},{"Content":"家训资风化，"},{"Content":"心源隐政能。"},{"Content":"明朝复何见，"},{"Content":"莱草古沟塍。","Comments":[{"Content":"一作叶","Type":"Text","Index":1}]}]},{"Id":11318,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"雪谤后逢李叔度"},"Clauses":[{"Content":"相逢空握手，"},{"Content":"往事不堪思。"},{"Content":"见少情难尽，"},{"Content":"愁深语自迟。"},{"Content":"草生分路处，"},{"Content":"雨散出山时。"},{"Content":"强得宽离恨，"},{"Content":"唯当说后期。"}]},{"Id":11223,"Allusions":[{"AllusionIndex":5025,"AllusionKey":"陶家","SentenceIndex":2},{"AllusionIndex":5263,"AllusionKey":"谢客","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"春日过李侍御","Comments":[{"Content":"一作郎","Type":"Text","Index":6}]},"Clauses":[{"Content":"高柳满春城，"},{"Content":"东园有鸟声。"},{"Content":"折花朝露滴，"},{"Content":"漱石野泉清。"},{"Content":"心许陶家醉，","Comments":[{"Content":"陶家","Type":"AllusionKey","Index":4}]},{"Content":"诗逢谢客呈。","Comments":[{"Content":"谢客","Type":"AllusionKey","Index":4}]},{"Content":"应怜末行吏，"},{"Content":"曾是鲁诸生。"}]},{"Id":11234,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"秋夜同畅当宿藏公院"},"Clauses":[{"Content":"礼足一垂泪，"},{"Content":"医王知病由。"},{"Content":"风萤方喜夜，"},{"Content":"露槿已伤秋。"},{"Content":"顾以儿童爱，","Comments":[{"Content":"一作童子","Type":"Text","Index":4}]},{"Content":"每从仁者求。"},{"Content":"将祈竟何得，","Comments":[{"Content":"一作来","Type":"Text","Index":2}]},{"Content":"灭迹在缁流。"}]}],"Count":337,"PageNo":3,"PageSize":20}