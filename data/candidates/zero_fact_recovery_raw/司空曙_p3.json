{"Authors":{"Names":["司空曙"],"AuthorIds":[13632],"Dynasties":["Tang"]},"ShiData":[{"Id":12197,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"齐","Rank":0,"Title":{"Content":"田家"},"Clauses":[{"Content":"田家喜雨足，"},{"Content":"邻老相招携。"},{"Content":"泉溢沟塍坏，"},{"Content":"麦高桑柘低。"},{"Content":"呼儿催放犊，"},{"Content":"宿客待烹鸡。","Comments":[{"Content":"一作邀","Type":"Text","Index":1}]},{"Content":"搔首蓬门下，"},{"Content":"如将轩冕齐。","Comments":[{"Content":"一作知","Type":"Text","Index":1}]}]},{"Id":12227,"Allusions":[{"AllusionIndex":1262,"AllusionKey":"祢生刺","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"送卢堪"},"Clauses":[{"Content":"羁贫不易去，"},{"Content":"此日始西东。"},{"Content":"旅舍秋霖叶，","Comments":[{"Content":"一作林夜","Type":"Text","Index":5}]},{"Content":"行人寒草风。","Comments":[{"Content":"一作塞","Type":"Text","Index":3}]},{"Content":"酒醒馀恨在，"},{"Content":"野饯暂游同。"},{"Content":"莫使祢生刺，","Comments":[{"Content":"祢生刺","Type":"AllusionKey","Index":5}]},{"Content":"空留怀袖中。"}]},{"Id":12242,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"送柳震入蜀"},"Clauses":[{"Content":"粉堞连青气，"},{"Content":"喧喧杂万家。"},{"Content":"夷人祠竹节，"},{"Content":"蜀鸟乳桐花。"},{"Content":"酒报新丰景，"},{"Content":"琴迎抵峡斜。"},{"Content":"多闻滞游客，"},{"Content":"不似在天涯。"}]},{"Id":12314,"Allusions":[{"AllusionIndex":1473,"AllusionKey":"陈农","SentenceIndex":1},{"AllusionIndex":2400,"AllusionKey":"寒笋出林","SentenceIndex":3},{"AllusionIndex":5802,"AllusionKey":"刘向","SentenceIndex":1}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"0","Rank":0,"Title":{"Content":"送李嘉祐正字括图书兼往扬州觐省"},"Clauses":[{"Content":"不事兰台贵，"},{"Content":"全多韦带风。"},{"Content":"儒官比刘向，","Comments":[{"Content":"刘向","Type":"AllusionKey","Index":5}]},{"Content":"使者得陈农。","Comments":[{"Content":"陈农","Type":"AllusionKey","Index":5}]},{"Content":"晚烧平芜外，"},{"Content":"朝阳叠浪东。"},{"Content":"归来喜调膳，"},{"Content":"寒笋出林中。","Comments":[{"Content":"寒笋出林","Type":"AllusionKey","Index":4}]}]},{"Id":12232,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"送刘侍御"},"Clauses":[{"Content":"狱成收夜烛，"},{"Content":"整豸出登车。"},{"Content":"黄叶辞荆楚，"},{"Content":"青山背汉初。"},{"Content":"早朝新羽卫，"},{"Content":"晚下步徒胥。"},{"Content":"应念长沙谪，"},{"Content":"思乡不食鱼。"}]},{"Id":12238,"Allusions":[{"AllusionIndex":3844,"AllusionKey":"何水曹","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"送庞判官赴黔中"},"Clauses":[{"Content":"天远风烟异，"},{"Content":"西南见一方。"},{"Content":"乱山来蜀道，"},{"Content":"诸水出辰阳。"},{"Content":"堆案青油暮，"},{"Content":"看棋画角长。"},{"Content":"论文谁可制，","Comments":[{"Content":"一作谕","Type":"Text","Index":1}]},{"Content":"记室有何郎。"}]},{"Id":12221,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"送人游岭南"},"Clauses":[{"Content":"万里南游客，"},{"Content":"交州见柳条。"},{"Content":"逢迎人易合，"},{"Content":"时日酒能消。"},{"Content":"浪晓浮青雀，"},{"Content":"风温解黑貂。"},{"Content":"囊金如未足，"},{"Content":"莫恨故乡遥。"}]},{"Id":12249,"Allusions":[{"AllusionIndex":10695,"AllusionKey":"中散诗","SentenceIndex":1}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"送曹同椅","Comments":[{"Content":"一作桐","Type":"Text","Index":3}]},"Clauses":[{"Content":"青春三十馀，","Comments":[{"Content":"一作山","Type":"Text","Index":2}]},{"Content":"众艺尽无如。"},{"Content":"中散诗传画，","Comments":[{"Content":"中散诗","Type":"AllusionKey","Index":3}]},{"Content":"将军扇续书。"},{"Content":"楚田晴下雁，"},{"Content":"江日暖游鱼。","Comments":[{"Content":"一作多","Type":"Text","Index":4}]},{"Content":"惆怅空相送，"},{"Content":"欢游自此疏。"}]},{"Id":12251,"Allusions":[{"AllusionIndex":451,"AllusionKey":"莱子","SentenceIndex":2},{"AllusionIndex":8628,"AllusionKey":"王祥","SentenceIndex":2}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"送鄂州张别驾襄阳觐省"},"Clauses":[{"Content":"苍苍岘亭路，","Comments":[{"Content":"一作峰","Type":"Text","Index":4}]},{"Content":"腊月汉阳春。","Comments":[{"Content":"一作江","Type":"Text","Index":4}]},{"Content":"带雪半山寺，"},{"Content":"行沙隔水人。"},{"Content":"王祥因就宦，","Comments":[{"Content":"王祥","Type":"AllusionKey","Index":2}]},{"Content":"莱子不违亲。","Comments":[{"Content":"莱子","Type":"AllusionKey","Index":2}]},{"Content":"正恨殊乡别，"},{"Content":"千条楚柳新。"}]},{"Id":12254,"Allusions":[{"AllusionIndex":4338,"AllusionKey":"惠连","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"送魏季羔游长沙觐兄","Comments":[{"Content":"一本无季字","Type":"Text","Index":9}]},"Clauses":[{"Content":"芦荻湘江水，"},{"Content":"萧萧万里秋。"},{"Content":"鹤高看迥野，"},{"Content":"蝉远入中流。"},{"Content":"访友多成滞，"},{"Content":"携家不厌游。"},{"Content":"惠连仍有作，","Comments":[{"Content":"惠连","Type":"AllusionKey","Index":2}]},{"Content":"知得从兄酬。"}]},{"Id":12187,"Allusions":[{"AllusionIndex":88,"AllusionKey":"骑省","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"九日洛东亭","Comments":[{"Content":"一作落","Type":"Text","Index":3}]},"Clauses":[{"Content":"风息斜阳尽，"},{"Content":"游人曲落间。"},{"Content":"采花因覆酒，"},{"Content":"行草转看山。"},{"Content":"柳散新霜下，"},{"Content":"天晴早雁还。"},{"Content":"伤秋非骑省，","Comments":[{"Content":"骑省","Type":"AllusionKey","Index":5}]},{"Content":"玄发白成斑。"}]},{"Id":12188,"Allusions":[{"AllusionIndex":214,"AllusionKey":"冠豸","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"Title":{"Content":"九日送人"},"Clauses":[{"Content":"送人冠獬豸，"},{"Content":"值节佩茱萸。"},{"Content":"均覆徵三壤，"},{"Content":"登车出五湖。"},{"Content":"水风凄落日，"},{"Content":"岸叶飒衰芜。"},{"Content":"自恨尘中使，"},{"Content":"何因在路隅。"}]},{"Id":12256,"Allusions":[{"AllusionIndex":284,"AllusionKey":"驻隙","SentenceIndex":0},{"AllusionIndex":5223,"AllusionKey":"君子墓","SentenceIndex":3},{"AllusionIndex":10518,"AllusionKey":"漳滨卧","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"哭王注"},"Clauses":[{"Content":"已叹漳滨卧，","Comments":[{"Content":"漳滨卧","Type":"AllusionKey","Index":5}]},{"Content":"何言驻隙难。","Comments":[{"Content":"驻隙","Type":"AllusionKey","Index":4}]},{"Content":"异才伤促短，"},{"Content":"诸友哭门阑。"},{"Content":"古道松声暮，"},{"Content":"荒阡草色寒。"},{"Content":"延陵今葬子，"},{"Content":"空使鲁人观。"}]},{"Id":12269,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"遇谷口道士"},"Clauses":[{"Content":"一见林中客，"},{"Content":"闲知州县劳。"},{"Content":"白云秋色远，"},{"Content":"苍岭夕阳高。"},{"Content":"自说名因石，"},{"Content":"谁逢手种桃。"},{"Content":"丹经傥相授，"},{"Content":"何用恋青袍。"}]},{"Id":12267,"Allusions":[{"AllusionIndex":1099,"AllusionKey":"蔡家亲","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"喜外弟卢纶见宿","Comments":[{"Content":"一作访","Type":"Text","Index":6}]},"Clauses":[{"Content":"静夜四无邻，"},{"Content":"荒居旧业贫。"},{"Content":"雨中黄叶树，"},{"Content":"灯下白头人。"},{"Content":"以我独沈久，"},{"Content":"愧君相见频。"},{"Content":"平生自有分，","Comments":[{"Content":"一作有深","Type":"Text","Index":4}]},{"Content":"况是蔡家亲。","Comments":[{"Content":"蔡家亲","Type":"AllusionKey","Index":5}]}],"Comments":[{"Book":"《对床夜语》","Content":"诗人发兴遣语，往往不约而合。如“雨中山果落，灯下草虫鸣”，王维也。“树初黄叶日，人欲白头时”，乐天也。司空曙有云：“雨中黄叶树，灯下白头人”，句法王而意参白，然诗家不以为袭也。","IsComment":false,"FullPath":"《对床夜语》"},{"Book":"《四溟诗话》","Content":"韦苏州曰“窗里人将老，门前树已秋”。白乐天曰：“树初黄叶日，人欲白头时”。司空曙曰：“雨中黄叶树，灯下白头人”。三诗同一机抒，司空为优，善状目前之景，无限凄感，见乎言表。又：晚唐人多用虚字，若司空曙“以我独沉久，愧君相见频”……此皆一句一意，虽瘦而健，虽粗而雅。","IsComment":false,"FullPath":"《四溟诗话》"},{"Book":"《唐诗选脉会通评林》","Content":"周珽曰：深情剀切。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《历代诗法》","Content":"得浩然之神髓。","IsComment":false,"FullPath":"《历代诗法》"},{"Book":"《唐诗三百首》","Content":"十字八层（“两中”一联下）。","IsComment":false,"FullPath":"《唐诗三百首》"},{"Book":"《唐宋诗举要》","Content":"三、四名句，“雨中”、“灯下”虽与王摩诘相犯，而意境各自不同，正不为病。","IsComment":false,"FullPath":"《唐宋诗举要》"},{"Book":"唐诗鉴赏辞典","Content":"司空曙和卢纶都在“大历十才子”之列，诗歌工力相匹，又是表兄弟。从这首诗，尤其是末联“平生自有分（情谊），况是蔡家亲（羊祜为蔡邕外孙，因称表亲为蔡家亲）”，可以看见他俩的亲密关系和真挚情谊；而且可以感受到作者生活境遇的悲凉。据《唐才子传》卷四载，司空曙“磊落有奇才”，但因为“性耿介，不干权要”，所以落得宦途坎坷，家境清寒。这首诗正是作者这种境遇的写照。<br /><br />前四句描写静夜里的荒村，陋室内的贫士，寒雨中的黄叶，昏灯下的白发，通过这些，构成一个完整的生活画面。这画面充满着辛酸和悲哀。后四句直揭诗题，写表弟卢纶来访见宿，在悲凉之中见到知心亲友，因而喜出望外。近人俞陛云《诗境浅说》说，这首诗“前半首写独处之悲，后言相逢之喜，反正相生，为律诗一格”。从章法上看，确是如此。前半首和后半首，一悲一喜，悲喜交感，总的倾向是统一于悲。后四句虽然写“喜”，却隐约透露出“悲”；“愧君相见频”中的一个“愧”字，就表现了悲凉的心情。因之，题中虽着“喜”字，背后却有“悲”的滋味。一正一反，互相生发，互相映衬，使所要表现的主旨更深化了，更突出了。这就是“反正相生”手法的艺术效果。<br /><br />比兴兼用，也是这首诗重要的艺术手法。“雨中黄叶树，灯下白头人”，不是单纯的比喻，而是进一步利用作比的形象来烘托气氛，特别富有诗味，成了著名的警句。用树之落叶来比喻人之衰老，是颇为贴切的。树叶在秋风中飘落，和人的风烛残年正相类似，相似点在衰飒。这里，树作为环境中的景物，起了气氛烘托的作用，类似起兴。自从宋玉《九辩》提出“悲哉秋之为气也，萧瑟兮草木摇落而变衰”，秋风落叶，常常被用以塑造悲的气氛，“黄叶树”自然也烘托了悲的情绪。比兴兼用，所以特别富有艺术感染力。明谢榛《四溟诗话》卷一云：“韦苏州曰：‘窗里人将老，门前树已秋。’白乐天曰：‘树初黄叶日，人欲白头时。’司空曙曰：‘雨中黄叶树，灯下白头人。’三诗同一机杼，司空为优：善状目前之景，无限凄感，见乎言表。”其实，三诗之妙，不只是善于状景物，而且还善于设喻。司空曙此诗颔联之所以“为优”，在于比韦应物、白居易诗多了雨景和昏灯这两层意思，虽然这两层并无“比”的作用，却大大加强了悲凉的气氛。高步瀛《唐宋诗举要》说：“‘雨中’‘灯下’虽与王摩诘相犯，而意境各自不同，正不为病。”王维《秋夜独坐》：“雨中山果落，灯下草虫鸣。”这两句纯属白描，是赋体，并不兼比；不仅意境不同，手法亦自有别。马戴《灞上秋居》：“落叶他乡树，寒灯独夜人。”语虽近似司空曙，但手法也并不一样，这里只写灞上秋居漂泊异乡孤独寂寞的情景，不曾以树喻人，没有比的意思。司空曙“雨中”、“灯下”两句之妙，就在于运用了兴而兼比的艺术手法。<br /><br />（林东海）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]},{"Id":12266,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"深上人见访忆李端"},"Clauses":[{"Content":"雁稀秋色尽，"},{"Content":"落日对寒山。"},{"Content":"避事多称疾，"},{"Content":"留僧独闭关。"},{"Content":"心归尘俗外，"},{"Content":"道胜有无间。"},{"Content":"仍忆东林友，"},{"Content":"相期久不还。"}]},{"Id":12270,"Classes":["軍旅 邊關"],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"塞下曲","Comments":[{"Content":"一作上","Type":"Text","Index":2}]},"Clauses":[{"Content":"寒柳接胡桑，"},{"Content":"军门向大荒。"},{"Content":"幕营随月魄，"},{"Content":"兵气长星芒。"},{"Content":"横吹催春酒，"},{"Content":"重裘隔夜霜。"},{"Content":"冰开不防虏，"},{"Content":"青草满辽阳。"}]},{"Id":12282,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"题鲜于秋林园","Comments":[{"Content":"一作映","Type":"Text","Index":4}]},"Clauses":[{"Content":"雨后园林好，"},{"Content":"幽行迥野通。","Comments":[{"Content":"一作回，一作向","Type":"Text","Index":3}]},{"Content":"远山芳草外，"},{"Content":"流水落花中。"},{"Content":"客醉悠悠惯，"},{"Content":"莺啼处处同。"},{"Content":"夕阳自一望，","Comments":[{"Content":"一作伤春","Type":"Text","Index":2}]},{"Content":"日暮杜陵东。"}]},{"Id":12217,"Allusions":[{"AllusionIndex":2433,"AllusionKey":"卖瓜侯","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"独游寄卫长林"},"Clauses":[{"Content":"草绿春阳动，"},{"Content":"迟迟泽畔游。"},{"Content":"恋花同野蝶，"},{"Content":"爱水剧江鸥。"},{"Content":"身外唯须醉，"},{"Content":"人间尽是愁。","Comments":[{"Content":"一作半","Type":"Text","Index":3}]},{"Content":"那知鸣玉者，"},{"Content":"不羡卖瓜侯。","Comments":[{"Content":"卖瓜侯","Type":"AllusionKey","Index":5}]}]},{"Id":12264,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"望水"},"Clauses":[{"Content":"高楼晴见水，","Comments":[{"Content":"一作原","Type":"Text","Index":2}]},{"Content":"楚色霭相和。"},{"Content":"野极空如练，","Comments":[{"Content":"一作雪","Type":"Text","Index":5}]},{"Content":"天遥不辨波。"},{"Content":"永无人迹到，"},{"Content":"时有鸟行过。"},{"Content":"况是苍茫外，"},{"Content":"残阳照最多。","Comments":[{"Content":"一作更","Type":"Text","Index":4}]}]}],"Count":165,"PageNo":3,"PageSize":20}