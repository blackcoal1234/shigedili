{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80813,"Classes":["軍旅 送行","軍旅 太平"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"送龚章判官之卫州","Comments":[{"Content":"新及第","Type":"Text","Index":8}]},"Clauses":[{"Content":"几砚昔年游，"},{"Content":"于今成十秋。"},{"Content":"松坚终发石，"},{"Content":"鱼变即辞流。"},{"Content":"近郡无飞檄，"},{"Content":"清时不借筹。"},{"Content":"淇园春竹美，"},{"Content":"军宴日椎牛。"}]},{"Id":81044,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"送王瓘同年河南府司录","Comments":[{"Content":"字文王，（原作正，据陈本改）先君尝为此官","Type":"Text","Index":10}]},"Clauses":[{"Content":"䌽服昔为儿，"},{"Content":"随亲宦洛师。"},{"Content":"至今馀梦想，"},{"Content":"常记旧游嬉。"},{"Content":"佐史头应白，"},{"Content":"书楼树已攲。"},{"Content":"闻君行有日，"},{"Content":"使我泪交颐。"}]},{"Id":81550,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"送王彦臣同年通判亳州","Comments":[{"Content":"字伯逢","Type":"Text","Index":10}]},"Clauses":[{"Content":"先朝御六飞，"},{"Content":"亲谒濑乡祠。"},{"Content":"牛酒当时惠，"},{"Content":"衣冠此日思。"},{"Content":"仙踪丹有灶，"},{"Content":"天瑞桧生枝。"},{"Content":"圣主怜耆旧，"},{"Content":"题舆得吏师。"}]},{"Id":80802,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"正月二十四日夜雪"},"Clauses":[{"Content":"叠瓦浮轻雪，"},{"Content":"参差粉画难。"},{"Content":"苦欺初变柳，"},{"Content":"故压未生兰。"},{"Content":"夜色微分白，"},{"Content":"春容不受寒。"},{"Content":"即为花卉夺，"},{"Content":"犹得暂供看。"}]},{"Id":81096,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"送峡州陈廉秘丞"},"Clauses":[{"Content":"郡府猿声外，"},{"Content":"旌旗鸟道边。"},{"Content":"楼高出楚塞，"},{"Content":"烟霁识巴船。"},{"Content":"襦裤嗟来暮，"},{"Content":"簪绅惜外迁。"},{"Content":"皇仁矜远俗，"},{"Content":"非谓意疏贤。"}]},{"Id":81095,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"送峡州陈廉秘丞"},"Clauses":[{"Content":"地险三巴口，"},{"Content":"江流百折蟠。"},{"Content":"驺珂通峡响，"},{"Content":"门戟照秋寒。"},{"Content":"翠壁虎牙石，"},{"Content":"素花狼尾滩。"},{"Content":"孙刘置栅处，"},{"Content":"细为写图看。"}]},{"Id":81188,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"雪中寻友人不遇"},"Clauses":[{"Content":"拥袖犯风雪，"},{"Content":"驱车行诣谁。"},{"Content":"朱门不可入，"},{"Content":"素友复难期。"},{"Content":"依世诚多拙，"},{"Content":"迷方忽自悲。"},{"Content":"褊心终寡合，"},{"Content":"吾道易参差。"}]},{"Id":80830,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"早春寄东郡旧同僚"},"Clauses":[{"Content":"楼台带馀雪，"},{"Content":"寒色未全收。"},{"Content":"久负入关意，"},{"Content":"空为同舍羞。"},{"Content":"清樽接胜友，"},{"Content":"飞盖从贤侯。"},{"Content":"应恨春来晚，","Comments":[{"Content":"原作限，据陈本、四库本改","Type":"Text","Index":2}]},{"Content":"烟林已数游。"}]},{"Id":81184,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"渔父"},"Clauses":[{"Content":"楚岸橘花香，"},{"Content":"扁舟泛渺茫。"},{"Content":"短蓑冲密雨，"},{"Content":"素发净秋霜。"},{"Content":"烟外鸣桹远，"},{"Content":"波间掷线长。"},{"Content":"无人识名姓，"},{"Content":"击楫入沧浪。","Comments":[{"Content":"原作汰，据陈本、四库本改","Type":"Text","Index":2}]}]},{"Id":80829,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"早春"},"Clauses":[{"Content":"璿霄转斗车，"},{"Content":"春意逼梅花。"},{"Content":"熟寐侵街鼓，"},{"Content":"闲情到酒家。"},{"Content":"晴阳浮地末，"},{"Content":"寒色敛天涯。"},{"Content":"归雁空馀迹，"},{"Content":"朝来印浦沙。"}]},{"Id":80755,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"山中早春"},"Clauses":[{"Content":"山木欣欣意，"},{"Content":"春光次第催。"},{"Content":"攲巾望归雁，"},{"Content":"伏槛听新雷。"},{"Content":"岩静闻冰折，"},{"Content":"巢空喜燕来。"},{"Content":"涧花从寂寞，"},{"Content":"亦向草堂开。"}]},{"Id":81256,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"赠学仙者"},"Clauses":[{"Content":"微径透重峦，"},{"Content":"茅堂竹叶冠。"},{"Content":"方瞳映骨静，"},{"Content":"秀气逼人寒。"},{"Content":"夜火装丹灶，"},{"Content":"晴霜醮石坛。"},{"Content":"不须惊浅俗，"},{"Content":"轻举入云端。"}]},{"Id":81138,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"留别友生"},"Clauses":[{"Content":"野际共为别，"},{"Content":"客亭芳草新。"},{"Content":"何心更执酒，"},{"Content":"满目尽伤春。"},{"Content":"今古无穷路，"},{"Content":"东西相背尘。"},{"Content":"行行复回首，"},{"Content":"不欲着鞭频。"}]},{"Id":81028,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"贻宋四行简迪"},"Clauses":[{"Content":"离群如几辰，"},{"Content":"屈指十青春。"},{"Content":"不意轮蹄迹，"},{"Content":"共兹京洛尘。"},{"Content":"文场投漆契，"},{"Content":"客路转蓬身。"},{"Content":"别易相逢阔，"},{"Content":"过从莫厌频。"}]},{"Id":80842,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"自嘲"},"Clauses":[{"Content":"盘飧罗新蔬，"},{"Content":"充腹不求馀。"},{"Content":"穷巷昼扃户，"},{"Content":"闲轩卧读书。"},{"Content":"有心齐塞马，"},{"Content":"无意羡川鱼。"},{"Content":"世道方邀逐，"},{"Content":"如君术已疏。"}]},{"Id":81608,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"雪寒取酒"},"Clauses":[{"Content":"雪意久未就，"},{"Content":"寒云低不收。"},{"Content":"飘扬插孤帜，"},{"Content":"迢递映高楼。"},{"Content":"试假贤人浊，"},{"Content":"聊攻客子愁。"},{"Content":"呼僮携小榼，"},{"Content":"更准黑貂裘。"}]},{"Id":81072,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"送吴辨叔大名司户"},"Clauses":[{"Content":"元宰司宫钥，"},{"Content":"旌旄压大河。"},{"Content":"敢言趋府倦，"},{"Content":"私叹折腰多。"},{"Content":"机发何妨避，"},{"Content":"光尘未免和。"},{"Content":"艰难方远到，"},{"Content":"庆阀肯蹉跎。"}]},{"Id":81071,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"送吴辨叔大名司户"},"Clauses":[{"Content":"致远必自近，"},{"Content":"如君岂椽曹。"},{"Content":"鱼龙试春浪，"},{"Content":"松栝露秋毫。"},{"Content":"错落辞华富，"},{"Content":"䃘𥐪气节高。"},{"Content":"垂天起肤寸，","Comments":[{"Content":"此句原缺，据陈本、四库本补","Type":"Text","Index":5}]},{"Content":"无叹走尘劳。"}]},{"Id":81060,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"送杨太祝知长洲县","Comments":[{"Content":"忱","Type":"Text","Index":4}]},"Clauses":[{"Content":"三吴佳县首，"},{"Content":"民物旧熙熙。"},{"Content":"专用清谈治，"},{"Content":"非如俗吏为。"},{"Content":"林疏丹橘迥，"},{"Content":"稻熟白芒攲。"},{"Content":"宜使民无忘，"},{"Content":"严修太伯祠。"}]},{"Id":80758,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"马病"},"Clauses":[{"Content":"羸病何其久，"},{"Content":"仁心到栈频。"},{"Content":"须怜苜蓿歉，"},{"Content":"当认主人贫。"},{"Content":"客舍同萧索，"},{"Content":"山程共苦辛。"},{"Content":"未能逢伯乐，"},{"Content":"且可自相亲。"}]}],"Count":1270,"PageNo":5,"PageSize":20}