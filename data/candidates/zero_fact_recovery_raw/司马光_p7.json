{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":81572,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"送聂之美任鸡泽令"},"Clauses":[{"Content":"赵魏高气侠，"},{"Content":"到今风俗然。"},{"Content":"椎埋吏难禁，"},{"Content":"击断世称贤。"},{"Content":"明府宜更瑟，"},{"Content":"罢民庶息肩。"},{"Content":"无如茧丝者，"},{"Content":"急敛纵敲鞭。"}]},{"Id":81190,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"馆宿遇雨怀诸同舍"},"Clauses":[{"Content":"佳雨濯烦暑，"},{"Content":"翛然生晓凉。"},{"Content":"森沈殿瓦碧，"},{"Content":"羃历井苔苍。"},{"Content":"院静杉篁秀，"},{"Content":"人闲钟鼓长。"},{"Content":"凭谁同把酒，"},{"Content":"清兴窅相望。"}]},{"Id":80998,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"宣徽使河东经略使郑文肃公挽歌"},"Clauses":[{"Content":"璿玑敷帝命，"},{"Content":"金节护边兵。"},{"Content":"尽付将军制，"},{"Content":"真为儒者荣。"},{"Content":"扶摇方上击，"},{"Content":"濛汜忽西倾。"},{"Content":"罢市人相吊，"},{"Content":"纷纷满百城。"}]},{"Id":80997,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"宣徽使河东经略使郑文肃公挽歌"},"Clauses":[{"Content":"柳翣丧容盛，"},{"Content":"江山故国遥。"},{"Content":"清时独长往，"},{"Content":"何日重来朝。"},{"Content":"事与秋云断，"},{"Content":"荣如晓梦消。"},{"Content":"西风虎丘路，"},{"Content":"马鬣又嶕峣。"}]},{"Id":81312,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"又代孙检讨作二首","Comments":[{"Content":"瑜，字叔礼","Type":"Text","Index":5}]},"Clauses":[{"Content":"湖澄翠岫孤，"},{"Content":"胜地古东吴。"},{"Content":"气象常时秀，"},{"Content":"英灵何世无。"},{"Content":"金闺演王綍，"},{"Content":"玉帐绾兵符。"},{"Content":"炜烨照乡曲，"},{"Content":"从兹益重儒。"}]},{"Id":80739,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"又代孙检讨作二首","Comments":[{"Content":"瑜，字叔礼","Type":"Text","Index":5}]},"Clauses":[{"Content":"人为天地客，"},{"Content":"处世若浮休。"},{"Content":"岂有生长在，"},{"Content":"祗知名可留。"},{"Content":"露沾寒草晚，"},{"Content":"风啸白杨秋。"},{"Content":"地下求文友，"},{"Content":"应从顾陆游。"}]},{"Id":80981,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"苦雨"},"Clauses":[{"Content":"积雨欲侵旬，"},{"Content":"朝晡漫不分。"},{"Content":"苍凉微露日，"},{"Content":"惨澹已生云。"},{"Content":"地半成泥滓，"},{"Content":"天应厌垢氛。"},{"Content":"时闻度鸧鸹，"},{"Content":"空外自为群。"}]},{"Id":80786,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"代叔礼作使北诗"},"Clauses":[{"Content":"人主爱民物，"},{"Content":"心无彼此情。"},{"Content":"约欢同一国，"},{"Content":"蒙福遍群生。"},{"Content":"玉帛遥相望，"},{"Content":"风波寂不惊。"},{"Content":"熙熙南北海，"},{"Content":"所至尽升平。"}]},{"Id":80740,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"又击毬"},"Clauses":[{"Content":"肃奉乘轺命，"},{"Content":"仍陪戏马游。"},{"Content":"朋分初迥出，"},{"Content":"势合复相收。"},{"Content":"顾盼华星激，"},{"Content":"萦回紫电流。"},{"Content":"良因重嘉好，"},{"Content":"礼接使臣优。"}]},{"Id":81064,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"送计先辈尉宗城","Comments":[{"Content":"泰符","Type":"Text","Index":4}]},"Clauses":[{"Content":"红尘久帝城，"},{"Content":"高价动公卿。"},{"Content":"竹柏寒方茂，"},{"Content":"骅骝老更成。"},{"Content":"冰霜驱马瘦，"},{"Content":"书剑束装轻。"},{"Content":"丞相虚东阁，"},{"Content":"遥知倒屣迎。"}]},{"Id":81104,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"送赵殿丞归成都","Comments":[{"Content":"象，字子舆","Type":"Text","Index":4},{"Content":"祀明堂礼毕，子舆新升朝，以恩官其父大理评事，赐告归宁，得其除书以俱。二三同舍为诗以纪其美，仆得回字","Type":"Text","Index":7}]},"Clauses":[{"Content":"蜀栈锦衣来，"},{"Content":"高堂绶笥开。"},{"Content":"恩辉同日至，"},{"Content":"喜色共春回。"},{"Content":"驷马过邻社，"},{"Content":"朝裾捧寿杯。"},{"Content":"吾生无此乐，"},{"Content":"空使寸心摧。"}]},{"Id":81077,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"送张都官江南东路提刑","Comments":[{"Content":"肃，字子庄","Type":"Text","Index":4},{"Content":"得前字","Type":"Text","Index":10}]},"Clauses":[{"Content":"楚俗号难治，"},{"Content":"司刑尤择贤。"},{"Content":"危疑片言决，"},{"Content":"舒惨一方专。"},{"Content":"松不彫寒色，"},{"Content":"丝曾断直弦。"},{"Content":"清风过江外，"},{"Content":"应在下车前。","Comments":[{"Content":"以上《温国文正司马公文集》卷七","Type":"Text","Index":5}]}]},{"Id":81259,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"赠清衍","Comments":[{"Content":"原作行，据陈本改","Type":"Text","Index":3}]},"Clauses":[{"Content":"我厌俗缘苦，"},{"Content":"空为薄宦牵。"},{"Content":"如师真达者，"},{"Content":"于世亦超然。"},{"Content":"敝笠冲尘陌，"},{"Content":"寒云拥雪天。"},{"Content":"崎岖远相顾，"},{"Content":"深愧此心专。"}]},{"Id":80959,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"和道粹春寒趋馆马上口占"},"Clauses":[{"Content":"残腊尚要春，"},{"Content":"清寒更著人。"},{"Content":"雪华犹惜别，"},{"Content":"物意倍添新。"},{"Content":"云压宫城重，"},{"Content":"风调玉漏匀。"},{"Content":"行游宜结辔，"},{"Content":"九陌未多尘。"}]},{"Id":80817,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"同次道元日宿尚书省听戒誓寄常州卲不疑","Comments":[{"Content":"去岁是日，次道同不疑斋直","Type":"Text","Index":18}]},"Clauses":[{"Content":"椒花献岁新，"},{"Content":"瑄玉侍祠频。"},{"Content":"此夕同华省，"},{"Content":"非才愧后尘。"},{"Content":"江风迎茜旆，"},{"Content":"沙雨待朱轮。"},{"Content":"不比斋宫冷，"},{"Content":"端居弃掷春。"}]},{"Id":81010,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"盐","Rank":0,"Title":{"Content":"春祠致斋寄呈景仁次道"},"Clauses":[{"Content":"比日聚官舍，"},{"Content":"笑言曾未厌。"},{"Content":"暂成挥手别，"},{"Content":"各有侍祠严。"},{"Content":"晴景朝朝丽，"},{"Content":"春容物物添。"},{"Content":"解斋当共醉，"},{"Content":"莫遣此期淹。"}]},{"Id":81042,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"送王殿丞西京签判","Comments":[{"Content":"恪","Type":"Text","Index":4}]},"Clauses":[{"Content":"清白世风存，"},{"Content":"王公复有孙。"},{"Content":"挺生如玉树，"},{"Content":"不竭似淮源。"},{"Content":"日背嵩峰紫，"},{"Content":"春添洛水喧。"},{"Content":"幕中多胜友，"},{"Content":"肯使负芳樽。"}]},{"Id":81112,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"送谢都官知光化军","Comments":[{"Content":"顗","Type":"Text","Index":4}]},"Clauses":[{"Content":"厩吏整车马，"},{"Content":"匆匆办晓装。"},{"Content":"青緺出阊阖，"},{"Content":"朱旆指沧浪。"},{"Content":"野店杏初发，"},{"Content":"津亭柳已黄。"},{"Content":"行行不可驻，"},{"Content":"犹及劝耕桑。"}]},{"Id":80731,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"二月二日太常致斋晨起呈景仁次道二同舍","Comments":[{"Content":"原作一，据陈本改","Type":"Text","Index":3}]},"Clauses":[{"Content":"官舍春萧瑟，"},{"Content":"朝来尚薄寒。"},{"Content":"人虽繁陌上，"},{"Content":"尘不近门端。"},{"Content":"已负踏青约，","Comments":[{"Content":"自注：同舍先有是约。","Type":"Text","Index":5}]},{"Content":"仍无举白欢。","Comments":[{"Content":"自注：从次道求酒不获，故云。","Type":"Text","Index":5}]},{"Content":"凭君御沟上，"},{"Content":"试折柳条看。"}]},{"Id":81054,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"送刘观察知洺州","Comments":[{"Content":"从广","Type":"Text","Index":4}]},"Clauses":[{"Content":"汉家英俊士，"},{"Content":"衮衮出金阊。"},{"Content":"久袭通侯籍，"},{"Content":"新腰太守章。"},{"Content":"畛封连故赵，"},{"Content":"庐井带清漳。"},{"Content":"春色迎铙吹，"},{"Content":"应忘道路长。"}]}],"Count":1270,"PageNo":7,"PageSize":20}