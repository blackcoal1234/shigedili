{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":536063,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"写怀二首","Comments":[{"Content":"元刻本作寓","Type":"Text","Index":1}]},"Clauses":[{"Content":"淡月疏云九月天，"},{"Content":"醉霜危叶坠江寒。"},{"Content":"孤窗镇日无聊赖，"},{"Content":"编辑诗词改抹看。"}]},{"Id":536064,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"写怀二首","Comments":[{"Content":"元刻本作寓","Type":"Text","Index":1}]},"Clauses":[{"Content":"菊有黄花离槛边，"},{"Content":"怨鸿声重下寒天。"},{"Content":"偏宜小阁幽窗下，"},{"Content":"独自烧香独自眠。"}]},{"Id":536066,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"秋日偶成"},"Clauses":[{"Content":"初合双鬟学画眉，"},{"Content":"未知心事属他谁。"},{"Content":"待将满抱中秋月，"},{"Content":"分付萧郎万首诗。"}]},{"Id":536067,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"秋日晚望"},"Clauses":[{"Content":"烟浓难认别州山，"},{"Content":"彷佛鸥群浴远滩。"},{"Content":"一点客帆摇动处，"},{"Content":"排云给日弄先寒。","Comments":[{"Content":"元刻本作光","Type":"Text","Index":6}]}]},{"Id":536068,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"江","Title":{"Content":"秋夜牵情三首"},"Clauses":[{"Content":"檐外秋清绣绮窗，"},{"Content":"菊烟月露冷浮香。"},{"Content":"寒更二十五声点，"},{"Content":"相应愁情尔许长。"}]},{"Id":536069,"GroupIndex":3,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"秋夜牵情三首"},"Clauses":[{"Content":"闲闷闲愁百病生，"},{"Content":"有情终不似无情。"},{"Content":"风流意思镌磨尽，"},{"Content":"离别肝肠铸写成。"}]},{"Id":536070,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"咏桂四首","Comments":[{"Content":"题原缺，据本集目录补","Type":"Text","Index":4}]},"Clauses":[{"Content":"弹压西风擅众芳，"},{"Content":"十分秋色为君忙。"},{"Content":"一枝淡贮书窗下，"},{"Content":"人与花心各自香。"}]},{"Id":536071,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"咏桂四首","Comments":[{"Content":"题原缺，据本集目录补","Type":"Text","Index":4}]},"Clauses":[{"Content":"移根蟾窟不寻常，"},{"Content":"枝叶犹垂月露香。"},{"Content":"可笑当年陶靖节，"},{"Content":"东篱犹带菊花黄。"}]},{"Id":536072,"GroupIndex":3,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"咏桂四首","Comments":[{"Content":"题原缺，据本集目录补","Type":"Text","Index":4}]},"Clauses":[{"Content":"酷爱清香折一枝，"},{"Content":"故簪香髻蓦思维。"},{"Content":"若教水月浮清浅，"},{"Content":"消得林逋两句诗。"}]},{"Id":536073,"GroupIndex":4,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"Title":{"Content":"咏桂四首","Comments":[{"Content":"题原缺，据本集目录补","Type":"Text","Index":4}]},"Clauses":[{"Content":"月待圆时花正好，"},{"Content":"花将残后月还亏。"},{"Content":"须知天上人间物，"},{"Content":"同禀秋清在一时。"}]},{"Id":536075,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"Title":{"Content":"白菊"},"Clauses":[{"Content":"回旋秋色漙清露，"},{"Content":"淩厉西风紫嫩霜。","Comments":[{"Content":"元刻本作洁","Type":"Text","Index":5}]},{"Content":"莫作东篱等闲看，"},{"Content":"下清曾借广寒香。","Comments":[{"Content":"武林本作下情，元刻本作清新","Type":"Text","Index":2},{"Content":"以上《新注朱淑真断肠诗集》前集卷六，总题秋景","Type":"Text","Index":7}]}]},{"Id":96194,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"冬日梅窗书事四首"},"Clauses":[{"Content":"明窗莹几净无尘，"},{"Content":"月映幽窗夜色新。"},{"Content":"惟有梅花无限意，"},{"Content":"射人又放一枝春。","Comments":[{"Content":"武林本作对人先","Type":"Text","Index":3}]}],"Comments":[{"Book":"朱淑真集","Content":"【校】[莹几]《古今女史》作[净几]。[无限意] 《古今女史》作[消息早]。[射人]《古今女史》　《武林》本作[对人]。[又放] 《古今女史》　《武林》本作[先放]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96195,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"冬日梅窗书事四首"},"Clauses":[{"Content":"爱日烘檐暖似春，"},{"Content":"梅花描摸雪精神。"},{"Content":"清香未寄江南梦，"},{"Content":"偏恼幽闲独睡人。"}]},{"Id":96196,"GroupIndex":3,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"Title":{"Content":"冬日梅窗书事四首"},"Clauses":[{"Content":"病起眼前俱不喜，"},{"Content":"可人唯有一枝梅。"},{"Content":"未容明月横疏影，"},{"Content":"且得清香寄酒杯。"}]},{"Id":96197,"GroupIndex":4,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"冬日梅窗书事四首"},"Clauses":[{"Content":"的皪江梅浅浅春，"},{"Content":"小窗相对自清新。"},{"Content":"幽香特地成牵役，"},{"Content":"不似梨花入梦频。"}]},{"Id":96187,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"二色梅"},"Clauses":[{"Content":"缀雪融酥各自芳，"},{"Content":"两般颜色一般香。"},{"Content":"瑶池会罢朝元客，"},{"Content":"缟素仙裳问道装。"}]},{"Id":536076,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"Title":{"Content":"山脚有梅一株地差背阴冬深初结蕊作绝句寄之"},"Clauses":[{"Content":"溪桥野店梅都绽，"},{"Content":"此地冬深尚未寒。"},{"Content":"寄语梅花且宁奈，"},{"Content":"枝头无雪不堪看。"}]},{"Id":536077,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"雪夜对月赋诗"},"Clauses":[{"Content":"一树梅花雪月间，"},{"Content":"梅清月皎雪光寒。"},{"Content":"看来表里俱清彻，"},{"Content":"酌酒吟诗兴尽宽。"}]},{"Id":536078,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"欲雪"},"Clauses":[{"Content":"寒雀无声满竹篱，"},{"Content":"冻云四羃雪将垂。","Comments":[{"Content":"原作暮，据武林本改","Type":"Text","Index":4}]},{"Content":"北风不看人情面，"},{"Content":"控勒梅花不放枝。"}]},{"Id":536082,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"围炉"},"Clauses":[{"Content":"圜坐红炉唱小词，"},{"Content":"旋篘新酒赏新诗。"},{"Content":"大家莫惜今宵醉，"},{"Content":"一别参差又几时。"}]}],"Count":367,"PageNo":9,"PageSize":20}