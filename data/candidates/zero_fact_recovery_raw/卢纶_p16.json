{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11397,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"孤松吟詶浑赞善"},"Clauses":[{"Content":"深山荒松枝，"},{"Content":"雪压半离披。"},{"Content":"朱门青松树，"},{"Content":"万叶承清露。","Comments":[{"Content":"一作乘","Type":"Text","Index":3}]},{"Content":"露重色逾鲜，"},{"Content":"吟风似远泉。"},{"Content":"天寒香自发，"},{"Content":"日丽影常圆。"},{"Content":"阴郊一夜雪，"},{"Content":"榆柳皆枯折。"},{"Content":"回首望君家，"},{"Content":"翠盖满琼花。"},{"Content":"捧君青松曲，"},{"Content":"自顾同衰木。"},{"Content":"曲罢不相亲，"},{"Content":"深山头白人。"}]},{"Id":11385,"Allusions":[{"AllusionIndex":6081,"AllusionKey":"鸾鹤","SentenceIndex":14}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"太白西峰偶宿车祝二尊师石室晨登前巘凭眺书怀即事寄呈凤翔齐员外张侍御","Comments":[{"Content":"一作郎","Type":"Text","Index":33}]},"Clauses":[{"Content":"弱龄诚昧鄙，"},{"Content":"遇胜惟求止。"},{"Content":"如何羁滞中，"},{"Content":"得步青冥里。"},{"Content":"青冥有桂丛，"},{"Content":"冰雪两仙翁。"},{"Content":"毛节未归海，"},{"Content":"丹梯闲倚空。"},{"Content":"逍遥拟上清，"},{"Content":"洞府不知名。"},{"Content":"醮罢雨雷至，"},{"Content":"客辞山忽明。"},{"Content":"山明鸟声乐，"},{"Content":"日气生嵓壑。","Comments":[{"Content":"一作石","Type":"Text","Index":4}]},{"Content":"嵓壑树脩脩，","Comments":[{"Content":"一作石","Type":"Text","Index":1}]},{"Content":"白云如水流。"},{"Content":"白云消散尽，"},{"Content":"陇塞俨然秋。"},{"Content":"积阻关河固，"},{"Content":"绵联烽戍稠。"},{"Content":"五营承庙略，"},{"Content":"四野失边愁。"},{"Content":"吁嗟系尘役，"},{"Content":"又负灵仙迹。"},{"Content":"芝朮自芳香，"},{"Content":"泥沙几沈溺。"},{"Content":"书此欲沾衣，"},{"Content":"平生事每违。"},{"Content":"烟霄不可仰，"},{"Content":"鸾鹤自追随。","Comments":[{"Content":"鸾鹤","Type":"AllusionKey","Index":2}]}]},{"Id":11402,"Allusions":[{"AllusionIndex":507,"AllusionKey":"一腹便便","SentenceIndex":11}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"先","Rank":0,"Title":{"Content":"秋幕中夜独坐迟明因陪陈翃郎中晨谒上公因书即事兼呈同院诸公","Comments":[{"Content":"一作幕中秋夜","Type":"Text","Index":4},{"Content":"一作聊","Type":"Text","Index":19}]},"Clauses":[{"Content":"风凄露泫然，"},{"Content":"明月在山巅。"},{"Content":"独倚古庭树，"},{"Content":"仰看深夜天。"},{"Content":"叶翻萤不定，"},{"Content":"虫思草无边。"},{"Content":"南舍机杼发，"},{"Content":"东方云景鲜。"},{"Content":"簪裘肃已整，"},{"Content":"车骑俨将前。"},{"Content":"百雉拱双戟，"},{"Content":"万夫尊一贤。"},{"Content":"琳琅多谋蕴，"},{"Content":"律吕更相宣。"},{"Content":"晓桂香浥露，"},{"Content":"新鸿晴满川。"},{"Content":"熙熙造化功，","Comments":[{"Content":"一作功化","Type":"Text","Index":5}]},{"Content":"穆穆唐尧年。"},{"Content":"顾己草同贱，"},{"Content":"誓心金匪坚。"},{"Content":"蹇辞惭自寡，"},{"Content":"渴病老难痊。"},{"Content":"书此更何问，"},{"Content":"边韶唯昼眠。"}]},{"Id":11401,"Allusions":[{"AllusionIndex":6545,"AllusionKey":"弄白须","SentenceIndex":10}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"秋中野望寄舍弟绶兼令呈上西川尚书舅"},"Clauses":[{"Content":"忧来思远望，"},{"Content":"高处殊非惬。"},{"Content":"夜露湿苍山，"},{"Content":"秋陂满黄叶。"},{"Content":"人随雁迢遰，"},{"Content":"栈与云重叠。"},{"Content":"骨肉暂分离，"},{"Content":"形神遂疲薾。"},{"Content":"红旌渭阳骑，"},{"Content":"几日劳登涉。"},{"Content":"蜀道蔼松筠，"},{"Content":"巴江盛舟楫。"},{"Content":"小生即何限，"},{"Content":"简诲偏盈箧。"},{"Content":"旧恨尚填膺，"},{"Content":"新悲复萦睫。"},{"Content":"因求种瓜利，"},{"Content":"自喜归耕捷。"},{"Content":"井臼赖依邻，"},{"Content":"儿童亦胜汲。","Comments":[{"Content":"一作笈","Type":"Text","Index":5}]},{"Content":"尘容不在照，"},{"Content":"雪鬓那堪镊。"},{"Content":"唯有餐霞心，"},{"Content":"知夫与天接。","Comments":[{"Content":"一作未","Type":"Text","Index":2}]}]},{"Id":11384,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"与张擢对酌"},"Clauses":[{"Content":"张翁对卢叟，"},{"Content":"一榼山村酒。"},{"Content":"倾酒请予歌，"},{"Content":"忽蒙张翁呵。"},{"Content":"呵予官非屈，"},{"Content":"曲有怨词多。"},{"Content":"歌罢谢张翁，"},{"Content":"所思殊不同。"},{"Content":"予悲方为老，"},{"Content":"君责一何空。"},{"Content":"曾看乐官录，"},{"Content":"向是悲翁曲。"},{"Content":"张老闻此词，"},{"Content":"汪汪泪盈目。"},{"Content":"卢叟醉言粗，"},{"Content":"一杯凡数呼。"},{"Content":"回头顾张老，"},{"Content":"敢欲戏为儒。"}]},{"Id"