Type":"Text","Index":5}]},{"Content":"谁知白首窗下人，"},{"Content":"不接朱门坐中客。"},{"Content":"贱亦不足叹，"},{"Content":"贵亦不足陈。"},{"Content":"长卿未遇杨朱泣，","Comments":[{"Content":"长卿未遇","Type":"AllusionKey","Index":4},{"Content":"杨朱泣","Type":"AllusionKey","Index":7}]},{"Content":"蔡泽无媒原宪贫。","Comments":[{"Content":"蔡泽无媒","Type":"AllusionKey","Index":4},{"Content":"原宪贫","Type":"AllusionKey","Index":7}]},{"Content":"如今万乘方用武，"},{"Content":"国命天威借貔虎。"},{"Content":"穷达皆为身外名，"},{"Content":"公侯可废刀头取。"},{"Content":"君不见汉家边将在边庭，"},{"Content":"白羽三千出井陉。"},{"Content":"当风看猎拥珠翠，"},{"Content":"岂在终年穷一经。"}]},{"Id":11389,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"虞","Rank":0,"Title":{"Content":"同畅当咏蒲团"},"Clauses":[{"Content":"团团锦花结，"},{"Content":"乃是前溪蒲。"},{"Content":"拥坐称儒褐，"},{"Content":"倚眠宜病夫。"},{"Content":"唯当学禅寂，"},{"Content":"终老与之俱。"}]},{"Id":11383,"Allusions":[{"AllusionIndex":1249,"AllusionKey":"传纱帐","SentenceIndex":4},{"AllusionIndex":5410,"AllusionKey":"山阴兴","SentenceIndex":5}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"庚","Rank":0,"Title":{"Content":"上巳日陪齐相公花楼宴"},"Clauses":[{"Content":"钟陵暮春月，"},{"Content":"飞观延群英。"},{"Content":"晨霞耀中轩，"},{"Content":"满席罗金琼。"},{"Content":"持杯凝远睇，"},{"Content":"触物结幽情。"},{"Content":"树色参差绿，","Comments":[{"Content":"一作杪","Type":"Text","Index":2}]},{"Content":"湖光潋滟明。"},{"Content":"礼卑瞻绛帐，"},{"Content":"恩浃厕华缨。"},{"Content":"徒记山阴兴，","Comments":[{"Content":"山阴兴","Type":"AllusionKey","Index":5}]},{"Content":"祓禊乃为荣。","Comments":[{"Content":"一作念此，一作今日","Type":"Text","Index":2}]}]},{"Id":11414,"Allusions":[{"AllusionIndex":6955,"AllusionKey":"切泥","SentenceIndex":5}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"割飞二刀子歌"},"Clauses":[{"Content":"我家有剪刀，"},{"Content":"人云鬼国铁。"},{"Content":"裁罗裁绮无钝时，"},{"Content":"用来三年一股折。"},{"Content":"南中匠人淳用钢，"},{"Content":"再令盘屈随手伤。"},{"Content":"改锻割飞二刀子，"},{"Content":"色迎霁雪锋含霜。"},{"Content":"两条神物秋冰薄，"},{"Content":"刃淬初蟾鞘金错。"},{"Content":"越戟吴钩不足誇，"},{"Content":"斩犀切玉应怀怍。"},{"Content":"日试曾磨汉水边，"},{"Content":"掌中恄慄声冷然。"},{"Content":"神惊魄悸却收得，"},{"Content":"刃头已吐微微烟。"},{"Content":"刀乎刀乎何烨烨，"},{"Content":"魑魅须藏怪须慑。"},{"Content":"若非良工变尔形，"},{"Content":"只向裁缝委箱箧。"}]},{"Id":11421,"Classes":["題畫"],"Allusions":[{"AllusionIndex":1557,"AllusionKey":"乘鹤","SentenceIndex":5},{"AllusionIndex":1566,"AllusionKey":"乘轩","SentenceIndex":1},{"AllusionIndex":4117,"AllusionKey":"华亭","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"四言诗","TypeDetail":"SiYan","Rank":0,"Title":{"Content":"和马郎中画鹤赞"},"Clauses":[{"Content":"高高华亭，","Comments":[{"Content":"华亭","Type":"AllusionKey","Index":4}]},{"Content":"有鹤在屏。"},{"Content":"削玉点漆，"},{"Content":"乘轩姓丁。","Comments":[{"Content":"乘轩","Type":"AllusionKey","Index":2}]},{"Content":"暮云冥冥，"},{"Content":"双垂雪翎。"},{"Content":"晨光炯炯，"},{"Content":"一直朱顶。"},{"Content":"含音俨容，"},{"Content":"绝粒遗影。"},{"Content":"君以为真，"},{"Content":"相期缑岭。"}]},{"Id":11422,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"六言诗","TypeDetail":"LiuYan","Rhyme":"侵","Rank":0,"Title":{"Content":"送万巨"},"Clauses":[{"Content":"把酒留君听琴，"},{"Content":"难堪岁暮离心。"},{"Content":"霜叶无风自落，"},{"Content":"秋云不雨空阴。"},{"Content":"人愁荒村路细，"},{"Content":"马怯寒溪水深。"},{"Content":"望断青山独立，","Comments":[{"Content":"一作尽","Type":"Text","Index":2}]},{"Content":"更知何处相寻。"}]},{"Id":11103,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"乐府曲辞","TypeDetail":"YueFu","Rhyme":"微","Rank":0,"Title":{"Content":"长门怨","Comments":[{"Content":"一作相和歌辞 长门怨","Type":"Text","Index":3}]},"Clauses":[{"Content":"空空古廊殿，","Comments":[{"Content":"一作宫","Type":"Text","Index":2}]},{"Content":"寒月落斜晖。"},{"Content":"卧听未央曲，"},{"Content":"满箱歌舞衣。"}]},{"Id":11123,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"乐府曲辞","TypeDetail":"YueFu","Rhyme":"虞","Rank":0,"Title":{"Content":"杂曲歌辞 妾薄命"},"Clauses":[{"Content":"妾年初二八，"},{"Content":"两度嫁狂夫。"},{"Content":"薄命今犹在，"},{"Content":"坚贞扫地无。"}]},{"Id":11115,"Classes":["軍旅"],"GroupIndex":5,"Allusi