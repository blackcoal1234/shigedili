{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80847,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"西溪公宴"},"Clauses":[{"Content":"五马非从乐，"},{"Content":"西城念劝功。"},{"Content":"翠帷低映水，"},{"Content":"红旆不胜风。"},{"Content":"叶脱青山静，"},{"Content":"云归碧落空。"},{"Content":"淹留尽佳兴，"},{"Content":"新月渐朦胧。"}]},{"Id":80846,"Classes":["軍旅 要地"],"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"西溪公宴"},"Clauses":[{"Content":"谢守爱山水，"},{"Content":"军城况不赊。"},{"Content":"鱼惊避落叶，"},{"Content":"鸟倦立浮查。"},{"Content":"古柏依冈远，"},{"Content":"垂杨带岸斜。"},{"Content":"秋风吹急管，"},{"Content":"一曲度荷花。"}]},{"Id":80845,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"西湖"},"Clauses":[{"Content":"佳丽三吴国，"},{"Content":"湖光荡日华。"},{"Content":"鱼惊动蘋叶，"},{"Content":"燕喜掠杨花。"},{"Content":"云过山腰黑，"},{"Content":"风驱雨脚斜。"},{"Content":"烟波遥尽处，"},{"Content":"彷佛见渔家。"}]},{"Id":80988,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"金山寺"},"Clauses":[{"Content":"香刹冠嵯峨，"},{"Content":"松门络薜萝。","Comments":[{"Content":"原作落，据陈本、四库本改","Type":"Text","Index":3}]},{"Content":"风清尘不到，"},{"Content":"岸阔鸟难过。"},{"Content":"欲雨江声怒，"},{"Content":"新晴海气多。"},{"Content":"行舟未摇棹，"},{"Content":"回望隔烟波。"}]},{"Id":80757,"Classes":["軍旅 出塞"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"出塞"},"Clauses":[{"Content":"边草荒无路，"},{"Content":"星河秋夜明。"},{"Content":"卷旗遮远塞，"},{"Content":"歇马受降城。"},{"Content":"霜重征衣薄，"},{"Content":"风高战鼓鸣。"},{"Content":"将军功未厌，"},{"Content":"士卒不须生。"}]},{"Id":80791,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"古松"},"Clauses":[{"Content":"摧颓岩壑间，"},{"Content":"磊落得天顽。"},{"Content":"香叶低渐水，"},{"Content":"馀根倒挂山。"},{"Content":"白猿窥子落，"},{"Content":"黄鹤认巢还。"},{"Content":"不久应为石，"},{"Content":"莓苔旧已班。"}]},{"Id":81125,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"闻龚伯建下第"},"Clauses":[{"Content":"文章真长物，"},{"Content":"堪叹又遗贤。"},{"Content":"利器空埋土，"},{"Content":"灵光久照天。"},{"Content":"赵锥犹未出，"},{"Content":"荆璧会须传。"},{"Content":"道在虽穷困，"},{"Content":"知君不慨然。"}]},{"Id":81006,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"故绛城"},"Clauses":[{"Content":"文公恢霸略，"},{"Content":"征讨辅周衰。"},{"Content":"奕世为盟主，"},{"Content":"诸侯听会期。"},{"Content":"山河表里在，"},{"Content":"朝市古今移。"},{"Content":"欲访虒祁处，"},{"Content":"乡人亦不知。"}]},{"Id":81250,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"题陈秀才园林","Comments":[{"Content":"凤","Type":"Text","Index":4}]},"Clauses":[{"Content":"剧谈惊满座，"},{"Content":"音貌独琅然。"},{"Content":"可惜郦生老，"},{"Content":"谁知苏季贤。"},{"Content":"青囊世外药，"},{"Content":"碧幕醉中天。"},{"Content":"不佩黄金印，"},{"Content":"都缘负郭田。"}]},{"Id":81215,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"游延安宿马太博东馆","Comments":[{"Content":"字承之","Type":"Text","Index":9}]},"Clauses":[{"Content":"高馆寂无哗，"},{"Content":"安闲胜在家。"},{"Content":"暮烟凝塞上，"},{"Content":"堠火落天涯。"},{"Content":"坐久笔生冻，"},{"Content":"夜阑灯作花。"},{"Content":"主人意未尽，"},{"Content":"归路不为赊。"}]},{"Id":81225,"Classes":["軍旅 邊關"],"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"塞上"},"Clauses":[{"Content":"节物正防秋，"},{"Content":"关山落叶稠。"},{"Content":"霜风壮金鼓，"},{"Content":"雾气湿旌裘。"},{"Content":"未得西羌灭，"},{"Content":"终为大汉羞。"},{"Content":"惭非班定远，"},{"Content":"弃笔取封侯。"}]},{"Id":81227,"Classes":["軍旅 邊關"],"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"塞上"},"Clauses":[{"Content":"鸿雁秋先到，"},{"Content":"牛羊夕未还。"},{"Content":"旌旗遥背水，"},{"Content":"亭堠远依山。"},{"Content":"落日衔西塞，"},{"Content":"阴烟澹北关。"},{"Content":"何时献戎捷，"},{"Content":"鞍甲一朝闲。"}]},{"Id":81226,"Classes":["軍旅 邊關"],"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"塞上"},"Clauses":[{"Content":"瀚海秋风至，"},{"Content":"萧萧木叶飞。"},{"Content":"如何逢汉使，"},{"Content":"犹未寄征衣。"},{"Content":"不叹千里远，"},{"Content":"难甘一信稀。"},{"Content":"年年沙漠雁，"},{"Content":"随意得南归。"}]},{"Id":81224,"Classes":["軍旅 邊關"],"GroupIndex":4,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"塞上"},"Clauses":[{"Content":"剑客苍鹰队，"},{"Content":"将军白虎牙。"},{"Content":"分兵逻圁水，"},{"Content":"纵骑猎鸣沙。"},{"Content":"浪有书藏袖，"},{"Content":"难凭信达家。"},{"Content":"不堪闻晓角，"},{"Content":"吹尽落梅花。"}]},{"Id":81068,"Classes":["軍旅 送行"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"冬","Rank":0,"Title":{"Content":"送何济川为庞公使庆阳席上探得冬字","Comments":[{"Content":"涉","Type":"Text","Index":4}]},"Clauses":[{"Content":"幕府遥三舍，"},{"Content":"传车乘一封。"},{"Content":"忠深轻远道，"},{"Content":"醉暖失严冬。","Comments":[{"Content":"四库本作后","Type":"Text","Index":2}]},{"Content":"圁水犹飞檄，"},{"Content":"芦阕未灭烽。"},{"Content":"贤侯虽喜士，"},{"Content":"难得久从容。"}]},{"Id":81372,"Classes":["軍旅 要地"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"延安道中作"},"Clauses":[{"Content":"羁旅兼边思，"},{"Content":"川原蹀血新。"},{"Content":"烟云长带雨，"},{"Content":"草树不知春。"},{"Content":"细水淘沙骨，"},{"Content":"惊飙转路尘。"},{"Content":"今朝见烽火，"},{"Content":"白首太平人。"}]},{"Id":81233,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"鄜州怀聂之美"},"Clauses":[{"Content":"何言内外家，"},{"Content":"忧患两如麻。"},{"Content":"别泪行三岁，"},{"Content":"思心各一涯。"},{"Content":"海边昏雾雨，"},{"Content":"塞外惨风沙。"},{"Content":"安得云飞术，"},{"Content":"乘空去不遐。"}]},{"Id":80798,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"归田诗","Comments":[{"Content":"五首并序","Type":"Text","Index":3}]},"Clauses":[{"Content":"秋水风波大，"},{"Content":"嗟嗟未可游。"},{"Content":"渔樵自应乐，"},{"Content":"圭组为谁忧。"},{"Content":"直木知先伐，"},{"Content":"明珠忌暗投。"},{"Content":"果然钩可曲，"},{"Content":"不惜取封侯。"}]},{"Id":80801,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"Title":{"Content":"归田诗","Comments":[{"Content":"五首并序","Type":"Text","Index":3}]},"Clauses":[{"Content":"绂冕诚虚器，"},{"Content":"簪裳悉畏途。"},{"Content":"触机身未保，"},{"Content":"好直道先孤。"},{"Content":"甔石曾何有，"},{"Content":"田园浪更无。"},{"Content":"可能推两耜，"},{"Content":"沮溺共为徒。"}]},{"Id":80800,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"归田诗","Comments":[{"Content":"五首并序","Type":"Text","Index":3}]},"Clauses":[{"Content":"圣哲虽云远，"},{"Content":"遗文幸未亡。"},{"Content":"沈冥观礼乐，"},{"Content":"彷佛见虞黄。"},{"Content":"鸡黍延三径，"},{"Content":"琴书乐一堂。"},{"Content":"逍遥名教内，"},{"Content":"富贵亦微茫。"}]}],"Count":1270,"PageNo":1,"PageSize":20}