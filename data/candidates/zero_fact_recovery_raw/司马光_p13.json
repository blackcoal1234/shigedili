{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80736,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"八月七日夜省直苦雨三首"},"Clauses":[{"Content":"怅望中秋月，"},{"Content":"于今已上弦。"},{"Content":"明生圭样小，"},{"Content":"影露桂花偏。"},{"Content":"幽思邈难致，"},{"Content":"浮云去不还。"},{"Content":"何当出阴翳，"},{"Content":"清彻照中天。"}]},{"Id":80735,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"八月七日夜省直苦雨三首"},"Clauses":[{"Content":"菊蕊如排粟，"},{"Content":"青青见叶心。"},{"Content":"未尝窥白日，"},{"Content":"何以散黄金。"},{"Content":"攲侧疏篱短，"},{"Content":"绵延蔓草深。"},{"Content":"寒蛩尔何与，"},{"Content":"终夕亦悲吟。"}]},{"Id":81223,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"紫微石舍人挽歌二首","Comments":[{"Content":"原作方，据陈本改","Type":"Text","Index":3}]},"Clauses":[{"Content":"地胜岷峨秀，"},{"Content":"时清隽乂生。"},{"Content":"扬雄晚得禄，"},{"Content":"何武少知名。"},{"Content":"性有图书癖，"},{"Content":"心忘绂冕荣。"},{"Content":"前年归谕蜀，"},{"Content":"不使里人惊。"}]},{"Id":81222,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"紫微石舍人挽歌二首","Comments":[{"Content":"原作方，据陈本改","Type":"Text","Index":3}]},"Clauses":[{"Content":"顾我非君比，"},{"Content":"最为相得欢。"},{"Content":"平生游处久，"},{"Content":"美行始终完。"},{"Content":"长夜忍埋玉，"},{"Content":"秋霜不借兰。"},{"Content":"西风湿襟袖，"},{"Content":"空有泪阑干。"}]},{"Id":80835,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"次韵和江邻几九月五日省直"},"Clauses":[{"Content":"群驺布路散，","Comments":[{"Content":"一作歆","Type":"Text","Index":5}]},{"Content":"瘦马解鞍回。"},{"Content":"雨阕虫声乐，"},{"Content":"秋深菊意催。"},{"Content":"图书纷自适，"},{"Content":"僚友邈谁陪。"},{"Content":"何以消寒夜，"},{"Content":"残醪不满杯。"}]},{"Id":80855,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"吴正肃公挽歌辞三首"},"Clauses":[{"Content":"皇家延茂异，"},{"Content":"鹗立迥无伦。"},{"Content":"高议谁能夺，"},{"Content":"英才自有真。"},{"Content":"骅骝宁受絷，"},{"Content":"水鉴不栖尘。","Comments":[{"Content":"陈本作冰","Type":"Text","Index":1}]},{"Content":"试为咨清论，"},{"Content":"风流第几人。"}]},{"Id":80854,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"吴正肃公挽歌辞三首"},"Clauses":[{"Content":"辞华已独步，"},{"Content":"政治复无前。"},{"Content":"吏不容三穴，"},{"Content":"民皆戴二天。"},{"Content":"于今知和寡，"},{"Content":"自古愧才偏。"},{"Content":"惆怅棠阴下，"},{"Content":"仁风尚蔼然。","Comments":[{"Content":"自注：公再为陜牧，光实陜人，知公之政。","Type":"Text","Index":5}]}]},{"Id":80853,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"吴正肃公挽歌辞三首"},"Clauses":[{"Content":"念昔少年日，"},{"Content":"谬登君子堂。"},{"Content":"重言何以称，"},{"Content":"厚德不能忘。","Comments":[{"Content":"自注：光昔以文请见，公答以长歌，过有褒美。","Type":"Text","Index":5}]},{"Content":"玉麈声容在，"},{"Content":"泉台岁月长。"},{"Content":"凭谁寄清泪，"},{"Content":"为我洒松冈。"}]},{"Id":80934,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"和江邻几金铃菊"},"Clauses":[{"Content":"何处见佳菊，"},{"Content":"秋风汶水阳。"},{"Content":"酒浮金铎细，"},{"Content":"露泛蜜房香。"},{"Content":"不谓红尘地，"},{"Content":"相逢君子堂。"},{"Content":"依然故人意，"},{"Content":"不减旧芬芳。"}]},{"Id":81568,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"送贤良陈著作签书寿州判官","Comments":[{"Content":"舜俞","Type":"Text","Index":6}]},"Clauses":[{"Content":"海隅方万里，"},{"Content":"豪隽几何人。"},{"Content":"百汰求才尽，"},{"Content":"三薰得士新。"},{"Content":"声华四方耸，"},{"Content":"器业一朝伸。"},{"Content":"佗日苍生望，"},{"Content":"非徒泽寿春。","Comments":[{"Content":"以上《温国文正司马公文集》卷九","Type":"Text","Index":5}]}]},{"Id":81142,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"青","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"致政邵少卿挽词"},"Clauses":[{"Content":"北固启佳城，"},{"Content":"东吴霣德星。"},{"Content":"繐帷长寂寞，"},{"Content":"羽扇遂飘零。"},{"Content":"泉烛千年碧，"},{"Content":"霜松数寸青。"},{"Content":"馀庆知有在，"},{"Content":"玉树满阶庭。"}]},{"Id":81323,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"之美访及不获展奉以诗为谢"},"Clauses":[{"Content":"昔君来阙下，"},{"Content":"定馆必吾庐。"},{"Content":"今者虽相值，"},{"Content":"依然是索居。","Comments":[{"Content":"自注：之美馆于僧舍。","Type":"Text","Index":5}]},{"Content":"不堪休沐少，"},{"Content":"便使往还疏。"},{"Content":"深愧原思巷，"},{"Content":"空回长者车。"}]},{"Id":81108,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"送聂秘丞宰桐城二首","Comments":[{"Content":"希甫，字子美","Type":"Text","Index":4}]},"Clauses":[{"Content":"问子青云器，"},{"Content":"胡为不少留。"},{"Content":"未能充禄养，"},{"Content":"安散及身谋。"},{"Content":"卓尔千人俊，"},{"Content":"居然百里忧。"},{"Content":"连城价终在，"},{"Content":"自是玉工羞。"}]},{"Id":81107,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"Title":{"Content":"送聂秘丞宰桐城二首","Comments":[{"Content":"希甫，字子美","Type":"Text","Index":4}]},"Clauses":[{"Content":"七载一相见，","Comments":[{"Content":"陈本、四库本作值","Type":"Text","Index":5}]},{"Content":"恍然如路衢。"},{"Content":"形骸渐枯槁，"},{"Content":"志业转荒芜。"},{"Content":"往事云过眼，"},{"Content":"新愁雪染须。"},{"Content":"明朝又分首，"},{"Content":"上马即重湖。"}]},{"Id":81114,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"送蒲中舍霜致政归蜀","Comments":[{"Content":"四库本作霖","Type":"Text","Index":5},{"Content":"前栗亭令","Type":"Text","Index":9}]},"Clauses":[{"Content":"厌苦折腰久，"},{"Content":"飘然黄鹄飞。"},{"Content":"田园未芜没，"},{"Content":"邻曲有光辉。"},{"Content":"昔奋儒衣去，"},{"Content":"今纡朝绂归。"},{"Content":"人生贵知足，"},{"Content":"得此已为稀。"}]},{"Id":81115,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"送蒲中舍霜致政归蜀","Comments":[{"Content":"四库本作霖","Type":"Text","Index":5},{"Content":"前栗亭令","Type":"Text","Index":9}]},"Clauses":[{"Content":"念昔两髦日，"},{"Content":"乌奴同燕游。"},{"Content":"随时自有乐，"},{"Content":"何物可为愁。"},{"Content":"岂意今头白，"},{"Content":"相逢欲涕流。"},{"Content":"凭君访题壁，"},{"Content":"好在水西楼。","Comments":[{"Content":"自注：光侍先君为利州路转运使，与君屡游乌奴山寺，题名屋壁。","Type":"Text","Index":5}]}]},{"Id":81401,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"苏门先生"},"Clauses":[{"Content":"长啸苏门石，"},{"Content":"行藏世莫知。"},{"Content":"逍遥心迹远，"},{"Content":"寂寞姓名谁。"},{"Content":"乡在无何有，"},{"Content":"时方不可为。"},{"Content":"麒麟本神物，"},{"Content":"安得系而羁。"}]},{"Id":81601,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"寄赠致仕刘都官","Comments":[{"Content":"原作事，据陈本改，注同","Type":"Text","Index":4},{"Content":"讽张元常云：讽年六十二致仕，夫妇皆徙居简州赖山中。有二子，皆有官，其一登进士第。诸孙皆好书","Type":"Text","Index":7}]},"Clauses":[{"Content":"星郎年未至，"},{"Content":"辞禄一何高。"},{"Content":"目莹栖灵气，"},{"Content":"眉疏出秀毫。"},{"Content":"胸中自有乐，"},{"Content":"身外尽徒劳。"},{"Content":"回首红尘地，"},{"Content":"纷纷笑我曹。"}]},{"Id":952074,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"寄赠致仕刘都官","Comments":[{"Content":"原作事，据陈本改，注同","Type":"Text","Index":4},{"Content":"讽张元常云：讽年六十二致仕，夫妇皆徙居简州赖山中。有二子，皆有官，其一登进士第。诸孙皆好书","Type":"Text","Index":7}]},"Clauses":[{"Content":"解绂沱江外，"},{"Content":"诛茅井络边。"},{"Content":"老莱夫妇隐，"},{"Content":"韦孟子孙贤。"},{"Content":"浮蚁邀旁舍，"},{"Content":"蹲鸱种薄田。"},{"Content":"不须亲几杖，"},{"Content":"想望已萧然。","Comments":[{"Content":"自注：范景仁诗云移家尚恐青云浅，隐几唯知白日长。朱公绰诗云疏草焚来应见史，橐金散尽只留书。","Type":"Text","Index":5}]}]},{"Id":81441,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"和宋郎中孟秋省直","Comments":[{"Content":"选，字子才","Type":"Text","Index":4}]},"Clauses":[{"Content":"夜久残暑尽，"},{"Content":"好风来满襟。"},{"Content":"床空唯置枕，"},{"Content":"冠小不施簪。"},{"Content":"竹影乱凉月，"},{"Content":"林梢转晓参。"},{"Content":"人心有喧寂，"},{"Content":"何必欲云岑。"}]}],"Count":1270,"PageNo":13,"PageSize":20}