{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80799,"GroupIndex":4,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"归田诗","Comments":[{"Content":"五首并序","Type":"Text","Index":3}]},"Clauses":[{"Content":"松菊陶潜宅，"},{"Content":"蓬蒿仲蔚家。"},{"Content":"行游筇杖瘦，"},{"Content":"啸傲幅巾斜。"},{"Content":"屋小疏茅覆，"},{"Content":"门深乱柳遮。"},{"Content":"村童迎客至，"},{"Content":"竹帚扫桃花。"}]},{"Id":81355,"GroupIndex":5,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"归田诗","Comments":[{"Content":"五首并序","Type":"Text","Index":3}]},"Clauses":[{"Content":"桑柘绿无际，"},{"Content":"田间戴胜飞。"},{"Content":"清醪迎社熟，"},{"Content":"鸣雉向春肥。"},{"Content":"执耒时将急，"},{"Content":"衔杯日渐稀。"},{"Content":"四邻能共乐，"},{"Content":"招饮莫相违。"}]},{"Id":80964,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"咏史"},"Clauses":[{"Content":"不事王侯者，"},{"Content":"翛然郑子真。"},{"Content":"开田谷口美，"},{"Content":"荷锸白渠春。"},{"Content":"德化移乡曲，"},{"Content":"声光动搢绅。"},{"Content":"一时钟鼎贵，"},{"Content":"磨灭彼何人。"}]},{"Id":80965,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"咏史"},"Clauses":[{"Content":"延陵腰利剑，"},{"Content":"上国使初通。"},{"Content":"待我周游遍，"},{"Content":"逢君遣奠终。"},{"Content":"晶荧系高树，"},{"Content":"萧瑟动寒风。"},{"Content":"谁敢欺生死，"},{"Content":"苍苍照尔衷。"}]},{"Id":80963,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"咏史"},"Clauses":[{"Content":"春风三阁上，"},{"Content":"珠翠日纷纷。"},{"Content":"乐饮陶江月，"},{"Content":"清歌遏海云。"},{"Content":"醉中失陈国，"},{"Content":"梦里入隋军。"},{"Content":"玉树庭花曲，"},{"Content":"凄凉不可闻。"}]},{"Id":81024,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"秋夜望月"},"Clauses":[{"Content":"万里氛昏歇，"},{"Content":"金波秋更明。"},{"Content":"星连河渚闇，"},{"Content":"风绕桂枝生。"},{"Content":"鳷鹊临华馆，"},{"Content":"新丰落故城。"},{"Content":"古今佳赏尽，"},{"Content":"殊自有馀清。"}]},{"Id":80803,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"齐","Rank":0,"Title":{"Content":"汉宫词"},"Clauses":[{"Content":"苜蓿花犹短，"},{"Content":"昌蒲叶未齐。","Comments":[{"Content":"陈本、四库本作蒲萄","Type":"Text","Index":2}]},{"Content":"更衣过柏谷，"},{"Content":"走马宿棠梨。"},{"Content":"逆旅聊怀玺，"},{"Content":"田间共斗鸡。"},{"Content":"犹思饮云露，"},{"Content":"高举出虹蜺。"}]},{"Id":81143,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"读汉武帝纪"},"Clauses":[{"Content":"方士陈仙术，"},{"Content":"飘飘意不疑。"},{"Content":"云浮仲山鼎，"},{"Content":"风降寿宫祠。"},{"Content":"上药行当就，"},{"Content":"殊庭庶可期。"},{"Content":"蓬莱何日返，"},{"Content":"五利不吾欺。"}]},{"Id":81385,"Classes":["題畫 山水"],"Froms":["御定历代题画诗类卷十六 山水类"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"观僧室画山水"},"Clauses":[{"Content":"画精禅室冷，"},{"Content":"方暑久徘徊。"},{"Content":"不尽林端雪，"},{"Content":"长青石上苔。"},{"Content":"心闲对岩岫，"},{"Content":"目净失尘埃。"},{"Content":"坐久清风至，"},{"Content":"疑从翠涧来。"}]},{"Id":80966,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"咏寒士"},"Clauses":[{"Content":"洋洋泌水侧，"},{"Content":"蓬室苦萧条。"},{"Content":"衣薄难胜夜，"},{"Content":"厨闲空过朝。"},{"Content":"笑谈东郭履，"},{"Content":"歌诵买臣樵。"},{"Content":"但问才何似，"},{"Content":"无疑卿相遥。"}]},{"Id":81566,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"送孟仲习宜君令","Comments":[{"Content":"翱","Type":"Text","Index":7}]},"Clauses":[{"Content":"合抱生毫末，"},{"Content":"无为厌小官。"},{"Content":"政成心更逸，"},{"Content":"道胜意常宽。"},{"Content":"野迥山形秀，"},{"Content":"云疏雪意阑。"},{"Content":"离杯如不尽，"},{"Content":"何用御祁寒。"}]},{"Id":81185,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"野庙"},"Clauses":[{"Content":"古庙崩榱在，"},{"Content":"墙间杂树荒。"},{"Content":"依稀设馀像，"},{"Content":"寂寞閟祠堂。"},{"Content":"旧日牲豭地，"},{"Content":"今晨狐兔乡。"},{"Content":"英灵如未灭，"},{"Content":"何以度凄凉。"}]},{"Id":80821,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"吕禄庙"},"Clauses":[{"Content":"赤帝祚四百，"},{"Content":"徒然诸吕谋。"},{"Content":"出游逢友卖，"},{"Content":"未返见家收。"},{"Content":"弊冢昔无记，","Comments":[{"Content":"陈本、四库本作托","Type":"Text","Index":5}]},{"Content":"遗祠今幸留。"},{"Content":"士心俱左袒，"},{"Content":"何怨曲周侯。"}]},{"Id":81189,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"雪霁登普贤阁"},"Clauses":[{"Content":"积雪明朝日，"},{"Content":"山河坐可分。"},{"Content":"崭岩初解冻，"},{"Content":"片段未归云。"},{"Content":"阔望穷人境，"},{"Content":"高寻俯雁群。","Comments":[{"Content":"原作府，据陈本、四库本改","Type":"Text","Index":3}]},{"Content":"开门枝鸟散，"},{"Content":"玉絮堕纷纷。"}]},{"Id":80762,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"云际亭"},"Clauses":[{"Content":"高齐杳冥际，"},{"Content":"迥与世尘违。"},{"Content":"席上山河近，"},{"Content":"天边桑柘微。"},{"Content":"人间已飘洒，"},{"Content":"栋里始纷霏。","Comments":[{"Content":"原作飞，据陈本、四库本改","Type":"Text","Index":5}]},{"Content":"草树收残照，"},{"Content":"逍遥久未归。"}]},{"Id":81427,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"和孙器之清风楼"},"Clauses":[{"Content":"贤侯宴枚马，"},{"Content":"歌鼓事繁华。"},{"Content":"晚吹来千里，"},{"Content":"清商落万家。"},{"Content":"平原转疏雨，"},{"Content":"远树隔残霞。"},{"Content":"宋玉虽能赋，"},{"Content":"还须念景差。"}]},{"Id":81260,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"赠楚法曹叔度","Comments":[{"Content":"楷","Type":"Text","Index":6}]},"Clauses":[{"Content":"夫君能直节，"},{"Content":"不耻杨曹轻。"},{"Content":"道果因时屈，"},{"Content":"官无当已荣。"},{"Content":"松杉虽偃蹇，"},{"Content":"霜霰苦峥嵘。"},{"Content":"会有良工识，"},{"Content":"终观大器成。"}]},{"Id":80809,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"先春亭"},"Clauses":[{"Content":"园林近铃阁，"},{"Content":"旦夕被仁风。"},{"Content":"自得芳菲早，"},{"Content":"岂将疏远同。"},{"Content":"冰开半塘绿，"},{"Content":"雨借数枝红。"},{"Content":"会待韶光遍，"},{"Content":"还应到野丛。"}]},{"Id":81157,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"寄扬州侯都监","Comments":[{"Content":"仲伦","Type":"Text","Index":6}]},"Clauses":[{"Content":"木落淮南树，"},{"Content":"秋风日夜高。"},{"Content":"月临扬子渡，"},{"Content":"雪捲广陵涛。"},{"Content":"不得同萧散，"},{"Content":"何因破郁陶。"},{"Content":"空凭尺书速，"},{"Content":"未解梦魂劳。"}]},{"Id":80862,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"齐","Title":{"Content":"沉阴欲雪与同列会饮南斋"},"Clauses":[{"Content":"簿领日沈迷，"},{"Content":"从容乐事稀。"},{"Content":"宾朋幸相值，"},{"Content":"樽酒不须违。"},{"Content":"惨澹愁云积，"},{"Content":"参差远树微。"},{"Content":"淹留勿轻散，"},{"Content":"待取雪花飞。"}]}],"Count":1270,"PageNo":2,"PageSize":20}