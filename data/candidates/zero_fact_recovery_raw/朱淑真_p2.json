{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":96325,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"晚春会东园"},"Clauses":[{"Content":"红叠苔痕绿满枝，"},{"Content":"举杯和泪送春归。"},{"Content":"鸧鹒有意留残景，"},{"Content":"杜字无情恋晚晖。"},{"Content":"蝶趁落花盘地舞，"},{"Content":"燕随狂絮入帘飞。"},{"Content":"醉中曾记题诗处，"},{"Content":"临水人家半敞扉。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[题]刘克庄《分门纂类唐宋时贤千家诗选》作[春暮]。[叠]《名媛诗归》　《古今女史》作[点]。[恋]《名媛诗归》　《古今女史》作[叫]。[晚]《名媛诗归》　《古今女史》作[落]。[趁]原作[翅]，与下句[随]字不对，据《武林》本改。[落]《宋元百家诗》　《名媛诗归》　《古今女史》作[残]。[敞]《名媛诗归》　《古今女史》作[掩]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":536008,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"暮春三首"},"Clauses":[{"Content":"才过清明春意残，"},{"Content":"落花飞恕便相关。"},{"Content":"衔泥燕子时来去，"},{"Content":"酿蜜蜂儿自往还。"},{"Content":"风静窗前榆叶闹，","Comments":[{"Content":"《名媛诗归》卷一九八作茂","Type":"Text","Index":7}]},{"Content":"雨馀墙角藓苔斑。"},{"Content":"绿槐高柳浓阴合，"},{"Content":"深院人眠白昼闲。"}]},{"Id":536009,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"暮春三首"},"Clauses":[{"Content":"碧沼荷钱小叶圆，"},{"Content":"眼前芍药恣连颠。"},{"Content":"清明已过三春候，"},{"Content":"谷雨初晴四月天。"},{"Content":"乍著薄罗偏觉瘦，"},{"Content":"懒匀铅粉祇宜眠。"},{"Content":"情知废事因诗句，"},{"Content":"气习难除笔砚缘。"}]},{"Id":536010,"GroupIndex":3,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"暮春三首"},"Clauses":[{"Content":"举杯无语送春归，"},{"Content":"分付东风欲去时。"},{"Content":"燕子楼台人寂寂，"},{"Content":"杨花庭院日熙熙。","Comments":[{"Content":"《名媛诗归》卷一九作梨花庭院雨丝丝","Type":"Text","Index":7}]},{"Content":"枝头添翠莺先觉，"},{"Content":"叶底销红蝶未知。"},{"Content":"诗卷酒杯新废却，"},{"Content":"闲愁消遣殢他谁。"}]},{"Id":96295,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"恨春五首"},"Clauses":[{"Content":"一瞬芬菲尔许时，","Comments":[{"Content":"《宋元百家诗》作桃李芳","Type":"Text","Index":3}]},{"Content":"苦无佳句纪相思。"},{"Content":"春光正好须风雨，","Comments":[{"Content":"《宋元百家诗》作虽好多","Type":"Text","Index":5}]},{"Content":"恩爱方深奈别离。"},{"Content":"泪眼谢他花缴抱，"},{"Content":"愁怀惟赖酒扶持。"},{"Content":"莺莺燕燕休相笑，"},{"Content":"试与单栖各自知。"}]},{"Id":96296,"GroupIndex":3,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"肴","Rank":0,"FirstClauseRhyme":"豪","Title":{"Content":"恨春五首"},"Clauses":[{"Content":"病酒厌厌日正高，"},{"Content":"一声啼鸟在花梢。"},{"Content":"惊回好梦方萌蕊，"},{"Content":"唤起新愁却破苞。"},{"Content":"暗把后期随处记，"},{"Content":"闲将清恨倩诗嘲。"},{"Content":"从今始信恩成怨，"},{"Content":"且与莺花作淡交。"}]},{"Id":96297,"GroupIndex":4,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"恨春五首"},"Clauses":[{"Content":"迟迟花日上帘钩，"},{"Content":"尽日无人独倚楼。"},{"Content":"蝶使蜂媒传客恨，"},{"Content":"莺梭柳线织春愁。"},{"Content":"碧云信断惟劳梦，"},{"Content":"红叶成诗想到秋。"},{"Content":"几许别离多少泪，"},{"Content":"不堪重省不堪流。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[清恨] 《名媛诗归》作[诗恨]，延客堂钞本作[情恨]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96298,"GroupIndex":5,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"恨春五首"},"Clauses":[{"Content":"一篆烟消系臂香，"},{"Content":"闲看书册就牙床。"},{"Content":"莺声冉冉来深院，"},{"Content":"柳色阴阴暗画墙。"},{"Content":"眼底落红千万点，"},{"Content":"脸边新泪两三行。"},{"Content":"梨花细雨黄昏后，"},{"Content":"不是愁人也断肠。"}]},{"Id":536012,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"蒸","Title":{"Content":"元夜三首"},"Clauses":[{"Content":"阑月笼春霁色澄，"},{"Content":"深沉帘幕管弦清。"},{"Content":"争豪竞侈连仙馆，"},{"Content":"坠翠遗珠满帝城。"},{"Content":"一片笑声连鼓吹，"},{"Content":"六街灯火丽升平。"},{"Content":"归来禁漏踰三四，"},{"Content":"窗上梅花瘦影横。"}]},{"Id":536013,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"元夜三首"},"Clauses":[{"Content":"厌尘小雨润生寒，","Comments":[{"Content":"原作麈，据元刻本、《后村千家诗》改","Type":"Text","Index":2}]},{"Content":"云影澄鲜月正圆。"},{"Content":"十里绮罗春富贵，"},{"Content":"千门灯火夜婵娟。"},{"Content":"香街宝马嘶琼辔，"},{"Content":"辇路轻舆乡翠軿。"},{"Content":"高挂危帘凝望处，"},{"Content":"分明星斗下晴天。"}]},{"Id":96283,"GroupIndex":3,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"元夜三首"},"Clauses":[{"Content":"火独银花触目红，"},{"Content":"揭天鼓吹闹春风。"},{"Content":"欣欢入手愁忙里，","Comments":[{"Content":"武林本作新","Type":"Text","Index":1}]},{"Content":"旧事惊心忆梦中。"},{"Content":"但愿暂成人缱绻，"},{"Content":"不妨常任月朦胧。"},{"Content":"赏灯那得工夫醉，"},{"Content":"未必明年此会同。"}]},{"Id":96327,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"冬","Title":{"Content":"膏雨"},"Clauses":[{"Content":"添得垂杨色更浓，"},{"Content":"飞烟捲雾弄轻风。"},{"Content":"展匀芳草茸茸绿，","Comments":[{"Content":"《后村千家诗》卷一二作染","Type":"Text","Index":1}]},{"Content":"湿透妖桃薄薄红。"},{"Content":"润物有情如著意，"},{"Content":"催花无语自施工。"},{"Content":"一犁膏脉分春垄，"},{"Content":"只慰农桑望眼中。"}]},{"Id":536017,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"Title":{"Content":"惜花"},"Clauses":[{"Content":"生情赋得春心性，"},{"Content":"剩选名花绕砌栽。","Comments":[{"Content":"原作绕，据《后村千家诗》卷七改","Type":"Text","Index":2}]},{"Content":"客到且堪供客眼，"},{"Content":"诗悭聊可助诗才。"},{"Content":"低丛高架随宜有，"},{"Content":"浅紫深红次第开。"},{"Content":"便做即今风雨限，","Comments":[{"Content":"《后村千家诗》作恨","Type":"Text","Index":7}]},{"Content":"要看香艳绣苍苔。"}]},{"Id":536022,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"梨花"},"Clauses":[{"Content":"朝来带雨一枝春，"},{"Content":"薄薄香罗蹙蕊匀。"},{"Content":"冷艳未饶梅共色，"},{"Content":"靓妆长与月为邻。"},{"Content":"许同蝶梦还如蝶，"},{"Content":"似替人愁却笑人。"},{"Content":"须到年年寒食夜，"},{"Content":"情怀为你倍伤神。"}]},{"Id":96320,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"海棠"},"Clauses":[{"Content":"胭脂为脸玉为肌，"},{"Content":"未赴春风二月期。"},{"Content":"曾比温泉妃子睡，"},{"Content":"不吟西蜀杜陵诗。"},{"Content":"桃羞艳冶愁回首，"},{"Content":"柳妒妖娆祇皱眉。"},{"Content":"燕子欲归寒食近，"},{"Content":"黄昏庭院雨丝丝。"}]},{"Id":536023,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"Title":{"Content":"荼蘼"},"Clauses":[{"Content":"花神未怯春归去，"},{"Content":"故遣仙姿殿后芳。"},{"Content":"白玉体轻蟾魄莹，","Comments":[{"Content":"原缺，据元刻本补","Type":"Text","Index":7}]},{"Content":"素纱囊薄麝脐香。"},{"Content":"梦思洛浦婵娟态，"},{"Content":"愁记瑶台淡净妆。"},{"Content":"勾引诗情清绝处，"},{"Content":"一枝和雨在东墙。"}]},{"Id":536026,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"瑞香"},"Clauses":[{"Content":"玲珑巧蹙紫罗囊，"},{"Content":"今得东君著意妆。"},{"Content":"带露欲开宜晓日，"},{"Content":"临风微困怯春霜。"},{"Content":"发挥名字来雕辇，","Comments":[{"Content":"《全芳备祖》前集卷二作庐阜","Type":"Text","Index":7}]},{"Content":"弹厌芳菲入醉乡。"},{"Content":"最是午窗初睡省，"},{"Content":"重重赢得梦魂香。"}]},{"Id":536028,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"齐","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"柳絮"},"Clauses":[{"Content":"缭绕晴空似雪飞，"},{"Content":"悠扬不肯著尘泥。"},{"Content":"花边娇软黏蜂翅，"},{"Content":"陌上轻狂趁马蹄。","Comments":[{"Content":"原作啼，据元刻本改","Type":"Text","Index":7}]},{"Content":"贴水化萍随浪远，"},{"Content":"弄风无影度墙低。","Comments":[{"Content":"原作底，据元刻本改","Type":"Text","Index":7}]},{"Content":"成团作阵愁春去，"},{"Content":"故把东君归路迷。"}]},{"Id":536029,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"闻子规有感"},"Clauses":[{"Content":"花落花开事可悲，"},{"Content":"等闲一醉失芳菲。"},{"Content":"园林初听莺声涩，"},{"Content":"庭径俄看蝶粉稀。"},{"Content":"攲枕夜深无梦到，"},{"Content":"倚楼天外便魂飞。"},{"Content":"我无云翼飞归去，"},{"Content":"杜宇能飞却不归。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》前集卷三，《春日闲坐》始总题春景，《惜花》始总题花柳","Type":"Text","Index":7}]}]},{"Id":96292,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"初夏二首"},"Clauses":[{"Content":"枝上浑无一点春，"},{"Content":"半随流水半随尘。"},{"Content":"柔桑欲椹吴蚕老，"},{"Content":"稚笋成竿䌽凤驯。"},{"Content":"荷嫩爱风攲盖翠，"},{"Content":"榴花宜日皱裙殷。"},{"Content":"待封一𥯃伤心泪，"},{"Content":"寄与南楼薄倖人。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[彩凤] 《千家诗选》作[绣凤]。[爱风]《武林》本作[受风]。[欹盖翠]原作[欹翠盖]，与下句对语不合，据延客堂钞本改。[皱裙新]底本作[皱裙殷]　铁琴　剑楼钞本作[破裙殷]　均出韵，延客堂钞本改。一庵[上改竹字头] 延客堂钞本作[一腔]　况周颐《证璧集》引作[一掬]。","IsComment":false,"FullPath":"朱淑真集"}]}],"Count":367,"PageNo":2,"PageSize":20}