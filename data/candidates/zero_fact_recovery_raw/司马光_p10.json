{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":499428,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"奉和始平公酬大资政吴侍郎"},"Clauses":[{"Content":"䆉稏千塍碧，"},{"Content":"芙蕖万顷香。"},{"Content":"跨波横略彴，"},{"Content":"逼地亚筼筜。"},{"Content":"大野禾麻溢，"},{"Content":"高斋几席凉。"},{"Content":"夔龙屡赓唱，"},{"Content":"东壁正垂光。"}]},{"Id":81186,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"野菊"},"Clauses":[{"Content":"野菊未尝种，"},{"Content":"秋花何处来。"},{"Content":"羞随众草没，"},{"Content":"故犯早霜开。"},{"Content":"寒蝶舞不去，"},{"Content":"夜蛬吟更哀。"},{"Content":"幽人自移席，"},{"Content":"小摘泛青杯。","Comments":[{"Content":"以上《温国文正司马公文集》卷八","Type":"Text","Index":5}]}]},{"Id":81022,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"冬","Rank":0,"Title":{"Content":"秋夜"},"Clauses":[{"Content":"城上调秋角，"},{"Content":"烟间发暝钟。"},{"Content":"风枝摇宿鸟，"},{"Content":"霜草覆寒蛬。"},{"Content":"久负观书乐，"},{"Content":"端愁束带恭。"},{"Content":"暂因群吏散，"},{"Content":"还得遂幽慵。"}]},{"Id":80977,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"宜甫东楼晚饮"},"Clauses":[{"Content":"宾主俱欢醉，"},{"Content":"高楼迥倚空。"},{"Content":"形忘羁检外，"},{"Content":"酒散笑谈中。"},{"Content":"晚市烟初白，"},{"Content":"秋园叶半红。"},{"Content":"登临不厌数，"},{"Content":"朝夕是寒风。"}]},{"Id":81090,"Classes":["軍旅 從軍","軍旅 要地","軍旅 送行","軍旅 赴任"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"送魏寺丞赴辟秦州判官","Comments":[{"Content":"广","Type":"Text","Index":4}]},"Clauses":[{"Content":"征西大府开，"},{"Content":"后乘得高才。"},{"Content":"区脱烽烟静，"},{"Content":"渠搜职贡来。"},{"Content":"陇云低玉帐，"},{"Content":"羌舞奉金罍。"},{"Content":"信美从军乐，"},{"Content":"脩梧茂帝台。"}]},{"Id":81182,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"清风台","Comments":[{"Content":"已下十七首，并和何济川汉州西湖杂咏","Type":"Text","Index":3}]},"Clauses":[{"Content":"太守金闺客，"},{"Content":"天朝应对才。"},{"Content":"非因板舆恋，"},{"Content":"宁驾使车来。"},{"Content":"水鉴秋毫尽，"},{"Content":"霜锋错节开。"},{"Content":"清风偏千里，"},{"Content":"不独此高台。"}]},{"Id":80808,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"伫月亭"},"Clauses":[{"Content":"灯火动鱼矶，"},{"Content":"湖边过鸟稀。"},{"Content":"孤蟾久未上，"},{"Content":"五马不成归。"},{"Content":"长啸风生座，"},{"Content":"高吟露满衣。"},{"Content":"闲情无日厌，"},{"Content":"岸帻对清晖。"}]},{"Id":81546,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"药圃"},"Clauses":[{"Content":"三蜀膏腴地，"},{"Content":"偏于药物宜。"},{"Content":"小畦千种聚，"},{"Content":"春雨一番滋。"},{"Content":"山相惭多识，"},{"Content":"桐君未遍知。"},{"Content":"佗年似胡广，"},{"Content":"养寿复扶衰。"}]},{"Id":80840,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"竹坞"},"Clauses":[{"Content":"二何迹相继，"},{"Content":"竹坞日阴森。","Comments":[{"Content":"自注：济川诗注云前守何脩撰不伐西湖竹，予亦遵之。","Type":"Text","Index":5}]},{"Content":"欲识养民意，"},{"Content":"先观爱物心。"},{"Content":"低垂樽俎冷，"},{"Content":"密映管弦深。"},{"Content":"勿怪湖光少，"},{"Content":"年来碧影侵。"}]},{"Id":81132,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"射堋"},"Clauses":[{"Content":"叠鼓花前急，"},{"Content":"红旌竹外高。"},{"Content":"惊飙分白羽，"},{"Content":"馀响振乌号。"},{"Content":"壮观倾春陌，"},{"Content":"欢声涌夜涛。"},{"Content":"因兹刑礼俗，"},{"Content":"岂独事游遨。"}]},{"Id":80804,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"玉徽亭"},"Clauses":[{"Content":"房公昔漂泊，"},{"Content":"置酒此鸣琴。"},{"Content":"人事有忧乐，"},{"Content":"山光无古今。"},{"Content":"风流俱寂寞，"},{"Content":"结构尚萧森。"},{"Content":"松竹含虚籁，"},{"Content":"犹疑弦上音。"}]},{"Id":80761,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"书楼"},"Clauses":[{"Content":"使君有书癖，"},{"Content":"记览浩无涯。"},{"Content":"况此孤楼迥，"},{"Content":"端无外物哗。"},{"Content":"横肱攲曲几，"},{"Content":"搔首落乌纱。"},{"Content":"此趣人谁识，"},{"Content":"长吟窗日斜。"}]},{"Id":81136,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"10","Rank":0,"Title":{"Content":"朔会堂"},"Clauses":[{"Content":"朔旦集俺吏，"},{"Content":"兹堂簪组繁。"},{"Content":"舞空孤鹤下，"},{"Content":"映日两凫翻。"},{"Content":"花散东方骑，"},{"Content":"萍浮北海樽。"},{"Content":"须知太守贵，"},{"Content":"铙吹引朱轮。"}]},{"Id":81137,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"浮醳亭","Comments":[{"Content":"陈本、四库本作觞","Type":"Text","Index":2}]},"Clauses":[{"Content":"曲水华榱下，"},{"Content":"浮觞去复还。"},{"Content":"浪摇花影碎，"},{"Content":"日射酒缸殷。"},{"Content":"灭没遥寻客，"},{"Content":"徘徊怯度湾。"},{"Content":"穷欢不知醉，"},{"Content":"清泚照心颜。"}]},{"Id":81183,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"清燕亭"},"Clauses":[{"Content":"波澄荫群木，"},{"Content":"永日湛清华。"},{"Content":"碧筱静秋色，"},{"Content":"白蘋低晚花。"},{"Content":"松声工醒酒，"},{"Content":"泉味最便茶。"},{"Content":"外事付丞掾，"},{"Content":"无妨风景嘉。"}]},{"Id":81589,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"流芳桥"},"Clauses":[{"Content":"桥下流芳度，"},{"Content":"馀春日夕催。"},{"Content":"呼人洗樽斝，"},{"Content":"招客藉莓苔。"},{"Content":"倚柱时流滞，"},{"Content":"随波乍往回。"},{"Content":"仙家如不近，"},{"Content":"安得此花来。"}]},{"Id":81588,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"齐","Rank":0,"Title":{"Content":"晓景亭"},"Clauses":[{"Content":"帘栊分晓色，"},{"Content":"远树子规啼。"},{"Content":"浓露侵衣冷，"},{"Content":"晴烟压水低。"},{"Content":"神游灵境健，"},{"Content":"身入画图迷。"},{"Content":"衙吏无烦报，"},{"Content":"河洲鹭正栖。"}]},{"Id":81155,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"假山"},"Clauses":[{"Content":"广汉土平远，"},{"Content":"已嫌丘壑疏。"},{"Content":"呼工刻岩洞，"},{"Content":"应手出庭除。"},{"Content":"缥渺神仙宅，"},{"Content":"嵌空虎豹居。"},{"Content":"人功与天力，"},{"Content":"秀绝两何如。"}]},{"Id":81174,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"探花桥"},"Clauses":[{"Content":"桥边春意近，"},{"Content":"五马屡徘徊。"},{"Content":"湖水旦暮渌，"},{"Content":"林花早晚开。"},{"Content":"适因尝酒到，"},{"Content":"又为赋诗来。"},{"Content":"借问双华表，"},{"Content":"经过日几回。"}]},{"Id":80785,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"乐轩"},"Clauses":[{"Content":"繁弦凝绿水，"},{"Content":"叠鼓掺渔阳。"},{"Content":"风结舞初急，"},{"Content":"尘飞歌正长。"},{"Content":"凫鹥争上下，"},{"Content":"栋宇为低昂。"},{"Content":"太守且安坐，"},{"Content":"新声未遽央。"}]}],"Count":1270,"PageNo":10,"PageSize":20}