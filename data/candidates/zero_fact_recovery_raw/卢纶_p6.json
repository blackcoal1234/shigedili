{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11302,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"冬","Rank":0,"FirstClauseRhyme":"冬","Title":{"Content":"送黎兵曹往陕府结亲","Comments":[{"Content":"所昏即君从母女弟","Type":"Text","Index":9}]},"Clauses":[{"Content":"郎马两如龙，"},{"Content":"春朝上路逢。"},{"Content":"鸳鸯初集水，"},{"Content":"薜荔欲依松。"},{"Content":"步帐歌声转，","Comments":[{"Content":"一作障珂","Type":"Text","Index":3}]},{"Content":"妆台烛影重。"},{"Content":"何言在阴者，"},{"Content":"得是戴侯宗。"}]},{"Id":11257,"Allusions":[{"AllusionIndex":8241,"AllusionKey":"不事小儿","SentenceIndex":3},{"AllusionIndex":10262,"AllusionKey":"鸳行","SentenceIndex":3},{"AllusionIndex":10727,"AllusionKey":"仲德","SentenceIndex":3},{"AllusionIndex":11075,"AllusionKey":"柴桑","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"送乐平苗明府"},"Clauses":[{"Content":"累职比柴桑，","Comments":[{"Content":"柴桑","Type":"AllusionKey","Index":5}]},{"Content":"清秋入楚乡。"},{"Content":"一船灯照浪，"},{"Content":"两岸树凝霜。"},{"Content":"亭吏趋寒雾，"},{"Content":"山城敛曙光。"},{"Content":"无辞折腰久，"},{"Content":"仲德在鸳行。","Comments":[{"Content":"仲德","Type":"AllusionKey","Index":2},{"Content":"鸳行","Type":"AllusionKey","Index":5}]}]},{"Id":11200,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"卧病书怀"},"Clauses":[{"Content":"苦心三十载，"},{"Content":"白首遇艰难。"},{"Content":"旧地成孤客，"},{"Content":"全家赖钓竿。"},{"Content":"貌衰缘药尽，"},{"Content":"起晚为山寒。"},{"Content":"老病今如此，"},{"Content":"无人更问看。"}]},{"Id":11322,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"落第后归终南别业"},"Clauses":[{"Content":"久为名所误，"},{"Content":"春尽始归山。"},{"Content":"落羽羞言命，"},{"Content":"逢人强破颜。"},{"Content":"交疏贫病里，"},{"Content":"身老是非间。"},{"Content":"不及东溪月，"},{"Content":"渔翁夜往还。"}],"Comments":[{"Book":"《唐诗品汇》","Content":"刘云：怨极自然（“交疏”二句下）。","IsComment":false,"FullPath":"《唐诗品汇》"},{"Book":"《唐诗选脉会通评林》","Content":"“少孤为客早，多难识君迟”、“交疏贫病里，身老是非间”，俱实境语，何痛彻之动人也！","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗摘钞》","Content":"尾联换意。三、四道心事极真，五、六写世情极透。名士落第，时名顿减，故六云云。七、八另换一意，言不及东溪渔翁在夜月中往还，自由自便，是非之所不到也。","IsComment":false,"FullPath":"《唐诗摘钞》"},{"Book":"《唐诗快》","Content":"落第诗无有不感慨者。此独怨而不怒，寄托悠然。","IsComment":false,"FullPath":"《唐诗快》"}]},{"Id":11295,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"齐","Rank":0,"FirstClauseRhyme":"齐","Title":{"Content":"送朝邑张明府","Comments":[{"Content":"一作夏县","Type":"Text","Index":3},{"Content":"一作少","Type":"Text","Index":5},{"Content":"此公善琴","Type":"Text","Index":6}]},"Clauses":[{"Content":"千室暮山西，"},{"Content":"浮云与树齐。"},{"Content":"剖辞云落纸，"},{"Content":"拥吏雪成泥。"},{"Content":"野火芦千顷，"},{"Content":"河田水万畦。"},{"Content":"不知琴月夜，"},{"Content":"谁得听乌啼。"}]},{"Id":11268,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"送李方东归","Comments":[{"Content":"即故李校书端亲弟","Type":"Text","Index":5}]},"Clauses":[{"Content":"故交三四人，"},{"Content":"闻别共沾巾。"},{"Content":"举目是陈事，"},{"Content":"满城无至亲。"},{"Content":"身从丧日病，"},{"Content":"家自俭年贫。"},{"Content":"此去何堪远，"},{"Content":"遗孤在旧邻。"}]},{"Id":11239,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"秋晚霁后野望忆夏侯审"},"Clauses":[{"Content":"天晴禾黍平，"},{"Content":"畅目亦伤情。"},{"Content":"野店云日丽，"},{"Content":"孤庄砧杵鸣。"},{"Content":"川原唯寂寞，"},{"Content":"岐路自纵横。"},{"Content":"前后无俦侣，"},{"Content":"此怀谁与呈。"}]},{"Id":11255,"Allusions":[{"AllusionIndex":247,"AllusionKey":"种玉","SentenceIndex":2},{"AllusionIndex":3340,"AllusionKey":"葛洪","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"送王尊师","Comments":[{"Content":"一作道士","Type":"Text","Index":4}]},"Clauses":[{"Content":"梦别一仙人，"},{"Content":"霞衣满鹤身。"},{"Content":"旌幢天路晚，","Comments":[{"Content":"一作远","Type":"Text","Index":5}]},{"Content":"桃杏海山春。"},{"Content":"种玉非求稔，","Comments":[{"Content":"种玉","Type":"AllusionKey","Index":2}]},{"Content":"烧金不为贫。"},{"Content":"自怜头白早，","Comments":[{"Content":"一作向白","Type":"Text","Index":5}]},{"Content":"难与葛洪亲。","Comments":[{"Content":"一作谁","Type":"Text","Index":1},{"Content":"葛洪","Type":"AllusionKey","Index":4}]}]},{"Id":11267,"Allusions":[{"AllusionIndex":9247,"AllusionKey":"萧咸","SentenceIndex":3},{"AllusionIndex":10776,"AllusionKey":"周郎","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"送抚州周使君","Comments":[{"Content":"即侍中之婿","Type":"Text","Index":6}]},"Clauses":[{"Content":"周郎三十馀，","Comments":[{"Content":"周郎","Type":"AllusionKey","Index":2}]},{"Content":"天子赐鱼书。"},{"Content":"龙节随云水，"},{"Content":"金铙动里闾。"},{"Content":"松声三楚远，"},{"Content":"乡思百花初。"},{"Content":"若转弘农守，"},{"Content":"萧咸事不如。","Comments":[{"Content":"萧咸","Type":"AllusionKey","Index":2}]}]},{"Id":11254,"Allusions":[{"AllusionIndex":24,"AllusionKey":"阿连","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"送王录事赴任苏州","Comments":[{"Content":"即舍人堂弟","Type":"Text","Index":8}]},"Clauses":[{"Content":"古堤迎拜路，"},{"Content":"万里一帆前。"},{"Content":"潮作浇田雨，"},{"Content":"云成煮海烟。"},{"Content":"吏闲唯重法，"},{"Content":"俗富不忧边。"},{"Content":"西掖今宵咏，"},{"Content":"还应寄阿连。","Comments":[{"Content":"一作须","Type":"Text","Index":2},{"Content":"阿连","Type":"AllusionKey","Index":5}]}]},{"Id":11167,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"大梵山寺院奉呈趣上人赵中丞"},"Clauses":[{"Content":"渐欲休人事，","Comments":[{"Content":"一作散发","Type":"Text","Index":2}]},{"Content":"僧房学闭关。"},{"Content":"伴鱼浮水上，"},{"Content":"看鹤向林间。"},{"Content":"寺古秋仍早，"},{"Content":"松深暮更闲。"},{"Content":"月中随道友，"},{"Content":"夜夜坐空山。"}]},{"Id":11281,"Allusions":[{"AllusionIndex":4342,"AllusionKey":"惠休","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"送恒操上人归江外觐省"},"Clauses":[{"Content":"依佛不违亲，"},{"Content":"高堂与寺邻。"},{"Content":"问安双树晓，"},{"Content":"求膳一僧贫。"},{"Content":"持咒过龙庙，"},{"Content":"翻经化海人。"},{"Content":"还同惠休去，","Comments":[{"Content":"惠休","Type":"AllusionKey","Index":4}]},{"Content":"儒者亦沾巾。"}]},{"Id":11193,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"舟中寒食"},"Clauses":[{"Content":"寒食空江曲，"},{"Content":"孤舟渺水前。"},{"Content":"斗鸡沙鸟异，"},{"Content":"禁火岸花然。"},{"Content":"日霁开愁望，"},{"Content":"波喧警醉眠。"},{"Content":"因看数茎鬓，"},{"Content":"倍欲惜芳年。"}]},{"Id":11169,"Allusions":[{"AllusionIndex":4525,"AllusionKey":"济济多士","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"元日早朝呈故省诸公"},"Clauses":[{"Content":"万戟淩霜布，"},{"Content":"森森瑞气间。"},{"Content":"垂衣当晓日，"},{"Content":"上寿对南山。"},{"Content":"济济延多士，"},{"Content":"跹跹舞百蛮。"},{"Content":"小臣无事谏，"},{"Content":"空愧伴鸣环。"}]},{"Id":11170,"Allusions":[{"AllusionIndex":1565,"AllusionKey":"凤城","SentenceIndex":3},{"AllusionIndex":10262,"AllusionKey":"鹓鹭","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"元日朝回中夜书情寄南宫二故人"},"Clauses":[{"Content":"鸣佩随鹓鹭，","Comments":[{"Content":"鹓鹭","Type":"AllusionKey","Index":5}]},{"Content":"登阶见冕旒。"},{"Content":"无能裨圣代，"},{"Content":"何事别沧洲。"},{"Content":"闲夜贫还醉，"},{"Content":"浮名老渐羞。"},{"Content":"凤城春欲晚，","Comments":[{"Content":"凤城","Type":"AllusionKey","Index":2}]},{"Content":"郎吏忆同游。"}]},{"Id":11275,"Classes":["軍旅 戍守","軍旅 送行"],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"送宛丘任少府"},"Clauses":[{"Content":"带绶别乡亲，"},{"Content":"东为千里人。"},{"Content":"俗讹唯竞祭，"},{"Content":"地古不留春。"},{"Content":"野戍云藏火，"},{"Content":"军城树拥尘。"},{"Content":"少年何所重，"},{"Content":"才子又清贫。"}]},{"Id":11260,"Allusions":[{"AllusionIndex":838,"AllusionKey":"邴曼","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"送永阳崔明府"},"Clauses":[{"Content":"鹤唳蒹葭晓，","Comments":[{"Content":"一作岸","Type":"Text","Index":5}]},{"Content":"中流见楚城。"},{"Content":"浪清风乍息，"},{"Content":"山白月犹明。"},{"Content":"废路开荒木，"},{"Content":"归人种古营。"},{"Content":"悬闻正讹俗，"},{"Content":"邴曼更知名。","Comments":[{"Content":"一作最","Type":"Text","Index":3},{"Content":"邴曼","Type":"AllusionKey","Index":2}]}]},{"Id":11277,"Classes":["軍旅 送行"],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"送郎士元使君赴郢州"},"Clauses":[{"Content":"赐衣兼授节，"},{"Content":"行日郢中闻。"},{"Content":"花发登山庙，"},{"Content":"天晴阅水军。","Comments":[{"Content":"一作清","Type":"Text","Index":2}]},{"Content":"渔商三楚接，"},{"Content":"郡邑九江分。"},{"Content":"高兴应难遂，"},{"Content":"元戎有大勋。"}]},{"Id":11256,"Allusions":[{"AllusionIndex":2265,"AllusionKey":"今古一南楼","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"送邓州崔长史"},"Clauses":[{"Content":"出山车骑次诸侯，"},{"Content":"坐领图书见督邮。"},{"Content":"绕郭桑麻通淅口，"},{"Content":"满川风景接襄州。"},{"Content":"高城鸟过方催夜，"},{"Content":"废垒蝉鸣不待秋。"},{"Content":"闻说元规偏爱月，"},{"Content":"知君常得伴登楼。"}]},{"Id":11261,"Allusions":[{"AllusionIndex":2265,"AllusionKey":"今古一南楼","SentenceIndex":2},{"AllusionIndex":2404,"AllusionKey":"坦腹","SentenceIndex":2},{"AllusionIndex":6600,"AllusionKey":"潘令","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"送申屠正字往湖南迎亲兼谒赵和州因呈上侍郎使君并戏简前历阳李明府"},"Clauses":[{"Content":"晓月朣朦映水关，","Comments":[{"Content":"一作胧","Type":"Text","Index":4}]},{"Content":"水边因到历阳山。"},{"Content":"千艘财货朱桥下，","Comments":[{"Content":"一作物","Type":"Text","Index":3}]},{"Content":"一曲闾阎青荻间。"},{"Content":"坦腹定逢潘令醉，","Comments":[{"Content":"坦腹","Type":"AllusionKey","Index":2},{"Content":"潘令","Type":"AllusionKey","Index":6}]},{"Content":"上楼应伴庾公闲。"},{"Content":"欢馀若问南行计，"},{"Content":"知念天涯负米还。"}]}],"Count":337,"PageNo":6,"PageSize":20}