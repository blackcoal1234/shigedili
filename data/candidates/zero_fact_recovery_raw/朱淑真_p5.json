{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":536193,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"锡","Rank":0,"Title":{"Content":"夏夜弹琴"},"Clauses":[{"Content":"夜久万籁息，"},{"Content":"琴声愈幽寂。"},{"Content":"接引到清江，"},{"Content":"岩泉溜寒滴。","Comments":[{"Content":"同上书册二页一四三八","Type":"Text","Index":5}]}]},{"Id":536000,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"立春前一日"},"Clauses":[{"Content":"梅花枝上雪初融，"},{"Content":"一夜高风激转东。"},{"Content":"芳草池塘冰未薄，"},{"Content":"柳条如线著春工。"}]},{"Id":96263,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"立春绝句二首"},"Clauses":[{"Content":"自折梅花插鬓端，"},{"Content":"韭黄兰茁簇春盘。"},{"Content":"泼醅酒软浑无力，"},{"Content":"作恶东风特地寒。"}]},{"Id":96264,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"佳","Rank":0,"FirstClauseRhyme":"佳","Title":{"Content":"立春绝句二首"},"Clauses":[{"Content":"喜胜春幡袅凤钗，","Comments":[{"Content":"武林本作嘉","Type":"Text","Index":1}]},{"Content":"新春不换旧情怀。"},{"Content":"草根隐绿冰痕满，"},{"Content":"柳眼藏娇雪影埋。","Comments":[{"Content":"元刻本作里","Type":"Text","Index":6}]}]},{"Id":96262,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"又绝句少年心"},"Clauses":[{"Content":"杨花扰乱少年心，"},{"Content":"怕雨愁风用意深。"},{"Content":"付与酒杯浑不管，"},{"Content":"从教天气作春阴。"}]},{"Id":96261,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"盐","Rank":0,"FirstClauseRhyme":"盐","Title":{"Content":"又绝句"},"Clauses":[{"Content":"乳燕调雏出画檐，"},{"Content":"游蜂喧翅入珠帘。"},{"Content":"日长无事人慵困，"},{"Content":"金鸭香销懒更添。"}]},{"Id":96250,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"冬","Title":{"Content":"春色有怀"},"Clauses":[{"Content":"客里逢春想恨浓，"},{"Content":"故园花木梦魂同。"},{"Content":"连堤绿阴晴烟里，"},{"Content":"映水红摇薄雾中。"}]},{"Id":96214,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"约游春不去二首"},"Clauses":[{"Content":"邻姬约我踏青游，"},{"Content":"强拂愁眉下小楼。"},{"Content":"去户欲行还自省，"},{"Content":"也知憔悴见人羞。"}]},{"Id":96213,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"约游春不去二首"},"Clauses":[{"Content":"少年意思懒能酬，"},{"Content":"爱好心情一向休。"},{"Content":"若到旧家游冶处，"},{"Content":"只应满眼是春愁。"}]},{"Id":536005,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"青","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"喜晴"},"Clauses":[{"Content":"鹁鸠声歇已闲晴，"},{"Content":"柳眼窥春浅放青。"},{"Content":"楼上捲帘凝目处，"},{"Content":"远山如画尽帏屏。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》前集卷一，总题春景。","Type":"Text","Index":7}]}]},{"Id":536006,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"春日杂书十首"},"Clauses":[{"Content":"春来春去几经过，"},{"Content":"不似今年恨最多。"},{"Content":"寂寂海棠枝上月，"},{"Content":"照人清夜欲如何。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】《历朝名媛诗词》作[春日杂事]。[似] 《名媛诗归》 　《古今女史》　《历朝名媛诗词》　《武林》均作[是]。[欲] 《武林》均作[月]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96234,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"春日杂书十首"},"Clauses":[{"Content":"柳丝拂拂弄东风，"},{"Content":"日色春容一样同。"},{"Content":"嫩草破烟开秀绿，"},{"Content":"小桃和露拆香红。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[拂拂弄] 《宋元百家诗》　《古今女史》　《历朝名媛诗词》均作[软软　]。[春容] 《宋元百家诗》　《古今女史》　《历朝名媛诗词》均作[家家]。 [拆] 《名媛诗归》 　《古今女史》　延客堂钞本作[折]，《武林》作[坼]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96235,"GroupIndex":3,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"盐","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"春日杂书十首"},"Clauses":[{"Content":"松松丽日约馀寒，"},{"Content":"春向梅边柳上添。"},{"Content":"蜂蝶自知新得意，"},{"Content":"展须忙翅入层帘。"}]},{"Id":96236,"GroupIndex":4,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"春日杂书十首"},"Clauses":[{"Content":"柳垂新绿腻烟光，"},{"Content":"紫燕惺松语画梁。"},{"Content":"午睡忽惊鸡唱罢，"},{"Content":"日移花影上窗香。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】 [新绿] 《宋元百家诗》　《古今女史》作[新线] 。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96237,"GroupIndex":5,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"春日杂书十首"},"Clauses":[{"Content":"捲帘月挂一钩斜，"},{"Content":"愁到黄昏转更加。"},{"Content":"独坐小窗无伴侣，"},{"Content":"凝情羞对海棠花。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】 [转更加]《名媛诗归》　《古今女史》作[更转加]。[凝情] 《宋元百家诗》作[含情] 。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96238,"GroupIndex":6,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"4","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"春日杂书十首"},"Clauses":[{"Content":"斗草寻花正及时，"},{"Content":"不为容易见芳菲。"},{"Content":"谁能更觑闲针线，"},{"Content":"且殢春光伴酒卮。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[殢]《武林》本作[滞]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96239,"GroupIndex":7,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"春日杂书十首"},"Clauses":[{"Content":"月筛窗幌好风生，","Comments":[{"Content":"原作愰，据元刻本改","Type":"Text","Index":4}]},{"Content":"病眼伤春泪欲倾。"},{"Content":"写字弹琴无意绪，"},{"Content":"踏青挑菜没心情。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[伤春]《武林》本作[伤风]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96240,"GroupIndex":8,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"Title":{"Content":"春日杂书十首"},"Clauses":[{"Content":"一年好处清明近，"},{"Content":"已觉春光大半休。"},{"Content":"点检芳菲多少在，"},{"Content":"翠深红浅已关愁。"}],"Comments":[{"Content":"1、题原作“春暮”，据《断肠集》改。<br />2、妙：《断肠集》作“好”。<br />3、芳菲：芬芳美盛的花草。<br />4、关：牵连，涉及。鲍照《代堂上歌行》：“万曲不关心，一曲动情多“","IsComment":false}]},{"Id":96241,"GroupIndex":9,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"春日杂书十首"},"Clauses":[{"Content":"濛濛细雨湿香尘，"},{"Content":"似欲藏鸦柳色新。"},{"Content":"斗草工夫浑忘却，"},{"Content":"祇凭诗酒破除春。"}]},{"Id":96242,"GroupIndex":10,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"春日杂书十首"},"Clauses":[{"Content":"自入春来日日愁，"},{"Content":"惜花翻作为花羞。"},{"Content":"呢喃飞过双双燕，"},{"Content":"嗔我帘垂不上钩。"}]}],"Count":367,"PageNo":5,"PageSize":20}