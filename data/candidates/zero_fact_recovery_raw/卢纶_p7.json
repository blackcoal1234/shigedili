{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11270,"Allusions":[{"AllusionIndex":451,"AllusionKey":"䌽服","SentenceIndex":0},{"AllusionIndex":3047,"AllusionKey":"凤雏","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"送李尚书郎君昆季侍从归觐滑州"},"Clauses":[{"Content":"凤雏联翼美王孙，","Comments":[{"Content":"凤雏","Type":"AllusionKey","Index":2}]},{"Content":"䌽服戎装拟塞垣。","Comments":[{"Content":"䌽服","Type":"AllusionKey","Index":2}]},{"Content":"金鼎对筵调野膳，"},{"Content":"玉鞭齐骑引行轩。"},{"Content":"冰河一曲旌旗满，"},{"Content":"墨诏千封雨露繁。"},{"Content":"更说务农能罢战，"},{"Content":"敢持歌颂庆晨昏。"}]},{"Id":11171,"Allusions":[{"AllusionIndex":6040,"AllusionKey":"漉酒巾","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"无题","Comments":[{"Content":"第七句缺","Type":"Text","Index":2}]},"Clauses":[{"Content":"耻将名利托交亲，"},{"Content":"只向尊前乐此身。"},{"Content":"才大不应成滞客，"},{"Content":"时危且喜是闲人。"},{"Content":"高歌犹爱思归引，"},{"Content":"醉语惟誇漉酒巾。","Comments":[{"Content":"漉酒巾","Type":"AllusionKey","Index":7}]},{"Content":"□□□□□□□，"},{"Content":"岂能偏遣老风尘。"}]},{"Id":11174,"Allusions":[{"AllusionIndex":3436,"AllusionKey":"贡禹","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"冬夜赠别友人"},"Clauses":[{"Content":"愁听千家流水声，"},{"Content":"相思独向月中行。"},{"Content":"侵阶暗草秋霜重，","Comments":[{"Content":"一作冬，又作寒","Type":"Text","Index":5}]},{"Content":"遍郭寒山夜月明。","Comments":[{"Content":"一作绕","Type":"Text","Index":1}]},{"Content":"连年客舍唯多病，"},{"Content":"数亩田园又废耕。"},{"Content":"更送乘轺归上国，"},{"Content":"应怜贡禹未成名。","Comments":[{"Content":"贡禹","Type":"AllusionKey","Index":4}]}]},{"Id":11290,"Allusions":[{"AllusionIndex":5805,"AllusionKey":"刘歆师儒","SentenceIndex":1},{"AllusionIndex":7796,"AllusionKey":"石建宗瑾孝","Sentenc