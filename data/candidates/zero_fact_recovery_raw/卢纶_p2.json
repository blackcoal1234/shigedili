{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11243,"Allusions":[{"AllusionIndex":4764,"AllusionKey":"七人班","SentenceIndex":1},{"AllusionIndex":7892,"AllusionKey":"书从外氏学","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"送从侄滁州觐省"},"Clauses":[{"Content":"爱尔似龙媒，"},{"Content":"翩翩千里回。"},{"Content":"书从外氏学，","Comments":[{"Content":"书从外氏学","Type":"AllusionKey","Index":5}]},{"Content":"竹自晋时栽。"},{"Content":"拥棹逢鸥舞，"},{"Content":"凭阑见雨来。"},{"Content":"上堂多庆乐，"},{"Content":"不醉莫停杯。"}]},{"Id":11333,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"詶苗员外仲夏归郊居遇雨见寄"},"Clauses":[{"Content":"雷响风仍急，"},{"Content":"人归鸟亦还。"},{"Content":"乱云方至水，"},{"Content":"骤雨已喧山。"},{"Content":"田鼠依林上，"},{"Content":"池鱼戏草间。"},{"Content":"因兹屏埃雾，","Comments":[{"Content":"一作高比","Type":"Text","Index":3}]},{"Content":"一咏一开颜。"}]},{"Id":11206,"Allusions":[{"AllusionIndex":4806,"AllusionKey":"借寇","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"和赵端公九日登石亭上和州家兄"},"Clauses":[{"Content":"洛浦想江津，"},{"Content":"悲欢共此辰。"},{"Content":"采花湖岸菊，"},{"Content":"望国旧楼人。"},{"Content":"雁别声偏苦，"},{"Content":"松寒色转新。"},{"Content":"传书问渔叟，"},{"Content":"借寇尔何因。","Comments":[{"Content":"借寇","Type":"AllusionKey","Index":2}]}]},{"Id":11205,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"和金吾裴将军使往河北宣慰因访张氏昆季旧居兼寄赵侍郎赵卿拜陵未回"},"Clauses":[{"Content":"飞轩不驻轮，"},{"Content":"感激汉儒臣。"},{"Content":"气慑千夫勇，"},{"Content":"恩传万里春。"},{"Content":"古原收野燎，"},{"Content":"寒笛怨空邻。"},{"Content":"书此达良友，"},{"Content":"五陵风雨频。","Comments":[{"Content":"一作杜","Type":"Text","Index":1}]}]},{"Id":11201,"Allusions":[{"AllusionIndex":592,"AllusionKey":"宋玉伤怀","SentenceIn