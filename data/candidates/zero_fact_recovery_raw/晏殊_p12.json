{"Authors":{"Names":["晏殊"],"AuthorIds":[27290],"Dynasties":["Song"]},"ShiData":[{"Id":198314,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"阳","Rank":0,"Title":{"Content":"燕归梁"},"TuneId":{"Id":213},"Clauses":[{"Content":"双燕归飞绕画堂。"},{"Content":"似留恋虹梁。"},{"Content":"清风明月好时光。"},{"Content":"更何况绮筵张。","Comments":[{"Content":"、","Type":"Text","Index":3}],"BreakAfter":"1"},{"Content":"云衫侍女，"},{"Content":"频倾寿酒，"},{"Content":"加意动笙簧。"},{"Content":"人人心在玉炉香。"},{"Content":"庆佳会祝延长。","Comments":[{"Content":"、","Type":"Text","Index":3}]}]},{"Id":198313,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"先","Rank":0,"Title":{"Content":"燕归梁"},"TuneId":{"Id":213},"Clauses":[{"Content":"金鸭香炉起瑞烟。"},{"Content":"呈妙舞开筵。"},{"Content":"阳春一曲动朱弦。"},{"Content":"斟美酒泛觥船。","Comments":[{"Content":"、","Type":"Text","Index":3}],"BreakAfter":"1"},{"Content":"中秋五日，"},{"Content":"风清露爽，"},{"Content":"犹是早凉天。"},{"Content":"蟠桃花发一千年。"},{"Content":"祝长寿比神仙。","Comments":[{"Content":"、","Type":"Text","Index":3}]}]},{"Id":198184,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"7","Rank":0,"Title":{"Content":"木兰花 春恨"},"TuneId":{"Id":273},"Clauses":[{"Content":"绿杨芳草长亭路，"},{"Content":"年少抛人容易去。"},{"Content":"楼头残梦五更钟，"},{"Content":"花底离愁三月雨。","BreakAfter":"1"},{"Content":"无情不似多情苦，"},{"Content":"一寸还成千万缕。"},{"Content":"天涯地角有穷时，"},{"Content":"只有相思无尽处。"}],"Comments":[{"Content":"此词抒写人生离别相思之苦，寄托了作者从有感于人生短促、聚散无常以及盛筵之后的落寞等心情生发出来的感慨。整首词感情真挚，情调凄切，抒情析理，绰约多姿，有着迷人的艺术魅力。作者在抒发人生感慨时成功地使用了夸张手法，更增添了词的艺术感染力。<br />上片首句写景，时间是绿柳依依的春天，地点在古道长亭 ，这是旅客小休之所，也是两人分别之处。<br />“年少”句叙述临行之际，闺女空自泪眼相看，无语凝咽，而“年少”的他却轻易地弃之而去。年少，是指思妇的“所欢”，也即“恋人”，据赵与时《宾退录》记载，“晏叔原见蒲传正曰：‘先君平日小词虽多 ，未尝作妇人语也 。’传正曰：‘绿杨芳草长亭路 ，年少抛人容易去 ，岂非妇人语乎 ？’叔原曰：“ 公谓年少为所欢乎，因公言，遂解得乐天诗两句：欲留所欢待富贵 ，富贵不来所欢去。’传正笔而悟。余按全篇云云，盖真谓所欢者，与乐天‘欲留年少待富贵，富贵不来年少去’之句不同，叔原之言失之。”<br />这是晏几道为其父此词“ 年少”语所作的无谓辩解。实际上，本词写思妇闺怨，用的的确是“妇人语”。“楼头”两句，把思妇的思念之意生动地描绘出来，从相反方面说明“ 抛人去 ”者的薄情。白昼逝去，黑夜降临，她转辗反侧，很久之后才悠悠进入睡乡，但很快就被五更钟声惊破了残梦，使她重又陷入无边的失望；窗外，飘洒着春雨，那些花瓣像是承受不住，带着离愁纷纷落下。“残梦”和“落花”在这里都是用来曲折地抒发怀人之情，语言工致匀称。陈廷焯《白雨斋词话》称其“婉转缠绵，深情一往，丽而有则，耐人寻味”。<br />下片用反语，先以无情与多情作对比，继而以具体比喻从反面来说明。“无情”两句，用反语以加强语意。先说无情则无烦恼，因此多情还不如无情，从而反托出“多情自古伤离别”的深衷；“ 一寸 ”指心，柳丝缕缕，拂水飘绵，最识离怀别苦。两句意思是说，无情怎似多情之苦，那一寸芳心，化成了千丝万缕，蕴含着千愁万恨。词意来自李煜“一片芳心千万绪，人间没个安排处”（《蝶恋花》）。<br />末两句含意深婉。天涯地角，是天地之尽头，故云“有穷时”。然而，别离之后的相思之情，却是无穷无尽的，正所谓“只有相思无尽处”。这里通过比较来体现出因“多情”而受到的精神折磨，感情真切而含蓄，对于那个薄幸年少，却毫无埋怨之语。《蓼园词选》赞曰：“末二句总见多情之苦耳。妙在意思忠厚，无怨怼口角。”<br />本词写闺怨 ，颇具婉转流利之致 ，词中不事藻饰，没有典故，除首两句为叙述，其余几句不论是用比喻，还是用反语，用夸张，都是通过白描手段反映思妇的心理活动，亦即难以言宣的相思之情，收到了很好的艺术效果。","IsComment":false}]},{"Id":198214,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"5","Rank":0,"Title":{"Content":"连理枝"},"TuneId":{"Id":365},"Clauses":[{"Content":"玉宇秋风至。"},{"Content":"帘幕生凉气。"},{"Content":"朱槿犹开，"},{"Content":"红莲尚拆，"},{"Content":"芙蓉含蕊。"},{"Content":"送旧巢归燕拂高帘，"},{"Content":"见梧桐叶坠。","BreakAfter":"1"},{"Content":"嘉宴临晨启。"},{"Content":"金鸭飘香细。"},{"Content":"凤竹鸾丝，"},{"Content":"清歌妙舞，"},{"Content":"尽呈游艺。"},{"Content":"愿百千遐寿比神仙，"},{"Content":"有年年岁岁。"}]},{"Id":198213,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"15","Rank":0,"Title":{"Content":"连理枝"},"TuneId":{"Id":365},"Clauses":[{"Content":"绿树莺声老。"},{"Content":"金井生秋早。"},{"Content":"不寒不暖，"},{"Content":"裁衣按曲，"},{"Content":"天时正好。"},{"Content":"况兰堂逢著寿筵开，"},{"Content":"见炉香缥缈。","BreakAfter":"1"},{"Content":"组绣呈纤巧。"},{"Content":"歌舞誇妍妙。"},{"Content":"玉酒频倾，"},{"Content":"朱弦翠管，"},{"Content":"移宫易调。"},{"Content":"献金杯重叠祝长生，"},{"Content":"永逍遥奉道。"}]},{"Id":357980,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"先","Rank":0,"Title":{"Content":"失调名"},"Clauses":[{"Content":"芳草碧连天。"}]},{"Id":198302,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"13","Rank":0,"Title":{"Content":"蝶恋花"},"TuneId":{"Id":304},"Clauses":[{"Content":"一霎秋风惊画扇。"},{"Content":"艳粉娇红，"},{"Content":"尚拆荷花面。"},{"Content":"草际露垂虫响遍。"},{"Content":"珠帘不下留归燕。","BreakAfter":"1"},{"Content":"埽掠亭台开小院。"},{"Content":"四坐清欢，"},{"Content":"莫放金杯浅。"},{"Content":"龟鹤命长松寿远。"},{"Content":"阳春一曲情千万。"}]},{"Id":358299,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"4","Rank":0,"Title":{"Content":"蝶恋花"},"TuneId":{"Id":304},"Clauses":[{"Content":"南园春半踏青时。"},{"Content":"风和闻马嘶。"},{"Content":"青梅如豆柳如眉。"},{"Content":"日长蝴蝶飞。"},{"Content":"花露重，"},{"Content":"草烟低。"},{"Content":"人家帘幕垂。"},{"Content":"秋千慵困解罗衣。"},{"Content":"画梁双燕归。"}]},{"Id":198303,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"5","Rank":0,"Title":{"Content":"蝶恋花"},"TuneId":{"Id":304},"Clauses":[{"Content":"紫菊初生朱槿坠。"},{"Content":"月好风清，"},{"Content":"渐有中秋意。"},{"Content":"更漏乍长天似水。"},{"Content":"银屏展尽遥山翠。","BreakAfter":"1"},{"Content":"绣幕卷波香引穗。"},{"Content":"急管繁弦，"},{"Content":"共庆人间瑞。"},{"Content":"满酌玉杯萦舞袂。"},{"Content":"南春祝寿千千岁。"}]},{"Id":198304,"GroupIndex":4,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"5","Rank":0,"Title":{"Content":"蝶恋花"},"TuneId":{"Id":304},"Clauses":[{"Content":"玉枕冰寒消暑气。"},{"Content":"碧簟纱厨，"},{"Content":"向午朦胧睡。"},{"Content":"莺舌惺忪如会意。"},{"Content":"无端画扇惊飞起。","BreakAfter":"1"},{"Content":"雨后初凉生水际。"},{"Content":"人面桃花，"},{"Content":"的的遥相似。"},{"Content":"眼看红芳犹抱蕊。"},{"Content":"丛中已结新莲子。"}]},{"Id":198299,"GroupIndex":5,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"31","Rank":0,"Title":{"Content":"蝶恋花"},"TuneId":{"Id":304},"Clauses":[{"Content":"梨叶疏红蝉韵歇。"},{"Content":"银汉风高，"},{"Content":"玉管声凄切。"},{"Content":"枕簟乍凉铜漏咽。"},{"Content":"谁教社燕轻离别。","BreakAfter":"1"},{"Content":"草际蛩吟珠露结。"},{"Content":"宿酒醒来，"},{"Content":"不记归时节。"},{"Content":"多少衷肠犹未说。"},{"Content":"朱帘一夜朦胧月。"}]},{"Id":198300,"GroupIndex":6,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"11","Rank":0,"Title":{"Content":"蝶恋花"},"TuneId":{"Id":304},"Clauses":[{"Content":"南雁依稀回侧阵。"},{"Content":"雪霁墙阴，"},{"Content":"偏觉兰芽嫩。"},{"Content":"中夜梦馀消酒困。"},{"Content":"炉香卷穗灯生晕。","BreakAfter":"1"},{"Content":"急景流年都一瞬。"},{"Content":"往事前欢，"},{"Content":"未免萦方寸。"},{"Content":"腊后花期知渐近。"},{"Content":"寒梅已作东风信。"}]},{"Id":198267,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"15","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"画鼓声中昏又晓。"},{"Content":"时光只解催人老。"},{"Content":"求得浅欢风日好。"},{"Content":"齐揭调。"},{"Content":"神仙一曲渔家傲。","BreakAfter":"1"},{"Content":"绿水悠悠天杳杳。"},{"Content":"浮生岂得长年少。"},{"Content":"莫惜醉来开口笑。"},{"Content":"须信道。"},{"Content":"人间万事何时了。"}]},{"Id":198271,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"23","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"荷叶荷花相间斗。"},{"Content":"红娇绿掩新妆就。"},{"Content":"昨日小池疏雨后。"},{"Content":"铺锦绣。"},{"Content":"行人过去频回首。","BreakAfter":"1"},{"Content":"倚遍朱阑凝望久。"},{"Content":"鸳鸯浴处波文皱。"},{"Content":"谁唤谢娘斟美酒。"},{"Content":"萦舞袖。"},{"Content":"当筵劝我千长寿。"}]},{"Id":198266,"GroupIndex":3,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"13","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"荷叶初开犹半卷。"},{"Content":"荷花欲折须微绽。"},{"Content":"此叶此花真可羡。"},{"Content":"秋水畔。"},{"Content":"青凉伞映红妆面。","BreakAfter":"1"},{"Content":"美酒一杯留客宴。"},{"Content":"拈花摘叶情无限。"},{"Content":"争奈世人多聚散。"},{"Content":"频祝愿。"},{"Content":"如花似叶长相见。"}]},{"Id":198265,"GroupIndex":4,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"7","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"杨柳风前香百步。"},{"Content":"盘心碎点真珠露。"},{"Content":"疑是水仙开洞府。"},{"Content":"妆景趣。"},{"Content":"红幢绿盖朝天路。","BreakAfter":"1"},{"Content":"小鸭飞来稠闹处。"},{"Content":"三三两两能言语。"},{"Content":"饮散短亭人欲去。"},{"Content":"留不住。"},{"Content":"黄昏更下萧萧雨。"}]},{"Id":198268,"GroupIndex":5,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"30","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"粉笔丹青描未得。"},{"Content":"金针䌽线功难敌。"},{"Content":"谁傍暗香轻采摘。"},{"Content":"风淅淅。"},{"Content":"船头触散双鸂鶒。","BreakAfter":"1"},{"Content":"夜雨染成天水碧。"},{"Content":"朝阳借出胭脂色。"},{"Content":"欲落又开人共惜。"},{"Content":"秋气逼。"},{"Content":"盘中已见新莲菂。"}]},{"Id":198274,"GroupIndex":6,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"11","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"叶下鵁鶄眠未稳。"},{"Content":"风翻露飐香成阵。"},{"Content":"仙女出游知远近。"},{"Content":"羞借问。"},{"Content":"饶将绿扇遮红粉。","BreakAfter":"1"},{"Content":"一掬蕊黄沾雨润。"},{"Content":"天人乞与金英嫩。"},{"Content":"试折乱条醒酒困。"},{"Content":"应有恨。"},{"Content":"芳心拗尽丝无尽。"}]},{"Id":198270,"GroupIndex":7,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"漾","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"罨画溪边停彩舫。"},{"Content":"仙娥绣被呈新样。"},{"Content":"飒飒风声来一饷。"},{"Content":"愁四望。"},{"Content":"残红片片随波浪。","BreakAfter":"1"},{"Content":"琼脸丽人青步障。"},{"Content":"风牵一袖低相向。"},{"Content":"应有锦鳞闲倚傍。"},{"Content":"秋水上。"},{"Content":"时时绿柄轻摇扬。"}]},{"Id":198277,"GroupIndex":8,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"15","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"宿蕊斗攒金粉闹。"},{"Content":"青房暗结蜂儿小。"},{"Content":"敛面似啼开似笑。"},{"Content":"天与貌。"},{"Content":"人间不是铅华少。","BreakAfter":"1"},{"Content":"叶软香清无限好。"},{"Content":"风头日脚乾催老。"},{"Content":"待得玉京仙子到。"},{"Content":"凭向道。"},{"Content":"红颜只合长年少。"}]}],"Count":360,"PageNo":12,"PageSize":20}