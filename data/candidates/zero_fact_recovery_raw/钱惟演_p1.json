{"Authors":{"Names":["钱惟演"],"AuthorIds":[34195],"Dynasties":["Song"]},"ShiData":[{"Id":203087,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"明皇"},"Clauses":[{"Content":"山上汤泉架玉梁，"},{"Content":"云中复道拂瑶光。"},{"Content":"丝囊暗结三危露，"},{"Content":"翠幰时遗百和香。"},{"Content":"枉是金鸡亲便坐，","Comments":[{"Content":"王注本作近","Type":"Text","Index":5}]},{"Content":"更抛珠被掩方床。"},{"Content":"匆匆一曲凉州罢，"},{"Content":"万里桥边见夕阳。"}]},{"Id":203072,"GroupIndex":1,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"无题三首"},"Clauses":[{"Content":"误语成疑意已伤，"},{"Content":"春山低敛翠眉长。"},{"Content":"鄂君绣被朝犹掩，"},{"Content":"荀令薰炉冷自香。"},{"Content":"有恨岂因燕凤去，"},{"Content":"无言宁为息侯亡。"},{"Content":"合欢不验丁香结，"},{"Content":"祇得凄凉对烛房。"}]},{"Id":203071,"GroupIndex":2,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"无题三首"},"Clauses":[{"Content":"耿耿寒灯照醉罗，"},{"Content":"看朱成碧意如何。"},{"Content":"虎头辟恶无妨枕，"},{"Content":"犀角凉心更待磨。"},{"Content":"惟有幽兰啼月露，"},{"Content":"可将尺素托云波。"},{"Content":"山屏六曲归来夜，"},{"Content":"祇恐重投折齿梭。"}]},{"Id":203070,"GroupIndex":3,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"无题三首"},"Clauses":[{"Content":"香歇环沉无限猜，"},{"Content":"春阴浓淡画帘开。"},{"Content":"有时盘马看犹懒，"},{"Content":"尽日投壶笑未回。"},{"Content":"蝶怨岂能重傅粉，"},{"Content":"雉娇疑待更求媒。"},{"Content":"啼妆不治金翘闇，"},{"Content":"肠断温郎玉照台。"}]},{"Id":203075,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"再赋七言"},"Clauses":[{"Content":"欲网珊瑚碧浪深，"},{"Content":"横塘斜日带秋阴。","Comments":[{"Content":"四库本作对","Type":"Text","Index":5}]},{"Content":"汉宫此地留金饼，"},{"Content":"洛浦何人遗锦衾。"},{"Content":"舞学西城回雅态，"},{"Content":"歌传南国有馀音。","Comments":[{"Content":"清注本作翻","Type":"Text","Index":2}]},{"Content":"韩凭恨魄如长在，"},{"Content":"青骨香销亦见寻。"}]},{"Id":203103,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"梨"},"Clauses":[{"Content":"紫花青蒂压枝繁，"},{"Content":"秋实离离出上兰。"},{"Content":"东海圆圭无柰碧，"},{"Content":"嵰州甜雪不胜寒。"},{"Content":"已忧仙佩悬珠重，"},{"Content":"更恐金刀切玉难。"},{"Content":"自与相如解痟渴，"},{"Content":"何须琼蕊作朝餐。"}]},{"Id":203089,"GroupIndex":1,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"泪二首"},"Clauses":[{"Content":"鲛盘千点怨吞声，"},{"Content":"蜡炬风高翠箔轻。"},{"Content":"夜半商陵闻别鹤，"},{"Content":"酒阑安石对哀筝。"},{"Content":"银屏欲去连珠迸，"},{"Content":"金屋初来玉箸横。"},{"Content":"马上悲歌寄黄鹄，"},{"Content":"紫台回首暮云平。"}]},{"Id":203088,"GroupIndex":2,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"泪二首"},"Clauses":[{"Content":"家在河阳路入秦，"},{"Content":"楼头相望祇酸辛。"},{"Content":"江南满目新亭宴，"},{"Content":"旗鼓伤心故国春。"},{"Content":"仙掌倚天频滴露，"},{"Content":"方诸待月自涵津。"},{"Content":"荆王未辨连城价，"},{"Content":"肠断南州抱璧人。"}]},{"Id":203064,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"七夕"},"Clauses":[{"Content":"紫天银水渡辛夷，"},{"Content":"藻帐雕屏解佩时。"},{"Content":"金朔窗中窥阿母，"},{"Content":"小姑堂上忆兰芝。"},{"Content":"初宵已有穿针乐，"},{"Content":"欲曙还成弄杼悲。"},{"Content":"若比人间更肠断，"},{"Content":"万重云浪寄微辞。"}]},{"Id":203076,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"青","Title":{"Content":"成都","Comments":[{"Content":"明周复俊《全蜀艺文志》卷五作钱勰诗","Type":"Text","Index":2}]},"Clauses":[{"Content":"武侯千载有遗灵，"},{"Content":"盘石刀痕尚未平。"},{"Content":"巴妇自饶丹穴富，"},{"Content":"汉庭还责碧砮征。"},{"Content":"雨经蜀市应和酒，"},{"Content":"琴到临邛别寄情。"},{"Content":"知有忠臣能叱驭，"},{"Content":"不论云栈更峥嵘。"}]},{"Id":203067,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"小园秋夕"},"Clauses":[{"Content":"潘鬓秋来已自伤，"},{"Content":"庾园时物更荒凉。"},{"Content":"紫梨半熟连红树，"},{"Content":"碧藓初圆乱缥墙。"},{"Content":"月露暗从孤桂滴，"},{"Content":"水风犹猎败荷香。"},{"Content":"滑稽还喜鸱夷在，"},{"Content":"欲取临邛美酒尝。"}]},{"Id":203086,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"始皇"},"Clauses":[{"Content":"天极周环百二都，"},{"Content":"六王钟鐻接刘苏。"},{"Content":"金椎漫筑甘泉道，"},{"Content":"匕首还随督亢图。","Comments":[{"Content":"王注本作献","Type":"Text","Index":4}]},{"Content":"已觉副车惊博浪，"},{"Content":"更携连弩望蓬壶。"},{"Content":"不将寸土封诸子，"},{"Content":"刘项由来是匹夫。"}]},{"Id":203080,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"初秋属疾"},"Clauses":[{"Content":"蜜房初满石榴红，","Comments":[{"Content":"四库本、清注本、王注本作若","Type":"Text","Index":5}]},{"Content":"秋意先侵玉井桐。"},{"Content":"薤簟自凭南郭几，"},{"Content":"縠巾犹卧北窗风。"},{"Content":"云迷候雁辞遥塞，"},{"Content":"露湿飞萤起暗丛。"},{"Content":"病已不须传七发，"},{"Content":"粉笺香墨寄诗筒。","Comments":[{"Content":"以上《西昆酬唱集》卷上","Type":"Text","Index":7}]}]},{"Id":203102,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"寄灵仙观舒职方学士"},"Clauses":[{"Content":"方瞳玄鬓粉闱郎，"},{"Content":"绛阙斋心奉紫皇。"},{"Content":"徵士高怀云在岭，"},{"Content":"骚人秋思水周堂。"},{"Content":"闲园露草开三径，"},{"Content":"灵宇华灯烛九光。"},{"Content":"知有美田堪种玉，"},{"Content":"几时春渚逐归艎。"}]},{"Id":203081,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"宋玉","Comments":[{"Content":"一作刘筠诗","Type":"Text","Index":2}]},"Clauses":[{"Content":"章华清宴重游陪，"},{"Content":"已有微词更有才。"},{"Content":"神女梦灵因赋感，"},{"Content":"屈平魂怨待招回。"},{"Content":"悲秋终古情难尽，"},{"Content":"障袂何时望可来。"},{"Content":"祇有大言君自许，"},{"Content":"景差无计上兰台。"}]},{"Id":203095,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"送客不及"},"Clauses":[{"Content":"桥阔川长恨已多，"},{"Content":"斑骓嘶断隔云萝。","Comments":[{"Content":"四库本、王注本作罗","Type":"Text","Index":7}]},{"Content":"遥山几叠迷朱旆，"},{"Content":"芳草经时驻玉珂。"},{"Content":"高鸟可能追夕照，"},{"Content":"绿杨空自拂微波。"},{"Content":"短辕白鼻何由得，"},{"Content":"目送层楼一雁过。"}]},{"Id":203090,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"虞","Rank":0,"Title":{"Content":"直夜"},"Clauses":[{"Content":"千庐徼道发传呼，"},{"Content":"帝宇沉沉璧月孤。"},{"Content":"重橑祇闻喧斗鼠，"},{"Content":"危枝谁见绕惊乌。"},{"Content":"石螭霜重连钩盾，"},{"Content":"玉虎冰消下辘轳。"},{"Content":"素发自怜同骑省，"},{"Content":"一竿何日钓秋鲈。"}]},{"Id":203093,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"柳絮"},"Clauses":[{"Content":"三月江南花渐稀，"},{"Content":"春阴漠漠雪霏霏。"},{"Content":"章台街里翩轻吹，"},{"Content":"灞水桥边送落晖。"},{"Content":"陆凯传精梅暗落，","Comments":[{"Content":"四库本、王注本作情","Type":"Text","Index":4}]},{"Content":"韩凭遗恨蝶争飞。"},{"Content":"诏书漫道吹纶薄，"},{"Content":"谁见纷纷上客衣。"}]},{"Id":203065,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"与客启明"},"Clauses":[{"Content":"越溪微霰洒寒梅，"},{"Content":"家近严陵古钓台。"},{"Content":"梦欲成鱼通夕去，"},{"Content":"书曾凭犬隔秋回。"},{"Content":"干时不为侏儒米，"},{"Content":"乐圣犹衔叔夜杯。"},{"Content":"帝右岂无杨得意，"},{"Content":"汉宫须荐长卿才。"}]},{"Id":203069,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"冬","Title":{"Content":"无题"},"Clauses":[{"Content":"绛缕初分麝气浓，"},{"Content":"弦声不动意潜通。"},{"Content":"圆蟾可见还归海，"},{"Content":"媚蝶多惊欲御风。"},{"Content":"纨扇寄情虽自洁，"},{"Content":"玉壶盛泪祇凝红。"},{"Content":"春窗亦有心知梦，"},{"Content":"未到鸣钟已旋空。"}]}],"Count":111,"PageNo":1,"PageSize":20}