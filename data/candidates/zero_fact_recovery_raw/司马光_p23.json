{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":81009,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"春日思景仁"},"Clauses":[{"Content":"去岁洛城中，"},{"Content":"嬉游处处同。"},{"Content":"从离崿岭北，"},{"Content":"常梦潩泉东。"},{"Content":"草绕春街碧，"},{"Content":"花繁夕市红。"},{"Content":"临风默惆怅，"},{"Content":"想像白眉翁。"}]},{"Id":81541,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"神宗皇帝挽词五首"},"Clauses":[{"Content":"决事神明速，"},{"Content":"任人金石坚。"},{"Content":"天机先兆朕，"},{"Content":"圣度蕴渊泉。"},{"Content":"仁义生知性，"},{"Content":"恩威独化权。"},{"Content":"乾坤无毁息，"},{"Content":"长与大名传。"}]},{"Id":81019,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"神宗皇帝挽词五首"},"Clauses":[{"Content":"听政涉中昃，"},{"Content":"观书达夜分。","Comments":[{"Content":"陈本、四库本作度","Type":"Text","Index":3}]},{"Content":"周王忘自逸，"},{"Content":"汉祖不知勤。"},{"Content":"棣萼因心友，"},{"Content":"云章落笔文。"},{"Content":"它年䌷石室，"},{"Content":"光大继皇坟。"}]},{"Id":81018,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"神宗皇帝挽词五首"},"Clauses":[{"Content":"至德成无象，"},{"Content":"徽名避不居。"},{"Content":"期门弋猎绝，"},{"Content":"步辇宴游疏。"},{"Content":"钱列金釭暗，"},{"Content":"兵严武帐虚。"},{"Content":"蓬莱日晏仗，"},{"Content":"犹望驾宫车。"}]},{"Id":81017,"GroupIndex":4,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"青","Rank":0,"Title":{"Content":"神宗皇帝挽词五首"},"Clauses":[{"Content":"鳌禁叨承诏，"},{"Content":"金华侍执经。"},{"Content":"微生轻草芥，"},{"Content":"圣泽阔沧溟。"},{"Content":"鹿性安林野，"},{"Content":"葵心注阙庭。"},{"Content":"尧云不可望，"},{"Content":"白首涕飘零。"}]},{"Id":81540,"GroupIndex":5,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"盐","Rank":0,"Title":{"Content":"神宗皇帝挽词五首"},"Clauses":[{"Content":"式道清行马，"},{"Content":"灵輴下陛帘。"},{"Content":"云奔同軓集，"},{"Content":"雨泣兆民瞻。"},{"Content":"石阙苍烟暝，"},{"Content":"松门白露沾。"},{"Content":"载弓徒陨绝，"},{"Content":"无计附龙髯。"}]},{"Id":80789,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"北京留守王太师挽歌词二首"},"Clauses":[{"Content":"卢肇时推重，"},{"Content":"终军众共贤。"},{"Content":"何如夺标日，"},{"Content":"未及弃繻年。"},{"Content":"官历清涂遍，"},{"Content":"名居美事先。"},{"Content":"人间福有五，"},{"Content":"视履岂非全。"}]},{"Id":80788,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"北京留守王太师挽歌词二首"},"Clauses":[{"Content":"昔日程文士，","Comments":[{"Content":"自注：光应举，公发解。","Type":"Text","Index":5}]},{"Content":"中间侍坐宾。"},{"Content":"游陪惭晚辈，"},{"Content":"待遇过它人。"},{"Content":"方叹龙门远，"},{"Content":"俄惊马鬣新。"},{"Content":"西园行乐处，"},{"Content":"引领但沾巾。","Comments":[{"Content":"以上《温国文正司马公文集》卷一五","Type":"Text","Index":5}]}]},{"Id":80878,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"到任明年旨罢官有作","Comments":[{"Content":"按《温国文正司马公文集》卷一一《别长安》绝句诗，末二句与此同。","Type":"Text","Index":9}]},"Clauses":[{"Content":"恬然如一梦，"},{"Content":"分竹守长安。"},{"Content":"去日冰犹壮，"},{"Content":"归时花未阑。"},{"Content":"风光经目少，"},{"Content":"惠爱及民难。"},{"Content":"可惜终南色，"},{"Content":"临行子细看。"}]},{"Id":80849,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"别一章改韵同五诗呈尧夫","Comments":[{"Content":"按：五诗即本集卷一一《秋夜》以下五首。","Type":"Text","Index":11}]},"Clauses":[{"Content":"家虽在城阙，"},{"Content":"萧瑟似山阿。"},{"Content":"远去名利窟，"},{"Content":"自称安乐窝。"},{"Content":"云归白石洞，"},{"Content":"鹤立碧松柯。"},{"Content":"得丧非吾事，"},{"Content":"何须更寤歌。"}]},{"Id":80730,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"二十八日会不疑家席上纪实"},"Clauses":[{"Content":"召客客俱来，"},{"Content":"赏花花正开。"},{"Content":"寒暄方得所，"},{"Content":"风雨不相催。"},{"Content":"席上柳飞雪，"},{"Content":"门前车隐雷。"},{"Content":"主人意仍厚，"},{"Content":"安得不徘徊。"}]},{"Id":81181,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"梧桐"},"Clauses":[{"Content":"紫极宫庭阔，"},{"Content":"扶疏四五栽。"},{"Content":"初闻一叶落，"},{"Content":"知是九秋来。"},{"Content":"实满风前地，"},{"Content":"极添雨后苔。"},{"Content":"群仙傥来会，"},{"Content":"灵凤必徘徊。"}]},{"Id":81011,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"齐","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"春猎"},"Clauses":[{"Content":"小苑微寒春雁飞，"},{"Content":"石关宫外草萋萋。"},{"Content":"汉家旌旆连围合，"},{"Content":"秦国山川入望低。"},{"Content":"花色才临珠缀发，"},{"Content":"柳阴欲傍金堤齐。"},{"Content":"韩嫣承恩来视兽，"},{"Content":"飞尘遥出建章西。"}]},{"Id":81560,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"送张兵部知遂州","Comments":[{"Content":"中庸，字无常","Type":"Text","Index":4}]},"Clauses":[{"Content":"剑岭横天古栈微，"},{"Content":"相如重驾传车归。"},{"Content":"双亲倚门望已久，"},{"Content":"千骑踏雪行如飞。"},{"Content":"人间富贵非不有，"},{"Content":"似君荣耀真亦稀。"},{"Content":"闻道西州遗画像，"},{"Content":"使我涕泪空沾衣。","Comments":[{"Content":"自注：先人知小溪县，正板籍，均赋役，闻邑人至今诵之，画像犹存。","Type":"Text","Index":7}]}]},{"Id":80728,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"Title":{"Content":"九日怀聂之美","Comments":[{"Content":"时余在河南，聂在陈州","Type":"Text","Index":6}]},"Clauses":[{"Content":"钱唐江里扁舟上，"},{"Content":"别后篱花几度黄。"},{"Content":"忧患萦心何缭绕，"},{"Content":"风光满目尽凄凉。"},{"Content":"谁同凿落杯中酒，"},{"Content":"独系茱萸肘后囊。"},{"Content":"可复无书道情素，"},{"Content":"云间空有雁南翔。"}]},{"Id":80729,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"Title":{"Content":"九日怀聂之美","Comments":[{"Content":"时余在河南，聂在陈州","Type":"Text","Index":6}]},"Clauses":[{"Content":"太室横山蔽十里，"},{"Content":"相思空复上高台。"},{"Content":"瓮头白酒行当熟，"},{"Content":"篱下黄花稍复开。"},{"Content":"陶令不无同醉兴，"},{"Content":"孟君况有解嘲才。"},{"Content":"欲凭西北高风势，"},{"Content":"飞度轘辕劝一杯。"}]},{"Id":81254,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"Title":{"Content":"赠吴之才"},"Clauses":[{"Content":"胜冠自立艰难里，"},{"Content":"大器由来贵晚成。"},{"Content":"松柏傥非生磊落，"},{"Content":"岩崖何易出峥嵘。"},{"Content":"苏秦游困羞妻嫂，"},{"Content":"主父居贫厌弟兄。"},{"Content":"六印佗年拥车骑，"},{"Content":"会须重过洛阳城。"}]},{"Id":81199,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"冬","Title":{"Content":"寒食许昌道中寄幕府诸君"},"Clauses":[{"Content":"原上烟芜淡复浓，"},{"Content":"寂寥佳节思无穷。"},{"Content":"竹林近水半边绿，"},{"Content":"桃树连村一片红。"},{"Content":"尽日解鞍山店雨，"},{"Content":"晚天回首酒旗风。"},{"Content":"遥知幕府清明饮，"},{"Content":"应笑驱驰羁旅中。","Comments":[{"Content":"原作驱，据陈本、四库本改","Type":"Text","Index":4}]}]},{"Id":81187,"Classes":["軍旅"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"齐","Title":{"Content":"阍吏"},"Clauses":[{"Content":"弊车羸马犯尘泥，"},{"Content":"愁到朱门遍遍辞。"},{"Content":"相国舍人难骤见，"},{"Content":"将军马监岂相知。"},{"Content":"因循岁月劳何补，"},{"Content":"颠倒风埃辱固宜。"},{"Content":"惆怅东冈旧陂在，"},{"Content":"素心空负白云期。"}]},{"Id":81061,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"Title":{"Content":"送朱校理知潍州","Comments":[{"Content":"寀，字廉叔","Type":"Text","Index":4}]},"Clauses":[{"Content":"东国连年水伤稼，"},{"Content":"使君到部即行春。"},{"Content":"茫茫四野潢污竭，"},{"Content":"郁郁万行桑柘新。"},{"Content":"俗不好奢田器贵，"},{"Content":"狱无留系吏家贫。"},{"Content":"齐人忽怨归朝速，"},{"Content":"自是承明侍从臣。"}]}],"Count":1270,"PageNo":23,"PageSize":20}