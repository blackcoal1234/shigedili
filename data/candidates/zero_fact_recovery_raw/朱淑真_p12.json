{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":536108,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"宴谢夫人堂"},"Clauses":[{"Content":"竹引清风入酒卮，"},{"Content":"森森凉气暗侵肌。"},{"Content":"冰峦四叠浑无暑，","Comments":[{"Content":"以上九字原缺，据《诗渊》册六补","Type":"Text","Index":2}]},{"Content":"不似人间六月时。"}]},{"Id":96210,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"青","Title":{"Content":"吊林和靖二者"},"Clauses":[{"Content":"不见孤山处士星，"},{"Content":"西湖风月为谁清。"},{"Content":"当时寂寞冰霜下，"},{"Content":"两句诗成万古名。"}]},{"Id":96211,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"吊林和靖二者"},"Clauses":[{"Content":"短篷载影夜归时，"},{"Content":"月白风清易得诗。"},{"Content":"不识酌泉拈菊意，"},{"Content":"一庭寒翠蔼空祠。"}]},{"Id":96274,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"Title":{"Content":"答求谱"},"Clauses":[{"Content":"雨好解开花百结，"},{"Content":"风恬扶起柳三眠。"},{"Content":"春醲酽处多伤感，"},{"Content":"那得心情事管弦。"}]},{"Id":536109,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"Title":{"Content":"新春二绝"},"Clauses":[{"Content":"雪从庾岭梅中尽，"},{"Content":"春向隋提柳上来。"},{"Content":"多少园林正萧索，"},{"Content":"纷纷争逐趁时开。"}]},{"Id":536110,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"新春二绝"},"Clauses":[{"Content":"黄宫阳气几潜伸，"},{"Content":"玉管吹灰适报春。"},{"Content":"天子只知农事重，"},{"Content":"躬耕端的为吾民。"}]},{"Id":96244,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"春日亭上观鱼"},"Clauses":[{"Content":"春暖长江水正清，"},{"Content":"洋洋得意漾波生。","Comments":[{"Content":"清抄本作平","Type":"Text","Index":7}]},{"Content":"非无欲透龙门志，"},{"Content":"只待新雷震一声。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[漾波] 《古今女史》作[浪波]。[生] 刘履芬校辑钞本作[平]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96253,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"春昼偶成"},"Clauses":[{"Content":"默默深闺掩昼关，"},{"Content":"简编盈案小窗寒。"},{"Content":"却嗟流水琴中意，"},{"Content":"难向人前取次弹。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[盈]《宋元百家诗》作[行]　《古今女史》作[横]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":536112,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"文","Title":{"Content":"立春日妆成宜春花"},"Clauses":[{"Content":"青幡碧胜缕金文，"},{"Content":"柳色梅花逐指新。"},{"Content":"却笑尚为儿女态，"},{"Content":"宝刀剪䌽强为春。"}]},{"Id":96255,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"齐","Rank":0,"FirstClauseRhyme":"齐","Title":{"Content":"春晓杂兴"},"Clauses":[{"Content":"挑尽残灯梦欲迷，"},{"Content":"子规催月小楼西。"},{"Content":"纱窗偷眼天将晓，"},{"Content":"无数宿禽花下啼。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[题]《名媛诗归》　《历朝名媛诗词》作[春晓]。[催月]《名媛诗归》　《历朝名媛诗词》作[啼绝]。[啼]《历朝名媛诗词》作[飞]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96272,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"寒食咏怀"},"Clauses":[{"Content":"淮南寒食更风流，"},{"Content":"丝管纷纷逐胜游。"},{"Content":"春色眼前无限好，"},{"Content":"思亲怀土自多愁。"}]},{"Id":96256,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"Title":{"Content":"春燕"},"Clauses":[{"Content":"帘前日暖翩翩过，"},{"Content":"帘外风轻对对斜。"},{"Content":"偏是社来还社去，"},{"Content":"年年不见蜡梅花。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[风轻] 《武林》本作[风清]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":536113,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"春夜感怀"},"Clauses":[{"Content":"清江碧草两悠悠，"},{"Content":"各自风流一种愁。"},{"Content":"正是落花寒食夜，"},{"Content":"夜深无伴倚空楼。"}]},{"Id":96258,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"齐","Rank":0,"FirstClauseRhyme":"齐","Title":{"Content":"独坐感春"},"Clauses":[{"Content":"翠密藏鸦绿柳提，"},{"Content":"伤春懒矣步桃溪。"},{"Content":"梦回窗下日当午，"},{"Content":"鶗鴂一声林外啼。"}]},{"Id":96212,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"暮春有感"},"Clauses":[{"Content":"倦对飘零满径花，"},{"Content":"静闻春水闹鸣蛙。"},{"Content":"故人何处草空碧，"},{"Content":"撩乱寸心天一涯。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》后集卷一，总题春景","Type":"Text","Index":7}]}]},{"Id":536114,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"夏日作"},"Clauses":[{"Content":"东风迤逦转南风，"},{"Content":"万物全归长养功。"},{"Content":"舜岂无心阜民俗，"},{"Content":"薰薰歌入五弦中。"}]},{"Id":536115,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"暑月独眠"},"Clauses":[{"Content":"纱幮困卧日初长，"},{"Content":"解却红裙小罩凉。"},{"Content":"一篆炉烟笼午枕，"},{"Content":"冰肌生汗白莲香。"}]},{"Id":536116,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"暑夜"},"Clauses":[{"Content":"水亭相对已黄昏，"},{"Content":"静数飞萤过小园。"},{"Content":"窗下孤灯自明灭，"},{"Content":"无陶独自懒扃门。"}]},{"Id":536117,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"青","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"夏夜有作"},"Clauses":[{"Content":"暑夕炎蒸著摸人，"},{"Content":"移床借月卧中庭。"},{"Content":"更深露下衣襟冷，"},{"Content":"梦到阳台不奈醒。"}]},{"Id":536118,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"Title":{"Content":"夏夜乘凉"},"Clauses":[{"Content":"满意好风生水面，"},{"Content":"趁人明月到天心。"},{"Content":"此时情绪谁能会，"},{"Content":"独坐中庭夜已深。"}]}],"Count":367,"PageNo":12,"PageSize":20}