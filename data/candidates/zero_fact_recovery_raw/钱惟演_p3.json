{"Authors":{"Names":["钱惟演"],"AuthorIds":[34195],"Dynasties":["Song"]},"ShiData":[{"Id":203117,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"排律","TypeDetail":"WuPai","Rhyme":"阳","Rank":0,"Title":{"Content":"秋夜对月"},"Clauses":[{"Content":"颢气中秋正，"},{"Content":"明河左界长。"},{"Content":"桂孤香易散，"},{"Content":"蚌冷泪先汪。"},{"Content":"飞盖倾兰坂，"},{"Content":"鸣琴厌烛房。"},{"Content":"玉盘浮浩露，","Comments":[{"Content":"清注本作承","Type":"Text","Index":3}]},{"Content":"素绠冰寒浆。","Comments":[{"Content":"四库本作凝","Type":"Text","Index":3}]},{"Content":"浪白江连楚，"},{"Content":"风凄笛怨羌。"},{"Content":"庾楼聊顾慕，"},{"Content":"潘省更悲凉。"},{"Content":"雪漫誇圆璧，"},{"Content":"珠休号夜光。"},{"Content":"嫦娥悔孀独，"},{"Content":"空见海生桑。"}]},{"Id":203123,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"排律","TypeDetail":"WuPai","Rhyme":"支","Rank":0,"Title":{"Content":"枢密王左丞宅新菊"},"Clauses":[{"Content":"贺燕翻飞地，"},{"Content":"灵芳茂遂时。","Comments":[{"Content":"清注本作遂茂","Type":"Text","Index":4}]},{"Content":"阴连桃李径，"},{"Content":"润接凤凰池。"},{"Content":"夕照挥金葆，"},{"Content":"轻风拂翠蕤。","Comments":[{"Content":"清注本作接","Type":"Text","Index":3}]},{"Content":"露珠清自冱，"},{"Content":"烟素引还披。"},{"Content":"西颢霜虽劲，"},{"Content":"南荣暖更滋。"},{"Content":"撷芳多楚泽，"},{"Content":"得地胜陶篱。"},{"Content":"味可登兰籍，"},{"Content":"香应夺桂旗。"},{"Content":"愿公长却老，"},{"Content":"宴寝奉琼卮。"}]},{"Id":203110,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"排律","TypeDetail":"WuPai","Rhyme":"先","Rank":0,"Title":{"Content":"上巳玉津园赐宴"},"Clauses":[{"Content":"汉家传洛饮，"},{"Content":"楚俗泛兰泉。"},{"Content":"玉液初颁酒，"},{"Content":"金盘屡击鲜。"},{"Content":"珥彤寻竹籞，"},{"Content":"倾盖集芝廛。"},{"Content":"锦羽翻晴旭，"},{"Content":"霞英落暖烟。"},{"Content":"雅音和舜乐，"},{"Content":"睿泽洽尧天。"},{"Content":"更听承云曲，"},{"Content":"同歌在镐年。"}]},{"Id":203118,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"排律","TypeDetail":"WuPai","Rhyme":"蒸","Rank":0,"FirstClauseRhyme":"青","Title":{"Content":"致斋太一宫"},"Clauses":[{"Content":"斋洁奉惟馨，"},{"Content":"瑶台独自升。"},{"Content":"楼迷五里雾，"},{"Content":"坛烛九枝灯。"},{"Content":"珠馆来青雀，"},{"Content":"琁题射玉绳。"},{"Content":"疏钟平野阔，"},{"Content":"古柏夕霏凝。"},{"Content":"鹤扇真规月，"},{"Content":"仙衣可镂冰。"},{"Content":"春茶泛云液，"},{"Content":"晓饭荐兰蒸。"},{"Content":"弃药疑洪井，"},{"Content":"藏书类羽陵。"},{"Content":"回瞻太帝室，"},{"Content":"飞槛更长凭。"}]},{"Id":203120,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"排律","TypeDetail":"WuPai","Rhyme":"灰","Rank":0,"Title":{"Content":"清风十韵"},"Clauses":[{"Content":"溽暑迎秋尽，"},{"Content":"凉飔逗晓回。"},{"Content":"起蘋初淅沥，"},{"Content":"猎桂更徘徊。"},{"Content":"欲引长烟素，"},{"Content":"微飘画烛煤。"},{"Content":"坠桐侵玉井，"},{"Content":"拂柳度章台。"},{"Content":"已觉云翘动，"},{"Content":"还惊月幌开。"},{"Content":"鲛帘移乱影，"},{"Content":"瑶瑟泛馀哀。"},{"Content":"扇掩藏鸾羽，"},{"Content":"荷倾侧露杯。"},{"Content":"正当河左界，"},{"Content":"不待雨东来。"},{"Content":"自好抟垂翼，"},{"Content":"宁劳起死灰。"},{"Content":"楚宫谁第赋，"},{"Content":"宋玉最多才。"}]},{"Id":203116,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"排律","TypeDetail":"WuPai","Rhyme":"豪","Rank":0,"Title":{"Content":"珊瑚笔格"},"Clauses":[{"Content":"蕴粹沧波远，"},{"Content":"搜奇铁网劳。"},{"Content":"柔条钻火树，"},{"Content":"丽景夺星旄。"},{"Content":"丛倚栖油几，"},{"Content":"枝疏荐兔毫。"},{"Content":"宝跗光互映，"},{"Content":"翠匣价相高。"},{"Content":"钩谩标祥谍，"},{"Content":"人须咏楚骚。"},{"Content":"休将铁如意，"},{"Content":"碎击为争豪。"}]},{"Id":203111,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"排律","TypeDetail":"WuPai","Rhyme":"齐","Rank":0,"Title":{"Content":"以蜀纸端砚寄仙芝"},"Clauses":[{"Content":"腻茧裁邛部，"},{"Content":"苍崖映越溪。"},{"Content":"展时云冉冉，"},{"Content":"呵久露凄凄。"},{"Content":"平滑逾鹅素，"},{"Content":"精钢类袅蹄。"},{"Content":"轻于汉宫縠，"},{"Content":"碧似夏王圭。"},{"Content":"钿轴聊闲卷，"},{"Content":"银钩且醉题。"},{"Content":"即时封密诏，"},{"Content":"别有武都泥。","Comments":[{"Content":"以上宋高似孙《纬略》卷一一","Type":"Text","Index":5}]}]},{"Id":203124,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"送张无梦归天台山"},"Clauses":[{"Content":"金庭霞标云半中，"},{"Content":"岩扉涧户凌太空。","Comments":[{"Content":"《舆地纪胜》卷一二作洞","Type":"Text","Index":3}]},{"Content":"飘飘灵气际浮景，"},{"Content":"蝉蜕万物乘高风。"},{"Content":"吾君当天坐环极，"},{"Content":"物色异人方侧席。"},{"Content":"岂因垂钓识羔裘，"},{"Content":"不假张罗得凫舄。"},{"Content":"恩深况遇千龄旦，"},{"Content":"威颜咫尺隆宸盼。"},{"Content":"问政应同牧马言，"},{"Content":"临轩几动犹龙叹。"},{"Content":"方瞳玉骨本无羁，"},{"Content":"驰烟驭气思东归。"},{"Content":"江南芳草正无际，"},{"Content":"林下群莺犹乱飞。"},{"Content":"浮丘挹袂去何处，"},{"Content":"五芝同晓仙露晞。"},{"Content":"人间秘境不可识，"},{"Content":"千载宸章焕岩壁。"}]},{"Id":203125,"GroupIndex":1,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"30","Rank":0,"Title":{"Content":"送僧归护国寺"},"Clauses":[{"Content":"曹溪有真嗣，"},{"Content":"是名大知识。"},{"Content":"得法三十年，"},{"Content":"堂堂坐岩石。"},{"Content":"忽徇云玺招，"},{"Content":"暂屈冥鸿翼。"},{"Content":"褰裳度王城，"},{"Content":"夙驾来军壁。"},{"Content":"陆泉正持戒，"},{"Content":"到溉方蔬食。"},{"Content":"晨炉薝卜霏，"},{"Content":"夜榻氍毹积。"},{"Content":"金钵稻脂香，"},{"Content":"琼瓯茗花碧。"},{"Content":"高谈入幽固，"},{"Content":"默对探虚寂。"},{"Content":"学精西竺言，"},{"Content":"诗妙南朝格。"},{"Content":"与游欣雾润，"},{"Content":"鄙吝犹泉涤。"},{"Content":"遽忆五芝春，"},{"Content":"悠然理归策。"},{"Content":"伊予病且老，"},{"Content":"末景如驹隙。"},{"Content":"惭为中军帅，"},{"Content":"更玷台臣席。"},{"Content":"无功翊熙明，"},{"Content":"何力当优绩。"},{"Content":"莲社久栖心，"},{"Content":"华簪聊寄迹。"},{"Content":"愿辞食地封，"},{"Content":"永事弥天释。"}]},{"Id":203122,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"7","Rank":0,"Title":{"Content":"和司空相公假山"},"Clauses":[{"Content":"斸得古云根，"},{"Content":"苍苍藓痕布。"},{"Content":"丛倚状峰岚，"},{"Content":"霏微起烟素。"},{"Content":"参差衡霍列，"},{"Content":"巉崒虬龙聚。"},{"Content":"挥扇动林风，"},{"Content":"飞香暗岩户。"},{"Content":"谁言盈尺内，"},{"Content":"自有青霄路。"},{"Content":"相君机务閒，"},{"Content":"玩此怀真趣。"},{"Content":"兴似东山归，"},{"Content":"境对曹溪悟。"},{"Content":"美矣仁智心，"},{"Content":"良哉圣明辅。","Comments":[{"Content":"宋祝穆《事文类聚》前集卷一四","Type":"Text","Index":5}]}]},{"Id":203126,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"词","TypeDetail":"Ci","Rhyme":"13","Rank":0,"Title":{"Content":"谪居汉东撰曲"},"TuneId":{"Id":273},"Clauses":[{"Content":"城上风光莺语乱，"},{"Content":"城下烟波春拍岸。","Comments":[{"Content":"《舆地纪胜》卷八三作风","Type":"Text","Index":5}]},{"Content":"绿杨芳草几时休，"},{"Content":"泪眼愁肠先已断。"},{"Content":"情怀渐变成衰晚，","Comments":[{"Content":"《诗话总龟》前集卷二四引作年年","Type":"Text","Index":2}]},{"Content":"鸾鉴朱颜惊暗换。"},{"Content":"昔年多病厌芳樽，"},{"Content":"今日芳樽惟恐浅。","Comments":[{"Content":"宋文莹《湘山野录》卷上","Type":"Text","Index":7}]}],"Comments":[{"Content":"①芳樽：对酒杯的美称。这里指饮酒。<br /><br />【评解】<br /><br />绿杨芳草，烟波拍岸，花间蝶舞，枝上莺啼。又是春光烂熳的时候了。流光似水，物换星移。随着岁月的流逝，不觉朱颜暗换，情怀已非当年。眼前恼人春色，益令人断肠。这首词通过春光春色的描写，婉转含蓄地抒发了诗人内心的无限感伤之情。<br /><br />【集评】<br /><br />黄升《花庵词选》：此公暮年之作，极凄惋。<br />张宗橚《词林纪事》：公谪汉东日，撰玉楼春词，酒阑歌之，必为泣下。<br /><br />【注释】：此为作者暮年遣怀之作。词中以极其凄婉的笔触，抒写了作者的垂暮之感和政治失意的感伤。作品中的“芳草”、“泪眼”、“鸾镜”、“朱颜”等意象无不充满绝望后的浓重感伤色彩，反映出宋初纤丽词风的艺术特色。<br />上片起首两句，从城上和城下两处着墨，声形兼备、富于动感地描绘春景，勾勒出一幅城头上莺语阵阵、风光无限 ；城脚下烟波浩淼、春水拍岸的图画，使读者隐然感觉到主人公的伤春愁绪，从而为下文的遣怀抒情作好了铺垫。<br />上片结末两句转而抒情 ，言绿杨芳草年年生发，而词人已是眼泪流尽 ，愁肠先断 ，愁惨之气溢于言表 。从表现手法上讲，用绿杨芳草来渲染泪眼愁肠，也就达到了情景相生的效果，情致极为凄婉。此二句由景入情，词意陡转，波澜突起。<br />过片两句 ，从精神与形体两方面感叹老之已至，抒写了词人无可奈何的伤感情怀。从中可以窥见，一贬汉东，默默无闻，大势已去，这对于曾经“官兼将相，阶勋、品皆第一 ”的作者来说 ，打击是多么巨大。<br />结拍两句将借酒浇愁这一司空见惯的题材赋予新意，敏锐而恰切地扣住词人对“芳尊”态度的前后变化这一细节 ，形成强烈反差，由景入情，画龙点睛，传神地抒发出一个政治失意者的绝望心情。<br />宋胡仔《苕溪渔隐丛话》卷二云：“侍儿小名录云：‘钱恩公谪汉东日（指钱惟演晚年谪随州），撰《玉楼春》词曰：“城上风光莺语乱，城下烟波春拍岸。绿杨芳草几时休，泪眼愁肠先已断。情怀渐变成衰晚，鸾镜朱颜惊暗换。往年多病厌芳樽，今日芳樽惟恐浅。”每酒阑歌之，则泣下。后阁有白发姬，乃邓王歌鬟惊鸿也 。遽言 ：“先王将薨，预戒挽铎中歌木兰花引绋为送 。今相公亦将亡乎 。”果薨于随州。’”可为此词注脚。","IsComment":false}]},{"Id":203127,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"词","TypeDetail":"Ci","Rhyme":"28","Rank":0,"Title":{"Content":"玉楼春"},"TuneId":{"Id":273},"Clauses":[{"Content":"锦箨参差朱槛曲。"},{"Content":"露濯文犀和粉绿。"},{"Content":"未容浓翠伴桃红，"},{"Content":"已许纤枝留凤宿。","BreakAfter":"1"},{"Content":"嫩似春荑明似玉。"},{"Content":"一寸芳心谁管束。"},{"Content":"劝君速吃莫踟蹰，"},{"Content":"看被南风吹作竹。"}]},{"Id":1149095,"Froms":["全宋文卷一九四","《山左金石志》卷一五","《阙里志》卷一七"],"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"四言诗","TypeDetail":"SiYan","Rhyme":"5","Rank":0,"Title":{"Content":"汉临淮太守孔安国今封曲阜伯赞"},"Clauses":[{"Content":"显显临淮，"},{"Content":"圣人之系。"},{"Content":"训传遗文，"},{"Content":"克示永世。"},{"Content":"绘像庙庭，"},{"Content":"聿章善继。"},{"Content":"东巡受封，"},{"Content":"是为褒异。"}]},{"Id":1149097,"Classes":["題畫"],"Froms":["全宋文卷一九四"],"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"四言诗","TypeDetail":"SiYan","Rank":0,"Title":{"Content":"王父文穆王像赞"},"Clauses":[{"Content":"洸洸显祖，"},{"Content":"命世之英。"},{"Content":"克绍洪业，"},{"Content":"遂尸齐盟。"},{"Content":"玉帛旅贡，"},{"Content":"充于王庭。"},{"Content":"鼓钟声伐，"},{"Content":"正彼邦刑。"},{"Content":"天光浚发，"},{"Content":"德宇惟宁。"},{"Content":"采章润泽，"},{"Content":"角犀丰盈。"},{"Content":"如云之蔚，"},{"Content":"如日之升。"},{"Content":"传诸永代，"},{"Content":"式举威灵。"},{"Content":"孙男惟演百拜敬赞。"}],"Note":"按：《钱氏家书》第二种。"},{"Id":1149098,"Classes":["題畫"],"Froms":["全宋文卷一九四"],"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"四言诗","TypeDetail":"SiYan","Rank":0,"Title":{"Content":"世父忠献王像赞"},"Clauses":[{"Content":"粤若伯氏，"},{"Content":"奕世明烈。"},{"Content":"竭忠尽诚，"},{"Content":"经德秉哲。"},{"Content":"家传玉书，"},{"Content":"手握金钺。"},{"Content":"既抗淮氛，"},{"Content":"乃克闽孽。"},{"Content":"貌也端庄，"},{"Content":"神则莹彻。"},{"Content":"为龙为光，"},{"Content":"如虹如电。"},{"Content":"焕发丹青，"},{"Content":"凛乎冰雪。"},{"Content":"具尔民瞻，"},{"Content":"允谓人杰。"},{"Content":"侄男惟演拜。"}],"Note":"按：《钱氏家书》第二种。"},{"Id":1149099,"Classes":["題畫"],"Froms":["全宋文卷一九四"],"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"四言诗","TypeDetail":"SiYan","Rank":0,"Title":{"Content":"王考忠懿王像赞"},"Clauses":[{"Content":"伟哉先君，"},{"Content":"静渊慈仁。"},{"Content":"诚惟许国，"},{"Content":"忠则忘身。"},{"Content":"克彼僭邦，"},{"Content":"朝于帝宸。"},{"Content":"庙庭合食，"},{"Content":"甲令书勋。"},{"Content":"五精秉耀，"},{"Content":"一气凝醇。"},{"Content":"峻侔春岳，"},{"Content":"爽极秋旻。"},{"Content":"俨若遗像，"},{"Content":"肖然有神。"},{"Content":"子孙保之，"},{"Content":"藻绘长新。"},{"Content":"男惟演百拜。"}],"Note":"按：《钱氏家书》第二种。"},{"Id":203136,"GroupIndex":1,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"日上故陵烟漠漠，"},{"Content":"春归空苑水潺潺。","Comments":[{"Content":"西洛故都","Type":"Text","Index":7}]}],"Note":"按：宋欧阳修《六一诗话》"},{"Id":203158,"GroupIndex":2,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rhyme":"灰","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"正好睡时行十里，"},{"Content":"不交谈处饮三杯。","Comments":[{"Content":"戏为句","Type":"Text","Index":7}]}]},{"Id":203131,"GroupIndex":3,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rhyme":"虞","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"厅前捉到须依法，"},{"Content":"合内盛来定付厨。","Comments":[{"Content":"又","Type":"Text","Index":7}]}],"Note":"按：以上宋宋敏求《春明退朝录》卷中"},{"Id":203157,"GroupIndex":4,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"句","TypeDetail":"Others","Rhyme":"先","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"雪意未成云著地，"},{"Content":"秋声不断雁连天。","Comments":[{"Content":"奉使途中","Type":"Text","Index":7}]}]}],"Count":111,"PageNo":3,"PageSize":20}