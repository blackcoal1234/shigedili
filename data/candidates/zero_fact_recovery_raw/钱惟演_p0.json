{"Authors":{"Names":["钱惟演"],"AuthorIds":[34195],"Dynasties":["Song"]},"ShiData":[{"Id":203106,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"禁中庭树"},"Clauses":[{"Content":"紫闼分阴地，"},{"Content":"丹条擢秀时。"},{"Content":"高枝接温树，"},{"Content":"密叶覆辛夷。"},{"Content":"夜影瑶光接，"},{"Content":"晨英玉露滋。"},{"Content":"乘春好封殖，"},{"Content":"为赋角弓诗。"}]},{"Id":203107,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"槿花"},"Clauses":[{"Content":"绮霞初结处，"},{"Content":"珠露未晞时。"},{"Content":"宝树宁三尺，"},{"Content":"华灯更九枝。"},{"Content":"亭亭方自喜，"},{"Content":"黯黯却成悲。"},{"Content":"欲作飞烟散，","Comments":[{"Content":"原作非，据《诗话总龟》前集卷一三引《诗史》、《宋朝事实类苑》卷三七、四库本、王注本改","Type":"Text","Index":3}]},{"Content":"犹怜反照迟。"}]},{"Id":203066,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"夕阳"},"Clauses":[{"Content":"远色连高树，"},{"Content":"回光射迥楼。"},{"Content":"自翻归雁影，"},{"Content":"更急思虫愁。"},{"Content":"烟暝长先隔，"},{"Content":"霞烘久未收。"},{"Content":"华灯知可继，","Comments":[{"Content":"王注本作如","Type":"Text","Index":3}]},{"Content":"惟照洞房幽。"}]},{"Id":203109,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"霜月"},"Clauses":[{"Content":"霜月正如钩，"},{"Content":"临池更上楼。"},{"Content":"沈侯新觉瘦，"},{"Content":"宋玉旧多愁。"},{"Content":"獭髓分膏密，"},{"Content":"鹅毛写恨稠。"},{"Content":"长怀寄归雁，"},{"Content":"归雁自悠悠。"}]},{"Id":203094,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"秋夕池上"},"Clauses":[{"Content":"圭月上金塘，"},{"Content":"烟容带水光。"},{"Content":"朱华接兰坂，"},{"Content":"绿荇溢鱼防。"},{"Content":"丛暗禽栖密，"},{"Content":"林疏露下凉。"},{"Content":"秋怀已潘鬓，"},{"Content":"无柰更啼螀。","Comments":[{"Content":"以上《西昆酬唱集》卷下","Type":"Text","Index":5}]}]},{"Id":203101,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"留题云门山雍熙院"},"Clauses":[{"Content":"精舍依岩巘，"},{"Content":"香林结薜萝。"},{"Content":"崇台涵夕霭，"},{"Content":"危阁架春波。"},{"Content":"净馔供蒲塞，"},{"Content":"真诠译贝多。"},{"Content":"几时辉昼锦，"},{"Content":"松下驻鸣珂。","Comments":[{"Content":"宋孔延之《会稽掇英总集》卷七","Type":"Text","Index":5}]}]},{"Id":203097,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"送梵才大师归天台","Comments":[{"Content":"《宋诗拾遗》卷二作赠净明庵僧长吉","Type":"Text","Index":8}]},"Clauses":[{"Content":"汉苑辞千柰，"},{"Content":"仙丘访五芝。"},{"Content":"汲瓶春溜满，"},{"Content":"卷裓晓云滋。"},{"Content":"望刹青龙起，"},{"Content":"观涛白马驰。"},{"Content":"红楼曾应制，"},{"Content":"佳句咏朝緌。"}]},{"Id":203099,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"送僧归天宁万年禅院"},"Clauses":[{"Content":"绝巘依沧海，"},{"Content":"疑君际紫氛。"},{"Content":"岩扉晴落雪，"},{"Content":"宝地昼生云。"},{"Content":"净馔芝房秀，"},{"Content":"深炉桂叶熏。"},{"Content":"宰官游未得，"},{"Content":"空愧北山文。","Comments":[{"Content":"以上宋李庚《天台续集》卷上","Type":"Text","Index":5}]}]},{"Id":203084,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"青","Rank":0,"FirstClauseRhyme":"青","Title":{"Content":"护国寺"},"Clauses":[{"Content":"峻极压沧溟，"},{"Content":"清居聚百灵。"},{"Content":"重门深閟邃，"},{"Content":"绝涧远湛冥。"},{"Content":"客问无生法，"},{"Content":"人游不死庭。"},{"Content":"何当谢簪组，"},{"Content":"鸟道驾飞軨。","Comments":[{"Content":"同上书卷中","Type":"Text","Index":5}]}]},{"Id":203082,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"FirstClauseRhyme":"萧","Title":{"Content":"怀天台进禅师"},"Clauses":[{"Content":"默坐理情条，"},{"Content":"虚斋息众嚣。"},{"Content":"寰区指稊米，"},{"Content":"身世谕芭蕉。"},{"Content":"雨任阶生藓，"},{"Content":"风嫌树有瓢。"},{"Content":"惟思白莲社，"},{"Content":"他日许相招。","Comments":[{"Content":"宋林师蒧《天台续集》卷下","Type":"Text","Index":5}]}]},{"Id":203105,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"登师欲东归因成五言"},"Clauses":[{"Content":"谁谓元戎幕，"},{"Content":"今同长者家。"},{"Content":"一音闻说法，"},{"Content":"五叶见开花。"},{"Content":"久住生车耳，"},{"Content":"因闲长道牙。"},{"Content":"方期注金策，"},{"Content":"休梦赤城霞。","Comments":[{"Content":"宋林表民《天台续集别编》卷一","Type":"Text","Index":5}]}]},{"Id":203098,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"青","Rank":0,"FirstClauseRhyme":"青","Title":{"Content":"送禅照大师归越"},"Clauses":[{"Content":"金刹杳霞扃，"},{"Content":"南风漾彩舲。"},{"Content":"吴天六幕远，"},{"Content":"越岫万螺青。"},{"Content":"龙篆霏雕像，"},{"Content":"鲸涛注净瓶。"},{"Content":"上方堪迥望，"},{"Content":"支策见春溟。"}]},{"Id":203092,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"南朝"},"Clauses":[{"Content":"结绮临春映夕霏，"},{"Content":"景阳钟动曙星稀。"},{"Content":"潘妃宝钏光如昼，"},{"Content":"江令花笺落似飞。"},{"Content":"舴艋凌波朱火度，"},{"Content":"觚棱拂汉紫烟微。"},{"Content":"自从饮马秦淮水，"},{"Content":"蜀柳无因对殿帏。"}]},{"Id":203121,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"4","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"休沐端居有怀希圣少卿学士"},"Clauses":[{"Content":"雕盘琼蕊冰寒凘，"},{"Content":"密树蝉嘶下直时。"},{"Content":"更赋新诗答灵运，"},{"Content":"不将团扇隔元规。"},{"Content":"经梅绿草沿阶上，"},{"Content":"尽日流风转蕙迟。"},{"Content":"祇待觚棱照初旭，"},{"Content":"横经还集绛纱帏。"}]},{"Id":203074,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"再次首唱韵和"},"Clauses":[{"Content":"云变危峰万里横，"},{"Content":"簟铺湘水一床平。"},{"Content":"红兰受露消晨渴，"},{"Content":"绿蕙翻风析夜酲。","Comments":[{"Content":"原作折，据四库本改","Type":"Text","Index":5}]},{"Content":"逸少偶书葵扇贵，"},{"Content":"羊欣閒卧练裙轻。"},{"Content":"无妨天上芝泥熟，"},{"Content":"独看瑶光近太清。"}]},{"Id":203073,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"汉武"},"Clauses":[{"Content":"一曲横汾鼓吹回，"},{"Content":"侍臣高会柏梁台。"},{"Content":"金芝烨煜凌晨见，"},{"Content":"青雀轩翔白昼来。"},{"Content":"立候东溟邀鹤驾，"},{"Content":"穷兵西极待龙媒。"},{"Content":"甘泉祭罢神光灭，"},{"Content":"更遣人间识玉杯。"}]},{"Id":203104,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"馆中新蝉"},"Clauses":[{"Content":"冉冉光风泛紫兰，"},{"Content":"新声含怨日将残。"},{"Content":"自怜伴雀成团扇，"},{"Content":"谁许迎秋集武冠。"},{"Content":"委蜕亭皋随木叶，","Comments":[{"Content":"原作脱，据四库本、清注本、王注本改","Type":"Text","Index":2}]},{"Content":"飞緌云表拂仙盘。"},{"Content":"青葱玉树连金爵，"},{"Content":"不觉醯鸡竞羽翰。"}]},{"Id":203108,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"鹤","Comments":[{"Content":"《诗话总龟》、《宋朝事实类苑》作禁中鹤","Type":"Text","Index":1}]},"Clauses":[{"Content":"碧树阴浓接玉墀，"},{"Content":"几年飞舞伴长离。"},{"Content":"天渊风雨多秋意，","Comments":[{"Content":"《诗话总龟》、《宋朝事实类苑》作思","Type":"Text","Index":7}]},{"Content":"辽海烟波失旧期。"},{"Content":"自许一鸣闻迥汉，"},{"Content":"可随三匝绕空枝。"},{"Content":"从来腐鼠何曾顾，"},{"Content":"不似鹓雏枉见疑。"}]},{"Id":203068,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"公子"},"Clauses":[{"Content":"莲勺交衢接荻园，"},{"Content":"来时十里一开筵。"},{"Content":"歌翻南国桃根曲，"},{"Content":"马过章台杏叶鞯。"},{"Content":"别殿对回双绶贵，"},{"Content":"后门归夜九枝然。","Comments":[{"Content":"清注本、王注本作去","Type":"Text","Index":4}]},{"Content":"閒随翠幰攲乌帽，"},{"Content":"紫陌三条入柳烟。"}]},{"Id":203085,"Dynasty":"北宋","Author":"钱惟演","AuthorId":34195,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"蒸","Rank":0,"FirstClauseRhyme":"蒸","Title":{"Content":"夜意","Comments":[{"Content":"四库本作赤日","Type":"Text","Index":2}]},"Clauses":[{"Content":"漏浅风微夜未胜，"},{"Content":"雨云无迹火云凝。"},{"Content":"簟铺寒水频移枕，"},{"Content":"帐卷轻烟更背灯。"},{"Content":"沃顶几思金掌露，"},{"Content":"涤烦谁借玉壶冰。"},{"Content":"兰台知有披襟处，"},{"Content":"宋玉多才独自登。"}]}],"Count":111,"PageNo":0,"PageSize":20}