{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11305,"Classes":["軍旅 送行"],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"送夔州班使君","Comments":[{"Content":"一作皇甫冉诗","Type":"Text","Index":6}]},"Clauses":[{"Content":"晓日照楼船，"},{"Content":"三军拜峡前。"},{"Content":"白云随浪散，"},{"Content":"青壁与城连。"},{"Content":"万岭岷峨雪，"},{"Content":"千家橘柚川。"},{"Content":"还知楚河内，","Comments":[{"Content":"一作如赴","Type":"Text","Index":3}]},{"Content":"天子许经年。"}]},{"Id":11246,"Allusions":[{"AllusionIndex":200,"AllusionKey":"巴字","SentenceIndex":0},{"AllusionIndex":697,"AllusionKey":"宅相","SentenceIndex":3},{"AllusionIndex":8744,"AllusionKey":"魏舒","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"送从舅成都丞广归蜀","Comments":[{"Content":"一本有南字","Type":"Text","Index":7},{"Content":"一作李端诗","Type":"Text","Index":9}]},"Clauses":[{"Content":"巴字天边水，","Comments":[{"Content":"巴字","Type":"AllusionKey","Index":2}]},{"Content":"秦人去是归。"},{"Content":"栈长山雨响，"},{"Content":"溪乱火田稀。"},{"Content":"俗富行应乐，"},{"Content":"官雄禄岂微。"},{"Content":"魏舒终有泪，","Comments":[{"Content":"魏舒","Type":"AllusionKey","Index":2}]},{"Content":"还识宁家衣。"}]},{"Id":11283,"Allusions":[{"AllusionIndex":1023,"AllusionKey":"宓贱","SentenceIndex":2},{"AllusionIndex":8628,"AllusionKey":"王祥","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"送绛州郭参军"},"Clauses":[{"Content":"炎天故绛路，"},{"Content":"千里麦花香。"},{"Content":"董泽雷声发，","Comments":[{"Content":"一作晚","Type":"Text","Index":5}]},{"Content":"汾桥水气凉。"},{"Content":"府趋随宓贱，","Comments":[{"Content":"宓贱","Type":"AllusionKey","Index":5}]},{"Content":"野宴接王祥。","Comments":[{"Content":"王祥","Type":"AllusionKey","Index":5}]},{"Content":"送客今何幸，"},{"Content":"经宵醉玉堂。"}]},{"Id":11289,"Allusions":[{"AllusionIndex":3233,"AllusionKey":"改乡名","Sen