,{"Content":"橘柚亦成蹊。"},{"Content":"还似海沂日，"},{"Content":"风清无鼓鼙。"}]},{"Id":11244,"Allusions":[{"AllusionIndex":4764,"AllusionKey":"七人班","SentenceIndex":3},{"AllusionIndex":9277,"AllusionKey":"谢守","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"送从叔士准赴任润州司士"},"Clauses":[{"Content":"云起山城暮，"},{"Content":"沈沈江上天。"},{"Content":"风吹建业雨，"},{"Content":"浪入广陵船。"},{"Content":"久是吴门客，"},{"Content":"尝闻谢守贤。","Comments":[{"Content":"谢守","Type":"AllusionKey","Index":4}]},{"Content":"终悲去国远，"},{"Content":"泪尽竹林前。"}]},{"Id":11253,"Allusions":[{"AllusionIndex":658,"AllusionKey":"陆与潘","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"送尹枢令狐楚及第后归觐"},"Clauses":[{"Content":"佳人比香草，"},{"Content":"君子即芳兰。"},{"Content":"宝器金罍重，"},{"Content":"清音玉佩寒。"},{"Content":"贡文齐受宠，"},{"Content":"献礼两承欢。","Comments":[{"Content":"一作醴","Type":"Text","Index":2}]},{"Content":"鞍马并汾地，"},{"Content":"争迎陆与潘。","Comments":[{"Content":"陆与潘","Type":"AllusionKey","Index":5}]}]},{"Id":11323,"Allusions":[{"AllusionIndex":270,"AllusionKey":"鹤语冢难寻","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"赋得馆娃宫送王山人游江东"},"Clauses":[{"Content":"苍苍枫树林，"},{"Content":"草合废宫深。"},{"Content":"越水风浪起，"},{"Content":"吴王歌管沈。"},{"Content":"燕归巢已尽，"},{"Content":"鹤语冢难寻。","Comments":[{"Content":"鹤语冢难寻","Type":"AllusionKey","Index":5}]},{"Content":"旅泊彼何夜，"},{"Content":"希君抽玉琴。"}]},{"Id":11409,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"送契玄法师赴内道场"},"Clauses":[{"Content":"昏昏醉老夫，"},{"Content":"灌顶遇醍醐。"},{"Content":"嫔御呈心镜，"},{"Content":"君王赐髻珠。"},{"Content":"降魔须战否，"},{"Content":"问疾敢行无。"},{"Content":"深契何相秘，"},{"Content":"儒宗本不殊。"}]},{"Id":11276,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,