{"Authors":{"Names":["李益"],"AuthorIds":[15274],"Dynasties":["Tang"]},"ShiData":[{"Id":28338,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"献刘济"},"Clauses":[{"Content":"草绿古燕州，"},{"Content":"莺声引独游。"},{"Content":"雁归天北畔，"},{"Content":"春尽海西头。"},{"Content":"向日花偏落，"},{"Content":"驰年水自流。"},{"Content":"感恩知有地，"},{"Content":"不上望京楼。"}]},{"Id":28329,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"哭柏岩禅师"},"Clauses":[{"Content":"遍与傍人别，"},{"Content":"临终尽不愁。"},{"Content":"影堂谁为扫，"},{"Content":"坐塔自看修。"},{"Content":"白日钟边晚，"},{"Content":"青苔钵上秋。"},{"Content":"天涯禅弟子，"},{"Content":"空到柏岩游。"}]},{"Id":28319,"Allusions":[{"AllusionIndex":235,"AllusionKey":"汉飞将","SentenceIndex":0}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"赴邠宁留别"},"Clauses":[{"Content":"身承汉飞将，","Comments":[{"Content":"汉飞将","Type":"AllusionKey","Index":5}]},{"Content":"束发即言兵。"},{"Content":"侠少何相问，"},{"Content":"从来事不平。"},{"Content":"黄云断朔吹，"},{"Content":"白雪拥沙城。"},{"Content":"幸应边书募，"},{"Content":"横戈会取名。"}]},{"Id":28313,"Classes":["軍旅 要地"],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"夜上受降城闻笛","Comments":[{"Content":"一作戎昱诗","Type":"Text","Index":7}]},"Clauses":[{"Content":"入夜思归切，","Comments":[{"Content":"一作归思","Type":"Text","Index":4}]},{"Content":"笛声清更哀。"},{"Content":"愁人不愿听，"},{"Content":"自到枕前来。"},{"Content":"风起塞云断，"},{"Content":"夜深关月开。"},{"Content":"平明独惆怅，"},{"Content":"落尽一庭梅。","Comments":[{"Content":"一作飞","Type":"Text","Index":1}]}]},{"Id":28323,"Classes":["軍旅 送行","軍旅 出塞"],"Allusions":[{"AllusionIndex":5537,"AllusionKey":"轻车","SentenceIndex":0}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"送客归振武"},"Clauses":[{"Content":"骏马事轻车，","Comments":[{"Content":"轻车","Type":"AllusionKey","Index":5}]},{"Content":"军行万里沙。"},{"Content":"胡山通嗢落，"},{"Content":"汉节绕浑邪。"},{"Content":"桂满天西月，"},{"Content":"芦吹塞北笳。"},{"Content":"别离俱报主，"},{"Content":"路极不为赊。"}]},{"Id":28316,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"宣上人病中相寻联句"},"Clauses":[{"Content":"策杖迎诗客，"},{"Content":"归房理病身。"},{"Content":"闲收无效药，"},{"Content":"遍寄有情人。","Comments":[{"Content":"广宣","Type":"Text","Index":5}]},{"Content":"草木分千品，"},{"Content":"方书问六陈。"},{"Content":"还知一室内，"},{"Content":"我尔即天亲。","Comments":[{"Content":"益","Type":"Text","Index":5}]}]},{"Id":28328,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"重阳夜集兰陵居与宣上人联句"},"Clauses":[{"Content":"蟋蟀催寒服，"},{"Content":"茱萸滴露房。"},{"Content":"酒巡明刻烛，"},{"Content":"篱菊暗寻芳。","Comments":[{"Content":"益","Type":"Text","Index":5}]},{"Content":"新月和秋露，"},{"Content":"繁星混夜霜。"},{"Content":"登高今夕事，"},{"Content":"九九是天长。","Comments":[{"Content":"广宣","Type":"Text","Index":5}]}]},{"Id":28336,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"赋应门照绿苔"},"Clauses":[{"Content":"宫阙何年月，"},{"Content":"应门何岁苔。"},{"Content":"清光一以照，"},{"Content":"白露共裴回。","Comments":[{"Content":"益","Type":"Text","Index":5}]},{"Content":"珠履久行绝，"},{"Content":"玉房重未开。"},{"Content":"妾心正如此，"},{"Content":"昭阳歌吹来。","Comments":[{"Content":"法振","Type":"Text","Index":5}]}]},{"Id":28335,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"游栖岩寺"},"Clauses":[{"Content":"晚上梯延洞，"},{"Content":"通宵兴莫穷。"},{"Content":"高明千嶂月，"},{"Content":"清爽一岩风。"},{"Content":"坐久衣衫润，"},{"Content":"吟馀物象空。"},{"Content":"举头星可摘，"},{"Content":"疑在广寒宫。"}],"Note":"按：见《古今图书集成·山川典》卷三五《中条山部》"},{"Id":28307,"Allusions":[{"AllusionIndex":8737,"AllusionKey":"魏国山河","SentenceIndex":1}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"同崔邠登鹳雀楼","Comments":[{"Content":"一作颁","Type":"Text","Index":3}]},"Clauses":[{"Content":"鹳雀楼西百尺樯，","Comments":[{"Content":"一作南，一作前","Type":"Text","Index":4}]},{"Content":"汀洲云树共茫茫。"},{"Content":"汉家箫鼓空流水，"},{"Content":"魏国山河半夕阳。","Comments":[{"Content":"魏国山河","Type":"AllusionKey","Index":4}]},{"Content":"事去千年犹恨速，"},{"Content":"愁来一日即为长。","Comments":[{"Content":"一作知","Type":"Text","Index":6}]},{"Content":"风烟并起思归望，","Comments":[{"Content":"一作尘","Type":"Text","Index":2},{"Content":"一作是","Type":"Text","Index":4},{"Content":"一作乡","Type":"Text","Index":6}]},{"Content":"远目非春亦自伤。"}],"Comments":[{"Book":"《梦溪笔谈》","Content":"河中府鹳雀楼二层，前瞻中条，下瞰大河。唐人留诗者甚多。唯李益、王之涣，畅诸三篇能状其景。","IsComment":false,"FullPath":"《梦溪笔谈》"},{"Book":"《唐诗鼓吹注解》","Content":"此因登楼而有感也。……望风烟之色，感怀乡之思，目穷千里，不因春色而亦自悲伤矣。","IsComment":false,"FullPath":"《唐诗鼓吹注解》"},{"Book":"《唐诗选脉会通评林》","Content":"周敬曰：赋景新切，寓感宏深。陈继儒曰：登眺情景，口边眼边。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《贯华堂选批唐才子诗》","Content":"登楼对景，更不别睹，斗地出手便先写一樯，下即急写汀洲，又急写云树，并不问此樯属何人，到何处，早已一片心魂弥梨麻罗，一递一递，竟自归去也。因言出时何等汉魏，已剩流水夕阳，人生世间，大抵如斯，迟迟不归，我为何事耶（首四句下）？此即趁势转笔，写是日归心刻不能待也。人见是春色，我见是风烟，即俗言“不知天好天暗”也。唐人思归诗甚多，乃更无急于此者（末四句下）。","IsComment":false,"FullPath":"《贯华堂选批唐才子诗》"},{"Book":"《唐诗贯珠笺释》","Content":"通身线索相通。","IsComment":false,"FullPath":"《唐诗贯珠笺释》"},{"Book":"《唐诗成法》","Content":"声调高亮，情致缠绵，十郎固是才子。","IsComment":false,"FullPath":"《唐诗成法》"},{"Book":"《大历诗略》","Content":"是诗颔联用事真切有味也。读书、远游，岂两事哉！","IsComment":false,"FullPath":"《大历诗略》"},{"Book":"《山满楼笺注唐诗七言律》","Content":"倏而魏，倏而汉，又倏而至于今，干年犹恨速，亦事之无可如何者也。欲住不可，欲归不能，欲不住不归又无所之，一日即为长，此真善于言愁者矣。","IsComment":false,"FullPath":"《山满楼笺注唐诗七言律》"},{"Book":"《历代诗法》","Content":"对此茫茫，百端交集。","IsComment":false,"FullPath":"《历代诗法》"},{"Book":"《养一斋诗话》","Content":"较之吴融《鹳雀楼》诗“鸟在林梢脚底看，夕阳无际戍烟残”诸句，稍有诗局。然前半平适落套，后半粗率任情，去王、畅二诗，终不可以道里计。","IsComment":false,"FullPath":"《养一斋诗话》"}]},{"Id":28314,"Allusions":[{"AllusionIndex":91,"AllusionKey":"谢公","SentenceIndex":3}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"元","Rank":0,"Title":{"Content":"奉酬崔员外副使携琴宿使院见示"},"Clauses":[{"Content":"忽闻此夜携琴宿，"},{"Content":"遂叹常时尘吏喧。"},{"Content":"庭木已衰空月亮，"},{"Content":"城砧自急对霜繁。"},{"Content":"犹持副节留军府，"},{"Content":"未荐高词直掖垣。"},{"Content":"谁问南飞长绕树，"},{"Content":"官微同在谢公门。","Comments":[{"Content":"谢公","Type":"AllusionKey","Index":6}]}]},{"Id":28325,"Allusions":[{"AllusionIndex":4669,"AllusionKey":"江淹拟诗","SentenceIndex":3}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"送贾校书东归寄振上人","Comments":[{"Content":"一作振上人院喜见贾弇兼酬别","Type":"Text","Index":10}]},"Clauses":[{"Content":"北风吹雁数声悲，","Comments":[{"Content":"一作南","Type":"Text","Index":3}]},{"Content":"况指前林是别时。"},{"Content":"秋草不堪频送远，"},{"Content":"白云何处更相期。"},{"Content":"山随匹马行看暮，"},{"Content":"路入寒城独去迟。"},{"Content":"为向东州故人道，"},{"Content":"江淹已拟惠休诗。"}]},{"Id":28311,"GroupIndex":1,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"Title":{"Content":"过马嵬二首"},"Clauses":[{"Content":"路至墙垣问樵者，"},{"Content":"顾予云是太真宫。"},{"Content":"太真血染马蹄尽，"},{"Content":"朱阁影随天际空。"},{"Content":"丹壑不闻歌吹夜，"},{"Content":"玉阶唯有薜萝风。"},{"Content":"世人莫重霓裳曲，"},{"Content":"曾致干戈是此中。"}]},{"Id":28312,"GroupIndex":2,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"过马嵬二首"},"Clauses":[{"Content":"金甲银旌尽已回，"},{"Content":"苍茫罗袖隔风埃。"},{"Content":"浓香犹自随鸾辂，"},{"Content":"恨魄无由离马嵬。","Comments":[{"Content":"一作因","Type":"Text","Index":4}]},{"Content":"南内真人悲帐殿，"},{"Content":"东溟方士问蓬莱。"},{"Content":"唯留坡畔弯环月，"},{"Content":"时送残辉入夜台。","Comments":[{"Content":"此首一作李远诗","Type":"Text","Index":7}]}]},{"Id":28330,"Classes":["軍旅 要地"],"Allusions":[{"AllusionIndex":712,"AllusionKey":"倚剑","SentenceIndex":1}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"盐州过胡儿饮马泉","Comments":[{"Content":"一作过五原胡儿饮马泉","Type":"Text","Index":8}]},"Clauses":[{"Content":"绿杨著水草如烟，"},{"Content":"旧是胡儿饮马泉。","Comments":[{"Content":"鸊鹈泉在丰州城北，胡人饮马于此","Type":"Text","Index":7}]},{"Content":"几处吹笳明月夜，"},{"Content":"何人倚剑白云天。","Comments":[{"Content":"倚剑","Type":"AllusionKey","Index":4}]},{"Content":"从来冻合关山路，"},{"Content":"今日分流汉使前。"},{"Content":"莫遣行人照容鬓，"},{"Content":"恐惊憔悴入新年。"}],"Comments":[{"Book":"《唐诗选》","Content":"玉遮曰：末句极言其清，兼影边塞意。","IsComment":false,"FullPath":"《唐诗选》"},{"Book":"《唐诗直解》","Content":"三、四中唐壮语，结亦趣。","IsComment":false,"FullPath":"《唐诗直解》"},{"Book":"《汇编唐诗十集》","Content":"结极有致。","IsComment":false,"FullPath":"《汇编唐诗十集》"},{"Book":"《唐诗选脉会通评林》","Content":"周敬云：通篇慷慨悲壮，结就题上生感慨，有趣。周启琦云：此诗可谓探源昆仑，雄才浩气，更笼络千古。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗评选》","Content":"才称七言小生，不知必且以“几处”、“何人”、“从来”、“今日”讥其尖仄。","IsComment":false,"FullPath":"《唐诗评选》"},{"Book":"《五朝诗善鸣集》","Content":"诵此诗如执玉擎珠，不敢作寻常近玩。","IsComment":false,"FullPath":"《五朝诗善鸣集》"},{"Book":"《删订唐诗解》","Content":"三、四感慨殊深。","IsComment":false,"FullPath":"《删订唐诗解》"},{"Book":"《唐七律选》","Content":"赋题能把捉，且尚有高健之气，稍振单习。","IsComment":false,"FullPath":"《唐七律选》"},{"Book":"《唐三体诗评》","Content":"落句不能振起全篇。然诗以各言其伤，不妨结到私情也。","IsComment":false,"FullPath":"《唐三体诗评》"},{"Book":"《唐诗贯珠笺释》","Content":"的确是中唐面目。气度色泽，自然另是一神。若令晚唐为之，令人泪下而气索矣。","IsComment":false,"FullPath":"《唐诗贯珠笺释》"},{"Book":"《唐诗成法》","Content":"“行人”即自己，容鬓已衰，空有“倚剑白云”之心，而日月逝矣，岁不我与。四有时无英雄之叹。","IsComment":false,"FullPath":"《唐诗成法》"},{"Book":"《近体秋阳》","Content":"如丝垂珠贯，继续生姿，结句感慨致别。","IsComment":false,"FullPath":"《近体秋阳》"},{"Book":"《唐诗别裁》","Content":"“几处吹笳明月夜，何人倚剑白云天？”言备边无人，句特含蓄。","IsComment":false,"FullPath":"《唐诗别裁》"},{"Book":"《大历诗略》","Content":"三、四飏开，慨守边之无良将也。后半仍扼定“泉”字，语不泛。","IsComment":false,"FullPath":"《大历诗略》"},{"Book":"《山满楼笺注唐诗七言律》","Content":"首句七字，先将鸊鹈泉上太平风景一笔描出，想当年饮马之时，安能有此？次句倒落题面，何等自然！于是三四遂用凭吊法，遐企古人开疆辟土之功，笳吹月中，剑倚天外，写得十分豪迈，千载下犹堪令壮士色飞也。“从来”一纵，“今日”一擒，此二句是咏叹法；而“冻合”、“分流”，觉犹是泉也，南北一判，寒暖顿殊，天时地气，宜非人力所能转移，而转移者已如此，写得何等兴会！七、八只就自己身上闲闲作结，妙在不脱“泉”字。","IsComment":false,"FullPath":"《山满楼笺注唐诗七言律》"},{"Book":"《网师园唐诗笺》","Content":"亦悲壮，亦流丽。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"《唐诗笺要》","Content":"中唐最苦软直无婉致，此首人皆称中二联之明快悲壮，予独赏其起结虚婉，与君虞五绝“殷勤驿西路，此去是长安”一样体格。","IsComment":false,"FullPath":"《唐诗笺要》"},{"Book":"《昭昧詹言》","Content":"起句先写景，次句点地。三、四言此是战场，戍卒思乡者多，以引起下文自家，则亦是兴也。五、六实赋，带入自家“至”字（按诗题一作《盐州过五原至饮马泉》）。结句出场，神来之笔，入妙。此等诗，有过此地之人、有命此题之人、有作此题诗之人之性情面目流露其中，所以耐人吟咏。","IsComment":false,"FullPath":"《昭昧詹言》"},{"Book":"唐诗鉴赏辞典","Content":"诗题一作《盐州过胡儿饮马泉》，又作《盐州过五原至饮马泉》。唐代五原县属盐州，今为内蒙古五原。中唐时，这是唐和吐蕃反复争夺的边缘地区。李益曾为幽州节度使刘济幕府，居边塞十余年。这首诗，是抒写诗人在春天经过收复了的五原时的复杂心情。<br /><br />首句描写色彩明丽，景色诱人。但见五原的原野上，杨柳拂水，丰草映目，风光绮丽，春意盎然。可以看出，诗人刚踏上这块土地，心情是十分喜悦的。第二句诗意突然一跌，翻出另一番景象：曾几何时，清清的泉流却成为胡人饮马的地方，美丽的五原成了一片战场。“饮马泉”，原有所指，这里也可泛指供饮马的水泉洼地。“旧是”，暗示出五原这片水草丰盛的土地，曾被吐蕃占据；“旧是”，又有失而复得之意，透露出诗人庆幸收复的欣慰之情。二字抚今追昔，情韵深厚。<br /><br />次联是写夜宿五原的见闻。明月当空，空旷的原野上，隐隐传来哀婉的胡笳声。胡笳，古代军中号角。于是诗人暗思：想必是哪里发生军事行动，不知又是哪些壮士正在英勇卫国哩。“倚剑白云天”化用伪作宋玉《大言赋》“长剑耿耿倚天外”语，赞叹守边将士的英雄形象。然而，诗人用“几处”、“何人”的不定语气表示感叹，用月夜笳声显示悲凉气氛，又蕴含着一种忧伤的情调，微妙地表现出五原一带形势依旧紧张，感慨边防实则尚未巩固。<br /><br />三联通过“从来”和“今日”的景色比较，又透露出诗人的心迹。冰雪严寒，关山险阻，道路坎坷，那是过去的惨景。如今气候解冻，春水分流，展现在人们眼前的则是另一番景象了。这里显然有诗人的感情寄托，“今日”充满生机的景象，毕竟使人感到一种希望和喜悦。“汉使”并非李益自指，他从未充任朝廷使职，当指李益的幕主。这两句写征途的顾往瞻来，寓意在委婉地希望朝廷乘胜前进。<br /><br />末联诗人触景生情，发出意味深长的感慨。如今春暖解冻，这“胡儿饮马泉”的潺潺清流，恰似一面光亮的镜子，能照见人景，然而切莫照呀，如果看见自己憔悴的面容怕是要吃惊呢！“莫遣”两字，见出诗人微妙的心曲。因为这胡儿饮马泉，何尝不是一面反映唐朝政治紊乱、国家衰弱的历史的镜子？正因为诗人积累了太多的失意、失望的体验，所以值此新春伊始，他不愿再用这面镜子对照自己失去的青春，不愿回顾已往。面对眼前国力犹弱、边防未固的现实，他更担心再度出现过去那样的悲凉景象。这种患得患失、忐忑不安的忧虑和伤感，表现出诗人多么希望保持这“绿杨著水草如烟”的眼前景色。因而他巧妙地采用不要让行人临水鉴镜的讽劝方式，委婉地表达了自己对朝廷的期望和忠告。<br /><br />同激昂高扬的盛唐边塞诗相比，李益这首诗忧伤重于欢欣，失望多于希望，情调大相径庭。这是不同时代使然。同时，正由于诗人具有爱国热忱，因而明知前途难测，希望微茫，却仍然要给人以欢欣和希望，这是诗人思想感情使然。这就使这首诗独具一种风格，欢而不乐，伤而不哀，明快而婉转，悠扬而低回，把复杂矛盾的思想感情表现得和谐动人，含蓄不尽。明人胡震亨概括李益边塞诗的基本情调是“悲壮婉转”，能“令人凄断”，这首诗正可作为代表。<br /><br />（倪其心）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]},{"Id":28340,"Allusions":[{"AllusionIndex":5888,"AllusionKey":"龙飞","SentenceIndex":1}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"赠宣大师"},"Clauses":[{"Content":"一国沙弥独解诗，"},{"Content":"人人道胜惠林师。"},{"Content":"先皇诏下徵还日，"},{"Content":"今上龙飞入内时。","Comments":[{"Content":"龙飞","Type":"AllusionKey","Index":4}]},{"Content":"看月忆来松寺宿，"},{"Content":"寻花思作杏溪期。"},{"Content":"因论佛地求心地，"},{"Content":"秪说常吟是住持。"}]},{"Id":28303,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"Title":{"Content":"八月十五夜宣上人独游安国寺山庭院步人迟明将至因话昨宵乘兴联句","Comments":[{"Content":"以下三首又见广宣集","Type":"Text","Index":30}]},"Clauses":[{"Content":"九重城接天花界，"},{"Content":"三五秋生一夜风。"},{"Content":"行听漏声云散后，"},{"Content":"遥闻天语月明中。","Comments":[{"Content":"广宣","Type":"Text","Index":7}]},{"Content":"含凉阁迥通仙掖，"},{"Content":"承露盘高出上宫。"},{"Content":"谁问独愁门外客，"},{"Content":"清谈不与此宵同。","Comments":[{"Content":"益","Type":"Text","Index":7}]}]},{"Id":28289,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"尤","Rank":0,"Title":{"Content":"赋得路傍一株柳送邢校书赴延州使府"},"Clauses":[{"Content":"路傍一株柳，"},{"Content":"此路向延州。"},{"Content":"延州在何处，"},{"Content":"此路起悠悠。","Comments":[{"Content":"一作边愁","Type":"Text","Index":5}]}]},{"Id":28281,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"Title":{"Content":"重赠邢校书"},"Clauses":[{"Content":"俱从四方事，","Comments":[{"Content":"一作士","Type":"Text","Index":5}]},{"Content":"共会九秋中。"},{"Content":"断蓬与落叶，"},{"Content":"相值各因风。"}]},{"Id":28296,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"支","Rank":0,"Title":{"Content":"照镜"},"Clauses":[{"Content":"衰鬓朝临镜，"},{"Content":"将看却自疑。","Comments":[{"Content":"一作各","Type":"Text","Index":3}]},{"Content":"惭君明似月，"},{"Content":"照我白如丝。"}]}],"Count":169,"PageNo":1,"PageSize":20}