{"Authors":{"Names":["李益"],"AuthorIds":[15274],"Dynasties":["Tang"]},"ShiData":[{"Id":28237,"Allusions":[{"AllusionIndex":5573,"AllusionKey":"尧蓂","SentenceIndex":1}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"青","Rank":0,"Title":{"Content":"书院无历日以诗代书问路侍御六月大小"},"Clauses":[{"Content":"野性迷尧历，"},{"Content":"松窗有道经。"},{"Content":"故人为柱史，"},{"Content":"为我数阶蓂。"}]},{"Id":28378,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"沃","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"闻鸡赠主人"},"Clauses":[{"Content":"胶胶司晨鸣，"},{"Content":"报尔东方旭。"},{"Content":"无事恋君轩，"},{"Content":"今君重凫鹄。"}]},{"Id":28286,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"先","Rank":0,"Title":{"Content":"登白楼见白鸟席上命鹧鸪辞"},"Clauses":[{"Content":"一鸟如霜雪，"},{"Content":"飞向白楼前。","Comments":[{"Content":"一作下","Type":"Text","Index":2}]},{"Content":"问君何以至，"},{"Content":"天子太平年。"}]},{"Id":28244,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"Title":{"Content":"石楼山见月","Comments":[{"Content":"一作宿青山石楼","Type":"Text","Index":5}]},"Clauses":[{"Content":"紫塞连年戍，"},{"Content":"黄砂碛路穷。"},{"Content":"故人今夜宿，","Comments":[{"Content":"一作山","Type":"Text","Index":2}]},{"Content":"见月石楼中。"}]},{"Id":28284,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"真","Rank":0,"Title":{"Content":"惜春伤同幕故人孟郎中兼呈去年看花友","Comments":[{"Content":"一本有杜侍御三字","Type":"Text","Index":10}]},"Clauses":[{"Content":"畏老身全老，","Comments":[{"Content":"一作今","Type":"Text","Index":4}]},{"Content":"逢春解惜春。"},{"Content":"今年看花伴，"},{"Content":"已少去年人。"}]},{"Id":28297,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"支","Rank":0,"Title":{"Content":"嘉禾寺见亡友王七题壁"},"Clauses":[{"Content":"今日忆君处，"},{"Content":"忆君君岂知。"},{"Content":"空馀暗尘字，"},{"Content":"读罢泪仍垂。"}]},{"Id":28299,"Allusions":[{"AllusionIndex":5423,"AllusionKey":"朗陵翁","SentenceIndex":1}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"Title":{"Content":"赠内兄卢纶"},"Clauses":[{"Content":"世故中年别，"},{"Content":"馀生此会同。"},{"Content":"却将悲与病，","Comments":[{"Content":"一作愁","Type":"Text","Index":3}]},{"Content":"来对朗陵翁。","Comments":[{"Content":"一作独","Type":"Text","Index":1},{"Content":"朗陵翁","Type":"AllusionKey","Index":5}]}]},{"Id":28287,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"真","Rank":0,"Title":{"Content":"答广宣供奉问兰陵居"},"Clauses":[{"Content":"居北有朝路，"},{"Content":"居南无住人。"},{"Content":"劳师问家第，"},{"Content":"山色是南邻。"}]},{"Id":28234,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"文","Rank":0,"Title":{"Content":"乞宽禅师瘿山罍呈宣供奉"},"Clauses":[{"Content":"石色凝秋藓，"},{"Content":"峰形若夏云。"},{"Content":"谁留秦苑地，"},{"Content":"好赠杏溪君。"}]},{"Id":28255,"Allusions":[{"AllusionIndex":7642,"AllusionKey":"射雕将","SentenceIndex":0}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"文","Rank":0,"Title":{"Content":"观骑射"},"Clauses":[{"Content":"边头射雕将，","Comments":[{"Content":"射雕将","Type":"AllusionKey","Index":5}]},{"Content":"走马出中军。"},{"Content":"远见平原上，"},{"Content":"翻身向暮云。"}]},{"Id":28272,"Classes":["軍旅 戍守"],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"幽州赋诗见意时佐刘幕","Comments":[{"Content":"一作题太原落漠驿西堠","Type":"Text","Index":10}]},"Clauses":[{"Content":"征戍在桑乾，"},{"Content":"年年蓟水寒。"},{"Content":"殷勤驿西路，","Comments":[{"Content":"一作堠","Type":"Text","Index":5}]},{"Content":"北去向长安。","Comments":[{"Content":"一作此","Type":"Text","Index":1},{"Content":"一作路","Type":"Text","Index":2},{"Content":"一作到","Type":"Text","Index":3}]}],"Comments":[{"Book":"《批点唐诗正声》","Content":"久戍塞下，如此岂不怨？妙在不言。","IsComment":false,"FullPath":"《批点唐诗正声》"},{"Book":"《唐诗直解》","Content":"客思在言表见。","IsComment":false,"FullPath":"《唐诗直解》"},{"Book":"《增订唐诗摘钞》","Content":"“殷勤”二字，唐人用之每妙。不言人不能归长安，但言驿路悠悠，如殷勤待人从此西去，立言之妙如此。","IsComment":false,"FullPath":"《增订唐诗摘钞》"}]},{"Id":28247,"Classes":["軍旅 感懷"],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"军次阳城烽舍北流泉"},"Clauses":[{"Content":"何地可潸然，"},{"Content":"阳城烽树边。","Comments":[{"Content":"一作舍","Type":"Text","Index":4}]},{"Content":"今朝望乡客，"},{"Content":"不饮北流泉。"}]},{"Id":28269,"Allusions":[{"AllusionIndex":3036,"AllusionKey":"冯子都","SentenceIndex":0},{"AllusionIndex":6787,"AllusionKey":"栖乌","SentenceIndex":1}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"金吾子"},"Clauses":[{"Content":"绣帐博山炉，"},{"Content":"银鞍冯子都。","Comments":[{"Content":"冯子都","Type":"AllusionKey","Index":5}]},{"Content":"黄昏莫攀折，"},{"Content":"惊起欲栖乌。","Comments":[{"Content":"栖乌","Type":"AllusionKey","Index":5}]}]},{"Id":28235,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"微","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"山鹧鸪词","Comments":[{"Content":"一本题上无山字","Type":"Text","Index":4}]},"Clauses":[{"Content":"湘江斑竹枝，"},{"Content":"锦翅鹧鸪飞。"},{"Content":"处处湘云合，"},{"Content":"郎从何处归。"}],"Comments":[{"Book":"《唐人万首绝句选评》","Content":"斑竹血泪以自比，鹧鸪行不得以喻郎，比兴深远，语意缥缈，神品也。","IsComment":false,"FullPath":"《唐人万首绝句选评》"},{"Book":"《诗境浅说续编》","Content":"前二句兴体也，后二句赋体也，皆美人香草之寓言。沈休文诗：“梦中不识路”，言梦去之无从。此云“处处湘云合”，言郎归之莫辨。相思无际，寄怀于水重云复之乡，乐府遗音也。","IsComment":false,"FullPath":"《诗境浅说续编》"}]},{"Id":28245,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"Title":{"Content":"立秋前一日览镜"},"Clauses":[{"Content":"万事销身外，"},{"Content":"生涯在镜中。"},{"Content":"唯将满鬓雪，"},{"Content":"明日对秋风。"}],"Comments":[{"Book":"唐诗鉴赏辞典","Content":"这首诗，当是诗人失意时的即兴之作，深含身世之慨和人生体验，构思精巧，颇有意趣。<br /><br />失志不遇的悲哀，莫过于年华蹉跎而志业无成，乃至无望。如果认定无望，反而转向超脱，看破红尘。在封建士人中，多数是明知无望，却仍抱希望，依旧奔波仕途，甘受沦落苦楚。李益这诗即作是想，怀此情。<br /><br />明天立秋，今天照镜子，不言而喻，有悲秋的意味。诗人看见自己两鬓花白如雪，苍老了。但他不惊不悲，而是平静淡漠，甚至有点调侃自嘲。镜中的面容，毕竟只表现过去的经历，是已知的体验。他觉得自己活着，这就够了，身外一切往事都可以一笔勾销，无须多想，不必烦恼，就让它留在镜子里。但是，镜外的诗人要面对明天，走向前途，该怎么办呢？他觉得明天恰同昨日。过去无成而无得，将来正可无求而无失。何况时光无情，明日立秋，秋风一起，万物凋零，自己的命运也如此，不容超脱，无从选择，只有在此华发之年，怀着一颗被失望凉却的心，去面对肃杀的秋风，接受凋零的前途。这自觉的无望，使他从悲哀而淡漠，变得异常冷静而清醒，虽未绝望，却趋无谓，置一生辛酸于身外，有无限苦涩在言表。这就是此诗中诗人的情怀。<br /><br />诗题“立秋前一日”点明写作日期，而主要用以表示本诗的比兴寓意在悲秋。“览镜”，取喻镜鉴，顾往瞻来。前二句概括失志的过去，是顾往；后二句抒写无望的未来，是瞻来。首句，实则已把身世感慨说尽，然后以“在镜中”、“两鬓雪”、“对秋风”这些具体形象以实喻虚，来表达那一言难尽的的遭遇和前途。这些比喻，既明白，又含蓄不尽，使全篇既有实感，又富意趣，浑然一体，一气呵成。<br /><br />（倪其心）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]},{"Id":28241,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"麻","Rank":0,"Title":{"Content":"代人乞花"},"Clauses":[{"Content":"绣户朝眠起，"},{"Content":"开帘满地花。"},{"Content":"春风解人意，"},{"Content":"欲落妾西家。","Comments":[{"Content":"一作吹","Type":"Text","Index":1}]}]},{"Id":28249,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"真","Rank":0,"Title":{"Content":"扬州怀古"},"Clauses":[{"Content":"故国歌钟地，"},{"Content":"长桥车马尘。"},{"Content":"彭城阁边柳，"},{"Content":"偏似不胜春。"}]},{"Id":28240,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"江","Rank":0,"FirstClauseRhyme":"江","Title":{"Content":"水宿闻雁"},"Clauses":[{"Content":"早雁忽为双，"},{"Content":"惊秋风水窗。"},{"Content":"夜长人自起，"},{"Content":"星月满空江。"}],"Comments":[{"Book":"《秋窗随笔》","Content":"李益诗“早雁忽为双……”所谓“不著一字，尽得风流”者邪？","IsComment":false,"FullPath":"《秋窗随笔》"},{"Book":"《唐人绝句精华》","Content":"将一瞬间耳闻目见者以二十字写出，光景犹新。","IsComment":false,"FullPath":"《唐人绝句精华》"}]},{"Id":28248,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"Title":{"Content":"扬州早雁"},"Clauses":[{"Content":"江上三千雁，"},{"Content":"年年过故宫。"},{"Content":"可怜江上月，"},{"Content":"偏照断根蓬。"}]},{"Id":28233,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"支","Rank":0,"Title":{"Content":"下楼","Comments":[{"Content":"一本有漏字","Type":"Text","Index":1}]},"Clauses":[{"Content":"话旧全应老，","Comments":[{"Content":"一作今","Type":"Text","Index":3},{"Content":"一作远","Type":"Text","Index":5}]},{"Content":"逢春喜又悲。"},{"Content":"看花行拭泪，"},{"Content":"倍觉下楼迟。"}]}],"Count":169,"PageNo":2,"PageSize":20}