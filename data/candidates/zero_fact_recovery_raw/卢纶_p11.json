{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11117,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"村南逢病叟"},"Clauses":[{"Content":"双膝过颐顶在肩，"},{"Content":"四邻知姓不知年。"},{"Content":"卧驱鸟雀惜禾黍，"},{"Content":"犹恐诸孙无社钱。"}],"Comments":[{"Book":"《唐诗选脉会通评林》","Content":"方回曰：尽老态之常。大历诗格，壮丽悲感。吴山民曰：首句病叟肖像，末句病叟实心。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《批点唐音》","Content":"太露。","IsComment":false,"FullPath":"《批点唐音》"}]},{"Id":11099,"GroupIndex":1,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"王评事驸马花烛诗"},"Clauses":[{"Content":"万条银烛引天人，"},{"Content":"十月长安半夜春。"},{"Content":"步障三千隘将断，","Comments":[{"Content":"一作无间","Type":"Text","Index":6}]},{"Content":"几多珠翠落香尘。"}]},{"Id":11100,"GroupIndex":2,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"王评事驸马花烛诗"},"Clauses":[{"Content":"一人女婿万人怜，"},{"Content":"一夜调疏抵百年。","Comments":[{"Content":"一作稠","Type":"Text","Index":3}]},{"Content":"为报司徒好将息，"},{"Content":"明珠解转又能圆。"}]},{"Id":11101,"GroupIndex":3,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"王评事驸马花烛诗"},"Clauses":[{"Content":"人主人臣是亲家，"},{"Content":"千秋万岁保荣华。"},{"Content":"几时曾向高天上，"},{"Content":"得见今宵月里花。"}]},{"Id":11102,"GroupIndex":4,"Allusions":[{"AllusionIndex":63,"AllusionKey":"满城香","SentenceIndex":0},{"AllusionIndex":1465,"AllusionKey":"和鸣","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"王评事驸马花烛诗"},"Clauses":[{"Content":"比翼和鸣双凤皇，","Comments":[{"Content":"和鸣","Type":"AllusionKey","Index":4}]},{"Content":"欲栖金帐满城香。","Comments":[{"Content":"一作玉梅","Type":"Text","Index":2},{"Content":"满城香","Type":"AllusionKey","Index":7}]},{"Content":"平明却入天泉里，"},{"Content":"日气曈昽五色光。"}]},{"Id":11105,"GroupIndex":1,"Allusions":[{"AllusionIndex":2667,"AllusionKey":"潘郎","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"古艳诗"},"Clauses":[{"Content":"残妆色浅髻鬟开，"},{"Content":"笑映朱帘觑客来。"},{"Content":"推醉谁知弄花钿，"},{"Content":"潘郎不敢使人催。","Comments":[{"Content":"潘郎","Type":"AllusionKey","Index":2}]}]},{"Id":11106,"GroupIndex":2,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"古艳诗"},"Clauses":[{"Content":"自拈裙带结同心，"},{"Content":"暖处偏知香气深。","Comments":[{"Content":"一作多","Type":"Text","Index":4}]},{"Content":"爱捉狂夫问闲事，"},{"Content":"不知歌舞用黄金。"}]},{"Id":11127,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"苦雨闻包谏议欲见访戏赠"},"Clauses":[{"Content":"草气厨烟咽不开，"},{"Content":"绕床连壁尽生苔。"},{"Content":"常时多病因多雨，"},{"Content":"那敢烦君车马来。"}]},{"Id":11130,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"春日忆司空文明"},"Clauses":[{"Content":"桃李风多日欲阴，"},{"Content":"百劳飞处落花深。"},{"Content":"贫居静久难逢信，"},{"Content":"知隔春山不可寻。"}]},{"Id":11145,"Allusions":[{"AllusionIndex":749,"AllusionKey":"玉人","SentenceIndex":1},{"AllusionIndex":2778,"AllusionKey":"莲花府","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"偶逢姚校书凭附书达河南郤推官因以戏赠"},"Clauses":[{"Content":"寄书常切到常迟，"},{"Content":"今日凭君君莫辞。"},{"Content":"若问玉人殊易识，","Comments":[{"Content":"一作君","Type":"Text","Index":1},{"Content":"玉人","Type":"AllusionKey","Index":4}]},{"Content":"莲花府里最清羸。","Comments":[{"Content":"莲花府","Type":"AllusionKey","Index":3}]}]},{"Id":11128,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"Title":{"Content":"驿中望山戏赠渭南陆贽主簿"},"Clauses":[{"Content":"官微多惧事多同，"},{"Content":"拙性偏无主驿功。"},{"Content":"山在门前登不得，"},{"Content":"鬓毛衰尽路尘中。","Comments":[{"Content":"一作落","Type":"Text","Index":5}]}]},{"Id":11159,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"赠韩山人"},"Clauses":[{"Content":"见君何事不惭颜，"},{"Content":"白发生来未到山。"},{"Content":"更叹无家又无药，"},{"Content":"往来唯在酒徒间。"}]},{"Id":11134,"Allusions":[{"AllusionIndex":528,"AllusionKey":"侯嬴","SentenceIndex":1},{"AllusionIndex":1783,"AllusionKey":"珠履","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"浑赞善东斋戏赠陈归"},"Clauses":[{"Content":"长裾珠履飒轻尘，","Comments":[{"Content":"珠履","Type":"AllusionKey","Index":4}]},{"Content":"閒以琴书列上宾。"},{"Content":"公子无雠可邀请，"},{"Content":"侯嬴此坐是何人。","Comments":[{"Content":"侯嬴","Type":"AllusionKey","Index":2}]}]},{"Id":11126,"Allusions":[{"AllusionIndex":8654,"AllusionKey":"萱草","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"玩春因寄冯卫二补阙戏呈李益","Comments":[{"Content":"时君与李新除侍御史","Type":"Text","Index":13}]},"Clauses":[{"Content":"掖垣春色自天来，"},{"Content":"红药当阶次第开。"},{"Content":"萱草丛丛尔何物，","Comments":[{"Content":"萱草","Type":"AllusionKey","Index":2}]},{"Content":"等闲穿破绿莓苔。"}]},{"Id":11104,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"冬","Rank":0,"Title":{"Content":"出山逢耿湋"},"Clauses":[{"Content":"云雪离披山万里，","Comments":[{"Content":"一作千","Type":"Text","Index":5}]},{"Content":"别来曾住最高峰。"},{"Content":"暂到人间归不得，"},{"Content":"长安陌上又相逢。"}]},{"Id":11140,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"重同畅当奘公院闻琴"},"Clauses":[{"Content":"误以音声祈远公，"},{"Content":"请将徽轸付秋风。"},{"Content":"漾漾硖流吹不尽，"},{"Content":"月华如在白波中。"}]},{"Id":11116,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"过玉真公主影殿","Comments":[{"Content":"（一作题安国观）。（一作卢尚书诗）","Type":"Text","Index":7}]},"Clauses":[{"Content":"夕照临窗起暗尘，","Comments":[{"Content":"一作闲","Type":"Text","Index":3}]},{"Content":"青松绕殿不知春。","Comments":[{"Content":"一作锁","Type":"Text","Index":3}]},{"Content":"君看白发诵经者，"},{"Content":"半是宫中歌舞人。"}],"Comments":[{"Book":"《唐语林》","Content":"政平坊安国观，明皇时玉真公主所建。门楼高九十尺，而柱端无斜。殿南有精思院，……院南池引御渠水注之，叠石像蓬莱、方丈、瀛洲三山。女冠多上阳宫人。其东与国学相接。咸通中，有书生云：“尝闻山池内，步虚、笙磬之音。”卢尚书有诗云：“夕照纱窗起暗尘……”","IsComment":false,"FullPath":"《唐语林》"}]},{"Id":11155,"Classes":["題畫"],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"题嘉祥殿南溪印禅师壁画影堂"},"Clauses":[{"Content":"双屐参差锡杖斜，","Comments":[{"Content":"一作屦","Type":"Text","Index":2}]},{"Content":"衲衣交膝对天花。"},{"Content":"瞻容悟问修持劫，","Comments":[{"Content":"一作空","Type":"Text","Index":2}]},{"Content":"似指前溪无数沙。"}]},{"Id":11152,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"Title":{"Content":"题伯夷庙"},"Clauses":[{"Content":"中条山下黄礓石，"},{"Content":"垒作夷齐庙里神。"},{"Content":"落叶满阶尘满座，"},{"Content":"不知浇酒为何人。","Comments":[{"Content":"一作是","Type":"Text","Index":5}]}]},{"Id":11112,"GroupIndex":1,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"曲江春望"},"Clauses":[{"Content":"菖蒲翻叶柳交枝，"},{"Content":"暗上莲舟鸟不知。"},{"Content":"更到无花最深处，"},{"Content":"玉楼金殿影参差。"}],"Comments":[{"Book":"《诗境浅说续编》","Content":"此首虽无深意，而当日曲江风景，可想其大概。","IsComment":false,"FullPath":"《诗境浅说续编》"}]}],"Count":337,"PageNo":11,"PageSize":20}