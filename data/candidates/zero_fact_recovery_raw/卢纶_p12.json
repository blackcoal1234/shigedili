{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11113,"GroupIndex":2,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"Title":{"Content":"曲江春望"},"Clauses":[{"Content":"翠黛红妆画鹢中，"},{"Content":"共惊云色带微风。"},{"Content":"箫管曲长吹未尽，"},{"Content":"花南水北雨濛濛。"}]},{"Id":11114,"GroupIndex":3,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"曲江春望"},"Clauses":[{"Content":"泉声遍野入芳洲，"},{"Content":"拥沫吹花草上流。","Comments":[{"Content":"一作上碧","Type":"Text","Index":6}]},{"Content":"落日行人渐无路，","Comments":[{"Content":"一作二月","Type":"Text","Index":2}]},{"Content":"巢乌乳燕满高楼。","Comments":[{"Content":"一作蜂","Type":"Text","Index":2}]}]},{"Id":11108,"GroupIndex":1,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"华清宫"},"Clauses":[{"Content":"汉家天子好经过，"},{"Content":"白日青山宫殿多。"},{"Content":"见说只今生草处，"},{"Content":"禁泉荒石已相和。"}]},{"Id":11109,"GroupIndex":2,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"华清宫"},"Clauses":[{"Content":"水气朦胧满画梁，","Comments":[{"Content":"一作天","Type":"Text","Index":1},{"Content":"一作暖","Type":"Text","Index":5}]},{"Content":"一回开殿满山香。"},{"Content":"宫娃几许经歌舞，"},{"Content":"白首翻令忆建章。"}]},{"Id":11154,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"题悟真寺"},"Clauses":[{"Content":"万峰交掩一峰开，"},{"Content":"晓色常从天上来。"},{"Content":"似到西方诸佛国，"},{"Content":"莲花影里数楼台。","Comments":[{"Content":"一作层","Type":"Text","Index":6}]}]},{"Id":11131,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"春日登楼有怀"},"Clauses":[{"Content":"花正浓时人正愁，"},{"Content":"逢花却欲替花羞。"},{"Content":"年来笑伴皆归去，"},{"Content":"今日晴明独上楼。","Comments":[{"Content":"一作春风","Type":"Text","Index":4}]}]},{"Id":11391,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"遇","Rank":0,"Title":{"Content":"过仙游寺"},"Clauses":[{"Content":"上方下方雪中路，"},{"Content":"白云流水如闲步。","Comments":[{"Content":"一作闲数步","Type":"Text","Index":7}]},{"Content":"数峰行尽犹未归，","Comments":[{"Content":"一作峰到尽时","Type":"Text","Index":4}]},{"Content":"寂寞经声竹阴暮。"}]},{"Id":11111,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"同路郎中韩侍御春日题野寺"},"Clauses":[{"Content":"寺前山远古陂宽，"},{"Content":"寺里人稀春草寒。","Comments":[{"Content":"一作移","Type":"Text","Index":4}]},{"Content":"何事最堪悲色相，"},{"Content":"折花将与老僧看。"}]},{"Id":11125,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"河中府崇福寺看花"},"Clauses":[{"Content":"闻道山花如火红，"},{"Content":"平明登寺已经风。"},{"Content":"老僧无见亦无说，"},{"Content":"应与看人心不同。"}]},{"Id":11091,"Allusions":[{"AllusionIndex":2264,"AllusionKey":"龙门","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"小鱼咏寄泾州杨侍郎"},"Clauses":[{"Content":"莲花影里暂相离，"},{"Content":"才出浮萍值罟师。"},{"Content":"上得龙门还失浪，","Comments":[{"Content":"龙门","Type":"AllusionKey","Index":4}]},{"Content":"九江何处是归期。"}]},{"Id":11142,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"Title":{"Content":"贼中与严越卿曲江看花"},"Clauses":[{"Content":"红枝欲折紫枝殷，","Comments":[{"Content":"一作繁","Type":"Text","Index":7}]},{"Content":"隔水连宫不用攀。"},{"Content":"会待长风吹落尽，"},{"Content":"始能开眼向青山。"}]},{"Id":11146,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"焦篱店醉题","Comments":[{"Content":"时看弄邵翁伯","Type":"Text","Index":5}]},"Clauses":[{"Content":"洛下渠头百卉新，"},{"Content":"满筵歌笑独伤春。"},{"Content":"何须更弄邵翁伯，","Comments":[{"Content":"一作却","Type":"Text","Index":5}]},{"Content":"即我此身如此人。"}]},{"Id":11147,"Allusions":[{"AllusionIndex":24,"AllusionKey":"阿连","SentenceIndex":1},{"AllusionIndex":2368,"AllusionKey":"傅说羹","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"新茶咏寄上西川相公二十三舅大夫二十舅"},"Clauses":[{"Content":"三献蓬莱始一尝，"},{"Content":"日调金鼎阅芳香。"},{"Content":"贮之玉合才半饼，"},{"Content":"寄与阿连题数行。","Comments":[{"Content":"一作谁","Type":"Text","Index":4},{"Content":"阿连","Type":"AllusionKey","Index":4}]}]},{"Id":11416,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"缉","Rank":0,"Title":{"Content":"渡浙江"},"Clauses":[{"Content":"前船后船未相及，"},{"Content":"五两头平北风急。"},{"Content":"飞沙卷地日色昏，"},{"Content":"一半征帆浪花湿。","Comments":[{"Content":"一作潮浪","Type":"Text","Index":6}]}]},{"Id":11157,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"赠别李纷"},"Clauses":[{"Content":"头白乘驴悬布囊，"},{"Content":"一回言别泪千行。"},{"Content":"儿孙满眼无归处，"},{"Content":"唯到尊前似故乡。"}]},{"Id":11137,"Allusions":[{"AllusionIndex":9653,"AllusionKey":"羊公灭吹鱼","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"送史寀滑州谒贾仆射"},"Clauses":[{"Content":"朱门洞启俨行车，"},{"Content":"金鐍装囊半是书。"},{"Content":"君向东州问徐胤，"},{"Content":"羊公何事灭吹鱼。"}]},{"Id":11151,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"裴给事宅白牡丹","Comments":[{"Content":"（一作裴潾诗）。（一作裴士淹诗）","Type":"Text","Index":7}]},"Clauses":[{"Content":"长安豪贵惜春残，"},{"Content":"争玩街西紫牡丹。","Comments":[{"Content":"一作赏新开","Type":"Text","Index":4}]},{"Content":"别有玉盘承露冷，"},{"Content":"无人起就月中看。"}],"Comments":[{"Book":"《北江诗话》","Content":"白牡丹诗，以唐韦端己“入门惟觉一庭香”及开元明公“别有玉盘承露冷，无人起向月中看”为最。","IsComment":false,"FullPath":"《北江诗话》"},{"Book":"《诗式》","Content":"做牡丹诗，若以富贵门面语铺排，毫不足观。植物中及菊花、梅花等题，实已难于出新。凡遇此等题，必须脱尽前人窠臼，自标新义，方合；否则，何贵此陈陈相因、人云亦云之作哉？牡丹上冠一“白”字，则尤宜贴切“白”字。然切“白”字处，若出以雕琢之笔，则又落小样，且绝无意趣，令人阅之生厌，又何贵此死句哉！惟切“白”字在不脱不粘之际，有一种神妙吐于毫端，斯足引阅者兴趣。袁氏简斋论做诗主性灵，诚然诚然。此首起承衬起，用笔甚活。二句三句切“白”字，借五盘形容之，绝不露斧凿之痕，而自然含有“白”字在内。且白牡丹在裴给事宅，亦须切主人身份，以“玉盘承露”等字点染，自切给事分际。如戎昱《红槿花诗》：“今日惊秋自怜客，折来持赠少年人”，又薛能《黄蜀葵诗》：“记得玉人春病起，道家装束厌禳时”，做“红”字、“黄”字均在有意无意之间，他题皆可隅反。[品]超诣。","IsComment":false,"FullPath":"《诗式》"},{"Book":"唐诗鉴赏辞典","Content":"在唐代，观赏牡丹成为富贵人家的一种习俗。据李肇《唐国史补》记载：“京城贵游尚牡丹三十余年矣，每春暮，车马若狂，以不耽玩为耻。”中唐诗人刘禹锡也有诗为证：“唯有牡丹真国色，花开时节动京城”（《赏牡丹》）。<br /><br />当时，牡丹价格十分昂贵，竟至“一本有直数万者”。（亦见《唐国史补》）牡丹中又以大红大紫为贵，白色牡丹不受重视。裴潾这首诗的前两句便形象而概括地写出了唐代的这种风习。<br /><br />“长安豪贵惜春残，争赏街西紫牡丹。”唐代京城长安有一条朱雀门大街横贯南北，将长安分为东西两半。街西属长安县，那里有许多私人名园。每到牡丹盛开季节，但见车水马龙，观者如堵，游人如云。选择“长安”、“街西”作为描写牡丹的背景，自然最为典型。作者描写牡丹花开时的盛景，只用“春残”二字点出季节，因为牡丹盛开恰在春暮。作者没有对紫牡丹的形象做任何点染，单从“豪贵”对她的态度着笔。豪贵们耽于逸乐，“无日不看花”，桃杏方尽，牡丹又开，正值暮春三月，为“惜春残”，更是对牡丹趋之若鹜。以争赏之众，衬花开之盛，“惜春残”一笔确实收到了比描写繁花似锦更好的艺术效果。<br /><br />以上使用侧面描写，着意渲染了紫牡丹的名贵。看似与题目无关，实则为后面展开对白牡丹的描写作了有力的铺垫。“别有玉盘承露冷，无人起就月中看。”一个“别”字，引出了迥然不同的另一番景象。玉盘，冷露，月白，风清，再加上寂静无人的空园，与上联描写的情景形成极其鲜明的对比。对白牡丹的形象刻划虽只是略加点染，但显然倾注了作者满心的爱悦和同情。“玉盘”，形容盛开的白牡丹，生动贴切。月夜的衬托和冷露的点缀，更增加了白牡丹形象的丰满。作者正是通过对紫牡丹和白牡丹这一动一静、一热一冷的对照描写，不加一句褒贬，不作任何说明，而寓意自显。为豪贵所争赏的紫牡丹尽管名贵却显得庸俗，相反，无人看的白牡丹却超尘脱俗，幽雅高尚，给人以冰清玉洁之感。诗人对白牡丹的赞美和对它处境的同情，寄托了对人生的感慨。末句“无人起就月中看”之“无人”，承上面豪贵而言，豪贵争赏紫牡丹，而“无人”看裴给事的白牡丹。即言裴给事之高洁，朝中竟无人赏识。诗题中特别点出“裴给事宅”，便是含蓄地点出这层意思。短短的一首七绝可谓含意丰富，旨趣遥深。可以说，在姹紫嫣红的牡丹诗群里，这首诗本身就是一朵姣美幽雅、盈盈带露的白牡丹花。<br /><br />（张明非）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]},{"Id":11136,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"送韦判官得雨中山"},"Clauses":[{"Content":"前峰后岭碧濛濛，"},{"Content":"草拥惊泉树带风。"},{"Content":"人语马嘶听不得，"},{"Content":"更堪长路在云中。"}]},{"Id":11093,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"文","Rank":0,"Title":{"Content":"山店","Comments":[{"Content":"一作王建诗","Type":"Text","Index":2}]},"Clauses":[{"Content":"登登山路行时尽，"},{"Content":"决决溪泉到处闻。"},{"Content":"风动叶声山犬吠，"},{"Content":"一家松火隔秋云。","Comments":[{"Content":"一作几","Type":"Text","Index":1}]}],"Comments":[{"Book":"《唐诗绝句类选》","Content":"杜牧《山行》：“白云深处有人家”句，与卢纶此句，结语意同，卢更胜（“一家松火”句下）。","IsComment":false,"FullPath":"《唐诗绝句类选》"},{"Book":"《唐诗选脉会通评林》","Content":"周珽曰：写山行之景，宛然画出。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《三体唐诗评》","Content":"何焯曰：发端是暮程倦客，亟望有店；“何时尽”，又直贯注“隔秋云”三字。第二句疑若路穷，妙能顿拌。第四句仍用“隔秋云”三字，欲透复缩。犬吠尚是因风远传，与下句“隔”字一线。","IsComment":false,"FullPath":"《三体唐诗评》"},{"Book":"《网师园唐诗笺》","Content":"画所不到（末二句下）。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"《唐人绝句精华》","Content":"寻常景色一入诗人之笔便不同。此诗无奇特之事物而有非画所能画出者，读之如身临其境，故是佳作。","IsComment":false,"FullPath":"《唐人绝句精华》"}]},{"Id":11098,"GroupIndex":4,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"天长久词","Comments":[{"Content":"三首。附《宫中乐》二首，一作《天长词》，一作《天长地久词》。","Type":"Text","Index":4}]},"Clauses":[{"Content":"台殿云深秋色微，","Comments":[{"Content":"一作凉","Type":"Text","Index":4},{"Content":"一作风日","Type":"Text","Index":6}]},{"Content":"君王初赐六宫衣。"},{"Content":"楼船泛罢归犹早，","Comments":[{"Content":"一作罢泛","Type":"Text","Index":4}]},{"Content":"行遣才人斗射飞。","Comments":[{"Content":"一作道","Type":"Text","Index":2}]}],"Comments":[{"Book":"《诗境浅说续编》","Content":"首二句言：云凉台殿，秋意初生，六宫已拜赐衣之宠。后二句言：液池晴涨，戏泛楼船，极中流箫鼓之娱；归时尚早，更遣才人，射飞逐走。盘游无度，不闻折槛之争，较“晋阳已陷休回顾，更请君王猎一围”，仅差胜一筹……此诗盖有夫谏之意也。","IsComment":false,"FullPath":"《诗境浅说续编》"}]}],"Count":337,"PageNo":12,"PageSize":20}