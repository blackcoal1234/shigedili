{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11217,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"泊扬子江岸"},"Clauses":[{"Content":"山映南徐暮，","Comments":[{"Content":"一作影","Type":"Text","Index":2}]},{"Content":"千帆入古津。","Comments":[{"Content":"一作吉","Type":"Text","Index":4}]},{"Content":"鱼惊出浦火，"},{"Content":"月照渡江人。"},{"Content":"清镜催双鬓，"},{"Content":"沧波寄一身。"},{"Content":"空怜莎草色，"},{"Content":"长接故园春。"}],"Comments":[{"Book":"《唐诗分类绳尺》","Content":"二诗（按指祖咏《泊杨子津》与本诗）景象敌手，而卢意觉胜。","IsComment":false,"FullPath":"《唐诗分类绳尺》"},{"Book":"《唐诗选脉会通评林》","Content":"周珽曰：写景寓意，不徒以声响成律者。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"}]},{"Id":11190,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"江行次武昌县"},"Clauses":[{"Content":"家寄五湖间，"},{"Content":"扁舟往复还。"},{"Content":"年年生白发，"},{"Content":"处处上青山。"},{"Content":"去国空知远，"},{"Content":"安身竟不闲。"},{"Content":"更悲江畔柳，"},{"Content":"长是北人攀。"}]},{"Id":11212,"Classes":["軍旅 要地"],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"夜泊金陵"},"Clauses":[{"Content":"圆月出高城，"},{"Content":"苍苍照水营。"},{"Content":"江中正吹笛，"},{"Content":"楼上又无更。"},{"Content":"洛下仍传箭，"},{"Content":"关西欲进兵。"},{"Content":"谁知五湖外，"},{"Content":"诸将但争名。","Comments":[{"Content":"一作将吏更","Type":"Text","Index":3}]}]},{"Id":11237,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"秋晚山中别业"},"Clauses":[{"Content":"树老野泉清，"},{"Content":"幽人好独行。"},{"Content":"去闲知路静，"},{"Content":"归晚喜山明。"},{"Content":"兰芰通荒井，"},{"Content":"牛羊出古城。"},{"Content":"茂陵秋最冷，","Comments":[{"Content":"一作晚","Type":"Text","Index":5}]},{"Content":"谁念一书生。"}]},{"Id":11177,"Allusions":[{"AllusionIndex":3361,"AllusionKey":"子真","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"关口逢徐迈"},"Clauses":[{"Content":"废寺连荒垒，"},{"Content":"那知见子真。","Comments":[{"Content":"子真","Type":"AllusionKey","Index":5}]},{"Content":"关城夜有雪，"},{"Content":"冰渡晓无人。"},{"Content":"酒里唯多病，","Comments":[{"Content":"一作移","Type":"Text","Index":4}]},{"Content":"山中愿作邻。"},{"Content":"常闻兄弟乐，"},{"Content":"谁肯信家贫。","Comments":[{"Content":"一作唯见谢","Type":"Text","Index":3}]}]},{"Id":11168,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"山中咏古木"},"Clauses":[{"Content":"高木已萧索，"},{"Content":"夜雨复秋风。"},{"Content":"坠叶鸣丛竹，","Comments":[{"Content":"一作荒","Type":"Text","Index":4}]},{"Content":"斜根拥断蓬。"},{"Content":"半侵山色里，","Comments":[{"Content":"一作影","Type":"Text","Index":4}]},{"Content":"长在水声中。"},{"Content":"此地何人到，"},{"Content":"云门去亦通。","Comments":[{"Content":"一作间路","Type":"Text","Index":3}]}]},{"Id":11252,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"送少微上人游蜀"},"Clauses":[{"Content":"瓶钵绕禅衣，"},{"Content":"连宵宿翠微。"},{"Content":"树开巴水远，"},{"Content":"山晓蜀星稀。"},{"Content":"识遍中朝贵，"},{"Content":"多谙外学非。"},{"Content":"何当一传付，"},{"Content":"道侣愿知归。"}]},{"Id":11259,"Allusions":[{"AllusionIndex":5025,"AllusionKey":"陶公","SentenceIndex":2},{"AllusionIndex":9277,"AllusionKey":"谢守","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"送宁国夏侯丞"},"Clauses":[{"Content":"楚国青芜上，"},{"Content":"秋云似白波。"},{"Content":"五湖长路少，"},{"Content":"九派乱山多。","Comments":[{"Content":"一作断","Type":"Text","Index":3}]},{"Content":"谢守通诗宴，","Comments":[{"Content":"谢守","Type":"AllusionKey","Index":2}]},{"Content":"陶公许醉过。","Comments":[{"Content":"陶公","Type":"AllusionKey","Index":2}]},{"Content":"怃然饯离阻，","Comments":[{"Content":"一作无钱","Type":"Text","Index":2}]},{"Content":"年鬓两蹉跎。"}]},{"Id":11287,"Allusions":[{"AllusionIndex":1501,"AllusionKey":"谏猎","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"送袁称"},"Clauses":[{"Content":"谏猎名空久，","Comments":[{"Content":"谏猎","Type":"AllusionKey","Index":2}]},{"Content":"多因病与贫。"},{"Content":"买书行几市，"},{"Content":"带雨别何人。"},{"Content":"客路山连水，"},{"Content":"军州日映尘。"},{"Content":"凄凉一分手，"},{"Content":"俱恨老相亲。"}]},{"Id":11326,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"罪所送苗员外上都","Comments":[{"Content":"一作非","Type":"Text","Index":1}]},"Clauses":[{"Content":"谋身当议罪，"},{"Content":"宁遣友朋闻。"},{"Content":"祸近防难及，"},{"Content":"愁长事未分。","Comments":[{"Content":"一作思","Type":"Text","Index":3}]},{"Content":"寂寥惊远语，"},{"Content":"幽闭望归云。"},{"Content":"亲戚如相见，"},{"Content":"唯应泣向君。"}]},{"Id":11271,"Allusions":[{"AllusionIndex":673,"AllusionKey":"笔耕","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"送李校书赴东川幕"},"Clauses":[{"Content":"泥坂望青城，"},{"Content":"浮云与栈平。"},{"Content":"字形知国号，"},{"Content":"眉势识山名。"},{"Content":"编简尘封阁，"},{"Content":"戈鋋雪照营。"},{"Content":"男儿须聘用，"},{"Content":"莫信笔堪耕。"}]},{"Id":11192,"Classes":["軍旅"],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"至德中赠内兄刘赞"},"Clauses":[{"Content":"时难访亲戚，"},{"Content":"相见喜还悲。"},{"Content":"好学年空在，"},{"Content":"从戎事已迟。"},{"Content":"听琴泉落处，"},{"Content":"步履雪深时。"},{"Content":"惆怅多边信，"},{"Content":"青山共有期。"}]},{"Id":11228,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"春日灞亭同苗员外寄皇甫侍御","Comments":[{"Content":"一作庾侍郎","Type":"Text","Index":13}]},"Clauses":[{"Content":"坐见春云暮，"},{"Content":"无因报所思。"},{"Content":"川平人去远，"},{"Content":"日暖雁飞迟。"},{"Content":"对酒山长在，"},{"Content":"看花鬓自衰。"},{"Content":"谁堪登灞岸，"},{"Content":"还作旧乡悲。","Comments":[{"Content":"一作异","Type":"Text","Index":3}]}]},{"Id":11301,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"青","Rank":0,"Title":{"Content":"送颜推官游银夏谒韩大夫"},"Clauses":[{"Content":"丛篁叫寒笛，","Comments":[{"Content":"一作杯","Type":"Text","Index":2}]},{"Content":"满眼塞山青。"},{"Content":"才子尊前画，"},{"Content":"将军石上铭。"},{"Content":"猎声云外响，"},{"Content":"战血雨中腥。"},{"Content":"苦乐从来事，"},{"Content":"因君一涕零。"}]},{"Id":11218,"Classes":["軍旅 送行","軍旅 赴任"],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"咸阳送房济侍御归太原幕","Comments":[{"Content":"昔尝与济同游此邑","Type":"Text","Index":11}]},"Clauses":[{"Content":"旧居无旧邻，"},{"Content":"似见故乡春。","Comments":[{"Content":"一作园","Type":"Text","Index":4}]},{"Content":"复对别离酒，"},{"Content":"欲成衰老人。"},{"Content":"客衣频染泪，"},{"Content":"军旅亦多尘。"},{"Content":"握手重相勉，"},{"Content":"平生心所因。"}]},{"Id":11263,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"送何召下第后归蜀"},"Clauses":[{"Content":"褒斜行客过，"},{"Content":"栈道响危空。"},{"Content":"路湿云初上，"},{"Content":"山明日正中。","Comments":[{"Content":"一作暄","Type":"Text","Index":2}]},{"Content":"水程通海货，"},{"Content":"地利杂吴风。"},{"Content":"一别金门远，"},{"Content":"何人复荐雄。"}]},{"Id":11286,"Allusions":[{"AllusionIndex":628,"AllusionKey":"北山文","SentenceIndex":3},{"AllusionIndex":10147,"AllusionKey":"禹穴","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"送耿拾遗湋充括图书使往江淮"},"Clauses":[{"Content":"传令收遗籍，"},{"Content":"诸儒喜饯君。"},{"Content":"孔家唯有地，"},{"Content":"禹穴但生云。","Comments":[{"Content":"禹穴","Type":"AllusionKey","Index":2}]},{"Content":"编简知还续，","Comments":[{"Content":"一作还知","Type":"Text","Index":4}]},{"Content":"虫鱼亦自分。"},{"Content":"如逢北山隐，"},{"Content":"一为谢移文。"}]},{"Id":11288,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"送郭判官赴振武"},"Clauses":[{"Content":"黄河九曲流，"},{"Content":"缭绕古边州。"},{"Content":"鸣雁飞初夜，"},{"Content":"羌胡正晚秋。"},{"Content":"凄凉金管思，","Comments":[{"Content":"一作清","Type":"Text","Index":2}]},{"Content":"迢遰玉人愁。"},{"Content":"七叶推多庆，","Comments":[{"Content":"一作虽","Type":"Text","Index":3}]},{"Content":"须怀杀敌忧。"}]},{"Id":11229,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"春江夕望"},"Clauses":[{"Content":"洞庭芳草遍，"},{"Content":"楚客莫思归。"},{"Content":"经难人空老，"},{"Content":"逢春雁自飞。"},{"Content":"东西兄弟远，"},{"Content":"存没友朋稀。"},{"Content":"独立还垂泪，"},{"Content":"天南一布衣。"}],"Comments":[{"Book":"《近体秋阳》","Content":"语甚凄而意甚傲，然傲一分却凄十分。一“还”字几使读者掩袂矣。","IsComment":false,"FullPath":"《近体秋阳》"}]},{"Id":11248,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"送元昱尉义兴"},"Clauses":[{"Content":"欲成云海别，"},{"Content":"一夜梦天涯。"},{"Content":"白浪缘江雨，"},{"Content":"青山绕县花。"},{"Content":"风标当剧部，"},{"Content":"冠带称儒家。"},{"Content":"去矣谢亲爱，"},{"Content":"知予发已华。"}]}],"Count":337,"PageNo":5,"PageSize":20}