{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":536044,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"青莲花"},"Clauses":[{"Content":"净土移根体性殊，"},{"Content":"笑他红白费工夫。"},{"Content":"幽姿羞损婵娟女，"},{"Content":"异色孤芳潋滟湖。"},{"Content":"顾影有情欺水荇，"},{"Content":"向人无语鄙风蒲。"},{"Content":"一枝摇动清香远，"},{"Content":"几许诗笺与画图。"}]},{"Id":96281,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"Title":{"Content":"九日"},"Clauses":[{"Content":"去年年月愁何限，"},{"Content":"重上心来益断肠。"},{"Content":"秋色夕阳俱淡薄，"},{"Content":"泪痕离思共凄凉。"},{"Content":"征鸿有阵全无信，"},{"Content":"黄菊无情却有香。"},{"Content":"自觉近来清瘦了，"},{"Content":"懒将鸾镜照容光。"}]},{"Id":96316,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"秋夜牵情三首"},"Clauses":[{"Content":"纤纤新月挂黄昏，"},{"Content":"人在幽闺欲断魂。"},{"Content":"笺素拆封还又改，"},{"Content":"酒杯慵举却重温。"},{"Content":"灯花占断烧心事，"},{"Content":"罗袖长供挹泪痕。"},{"Content":"益悔风流多不足，"},{"Content":"须知恩爱是愁根。"}]},{"Id":536074,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"堂下岩桂秋晚未开作诗促之"},"Clauses":[{"Content":"著意裁诗特地催，"},{"Content":"花须著意听新诗。"},{"Content":"清香未吐黄金粟，"},{"Content":"嫩蕊犹藏碧玉枝。"},{"Content":"不是地寒偏放晚，"},{"Content":"定知花好故开迟。"},{"Content":"也宜急趁无风雨，"},{"Content":"莫待霜高露结时。"}]},{"Id":536079,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"盐","Rank":0,"FirstClauseRhyme":"盐","Title":{"Content":"雪二首"},"Clauses":[{"Content":"一夜青山换玉尖，"},{"Content":"了无尘翳半痕兼。"},{"Content":"寒鸦打食围沙渚，"},{"Content":"冻雀藏身宿画檐。"},{"Content":"野外易寻东郭履，"},{"Content":"月中难认塞翁髯。"},{"Content":"梅花恣逞春情性，"},{"Content":"不管风姨号令严。"}]},{"Id":536080,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"盐","Rank":0,"FirstClauseRhyme":"盐","Title":{"Content":"雪二首"},"Clauses":[{"Content":"谁剪飞花六出尖，"},{"Content":"索娥肌肉莹相兼。","Comments":[{"Content":"原作饥，据元刻本改","Type":"Text","Index":3}]},{"Content":"分明幻玉迷青嶂，"},{"Content":"轻薄随风入画檐。"},{"Content":"冻笔想停诗客手，"},{"Content":"寒蓑宜拥钓翁髯。"},{"Content":"长安陋巷多贫士，"},{"Content":"可见鹑衣透胆严。"}]},{"Id":536081,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"雪晴"},"Clauses":[{"Content":"饥禽高噪日三竿，"},{"Content":"积雪回风堕指寒。"},{"Content":"秀色暗添梅富裕，"},{"Content":"绿梢明报竹平安。"},{"Content":"冷侵翠袖诗肩耸，","Comments":[{"Content":"原作吟，据元刻本改","Type":"Text","Index":1}]},{"Content":"春入红炉酒量宽。"},{"Content":"帘外有山千万叠，"},{"Content":"醉眸浑作怒涛看。"}]},{"Id":96318,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"除夜"},"Clauses":[{"Content":"穷冬欲去尚徘徊，"},{"Content":"独坐频斟守岁杯。"},{"Content":"一夜腊寒随漏尽，"},{"Content":"十分春色破朝来。","Comments":[{"Content":"原作被，据武林本改","Type":"Text","Index":5}]},{"Content":"桃符自写新翻句，"},{"Content":"玉律谁吹定等灰。"},{"Content":"且是作诗人未老，"},{"Content":"换年添岁莫相催。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》前集卷七，总题冬景","Type":"Text","Index":7}]}]},{"Id":96290,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"文","Title":{"Content":"灯花","Comments":[{"Content":"俗谓灯有财花，有客花，故成未句","Type":"Text","Index":2}]},"Clauses":[{"Content":"兰釭和气散氤氲，"},{"Content":"忽作元珠吐穗新。"},{"Content":"膏脉破芽非藉手，"},{"Content":"敷芳成艳不关春。"},{"Content":"疑猜海角天涯事，"},{"Content":"搅乱衾寒枕冷人。"},{"Content":"我欲生怜心燄上，"},{"Content":"何妨好客致清贫。"}]},{"Id":96287,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"盐","Rank":0,"FirstClauseRhyme":"盐","Title":{"Content":"伤别二首"},"Clauses":[{"Content":"览镜惊容却自嫌，"},{"Content":"逢春长尽病恹恹。","Comments":[{"Content":"武林本作是","Type":"Text","Index":4}]},{"Content":"吹花弄粉新来懒，"},{"Content":"惹恨供愁旧日添。"},{"Content":"生怕子规声到耳，"},{"Content":"苦羞双燕影穿帘。"},{"Content":"眉头眼底无他事，"},{"Content":"须信离情一味严。"}]},{"Id":536095,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"伤别二首"},"Clauses":[{"Content":"双燕呢喃语画梁，"},{"Content":"劝人休恁苦思量。"},{"Content":"逢春触处须萦恨，"},{"Content":"对景无时不断肠。"},{"Content":"寒食梨花新月夜，"},{"Content":"黄昏杨柳旧风光。"},{"Content":"繁华种种成愁恨，"},{"Content":"最是西楼近夕阳。"}]},{"Id":536096,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"诉愁"},"Clauses":[{"Content":"苦没心情只爱眠，"},{"Content":"梦魂还又到愁边。"},{"Content":"旧家庭院春长锁，"},{"Content":"今夜楼台月正圆。"},{"Content":"锦夜楼台双凤带，","Comments":[{"Content":"此句当有舛误，武林本作凤带□□云锦□，清抄本末空缺字作帐","Type":"Text","Index":7}]},{"Content":"兽炉闲爇水沉烟。"},{"Content":"良辰美景俱成恨，"},{"Content":"莫问新年与旧年。"}]},{"Id":96323,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"寄恨"},"Clauses":[{"Content":"如毛细雨蔼遥空，"},{"Content":"偏与花枝著意红。"},{"Content":"人自多愁春自好，"},{"Content":"天应不语闷应同。"},{"Content":"吟笺谩有千篇苦，"},{"Content":"心事全无一点通。"},{"Content":"窗外数声新百舌，"},{"Content":"唤回杨柳正眠中。"}]},{"Id":96324,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"得家嫂书"},"Clauses":[{"Content":"声声喜报鹊温柔，"},{"Content":"忽接芳缄自便邮。"},{"Content":"一尺溪藤摛锦带，"},{"Content":"数行香墨健银钩。"},{"Content":"倾心吐尽重重恨，"},{"Content":"入眼翻成字字愁。"},{"Content":"添得情怀无是处，"},{"Content":"非干病酒与悲秋。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》前集一○，总题杂题","Type":"Text","Index":7}]}]},{"Id":536111,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"侵","Rank":0,"Title":{"Content":"早春喜晴即事"},"Clauses":[{"Content":"山明雪尽翠岚深，"},{"Content":"天阔云开断翳阴。"},{"Content":"漠漠暖烟生草木，"},{"Content":"薰薰和气动园林。"},{"Content":"诗书遣兴消长日，"},{"Content":"景物牵情入苦吟。"},{"Content":"金鸭火残香阁静，"},{"Content":"更调商羽弄瑶琴。","Comments":[{"Content":"原作摇，据元刻本改","Type":"Text","Index":6}]}]},{"Id":96311,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"春晴"},"Clauses":[{"Content":"日暖风和明媚天，"},{"Content":"最宜吟咏入诗篇。"},{"Content":"庭花吐蕊红如锦，"},{"Content":"岸柳飞丝白似绵。"},{"Content":"深院雕梁巢燕返，"},{"Content":"高林乔木谷莺迁。"},{"Content":"韶光正近清明节，"},{"Content":"花坞楼台酒旆悬。"}]},{"Id":96307,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"春园小宴"},"Clauses":[{"Content":"春园得对赏芳菲，"},{"Content":"步草黏鞋絮点衣。"},{"Content":"万木初阴莺百转，"},{"Content":"千花乍拆蝶双飞。"},{"Content":"牵情自觉诗毫健，"},{"Content":"痛饮惟优酒力微。"},{"Content":"穷日追欢欢不足，"},{"Content":"恨无为计锁斜晖。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[乍拆]艺芸书舍本　刘履芬校辑钞本作[乍折] 。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96299,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"春日书怀"},"Clauses":[{"Content":"从宦东西不自由，"},{"Content":"亲帏千里泪长流。"},{"Content":"已无鸿雁传家信，"},{"Content":"更被杜鹃追客愁。"},{"Content":"日暖鸟歌空美景，"},{"Content":"花光柳影谩盈眸。"},{"Content":"高楼惆怅凭阑久，"},{"Content":"心逐白云南向浮。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[追] 《古今女史》作[送]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96301,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"春日杂兴"},"Clauses":[{"Content":"窈窕风光艳艳春，"},{"Content":"无言桃李一番新。"},{"Content":"青回野烧草初染，"},{"Content":"光泛幽香兰可纫。"},{"Content":"官柳欲眠多态度，"},{"Content":"海棠贪睡足精神。"},{"Content":"旧游似梦浑情懒，"},{"Content":"对景无聊愁杀人。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[题] 《名媛诗归》作[春] 。[艳艳]《名媛诗归》　《古今女史》作[绝艳]。[似梦浑]底本缺，据《武林》本补。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96285,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"冬日离咏"},"Clauses":[{"Content":"爱日温温正涤场，"},{"Content":"老农击壤庆时康。"},{"Content":"水催舂韵捣残雨，"},{"Content":"风急耞声带夕阳。"},{"Content":"霜瓦晓寒欺酒力，"},{"Content":"月栏夜冷动诗肠。"},{"Content":"厌厌对景无情绪，"},{"Content":"谩把梅花取次妆。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[枷声]铁琴　剑楼钞本作[笳声]。","IsComment":false,"FullPath":"朱淑真集"}]}],"Count":367,"PageNo":3,"PageSize":20}