{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":81020,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"秋日寄山中友人"},"Clauses":[{"Content":"昨夜听秋风，"},{"Content":"霜崖几树红。"},{"Content":"心随新雁去，"},{"Content":"宛至碧溪东。"},{"Content":"圣主搜渔钓，"},{"Content":"林岩今已空。"},{"Content":"胡为执高节，"},{"Content":"憔悴久山中。"}]},{"Id":81126,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"首夏二章呈诸邻"},"Clauses":[{"Content":"首夏木阴薄，"},{"Content":"清和自一时。"},{"Content":"笋抽八九尺，"},{"Content":"荷生三四枝。"},{"Content":"新服裁蝉翼，"},{"Content":"旧扇拂蛛丝。"},{"Content":"莎径热未剧，"},{"Content":"晨昏往来宜。"}]},{"Id":80990,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"青","Rank":0,"Title":{"Content":"南园杂诗六首 萤"},"Clauses":[{"Content":"林塘荒湿地，"},{"Content":"向夕已飞萤。"},{"Content":"月没蛩吟砌，"},{"Content":"露凉人在庭。"},{"Content":"随风疑落烬，"},{"Content":"过水乱疏星。"},{"Content":"学子灯前寝，"},{"Content":"谁将尔照经。"}]},{"Id":80989,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"齐","Rank":0,"Title":{"Content":"南园杂诗六首 莲房"},"Clauses":[{"Content":"莲房前后熟，"},{"Content":"供啖不须齐。"},{"Content":"肉嫩山蜂子，"},{"Content":"棱深天马蹄。"},{"Content":"尚连馀蕊在，"},{"Content":"深映乱荷低。"},{"Content":"脆美知新采，"},{"Content":"近根犹带泥。"}]},{"Id":80816,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"华清宫"},"Clauses":[{"Content":"新丰鸡犬稀，"},{"Content":"蓟北马秋肥。"},{"Content":"金殿翠华去，"},{"Content":"玉阶红叶飞。"},{"Content":"荒林上路废，"},{"Content":"温谷旧流微。"},{"Content":"嗟此非人事，"},{"Content":"何须问是非。"}]},{"Id":80985,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"虎牢关"},"Clauses":[{"Content":"天险限西东，"},{"Content":"难知造化功。"},{"Content":"路邀三晋会，"},{"Content":"势压两河雄。"},{"Content":"馀雪沾枯草，"},{"Content":"惊飙卷断蓬。"},{"Content":"徒观争战处，"},{"Content":"今古索然空。"}]},{"Id":80929,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"Title":{"Content":"和李殿丞仓中对菊"},"Clauses":[{"Content":"高士寄朝市，"},{"Content":"迥然心迹殊。"},{"Content":"秋风太仓里，"},{"Content":"黄菊满庭隅。"},{"Content":"陶令成诗后，"},{"Content":"王公送酒无。"},{"Content":"遥知厌俗事，"},{"Content":"未免强踌蹰。"}]},{"Id":80928,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"和李殿丞仓中对菊"},"Clauses":[{"Content":"文案渐消散，"},{"Content":"仓闲吏已稀。"},{"Content":"庭空数蝶下，"},{"Content":"夜静一萤飞。"},{"Content":"爱赏忽成句，"},{"Content":"淹留时忘归。"},{"Content":"高情虽不系，"},{"Content":"遇此独依依。"}]},{"Id":80927,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"和李殿丞仓中对菊"},"Clauses":[{"Content":"凉风正萧瑟，"},{"Content":"好月复徘徊。"},{"Content":"幽兴眇不尽，"},{"Content":"芳樽时一开。"},{"Content":"馀英盖红叶，"},{"Content":"坠露湿苍苔。"},{"Content":"从此东篱下，"},{"Content":"应忘归去来。"}]},{"Id":81067,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"Title":{"Content":"送何万下第归蜀"},"Clauses":[{"Content":"十上终无就，"},{"Content":"才高定复论。"},{"Content":"清时守儒术，"},{"Content":"白首在丘园。"},{"Content":"远树隐残日，"},{"Content":"孤烟生暮村。"},{"Content":"扬鞭万里去，"},{"Content":"几许不销魂。"}]},{"Id":81066,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"送何万下第归蜀"},"Clauses":[{"Content":"失意流年老，"},{"Content":"残春对夕阳。"},{"Content":"可堪临远道，"},{"Content":"更复举离觞。"},{"Content":"花柳已萧索，"},{"Content":"云山复渺茫。"},{"Content":"西风如有意，"},{"Content":"音信勿相忘。"}]},{"Id":81221,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"答陈进士谓之忆江东旧游见赠"},"Clauses":[{"Content":"客路今东去，"},{"Content":"亭皋木叶飞。"},{"Content":"居然不堪恨，"},{"Content":"况与赏心违。"},{"Content":"顾渚烟波阔，"},{"Content":"长洲草树微。"},{"Content":"江边好春色，"},{"Content":"行望锦标归。"}]},{"Id":81519,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"客思"},"Clauses":[{"Content":"客思倦漂泊，"},{"Content":"居然感物华。"},{"Content":"关头望红叶，"},{"Content":"马上见黄花。"},{"Content":"薄宦终无定，"},{"Content":"闲愁讵有涯。"},{"Content":"今朝书至否，"},{"Content":"几夕梦还家。"}]},{"Id":81021,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"秋日登观信亭"},"Clauses":[{"Content":"西风连夜雨，"},{"Content":"草树已萧条。"},{"Content":"宿霭稍零落，"},{"Content":"寒山更寂寥。"},{"Content":"林红犹带日，"},{"Content":"岸白欲生潮。"},{"Content":"新雁来何处，"},{"Content":"离离天际遥。"}]},{"Id":81218,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"湖上村家"},"Clauses":[{"Content":"万顷寒烟外，"},{"Content":"茅茨枕碧流。"},{"Content":"枫林巢乳鹤，"},{"Content":"沙溆乱鸣鸥。"},{"Content":"漠漠菰蒲晚，"},{"Content":"苍苍芦荻秋。"},{"Content":"欲过南浦去，"},{"Content":"篱下出渔舟。"}]},{"Id":80850,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"别聂之美"},"Clauses":[{"Content":"客宦常漂泊，"},{"Content":"离怀徒自劳。"},{"Content":"贫无衣换酒，"},{"Content":"空有涕沾袍。"},{"Content":"木叶寒犹在，"},{"Content":"江湖暮更豪。"},{"Content":"行舟远不见，"},{"Content":"赖有片帆高。"}]},{"Id":80770,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"双竹"},"Clauses":[{"Content":"双干标枯腹，"},{"Content":"青青凡几霜。"},{"Content":"龙腾双角直，"},{"Content":"鲸喷两须长。"},{"Content":"但欲寻支遁，"},{"Content":"安能问辟疆。"},{"Content":"屡来非别意，"},{"Content":"未与此君忘。"}]},{"Id":81133,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"旅宿睢阳南湖"},"Clauses":[{"Content":"梁王弃宫馆，"},{"Content":"时世古今违。"},{"Content":"犹有南湖水，"},{"Content":"春来雁鹜飞。"},{"Content":"楼台沈倒影，"},{"Content":"林薄挂馀晖。"},{"Content":"豪侈终何在，"},{"Content":"行人得暂依。"}]},{"Id":80993,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"Title":{"Content":"南湖"},"Clauses":[{"Content":"宋都南野水，"},{"Content":"花柳媚名园。"},{"Content":"鸟起沙留迹，"},{"Content":"鱼惊浪结痕。"},{"Content":"朱桥通别岛，"},{"Content":"白路出荒村。"},{"Content":"城邑虽云迩，"},{"Content":"常无车马喧。"}]},{"Id":80992,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"南湖"},"Clauses":[{"Content":"海雁长桥北，"},{"Content":"乘闲日日来。"},{"Content":"游鱼自应乐，"},{"Content":"宿鸟不相猜。"},{"Content":"弱柳周遭合，"},{"Content":"芳花次第开。"},{"Content":"梁王昔游集，"},{"Content":"后乘列邹枚。"}]}],"Count":1270,"PageNo":0,"PageSize":20}