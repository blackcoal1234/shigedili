{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80983,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"英宗皇帝挽歌辞三首"},"Clauses":[{"Content":"虹瑞流朱邸，"},{"Content":"童髦侍紫宸。"},{"Content":"简心天与子，"},{"Content":"授位帝知人。"},{"Content":"学古功时敏，"},{"Content":"钩深道日新。"},{"Content":"宜然三百载，"},{"Content":"民物仰威神。"}]},{"Id":80982,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"英宗皇帝挽歌辞三首"},"Clauses":[{"Content":"谏省臣无状，"},{"Content":"龙鳞昔屡婴。"},{"Content":"恩深忘位贱，"},{"Content":"义重觉生轻。"},{"Content":"不正诛锄法，"},{"Content":"仍蒙奖叹荣。"},{"Content":"百身何足报，"},{"Content":"天造固难名。"}]},{"Id":81120,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"送燕谏议知潭州"},"Clauses":[{"Content":"长沙地饶美，"},{"Content":"贾谊独伤悲。"},{"Content":"自古临荣辱，"},{"Content":"几人无怨咨。"},{"Content":"使君拥符节，"},{"Content":"大舰出江湄。"},{"Content":"意气陶然乐，"},{"Content":"应无吊屈辞。"}]},{"Id":81081,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"Title":{"Content":"送李益之侍郎致政归庐山","Comments":[{"Content":"十月七日。益之好谈禅，故效其语","Type":"Text","Index":11}]},"Clauses":[{"Content":"儒业金华贵，"},{"Content":"归心白鹤孤。"},{"Content":"江山依旧在，"},{"Content":"轩冕向来无。"},{"Content":"啸咏谁当共，"},{"Content":"登临未索扶。"},{"Content":"浩然知此乐，"},{"Content":"迥与世人殊。"}]},{"Id":81080,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"Title":{"Content":"送李益之侍郎致政归庐山","Comments":[{"Content":"十月七日。益之好谈禅，故效其语","Type":"Text","Index":11}]},"Clauses":[{"Content":"水底元无月，"},{"Content":"衣中自有珠。"},{"Content":"六尘皆外物，"},{"Content":"万法尽迷涂。"},{"Content":"瀑布寒云湿，"},{"Content":"觚棱瑞气扶。"},{"Content":"遥知至乐地，"},{"Content":"不异在京都。"}]},{"Id":80832,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"资善堂宴饯应诏"},"Clauses":[{"Content":"士论归清德，"},{"Content":"皇心重老成。"},{"Content":"陈谟侍经席，"},{"Content":"得谢解尘缨。"},{"Content":"坐密金章并，"},{"Content":"行徐玉醴清。"},{"Content":"都门昔供帐，"},{"Content":"疏傅未为荣。"}]},{"Id":81027,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"胡太傅挽歌二首","Comments":[{"Content":"宿，字武平","Type":"Text","Index":3}]},"Clauses":[{"Content":"行冠乡人品，"},{"Content":"文为学者师。"},{"Content":"黄裳蕴厚德，"},{"Content":"玉律俨清规。"},{"Content":"大节人难夺，"},{"Content":"嘉谟世莫知。"},{"Content":"仪型不可见，"},{"Content":"遗烈满丰碑。"}]},{"Id":81026,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"Title":{"Content":"胡太傅挽歌二首","Comments":[{"Content":"宿，字武平","Type":"Text","Index":3}]},"Clauses":[{"Content":"裴回游内禁，"},{"Content":"密勿赞鸿枢。"},{"Content":"阴德加民物，"},{"Content":"清名服士夫。"},{"Content":"天方遗一老，"},{"Content":"星忽陨三吴。"},{"Content":"疑从龙髯去，"},{"Content":"乘云在帝都。","Comments":[{"Content":"原作来，据陈本改","Type":"Text","Index":1},{"Content":"自注：英宗时方上仙。","Type":"Text","Index":5}]}]},{"Id":81110,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"送惠思归钱塘"},"Clauses":[{"Content":"孤岫平湖外，"},{"Content":"禅房老柏阴。"},{"Content":"倦游谙浊世，"},{"Content":"独往遂初心。"},{"Content":"夜雨灯窗迥，"},{"Content":"秋苔屐齿深。"},{"Content":"勿锄山径草，"},{"Content":"便有俗人寻。"}]},{"Id":81069,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"送吴仲庶知江宁"},"Clauses":[{"Content":"江南佳丽地，"},{"Content":"人物自风流。"},{"Content":"青骨灵祠在，"},{"Content":"黄旗王气收。"},{"Content":"衣冠馀旧俗，"},{"Content":"歌颂乐贤侯。"},{"Content":"正恐还朝速，"},{"Content":"江山未遍游。"}]},{"Id":80967,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"青","Rank":0,"Title":{"Content":"夜发长垣"},"Clauses":[{"Content":"长涂暑气剧，"},{"Content":"永日卧邮亭。"},{"Content":"画伏如墙鼠，"},{"Content":"宵行似野萤。"},{"Content":"歇鞍沙月白，"},{"Content":"拂面柳风醒。"},{"Content":"历历瞻云汉，"},{"Content":"谁为二使星。"}]},{"Id":81030,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"送丁正臣通判复州"},"Clauses":[{"Content":"得失固有命，"},{"Content":"世人空自劳。"},{"Content":"冬温少霜雪，"},{"Content":"松短没蓬蒿。"},{"Content":"孤宦千里远，"},{"Content":"荣名一旦高。"},{"Content":"回看碌碌者，"},{"Content":"太华与秋毫。"}]},{"Id":80844,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"致政王侍郎挽歌二首","Comments":[{"Content":"琪，字君玉","Type":"Text","Index":5}]},"Clauses":[{"Content":"弱冠献奇策，"},{"Content":"居然终贾才。"},{"Content":"赋成平乐馆，"},{"Content":"歌奉柏梁杯。","Comments":[{"Content":"自注：侍郎天圣初以江都主簿上书献十策，召试馆职，尝侍宴后苑，赋《山水石歌》，首出诸文士，独被褒赏。","Type":"Text","Index":5}]},{"Content":"丽藻留昭世，"},{"Content":"英游隔夜台。"},{"Content":"土中埋美玉，"},{"Content":"谁见不兴哀。"}]},{"Id":80843,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"Title":{"Content":"致政王侍郎挽歌二首","Comments":[{"Content":"琪，字君玉","Type":"Text","Index":5}]},"Clauses":[{"Content":"振鹭辞灵沼，"},{"Content":"冥鸿翔太虚。"},{"Content":"清朝解鸣玉，"},{"Content":"旧里挂安车。"},{"Content":"诗酒江山胜，"},{"Content":"园林俸禄馀。"},{"Content":"所忠今不往，"},{"Content":"谁奏茂陵书。"}]},{"Id":81206,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"景仁招游东园马上口占"},"Clauses":[{"Content":"适野自可爱，"},{"Content":"况逢佳主人。"},{"Content":"马穿官柳影，"},{"Content":"衣拂帝城尘。"},{"Content":"物外谁知乐，"},{"Content":"樽前别有春。"},{"Content":"年华己消歇，"},{"Content":"历历见松筠。"}]},{"Id":80875,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"依前韵奉送才元和甫使北"},"Clauses":[{"Content":"析木带天津，"},{"Content":"华星随去人。"},{"Content":"扬旌踰绝漠，"},{"Content":"负弩候前尘。"},{"Content":"出塞风霜苦，"},{"Content":"归涂杨柳春。"},{"Content":"会书专对美，"},{"Content":"烨烨满秋筠。"}]},{"Id":81128,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"哭刘仲原"},"Clauses":[{"Content":"天下才无几，"},{"Content":"夫君独患多。"},{"Content":"高文粲列宿，"},{"Content":"英辩泻长河。"},{"Content":"荣宦成朝梦，"},{"Content":"浮生度尺波。"},{"Content":"旧僚空执酒，"},{"Content":"相与泪滂沱。"}]},{"Id":81129,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"哭刘仲原"},"Clauses":[{"Content":"昔醉金明渚，"},{"Content":"今来慧辩祠。"},{"Content":"当年笑相视，"},{"Content":"此日哭殊悲。"},{"Content":"天迥川原净，"},{"Content":"风高草木衰。"},{"Content":"江梅灵气在，"},{"Content":"泉下复相知。"}]},{"Id":81056,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"送向防御知陈州","Comments":[{"Content":"经","Type":"Text","Index":4}]},"Clauses":[{"Content":"千骑去翩翩，"},{"Content":"专城上少年。"},{"Content":"韦平家好学，"},{"Content":"阴马世称贤。"},{"Content":"官用才能进，"},{"Content":"恩非雨露偏。"},{"Content":"想闻河润远，"},{"Content":"封畛帝畿连。"}]},{"Id":80831,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"早朝书事"},"Clauses":[{"Content":"太白明如李，","Comments":[{"Content":"原校：恐误。","Type":"Text","Index":5}]},{"Content":"东方三丈高。"},{"Content":"晨光孤照阙，"},{"Content":"雾气湿侵袍。"},{"Content":"槐柳经霜惨，"},{"Content":"骅骝得路豪。"},{"Content":"素餐无小补，"},{"Content":"俛仰愧金鳌。"}]}],"Count":1270,"PageNo":16,"PageSize":20}