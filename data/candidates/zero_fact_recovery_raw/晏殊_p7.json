{"Authors":{"Names":["晏殊"],"AuthorIds":[27290],"Dynasties":["Song"]},"ShiData":[{"Id":198019,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"Title":{"Content":"九月八日游涡","Comments":[{"Content":"徐通判、李谯县、杨察监丞、朱从道县尉同之","Type":"Text","Index":6}]},"Clauses":[{"Content":"黄花夹径疑无路，"},{"Content":"红叶临流巧胜春。"},{"Content":"前去重阳犹一日，"},{"Content":"不辞倾尽蚁醪醇。"}]},{"Id":198064,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"闰九月九日"},"Clauses":[{"Content":"闰秋重九再佳辰，"},{"Content":"犹见黄花裛露新。"},{"Content":"更作登高亦何害，"},{"Content":"恨无彭泽苦吟人。","Comments":[{"Content":"以上同上书卷三七","Type":"Text","Index":7}]}]},{"Id":198075,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"文","Rank":0,"Title":{"Content":"崇因寺"},"Clauses":[{"Content":"卷帘山色眼前见，"},{"Content":"入夜涛声枕上闻。"},{"Content":"苔径雨馀堆落叶，"},{"Content":"石楼风静锁寒云。","Comments":[{"Content":"清陈焯《宋元诗会》卷六引宋王象之《舆地纪胜》。按：《舆地纪胜》卷二六仅存前二句。","Type":"Text","Index":7}]}]},{"Id":198079,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"紫竹花","Comments":[{"Content":"一作杨巽斋诗","Type":"Text","Index":3}]},"Clauses":[{"Content":"长夏幽居景不穷，"},{"Content":"花开芳砌翠成丛。"},{"Content":"窗南高卧追凉际，"},{"Content":"时有微香逗晚风。","Comments":[{"Content":"清俞琰《咏物诗选》卷七","Type":"Text","Index":7}]}]},{"Id":198043,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"白云庵"},"Clauses":[{"Content":"草庵何似清风楼，"},{"Content":"更在空中最上头。"},{"Content":"眼界豁开无畛域，"},{"Content":"枯藤古木暮烟浮。","Comments":[{"Content":"清吕懋先同治《奉新县志》卷四","Type":"Text","Index":7}]}]},{"Id":198151,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"排律","TypeDetail":"WuPai","Rhyme":"支","Rank":0,"Title":{"Content":"丙寅中秋咏月"},"Clauses":[{"Content":"玉籥秋初半，"},{"Content":"冰轮岁有期。"},{"Content":"苦吟含翰久，"},{"Content":"清宴下楼迟。"},{"Content":"雁怯波光动，"},{"Content":"蛩愁叶影危。"},{"Content":"烘帘频卷押，"},{"Content":"温酎旋凝澌。"},{"Content":"皎外蟾生滴，"},{"Content":"寒中桂有枝。"},{"Content":"星文藏熠耀，"},{"Content":"露彩见华滋。"},{"Content":"苑静疏萤湿，"},{"Content":"巢空惊鹤移。"},{"Content":"渐穿鸣瑟幌，"},{"Content":"偏鉴读书帷。"},{"Content":"濛谷徒催晓，"},{"Content":"纤阿莫放亏。"},{"Content":"陈王收妙舞，"},{"Content":"疑待仲宣辞。"}]},{"Id":198152,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"排律","TypeDetail":"WuPai","Rhyme":"阳","Rank":0,"Title":{"Content":"次韵和司空相公闰秋重九中书对菊"},"Clauses":[{"Content":"两掖仪台峻，"},{"Content":"珍丛应序黄。"},{"Content":"积分回令节，"},{"Content":"伏槛赏幽芳。"},{"Content":"昧谷重延律，"},{"Content":"仙州剩借霜。"},{"Content":"冒寒知薏苦，"},{"Content":"逾分得荃香。"},{"Content":"汉幄群生遂，"},{"Content":"虞廷万事康。"},{"Content":"与人同所乐，"},{"Content":"留玩属澄觞。"}]},{"Id":198154,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"排律","TypeDetail":"WuPai","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"奉和圣制冬至"},"Clauses":[{"Content":"吉序冠三正，"},{"Content":"民时顺盛成。"},{"Content":"岁穰千亩实，"},{"Content":"气爽六符平。"},{"Content":"肆乐遵年律，"},{"Content":"迎长蔼颂声。"},{"Content":"云浓燕雁度，"},{"Content":"雪霁楚兰荣。"},{"Content":"异域梯航集，"},{"Content":"诸侯篚贡盈。"},{"Content":"尧仁敷万有，"},{"Content":"同此一阳生。","Comments":[{"Content":"以上同上书卷四○","Type":"Text","Index":5}]}]},{"Id":198156,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"排律","TypeDetail":"WuPai","Rhyme":"鱼","Rank":0,"Title":{"Content":"送瞿生还拜亲"},"Clauses":[{"Content":"门标杨氏阙，"},{"Content":"家有汉皇书。"},{"Content":"射策淹前志，"},{"Content":"鸣榔省旧居。"},{"Content":"仙山人罕到，"},{"Content":"幽境画难如。"},{"Content":"云窦开宾馆，"},{"Content":"芝田足岁储。"},{"Content":"修祠穷五际，"},{"Content":"为学慕三馀。"},{"Content":"努力文明代，"},{"Content":"翘翘托乘车。","Comments":[{"Content":"清邵子彝同治《建昌府志》卷九","Type":"Text","Index":5}]}]},{"Id":198155,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"排律","TypeDetail":"QiPai","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"奉和圣制新春"},"Clauses":[{"Content":"斗柄东回六合春，"},{"Content":"尧天历象与时新。"},{"Content":"铜壶瑞气延疏漏，"},{"Content":"青辂祥风绕画轮。"},{"Content":"云里楼台高郁郁，"},{"Content":"雨中原隰碧鳞鳞。"},{"Content":"千枝彩萼梅英吐，","Comments":[{"Content":"四库本作村粉","Type":"Text","Index":3}]},{"Content":"百尺金丝柳带匀。"},{"Content":"秉箓调元功有序，"},{"Content":"在璿观妙政惟醇。"},{"Content":"仰瞻魏阙宣和会，"},{"Content":"共识皇恩子万民。"}]},{"Id":198153,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"排律","TypeDetail":"QiPai","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"过华夫书屋"},"Clauses":[{"Content":"西斋辉赫亘山隅，"},{"Content":"嘉致清风世莫如。"},{"Content":"乡党名流依绛帐，"},{"Content":"烟萝幽境似仙居。"},{"Content":"趋庭子弟皆攀桂，"},{"Content":"弹铗宾朋总食鱼。"},{"Content":"汗简传经亚邹鲁，"},{"Content":"粉牌留咏尽严徐。"},{"Content":"杯盘互进先生馔，"},{"Content":"门巷应停长者车。"},{"Content":"坟籍岂惟精四部，"},{"Content":"弦歌常见习三馀。"},{"Content":"玳簪珠履延豪士，"},{"Content":"缥帙牙签刊赐书。"},{"Content":"碧沼暮凉浮菡萏，"},{"Content":"纱窗秋静漏蟾蜍。"},{"Content":"闲庭潇洒移泉石，"},{"Content":"华表峥嵘冠里闾。"},{"Content":"我恨羁游在芸阁，"},{"Content":"不陪诸彦曳长裾。","Comments":[{"Content":"清曾燠《江西诗徵》卷五","Type":"Text","Index":7}]}]},{"Id":198172,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"10","Rank":0,"Title":{"Content":"题太祖庙","Comments":[{"Content":"《挥麈后录》卷一作题阏伯庙","Type":"Text","Index":4}]},"Clauses":[{"Content":"炎宋肇英主，","Comments":[{"Content":"《挥麈后录》作祖","Type":"Text","Index":5}]},{"Content":"初九方潜鳞。"},{"Content":"尝因蓍蔡占，"},{"Content":"地决天地屯。"},{"Content":"庚庚大横兆，","Comments":[{"Content":"《挥麈后录》作契","Type":"Text","Index":2}]},{"Content":"謦咳如有闻。","Comments":[{"Content":"同上书后集卷一九引《蔡宽夫诗话》","Type":"Text","Index":5}]}]},{"Id":198160,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"12","Rank":0,"Title":{"Content":"列子有力命王充论衡有命禄极言必定之致览之有感"},"Clauses":[{"Content":"大钧播群物，"},{"Content":"零茂归自然。"},{"Content":"默定既有初，"},{"Content":"不为智力迁。"},{"Content":"籞寇导其流，"},{"Content":"仲任派其源。"},{"Content":"智愚信自我，"},{"Content":"通塞当由天。"},{"Content":"宰世曰皋伊，"},{"Content":"迷邦有颜原。"},{"Content":"吾道诚一概，"},{"Content":"彼途钟百端。"},{"Content":"卷之入纤毫，"},{"Content":"舒之盈八埏。"},{"Content":"进退得其宜，"},{"Content":"夸荣非所先。"},{"Content":"朝闻可夕陨，"},{"Content":"吾奉圣师言。"}]},{"Id":198165,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"5","Rank":0,"Title":{"Content":"和王校勘中夏东园"},"Clauses":[{"Content":"东园何所乐，"},{"Content":"所乐非尘事。","Comments":[{"Content":"《元献遗文》作亦多","Type":"Text","Index":4}]},{"Content":"野竹乱无行，"},{"Content":"幽花晚多思。"},{"Content":"闲窥鱼尾赤，","Comments":[{"Content":"《元献遗文》作看鱼尾漪","Type":"Text","Index":5}]},{"Content":"暗辨蜂腰细。"},{"Content":"树影密遮林，"},{"Content":"藤梢狂罥袂。"},{"Content":"潘蔬足登膳，"},{"Content":"陶秫径取醉。"},{"Content":"幸获我汝交，"},{"Content":"都忘今昔世。","Comments":[{"Content":"《元献遗文》作可","Type":"Text","Index":1}]},{"Content":"欢言捧瑶佩，"},{"Content":"愿以疏麻继。","Comments":[{"Content":"以上宋吕祖谦《宋文鉴》卷一五","Type":"Text","Index":5}]}]},{"Id":198070,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"支","Rank":0,"Title":{"Content":"金灯花"},"Clauses":[{"Content":"煌煌五枝灯，"},{"Content":"下有玉蟠螭。"},{"Content":"汉宫已荆棘，"},{"Content":"此地生何为。"},{"Content":"既无膏火用，"},{"Content":"虚名徒自欺。"}]},{"Id":494275,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"微","Rank":0,"Title":{"Content":"社日"},"Clauses":[{"Content":"山郡多暇日，"},{"Content":"社时放吏归。"},{"Content":"坐阁独成闷，"},{"Content":"行塘阅清辉。"},{"Content":"春风动高柳，"},{"Content":"芳园掩夕扉。"},{"Content":"遥思里中会，"},{"Content":"心绪怅微微。","Comments":[{"Content":"以上同上书卷一○","Type":"Text","Index":5}]}]},{"Id":198170,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"寒食东城作"},"Clauses":[{"Content":"王城五百车马繁，","Comments":[{"Content":"四库本作百五","Type":"Text","Index":4}]},{"Content":"重帷黕幕纷郊原。"},{"Content":"游人得意惜光景，"},{"Content":"恣寻复树登高轩。"},{"Content":"平芜远水知何许，"},{"Content":"眼入迢迢空处所。","Comments":[{"Content":"补编作里","Type":"Text","Index":2}]},{"Content":"梨花澹艳柳丝长，"},{"Content":"百计撩春作烟雨。"},{"Content":"歌哭声中半落晖，"},{"Content":"雕鞍绣毂尚迟归。"},{"Content":"荒田野草人间事，"},{"Content":"谁向伶玄泪满衣。","Comments":[{"Content":"补编作邻家","Type":"Text","Index":4}]}]},{"Id":198161,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"质","Rank":0,"Title":{"Content":"次韵和致仕陈相公除夜"},"Clauses":[{"Content":"从来岁除咏，"},{"Content":"托讽情非一。"},{"Content":"公在维师年，"},{"Content":"久谐归政逸。"},{"Content":"辛盘具芳郁，"},{"Content":"柏酒澄嘉栗。"},{"Content":"犹厌贺车烦，"},{"Content":"晨门效圭筚。","Comments":[{"Content":"四库本作勤","Type":"Text","Index":3},{"Content":"以上同上书卷四二","Type":"Text","Index":5}]}]},{"Id":198169,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"23","Rank":0,"Title":{"Content":"巢父井"},"Clauses":[{"Content":"禀生值尧年，"},{"Content":"率性在庞厚。"},{"Content":"安巢一枝上，"},{"Content":"岂曰鹑居陋。"},{"Content":"颍波人洗耳，"},{"Content":"曾不污牛口。"},{"Content":"谅兹耕耒暇，"},{"Content":"凿饮隈林薮。","Comments":[{"Content":"补编作井","Type":"Text","Index":2}]},{"Content":"含饴鼓其腹，"},{"Content":"帝力予何有。"},{"Content":"遂令千载外，"},{"Content":"此地存遗甃。"},{"Content":"泓然逼乔木，"},{"Content":"宛若栖嵵旧。"},{"Content":"乡人揭题榜，"},{"Content":"行旅谐瞻觏。"},{"Content":"我来观古迹，"},{"Content":"愕立徘徊久。"},{"Content":"凄其望清风，"},{"Content":"不获见师友。"},{"Content":"愿言㪺一勺，","Comments":[{"Content":"补编作斟复酌","Type":"Text","Index":5}]},{"Content":"拭面洗心垢。"},{"Content":"翘勤慕高躅，"},{"Content":"感慨陈卮酒。"},{"Content":"思齐胡可望，"},{"Content":"庶以宽容瞀。"},{"Content":"夙驾恨长途，"},{"Content":"凭高重回首。","Comments":[{"Content":"明王雄正德《汝州志》卷七","Type":"Text","Index":5}]}]},{"Id":198283,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"5","Rank":0,"Title":{"Content":"谒金门"},"TuneId":{"Id":113},"Clauses":[{"Content":"秋露坠。"},{"Content":"滴尽楚兰红泪。"},{"Content":"往事旧欢何限意。"},{"Content":"思量如梦寐。","BreakAfter":"1"},{"Content":"人貌老于前岁。"},{"Content":"风月宛然无异。"},{"Content":"座有嘉宾尊有桂。"},{"Content":"莫辞终夕醉。"}]}],"Count":360,"PageNo":7,"PageSize":20}