{"Authors":{"Names":["李益"],"AuthorIds":[15274],"Dynasties":["Tang"]},"ShiData":[{"Id":28305,"Allusions":[{"AllusionIndex":7135,"AllusionKey":"丘陵","SentenceIndex":3},{"AllusionIndex":7410,"AllusionKey":"三鸟","SentenceIndex":0}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"长社窦明府宅夜送王屋道士常究子"},"Clauses":[{"Content":"旦随三鸟去，","Comments":[{"Content":"三鸟","Type":"AllusionKey","Index":4}]},{"Content":"羽节凌霞光。"},{"Content":"暮与双凫宿，"},{"Content":"云车下紫阳。"},{"Content":"天坛临月近，"},{"Content":"洞水出山长。"},{"Content":"海峤年年别，"},{"Content":"丘陵徒自伤。","Comments":[{"Content":"丘陵","Type":"AllusionKey","Index":2}]}]},{"Id":28331,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"罢镜"},"Clauses":[{"Content":"手中青铜镜，"},{"Content":"照我少年时。"},{"Content":"衰飒一如此，"},{"Content":"清光难复持。"},{"Content":"欲令孤月掩，"},{"Content":"从遣半心疑。"},{"Content":"纵使逢人见，"},{"Content":"犹胜自见悲。"}]},{"Id":28337,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"赋得垣衣","Comments":[{"Content":"一作李得诗","Type":"Text","Index":4}]},"Clauses":[{"Content":"漠漠复霏霏，"},{"Content":"为君垣上衣。"},{"Content":"昭阳辇下草，"},{"Content":"应笑此生非。"},{"Content":"掩蔼青春去，","Comments":[{"Content":"一作奄霭，一作庵薆","Type":"Text","Index":2},{"Content":"一作暮","Type":"Text","Index":5}]},{"Content":"苍茫白露稀。","Comments":[{"Content":"一作晞","Type":"Text","Index":5}]},{"Content":"犹胜萍逐水，"},{"Content":"流浪不相依。"}]},{"Id":28321,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"送人流贬"},"Clauses":[{"Content":"汉章虽约法，"},{"Content":"秦律已除名。"},{"Content":"谤远人多惑，"},{"Content":"官微不自明。"},{"Content":"霜风先独树，"},{"Content":"瘴雨失荒城。"},{"Content":"畴昔长沙事，"},{"Content":"三年召贾生。"}]},{"Id":28320,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"送人南归"},"Clauses":[{"Content":"人言下江疾，"},{"Content":"君道下江迟。"},{"Content":"五月江路恶，"},{"Content":"南风惊浪时。"},{"Content":"应知近家喜，"},{"Content":"还有异乡悲。"},{"Content":"无奈孤舟夕，"},{"Content":"山歌闻竹枝。"}]},{"Id":28304,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"水亭夜坐赋得晓雾"},"Clauses":[{"Content":"月落寒雾起，"},{"Content":"沈思浩通川。"},{"Content":"宿禽啭木散，"},{"Content":"山泽一苍然。"},{"Content":"漠漠沙上路，","Comments":[{"Content":"一作鹭","Type":"Text","Index":5}]},{"Content":"沄沄洲外田。"},{"Content":"犹当依远树，"},{"Content":"断续欲穷天。"}]},{"Id":28326,"Classes":["軍旅 送行"],"Allusions":[{"AllusionIndex":6744,"AllusionKey":"蒲泥","SentenceIndex":2}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"齐","Rank":0,"Title":{"Content":"送常曾侍御使西蕃寄题西川"},"Clauses":[{"Content":"凉王宫殿尽，"},{"Content":"芜没陇云西。"},{"Content":"今日闻君使，"},{"Content":"雄心逐鼓鼙。"},{"Content":"行当收汉垒，"},{"Content":"直可取蒲泥。","Comments":[{"Content":"蒲泥","Type":"AllusionKey","Index":5}]},{"Content":"旧国无由到，"},{"Content":"烦君下马题。","Comments":[{"Content":"一作走","Type":"Text","Index":3}]}]},{"Id":28302,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"入南山至全师兰若"},"Clauses":[{"Content":"木陨水归壑，","Comments":[{"Content":"一作落","Type":"Text","Index":2}]},{"Content":"寂然无念心。","Comments":[{"Content":"一作始","Type":"Text","Index":4}]},{"Content":"南行有真子，"},{"Content":"被褐息山阴。"},{"Content":"石路瑶草散，"},{"Content":"松门寒景深。"},{"Content":"吾师亦何爱，","Comments":[{"Content":"一作授","Type":"Text","Index":5}]},{"Content":"自起定中吟。"}]},{"Id":28327,"Classes":["軍旅 將軍","軍旅 送行"],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"送韩将军还边"},"Clauses":[{"Content":"白马羽林儿，"},{"Content":"扬鞭薄暮时。"},{"Content":"独将轻骑出，"},{"Content":"暗与伏兵期。"},{"Content":"雨雪移军远，"},{"Content":"旌旗上垄迟。"},{"Content":"圣心戎寄重，"},{"Content":"未许让恩私。"}]},{"Id":28332,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"晚春卧病喜振上人见访"},"Clauses":[{"Content":"卧床如旧日，","Comments":[{"Content":"一作殊","Type":"Text","Index":3}]},{"Content":"窥户易伤春。"},{"Content":"灵寿扶衰力，"},{"Content":"芭蕉对病身。"},{"Content":"道心空寂寞，"},{"Content":"时物自芳新。"},{"Content":"旦夕谁相访，"},{"Content":"唯当摄上人。","Comments":[{"Content":"一作揖","Type":"Text","Index":3}]}]},{"Id":28317,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"春行"},"Clauses":[{"Content":"侍臣朝谒罢，"},{"Content":"戚里自相过。"},{"Content":"落日青丝骑，"},{"Content":"春风白纻歌。"},{"Content":"恩承三殿近，"},{"Content":"猎向五陵多。"},{"Content":"归路南桥望，"},{"Content":"垂杨拂细波。"}]},{"Id":28318,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"洛阳河亭奉酬留守群公追送","Comments":[{"Content":"一作李逸诗","Type":"Text","Index":12}]},"Clauses":[{"Content":"离亭饯落晖，"},{"Content":"腊酒减春衣。","Comments":[{"Content":"一作征","Type":"Text","Index":4}]},{"Content":"岁晚烟霞重，"},{"Content":"川寒云树微。"},{"Content":"戎装千里至，"},{"Content":"旧路十年归。"},{"Content":"还似汀洲雁，"},{"Content":"相逢又背飞。"}]},{"Id":28309,"Allusions":[{"AllusionIndex":733,"AllusionKey":"桃源","SentenceIndex":3}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"寻纪道士偶会诸叟"},"Clauses":[{"Content":"山阴寻道士，","Comments":[{"Content":"一作逢","Type":"Text","Index":3}]},{"Content":"映竹羽衣新。"},{"Content":"侍坐双童子，"},{"Content":"陪游五老人。"},{"Content":"水花松下静，"},{"Content":"坛草雪中春。"},{"Content":"见说桃源洞，","Comments":[{"Content":"桃源","Type":"AllusionKey","Index":4}]},{"Content":"如今犹避秦。"}]},{"Id":28308,"Allusions":[{"AllusionIndex":7616,"AllusionKey":"少君","SentenceIndex":0}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"同萧鍊师宿太乙庙"},"Clauses":[{"Content":"微月空山曙，"},{"Content":"春祠谒少君。","Comments":[{"Content":"少君","Type":"AllusionKey","Index":5}]},{"Content":"落花坛上拂，","Comments":[{"Content":"一作扫","Type":"Text","Index":5}]},{"Content":"流水洞中闻。"},{"Content":"酒引芝童奠，"},{"Content":"香馀桂子焚。","Comments":[{"Content":"一作女","Type":"Text","Index":4}]},{"Content":"鹤飞将羽节，"},{"Content":"遥向赤城分。"}]},{"Id":28322,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"送同落第者东归"},"Clauses":[{"Content":"东门有行客，"},{"Content":"落日满前山。"},{"Content":"圣代谁知者，"},{"Content":"沧洲今独还。"},{"Content":"片云归海暮，"},{"Content":"流水背城闲。"},{"Content":"余亦依嵩颍，","Comments":[{"Content":"一作岭","Type":"Text","Index":5}]},{"Content":"松花深闭关。"}]},{"Id":28324,"Classes":["軍旅 送行","軍旅 邊關"],"Allusions":[{"AllusionIndex":3282,"AllusionKey":"仪形当汉阁","SentenceIndex":3},{"AllusionIndex":4379,"AllusionKey":"嫖姚","SentenceIndex":3}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"送柳判官赴振武"},"Clauses":[{"Content":"边庭汉仪重，"},{"Content":"旌甲似云中。","Comments":[{"Content":"一作事","Type":"Text","Index":3}]},{"Content":"虏地山川壮，"},{"Content":"单于鼓角雄。"},{"Content":"关寒塞榆落，"},{"Content":"月白胡天风。"},{"Content":"君逐嫖姚将，","Comments":[{"Content":"嫖姚","Type":"AllusionKey","Index":4}]},{"Content":"麒麟有战功。"}]},{"Id":28315,"Allusions":[{"AllusionIndex":91,"AllusionKey":"谢公","SentenceIndex":3}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"述怀寄衡州令狐相公"},"Clauses":[{"Content":"调元方翼圣，"},{"Content":"轩盖忽言东。"},{"Content":"道以中枢密，"},{"Content":"心将外理同。"},{"Content":"白头生远浪，"},{"Content":"丹叶下高枫。"},{"Content":"江上萧疏雨，"},{"Content":"何人对谢公。","Comments":[{"Content":"谢公","Type":"AllusionKey","Index":5}]}]},{"Id":28333,"Allusions":[{"AllusionIndex":81,"AllusionKey":"安僻陋","SentenceIndex":3},{"AllusionIndex":726,"AllusionKey":"开三径","SentenceIndex":0}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"喜入兰陵望紫阁峰呈宣上人"},"Clauses":[{"Content":"薙草开三径，","Comments":[{"Content":"开三径","Type":"AllusionKey","Index":5}]},{"Content":"巢林喜一枝。"},{"Content":"地宽留种竹，"},{"Content":"泉浅欲开池。"},{"Content":"紫阁当疏牖，"},{"Content":"青松入坏篱。"},{"Content":"从今安僻陋，","Comments":[{"Content":"安僻陋","Type":"AllusionKey","Index":5}]},{"Content":"萧相是吾师。"}]},{"Id":28334,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"冬","Rank":0,"Title":{"Content":"喜见外弟又言别"},"Clauses":[{"Content":"十年离乱后，","Comments":[{"Content":"一作乱离","Type":"Text","Index":4}]},{"Content":"长大一相逢。"},{"Content":"问姓惊初见，"},{"Content":"称名忆旧容。"},{"Content":"别来沧海事，"},{"Content":"语罢暮天钟。"},{"Content":"明日巴陵道，"},{"Content":"秋山又几重。"}],"Comments":[{"Book":"《对床夜语》","Content":"“马上相逢久，人中欲认难”，“问姓惊初见，称名忆旧容”，“乍见翻疑梦，相悲各问年”；皆诗人会故人诗也。久别倏逢之意，宛然在目，想而味之，情融神会，殆如直述。前辈谓唐人行旅聚散之作，最能感动人意，信非虚语。","IsComment":false,"FullPath":"《对床夜语》"},{"Book":"《诗镜总论》","Content":"盛唐人工于缀景，惟杜子美长于言情。人情向外，见物易时自见难也。司空曙“乍见翻疑梦，想悲各问年”，李益“问姓惊初见，称名识旧容”，抚衷述怀，罄快极矣。因之思《三百篇》，情绪如丝，绎之不尽，汉人曾道只字不得。","IsComment":false,"FullPath":"《诗镜总论》"},{"Book":"《载酒园诗话又编》","Content":"司空文明每作得一联好语，辄力人压占。如“乍见翻疑梦，相悲各问年”，可谓情至之语；李益曰：“问姓惊初见，称名忆旧容”，则情尤深，语尤怆，读之几于泪不能收。","IsComment":false,"FullPath":"《载酒园诗话又编》"},{"Book":"《唐诗别裁》","Content":"一气旋折，中唐诗中仅见者。","IsComment":false,"FullPath":"《唐诗别裁》"},{"Book":"《网师园唐诗笺》","Content":"形容刻至（“问姓”二句下）。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"唐诗鉴赏辞典","Content":"这首诗艺术地再现了诗人同表弟（外弟）久别重逢又匆匆话别的情景。在以人生聚散为题材的小诗中，它历来引人注目。<br /><br />“十年离乱后，长大一相逢”，开门见山，介绍二人相逢的背景。这里有三层意思：一是指出离别已有十年之久。二是说明这是社会动乱中的离别。它使人想起，发生于李益八岁到十六岁时的安史之乱及其后的藩镇混战、外族入侵等战乱。三是说二人分手于幼年，“长大”才会面，这意味着双方的容貌已有极大变化。他们长期音信阻隔，存亡未卜，突然相逢，颇出意外。句中“一”字，表现出这次重逢的戏剧性。<br /><br />颔联“问姓惊初见，称名忆旧容”，正面描写重逢。他们的重逢，同司空曙所描写的“乍见翻疑梦，相悲各问年”中的情景显然不同。互相记忆犹新才可能“疑梦”，而李益和表弟却已经对面不能相认了。看来，他们是邂逅相遇。诗人抓住“初见”的一瞬间，作了生动的描绘。面对陌生人，诗人客气地询问：“贵姓？”，不由暗自惊讶。对一个似未谋面者的身份和来意感到惊讶。<br /><br />下句“称名”和“忆旧容”的主语，都是作者。经过初步接谈，诗人恍然大悟，面前的“陌生人”原来就是十年前还在一起嬉戏的表弟。诗人一边激动地称呼表弟的名字，一边端祥对方的容貌，努力搜索记忆中关于表弟的印象。想来，他当时还曾说：你比从前……。<br /><br />诗人从生活出发，抓住了典型的细节，从“问”到“称”，从“惊”到“忆”，层次清晰地写出了由初见不识到接谈相认的神情变化，绘声绘色，细腻传神。而至亲重逢的深挚情谊，也自然地从描述中流露出来，不需外加抒情的笔墨，已经为读者所领略了。<br /><br />十年阔别，一朝相遇，该有多少话语要说！颈联“别来沧海事，语罢暮天钟”，表现了这倾诉别情的场面。分手以来千头万绪的往事，诗人用“沧海事”一语加以概括。这里化用了沧海桑田的典故，突出了十年间个人、亲友、社会的种种变化，同时也透露了作者对社会动乱的无限感慨。<br /><br />两人热烈地交谈，从白天到日暮才停下话音。叙谈时间长，正表明他们情谊的深长。“暮天钟”并不是单纯作为日暮的标志而出现的。它表明二人叙谈得十分入神，以至顾不上观望天色的变化，也感觉不到时间的流逝，只有远处传来寺院的钟声，才使他们意识到原来已是黄昏。作者在这一联，避实就虚，择取了叙旧时间很长这个侧面，表现出二人欢聚时的热烈气氛和激动心情。<br /><br />前六句，从久别，到重逢，到叙旧，写“喜见”，突出了一个“喜”字；七、八句转入“言别”。作者没有使用“离别”的字样，而是想象出一幅表弟登程远去的画图：“明日巴陵道，秋山又几重”。“明日”，点出聚散匆匆。“巴陵道”，即通往巴陵郡（今湖南岳阳）的道路，这里提示了表弟即将远行的去向。“秋山又几重”则是通过重山阻隔的场景，把新的别离，形象地展现在读者面前。用“秋”形容“山”，于点明时令的同时，又隐蕴着作者伤别的情怀。不是从宋玉开始，就把秋天同悲伤联系在一起了么？“几重”而冠以“又”字，同首句的“十年离乱”相呼应，使后会难期的惆怅心情，溢于言表。<br /><br />这首诗不以奇特警俗取胜，而以朴素自然见长。诗中的情景和细节，似曾人人经历过的，这就使人们读起来，感觉十分亲切。诗用凝炼的语言，白描的手法，生动的细节，典型的场景，层次分明地再现了社会动乱中人生聚散的独特一幕，委婉蕴藉地抒发了真挚的至亲情谊和深重的动乱之感。<br /><br />（范之麟）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]},{"Id":28306,"Classes":["軍旅 營地"],"Allusions":[{"AllusionIndex":441,"AllusionKey":"捐扇","SentenceIndex":2},{"AllusionIndex":1414,"AllusionKey":"阳台","SentenceIndex":3},{"AllusionIndex":5913,"AllusionKey":"龙山","SentenceIndex":1}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"立春日宁州行营因赋朔风吹飞雪"},"Clauses":[{"Content":"边声日夜合，"},{"Content":"朔风惊复来。"},{"Content":"龙山不可望，","Comments":[{"Content":"龙山","Type":"AllusionKey","Index":2}]},{"Content":"千里一裴回。"},{"Content":"捐扇破谁执，","Comments":[{"Content":"捐扇","Type":"AllusionKey","Index":2}]},{"Content":"素纨轻欲裁。"},{"Content":"非时妒桃李，"},{"Content":"自是舞阳台。","Comments":[{"Content":"阳台","Type":"AllusionKey","Index":5}]}]}],"Count":169,"PageNo":0,"PageSize":20}