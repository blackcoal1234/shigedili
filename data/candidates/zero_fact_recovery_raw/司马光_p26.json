{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":81331,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"从始平公城西大阅"},"Clauses":[{"Content":"沧溟浴日照春台，"},{"Content":"组练光中玉帐开。"},{"Content":"汾水腾凌金鼓震，"},{"Content":"西山宛转旆旌回。"},{"Content":"逍遥静散晴空雨，"},{"Content":"叱咤横飞迥野雷。"},{"Content":"坐镇四夷真汉相，"},{"Content":"武侯空复道英才。"}]},{"Id":81154,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"陪诸君北园乐饮"},"Clauses":[{"Content":"浩歌纵饮任天机，"},{"Content":"莫使欢娱与性违。"},{"Content":"玉枕醉人从独卧，"},{"Content":"金羁倦客听先归。"},{"Content":"须知会府闲时少，"},{"Content":"况复边城乐事稀。"},{"Content":"花卉正浓风日好，"},{"Content":"今年已不负春晖。"}]},{"Id":81177,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"Title":{"Content":"晨发故关寄逢吉"},"Clauses":[{"Content":"画戟衣中趋绛帐，"},{"Content":"驿亭门外拂征鞍。"},{"Content":"已嗟漂泊三年别，"},{"Content":"更负从容十日欢。"},{"Content":"暖席未穷谈笑乐，"},{"Content":"陟冈相望滞留难。"},{"Content":"扬鞭策马几多意，"},{"Content":"原上秋风作晓寒。"}]},{"Id":80759,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"中秋夕始平公命与考校诸君置酒赋诗"},"Clauses":[{"Content":"月华秋色雨鲜新，"},{"Content":"万里澄空不受尘。"},{"Content":"兔濯素毛腾浩露，"},{"Content":"桂飘香实下飞轮。"},{"Content":"光侵酒面寒无力，"},{"Content":"清入诗豪健有神。"},{"Content":"坐客何须辞醉倒，"},{"Content":"相君应不惜车茵。"}]},{"Id":80926,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"和李八丈小雪同会有怀邻几"},"Clauses":[{"Content":"天禄淹回德齿尊，"},{"Content":"暂留汾曲两朱轓。"},{"Content":"闲轩坐啸正飞雪，"},{"Content":"同舍倦游来及门。"},{"Content":"空叹高歌如郢客，"},{"Content":"愧无佳赋似文园。"},{"Content":"坐中犹欠邻几在，"},{"Content":"深负棋枰与酒樽。"}]},{"Id":80951,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"豪","Rank":0,"FirstClauseRhyme":"豪","Title":{"Content":"和钱学士呈邵兴宗","Comments":[{"Content":"公辅，字君倚","Type":"Text","Index":4}]},"Clauses":[{"Content":"霜露苍苍宰树高，"},{"Content":"累茵列鼎重鸿毛。"},{"Content":"蒹葭自幸犹依玉，"},{"Content":"髋髀何能学奏刀。"},{"Content":"才薄无由裨覆焘，"},{"Content":"命奇不得报劬劳。","Comments":[{"Content":"自注：光仕始周岁，二亲继丧。","Type":"Text","Index":7}]},{"Content":"平生念此心先乱，"},{"Content":"蓼蓼难分莪与蒿。"}]},{"Id":80938,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"和始平公郡斋偶书二首"},"Clauses":[{"Content":"文武从容两有馀，"},{"Content":"公槐将幕往来居。"},{"Content":"已安四海如三杰，"},{"Content":"欲散千金比二疏。"},{"Content":"今日监边亲跪毂，"},{"Content":"佗年入殿赐乘车。"},{"Content":"武侯暂为苍生起，"},{"Content":"长忆隆中卧旧庐。"}]},{"Id":80937,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"和始平公郡斋偶书二首"},"Clauses":[{"Content":"平安候火出云间，"},{"Content":"区脱无尘刁斗闲。"},{"Content":"汉相威声遥制敌，"},{"Content":"胡兵远迹夜开关。"},{"Content":"赤松雅意思轻举，"},{"Content":"黄阁群心望复还。"},{"Content":"玉帐牙旗空壮观，"},{"Content":"谢公高兴在东山。"}]},{"Id":80834,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"次韵和冲卿中秋胧月"},"Clauses":[{"Content":"岂无锦幄翠帘垂，"},{"Content":"匝树明灯正赫曦。"},{"Content":"共惜月华方满夜，"},{"Content":"更当秋色中分时。"},{"Content":"乌皮几稳风侵鬓，"},{"Content":"白玉楼高冷透肌。"},{"Content":"千里浮云何处断，"},{"Content":"北来试问雁应知。"}]},{"Id":80894,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"和冲卿喜雨偶成"},"Clauses":[{"Content":"万里风随快雨来，"},{"Content":"尘昏消伏旱光开。"},{"Content":"物情濯热参差喜，"},{"Content":"天意为仁容易回。","Comments":[{"Content":"原作溯，据陈本改","Type":"Text","Index":7}]},{"Content":"帘映薄寒灯有晕，"},{"Content":"窗含虚白麝成煤。","Comments":[{"Content":"原作日，据四库本改","Type":"Text","Index":4}]},{"Content":"君侯雅有江湖兴，"},{"Content":"萧洒何须气象催。"}]},{"Id":80833,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"蒸","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"次韵和王胜之十二月十五日朝退马上作"},"Clauses":[{"Content":"瓦沟微白雪光清，"},{"Content":"阙角初红海日腾。"},{"Content":"尘息长街千骑入，","Comments":[{"Content":"原作人，据陈本改","Type":"Text","Index":7}]},{"Content":"鞘鸣深殿六龙升。"},{"Content":"云岩有客空回首，"},{"Content":"圭荜何人尚曲肱。"},{"Content":"自笑鲰生章绶缚，"},{"Content":"不容逃去正如罾。"}]},{"Id":81318,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"又和雪"},"Clauses":[{"Content":"四檐冰管未全晞，"},{"Content":"一夕阴风雪又飞。"},{"Content":"客卧牛衣忧死别，"},{"Content":"人留玉塞望生归。"},{"Content":"公车岁晚怜东郭，"},{"Content":"辽海云深失令威。"},{"Content":"颇忆当年映书否，"},{"Content":"物华如旧鬓毛非。"}]},{"Id":81440,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"和吴省副梅花半开招凭由张司封饮","Comments":[{"Content":"中复，字仲庶","Type":"Text","Index":4},{"Content":"伯玉，字公达","Type":"Text","Index":14}]},"Clauses":[{"Content":"帝乡春色岭头梅，"},{"Content":"高压年华犯雪开。"},{"Content":"正与嘉宾思共醉，"},{"Content":"不须芳物重相催。"},{"Content":"从车贮酒传呼出，"},{"Content":"侧弁簪花倒载回。"},{"Content":"风雨难期王事剧，"},{"Content":"未知休沐几旬来。"}]},{"Id":81202,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"御制后苑赏花钓鱼七言四韵诗一首奉圣旨次韵"},"Clauses":[{"Content":"馺娑蜚廉次第开，"},{"Content":"鸣鞘传跸自天来。"},{"Content":"云随䌽仗低临幄，"},{"Content":"柳压金堤翠入杯。"},{"Content":"槛倚柔风丝缥渺，"},{"Content":"花翻丽日影徘徊。"},{"Content":"上林春色长如旧，"},{"Content":"玉辇嬉游岁岁陪。"}]},{"Id":81109,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"Title":{"Content":"送致仕朱郎中令孙"},"Clauses":[{"Content":"世间荣利无穷物，"},{"Content":"奔走劳劳何所之。"},{"Content":"仕宦为郎非不达，"},{"Content":"功名有命待无时。"},{"Content":"橐中虽乏千金直，"},{"Content":"膝下常携两绶儿。"},{"Content":"细校人生能此少，"},{"Content":"好从闾里乐期颐。"}]},{"Id":80876,"Classes":["題畫 山水"],"Froms":["御定历代题画诗类卷二十二 山水类"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"依韵和仲庶省壁画山水"},"Clauses":[{"Content":"画工执笔已心游，"},{"Content":"稍稍蘅皋引杜洲。"},{"Content":"堆案烦文犹倦暑，"},{"Content":"满轩新意忽惊秋。"},{"Content":"天生贤者非无谓，"},{"Content":"官遇明时未易休。"},{"Content":"正恐怒飞朝暮事，"},{"Content":"丹青难得久淹留。"}]},{"Id":80975,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"始平公以光得免使北赐之以诗谨依韵酬和"},"Clauses":[{"Content":"皇华将命得人难，"},{"Content":"专对非才辄自言。"},{"Content":"幸免驱车涉沙漠，"},{"Content":"尚容载笔侍宣温。"},{"Content":"不唯羞屈穹庐膝，"},{"Content":"无奈常游魏阙魂。"},{"Content":"衮职区区未能补，"},{"Content":"何时馀论奉清樽。"}]},{"Id":81562,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"送李侍郎西京留台","Comments":[{"Content":"东之","Type":"Text","Index":4}]},"Clauses":[{"Content":"先公勋烈盛盐梅，"},{"Content":"清白仍闻世济才。"},{"Content":"华省拂衣辞簿领，"},{"Content":"长衢回首谢尘埃。"},{"Content":"嵩峰排雾依稀出，"},{"Content":"洛水迎人迤逦来。"},{"Content":"寄语马前头白吏，"},{"Content":"何殊昔日李西台。"}]},{"Id":80946,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"和赵子舆龙州吏隐堂"},"Clauses":[{"Content":"四望逶迤万叠山，"},{"Content":"微通云栈落尘寰。"},{"Content":"谁知吏道自可隐，"},{"Content":"未必仙家有此闲。"},{"Content":"酒熟何人能共醉，"},{"Content":"诗成无事复相关。"},{"Content":"浮生适意即为乐，"},{"Content":"安用腰金鼎鼐间。"}]},{"Id":80953,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"和范景仁夜读试卷"},"Clauses":[{"Content":"案前官烛堕花频，"},{"Content":"满目高文妙入神。"},{"Content":"勇气先登势无敌，"},{"Content":"巧心后发语尤新。"},{"Content":"好贤何啻三薰贵，"},{"Content":"求宝方知百汰真。"},{"Content":"愚鲁自非凭骥发，"},{"Content":"昆山千里到无因。"}]}],"Count":1270,"PageNo":26,"PageSize":20}