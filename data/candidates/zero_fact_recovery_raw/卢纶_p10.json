{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11132,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"佳","Rank":0,"Title":{"Content":"春词"},"Clauses":[{"Content":"北苑罗裙带，"},{"Content":"尘衢锦绣鞋。"},{"Content":"醉眠芳树下，"},{"Content":"半被落花埋。"}]},{"Id":11095,"GroupIndex":1,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"支","Rank":0,"Title":{"Content":"天长久词","Comments":[{"Content":"三首。附《宫中乐》二首，一作《天长词》，一作《天长地久词》。","Type":"Text","Index":4}]},"Clauses":[{"Content":"玉砌红花树，"},{"Content":"香风不敢吹。"},{"Content":"春光解天意，"},{"Content":"偏发殿南枝。","Comments":[{"Content":"天长久，万年昌","Type":"Text","Index":5}]}]},{"Id":11096,"GroupIndex":2,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"天长久词","Comments":[{"Content":"三首。附《宫中乐》二首，一作《天长词》，一作《天长地久词》。","Type":"Text","Index":4}]},"Clauses":[{"Content":"虹桥千步廊，"},{"Content":"半在水中央。"},{"Content":"天子方清暑，","Comments":[{"Content":"一作消","Type":"Text","Index":4}]},{"Content":"宫娃起夜妆。","Comments":[{"Content":"一作人重暮","Type":"Text","Index":4},{"Content":"天长久，万年昌","Type":"Text","Index":5}]}]},{"Id":11097,"GroupIndex":3,"Allusions":[{"AllusionIndex":1941,"AllusionKey":"辞辇","SentenceIndex":0},{"AllusionIndex":2193,"AllusionKey":"当熊","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"天长久词","Comments":[{"Content":"三首。附《宫中乐》二首，一作《天长词》，一作《天长地久词》。","Type":"Text","Index":4}]},"Clauses":[{"Content":"辞辇复当熊，","Comments":[{"Content":"辞辇","Type":"AllusionKey","Index":2},{"Content":"当熊","Type":"AllusionKey","Index":5}]},{"Content":"倾心奉六宫。","Comments":[{"Content":"一作上","Type":"Text","Index":4}]},{"Content":"君王若看貌，","Comments":[{"Content":"一作见","Type":"Text","Index":5}]},{"Content":"甘在众妃中。","Comments":[{"Content":"天长久，万年昌","Type":"Text","Index":5}]}]},{"Id":11143,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"途中遇雨马上口号留别张刘二端公"},"Clauses":[{"Content":"阴雷慢转野云长，"},{"Content":"骏马双嘶爱雨凉。","Comments":[{"Content":"一作骢","Type":"Text","Index":1}]},{"Content":"应念龙钟在泥滓，","Comments":[{"Content":"一作客","Type":"Text","Index":7}]},{"Content":"欲摧肝胆事王章。","Comments":[{"Content":"一作君王","Type":"Text","Index":7}]}]},{"Id":11153,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"Title":{"Content":"题念济寺"},"Clauses":[{"Content":"灵空闻偈夜清静，","Comments":[{"Content":"一作净","Type":"Text","Index":7}]},{"Content":"雨里花枝朝暮开。"},{"Content":"故友九泉留语别，","Comments":[{"Content":"一作里","Type":"Text","Index":2}]},{"Content":"逐臣千里寄书来。"}]},{"Id":11124,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"河口逢江州朱道士因听琴"},"Clauses":[{"Content":"庐山道士夜携琴，"},{"Content":"映月相逢辨语音。"},{"Content":"引坐霜中弹一弄，"},{"Content":"满船商客有归心。"}]},{"Id":11094,"Allusions":[{"AllusionIndex":4085,"AllusionKey":"河阳","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"中书舍人李座上送颍阳徐少府"},"Clauses":[{"Content":"颍阳春色似河阳，","Comments":[{"Content":"河阳","Type":"AllusionKey","Index":7}]},{"Content":"一望繁花一县香。"},{"Content":"今日送官君最恨，","Comments":[{"Content":"一作君","Type":"Text","Index":4}]},{"Content":"可怜才子白须长。"}]},{"Id":11086,"GroupIndex":1,"Allusions":[{"AllusionIndex":3025,"AllusionKey":"献赋","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"与从弟瑾同下第后出关言别"},"Clauses":[{"Content":"同作金门献赋人，","Comments":[{"Content":"献赋","Type":"AllusionKey","Index":6}]},{"Content":"二年悲见故园春。"},{"Content":"到阙不沾新雨露，"},{"Content":"还家空带旧风尘。"}]},{"Id":11087,"GroupIndex":2,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"与从弟瑾同下第后出关言别"},"Clauses":[{"Content":"杂花飞尽柳阴阴，"},{"Content":"官路逶迤绿草深。"},{"Content":"对酒已成千里客，"},{"Content":"望山空寄两乡心。"}]},{"Id":11088,"Classes":["軍旅 營地"],"GroupIndex":3,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"与从弟瑾同下第后出关言别"},"Clauses":[{"Content":"出关愁暮一沾裳，"},{"Content":"满野蓬生古战场。"},{"Content":"孤村树色昏残雨，"},{"Content":"远寺钟声带夕阳。"}]},{"Id":11089,"GroupIndex":4,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"冬","Rank":0,"FirstClauseRhyme":"冬","Title":{"Content":"与从弟瑾同下第后出关言别"},"Clauses":[{"Content":"谁怜苦志已三冬，"},{"Content":"却欲躬耕学老农。"},{"Content":"流水白云寻不尽，"},{"Content":"期君何处得相逢。"}]},{"Id":11135,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"赴虢州留别故人","Comments":[{"Content":"（一作失题）。（一作李益诗）","Type":"Text","Index":7}]},"Clauses":[{"Content":"世故相逢各未闲，"},{"Content":"百年多在别离间。"},{"Content":"昨夜秋风今夜雨，"},{"Content":"不知何处入空山。"}]},{"Id":11139,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"送畅当还旧山"},"Clauses":[{"Content":"常逢明月马尘间，"},{"Content":"是夜照君归处山。"},{"Content":"山中松桂花尽发，"},{"Content":"头白属君如等闲。"}],"Comments":[{"Book":"《唐诗归》","Content":"钟云：调古甚，入绝句尤难。","IsComment":false,"FullPath":"《唐诗归》"}]},{"Id":11138,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"送昙延法师讲罢赴上都"},"Clauses":[{"Content":"金缕袈裟国大师，"},{"Content":"能销坏宅火烧时。"},{"Content":"复来拥膝说无住，"},{"Content":"知向人天何处期。"}]},{"Id":11129,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"将赴京留献令公"},"Clauses":[{"Content":"沙鹤惊鸣野雨收，"},{"Content":"大河风物飒然秋。"},{"Content":"力微恩重谅难报，"},{"Content":"不是行人不解愁。"}]},{"Id":11150,"Classes":["軍旅 軍士"],"Allusions":[{"AllusionIndex":4342,"AllusionKey":"汤师","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"詶灵澈上人","Comments":[{"Content":"一作口号戏赠灵澈上人时奉事入城","Type":"Text","Index":5}]},"Clauses":[{"Content":"军人奉役本无期，"},{"Content":"落叶花开总不知。","Comments":[{"Content":"一作叶落","Type":"Text","Index":2}]},{"Content":"走马城中头雪白，"},{"Content":"若为将面见汤师。","Comments":[{"Content":"汤师","Type":"AllusionKey","Index":7}]}]},{"Id":11398,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"霰","Rank":0,"Title":{"Content":"雨中酬友人"},"Clauses":[{"Content":"看山独行归竹院，"},{"Content":"水绕前阶草生遍。"},{"Content":"空林细雨暗无声，","Comments":[{"Content":"一作明暗寂","Type":"Text","Index":5}]},{"Content":"唯有愁心两相见。"}]},{"Id":11141,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"哭司农苗主簿"},"Clauses":[{"Content":"原头殡御绕新茔，"},{"Content":"原下行人望哭声。","Comments":[{"Content":"一作上","Type":"Text","Index":2}]},{"Content":"更想秋山连古木，"},{"Content":"唯应石上见君名。"}]},{"Id":11144,"Classes":["軍旅 軍士"],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"逢病军人","Comments":[{"Content":"一作卢仝诗","Type":"Text","Index":4}]},"Clauses":[{"Content":"行多有病住无粮，","Comments":[{"Content":"一作无力","Type":"Text","Index":4}]},{"Content":"万里还乡未到乡。"},{"Content":"蓬鬓哀吟古城下，"},{"Content":"不堪秋气入金疮。"}],"Comments":[{"Book":"《对床夜语》","Content":"赵微明《回军跛者》之诗，只读起句，不必看题，亦必知为此诗矣。……卢纶《逢病军人》诗云：“行多有病住无粮……”驱骂虽未及前，而凄苦之意，殆无以过。起句亦尽。","IsComment":false,"FullPath":"《对床夜语》"},{"Book":"《唐人绝句精华》","Content":"凡战阵伤残兵士，理应有抚恤。此诗所写伤兵之苦如此，则其吋军政之窳败自在言外。吟，呻吟也。","IsComment":false,"FullPath":"《唐人绝句精华》"},{"Book":"唐诗鉴赏辞典","Content":"此诗写一个伤病退伍在还乡途中的军人，从诗题看可能是以作者目睹的生活事件为依据。诗人用集中描画、加倍渲染的手法，着重塑造人物的形象。诗中的这个伤兵退伍后，他很快就发觉等待着他的仍是悲惨的命运。“行多”，已不免疲乏；加之“有病”，对赶路的人就越发难堪了。病不能行，便引出“住”意。然而住又谈何容易，离军即断了给养，长途跋涉中，干粮已尽。“无粮”的境况下多耽一天多受一天罪。第一句只短短七字，写出“病军人”的三重不堪，将其行住两难、进退无路的凄惨处境和盘托出，这就是“加倍”手法的妙用。第二句承上句“行”字，进一步写人物处境。分为两层。“万里还乡”是“病军人”的目的和希望。尽管家乡也不会有好运等着他，但狐死首丘，叶落归根，对于“病军人”不过是得愿死于乡里而已。虽然“行多”，但家乡远隔万里，未行之途必更多。就连死于乡里那种可怜的愿望怕也难以实现呢。这就使“未到乡”三字充满难言的悲愤、哀怨，令读者为之酸鼻。这里，“万里还乡”是不幸之幸，对于诗情是一纵；然而“未到乡”，又是“喜”尽悲来，对于诗情是一擒。由于这种擒纵之致，使诗句读来一唱三叹，低回不尽。<br /><br />诗的前两句未直接写人物外貌。只闻其声，不见其人。然而由于加倍渲染与唱叹，人物形象已呼之欲出。在前两句铺垫的基础上，第三句进而刻画人物外貌，就更鲜明突出，有如雕像被安置在适当的环境中。“蓬鬓”二字，极生动地再现出一个疲病冻饿、受尽折磨的人物形象。“哀吟”直接是因为病饿的缘故，尤其是因为创伤发作的缘故。“病军人”负过伤（“金疮”），适逢“秋气”已至，气候变坏，于是旧伤复发。从这里又可知道其衣着的单薄、破敝，不能御寒。于是，第四句又写出了三重“不堪”。此外还有一层未曾明白写出而读者不难意会，那就是“病军人”常恐死于道路、弃骨他乡的内心绝望的痛苦。正由于有交加于身心两方面的痛苦，才使其“哀吟”令人不忍卒闻。这样一个“蓬鬓哀吟”的伤兵形象，作者巧妙地把他放在一个“古城”的背景下，其形容的憔悴，处境的孤凄，无异十倍加。使人感到他随时都可能象蚂蚁一样在城边死去。<br /><br />这样，通过加倍手法，有人物刻划，也有背景的烘托，把“病军人”饥、寒、疲、病、伤的苦难集中展现，“凄苦之意，殆无以过”（南宋范晞文《对床夜语》）。它客观上是对社会的控诉，也流露出诗人对笔下人物的深切同情。<br /><br />（周啸天）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]}],"Count":337,"PageNo":10,"PageSize":20}