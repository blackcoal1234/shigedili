{"Authors":{"Names":["晏殊"],"AuthorIds":[27290],"Dynasties":["Song"]},"ShiData":[{"Id":198051,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"牡丹"},"Clauses":[{"Content":"水晶宫殿接龙津，"},{"Content":"碧树阳春晓色新。"},{"Content":"朱户曲房能驻日，"},{"Content":"酥盘金胜自生春。","Comments":[{"Content":"宋陈景沂《全芳备祖》前集卷六","Type":"Text","Index":7}]}]},{"Id":198069,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"青","Rank":0,"Title":{"Content":"金灯花"},"Clauses":[{"Content":"兰香爇处光犹浅，"},{"Content":"银烛烧时焰不馨。"},{"Content":"好向书生窗下种，"},{"Content":"免教辛苦更囊萤。","Comments":[{"Content":"同上书卷二六","Type":"Text","Index":7}]}]},{"Id":198072,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"草"},"Clauses":[{"Content":"春尽江南茂草深，"},{"Content":"绕池萦树碧岑岑。","Comments":[{"Content":"补编作榭","Type":"Text","Index":4}]},{"Content":"长安官舍孤根地，"},{"Content":"一寸幽芳万里心。","Comments":[{"Content":"同上书卷一○","Type":"Text","Index":7}]}]},{"Id":198068,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"Title":{"Content":"金凤花"},"Clauses":[{"Content":"九苞颜色春霞萃，","Comments":[{"Content":"《全芳备祖》作意动","Type":"Text","Index":7}]},{"Content":"丹穴威仪秀气殚。","Comments":[{"Content":"《全芳备祖》作攒","Type":"Text","Index":7}]},{"Content":"题品直须名最上，"},{"Content":"昂昂骧首倚朱栏。","Comments":[{"Content":"宋祝穆《事文类聚》后集卷三二","Type":"Text","Index":7}]}]},{"Id":198071,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"金柅园"},"Clauses":[{"Content":"临川楼上柅园中，"},{"Content":"十五年前此会同。"},{"Content":"一曲清歌满樽酒，"},{"Content":"人生何处不相逢。","Comments":[{"Content":"宋祝穆《方舆胜览》卷二一","Type":"Text","Index":7}]}]},{"Id":198025,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"上元"},"Clauses":[{"Content":"金翠光中宝焰繁，"},{"Content":"山楼高下鼓声喧。"},{"Content":"两军伎女轻如鹘，"},{"Content":"百尺竿头电线翻。","Comments":[{"Content":"宋陈元靓《岁时广纪》卷一○","Type":"Text","Index":7}]}]},{"Id":198073,"GroupIndex":3,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"海棠"},"Clauses":[{"Content":"昔闻游客话芳菲，"},{"Content":"濯锦江头几万枝。"},{"Content":"纵使许昌诗笔健，"},{"Content":"可能终古绝妍辞。"}]},{"Id":198032,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"元日词"},"SubTitle":{"Content":"御阁"},"Clauses":[{"Content":"莺谷春风柳上归，"},{"Content":"禁闱芳树渐依依。","Comments":[{"Content":"四库本作园","Type":"Text","Index":2}]},{"Content":"尧年亿万如天远，"},{"Content":"万国欢心拱太微。"}]},{"Id":198035,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"Title":{"Content":"元日词"},"SubTitle":{"Content":"御阁"},"Clauses":[{"Content":"屠苏醴酒盈金斝，"},{"Content":"郁垒神符卫紫关。"},{"Content":"三境上真垂介福，"},{"Content":"绵绵洪算等南山。"}]},{"Id":198037,"GroupIndex":3,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"青","Title":{"Content":"元日词"},"SubTitle":{"Content":"御阁"},"Clauses":[{"Content":"南国雕胡奉紫庭，"},{"Content":"九重楼阁瑞云生。"},{"Content":"丹毫玉策延洪算，","Comments":[{"Content":"四库本作台","Type":"Text","Index":2}]},{"Content":"八表欢娱四海清。"}]},{"Id":198039,"GroupIndex":4,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"元日词"},"SubTitle":{"Content":"御阁"},"Clauses":[{"Content":"习习条风拂曙来，"},{"Content":"清香犹绽雪中梅。"},{"Content":"屠苏酒绿炉烟动，"},{"Content":"共献宜城万寿杯。"}]},{"Id":198030,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"元日词"},"SubTitle":{"Content":"内廷"},"Clauses":[{"Content":"玉殿初晨淑气和，"},{"Content":"璧池冰解水生波。"},{"Content":"龟台圣母增年历，"},{"Content":"万寿无疆积庆多。"}]},{"Id":198033,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"豪","Rank":0,"FirstClauseRhyme":"豪","Title":{"Content":"元日词"},"SubTitle":{"Content":"内廷"},"Clauses":[{"Content":"献寿椒花泛渌醪，"},{"Content":"迎祥朱户怙仙桃。","Comments":[{"Content":"四库本作帖","Type":"Text","Index":5}]},{"Content":"彤庭玉殿炉烟起，"},{"Content":"霭霭卿云瑞日高。"}]},{"Id":198036,"GroupIndex":3,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"豪","Rank":0,"FirstClauseRhyme":"萧","Title":{"Content":"元日词"},"SubTitle":{"Content":"内廷"},"Clauses":[{"Content":"池冰初解雪初消，"},{"Content":"十二重城晓日高。"},{"Content":"飒飒和风绕珠树，"},{"Content":"千年春色在蟠桃。"}]},{"Id":198038,"GroupIndex":4,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"Title":{"Content":"元日词"},"SubTitle":{"Content":"内廷"},"Clauses":[{"Content":"三百六旬初一日，"},{"Content":"四时嘉序太平年。"},{"Content":"霓衣绛节修真箓，"},{"Content":"步武祥云奉九天。"}]},{"Id":198031,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"元日词"},"SubTitle":{"Content":"东宫阁"},"Clauses":[{"Content":"铜龙楼下早春归，"},{"Content":"三朔元辰在此时。"},{"Content":"椒柏暖风浮玉斝，"},{"Content":"两宫称庆奉皇慈。","Comments":[{"Content":"原作恩，据四库本改","Type":"Text","Index":7}]}]},{"Id":198034,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"元日词"},"SubTitle":{"Content":"东宫阁"},"Clauses":[{"Content":"条风发动协初辰，","Comments":[{"Content":"四库本作岁","Type":"Text","Index":4}]},{"Content":"玄圃瑶山景象新。"},{"Content":"千载百灵资介福，","Comments":[{"Content":"补编作白麟","Type":"Text","Index":4}]},{"Content":"沧溟重润月重轮。"}]},{"Id":198044,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"