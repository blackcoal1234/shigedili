{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":536021,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"豪","Rank":0,"FirstClauseRhyme":"萧","Title":{"Content":"杏花"},"Clauses":[{"Content":"浅注胭脂剪绛绡，"},{"Content":"独将妖艳冠花曹。"},{"Content":"春心自得东君意，"},{"Content":"远胜玄都观里桃。"}]},{"Id":536024,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"文","Title":{"Content":"偶得牡丹数本移植窗外将有著花意二首"},"Clauses":[{"Content":"王种元从上苑分，"},{"Content":"拥培围护怕因循。"},{"Content":"快晴快雨随人意，"},{"Content":"正为墙阴作好春。"}]},{"Id":536025,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"偶得牡丹数本移植窗外将有著花意二首"},"Clauses":[{"Content":"香玉对春未啄花，"},{"Content":"露根烘晓见红霞。"},{"Content":"自非水月观音样，"},{"Content":"不称维摩居士家。"}]},{"Id":536027,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"柳"},"Clauses":[{"Content":"万缕千丝织暖风，"},{"Content":"绊烟留雾市桥东。"},{"Content":"砌成幽恨斜阴里，"},{"Content":"供断闲愁细雨中。"}]},{"Id":96223,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"初夏二首"},"Clauses":[{"Content":"冰蚕欲茧二桑阴，"},{"Content":"粉箨彫风曲径深。"},{"Content":"长日渐成微暑意，"},{"Content":"喜看楼影浸波心。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[二阴]延客堂钞本作[翠桑阴]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":536030,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"Title":{"Content":"日永"},"Clauses":[{"Content":"雨过横塘蛙吹闹，"},{"Content":"日融芳圃蜜脾香。"},{"Content":"一痕心事难消遣，"},{"Content":"双鹊飞鸣过短墙。"}]},{"Id":96280,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"端午"},"Clauses":[{"Content":"纵有灵符共䌽丝，"},{"Content":"心情不似旧家时。"},{"Content":"榴花照眼能牵恨，"},{"Content":"强切菖蒲泛酒卮。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[旧家]《宋元百家诗》　《名媛诗归》作[去年]。[能]《千家诗选》作[唯]。[牵恨]<br />《名媛诗归》作[供恨]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":536032,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"齐","Title":{"Content":"纳凉桂堂二首"},"Clauses":[{"Content":"微凉待月画楼西，"},{"Content":"风递荷香拂面吹。"},{"Content":"先自桂堂无暑气，"},{"Content":"那堪人唱雪堂词。"}]},{"Id":536033,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"Title":{"Content":"纳凉桂堂二首"},"Clauses":[{"Content":"清香满座瓜分玉，"},{"Content":"明月澄空酒漾金。"},{"Content":"不是夜凉难就醉，"},{"Content":"一帘秋色竹森森。"}]},{"Id":536034,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"梅蒸滋甚因怀湖上二首"},"Clauses":[{"Content":"东风作雨浅寒生，"},{"Content":"梅子传黄未肯晴。"},{"Content":"戢戢箨龙头角就，"},{"Content":"温云缭绕变江城。"}]},{"Id":536035,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"梅蒸滋甚因怀湖上二首"},"Clauses":[{"Content":"云暗湖光雨四垂，"},{"Content":"珠玑万斛撒琉璃。"},{"Content":"紫苔阶面寒声急，"},{"Content":"有甚心情更赋诗。"}]},{"Id":536036,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"纳凉即事"},"Clauses":[{"Content":"旋折莲蓬破绿瓜，"},{"Content":"酒杯收起点新茶。"},{"Content":"飞蝇不到冰壶净，"},{"Content":"时有凉风入齿牙。"}]},{"Id":536037,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"夏雨生凉三首"},"Clauses":[{"Content":"烈日如焚正蕴隆，"},{"Content":"黑云载雨泻长空。"},{"Content":"搜龙霹雳一声歇，","Comments":[{"Content":"《后村千家诗》卷一二作乖","Type":"Text","Index":1}]},{"Content":"庭竹潇潇来好风。"}]},{"Id":536038,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"夏雨生凉三首"},"Clauses":[{"Content":"崒嵂金蛇殷殷雷，"},{"Content":"过雷斑驳渐晴开。","Comments":[{"Content":"原作较，据清抄本改","Type":"Text","Index":4}]},{"Content":"雨催凉意诗催雨，"},{"Content":"当尽新篘玉友醅。"}]},{"Id":536039,"GroupIndex":3,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"夏雨生凉三首"},"Clauses":[{"Content":"眼界清无俗事来，"},{"Content":"要凉更著好诗催。"},{"Content":"凉生还又撩幽恨，"},{"Content":"留取孤樽对月开。"}]},{"Id":536040,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"雨过"},"Clauses":[{"Content":"幽篁脱箨绿参差，"},{"Content":"雨过微风拂面宜。","Comments":[{"Content":"原作有，据武林本改","Type":"Text","Index":5}]},{"Content":"浴罢晚妆慵不御，"},{"Content":"却亲笔砚赋新诗。"}]},{"Id":536042,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"夏夜"},"Clauses":[{"Content":"花底杯倾演漾金，"},{"Content":"月边风细竹阴阴。"},{"Content":"故人清远更真绝，"},{"Content":"消尽烦襟爽气深。"}]},{"Id":536043,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"新荷"},"Clauses":[{"Content":"平波浮动洛妃钿，"},{"Content":"翠色娇圆小更鲜。"},{"Content":"荡漾湖光三十顷，"},{"Content":"未知叶底是谁莲。"}]},{"Id":536045,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"水栀子"},"Clauses":[{"Content":"一痕春寄小峰蛮，","Comments":[{"Content":"《全芳备祖》前集卷二二作一根曾寄小峰峦","Type":"Text","Index":7}]},{"Content":"薝卜香清水影寒。","Comments":[{"Content":"原作薝，据《全芳备祖》改","Type":"Text","Index":1}]},{"Content":"玉质自然无暑意，"},{"Content":"更宜移就月中看。"}]},{"Id":536046,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"羞燕"},"Clauses":[{"Content":"停针无语泪盈眸，"},{"Content":"不但伤春夏亦愁。"},{"Content":"花外飞来双燕子，"},{"Content":"一番飞过一番羞。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》前集卷四，总题夏景","Type":"Text","Index":7}]}]}],"Count":367,"PageNo":7,"PageSize":20}