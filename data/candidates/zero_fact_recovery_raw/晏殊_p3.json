{"Authors":{"Names":["晏殊"],"AuthorIds":[27290],"Dynasties":["Song"]},"ShiData":[{"Id":198063,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"支","Rank":0,"Title":{"Content":"迎春花"},"Clauses":[{"Content":"浅艳侔莺羽，"},{"Content":"纤条结兔丝。"},{"Content":"偏凌早春发，"},{"Content":"应诮众芳迟。","Comments":[{"Content":"同上书卷二○","Type":"Text","Index":5}]}]},{"Id":198159,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"职","Rank":0,"Title":{"Content":"石榴"},"Clauses":[{"Content":"开从百花后，"},{"Content":"占断群芳色。"},{"Content":"更作琴轸房，"},{"Content":"轻盈琐窗侧。","Comments":[{"Content":"同上书后集卷六","Type":"Text","Index":5}]}]},{"Id":198171,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"11","Rank":0,"Title":{"Content":"椿"},"Clauses":[{"Content":"峨峨楚南树，"},{"Content":"杳杳含风韵。"},{"Content":"何用八千秋，"},{"Content":"腾凌诧朝菌。","Comments":[{"Content":"同上书卷一五","Type":"Text","Index":5}]}]},{"Id":198167,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"寘","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"柳"},"Clauses":[{"Content":"河柳擅佳名，"},{"Content":"青条发红穗。"},{"Content":"因愁百卉娇，"},{"Content":"强作芳菲意。","Comments":[{"Content":"同上书卷一七","Type":"Text","Index":5}]}]},{"Id":198074,"GroupIndex":4,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"Title":{"Content":"海棠"},"Clauses":[{"Content":"濯锦江头树，"},{"Content":"移根药砌中。"},{"Content":"只应春有意，"},{"Content":"偏与半妆红。"}]},{"Id":198026,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"灰","Rank":0,"Title":{"Content":"上元日诣昭应宫分献凝命殿以宪职不预班独归书事"},"Clauses":[{"Content":"别殿香三炷，"},{"Content":"斜廊酒一杯。"},{"Content":"官闲非侍从，"},{"Content":"骑马却归来。","Comments":[{"Content":"以上同上书卷八","Type":"Text","Index":5}]}]},{"Id":198099,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"真","Rank":0,"Title":{"Content":"赠李阳孙"},"Clauses":[{"Content":"不忍与君别，"},{"Content":"怜君仁义人。"},{"Content":"三年官满后，"},{"Content":"依旧一家贫。","Comments":[{"Content":"明凌迪知《万姓统谱》卷七二","Type":"Text","Index":5}]}]},{"Id":198050,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"Title":{"Content":"西垣榴花"},"Clauses":[{"Content":"山木有甘实，"},{"Content":"托根清禁中。"},{"Content":"岁芳摇落尽，"},{"Content":"独自向炎风。","Comments":[{"Content":"同上书引《后村千家诗》。按：见宋刘克庄《后村千家诗》卷九","Type":"Text","Index":5}]}]},{"Id":198041,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"豪","Rank":0,"FirstClauseRhyme":"豪","Title":{"Content":"忆越州"},"Clauses":[{"Content":"鉴湖清澈秦望高，"},{"Content":"涵虚逗碧供吟毫。"},{"Content":"当日醉眼倚空阔，"},{"Content":"三江七泽才容舠。"}]},{"Id":198040,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"Title":{"Content":"忆越州"},"Clauses":[{"Content":"湖山杳渺不可状，"},{"Content":"登览幽求无所遗。"},{"Content":"高僧伴吟足清览，"},{"Content":"见尽白莲开落时。","Comments":[{"Content":"同上书卷一五","Type":"Text","Index":7}]}]},{"Id":198046,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"吊苏哥"},"Clauses":[{"Content":"苏哥风味逼天真，"},{"Content":"恐是文君向上人。"},{"Content":"何日九原芳草绿，"},{"Content":"大家携酒哭青春。","Comments":[{"Content":"宋赵令畤《侯鲭录》卷七","Type":"Text","Index":7}]}]},{"Id":198065,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"咏上竿伎"},"Clauses":[{"Content":"百尺竿头袅袅身，"},{"Content":"足腾跟挂骇傍人。","Comments":[{"Content":"《事文类聚》作倒","Type":"Text","Index":4}]},{"Content":"汉阴有叟君知否，"},{"Content":"抱瓮区区亦未贫。","Comments":[{"Content":"宋叶梦得《石林诗话》卷中","Type":"Text","Index":7}]}]},{"Id":198078,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"煮茶"},"Clauses":[{"Content":"稽山新茗绿如烟，"},{"Content":"静挈都蓝煮惠泉。"},{"Content":"未向人间杀风景，"},{"Content":"更持醪醑醉花前。","Comments":[{"Content":"宋胡仔，苕溪渔隐丛话》前集卷二二引《西清诗话》","Type":"Text","Index":7}]}]},{"Id":198076,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"雪中"},"Clauses":[{"Content":"平台千里渴商霖，"},{"Content":"内史忧民望最深。"},{"Content":"衣上六花非所好，"},{"Content":"亩间盈尺是吾心。","Comments":[{"Content":"同上书卷二七","Type":"Text","Index":7}]}]},{"Id":198158,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"古瓦砚诗","Comments":[{"Content":"张殿院惠","Type":"Text","Index":4}]},"Clauses":[{"Content":"邺城宫殿久荒凉，"},{"Content":"缥瓦随波出禁墙。"},{"Content":"谁约藓文成古砚，"},{"Content":"放闲裁破碧鸳鸯。"}]},{"Id":494274,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"元","Rank":0,"Title":{"Content":"古瓦砚诗","Comments":[{"Content":"张殿院惠","Type":"Text","Index":4}]},"Clauses":[{"Content":"已恣玉锋磨藓骨，"},{"Content":"更持蟾泪湿云根。"},{"Content":"欲知千载凄凉意，"},{"Content":"尚有昭阳夜雨痕。","Comments":[{"Content":"宋高似孙《砚笺》卷三","Type":"Text","Index":7}]}]},{"Id":198066,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"建茶"},"Clauses":[{"Content":"北苑中春岫幌开，"},{"Content":"里民清晓驾肩来。"},{"Content":"丰隆已助新芽出，"},{"Content":"更作欢声动地催。","Comments":[{"Content":"同上书卷一二九《福建路·建宁府》","Type":"Text","Index":7}]}]},{"Id":198080,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"删","Rank":0,"Title":{"Content":"禁苑"},"Clauses":[{"Content":"风回玉宇箫声远，"},{"Content":"日下琼林佩影闲。"},{"Content":"待得年光遍天下，"},{"Content":"始教春色到人间。","Comments":[{"Content":"宋《锦绣万花谷》前集卷八","Type":"Text","Index":7}]}]},{"Id":198098,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"蒸","Rank":0,"Title":{"Content":"题巩县西门周襄王庙"},"Clauses":[{"Content":"人来人去市朝变，"},{"Content":"山后山前烟雾凝。"},{"Content":"萦带二川河洛水，"},{"Content":"寂寥千古帝王陵。","Comments":[{"Content":"宋李壁《王荆公诗笺注》卷九","Type":"Text","Index":7}]}]},{"Id":198077,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"文","Rank":0,"Title":{"Content":"鹿葱花"},"Clauses":[{"Content":"宫后扇开青雉尾，"},{"Content":"羽人衣剪赤霜文。"},{"Content":"农皇药录真无谓，"},{"Content":"不向萱丛辩纠纷。","Comments":[{"Content":"宋赵彦卫《云麓漫钞》卷四","Type":"Text","Index":7}]}]}],"Count":360,"PageNo":3,"PageSize":20}