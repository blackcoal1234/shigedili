{"Authors":{"Names":["常建"],"AuthorIds":[14932],"Dynasties":["Tang"]},"ShiData":[{"Id":46515,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"庚","Rank":0,"Title":{"Content":"高楼夜弹筝"},"Clauses":[{"Content":"高楼百馀尺，"},{"Content":"直上江水平。"},{"Content":"明月照人苦，"},{"Content":"开帘弹玉筝。"},{"Content":"山高猿狖急，"},{"Content":"天静鸿雁鸣。"},{"Content":"曲度犹未终，"},{"Content":"东峰霞半生。"}]},{"Id":46509,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"先","Rank":0,"Title":{"Content":"客有自燕而归哀其老而赠之"},"Clauses":[{"Content":"羸马朝自燕，"},{"Content":"一身为二连。"},{"Content":"忆亲拜孤冢，"},{"Content":"移葬双陵前。"},{"Content":"幽愿从此毕，"},{"Content":"剑心因获全。"},{"Content":"孟冬寒气盛，"},{"Content":"抚辔告言旋。"},{"Content":"碣石海北门，"},{"Content":"馀寇惟朝鲜。"},{"Content":"离离一寒骑，"},{"Content":"袅袅驰白天。"},{"Content":"生别皆自取，"},{"Content":"况为士卒先。"},{"Content":"寸心渔阳兴，"},{"Content":"落日旌竿悬。"}]},{"Id":46498,"Allusions":[{"AllusionIndex":923,"AllusionKey":"沧浪","SentenceIndex":1}],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"31","Rank":0,"Title":{"Content":"白龙窟汎舟寄天台学道者"},"Clauses":[{"Content":"夕映翠山深，"},{"Content":"馀晖在龙窟。"},{"Content":"扁舟沧浪意，","Comments":[{"Content":"沧浪","Type":"AllusionKey","Index":4}]},{"Content":"澹澹花影没。"},{"Content":"西浮入天色，"},{"Content":"南望对云阙。"},{"Content":"因忆莓苔峰，"},{"Content":"初阳濯玄发。"},{"Content":"泉萝两幽映，"},{"Content":"松鹤间清越。"},{"Content":"碧海莹子神，"},{"Content":"玉膏泽人骨。"},{"Content":"忽然为枯木，"},{"Content":"微兴遂如兀。"},{"Content":"应寂中有天，"},{"Content":"明心外无物。"},{"Content":"环回从所汎，"},{"Content":"夜静犹不歇。"},{"Content":"澹然意无限，"},{"Content":"身与波上月。"}]},{"Id":46505,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"元","Rank":0,"Title":{"Content":"张天师草堂"},"Clauses":[{"Content":"灵溪宴清宇，"},{"Content":"傍倚枯松根。"},{"Content":"花药绕方丈，"},{"Content":"瀑泉飞至门。"},{"Content":"四气闭炎热，"},{"Content":"两崖改明昏。"},{"Content":"夜深月暂皎，"},{"Content":"亭午朝始暾。"},{"Content":"信是天人居，"},{"Content":"幽幽寂无喧。"},{"Content":"万壑应鸣磬，"},{"Content":"诸峰接一魂。"},{"Content":"遂登仙子谷，"},{"Content":"因醉田生樽。","Comments":[{"Content":"一作中","Type":"Text","Index":4}]},{"Content":"时节开玉书，"},{"Content":"窅映飞天言。"},{"Content":"心化便无影，","Comments":[{"Content":"一作更","Type":"Text","Index":3}]},{"Content":"目精焉累烦。"},{"Content":"忽而与霄汉，","Comments":[{"Content":"一作举","Type":"Text","Index":3}]},{"Content":"寥落空南轩。"}]},{"Id":46496,"GroupIndex":1,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"12","Rank":0,"Title":{"Content":"古意三首"},"Clauses":[{"Content":"二妃方访舜，"},{"Content":"万里南方悬。"},{"Content":"远道隔江汉，"},{"Content":"孤舟无岁年。"},{"Content":"不知苍梧处，"},{"Content":"气尽呼青天。"},{"Content":"愁泪变楚竹，"},{"Content":"蛾眉丧湘川。"},{"Content":"后人立为庙，"},{"Content":"累世称其贤。"},{"Content":"过客设祠祭，"},{"Content":"狐狸来坐边。"},{"Content":"怀古未忍还，"},{"Content":"猿吟彻空山。"}]},{"Id":46497,"GroupIndex":2,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"古意三首"},"Clauses":[{"Content":"明月照高阁，"},{"Content":"䌽女褰罗幕。"},{"Content":"歌舞临碧云，"},{"Content":"箫声沸珠箔。"},{"Content":"青鸾临南海，"},{"Content":"天上双白鹤。"},{"Content":"万里齐翼飞，"},{"Content":"意求君门乐。"},{"Content":"玉霄九重闭，"},{"Content":"金锁夜不开。"},{"Content":"两翅自无力，"},{"Content":"愁鸣云外来。"},{"Content":"态深入空贵，","Comments":[{"Content":"一作人","Type":"Text","Index":3}]},{"Content":"世屈无良媒。"},{"Content":"俛仰顾中禁，"},{"Content":"东飞白玉台。"}]},{"Id":46519,"Allusions":[{"AllusionIndex":923,"AllusionKey":"沧浪","SentenceIndex":1}],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"庚","Rank":0,"Title":{"Content":"渔浦"},"Clauses":[{"Content":"春至百草绿，"},{"Content":"陂泽闻鸧鹒。"},{"Content":"别家投钓翁，"},{"Content":"今世沧浪情。","Comments":[{"Content":"沧浪","Type":"AllusionKey","Index":4}]},{"Content":"沤纻为缊袍，"},{"Content":"折麻为长缨。"},{"Content":"荣誉失本真，"},{"Content":"怪人浮此生。"},{"Content":"碧水月自阔，"},{"Content":"安流净而平。"},{"Content":"扁舟与天际，"},{"Content":"独往谁能名。"}]},{"Id":46508,"Allusions":[{"AllusionIndex":627,"AllusionKey":"采薇","SentenceIndex":10}],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"肴","Rank":0,"Title":{"Content":"空灵山应田叟"},"Clauses":[{"Content":"湖南无村落，"},{"Content":"山舍多黄茆。"},{"Content":"淳朴如太古，"},{"Content":"其人居鸟巢。"},{"Content":"牧童唱巴歌，"},{"Content":"野老亦献嘲。"},{"Content":"泊舟问溪口，"},{"Content":"言语皆哑咬。"},{"Content":"土俗不尚农，"},{"Content":"岂暇论肥硗。"},{"Content":"莫徭射禽兽，"},{"Content":"浮客烹鱼鲛。"},{"Content":"余亦罘罝人，"},{"Content":"获麋今尚苞。"},{"Content":"敬君中国来，"},{"Content":"愿以充其庖。"},{"Content":"日入闻虎斗，"},{"Content":"空山满咆哮。"},{"Content":"怀人虽共安，"},{"Content":"异域终难交。"},{"Content":"白水可洗心，"},{"Content":"采薇可为肴。","Comments":[{"Content":"采薇","Type":"AllusionKey","Index":2}]},{"Content":"曳策背落日，"},{"Content":"江风鸣梢梢。"}]},{"Id":46490,"Allusions":[{"AllusionIndex":7506,"AllusionKey":"桑榆","SentenceIndex":10}],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"支","Rank":0,"Title":{"Content":"太公哀晚遇"},"Clauses":[{"Content":"日出渭流白，"},{"Content":"文王畋猎时。"},{"Content":"钓翁在芦苇，"},{"Content":"川泽无熊罴。"},{"Content":"诏书起遗贤，"},{"Content":"匹马令致辞。","Comments":[{"Content":"一作今","Type":"Text","Index":3}]},{"Content":"因称江海人，"},{"Content":"臣老筋力衰。"},{"Content":"迟迟诣天车，"},{"Content":"快快悟灵龟。","Comments":[{"Content":"一作怏怏","Type":"Text","Index":2}]},{"Content":"兵马更不猎，"},{"Content":"君臣皆共怡。"},{"Content":"同车至咸阳，"},{"Content":"心影无磷缁。"},{"Content":"四牡玉墀下，"},{"Content":"一言为帝师。"},{"Content":"王侯拥朱门，"},{"Content":"轩盖曜长逵。"},{"Content":"古来荣华人，"},{"Content":"遭遇谁知之。"},{"Content":"落日悬桑榆，","Comments":[{"Content":"桑榆","Type":"AllusionKey","Index":5}]},{"Content":"光景有顿亏。"},{"Content":"倏忽天地人，","Comments":[{"Content":"一作悲","Type":"Text","Index":2}]},{"Content":"虽贵将何为。"}]},{"Id":46513,"Classes":["軍旅 和戎"],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"月","Rank":0,"Title":{"Content":"昭君墓"},"Clauses":[{"Content":"汉宫岂不死，"},{"Content":"异域伤独没。","Comments":[{"Content":"一作犹伤","Type":"Text","Index":4}]},{"Content":"万里驮黄金，"},{"Content":"蛾眉为枯骨。"},{"Content":"回车夜出塞，","Comments":[{"Content":"一作军","Type":"Text","Index":2}]},{"Content":"立马皆不发。"},{"Content":"共恨丹青人，","Comments":[{"Content":"一作愤","Type":"Text","Index":1}]},{"Content":"坟上哭明月。"}],"Comments":[{"Book":"《唐诗品汇》","Content":"刘云：千古词人之恨，写作当时事，断肠软语，不落脂粉，故他作不及。","IsComment":false,"FullPath":"《唐诗品汇》"},{"Book":"《增订评注唐诗正声》","Content":"起便多少悲惋。","IsComment":false,"FullPath":"《增订评注唐诗正声》"},{"Book":"《唐诗广选》","Content":"蒋仲舒曰：伤哉！片语足当万泪。“立马”句又自凄其。","IsComment":false,"FullPath":"《唐诗广选》"},{"Book":"《全唐风雅》","Content":"造意精巧（“蛾眉”句下）。","IsComment":false,"FullPath":"《全唐风雅》"},{"Book":"《唐诗选脉会通评林》","Content":"吴山民曰：“岂”、“伤”字有照应。“皆不发”三字有情。延寿先伏欧刀，死不必恨。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗绪笺》","Content":"首二句意深。昔有慰远谪者曰：“伤寒七日不起死矣，岂独海外能死人哉！”与此意同。","IsComment":false,"FullPath":"《唐诗绪笺》"}]},{"Id":46500,"Classes":["軍旅 將軍"],"Allusions":[{"AllusionIndex":235,"AllusionKey":"汉飞将","SentenceIndex":2}],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"纸","Rank":0,"Title":{"Content":"吊王将军墓","Comments":[{"Content":"（一作吊王将军）。（一作陶翰诗）","Type":"Text","Index":5}]},"Clauses":[{"Content":"嫖姚北伐时，"},{"Content":"深入强千里。","Comments":[{"Content":"一作几","Type":"Text","Index":3}]},{"Content":"战馀落日黄，"},{"Content":"军败鼓声死。"},{"Content":"尝闻汉飞将，","Comments":[{"Content":"汉飞将","Type":"AllusionKey","Index":5}]},{"Content":"可夺单于垒。"},{"Content":"今与山鬼邻，"},{"Content":"残兵哭辽水。"}],"Comments":[{"Book":"《对床夜语》","Content":"哀之至矣。第二联尤妙。","IsComment":false,"FullPath":"《对床夜语》"},{"Book":"《唐诗品汇》","Content":"殷云：一篇尽善。属辞既苦，辞亦警绝，潘岳虽云能序悲怨，未见如此章。","IsComment":false,"FullPath":"《唐诗品汇》"},{"Book":"《唐诗镜》","Content":"二四古色黯淡。","IsComment":false,"FullPath":"《唐诗镜》"},{"Book":"《唐诗归》","Content":"钟云：疏壮，又是一调。又云：“鼓声死”，从师旷“南风不竞多死声”出（“军败”句下）。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗选脉会通评林》","Content":"刘辰翁曰：短绝。形容古所未至。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐风定》","Content":"极其悲壮，幽奇寓于其中。","IsComment":false,"FullPath":"《唐风定》"},{"Book":"《唐贤三昧集笺注》","Content":"“死”字险，得力全在此。“哭”字亦善用。使人感慨不已。","IsComment":false,"FullPath":"《唐贤三昧集笺注》"},{"Book":"《唐诗别裁》","Content":"“哭枯骨”、“哭明月”、“哭辽水”，长于写哭。","IsComment":false,"FullPath":"《唐诗别裁》"}]},{"Id":46494,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"古意"},"Clauses":[{"Content":"井底玉冰洞地明，"},{"Content":"琥珀辘轳青丝索。"},{"Content":"仙人骑凤披彩霞，"},{"Content":"挽上银瓶照天阁。"},{"Content":"黄金作身双飞龙，"},{"Content":"口衔明月喷芙蓉。"},{"Content":"一时渡海望不见，"},{"Content":"晓上青楼十二重。"}],"Comments":[{"Book":"《唐诗归》","Content":"钟云：似李民吉。谭云：诗中不必多作此调，有数首入集，可脱寒酸浅易之气。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗解》","Content":"妆点绮丽，使人眩目。结归实境，便易着想，然终非有骨文。","IsComment":false,"FullPath":"《唐诗解》"},{"Book":"《唐诗选脉会通评林》","Content":"周敬曰：酷似李长吉《梦天》等作，艳不伤怪，故胜。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐风定》","Content":"创意幽玄，恍惚杳冥，几希鬼语矣！","IsComment":false,"FullPath":"《唐风定》"},{"Book":"《唐诗绪笺》","Content":"建诗七言《古意》，托之游仙，故是有养之士。","IsComment":false,"FullPath":"《唐诗绪笺》"}]},{"Id":46492,"Allusions":[{"AllusionIndex":4580,"AllusionKey":"莫愁","SentenceIndex":1}],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"古兴"},"Clauses":[{"Content":"辘轳井上双梧桐，"},{"Content":"飞鸟衔花日将没。"},{"Content":"深闺女儿莫愁年，","Comments":[{"Content":"莫愁","Type":"AllusionKey","Index":6}]},{"Content":"玉指泠泠怨金碧。"},{"Content":"石榴裙裾蛱蝶飞，"},{"Content":"见人不语颦蛾眉。"},{"Content":"青丝素丝红绿丝，"},{"Content":"织成锦衾当为谁。"}],"Comments":[{"Book":"《唐诗广选》","Content":"蒋仲舒曰：五六画出娇容，七八情语殊绝。","IsComment":false,"FullPath":"《唐诗广选》"},{"Book":"《唐诗归》","Content":"钟云：三“丝”字连用在，一句中，数得妙！谭云：写儿女闺房中开奁检点，琐屑光景在目，娓娓话头，无限情思在此（“青丝”句下）。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《汇编唐诗十集》","Content":"唐云：闺情平调，于诸家中未见其超。","IsComment":false,"FullPath":"《汇编唐诗十集》"}]},{"Id":46504,"Classes":["軍旅 出征"],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"张公子行","Comments":[{"Content":"一作古意","Type":"Text","Index":4}]},"Clauses":[{"Content":"日出乘钓舟，"},{"Content":"袅袅持钓竿。"},{"Content":"涉淇傍荷花，"},{"Content":"骢马闲金鞍。"},{"Content":"侠客白云中，","Comments":[{"Content":"一作使君","Type":"Text","Index":2}]},{"Content":"腰间悬辘轳。"},{"Content":"出门事嫖姚，"},{"Content":"为君西击胡。"},{"Content":"胡兵汉骑相驰逐，"},{"Content":"转战孤军西海北。","Comments":[{"Content":"一作海西","Type":"Text","Index":6},{"Content":"一作曲","Type":"Text","Index":7}]},{"Content":"百尺旌竿沈黑云，"},{"Content":"边笳落日不堪闻。"}],"Comments":[{"Book":"《唐诗品汇》","Content":"刘云：从闲人幽率，忽写至败军亡将，险绝。","IsComment":false,"FullPath":"《唐诗品汇》"},{"Book":"《唐风定》","Content":"和平雅捷，盛唐正派。《古意》之作外道矣，《古兴》尤靡靡，好新者喜之。","IsComment":false,"FullPath":"《唐风定》"}]},{"Id":46523,"Allusions":[{"AllusionIndex":6011,"AllusionKey":"陆沈","SentenceIndex":3}],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"侵","Rank":0,"Title":{"Content":"燕居"},"Clauses":[{"Content":"青苔常满路，"},{"Content":"流水复入林。"},{"Content":"远与市朝隔，"},{"Content":"日闻鸡犬深。"},{"Content":"寥寥丘中想，"},{"Content":"渺渺湖上心。"},{"Content":"啸傲转无欲，"},{"Content":"不知成陆沈。","Comments":[{"Content":"陆沈","Type":"AllusionKey","Index":5}]}]}],"Count":55,"PageNo":2,"PageSize":20}