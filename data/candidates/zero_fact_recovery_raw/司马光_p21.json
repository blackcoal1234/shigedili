{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80874,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"闲居呈复古"},"Clauses":[{"Content":"闲居虽懒放，"},{"Content":"未得便无营。"},{"Content":"伐木添山色，"},{"Content":"穿渠擘水声。"},{"Content":"经霜收芋美，"},{"Content":"带雨接花成。"},{"Content":"前日邻翁至，"},{"Content":"柴门扫叶迎。"}]},{"Id":80942,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"和明叔游白龙溪"},"Clauses":[{"Content":"溪深荒径微，"},{"Content":"寻胜不知疲。"},{"Content":"寒月影随马，"},{"Content":"晓风冰满髭。"},{"Content":"行歌被褐叟，"},{"Content":"聚戏拾薪儿。"},{"Content":"外野饶真趣，"},{"Content":"令人怀抱夷。"}]},{"Id":81176,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"晚春病起呈择之治臣"},"Clauses":[{"Content":"风日正和柔，"},{"Content":"身轻喜病瘳。"},{"Content":"懒抛残蠹简，"},{"Content":"暖脱弊貂裘。"},{"Content":"值客开青眼，"},{"Content":"逢花忘白头。"},{"Content":"家家好春色，","Comments":[{"Content":"原作酒，据陈本改","Type":"Text","Index":4}]},{"Content":"何处可同游。"}]},{"Id":80889,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"和王安之题独乐园","Comments":[{"Content":"原缺，据四库本补","Type":"Text","Index":8}]},"Clauses":[{"Content":"草浓初过雨，"},{"Content":"林静远含烟。"},{"Content":"燕引新飞鷇，"},{"Content":"荷承半坠莲。"},{"Content":"朋来惟有月，"},{"Content":"山见不须钱。"},{"Content":"谁与同其乐，"},{"Content":"壶中浊酒贤。"}]},{"Id":80852,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"君贶环溪"},"Clauses":[{"Content":"地胜风埃外，"},{"Content":"门深花竹间。"},{"Content":"波光冷于玉，"},{"Content":"溪势曲如环。"},{"Content":"荣路回翔厌，"},{"Content":"华轩啸咏闲。"},{"Content":"堪羞谢太傅，"},{"Content":"不复到东山。"}]},{"Id":80772,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"太皇太后挽歌词二首","Comments":[{"Content":"曹后","Type":"Text","Index":9}]},"Clauses":[{"Content":"麟阁承家庆，"},{"Content":"轩星应德晖。"},{"Content":"帝猷阴有补，"},{"Content":"嫔则动无违。"},{"Content":"遽就苍梧野，"},{"Content":"空馀大练衣。"},{"Content":"只应彤管在，"},{"Content":"万古播鸿徽。"}]},{"Id":80771,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"Title":{"Content":"太皇太后挽歌词二首","Comments":[{"Content":"曹后","Type":"Text","Index":9}]},"Clauses":[{"Content":"四纪袆衣盛，"},{"Content":"两朝长乐尊。"},{"Content":"九州贡甘旨，","Comments":[{"Content":"原作洲，据陈本改","Type":"Text","Index":2}]},{"Content":"万乘问晨昏。"},{"Content":"明辟归元子，"},{"Content":"嘉谋赉孝孙。"},{"Content":"群生资后土，"},{"Content":"难答化光恩。"}]},{"Id":80961,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"和潞公与昌言正叔游独乐园徘徊久之主人不至"},"Clauses":[{"Content":"茂勋成亮采，"},{"Content":"胜赏寄风流。"},{"Content":"闲引翘林客，"},{"Content":"同为独乐游。"},{"Content":"厌居华宇盛，"},{"Content":"翻爱弊庐幽。"},{"Content":"愧不先操彗，"},{"Content":"迎尘立道周。"}]},{"Id":80956,"Classes":["題畫 花卉"],"Froms":["御定历代题画诗类卷九十 花卉类"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"和景仁答才元寄示花图"},"Clauses":[{"Content":"高士闲居旧，"},{"Content":"名花独步今。"},{"Content":"移从洛浦远，"},{"Content":"濯自锦江深。"},{"Content":"传得巫山貌，"},{"Content":"非因延寿金。"},{"Content":"不须天女散，"},{"Content":"已解动禅心。","Comments":[{"Content":"自注：近岁举世谈禅，独景仁未耳，今亦有空相之句，故卒章戏之。","Type":"Text","Index":5}]}]},{"Id":80979,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"或谓光嗤景仁谈禅而自谈又因用前韵为景仁解禅"},"Clauses":[{"Content":"贱子悟已久，","Comments":[{"Content":"陈本、四库本作误","Type":"Text","Index":3}]},{"Content":"景仁迷自今。"},{"Content":"良因拯溺急，"},{"Content":"是致涉波深。"},{"Content":"到岸何须筏，"},{"Content":"挥锄不见金。"},{"Content":"浮云任来往，"},{"Content":"明月在天心。"}]},{"Id":81220,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"答张伯常之郢州涂中见寄"},"Clauses":[{"Content":"适意遗轩冕，"},{"Content":"轻于鸿一毛。"},{"Content":"扁舟千里远，"},{"Content":"佳句百篇豪。"},{"Content":"酒饮宜城美，"},{"Content":"歌闻白雪高。"},{"Content":"家林已春色，"},{"Content":"慎勿滞江皋。"}]},{"Id":80796,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"四月十三日立夏呈安之"},"Clauses":[{"Content":"留春春不住，"},{"Content":"昨夜的然归。"},{"Content":"欢趣何妨少，"},{"Content":"闲游勿怪稀。"},{"Content":"林莺欣有托，","Comments":[{"Content":"自注：前日始闻莺。","Type":"Text","Index":5}]},{"Content":"丛蝶怅无依。"},{"Content":"窗下忘怀客，"},{"Content":"高眠正掩扉。","Comments":[{"Content":"自注：陶潜尝言：夏月虚闲，高卧北窗下，清风飒至，自谓羲皇上人。","Type":"Text","Index":5}]}]},{"Id":80822,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"佳","Rank":0,"Title":{"Content":"安之令子河阳官舍作蛙乐轩安之有诗寄题辄敢继和"},"Clauses":[{"Content":"鼓吹娱俗耳，"},{"Content":"蛙鸣惬雅怀。"},{"Content":"最宜凉雨歇，"},{"Content":"更与晚风偕。"},{"Content":"骥子方长骛，"},{"Content":"云衢偶未谐。"},{"Content":"功名当努力，"},{"Content":"留此遗吾侪。","Comments":[{"Content":"原作济，据陈本改","Type":"Text","Index":5}]}]},{"Id":81145,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"逍遥四章呈钦之尧夫"},"Clauses":[{"Content":"结发读经史，"},{"Content":"疲精非一朝。"},{"Content":"于今成濩落，"},{"Content":"所幸得逍遥。"},{"Content":"不韪狂心息，"},{"Content":"难平客气消。"},{"Content":"巢林易为足，"},{"Content":"窃敢比鹪鹩。"}]},{"Id":81594,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"逍遥四章呈钦之尧夫"},"Clauses":[{"Content":"闲思宇宙内，"},{"Content":"何物不由天。"},{"Content":"定分不移易，"},{"Content":"劳心徒弃捐。"},{"Content":"鹏飞九万里，"},{"Content":"松寿一千年。"},{"Content":"斥鴳与朝菌，"},{"Content":"逍遥亦自然。"}]},{"Id":81593,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"逍遥四章呈钦之尧夫"},"Clauses":[{"Content":"闭目念前古，"},{"Content":"飘然一烘尘。"},{"Content":"两仪仍似旧，"},{"Content":"万物互争新。"},{"Content":"轩冕荣何在，"},{"Content":"箪瓢乐最真。"},{"Content":"众人俱我笑，"},{"Content":"我亦笑其人。"}]},{"Id":81144,"GroupIndex":4,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"逍遥四章呈钦之尧夫"},"Clauses":[{"Content":"六合旷无际，"},{"Content":"逍遥好纵游。"},{"Content":"放怀同一贯，"},{"Content":"瞬目即千秋。"},{"Content":"丸遇区臾止，"},{"Content":"萍随波浪流。"},{"Content":"所之皆自得，"},{"Content":"何惧亦何忧。","Comments":[{"Content":"以上《温国文正司马公文集》卷一四","Type":"Text","Index":5}]}]},{"Id":81229,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"齐","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"感物"},"Clauses":[{"Content":"朝看新燕飞，"},{"Content":"暮听子规啼。"},{"Content":"尺蠖身藏叶，"},{"Content":"神龟尾曳泥。"},{"Content":"鞲鹰何用掣，"},{"Content":"枥马不当嘶。"},{"Content":"自伐憎狙巧，"},{"Content":"颓然忧木鸡。","Comments":[{"Content":"陈本作爱","Type":"Text","Index":3}]}]},{"Id":81638,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"酬安之谢光兄弟见过"},"Clauses":[{"Content":"平时一二日，"},{"Content":"不见已相思。"},{"Content":"况复闭关久，"},{"Content":"杳无携手期。"},{"Content":"清谈胜妙药，"},{"Content":"高韵敌凉飔。"},{"Content":"愧乏机云美，"},{"Content":"虚承青眼知。","Comments":[{"Content":"原作清，的陈本改","Type":"Text","Index":3}]}]},{"Id":81636,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"酬王安之闻罢真率会"},"Clauses":[{"Content":"闭关宁是率，"},{"Content":"辞疾似非真。"},{"Content":"既处讥嘲地，"},{"Content":"谁为长厚人。"},{"Content":"虚舟非有意，"},{"Content":"飘瓦不须嗔。"},{"Content":"此过如何赎，"},{"Content":"清秋宴席陈。","Comments":[{"Content":"自注：安之诗有解嘲意，故以此戏之，资一笑。","Type":"Text","Index":5}]}]}],"Count":1270,"PageNo":21,"PageSize":20}