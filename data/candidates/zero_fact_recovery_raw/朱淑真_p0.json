{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":96288,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"伤春"},"Clauses":[{"Content":"阁泪抛诗卷，"},{"Content":"无聊酒独亲。"},{"Content":"客情方惜别，"},{"Content":"心事已伤春。"},{"Content":"柳暗轻笼日，"},{"Content":"花飞半掩尘。"},{"Content":"莺声惊蝶梦，"},{"Content":"唤起旧愁新。"}]},{"Id":96303,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"春日感怀"},"Clauses":[{"Content":"寂寂多愁客，"},{"Content":"伤春二月中。"},{"Content":"惜花嫌夜雨，"},{"Content":"多病怯东风。"},{"Content":"不奈莺声碎，"},{"Content":"那堪蝶梦空。"},{"Content":"海堂方睡足，"},{"Content":"帘影日融融。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[怯]《武林》本作[发]。[不奈]《名媛诗归》　《古今女史》作[不禁]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96304,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"春半"},"Clauses":[{"Content":"拭目凭阑久，"},{"Content":"柔风拂面吹。"},{"Content":"莺花争妩媚，"},{"Content":"诗酒斗清奇。"},{"Content":"已近清明节，"},{"Content":"初过上巳时。"},{"Content":"莫萦寻俗事，"},{"Content":"随意乐春熙。"}]},{"Id":96313,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"春睡"},"Clauses":[{"Content":"午窗春睡足，"},{"Content":"推枕起来时。"},{"Content":"瘦怯罗衣褪，"},{"Content":"慵妆鬓影垂。"},{"Content":"旧愁消不尽，"},{"Content":"新恨忽相随。"},{"Content":"有蝶传魂梦，"},{"Content":"无鸿寄别离。","Comments":[{"Content":"以上《新注朱淑真断肠集》前集卷二，总题春景","Type":"Text","Index":5}]}]},{"Id":536058,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"中秋"},"Clauses":[{"Content":"秋来长是病，","Comments":[{"Content":"《后村千家诗》卷四作光阴如撚指","Type":"Text","Index":5}]},{"Content":"不易到中秋。","Comments":[{"Content":"《后村千家诗》作觉是","Type":"Text","Index":3}]},{"Content":"欲赏今宵月，"},{"Content":"须登昨夜楼。"},{"Content":"露浓梧影淡，"},{"Content":"风细桂香浮。"},{"Content":"莫做寻常看，"},{"Content":"嫦娥亦解愁。"}]},{"Id":536059,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"佳","Rank":0,"FirstClauseRhyme":"佳","Title":{"Content":"中秋值雨"},"Clauses":[{"Content":"积叶冷翻阶，"},{"Content":"痴云暗海涯。"},{"Content":"楼高劳望眼，"},{"Content":"天暝隔吟怀。"},{"Content":"宛转愁难遣，"},{"Content":"团圆事未谐。"},{"Content":"四檐飞急雨，"},{"Content":"寂寂坐空齐。"}]},{"Id":96315,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"独坐"},"Clauses":[{"Content":"捲帘待明月，"},{"Content":"拂槛对西风。"},{"Content":"夜气涵秋色，"},{"Content":"瑶河浸碧空。"},{"Content":"草根鸣蟋蟀，"},{"Content":"天外叫冥鸿。"},{"Content":"几许旧时事，"},{"Content":"今宵谁与同。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[浸] 《名媛诗归》作[度] 　《古今女史》作[渡]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":536092,"Classes":["題畫 花卉"],"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"墨梅"},"Clauses":[{"Content":"若个龙眠手，"},{"Content":"能传处士诗。"},{"Content":"借他窗上影，"},{"Content":"写作雪中枝。"},{"Content":"顷刻回春色，"},{"Content":"轻盈动玉卮。"},{"Content":"不能殷七七，"},{"Content":"横笛月中吹。"}]},{"Id":96300,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"春日有作"},"Clauses":[{"Content":"景近清明节，"},{"Content":"垂杨翠缕长。"},{"Content":"塞鸿归朔漠，"},{"Content":"海燕度潇湘。"},{"Content":"花丽繁争锦，"},{"Content":"莺娇巧转簧。"},{"Content":"西园正明媚，"},{"Content":"收拾入吟乡。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[题]《千家诗选》作[春]。[翠缕] 《千家诗选》作[绿缕]。[争锦] 《武林》作[争景]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96312,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"春游西园"},"Clauses":[{"Content":"闲步西园里，"},{"Content":"春风明媚天。"},{"Content":"蝶疑庄叟梦，"},{"Content":"絮忆谢娘联。"},{"Content":"踏草青茵软，"},{"Content":"看花红锦鲜。"},{"Content":"徘徊月影下，","Comments":[{"Content":"元刻本作阴","Type":"Text","Index":3}]},{"Content":"欲去又依然。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[絮忆]《名媛诗归》　《古今女史》作[絮意]。[踏青]刘履芬校辑钞本作[踏翠] 。[月影]底本作[阴影]，据《武林》本改，《证璧集》引作[林影]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":536119,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"夏枕自咏"},"Clauses":[{"Content":"夏日初长候，"},{"Content":"风棂暑夕眠。"},{"Content":"衣轻香汗透，"},{"Content":"睡重翠鬟偏。","Comments":[{"Content":"元刻本作髻","Type":"Text","Index":3}]},{"Content":"颦绿攒眉小，"},{"Content":"啼红上脸鲜。"},{"Content":"起来无个事，"},{"Content":"纤手弄清泉。"}]},{"Id":536120,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"游湖归晚"},"Clauses":[{"Content":"恋恋西湖景，"},{"Content":"山头带夕阳。"},{"Content":"归禽翻竹露，"},{"Content":"落果响芹塘。","Comments":[{"Content":"原作果落，据武林本乙","Type":"Text","Index":2}]},{"Content":"叶倚风中静，"},{"Content":"鱼游水底凉。"},{"Content":"半亭明月色，"},{"Content":"荷气恼人香。"}]},{"Id":536123,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"秋日晚望"},"Clauses":[{"Content":"极目寒郊外，"},{"Content":"晚来微雨收。"},{"Content":"陇头霞散绮，"},{"Content":"天际月悬钩。"},{"Content":"一字新鸿度，"},{"Content":"千声落叶秋。"},{"Content":"倚楼堪听处，","Comments":[{"Content":"元刻本作栏","Type":"Text","Index":2}]},{"Content":"玉笛在渔舟。"}]},{"Id":536126,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"早秋偶笔"},"Clauses":[{"Content":"肃肃凉风至，"},{"Content":"凄然景骤清。"},{"Content":"雨馀残暑退，"},{"Content":"日落晚凉生。"},{"Content":"鹰隼双睛转，"},{"Content":"梧桐一叶惊。"},{"Content":"试听松竹里，"},{"Content":"万籁起秋声。"}]},{"Id":536131,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"中秋夜家宴咏月"},"Clauses":[{"Content":"九秋三五夕，"},{"Content":"此夕正秋中。"},{"Content":"天意一夜别，"},{"Content":"人心千古同。"},{"Content":"清光消雾霭，"},{"Content":"皓色遍高空。"},{"Content":"愿把团圆盏，"},{"Content":"年年对兔宫。"}]},{"Id":536134,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"中秋玩月"},"Clauses":[{"Content":"独占秋光盛，"},{"Content":"天工信有偏。"},{"Content":"清晖千里共，"},{"Content":"皓魄十分圆。"},{"Content":"兔影寒犹弄，"},{"Content":"蟾蜍老更坚。"},{"Content":"只愁看未足，"},{"Content":"一去又轻年。"}]},{"Id":536136,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"秋夜感怀"},"Clauses":[{"Content":"满院含秋思，"},{"Content":"蟾辉映一方。"},{"Content":"蛩吟喧曲砌，"},{"Content":"鸟宿傍回塘。","Comments":[{"Content":"原作宿鸟，据《名媛诗归》卷一九乙","Type":"Text","Index":2}]},{"Content":"木落桐应瘦，"},{"Content":"宵寒漏正长。"},{"Content":"安仁闲感慨，"},{"Content":"徒尔鬓苍苍。"}]},{"Id":536137,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"小阁秋日咏雨"},"Clauses":[{"Content":"疏雨洗高穹，"},{"Content":"潇潇滴井桐。"},{"Content":"润烟生砚底，"},{"Content":"凉气入堂中。"},{"Content":"翠锁交竿竹，"},{"Content":"红翻落叶枫。"},{"Content":"抚琴闲弄曲，"},{"Content":"静坐理商宫。"}]},{"Id":536138,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"秋日得书"},"Clauses":[{"Content":"秋风本无意，"},{"Content":"愁思自难禁。"},{"Content":"共月伤千里，"},{"Content":"来书胜万金。"},{"Content":"代骝惊北吹，"},{"Content":"越鸟恋南林。"},{"Content":"已有归宁约，"},{"Content":"何须惜岁阴。"}]},{"Id":96291,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"初冬书怀"},"Clauses":[{"Content":"触目园池景，"},{"Content":"荷枯菊已荒。"},{"Content":"风寒侵夜枕，"},{"Content":"霜冻怯晨妆。"},{"Content":"江上枫翻赤，"},{"Content":"庭前橘带黄。"},{"Content":"题诗欲排闷，"},{"Content":"对景倍悲伤。"}]}],"Count":367,"PageNo":0,"PageSize":20}