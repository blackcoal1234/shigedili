{"Authors":{"Names":["晏殊"],"AuthorIds":[27290],"Dynasties":["Song"]},"ShiData":[{"Id":198130,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"奉和圣制除夜"},"Clauses":[{"Content":"珠躔回碧落，"},{"Content":"绛燎烛青规。"},{"Content":"琐闼琼签度，"},{"Content":"层台玉漏移。"},{"Content":"纳新皇泽普，"},{"Content":"顺节圣情怡。"},{"Content":"万宇长安陌，"},{"Content":"乡傩集此时。"}]},{"Id":198115,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"Title":{"Content":"和三兄除夜"},"Clauses":[{"Content":"星汉回曾宇，"},{"Content":"埙篪集上都。"},{"Content":"夜寒凝爆燎，"},{"Content":"春气入屠苏。"},{"Content":"九陌传珂乘，"},{"Content":"千门促漏壶。"},{"Content":"此时开棣宴，"},{"Content":"仍在碧城隅。"}]},{"Id":198134,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"转运度支得青州资政黄素书韩吏部伯夷颂许昌相以以诗跋尾遂为七言因而寄及谨用拙篇纪咏"},"Clauses":[{"Content":"首阳垂范远，"},{"Content":"吏部属辞深。"},{"Content":"染翰著嘉尚，"},{"Content":"系言光德音。"},{"Content":"褒崇亘千𥜥，"},{"Content":"精妙极双金。"},{"Content":"题咏益珍秘，"},{"Content":"用昭贤彦心。","Comments":[{"Content":"明朱存理《赵氏铁网珊瑚》卷二","Type":"Text","Index":5}]}]},{"Id":198138,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"FirstClauseRhyme":"萧","Title":{"Content":"送铅山周尉"},"Clauses":[{"Content":"风烟古上饶，"},{"Content":"属邑寄山椒。"},{"Content":"仇览同栖棘，"},{"Content":"陶潜共折腰。"},{"Content":"安舆方就养，"},{"Content":"黄绶岂辞遥。"},{"Content":"善绩青箱业，"},{"Content":"兴廉有汉条。","Comments":[{"Content":"明笡继良万历《铅书》卷五","Type":"Text","Index":5}]}]},{"Id":198133,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"奉和御制中和节"},"Clauses":[{"Content":"正元崇吉序，"},{"Content":"实历记良辰。"},{"Content":"营室彤曦转，"},{"Content":"勾芒令祀新。"},{"Content":"尧蓂方告朔，"},{"Content":"汉酎更宜春。"},{"Content":"菖叶农耕候，"},{"Content":"如膏洒泽频。"}]},{"Id":198168,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"留题越州石氏山斋"},"Clauses":[{"Content":"书仙十阁壮儒宫，"},{"Content":"灵越山川宝势雄。"},{"Content":"岫柏亚香侵几席，"},{"Content":"岩花回影入帘栊。"},{"Content":"千秋碧锁东南竹，"},{"Content":"一水清含旦暮风。"},{"Content":"文酒雅宜频宴集，"},{"Content":"谢家兰玉有新丛。"}]},{"Id":198173,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"齐","Rank":0,"Title":{"Content":"赠会稽道士"},"Clauses":[{"Content":"藐姑容化三阴馆，"},{"Content":"句漏砂封六乙泥。"},{"Content":"五练夜穷青玉枕，"},{"Content":"七明晨采碧云梯。"},{"Content":"冠霞高把浮丘袂，"},{"Content":"握体深藏鬼谷奚。"},{"Content":"知有山西驻龄药，"},{"Content":"何妨相赠一刀圭。","Comments":[{"Content":"以上宋孔延之《会稽掇英总集》卷一二","Type":"Text","Index":7}]}]},{"Id":198108,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"正月十八夜"},"Clauses":[{"Content":"槿户茅斋雅自便，"},{"Content":"京华风味入新年。"},{"Content":"楼台冷落收灯夜，"},{"Content":"门巷萧条扫雪天。"},{"Content":"病酒不闻花外漏，"},{"Content":"放朝仍得日高眠。"},{"Content":"何妨静习闲中趣，"},{"Content":"欲问林僧结净缘。"}]},{"Id":198147,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"0","Rank":0,"FirstClauseRhyme":"冬","Title":{"Content":"寄远","Comments":[{"Content":"《瀛奎律髓》卷五作寓意，《元献遗文》作无题","Type":"Text","Index":2}]},"Clauses":[{"Content":"宝毂香轮不再逢，","Comments":[{"Content":"《瀛奎律髓》作油壁香车","Type":"Text","Index":4}]},{"Content":"峡云巫雨杳无踪。","Comments":[{"Content":"《瀛奎律髓》作无迹任西东","Type":"Text","Index":7}]},{"Content":"梨花院落溶溶月，"},{"Content":"柳絮池塘淡淡风。"},{"Content":"几日寂寥伤酒后，","Comments":[{"Content":"《瀛奎律髓》作中","Type":"Text","Index":5}]},{"Content":"一番萧索禁烟中。"},{"Content":"鱼书欲寄无由达，","Comments":[{"Content":"《瀛奎律髓》作何","Type":"Text","Index":5}]},{"Content":"水远山长处处同。","Comments":[{"Content":"以上宋何汶《竹庄诗话》卷一八引《诗事》","Type":"Text","Index":7}]}],"Comments":[{"Content":"（1）油壁香车：古代妇女所坐的车子，因车厢涂刷了油漆而得名。（2）峡云：巫山峡谷上的云彩。（3）溶溶：月光似水一般地流动。（4）淡淡：轻微的意思。（5）伤酒：饮酒过量导致身体不舒服。（6）萧索：缺乏生机。禁烟：指寒食节禁烟火。（7）鱼书：指书信。","IsComment":false}]},{"Id":198114,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"初秋宿直"},"Clauses":[{"Content":"绛河星斗夜阑干，"},{"Content":"禁署沈沈闭九关。"},{"Content":"上帝册书群玉府，"},{"Content":"仙人宫阙巨鳌山。"},{"Content":"凉蟾影度秋阴薄，"},{"Content":"促漏声来夜唱闲。"},{"Content":"拥鼻吟多欲愁绝，","Comments":[{"Content":"《元献遗文》作隐几","Type":"Text","Index":2}]},{"Content":"严钟凄断树乌还。"}]},{"Id":198110,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"安昌侯"},"Clauses":[{"Content":"莲勺移家近七迁，"},{"Content":"鲁儒章句世相传。"},{"Content":"关中沃壤通泾渭，"},{"Content":"堂上繁声逐管弦。"},{"Content":"身服儒衣同蔡义，"},{"Content":"日将卮酒对彭宣。"},{"Content":"高坟丈五阳陵外，"},{"Content":"千古朱云气凛然。"}]},{"Id":198109,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"假中示判官张寺丞王校勘"},"Clauses":[{"Content":"元巳清明例未开，"},{"Content":"小园幽径独徘徊。"},{"Content":"春寒不定斑斑雨，"},{"Content":"宿醉难禁滟滟杯。"},{"Content":"无可奈何花落去，"},{"Content":"似曾相识燕归来。"},{"Content":"游梁赋客多风味，"},{"Content":"莫惜青钱万选才。","Comments":[{"Content":"以上同上书卷二四","Type":"Text","Index":7}]}]},{"Id":198145,"Classes":["軍旅 要地"],"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"麻姑山"},"Clauses":[{"Content":"昔年权暂领军城，"},{"Content":"静爱仙山咏过春。"},{"Content":"天下云车曾祖驾，"},{"Content":"城中鳌海几生尘。"},{"Content":"明知绿发升真籍，"},{"Content":"堪笑苍颜预宪臣。"},{"Content":"我若粗成忠国事，"},{"Content":"赤松曾羡汉廷人。","Comments":[{"Content":"以上宋李庚，天台续集》卷上","Type":"Text","Index":7}]}]},{"Id":198142,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"海棠"},"Clauses":[{"Content":"轻盈千结乱樱丛，"},{"Content":"占得年芳近碧栊。"},{"Content":"逐处间匀高下萼，","Comments":[{"Content":"《全芳备祖》前集卷七存此诗前四句，此句作逐处开齐高下朵","Type":"Text","Index":7}]},{"Content":"几番分破浅深红。"},{"Content":"烟晴始觉香缨绽，"},{"Content":"日极犹疑蜡蒂融。"},{"Content":"数夕朱栏未飘落，"},{"Content":"再三珍重石尤风。"}]},{"Id":198127,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"Title":{"Content":"奉和圣制元日"},"Clauses":[{"Content":"人正肇届时多祜，"},{"Content":"凤历惟新景载阳。"},{"Content":"双阙布和云气郁，"},{"Content":"千门献寿玉声长。"},{"Content":"东风入律三边静，"},{"Content":"北斗回春万物芳。"},{"Content":"朝暇肃诚颁睿藻，","Comments":[{"Content":"四库本作城","Type":"Text","Index":4}]},{"Content":"搢绅交抃捧尧章。"}]},{"Id":198136,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"冬","Rank":0,"FirstClauseRhyme":"冬","Title":{"Content":"癸酉岁元日中书致斋感事"},"Clauses":[{"Content":"一叶春王拆瑞筇，"},{"Content":"八斋西省夕香浓。"},{"Content":"多年不宿金闺署，","Comments":[{"Content":"自注：自天圣三年乙丑岁十月十四日由翰林授枢密副使，罢宿禁中凡（四库本作几）八年矣。","Type":"Text","Index":7}]},{"Content":"半夜再闻长乐钟。"},{"Content":"却展旧编探史汉，"},{"Content":"更惭高步接夔龙。"},{"Content":"十思三省无荒豫，"},{"Content":"千载亨辰岂易逢。"}]},{"Id":198106,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"壬午岁元日雪"},"Clauses":[{"Content":"千门初曙彻星河，","Comments":[{"Content":"四库本作散","Type":"Text","Index":5}]},{"Content":"飒洒貂裘润玉珂。"},{"Content":"向兽樽前飞絮早，","Comments":[{"Content":"四库本作白","Type":"Text","Index":1}]},{"Content":"景阳钟后落梅多。"},{"Content":"无声暗重琼林彩，"},{"Content":"有意微藏璧沼波。"},{"Content":"三殿端辰得嘉瑞，"},{"Content":"不须庭燎夜如何。","Comments":[{"Content":"以上宋蒲积中《古今岁时杂咏》卷二","Type":"Text","Index":7}]}]},{"Id":198129,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"蒸","Rank":0,"Title":{"Content":"奉和圣制立春日"},"Clauses":[{"Content":"阴阳自协璇玑运，"},{"Content":"和煦潜随缇管升。"},{"Content":"十二紫关鱼籥启，"},{"Content":"九重晓阙绛烟凝。","Comments":[{"Content":"四库本作峣","Type":"Text","Index":3}]},{"Content":"芳华稍变青门柳，"},{"Content":"寒冻微消北陆冰。"},{"Content":"宸藻下颁羲日丽，","Comments":[{"Content":"四库本作又","Type":"Text","Index":6}]},{"Content":"八纮民庶保年登。"}]},{"Id":198125,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"Title":{"Content":"奉和圣制上元夜"},"Clauses":[{"Content":"兰灯照夕开南阙，"},{"Content":"星弁飞楼拱北辰。"},{"Content":"在镐正逢全盛日，"},{"Content":"祝尧皆是太平人。"},{"Content":"流风舞妙翻成字，"},{"Content":"积雪歌长迥绕尘。"},{"Content":"鸾鹊宝函颁睿什，","Comments":[{"Content":"原作眷，据四库本改","Type":"Text","Index":6}]},{"Content":"明良赓载想同伦。"}]},{"Id":198144,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"扈从观灯"},"Clauses":[{"Content":"诘旦雕舆下桂宫，"},{"Content":"盛时为乐与民同。"},{"Content":"三千世界笙歌里，"},{"Content":"十二都城锦绣中。"},{"Content":"行漏不能分昼夜，"},{"Content":"游人无复辨西东。"},{"Content":"归来更坐嶕峣阙，"},{"Content":"万乐铮鏦密炬红。","Comments":[{"Content":"四库本作铮蜡","Type":"Text","Index":5}]}]}],"Count":360,"PageNo":1,"PageSize":20}