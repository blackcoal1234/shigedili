{"Authors":{"Names":["司空曙"],"AuthorIds":[13632],"Dynasties":["Tang"]},"ShiData":[{"Id":12265,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"望商山路"},"Clauses":[{"Content":"南见青山道，"},{"Content":"依然去国时。"},{"Content":"已甘长避地，"},{"Content":"谁料有还期。"},{"Content":"雨霁残阳薄，"},{"Content":"人愁独望迟。"},{"Content":"空残华发在，"},{"Content":"前事不堪思。"}]},{"Id":12280,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"题落叶"},"Clauses":[{"Content":"霜景催危叶，"},{"Content":"今朝半树空。"},{"Content":"萧条故国异，"},{"Content":"零落旅人同。"},{"Content":"飒岸浮寒水，"},{"Content":"依阶拥夜虫。"},{"Content":"随风偏可羡，"},{"Content":"得到洛阳宫。","Comments":[{"Content":"一作城中","Type":"Text","Index":5}]}]},{"Id":12262,"Allusions":[{"AllusionIndex":2224,"AllusionKey":"支公","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"寄准上人"},"Clauses":[{"Content":"昨闻归旧寺，"},{"Content":"暂别欲经年。"},{"Content":"樵客应同步，","Comments":[{"Content":"一作出","Type":"Text","Index":5}]},{"Content":"邻僧定伴禅。"},{"Content":"后峰秋有雪，"},{"Content":"远涧夜鸣泉。"},{"Content":"偶与支公论，","Comments":[{"Content":"支公","Type":"AllusionKey","Index":4}]},{"Content":"人间自共传。"}]},{"Id":12236,"Allusions":[{"AllusionIndex":9277,"AllusionKey":"玄晖","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"送况上人还荆州因寄卫侍御象"},"Clauses":[{"Content":"惠持游蜀久，"},{"Content":"策杖欲西还。","Comments":[{"Content":"一作忽","Type":"Text","Index":3}]},{"Content":"共别此宵月，"},{"Content":"独归何处山。"},{"Content":"对鸥沙草畔，"},{"Content":"洗足野云间。"},{"Content":"知有玄晖会，","Comments":[{"Content":"玄晖","Type":"AllusionKey","Index":4}]},{"Content":"斋心受八关。"}]},{"Id":12272,"Allusions":[{"AllusionIndex":7687,"AllusionKey":"神燕不须雷","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"酬卫长林岁日见呈"},"Clauses":[{"Content":"地暖雪花摧，"},{"Content":"天春斗柄回。"},{"Content":"朱泥一丸药，"},{"Content":"柏叶万年杯。"},{"Content":"旅雁辞人去，"},{"Content":"繁霜满镜来。"},{"Content":"今朝彩盘上，"},{"Content":"神燕不须雷。","Comments":[{"Content":"神燕不须雷","Type":"AllusionKey","Index":5}]}]},{"Id":12209,"Allusions":[{"AllusionIndex":6267,"AllusionKey":"梅市","SentenceIndex":2},{"AllusionIndex":6353,"AllusionKey":"阮家贫","SentenceIndex":2}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"闲园即事寄暕公"},"Clauses":[{"Content":"欲就东林寄一身，"},{"Content":"尚怜儿女未成人。"},{"Content":"柴门客去残阳在，"},{"Content":"药圃虫喧秋雨频。"},{"Content":"近水方同梅市隐，","Comments":[{"Content":"梅市","Type":"AllusionKey","Index":6}]},{"Content":"曝衣多笑阮家贫。","Comments":[{"Content":"阮家贫","Type":"AllusionKey","Index":7}]},{"Content":"深山兰若何时到，"},{"Content":"羡与闲云作四邻。"}]},{"Id":12281,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"题暕上人院"},"Clauses":[{"Content":"闭门不出自焚香，"},{"Content":"拥褐看山岁月长。"},{"Content":"雨后绿苔生石井，"},{"Content":"秋来黄叶遍绳床。"},{"Content":"身闲何处无真性，"},{"Content":"年老曾言隐故乡。","Comments":[{"Content":"一作来","Type":"Text","Index":4}]},{"Content":"更说本师同学在，"},{"Content":"几时携手见衡阳。","Comments":[{"Content":"一作向","Type":"Text","Index":5}]}],"Comments":[{"Book":"《贯华堂选批唐才子诗》","Content":"前解写陈公闭门，便是彻底闭门，不唯自家不出，人亦莫得而入。“雨后绿苔”言无一人行处，“秋来黄叶”言无一人坐处，盖其门风孤峻则有如此者。后解写暕公游行，又是彻底自在。五或云摄化各处，六或云还归本乡，七、八或又云师友情缘眷恋不舍，某年某日又见在于某处，盖其分身无碍又有如此者。","IsComment":false,"FullPath":"《贯华堂选批唐才子诗》"}]},{"Id":12194,"Allusions":[{"AllusionIndex":6009,"AllusionKey":"鲁诸生","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"长安晓望寄程补阙","Comments":[{"Content":"一作包何诗","Type":"Text","Index":8}]},"Clauses":[{"Content":"迢遰山河拥帝京，"},{"Content":"参差宫殿接云平。"},{"Content":"风吹晓漏经长乐，"},{"Content":"柳带晴烟出禁城。"},{"Content":"天净笙歌临路发，","Comments":[{"Content":"一作奏","Type":"Text","Index":7}]},{"Content":"日高车马隔尘行。"},{"Content":"独有浅才甘未达，"},{"Content":"多惭名在鲁诸生。","Comments":[{"Content":"鲁诸生","Type":"AllusionKey","Index":7}]}],"Comments":[{"Book":"《诗薮》","Content":"中唐如钱起《和李员外寄郎士元》、皇甫曾《早朝》、李嘉祐《登阁》、司空曙《晓望》，皆去盛唐不远。","IsComment":false,"FullPath":"《诗薮》"},{"Book":"《批选唐诗》","Content":"清空流丽。","IsComment":false,"FullPath":"《批选唐诗》"},{"Book":"《唐诗解》","Content":"言山河之固，宫阙之丽，漏声之远，御柳之郁，天下之壮观也。","IsComment":false,"FullPath":"《唐诗解》"},{"Book":"《删订唐诗解》","Content":"此诗极为清丽，无衰飒之态。","IsComment":false,"FullPath":"《删订唐诗解》"},{"Book":"《唐诗绎》","Content":"末二转入己之不遇，言之黯然。须知前文却为“独有”二字蓄势，递到末二，倍觉神伤。","IsComment":false,"FullPath":"《唐诗绎》"},{"Book":"《唐诗别裁》","Content":"极形山河宫阙之壮丽，而己之虚名不遇，益觉可伤。","IsComment":false,"FullPath":"《唐诗别裁》"},{"Book":"《大历诗略》","Content":"虽不逮钱仲文《赠裴舍人》作，颔联亦兴调绝佳。","IsComment":false,"FullPath":"《大历诗略》"},{"Book":"《山满楼笺注唐诗七言律》","Content":"大凡遇冠冕题目，最易涉痴肥一边，而此偏能以轻秀见长。","IsComment":false,"FullPath":"《山满楼笺注唐诗七言律》"}]},{"Id":12190,"Allusions":[{"AllusionIndex":2230,"AllusionKey":"雪里题诗","SentenceIndex":1},{"AllusionIndex":4764,"AllusionKey":"林间饮酒","SentenceIndex":1}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"下第日书情寄上叔父"},"Clauses":[{"Content":"微才空觉滞京师，"},{"Content":"末学曾为叔父知。"},{"Content":"雪里题诗偏见赏，","Comments":[{"Content":"雪里题诗","Type":"AllusionKey","Index":4}]},{"Content":"林间饮酒独令随。","Comments":[{"Content":"林间饮酒","Type":"AllusionKey","Index":4}]},{"Content":"游客尽伤春色老，"},{"Content":"贫居还惜暮阴移。"},{"Content":"欲归江海寻山去，"},{"Content":"愿报何人得桂枝。"}]},{"Id":12215,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"南原望汉宫","Comments":[{"Content":"一作浦","Type":"Text","Index":2}]},"Clauses":[{"Content":"荒原空有汉宫名，"},{"Content":"衰草茫茫雉堞平。"},{"Content":"连雁下时秋水在，"},{"Content":"行人过尽暮烟生。"},{"Content":"西陵歌吹何年绝，"},{"Content":"南陌登临此日情。"},{"Content":"故事悠悠不可问，"},{"Content":"寒禽野水自纵横。"}],"Comments":[{"Book":"《贯华堂选批唐才子诗》","Content":"“何年”，妙！“此日”，妙！彼别不知何年，我来则是此日。盖前之人，当时定如我之此日；后之人更至，复不审我何年。此处更无可以着语，亦更无可以堕泪，只好闲闲然说个“悠悠不可问”五字而已。再写水禽纵横，不是冷眼相笑，亦不是慈眼等观。《庄子》云：知其不可奈何而安之为命。如是云尔！","IsComment":false,"FullPath":"《贯华堂选批唐才子诗》"}]},{"Id":12201,"Allusions":[{"AllusionIndex":9277,"AllusionKey":"玄晖","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"早夏寄元校书"},"Clauses":[{"Content":"独游野径送芳菲，","Comments":[{"Content":"一作自","Type":"Text","Index":5}]},{"Content":"高竹林居接翠微。"},{"Content":"绿岸草深虫入遍，"},{"Content":"青丛花尽蝶来稀。"},{"Content":"珠荷荐果香寒簟，"},{"Content":"玉柄摇风满夏衣。"},{"Content":"蓬荜永无车马到，"},{"Content":"更当斋夜忆玄晖。","Comments":[{"Content":"玄晖","Type":"AllusionKey","Index":7}]}]},{"Id":12286,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"赠衡岳隐禅师","Comments":[{"Content":"一作岳阳","Type":"Text","Index":3}]},"Clauses":[{"Content":"拥褐安居南岳头，"},{"Content":"白云高寺见衡州。"},{"Content":"石窗湖水摇寒月，"},{"Content":"枫树猿声报夜秋。"},{"Content":"讲席旧逢山鸟至，","Comments":[{"Content":"一作沙","Type":"Text","Index":5}]},{"Content":"梵经初向竺僧求。"},{"Content":"垂垂身老将传法，","Comments":[{"Content":"一作自知","Type":"Text","Index":2}]},{"Content":"因下人间逐北游。","Comments":[{"Content":"一作逐此","Type":"Text","Index":6}]}]},{"Id":12279,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"题凌云寺"},"Clauses":[{"Content":"春山古寺绕沧波，"},{"Content":"石磴盘空鸟道过。"},{"Content":"百丈金身开翠壁，"},{"Content":"万龛灯焰隔烟萝。"},{"Content":"云生客到侵衣湿，"},{"Content":"花落僧禅覆地多。"},{"Content":"不与方袍同结社，"},{"Content":"下归尘世竟如何。"}],"Comments":[{"Book":"《唐诗摘钞》","Content":"寺曰“凌云”，以山高故得名。首句是春山绕沧波，却插入“古寺”二字。只此句安顿得有法，以后写山处便是写寺，写寺处便是写山，皆两相映合，益见此句穿插之妙。","IsComment":false,"FullPath":"《唐诗摘钞》"},{"Book":"《唐体馀编》","Content":"题寺诗充栋，此联杰出（“百丈金身”联下）。","IsComment":false,"FullPath":"《唐体馀编》"}]},{"Id":12234,"Allusions":[{"AllusionIndex":270,"AllusionKey":"丁仙化鹤","SentenceIndex":3},{"AllusionIndex":316,"AllusionKey":"白石先生","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"送曲山人之衡州"},"Clauses":[{"Content":"白石先生眉发光，","Comments":[{"Content":"一作老","Type":"Text","Index":7},{"Content":"白石先生","Type":"AllusionKey","Index":4}]},{"Content":"已分甜雪饮红浆。","Comments":[{"Content":"一作绀","Type":"Text","Index":3}]},{"Content":"衣巾半染烟霞气，","Comments":[{"Content":"一作色","Type":"Text","Index":7}]},{"Content":"语笑兼和药草香。"},{"Content":"茅洞玉声流暗水，"},{"Content":"衡山碧色映朝阳。","Comments":[{"Content":"一作气","Type":"Text","Index":4}]},{"Content":"千年城郭如相问，"},{"Content":"华表峨峨有夜霜。"}]},{"Id":12273,"Allusions":[{"AllusionIndex":1221,"AllusionKey":"腐草","SentenceIndex":1},{"AllusionIndex":3069,"AllusionKey":"紫凤衔书","SentenceIndex":0},{"AllusionIndex":7126,"AllusionKey":"琼瑶","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"酬张芬有赦后见赠","Comments":[{"Content":"一作司空图诗","Type":"Text","Index":8}]},"Clauses":[{"Content":"紫凤朝衔五色书，"},{"Content":"阳春忽布网罗除。","Comments":[{"Content":"一作报","Type":"Text","Index":4}]},{"Content":"已将心变寒灰后，"},{"Content":"岂料光生腐草馀。","Comments":[{"Content":"腐草","Type":"AllusionKey","Index":6}]},{"Content":"建水风烟收客泪，"},{"Content":"杜陵花竹梦郊居。"},{"Content":"劳君故有诗相赠，"},{"Content":"欲报琼瑶恨不如。","Comments":[{"Content":"琼瑶","Type":"AllusionKey","Index":4}]}]},{"Id":12218,"Allusions":[{"AllusionIndex":1842,"AllusionKey":"桥下书曾受","SentenceIndex":2},{"AllusionIndex":9652,"AllusionKey":"羊公","SentenceIndex":0}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"秋日趋府上张大夫"},"Clauses":[{"Content":"重城洞启肃秋烟，"},{"Content":"共说羊公在镇年。","Comments":[{"Content":"羊公","Type":"AllusionKey","Index":4}]},{"Content":"鞞鼓暗惊林叶落，"},{"Content":"旌旗遥拂雁行偏。"},{"Content":"石过桥下书曾受，","Comments":[{"Content":"桥下书曾受","Type":"AllusionKey","Index":7}]},{"Content":"星降人间梦已传。"},{"Content":"谪吏何能沐风化，"},{"Content":"空将歌颂拜车前。"}]},{"Id":12259,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"寄卫明府常见短靴褐裘又务持诵是以有末句之赠"},"Clauses":[{"Content":"柴桑官舍近东林，"},{"Content":"儿稚初髫即道心。"},{"Content":"侧寄绳床嫌凭几，"},{"Content":"斜安苔帻懒穿簪。"},{"Content":"高僧静望山僮逐，"},{"Content":"走吏喧来水鸭沈。"},{"Content":"翠竹黄花皆佛性，"},{"Content":"莫教尘境误相侵。"}]},{"Id":12274,"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"酬李端校书见赠"},"Clauses":[{"Content":"绿槐垂穗乳乌飞，","Comments":[{"Content":"一作初","Type":"Text","Index":3}]},{"Content":"忽忆山中独未归。"},{"Content":"青镜流年看发变，"},{"Content":"白云芳草与心违。"},{"Content":"乍逢酒客春游惯，","Comments":[{"Content":"一作多","Type":"Text","Index":1},{"Content":"一作朝","Type":"Text","Index":5}]},{"Content":"久别林僧夜坐稀。"},{"Content":"昨日闻君到城阙，"},{"Content":"莫将簪弁胜荷衣。","Comments":[{"Content":"一作责","Type":"Text","Index":5}]}],"Comments":[{"Book":"《唐诗评选》","Content":"温润为中唐首唱。","IsComment":false,"FullPath":"《唐诗评选》"},{"Book":"《贯华堂选批唐才子诗》","Content":"相其七、八，乃是李端校书新来都城，有所投赠，而司空赋此酬之。乃人且新来，而我反欲去，且言无不尽去，深嫌只有我未曾去，真令新来人兜头一杓冷水也。","IsComment":false,"FullPath":"《贯华堂选批唐才子诗》"},{"Book":"《唐诗别裁》","Content":"四语言已系于一官，不能遂“白云芳草”之心。末勉其坚守初服，勿萦情于簪弁也。与前一首（按指《长安晓望寄程补阙》）似两种心事，意既得官后，知宦途之无味耶？","IsComment":false,"FullPath":"《唐诗别裁》"},{"Book":"《诗式》","Content":"发句上句切初夏，系写时令，下句“忽忆山中”四字，言校书在野，所以触景而忆也。“忽”字承上句来，“独未归”三字，言心虽忆校书在山中，而己独未归，言外若承校书见赠，因之感触，而似怨不归者，玩“独”字便得其神理矣。颔联上句言对著青镜，即知流年，此何以故？但看己发变白，己况可知。下句言天边白云，天涯之芳草，俱杳然自远者，文明徒心忆山中，身不得归，与白云、芳草俱远也。此联情景兼到。颈联上句言逢酒客以游春，亦山中事；“乍”字有偶见逢著即游之意，“惯”字有习惯之意。下句言曩在山中与林僧夜坐，于今别僧已久，夜坐只是难期。此联写景。落句言本在山中与酒客、林僧居，春与游，夜与坐，乃昨日忽闻已到城阙，得毋有意于簪弁乎？下句言若簪弁为荣，何如以荷衣为乐，只怨校书以彼物胜此物；“莫将”二字有勉之之意，盖勉其栖隐也。[站]高旷。","IsComment":false,"FullPath":"《诗式》"}]},{"Id":12204,"Allusions":[{"AllusionIndex":2224,"AllusionKey":"支遁","SentenceIndex":2},{"AllusionIndex":3624,"AllusionKey":"五柳","SentenceIndex":0},{"AllusionIndex":6923,"AllusionKey":"潜夫","SentenceIndex":3}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"过卢秦卿旧居"},"Clauses":[{"Content":"五柳茅茨楚国贤，","Comments":[{"Content":"五柳","Type":"AllusionKey","Index":2}]},{"Content":"桔槔蔬圃水涓涓。"},{"Content":"黄花寒后难逢蝶，"},{"Content":"红叶晴来忽有蝉。"},{"Content":"韩康助采君臣药，"},{"Content":"支遁同看内外篇。","Comments":[{"Content":"支遁","Type":"AllusionKey","Index":2}]},{"Content":"为问潜夫空著论，","Comments":[{"Content":"潜夫","Type":"AllusionKey","Index":4}]},{"Content":"如何侍从赋甘泉。","Comments":[{"Content":"一作何如","Type":"Text","Index":2}]}]},{"Id":12276,"Allusions":[{"AllusionIndex":1176,"AllusionKey":"童子是苍蝇","SentenceIndex":3},{"AllusionIndex":8544,"AllusionKey":"万年枝","SentenceIndex":1}],"Dynasty":"唐","Author":"司空曙","AuthorId":13632,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"酬崔峒见寄","Comments":[{"Content":"（一作江湖秋思）。（一作李嘉祐诗）","Type":"Text","Index":5}]},"Clauses":[{"Content":"趋陪禁掖雁行随，","Comments":[{"Content":"一作稀","Type":"Text","Index":7}]},{"Content":"迁放江潭鹤发垂。"},{"Content":"素浪遥疑太液水，"},{"Content":"青枫忽似万年枝。","Comments":[{"Content":"万年枝","Type":"AllusionKey","Index":7}]},{"Content":"嵩南春遍愁魂梦，","Comments":[{"Content":"一作伤","Type":"Text","Index":5}]},{"Content":"壶口云深隔路岐。","Comments":[{"Content":"一作湖","Type":"Text","Index":1}]},{"Content":"共望汉朝多沛泽，"},{"Content":"苍蝇早晚得先知。"}]}],"Count":165,"PageNo":4,"PageSize":20}