{"Authors":{"Names":["常建"],"AuthorIds":[14932],"Dynasties":["Tang"]},"ShiData":[{"Id":46501,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"侵","Rank":0,"Title":{"Content":"江上琴兴"},"Clauses":[{"Content":"江上调玉琴，"},{"Content":"一弦清一心。"},{"Content":"泠泠七弦遍，"},{"Content":"万木澄幽阴。","Comments":[{"Content":"一作音","Type":"Text","Index":5}]},{"Content":"能使江月白，"},{"Content":"又令江水深。"},{"Content":"始知梧桐枝，"},{"Content":"可以徽黄金。"}],"Comments":[{"Book":"《唐诗品汇》","Content":"刘云：等闲楚楚。","IsComment":false,"FullPath":"《唐诗品汇》"},{"Book":"《唐诗归》","Content":"钟云：深静有奇光。谭云：似水晶帘，内外洞澈，此天生诗人心手也。钟云：从何处见得？谭云：“一心”尤妙（“一弦”句下）。谭云：“能使”、“又令”，神化之言，觉相如以琴心挑之，只能动有情耳。（“能使”二句下）。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗解》","Content":"一弦足清一心，遍奏则万木改色，而月之白、江之深，咸苦琴声使之然者，其神妙乃尔邪！","IsComment":false,"FullPath":"《唐诗解》"},{"Book":"《唐诗选脉会通评林》","Content":"蒋一葵曰：松散极得趣，入深偏有情。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《此木轩论诗汇编》","Content":"自为古音，亦为东野开先。","IsComment":false,"FullPath":"《此木轩论诗汇编》"},{"Book":"《唐贤三昧集笺注》","Content":"泠泠清音，欲满人耳。一结意味尤深。","IsComment":false,"FullPath":"《唐贤三昧集笺注》"},{"Book":"《网师园唐诗笺》","Content":"妙在只写琴理，若一从琴声著笔，便多落套。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"《王闿运手批唐诗选》","Content":"清语生新，是作荇特勤。","IsComment":false,"FullPath":"《王闿运手批唐诗选》"}]},{"Id":46514,"Allusions":[{"AllusionIndex":790,"AllusionKey":"别鹤操","SentenceIndex":3},{"AllusionIndex":1629,"AllusionKey":"双鲤","SentenceIndex":3},{"AllusionIndex":7682,"AllusionKey":"仙尉","SentenceIndex":2}],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"鱼","Rank":0,"Title":{"Content":"送楚十少府"},"Clauses":[{"Content":"微风吹霜气，"},{"Content":"寒影明前除。","Comments":[{"Content":"一作流","Type":"Text","Index":3}]},{"Content":"落日未能别，"},{"Content":"萧萧林木虚。"},{"Content":"愁烟闭千里，"},{"Content":"仙尉其何如。","Comments":[{"Content":"仙尉","Type":"AllusionKey","Index":2}]},{"Content":"因送别鹤操，","Comments":[{"Content":"别鹤操","Type":"AllusionKey","Index":5}]},{"Content":"赠之双鲤鱼。","Comments":[{"Content":"双鲤","Type":"AllusionKey","Index":4}]},{"Content":"鲤鱼在金盘，"},{"Content":"别鹤哀有馀。"},{"Content":"心事则如此，"},{"Content":"请君开素书。"}],"Comments":[{"Book":"《批点唐音》","Content":"精奇古雅，正与险薄不同。","IsComment":false,"FullPath":"《批点唐音》"},{"Book":"《唐诗归》","Content":"钟云：此等诗未尝露其深厚，然直以为请灵一派不可，请参之。钟云：冷极。尤妙在题中不用出冬日字。谭云：冬景入微，非送人时不觉（首二句齐）。谭云：“虚”字妙（“萧萧”句下）。谭云：探得温柔（“愁烟”一联下）。谭云：刀斧斩绝语，偏有流风馀韵（末句下）。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗选脉会通评林》","Content":"通篇词气情理兼至。吴亮之曰：沉奥幽迥，后数语几使浅识者不能解。《唐贤清雅集》：起境微妙，渐渐说开阔去，构局极精。佳在全用兴比，境味便深厚。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"}]},{"Id":46503,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"侵","Rank":0,"Title":{"Content":"张山人弹琴"},"Clauses":[{"Content":"君去芳草绿，"},{"Content":"西峰弹玉琴。"},{"Content":"岂惟丘中赏，"},{"Content":"兼得清烦襟。"},{"Content":"朝从山口还，"},{"Content":"出岭闻清音。","Comments":[{"Content":"一作幽","Type":"Text","Index":4}]},{"Content":"了然云霞气，","Comments":[{"Content":"一作意","Type":"Text","Index":5}]},{"Content":"照见天地心。"},{"Content":"玄鹤下澄空，"},{"Content":"翩翩舞松林。"},{"Content":"改弦扣商声，","Comments":[{"Content":"一作和","Type":"Text","Index":3}]},{"Content":"又听飞龙吟。"},{"Content":"稍觉此身妄，"},{"Content":"渐知仙事深。"},{"Content":"其将鍊金鼎，"},{"Content":"永矣投吾簪。","Comments":[{"Content":"一作以","Type":"Text","Index":2}]}]},{"Id":46499,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"白湖寺后溪宿云门"},"Clauses":[{"Content":"落日山水清，"},{"Content":"乱流鸣淙淙。"},{"Content":"旧蒲雨抽节，"},{"Content":"新花水对窗。"},{"Content":"溪中日已没，"},{"Content":"归鸟多为双。"},{"Content":"杉松引直路，"},{"Content":"出谷临前湖。"},{"Content":"洲渚晚色静，"},{"Content":"又观花与蒲。"},{"Content":"入溪复登岭，"},{"Content":"草浅寒流速。"},{"Content":"圆月明高峰，"},{"Content":"春山因独宿。"},{"Content":"松阴澄初夜，"},{"Content":"曙色分远目。"},{"Content":"日出城南隅，"},{"Content":"青青媚川陆。"},{"Content":"乱花覆东郭，"},{"Content":"碧气销长林。"},{"Content":"四郊一清影，"},{"Content":"千里归寸心。"},{"Content":"前瞻王程促，","Comments":[{"Content":"一作去","Type":"Text","Index":3}]},{"Content":"却恋云门深。"},{"Content":"毕景有馀兴，"},{"Content":"到家弹玉琴。"}]},{"Id":46506,"GroupIndex":1,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"质","Rank":0,"Title":{"Content":"闲斋卧病行药至山馆稍次湖亭二首","Comments":[{"Content":"一作雨","Type":"Text","Index":4},{"Content":"一作一首","Type":"Text","Index":15}]},"Clauses":[{"Content":"旬时结阴霖，"},{"Content":"帘外初白日。"},{"Content":"斋沐清病容，"},{"Content":"心魂畏虚室。","Comments":[{"Content":"一作灵","Type":"Text","Index":4}]},{"Content":"闲梅照前户，"},{"Content":"明镜悲旧质。"},{"Content":"同袍四五人，"},{"Content":"何不来问疾。"}]},{"Id":46507,"GroupIndex":2,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"麻","Rank":0,"Title":{"Content":"闲斋卧病行药至山馆稍次湖亭二首","Comments":[{"Content":"一作雨","Type":"Text","Index":4},{"Content":"一作一首","Type":"Text","Index":15}]},"Clauses":[{"Content":"行药至石壁，"},{"Content":"东风变萌芽。"},{"Content":"主人门外绿，","Comments":[{"Content":"一作山人山门","Type":"Text","Index":4}]},{"Content":"小隐湖中花。"},{"Content":"时物堪独往，"},{"Content":"春帆宜别家。"},{"Content":"辞君向沧海，"},{"Content":"烂熳从天涯。"}],"Comments":[{"Book":"《唐诗归》","Content":"钟云：“绿”字无所指，妙，妙！","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐贤三昧集》","Content":"“行药”字甚新。","IsComment":false,"FullPath":"《唐贤三昧集》"}]},{"Id":46522,"Classes":["軍旅 邊關"],"Allusions":[{"AllusionIndex":2043,"AllusionKey":"刀头","SentenceIndex":1}],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"月","Rank":0,"Title":{"Content":"塞上曲"},"Clauses":[{"Content":"翩翩云中使，"},{"Content":"来问太原卒。"},{"Content":"百战苦不归，"},{"Content":"刀头怨明月。","Comments":[{"Content":"刀头","Type":"AllusionKey","Index":2}]},{"Content":"塞云随阵落，"},{"Content":"寒日傍城没。","Comments":[{"Content":"一作旁","Type":"Text","Index":3}]},{"Content":"城下有寡妻，"},{"Content":"哀哀哭枯骨。"}],"Comments":[{"Book":"《批点唐诗正声》","Content":"常诗短篇固佳，而气格少减，晚唐胚胎必自此始。","IsComment":false,"FullPath":"《批点唐诗正声》"},{"Book":"《唐诗解》","Content":"语意佳。","IsComment":false,"FullPath":"《唐诗解》"},{"Book":"《唐诗选脉会通评林》","Content":"吴山民曰：“塞云”一联，惨景；末二句，惨情。\n周明辅曰：气格清劲，然晚唐胚胎自此始。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"}]},{"Id":46491,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"东","Rank":0,"Title":{"Content":"仙谷遇毛女意知是秦宫人"},"Clauses":[{"Content":"溪口水石浅，"},{"Content":"泠泠明药丛。"},{"Content":"入溪双峰峻，"},{"Content":"松栝疏幽风。"},{"Content":"垂岭枝袅袅，","Comments":[{"Content":"一作竹","Type":"Text","Index":3}]},{"Content":"翳泉花濛濛。"},{"Content":"夤缘霁人目，"},{"Content":"路尽心弥通。"},{"Content":"盘石横阳崖，"},{"Content":"前流殊未穷。","Comments":[{"Content":"一作临","Type":"Text","Index":2}]},{"Content":"回潭清云影，"},{"Content":"㳽漫长天空。"},{"Content":"水边一神女，"},{"Content":"千岁为玉童。"},{"Content":"羽毛经汉代，"},{"Content":"珠翠逃秦宫。"},{"Content":"目觌神已寓，"},{"Content":"鹤飞言未终。"},{"Content":"祈君青云秘，"},{"Content":"愿谒黄仙翁。"},{"Content":"尝以耕玉田，"},{"Content":"龙鸣西顶中。"},{"Content":"金梯与天接，"},{"Content":"几日来相逢。"}]},{"Id":46518,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"文","Rank":0,"Title":{"Content":"梦太白西峰"},"Clauses":[{"Content":"梦寐升九崖，"},{"Content":"杳霭逢元君。"},{"Content":"遗我太白峰，","Comments":[{"Content":"一作岑","Type":"Text","Index":5}]},{"Content":"寥寥辞垢氛。"},{"Content":"结宇在星汉，"},{"Content":"宴林闭氤氲。"},{"Content":"檐楹覆馀翠，"},{"Content":"巾舄生片云。"},{"Content":"时往溪水间，","Comments":[{"Content":"一作谷","Type":"Text","Index":4}]},{"Content":"孤亭昼仍曛。"},{"Content":"松峰引天影，"},{"Content":"石濑清霞文。"},{"Content":"恬目缓舟趣，"},{"Content":"霁心投鸟群。"},{"Content":"春风又摇棹，"},{"Content":"潭岛花纷纷。"}],"Comments":[{"Book":"《唐诗归》","Content":"钟云：“恬目”、“霁心”四字，无此不可到山水间。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗选脉会通评林》","Content":"周珽曰：嶙峋串律，时有丹霞纷峙于心口间。方之太白《梦游天姥》，俱能空中造奇。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐贤三昧集笺注》","Content":"奇景（“檐楹”句下）。如对王摩诘《春川钓鱼图》（“春风”句下）。","IsComment":false,"FullPath":"《唐贤三昧集笺注》"}]},{"Id":46521,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"文","Rank":0,"Title":{"Content":"鄂渚招王昌龄张偾"},"Clauses":[{"Content":"刈芦旷野中，"},{"Content":"沙土飞黄云。","Comments":[{"Content":"一作上","Type":"Text","Index":2}]},{"Content":"天晦无精光，"},{"Content":"茫茫悲远君。"},{"Content":"楚山隔湘水，"},{"Content":"湖畔落日曛。"},{"Content":"春雁又北飞，"},{"Content":"音书固难闻。"},{"Content":"谪居未为叹，"},{"Content":"谗枉何由分。"},{"Content":"午日逐蛟龙，","Comments":[{"Content":"一作蛇","Type":"Text","Index":4}]},{"Content":"宜为吊冤文。"},{"Content":"翻覆古共然，"},{"Content":"名宦安足云。","Comments":[{"Content":"一作官","Type":"Text","Index":1}]},{"Content":"贫士任枯槁，"},{"Content":"捕鱼清江濆。"},{"Content":"有时荷锄犁，"},{"Content":"旷野自耕耘。"},{"Content":"不然春山隐，"},{"Content":"溪涧花氤氲。","Comments":[{"Content":"一作何","Type":"Text","Index":3}]},{"Content":"山鹿自有场，"},{"Content":"贤达亦顾群。"},{"Content":"二贤归去来，"},{"Content":"世上徒纷纷。"}]},{"Id":46511,"GroupIndex":1,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"支","Rank":0,"Title":{"Content":"春词二首","Comments":[{"Content":"《乐府》诗题作《陌上桑》，一本连后阶下草犹短一首共作三首。","Type":"Text","Index":4}]},"Clauses":[{"Content":"菀菀黄柳丝，"},{"Content":"濛濛杂花垂。"},{"Content":"日高红妆卧，"},{"Content":"倚对春光迟。","Comments":[{"Content":"一作树","Type":"Text","Index":2},{"Content":"一作风","Type":"Text","Index":4}]},{"Content":"宁知傍淇水，"},{"Content":"騕袅黄金羁。"}]},{"Id":46512,"GroupIndex":2,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"阳","Rank":0,"Title":{"Content":"春词二首","Comments":[{"Content":"《乐府》诗题作《陌上桑》，一本连后阶下草犹短一首共作三首。","Type":"Text","Index":4}]},"Clauses":[{"Content":"翳翳陌上桑，"},{"Content":"南枝交北堂。"},{"Content":"美人金梯出，"},{"Content":"素手自提筐。"},{"Content":"非但畏蚕饥，","Comments":[{"Content":"一作为","Type":"Text","Index":3}]},{"Content":"盈盈娇路傍。"}]},{"Id":46517,"Allusions":[{"AllusionIndex":923,"AllusionKey":"沧浪","SentenceIndex":5}],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"侵","Rank":0,"Title":{"Content":"晦日马镫曲稍次中流作"},"Clauses":[{"Content":"夜寒宿芦苇，"},{"Content":"晓色明西林。"},{"Content":"初日在川上，"},{"Content":"便澄游子心。"},{"Content":"秦天无纤翳，","Comments":[{"Content":"一作晴","Type":"Text","Index":1}]},{"Content":"郊野浮春阴。"},{"Content":"波静随钓鱼，"},{"Content":"舟小绿水深。"},{"Content":"出浦见千里，"},{"Content":"旷然谐远寻。"},{"Content":"扣船应渔父，"},{"Content":"因唱沧浪吟。","Comments":[{"Content":"一作同","Type":"Text","Index":1},{"Content":"沧浪","Type":"AllusionKey","Index":4}]}]},{"Id":46495,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"遇","Rank":0,"Title":{"Content":"古意","Comments":[{"Content":"一本连后古意三首，共作四首","Type":"Text","Index":2}]},"Clauses":[{"Content":"牧马古道傍，"},{"Content":"道傍多古墓。"},{"Content":"萧条愁杀人，"},{"Content":"蝉鸣白杨树。"},{"Content":"回头望京邑，"},{"Content":"合沓生尘雾。"},{"Content":"富贵安可常，"},{"Content":"归来保贞素。"}]},{"Id":46516,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"宿五度溪仙人得道处"},"Clauses":[{"Content":"五度溪上花，"},{"Content":"生根依两崖。"},{"Content":"二月寻片云，"},{"Content":"愿宿秦人家。"},{"Content":"上见悬崖崩，"},{"Content":"下见白水湍。"},{"Content":"仙人弹棋处，"},{"Content":"石上青萝盘。"},{"Content":"无处求玉童，"},{"Content":"翳翳唯林峦。"},{"Content":"前溪遇新月，"},{"Content":"聊取玉琴弹。"}]},{"Id":46502,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"霁","Rank":0,"Title":{"Content":"西山"},"Clauses":[{"Content":"一身为轻舟，"},{"Content":"落日西山际。"},{"Content":"常随去帆影，"},{"Content":"远接长天势。"},{"Content":"物象归馀清，"},{"Content":"林峦分夕丽。"},{"Content":"亭亭碧流暗，"},{"Content":"日入孤霞继。"},{"Content":"渚日远阴映，"},{"Content":"湖云尚明霁。"},{"Content":"林昏楚色来，"},{"Content":"岸远荆门闭。"},{"Content":"至夜转清迥，"},{"Content":"萧萧北风厉。"},{"Content":"沙边雁鹭泊，"},{"Content":"宿处蒹葭蔽。"},{"Content":"圆月逗前浦，"},{"Content":"孤琴又摇曳。"},{"Content":"泠然夜遂深，"},{"Content":"白露沾人袂。"}],"Comments":[{"Book":"《唐诗直解》","Content":"此诗置谢康乐集中，不露苍白。平铺直叙，自是出世语。","IsComment":false,"FullPath":"《唐诗直解》"},{"Book":"《唐诗镜》","Content":"霁色清音。","IsComment":false,"FullPath":"《唐诗镜》"},{"Book":"《唐诗归》","Content":"钟云：于鳞知取此作，而遗前后数首，何也？乃知未得此首之趣，从众收之耳。谭云：“一身为轻舟”，妙在“为”字，用“如”字则肤矣。\n谭云：又妙在“归”字，在“馀”字（“物象”句下）谭云：孤霞凑趣，若灯烛则败兴矣（“日入”句下）。谭云：“至夜”接得老。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗选脉会通评林》","Content":"黄家鼎曰：清绝，无烟火气。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗归折衷》","Content":"唐云：据钟所选诸首，终是此首清绝，馀未免有烟火气。","IsComment":false,"FullPath":"《唐诗归折衷》"},{"Book":"《唐贤三昧集笺注》","Content":"雄丽宕逸可爱。奇笔（“远接”句下）。","IsComment":false,"FullPath":"《唐贤三昧集笺注》"},{"Book":"《古唐诗合解》","Content":"是诗平铺直叙，自见清澈。","IsComment":false,"FullPath":"《古唐诗合解》"},{"Book":"《唐诗别裁》","Content":"步骤谢公。此夜泊西山之作。“一身为轻舟”，言独身泛舟，身犹舟也。","IsComment":false,"FullPath":"《唐诗别裁》"}]},{"Id":46510,"Allusions":[{"AllusionIndex":7410,"AllusionKey":"青鸟","SentenceIndex":2}],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"陌","Rank":0,"Title":{"Content":"春词"},"Clauses":[{"Content":"阶下草犹短，"},{"Content":"墙头梨花白。"},{"Content":"织女高楼上，"},{"Content":"停梭顾行客。"},{"Content":"问君在何所，"},{"Content":"青鸟舒锦翮。","Comments":[{"Content":"青鸟","Type":"AllusionKey","Index":2}]}]},{"Id":46524,"Allusions":[{"AllusionIndex":10662,"AllusionKey":"枳棘林","SentenceIndex":6}],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"寒","Rank":0,"Title":{"Content":"赠三侍御"},"Clauses":[{"Content":"高山临大泽，"},{"Content":"正月芦花乾。"},{"Content":"阳色薰两崖，"},{"Content":"不改青松寒。"},{"Content":"士贤守孤贞，"},{"Content":"古来皆共难。"},{"Content":"明君错甚才，","Comments":[{"Content":"一作任","Type":"Text","Index":4}]},{"Content":"台上飞三鸾。"},{"Content":"操与霜雪明，"},{"Content":"量与江海宽。"},{"Content":"束身视天涯，"},{"Content":"安能穷波澜。"},{"Content":"孤鹤在枳棘，"},{"Content":"一枝非所安。"},{"Content":"逸翮望绝霄，"},{"Content":"见欲凌云端。"},{"Content":"层台何其高，"},{"Content":"山石流洪湍。"},{"Content":"固知非天池，"},{"Content":"鸣跃同所欢。"},{"Content":"谁念独枯槁，"},{"Content":"四十长江干。"},{"Content":"责躬贵知己，"},{"Content":"效拙从一官。"},{"Content":"折翮悲高风，"},{"Content":"苦饥候朝餐。"},{"Content":"湖月映大海，"},{"Content":"天空何漫漫。"},{"Content":"托身未知所，"},{"Content":"谋道庶不刊。"},{"Content":"吟彼乔木诗，"},{"Content":"一夕常三叹。"}]},{"Id":46520,"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"冬","Rank":0,"Title":{"Content":"第三峰"},"Clauses":[{"Content":"西山第三顶，"},{"Content":"茅宇依双松。"},{"Content":"杳杳欲至天，"},{"Content":"云梯升几重。"},{"Content":"莹魄澄玉虚，"},{"Content":"以求鸾鹤踪。"},{"Content":"逶迤非天人，"},{"Content":"执节乘赤龙。"},{"Content":"旁映白日光，"},{"Content":"缥缈轻霞容。"},{"Content":"孤辉上烟雾，"},{"Content":"馀影明心胸。"},{"Content":"愿与黄麒麟，"},{"Content":"欲飞而莫从。"},{"Content":"因寂清万象，"},{"Content":"轻云自中峰。"},{"Content":"山暝学栖鸟，"},{"Content":"月来随暗蛬。"},{"Content":"寻空静馀响，"},{"Content":"袅袅云溪钟。"}]},{"Id":46493,"Classes":["軍旅 感懷"],"Dynasty":"唐","Author":"常建","AuthorId":14932,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"支","Rank":0,"Title":{"Content":"古兴"},"Clauses":[{"Content":"汉上逢老翁，"},{"Content":"江口为僵尸。"},{"Content":"白发沾黄泥，"},{"Content":"遗骸集乌鸱。"},{"Content":"机巧自此忘，"},{"Content":"精魄今何之。"},{"Content":"风吹钓竿折，"},{"Content":"鱼跃安能施。"},{"Content":"白水明汀洲，"},{"Content":"菰蒲冒深陂。"},{"Content":"唯留扁舟影，"},{"Content":"系在长江湄。"},{"Content":"突兀枯松枝，"},{"Content":"悠扬女萝丝。"},{"Content":"托身难凭依，"},{"Content":"生死焉相知。"},{"Content":"遍观今时人，"},{"Content":"举世皆尔为。"},{"Content":"将军死重围，"},{"Content":"汉卒犹争驰。"},{"Content":"百马同一衔，"},{"Content":"万轮同一规。"},{"Content":"名与身孰亲，"},{"Content":"君子宜固思。"}]}],"Count":55,"PageNo":1,"PageSize":20}