{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11374,"Allusions":[{"AllusionIndex":3265,"AllusionKey":"照胆清","SentenceIndex":1},{"AllusionIndex":9727,"AllusionKey":"瑶池","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"排律","TypeDetail":"WuPai","Rhyme":"庚","Rank":0,"Title":{"Content":"清如玉壶冰"},"Clauses":[{"Content":"玉壶冰始结，"},{"Content":"循吏政初成。"},{"Content":"既有虚心鉴，"},{"Content":"还如照胆清。","Comments":[{"Content":"照胆清","Type":"AllusionKey","Index":5}]},{"Content":"瑶池惭洞澈，","Comments":[{"Content":"瑶池","Type":"AllusionKey","Index":2}]},{"Content":"金镜让澄明。"},{"Content":"气若朝霜动，"},{"Content":"形随夜月盈。"},{"Content":"临人能不蔽，"},{"Content":"待物本无情。"},{"Content":"怯对圆光裹，"},{"Content":"妍蚩自此呈。","Comments":[{"Content":"一作生","Type":"Text","Index":5}]}]},{"Id":11405,"Allusions":[{"AllusionIndex":733,"AllusionKey":"桃源客","SentenceIndex":21}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"送吉中孚校书归楚州旧山","Comments":[{"Content":"中孚自仙官入仕","Type":"Text","Index":11}]},"Clauses":[{"Content":"青袍芸阁郎，"},{"Content":"谈笑挹侯王。"},{"Content":"旧箓藏云穴，"},{"Content":"新诗满帝乡。"},{"Content":"名高闲不得，"},{"Content":"到处人争识。"},{"Content":"谁知冰雪颜，"},{"Content":"已杂风尘色。"},{"Content":"此去复如何，"},{"Content":"东皋岐路多。"},{"Content":"藉芳临紫陌，","Comments":[{"Content":"一作茅","Type":"Text","Index":2}]},{"Content":"回首忆沧波。","Comments":[{"Content":"一作望","Type":"Text","Index":3}]},{"Content":"年来倦萧索，"},{"Content":"但说淮南乐。"},{"Content":"并楫湖上游，","Comments":[{"Content":"一作中","Type":"Text","Index":4}]},{"Content":"连樯月中泊。","Comments":[{"Content":"一作下","Type":"Text","Index":4}]},{"Content":"沿溜入阊门，","Comments":[{"Content":"一作流","Type":"Text","Index":2},{"Content":"一作闾，一作阁","Type":"Text","Index":4}]},{"Content":"千灯夜市喧。"},{"Content":"喜逢邻舍伴，"},{"Content":"遥语问乡园。"},{"Content":"下淮风自急，"},{"Content":"树杪分郊邑。"},{"Content":"送客随岸行，"},{"Content":"离人出帆立。","Comments":[{"Content":"一作船","Type":"Text","Index":4}]},{"Content":"渔村绕水田，"},{"Content":"澹澹隔晴烟。","Comments":[{"Content":"一作浦","Type":"Text","Index":2}]},{"Content":"欲就林中醉，"},{"Content":"先期石上眠。"},{"Content":"林昏天未曙，"},{"Content":"但向云边去。"},{"Content":"暗入无路山，"},{"Content":"心知有花处。"},{"Content":"登高日转明，"},{"Content":"下望见春城。"},{"Content":"洞里草空长，"},{"Content":"冢边人自耕。"},{"Content":"寥寥行异境，"},{"Content":"过尽千峰影。"},{"Content":"露色凝古坛，"},{"Content":"泉声落寒井。"},{"Content":"仙成不可期，"},{"Content":"多别自堪悲。"},{"Content":"为问桃源客，","Comments":[{"Content":"桃源客","Type":"AllusionKey","Index":5}]},{"Content":"何人见乱时。","Comments":[{"Content":"一本此篇分作绝句十一首","Type":"Text","Index":5}]}],"Comments":[{"Book":"《唐诗归》","Content":"钟云：只写景到极象处，情便难堪。谭云：别情说向幽景上去，情更深。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗选脉会通评林》","Content":"周珽曰：第三句顶上二句，总指送别时事言。末句写出旧山可归之趣，调法新爽（“林昏”四句下）。唐汝询曰：索漠中出此玄想，亦送别妙境。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《石园诗话》","Content":"“名高闲不得，到处人争识”，名士出门，大都如是。接云“谁知冰雪颜，已杂风尘色”两句，又无限感叹矣。","IsComment":false,"FullPath":"《石园诗话》"}]},{"Id":11404,"Allusions":[{"AllusionIndex":2700,"AllusionKey":"小阮","SentenceIndex":7}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"送从叔牧永州"},"Clauses":[{"Content":"五侯轩盖行何疾，"},{"Content":"零陵太守登车日。"},{"Content":"零陵太守泪盈巾，"},{"Content":"此日长安方欲春。"},{"Content":"虎符龙节照岐路，"},{"Content":"何苦愁为江海人。"},{"Content":"彼方韶景无时节，"},{"Content":"山水诸花恣开发。"},{"Content":"客投津戍少闻猿，"},{"Content":"雁过潇湘更逢雪。"},{"Content":"郡斋无事好闲眠，"},{"Content":"粳稻油油绿满川。"},{"Content":"浪里争迎三蜀货，"},{"Content":"月中喧泊九江船。"},{"Content":"今朝小阮同夷老，","Comments":[{"Content":"小阮","Type":"AllusionKey","Index":4}]},{"Content":"欲闻明年借几年。","Comments":[{"Content":"一作君","Type":"Text","Index":4}]}]},{"Id":11415,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"敩颜鲁公送挺赟归翠微寺"},"Clauses":[{"Content":"挺赟惠学该儒释，"},{"Content":"袖有颜徐真草迹。"},{"Content":"一斋三请纪行诗，"},{"Content":"诮我垂鞭弄鸣镝。"},{"Content":"寺悬金榜半山隅，"},{"Content":"石路荒凉松树枯。"},{"Content":"虎迹印雪大如斗，"},{"Content":"闰月暮天过得无。"}]},{"Id":11420,"Allusions":[{"AllusionIndex":3048,"AllusionKey":"凤雏","SentenceIndex":2}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"职","Rank":0,"Title":{"Content":"颜侍御厅丛篁咏送薛存诚"},"Clauses":[{"Content":"玉干百馀茎，"},{"Content":"生君此堂侧。"},{"Content":"拂帘寒雨响，"},{"Content":"拥砌深溪色。"},{"Content":"何事凤皇雏，"},{"Content":"兹焉理归翼。"}]},{"Id":11407,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"歌","Rank":0,"Title":{"Content":"送畅当"},"Clauses":[{"Content":"四望无极路，"},{"Content":"千里流大河。"},{"Content":"秋风满离袂，"},{"Content":"唯老事唯多。"}]},{"Id":11408,"Classes":["軍旅 將帥","軍旅 送行"],"Allusions":[{"AllusionIndex":2306,"AllusionKey":"地仙","SentenceIndex":11},{"AllusionIndex":5522,"AllusionKey":"李将军","SentenceIndex":2},{"AllusionIndex":1451,"AllusionKey":"曼倩","SentenceIndex":12}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"送饯从叔辞丰州幕归嵩阳旧居"},"Clauses":[{"Content":"白须宗孙侍坐时，"},{"Content":"愿持寿酒前致词。"},{"Content":"鄙词何所拟，"},{"Content":"请自边城始。"},{"Content":"边城贵者李将军，","Comments":[{"Content":"李将军","Type":"AllusionKey","Index":7}]},{"Content":"战鼓遥疑天上闻。"},{"Content":"屯田布锦周千里，"},{"Content":"牧马攒花溢万群。"},{"Content":"白云本是乔松伴，"},{"Content":"来绕青营复飞散。"},{"Content":"三声画角咽不通，"},{"Content":"万里蓬根一时断。"},{"Content":"丰州闻说似凉州，"},{"Content":"沙塞晴明部落稠。"},{"Content":"行客已去依独戍，"},{"Content":"主人犹自在高楼。"},{"Content":"梦亲旌旆何由见，"},{"Content":"每阻清风一回面。","Comments":[{"Content":"一作值","Type":"Text","Index":2}]},{"Content":"洞里先生那怪迟，"},{"Content":"人天无路自无期。"},{"Content":"砂泉丹井非同味，"},{"Content":"桂树榆林不并枝。"},{"Content":"吾翁致身殊得计，"},{"Content":"地仙亦是三千岁。","Comments":[{"Content":"地仙","Type":"AllusionKey","Index":2}]},{"Content":"莫著戎衣期上清，"},{"Content":"东方曼倩逢人轻。","Comments":[{"Content":"曼倩","Type":"AllusionKey","Index":4}]}]},{"Id":11387,"GroupIndex":1,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"侵","Rank":0,"Title":{"Content":"同吉中孚梦桃源"},"Clauses":[{"Content":"春雨夜不散，"},{"Content":"梦中山亦阴。"},{"Content":"云中碧潭水，"},{"Content":"路暗红花林。"},{"Content":"花水自深浅，"},{"Content":"无人知古今。"}],"Comments":[{"Book":"《唐诗归》","Content":"钟云：只六句，境、趣、理俱在内，而皆指不出，妙至于此。又云：十字浑沦，无处可入（末二句下）。","IsComment":false,"FullPath":"《唐诗归》"},{"Book":"《唐诗归折衷》","Content":"唐云：钟但爱其不说明耳，细味之，实无深想。","IsComment":false,"FullPath":"《唐诗归折衷》"},{"Book":"《唐诗选脉会通评林》","Content":"周珽曰：“云中”二语，写梦境入微。“花水”二语，写梦情超异。桃花源事，原属幻景；梦桃源中，幻中之幻。子安《梦游仙》、常建《梦太白峰》、青莲《梦游天姥》，各极变幻、摹写之妙；而此寥寥数语，景物幽美，兴致慨切，简秀清远，幻化高华：何初、盛、中之有分也！","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐诗快》","Content":"此三十字足抵渊明一篇诗纪矣。末二句尤妙在似梦中语。","IsComment":false,"FullPath":"《唐诗快》"},{"Book":"《古唐诗合解》","Content":"命题固奇，诗意亦奥。后二语浑沦，令人莫测。","IsComment":false,"FullPath":"《古唐诗合解》"}]},{"Id":11388,"GroupIndex":2,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"陌","Rank":0,"Title":{"Content":"同吉中孚梦桃源"},"Clauses":[{"Content":"夜静春梦长，"},{"Content":"梦逐仙山客。"},{"Content":"园林满芝朮，"},{"Content":"鸡犬傍篱栅。"},{"Content":"几处花下人，"},{"Content":"看予笑头白。"}]},{"Id":11392,"Allusions":[{"AllusionIndex":712,"AllusionKey":"倚刃","SentenceIndex":46},{"AllusionIndex":1022,"AllusionKey":"十上","SentenceIndex":14},{"AllusionIndex":1328,"AllusionKey":"曳长裾","SentenceIndex":44},{"AllusionIndex":4617,"AllusionKey":"建瓴","SentenceIndex":33},{"AllusionIndex":4836,"AllusionKey":"金谷","SentenceIndex":45},{"AllusionIndex":6900,"AllusionKey":"一顾","SentenceIndex":29},{"AllusionIndex":8302,"AllusionKey":"天高听卑","SentenceIndex":47},{"AllusionIndex":8364,"AllusionKey":"天柱","SentenceIndex":27},{"AllusionIndex":9738,"AllusionKey":"瑶台","SentenceIndex":45}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"20","Rank":0,"Title":{"Content":"纶与吉侍郎中孚司空郎中曙苗员外发崔补阙峒耿拾遗湋李校书端风尘追游向三十载数公皆负当时盛称荣耀未几俱沈下泉畅博士当感怀前踪有五十韵见寄辄有所詶以申悲旧兼寄夏侯侍御审侯仓曹钊","Comments":[{"Content":"一作郎","Type":"Text","Index":80}]},"Clauses":[{"Content":"禀命孤且贱，"},{"Content":"少为病所婴。"},{"Content":"八岁始读书，"},{"Content":"四方遂有兵。"},{"Content":"童心幸不羁，"},{"Content":"此去负平生。"},{"Content":"是月胡入洛，"},{"Content":"明年天陨星。"},{"Content":"夜行登灞陵，"},{"Content":"惝恍靡所征。"},{"Content":"云海一翻荡，"},{"Content":"鱼龙俱不宁。"},{"Content":"因浮襄江流，"},{"Content":"远寄鄱阳城。"},{"Content":"鄱阳富学徒，"},{"Content":"诮我戆无营。"},{"Content":"谕以诗礼义，"},{"Content":"勖随宾荐名。"},{"Content":"舟车更滞留，"},{"Content":"水陆互阴晴。"},{"Content":"晓望怯云阵，"},{"Content":"夜愁惊鹤声。"},{"Content":"凄凄指宋郊，"},{"Content":"浩浩入秦京。"},{"Content":"沴气既风散，"},{"Content":"皇威如日明。"},{"Content":"方逢粟比金，"},{"Content":"未识公与卿。"},{"Content":"十上不可待，","Comments":[{"Content":"十上","Type":"AllusionKey","Index":2}]},{"Content":"三年竟无成。"},{"Content":"偶为达者知，"},{"Content":"扬我于王廷。"},{"Content":"素志且不立，"},{"Content":"青袍徒见萦。"},{"Content":"昏孱夙自保，"},{"Content":"静躁本殊形。"},{"Content":"始趋甘棠阴，"},{"Content":"旋遇密人迎。"},{"Content":"考实绩无取，"},{"Content":"责能才固轻。"},{"Content":"新丰古离宫，"},{"Content":"宫树锁云扃。"},{"Content":"中复莅兹邑，"},{"Content":"往惟曾所经。"},{"Content":"缭垣何逶迤，"},{"Content":"水殿亦峥嵘。"},{"Content":"夜雨滴金砌，"},{"Content":"阴风吹玉楹。"},{"Content":"官曹虽检率，"},{"Content":"国步日夷平。"},{"Content":"命蹇固安分，"},{"Content":"祸来非有萌。"},{"Content":"因逢骇浪飘，"},{"Content":"几落无辜刑。"},{"Content":"巍巍登坛臣，"},{"Content":"独正天柱倾。","Comments":[{"Content":"天柱","Type":"AllusionKey","Index":4}]},{"Content":"悄悄失途子，"},{"Content":"分将秋草并。"},{"Content":"百年甘守素，"},{"Content":"一顾乃拾青。","Comments":[{"Content":"一顾","Type":"AllusionKey","Index":2}]},{"Content":"相逢十月交，"},{"Content":"众卉飘已零。"},{"Content":"感旧谅戚戚，"},{"Content":"问孤恳茕茕。"},{"Content":"侍郎文章宗，"},{"Content":"杰出淮楚灵。"},{"Content":"掌赋若吹籁，"},{"Content":"司言如建瓴。","Comments":[{"Content":"建瓴","Type":"AllusionKey","Index":5}]},{"Content":"郎中善馀庆，"},{"Content":"雅韵与琴清。"},{"Content":"郁郁松带雪，"},{"Content":"萧萧鸿入冥。"},{"Content":"员外真贵儒，"},{"Content":"弱冠被华缨。"},{"Content":"月香飘桂实，"},{"Content":"乳溜滴琼英。"},{"Content":"补阙思冲融，"},{"Content":"巾拂艺亦精。","Comments":[{"Content":"一作六艺亦精明","Type":"Text","Index":5}]},{"Content":"䌽蝶戏芳圃，"},{"Content":"瑞云凝翠屏。","Comments":[{"Content":"一作滋","Type":"Text","Index":3}]},{"Content":"拾遗兴难侔，"},{"Content":"逸调旷无程。"},{"Content":"九酝贮弥洁，"},{"Content":"三花寒转馨。"},{"Content":"校书才智雄，"},{"Content":"举世一娉婷。"},{"Content":"赌墅鬼神变，"},{"Content":"属词鸾凤惊。"},{"Content":"差肩曳长裾，","Comments":[{"Content":"曳长裾","Type":"AllusionKey","Index":5}]},{"Content":"总辔奉和铃。"},{"Content":"共赋瑶台雪，","Comments":[{"Content":"瑶台","Type":"AllusionKey","Index":4}]},{"Content":"同观金谷筝。","Comments":[{"Content":"一作笙","Type":"Text","Index":5},{"Content":"金谷","Type":"AllusionKey","Index":4}]},{"Content":"倚天方比剑，"},{"Content":"沈井忽如瓶。","Comments":[{"Content":"一作水","Type":"Text","Index":2}]},{"Content":"神昧不可问，"},{"Content":"天高莫尔听。"},{"Content":"君持玉盘珠，"},{"Content":"泻我怀袖盈。"},{"Content":"读罢涕交颐，"},{"Content":"愿言跻百龄。"}]},{"Id":11394,"Allusions":[{"AllusionIndex":245,"AllusionKey":"营蝇","SentenceIndex":-1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"和赵给事白蝇拂歌"},"Clauses":[{"Content":"华堂多众珍，"},{"Content":"白拂称殊异。"},{"Content":"柄裁沈节香袭人，"},{"Content":"上结为文下垂穗。"},{"Content":"霜缕霏微莹且柔，"},{"Content":"虎须乍细龙髯稠。"},{"Content":"皎然素色不因染，"},{"Content":"淅尔凉风非为秋。"},{"Content":"群蝇青苍恣游息，"},{"Content":"广庖万品无颜色。"},{"Content":"金屏成点玉成瑕，"},{"Content":"昼眠宛转空咨嗟。"},{"Content":"此时满筵看一举，"},{"Content":"荻花忽旋杨花舞。"},{"Content":"砉如寒隼惊暮禽，"},{"Content":"飒若繁埃得轻雨。"},{"Content":"主人说是故人留，"},{"Content":"每诫如新比白头。"},{"Content":"若将挥玩闲临水，"},{"Content":"愿接波中一白鸥。"}]},{"Id":11413,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"萧常侍瘿柏亭歌"},"Clauses":[{"Content":"柏之异者山中灵，"},{"Content":"何人断绝为君亭。"},{"Content":"云翻浪卷不可识，"},{"Content":"鸟兽成形花倒植。"},{"Content":"莓苔旧点色尚青，"},{"Content":"霹雳残痕节犹黑。"},{"Content":"金貂主人汉三老，"},{"Content":"构此穷年下朝早。"},{"Content":"心规目制不暂疲，"},{"Content":"匠者受之无一词。"},{"Content":"清晨拂匣菱生镜，"},{"Content":"落日凭阑星满池。"},{"Content":"攒甍斗拱无斤迹，"},{"Content":"根瘿联悬同素壁。"},{"Content":"数层乱泻云里峰，"},{"Content":"万片争呈雪中石。"},{"Content":"重帘不动自飘香，"},{"Content":"似到瀛洲白玉堂。","Comments":[{"Content":"一作雪","Type":"Text","Index":6}]},{"Content":"水精如意刁金色，","Comments":[{"Content":"一作方同，一作方含","Type":"Text","Index":6}]},{"Content":"云母屏风透掩光。","Comments":[{"Content":"一作遂","Type":"Text","Index":5}]},{"Content":"四阶绵绵被纤草，"},{"Content":"草上依微众山道。"},{"Content":"松间汲井烟翠寒，"},{"Content":"洞里围棋天景好。"},{"Content":"愚儒敢欲贺成功，"},{"Content":"鸾凤栖翔固不同。"},{"Content":"应念废材今接地，"},{"Content":"一枝思寄户庭中。"}]},{"Id":11419,"Allusions":[{"AllusionIndex":827,"AllusionKey":"鲛人","SentenceIndex":1},{"AllusionIndex":6081,"AllusionKey":"鸾鹤","SentenceIndex":4}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"慈恩寺石磬歌"},"Clauses":[{"Content":"灵山石磬生海西，"},{"Content":"海涛平处与山齐。","Comments":[{"Content":"一作波","Type":"Text","Index":1}]},{"Content":"长眉老僧同佛力，"},{"Content":"咒使鲛人往求得。","Comments":[{"Content":"鲛人","Type":"AllusionKey","Index":4}]},{"Content":"珠穴沈成绿浪痕，"},{"Content":"天衣拂尽苍苔色。"},{"Content":"星汉徘徊山有风，"},{"Content":"禅翁静扣月明中。"},{"Content":"群仙下云龙出水，"},{"Content":"鸾鹤交飞半空里。","Comments":[{"Content":"鸾鹤","Type":"AllusionKey","Index":2}]},{"Content":"山精木魅不可听，","Comments":[{"Content":"一作城","Type":"Text","Index":1}]},{"Content":"落叶秋砧一时起。"},{"Content":"花宫杳杳响泠泠，","Comments":[{"Content":"一作梵宫香散","Type":"Text","Index":4}]},{"Content":"无数沙门昏梦醒。"},{"Content":"古廊灯下见行道，"},{"Content":"疏林池边闻诵经。","Comments":[{"Content":"一作柳","Type":"Text","Index":2}]},{"Content":"徒壮洪钟秘高阁，","Comments":[{"Content":"一作使","Type":"Text","Index":2}]},{"Content":"万金费尽工雕凿。"},{"Content":"岂如全质挂青松，"},{"Content":"数叶残云一片峰。"},{"Content":"吾师宝之寿中国，"},{"Content":"愿同劫石无终极。"}]},{"Id":11406,"Classes":["軍旅 送行"],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"送张郎中还蜀歌"},"Clauses":[{"Content":"秦家御史汉家郎，"},{"Content":"亲专两印征殊方。"},{"Content":"功成走马朝天子，"},{"Content":"伏槛论边若流水。","Comments":[{"Content":"一作谈","Type":"Text","Index":3}]},{"Content":"晓离仙署趋紫微，"},{"Content":"夜接高儒读青史。"},{"Content":"泸南五将望君还，"},{"Content":"愿以天书示百蛮。"},{"Content":"曲栈重江初过雨，"},{"Content":"前旌后骑不同山。"},{"Content":"迎车拜舞多耆老，"},{"Content":"旧卒新营遍青草。"},{"Content":"塞口云生火候迟，"},{"Content":"烟中鹤唳军行早。"},{"Content":"黄花川下水交横，"},{"Content":"远映孤霞蜀国晴。","Comments":[{"Content":"一作雁","Type":"Text","Index":2}]},{"Content":"邛竹笋长椒瘴起，"},{"Content":"荔枝花发杜鹃鸣。"},{"Content":"回首岷峨半天黑，"},{"Content":"传觞接膝何由得。"},{"Content":"空令豪士仰威名，"},{"Content":"无复贫交恃颜色。"},{"Content":"垂杨不动雨纷纷，"},{"Content":"锦帐胡瓶争送君。"},{"Content":"须臾醉起箫笳发，"},{"Content":"空见红旌入白云。","Comments":[{"Content":"一作双","Type":"Text","Index":3},{"Content":"一作塞","Type":"Text","Index":6}]}]},{"Id":11410,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"宴席赋得姚美人拍筝歌","Comments":[{"Content":"美人曾在禁中","Type":"Text","Index":10}]},"Clauses":[{"Content":"出帘仍有钿筝随，"},{"Content":"见罢翻令恨识迟。"},{"Content":"微收皓腕缠红袖，"},{"Content":"深遏朱弦低翠眉。"},{"Content":"忽然高张应繁节，","Comments":[{"Content":"一作疏","Type":"Text","Index":6}]},{"Content":"玉指回旋若飞雪。"},{"Content":"凤箫韶管寂不喧，","Comments":[{"Content":"一作龙","Type":"Text","Index":3}]},{"Content":"绣幕纱窗俨秋月。"},{"Content":"有时轻弄和郎歌，"},{"Content":"慢处声迟情更多。"},{"Content":"已愁红脸能佯醉，"},{"Content":"又恐朱门难再过。"},{"Content":"昭阳伴里最聪明，","Comments":[{"Content":"一作宫","Type":"Text","Index":3}]},{"Content":"出到人间才长成。"},{"Content":"遥知禁曲难翻处，"},{"Content":"犹是君王说小名。"}],"Comments":[{"Book":"《大历诗略》","Content":"其纤丽元人能之，恐之此矜贵也。唐人擅场在此，只六朝乐府烂熟耳。","IsComment":false,"FullPath":"《大历诗略》"}]},{"Id":11393,"Allusions":[{"AllusionIndex":243,"AllusionKey":"白笔","SentenceIndex":4}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"陈翃郎中北亭送侯钊侍御赋得带冰流歌","Comments":[{"Content":"一作送刘侍御","Type":"Text","Index":11}]},"Clauses":[{"Content":"溪中鸟鸣春景旦，"},{"Content":"一派寒冰忽开散。"},{"Content":"璧方镜员流不断，"},{"Content":"白云鳞鳞满河汉。"},{"Content":"叠处浅，"},{"Content":"旋处深。"},{"Content":"撇捩寒鱼上复沈，"},{"Content":"群鹅鼓舞扬清音。"},{"Content":"主人有客簪白笔，","Comments":[{"Content":"白笔","Type":"AllusionKey","Index":7}]},{"Content":"玉壶贮水光如一。"},{"Content":"持此赠君君饮之，"},{"Content":"圣君识君冰玉姿。"}]},{"Id":11411,"Allusions":[{"AllusionIndex":9826,"AllusionKey":"一抔土","SentenceIndex":4}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"栖岩寺隋文帝马脑盏歌"},"Clauses":[{"Content":"天宫宝器隋朝物，"},{"Content":"锁在金函比金骨。"},{"Content":"开函捧之光乃发，"},{"Content":"阿修罗王掌中月。"},{"Content":"五云如拳轻复浓，"},{"Content":"昔曾噀酒今藏龙。"},{"Content":"规形环影相透彻，"},{"Content":"乱雪繁花千万重。"},{"Content":"可怜贞质无今古，"},{"Content":"可叹隋陵一抔土。","Comments":[{"Content":"一抔土","Type":"AllusionKey","Index":7}]},{"Content":"宫中艳女满宫春，"},{"Content":"得亲此宝能几人。"},{"Content":"一留寒殿殿将坏，"},{"Content":"唯有幽光通隙尘。"},{"Content":"山中老僧眉似雪，"},{"Content":"忍死相传保扃鐍。"}]},{"Id":11412,"Allusions":[{"AllusionIndex":514,"AllusionKey":"蛟龙子","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"难绾刀子歌"},"Clauses":[{"Content":"黄金鞘里青芦叶，"},{"Content":"丽若剪成铦且翣。","Comments":[{"Content":"一作捷","Type":"Text","Index":7}]},{"Content":"轻冰薄玉状不分，"},{"Content":"一尺寒光堪决云。"},{"Content":"吹毛可试不可触，"},{"Content":"似有虫搜阙裂文。"},{"Content":"淬之几堕前池水，"},{"Content":"焉知不是蛟龙子。","Comments":[{"Content":"蛟龙子","Type":"AllusionKey","Index":7}]},{"Content":"割鸡刺虎皆若空，"},{"Content":"愿应君心逐君指。"},{"Content":"并州难绾竟何人，"},{"Content":"每成此物如有神。"}]},{"Id":11417,"Classes":["軍旅"],"Allusions":[{"AllusionIndex":928,"AllusionKey":"非熊","SentenceIndex":12}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"腊日观咸宁王部曲娑勒擒豹歌","Comments":[{"Content":"一作月","Type":"Text","Index":2}]},"Clauses":[{"Content":"山头曈曈日将出，"},{"Content":"山下猎围照初日。"},{"Content":"前林有兽未识名，"},{"Content":"将军促骑无人声。"},{"Content":"潜形踠伏草不动，","Comments":[{"Content":"一作蜿","Type":"Text","Index":3},{"Content":"一作未","Type":"Text","Index":6}]},{"Content":"双雕旋转群鸦鸣。"},{"Content":"阴方质子才三十，"},{"Content":"译语受词蕃语揖。"},{"Content":"舍鞍解甲疾如风，"},{"Content":"人忽虎蹲兽人立。"},{"Content":"歘然扼颡批其颐，"},{"Content":"爪牙委地涎淋漓。"},{"Content":"既苏复吼拗仍怒，"},{"Content":"果叶英谋生致之。"},{"Content":"拖自深丛目如电，"},{"Content":"万夫失容千马战。"},{"Content":"传呼贺拜声相连，"},{"Content":"杀气腾凌阴满川。"},{"Content":"始知缚虎如缚鼠，"},{"Content":"败虏降羌生眼前。","Comments":[{"Content":"一作在","Type":"Text","Index":5},{"Content":"一作皆目睹","Type":"Text","Index":7}]},{"Content":"祝尔嘉词尔无苦，","Comments":[{"Content":"一作身","Type":"Text","Index":5}]},{"Content":"献尔将随犀象舞。","Comments":[{"Content":"一作看","Type":"Text","Index":2}]},{"Content":"苑中流水禁中山，"},{"Content":"期尔攫搏开天颜。"},{"Content":"非熊之兆庆无极，","Comments":[{"Content":"非熊","Type":"AllusionKey","Index":2}]},{"Content":"愿纪雄名传百蛮。"}],"Comments":[{"Book":"《唐诗别裁》","Content":"人虎互形，毛发生动（“人忽虎蹲”句下）。中间搏兽数语，何减太史公叙巨鹿之战？","IsComment":false,"FullPath":"《唐诗别裁》"}]},{"Id":11418,"Allusions":[{"AllusionIndex":255,"AllusionKey":"俗书博白鹅","SentenceIndex":6}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"赋得白鸥歌送李伯康归使"},"Clauses":[{"Content":"积水深源，","Comments":[{"Content":"一作沈","Type":"Text","Index":4}]},{"Content":"白鸥翻翻。","Comments":[{"Content":"一作飞","Type":"Text","Index":3}]},{"Content":"倒影光素，"},{"Content":"于潭之间。"},{"Content":"衔鱼鱼落乱惊鸣，","Comments":[{"Content":"一作衔鱼落","Type":"Text","Index":4}]},{"Content":"争扑莲丛莲叶倾。","Comments":[{"Content":"一作华","Type":"Text","Index":6},{"Content":"一作争扑莲丛叶倾","Type":"Text","Index":7}]},{"Content":"尔不见波中鸥鸟闲无营，"},{"Content":"何必汲汲劳其生。"},{"Content":"柳花冥濛大堤口，"},{"Content":"悠扬相和乍无有。"},{"Content":"轻随去浪杳不分，"},{"Content":"细舞清风亦何有。","Comments":[{"Content":"一作春","Type":"Text","Index":3},{"Content":"一作一","Type":"Text","Index":5},{"Content":"一作久","Type":"Text","Index":7}]},{"Content":"似君换得白鹅时，"},{"Content":"独凭阑干雪满池。"},{"Content":"今日还同看鸥鸟，"},{"Content":"如何羽翮复参差。"},{"Content":"复参差，"},{"Content":"海涛澜漫何由期。"}]}],"Count":337,"PageNo":15,"PageSize":20}