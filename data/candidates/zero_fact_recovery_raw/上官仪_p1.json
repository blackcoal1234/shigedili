{"Authors":{"Names":["上官仪"],"AuthorIds":[12429],"Dynasties":["Tang"]},"ShiData":[{"Id":4787,"Allusions":[{"AllusionIndex":88,"AllusionKey":"安仁省","SentenceIndex":5},{"AllusionIndex":8442,"AllusionKey":"子云阁","SentenceIndex":5}],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"酬薛舍人万年宫晚景寓直怀友"},"Clauses":[{"Content":"奕奕九成台，"},{"Content":"窈窕绝尘埃。"},{"Content":"苍苍万年树，"},{"Content":"玲珑下冥雾。"},{"Content":"池色摇晚空，"},{"Content":"岩花敛馀煦。","Comments":[{"Content":"一作光","Type":"Text","Index":2}]},{"Content":"清切丹禁静，"},{"Content":"浩荡文河注。"},{"Content":"留连穷胜托，"},{"Content":"夙期暌善谑。","Comments":[{"Content":"一作风","Type":"Text","Index":1}]},{"Content":"东望安仁省，","Comments":[{"Content":"安仁省","Type":"AllusionKey","Index":5}]},{"Content":"西临子云阁。","Comments":[{"Content":"子云阁","Type":"AllusionKey","Index":5}]},{"Content":"长啸披烟霞，"},{"Content":"高步寻兰若。"},{"Content":"金狄掩通门，"},{"Content":"雕鞍归骑喧。"},{"Content":"燕姝对明月，"},{"Content":"荆艳促芳尊。"},{"Content":"别有青山路，"},{"Content":"策杖访王孙。"}]},{"Id":4786,"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"遇","Rank":0,"Title":{"Content":"谢都督挽歌"},"Clauses":[{"Content":"漠漠佳城幽，"},{"Content":"苍苍松槚暮。"},{"Content":"鲁幕飘欲卷，"},{"Content":"宛驷悲还顾。"},{"Content":"楚挽绕卢山，","Comments":[{"Content":"一作桡","Type":"Text","Index":2}]},{"Content":"胡笳临武库。"},{"Content":"怅然郊原静，"},{"Content":"烟生归鸟度。"}]},{"Id":4781,"GroupIndex":1,"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"八咏应制二首"},"Clauses":[{"Content":"启重帷，"},{"Content":"重帷照文杏。"},{"Content":"翡翠藻轻花，"},{"Content":"流苏媚浮影。"},{"Content":"瑶笙燕始归，"},{"Content":"金堂露初晞。"},{"Content":"风随少女至，"},{"Content":"虹共美人归。"},{"Content":"罗荐已擘鸳鸯被，"},{"Content":"绮衣复有蒲萄带。"},{"Content":"残红艳粉映帘中，"},{"Content":"戏蝶流莺聚窗外。"},{"Content":"洛滨春雪回，"},{"Content":"巫峡暮云来。"},{"Content":"雪花飘玉辇，"},{"Content":"云光上璧台。"},{"Content":"共待新妆出，"},{"Content":"清歌送落梅。"}]},{"Id":4782,"GroupIndex":2,"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"八咏应制二首"},"Clauses":[{"Content":"入丛台，"},{"Content":"丛台裛春露。"},{"Content":"滴沥间深红，"},{"Content":"参差散轻素。"},{"Content":"妆蝶惊复聚，","Comments":[{"Content":"一作粉","Type":"Text","Index":1}]},{"Content":"黄鹂飞且顾。"},{"Content":"攀折殊未已，"},{"Content":"复值惊飞起。"},{"Content":"送影舞衫前，"},{"Content":"飘香歌扇里。"},{"Content":"望望惜春晖，"},{"Content":"行行犹未归。"},{"Content":"暂得佳游趣，"},{"Content":"更愁花鸟稀。"},{"Content":"且学鸟声调凤管，"},{"Content":"方移花影入鸳机。"}]},{"Id":4784,"Allusions":[{"AllusionIndex":1245,"AllusionKey":"数钱","SentenceIndex":3},{"AllusionIndex":4791,"AllusionKey":"解佩","SentenceIndex":3}],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"和太尉戏赠高阳公"},"Clauses":[{"Content":"薰炉御史出神仙，"},{"Content":"云鞍羽盖下芝田。"},{"Content":"红尘正起浮桥路，"},{"Content":"青楼遥敞御沟前。"},{"Content":"倾城比态芳菲节，"},{"Content":"绝世相娇是六年。"},{"Content":"惯是洛滨要解佩，","Comments":[{"Content":"解佩","Type":"AllusionKey","Index":7}]},{"Content":"本是河间好数钱。","Comments":[{"Content":"数钱","Type":"AllusionKey","Index":7}]},{"Content":"翠钗照耀衔云发，"},{"Content":"玉步逶迤动罗袜。"},{"Content":"石榴绞带轻花转，"},{"Content":"桃枝绿扇微风发。"},{"Content":"无情拂袂欲留宾，"},{"Content":"讵恨深潭不可越。"},{"Content":"天津一别九秋长，"},{"Content":"岂若随闻三日香。"},{"Content":"南国自然胜掌上，"},{"Content":"东家复是忆王昌。"}]},{"Id":4775,"Froms":["全唐诗续补遗"],"Allusions":[{"AllusionIndex":3800,"AllusionKey":"汉筑","SentenceIndex":5}],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"侵","Rank":0,"Title":{"Content":"五言辽东侍宴山夜临秋同赋临韵应诏"},"Clauses":[{"Content":"奉驾凌稽阜，"},{"Content":"同御掩□岑。"},{"Content":"肆赏乖濡足，"},{"Content":"穷览□干心。","Comments":[{"Content":"疑为「惕」字。","Type":"Text","Index":3}]},{"Content":"一德光神武，"},{"Content":"万象镜冲襟。"},{"Content":"御□辽山夕，"},{"Content":"凝麾溟海浔。"},{"Content":"帷殿清炎气，","Comments":[{"Content":"《初》作「殿帐」","Type":"Text","Index":2}]},{"Content":"辇道含秋阴。"},{"Content":"凄风移汉筑，","Comments":[{"Content":"汉筑","Type":"AllusionKey","Index":5}]},{"Content":"流水入虞琴。"},{"Content":"云飞送断雁，"},{"Content":"月上净疏林。"},{"Content":"滴沥露枝响，"},{"Content":"空蒙烟壑深。"},{"Content":"抚躬谢仁智，"},{"Content":"泉石忝登临。"},{"Content":"信美陪仙跸，"},{"Content":"长歌慰陆沉。","Comments":[{"Content":"见影日本藏唐卷子本《翰林学士集》，以《初学记》卷三引诗参校。","Type":"Text","Index":5}]}]},{"Id":826998,"Froms":["全唐诗续补遗"],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"阳","Rank":0,"Title":{"Content":"五言春日侍宴望海应诏"},"Clauses":[{"Content":"青丘横日域，"},{"Content":"碧海贯乾纲。"},{"Content":"奇怪储神府，"},{"Content":"朝宗擅谷王。"},{"Content":"灵官耀三岳，"},{"Content":"仙槎泛□□。"},{"Content":"蜃楼朝气上，"},{"Content":"鸡树早花芳。"},{"Content":"别岛春潮駃，"},{"Content":"连汀宿雾长。"},{"Content":"惊湍荡云色，"},{"Content":"沓浪倒霞光。"},{"Content":"宸行肃辽隧，"},{"Content":"降望临归塘。"},{"Content":"夹林朱鹭澈，"},{"Content":"分空翠凤翔。"},{"Content":"凭深体妫后，"},{"Content":"徒御叶周王。"},{"Content":"游圣沾玄泽，"},{"Content":"讵假濯沧浪。","Comments":[{"Content":"同前","Type":"Text","Index":5}]}]},{"Id":826999,"Froms":["全唐诗续补遗"],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"虞","Rank":0,"Title":{"Content":"五言奉和行经破薛举战地应诏"},"Clauses":[{"Content":"策星映霄极，"},{"Content":"飞鸿浃地区。"},{"Content":"鲔水腾周驾，"},{"Content":"涿鹿惊轩弧。"},{"Content":"荣河开秘篆，"},{"Content":"柳谷荐灵符。"},{"Content":"天游御长策，"},{"Content":"侮食被来苏。"},{"Content":"秋原怀八阵，"},{"Content":"武校烛三驱。"},{"Content":"投石堙旧垒，"},{"Content":"削树委荒途。"},{"Content":"□野惊宵磷，"},{"Content":"颓墉噪晚乌。"},{"Content":"毒泾晦凉雨，"},{"Content":"塞井蔽荒芜。"},{"Content":"冲情朗金镜，"},{"Content":"睿藻邃玄珠。"},{"Content":"□恩奉御什，"},{"Content":"抚己滥齐竽。","Comments":[{"Content":"同前","Type":"Text","Index":5}]}]},{"Id":827006,"Froms":["全唐诗续补遗"],"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"假作美人诗"},"Clauses":[{"Content":"宋腊何须说，"},{"Content":"虞姬未足谈。"},{"Content":"颊态花翻愧，"},{"Content":"眉成月倒悬。","Comments":[{"Content":"《诗格》作「妆罢花更丑，眉成月对愁」。此首为赞誉志。以上六首皆见《文镜秘府论》地卷《六志》引上官仪《笔札华梁》。《吟窗杂录》卷一引托名魏文帝《诗格》每首各引二句。","Type":"Text","Index":5}]}]},{"Id":4788,"Dynasty":"初唐","Author":"上官仪","AuthorId":12429,"Type":"句","TypeDetail":"Others","Rank":0,"Title":{"Content":"句","Comments":[{"Content":"以下并见释空海《文镜秘府论》","Type":"Text","Index":1}]},"Clauses":[{"Content":"曙色随行漏，"},{"Content":"早吹入繁笳。"},{"Content":"旗文萦桂叶，"},{"Content":"骑影拂桃华。"},{"Content":"碧潭写春照，"},{"Content":"青山笼雪花。","Comments":[{"Content":"论云，此六句犯长撷腰病","Type":"Text","Index":5}]},{"Content":"池牑风月清，"},{"Content":"閒居游客情。"},{"Content":"兰泛樽中色，"},{"Content":"松今弦上声。","Comments":[{"Content":"此四句犯长解镫病","Type":"Text","Index":5}]}]}],"Count":30,"PageNo":1,"PageSize":20}