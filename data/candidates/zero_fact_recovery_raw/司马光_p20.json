{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80743,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"又和开叔"},"Clauses":[{"Content":"寒梅犯雪荣，"},{"Content":"大隐久专名。"},{"Content":"异种生江渚，"},{"Content":"何年到洛城。","Comments":[{"Content":"自注：洛中虽有梅，开花常晚，独大隐梅最先开。相传好事者自江南移来，今数十年矣。","Type":"Text","Index":5}]},{"Content":"色如虚室白，"},{"Content":"香似主人清。"},{"Content":"响使吴儿见，"},{"Content":"不思菰菜羹。"}]},{"Id":81263,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"魏忠献公挽歌辞三首"},"Clauses":[{"Content":"瀛海吁谟定，"},{"Content":"宗祧指顾安。"},{"Content":"鸿勋柱石壮，"},{"Content":"劲节雪霜寒。"},{"Content":"翼亮三朝久，"},{"Content":"初终一德完。"},{"Content":"如何未黄发，"},{"Content":"垄柏已丸丸。"}]},{"Id":81262,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"魏忠献公挽歌辞三首"},"Clauses":[{"Content":"爱物威容悴，"},{"Content":"忧公宿疹加。"},{"Content":"孤忠贯白日，"},{"Content":"美志掩丹霞。"},{"Content":"行路皆惆怅，"},{"Content":"闻风悉叹嗟。"},{"Content":"英灵觐宗祖，"},{"Content":"犹想佑皇家。"}]},{"Id":81261,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"魏忠献公挽歌辞三首"},"Clauses":[{"Content":"恻怛动旒扆，"},{"Content":"鸿胪葬老臣。"},{"Content":"箫铙震淦口，","Comments":[{"Content":"陈本作涂","Type":"Text","Index":4}]},{"Content":"绋翣隘漳滨。"},{"Content":"久大英名在，"},{"Content":"哀荣异礼陈。"},{"Content":"丰碑纪遗烈，"},{"Content":"长泣邺城人。"}]},{"Id":81237,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"酬君贶和景仁对酒见寄三首"},"SubTitle":{"Content":"上宣徽"},"Clauses":[{"Content":"懒拙无时用，"},{"Content":"耆朋独我思。","Comments":[{"Content":"原作明，据陈本改","Type":"Text","Index":2}]},{"Content":"乘闲同把酒，"},{"Content":"道旧各成诗。"},{"Content":"高义刮眼膜，"},{"Content":"清风生鬓丝。"},{"Content":"方将激衰俗，"},{"Content":"贱子实何为。","Comments":[{"Content":"陈本作独","Type":"Text","Index":3}]}]},{"Id":81239,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"酬君贶和景仁对酒见寄三首"},"SubTitle":{"Content":"上宣徽"},"Clauses":[{"Content":"北阙黄金印，"},{"Content":"西山白发翁。"},{"Content":"吁谟帝廷异，"},{"Content":"小筑洛川同。"},{"Content":"晴野峰峰碧，"},{"Content":"霜林叶叶红。"},{"Content":"无因侍樽席，"},{"Content":"惆怅又秋风。"}]},{"Id":81238,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"Title":{"Content":"酬君贶和景仁对酒见寄三首 上侍中"},"Clauses":[{"Content":"何事挂冠客，"},{"Content":"至今留帝台。"},{"Content":"红尘终可厌，"},{"Content":"青眼不长开。"},{"Content":"春路半消雪，"},{"Content":"寒枝初破梅。"},{"Content":"南园虚客席，","Comments":[{"Content":"原作劣容，据陈本改","Type":"Text","Index":4}]},{"Content":"洒扫望公来。"}]},{"Id":80769,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"六月十八日夜大暑"},"Clauses":[{"Content":"老柳蜩螗噪，"},{"Content":"荒庭熠耀流。"},{"Content":"人情正苦暑，"},{"Content":"物怎已惊秋。","Comments":[{"Content":"四库本作态","Type":"Text","Index":2}]},{"Content":"月下濯寒水，"},{"Content":"风前梳白头。"},{"Content":"如何夜半客，"},{"Content":"束带谒公侯。"}]},{"Id":80872,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"Title":{"Content":"闲中有富贵"},"Clauses":[{"Content":"闲中有富贵，"},{"Content":"迥与俗尘殊。"},{"Content":"水净齐纨展，"},{"Content":"花繁蜀锦纡。"},{"Content":"竹风寒扣玉，"},{"Content":"荷雨急跳珠。"},{"Content":"可笑公孙衍，"},{"Content":"酣歌誇丈夫。"}]},{"Id":81159,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"覃","Rank":0,"Title":{"Content":"寄唐州吴辨叔二兄"},"Clauses":[{"Content":"方城古称险，"},{"Content":"远在豫州南。"},{"Content":"近岁污莱辟，"},{"Content":"新民秦晋参。"},{"Content":"当官诚近厚，"},{"Content":"获谴亦无惭。"},{"Content":"但惜墙阴竹，"},{"Content":"归辕几日骖。"}]},{"Id":80898,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"和安之久雨"},"Clauses":[{"Content":"秋霖逢甲子，"},{"Content":"禾耳恐须生。"},{"Content":"流俗幸无验，"},{"Content":"高田犹有成。"},{"Content":"润唯藜莠得，"},{"Content":"烂与蕙兰并。"},{"Content":"早晚浮云豁，"},{"Content":"逍遥赋晚晴。"}]},{"Id":80945,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"和复古小园书事"},"Clauses":[{"Content":"饱食复闲眠，"},{"Content":"风清雨霁天。"},{"Content":"叶深时坠果，"},{"Content":"岸曲乍藏莲。"},{"Content":"波面秋光净，"},{"Content":"林梢夕照鲜。"},{"Content":"东家近亦富，"},{"Content":"满地布苔钱。"}]},{"Id":80994,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"复古诗首句云独步复静坐辄继二章"},"SubTitle":{"Content":"独步"},"Clauses":[{"Content":"踽踽出东轩，"},{"Content":"徐徐步小园。"},{"Content":"何须从吏卒，"},{"Content":"亦不引儿孙。"},{"Content":"蹑屐寻莎径，"},{"Content":"携筇拨水源。"},{"Content":"愁闻俗客到，"},{"Content":"唯说市朝喧。"}]},{"Id":80995,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"复古诗首句云独步复静坐辄继二章"},"SubTitle":{"Content":"静坐"},"Clauses":[{"Content":"一榻仅容膝，"},{"Content":"身心俱寂然。"},{"Content":"直缘知乐内，"},{"Content":"亦不为安禅。"},{"Content":"棐几陈编掩，"},{"Content":"竹窗残局捐。"},{"Content":"尚馀喧噪在，"},{"Content":"野鸟与林蝉。"}]},{"Id":80810,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"覃","Rank":0,"Title":{"Content":"光诗首句云饱食复闲眠又成二章"},"SubTitle":{"Content":"饱食"},"Clauses":[{"Content":"钱少何须万，"},{"Content":"杯多不过三。"},{"Content":"龟肠本易足，"},{"Content":"熊掌讵宜贪。"},{"Content":"散步竹斋外，"},{"Content":"高吟柳径南。"},{"Content":"此心无所用，"},{"Content":"脱粟亦深惭。"}]},{"Id":67025,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"光诗首句云饱食复闲眠又成二章"},"SubTitle":{"Content":"闲眠"},"Clauses":[{"Content":"秋怀一事无，"},{"Content":"暑尽昼凉初。"},{"Content":"竹户静长闭，"},{"Content":"藜床安有馀。"},{"Content":"逍遥化胡蝶，"},{"Content":"容易入华胥。"},{"Content":"天上多官府，"},{"Content":"神仙恐不如。"}]},{"Id":81168,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"Title":{"Content":"寄题济源李少卿园亭","Comments":[{"Content":"章","Type":"Text","Index":7}]},"Clauses":[{"Content":"县僻人事少，"},{"Content":"土肥风物殊。"},{"Content":"杖刊灵寿木，"},{"Content":"轮裹溴梁蒲。"},{"Content":"竹不减淇水，"},{"Content":"花仍似洛都。"},{"Content":"主公眉雪白，"},{"Content":"游览未尝扶。"}]},{"Id":80941,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"和明叔九日"},"Clauses":[{"Content":"不奈衰须白，"},{"Content":"羞看朝鉴明。"},{"Content":"聊凭佳节酒，"},{"Content":"强作少年情。"},{"Content":"雨冷弊裘薄，"},{"Content":"风高醉帽倾。"},{"Content":"如何不行乐，"},{"Content":"况复值秋成。"}]},{"Id":80870,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"寒","Rank":0,"Title":{"Content":"邵尧夫先生哀辞二首"},"Clauses":[{"Content":"菽藿一箪乐，"},{"Content":"蒿莱三亩宽。"},{"Content":"蒲轮不能起，"},{"Content":"瓮牖有馀安。"},{"Content":"高节去圭角，"},{"Content":"久要敦岁寒。"},{"Content":"今朝郊外客，"},{"Content":"谁免涕汍澜。"}]},{"Id":80869,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"邵尧夫先生哀辞二首"},"Clauses":[{"Content":"慕德闻风久，"},{"Content":"论交倾盖新。"},{"Content":"何须半面旧，"},{"Content":"不待一言亲。"},{"Content":"讲道切磋直，"},{"Content":"忘怀笑语真。"},{"Content":"重言蒙蹠实，"},{"Content":"佩服敢书绅。","Comments":[{"Content":"自注：先生尝以予为脚踏实地之人。（注原缺，据陈本补）","Type":"Text","Index":5}]}]}],"Count":1270,"PageNo":20,"PageSize":20}