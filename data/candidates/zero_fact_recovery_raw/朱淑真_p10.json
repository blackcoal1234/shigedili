{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":96265,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"除日"},"Clauses":[{"Content":"爆竹声中腊已残，"},{"Content":"酴酥酒暖烛花寒。"},{"Content":"朦胧晓色笼春色，"},{"Content":"便觉春光不一般。","Comments":[{"Content":"元刻本作风","Type":"Text","Index":3}]}]},{"Id":96232,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"湖上小集"},"Clauses":[{"Content":"门前春水碧于天，"},{"Content":"坐上诗人逸似仙。"},{"Content":"白璧一双无玷缺，"},{"Content":"吹箫归去又无缘。"}]},{"Id":536083,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"下湖即事"},"Clauses":[{"Content":"晴波碧漾浸春空，"},{"Content":"邃馆清寒柳曳风。"},{"Content":"隔岸谁家修竹外，"},{"Content":"杏花斜袅一枝红。"}]},{"Id":536084,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"江","Title":{"Content":"西楼寄情"},"Clauses":[{"Content":"静看飞蝇触晓窗，"},{"Content":"宿酲未醒卷梳妆。"},{"Content":"强调朱粉西楼上，"},{"Content":"愁里春山画不长。"}]},{"Id":536086,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"夜留依绿亭"},"Clauses":[{"Content":"水鸟栖烟夜不喧，"},{"Content":"风传宫漏到湖边。"},{"Content":"三更好月十分魄，"},{"Content":"万里无云一样天。"}]},{"Id":536087,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"冬","Title":{"Content":"夜留依绿亭"},"Clauses":[{"Content":"雨换新凉秋兴浓，"},{"Content":"流萤明灭绿杨中。"},{"Content":"庭虚池印一方月，"},{"Content":"楼静檐披四面风。"}]},{"Id":536088,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"闲步"},"Clauses":[{"Content":"天街平贴净无尘，"},{"Content":"灯火春摇不夜城。","Comments":[{"Content":"《名媛诗归》卷二○作荧煌","Type":"Text","Index":4}]},{"Content":"乍得好凉宜散步，"},{"Content":"朦胧新月弄疏明。"}]},{"Id":536089,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"20","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"闻鹊"},"Clauses":[{"Content":"墙头花外说新情，","Comments":[{"Content":"元刻本作晴","Type":"Text","Index":7}]},{"Content":"拔去闲愁著耳听。"},{"Content":"青鸟已承云信息，"},{"Content":"预先来报两三声。"}]},{"Id":536090,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"试墨"},"Clauses":[{"Content":"翠楼高压浙山头，"},{"Content":"海角湖光豁醉眸。"},{"Content":"万景入帘吹不捲，"},{"Content":"一般心做百般愁。"}]},{"Id":536091,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"青","Rank":0,"FirstClauseRhyme":"青","Title":{"Content":"书王庵道姑壁"},"Clauses":[{"Content":"短短墙围小小亭，"},{"Content":"半檐疏玉响泠泠。"},{"Content":"尘飞不到人长静，"},{"Content":"一篆炉烟两卷经。"}]},{"Id":96192,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"Title":{"Content":"东马塍"},"Clauses":[{"Content":"一塍芳草碧芋芋，"},{"Content":"活水穿花暗护田。"},{"Content":"蚕事正忙农事急，"},{"Content":"不知春色为谁妍。"}],"Comments":[{"Content":"塍，（音秤）田间土梗。东马塍，地名。","IsComment":false}]},{"Id":536093,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"月台"},"Clauses":[{"Content":"下视红尘意眇然，"},{"Content":"翠栏十二出云颠。"},{"Content":"纵眸愈觉心宽大，"},{"Content":"碧落无垠绕地圆。"}]},{"Id":536094,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"云掩半月"},"Clauses":[{"Content":"霜月迎寒著意圆，"},{"Content":"横天云浪碍婵娟。"},{"Content":"嫦娥未肯全梳掠，"},{"Content":"玉鉴先教露半边。","Comments":[{"Content":"以上《新注朱淑真断肠诗集》前集卷八，总题吟赏","Type":"Text","Index":7}]}]},{"Id":96277,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"愁怀二首"},"Clauses":[{"Content":"鸥鹭鸳鸯作一池，"},{"Content":"须知羽翼不相宜。"},{"Content":"东君不与花为主，"},{"Content":"何似休生连理枝。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[不与]《宋元百家诗》　《名媛诗归》作[是与]。[何似休生]《宋元百家诗》　《名媛诗归》作[一任多生]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96278,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"愁怀二首"},"Clauses":[{"Content":"满眼春光色色新，"},{"Content":"花红柳绿总关情。"},{"Content":"欲将郁结心头事，"},{"Content":"付与黄鹂叫几声。"}]},{"Id":96202,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"冬","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"旧愁二首"},"Clauses":[{"Content":"银屏屈曲障春风，"},{"Content":"独抱寒衾睡正浓。"},{"Content":"啼鸟一声惊梦破，"},{"Content":"乱愁依旧锁眉峰。"}]},{"Id":96203,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"江","Title":{"Content":"旧愁二首"},"Clauses":[{"Content":"花影重重叠绮窗，"},{"Content":"篆烟飞上枕屏香。"},{"Content":"无情莺舌惊春梦，"},{"Content":"唤起愁人对夕阳。"}]},{"Id":536097,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"供愁"},"Clauses":[{"Content":"寂寂疏帘挂玉楼，"},{"Content":"楼头新月曲如钩。"},{"Content":"不须问我情深浅，"},{"Content":"钩动长天远水愁。"}]},{"Id":96230,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"恨别"},"Clauses":[{"Content":"调朱弄粉总无心，"},{"Content":"瘦觉宽馀缠臂金。"},{"Content":"别后大拚憔悴损，"},{"Content":"思情未抵此情深。"}]},{"Id":96269,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"寄情"},"Clauses":[{"Content":"欲寄相思满纸愁，"},{"Content":"鱼沉雁杳又还休。"},{"Content":"分明此去无多地，"},{"Content":"如在天涯无尽头。"}]}],"Count":367,"PageNo":10,"PageSize":20}