":"林黄柳尚疏。"},{"Content":"菱苕生皎镜，"},{"Content":"金碧照澄虚。"},{"Content":"翰苑声何旧，"},{"Content":"宾筵醉止初。"},{"Content":"中州有辽雁，"},{"Content":"好为系边书。"}]},{"Id":28342,"Classes":["軍旅 出征"],"Allusions":[{"AllusionIndex":2954,"AllusionKey":"一丸泥","SentenceIndex":5},{"AllusionIndex":7184,"AllusionKey":"取蒲类","SentenceIndex":6},{"AllusionIndex":8148,"AllusionKey":"太白","SentenceIndex":4}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"排律","TypeDetail":"WuPai","Rhyme":"齐","Rank":0,"FirstClauseRhyme":"齐","Title":{"Content":"再赴渭北使府留别"},"Clauses":[{"Content":"结发逐鸣鼙，"},{"Content":"连兵追谷蠡。"},{"Content":"山川搜伏虏，"},{"Content":"铠甲被重犀。"},{"Content":"故府旌旗在，"},{"Content":"新军羽校齐。","Comments":[{"Content":"一作檄","Type":"Text","Index":4}]},{"Content":"报恩身未死，"},{"Content":"识路马还嘶。"},{"Content":"列嶂高烽举，"},{"Content":"当营太白低。","Comments":[{"Content":"太白","Type":"AllusionKey","Index":4}]},{"Content":"平戎七尺剑，"},{"Content":"封检一丸泥。","Comments":[{"Content":"一丸泥","Type":"AllusionKey","Index":5}]},{"Content":"截海取蒲类，","Comments":[{"Content":"一作收","Type":"Text","Index":3},{"Content":"取蒲类","Type":"AllusionKey","Index":5}]},{"Content":"跑泉饮鸊鹈。"},{"Content":"汉庭中选重，"},{"Content":"更事五原西。"}]},{"Id":28341,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"排律","TypeDetail":"WuPai","Rhyme":"萧","Rank":0,"Title":{"Content":"兰陵僻居联句"},"Clauses":[{"Content":"潘岳闲居赋，"},{"Content":"陶潜独酌谣。"},{"Content":"二贤成往事，"},{"Content":"三径是今朝。","Comments":[{"Content":"广宣","Type":"Text","Index":5}]},{"Content":"生幸逢唐运，"},{"Content":"昌时奉帝尧。"},{"Content":"进思谐启沃，"},{"Content":"退混即渔樵。","Comments":[{"Content":"益","Type":"Text","Index":5}]},{"Content":"蠹简封延阁，"},{"Content":"彫阑閟上霄。"},{"Content":"相从清旷地，"},{"Content":"秋露挹兰苕。","Comments":[{"Content":"羔","Type":"Text","Index":5}]}]},{"Id":28344,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"排律","TypeDetail":"WuPai","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"红楼下联句"},"Clauses":[{"Content":"佛刹接重城，"},{"Content":"红楼切太清。"},{"Content":"紫云连照耀，"},{"Content":"丹槛郁峥嵘。","Comments":[{"Content":"