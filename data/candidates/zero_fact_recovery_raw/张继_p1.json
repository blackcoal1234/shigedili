{"Authors":{"Names":["张继"],"AuthorIds":[15634],"Dynasties":["Tang"]},"ShiData":[{"Id":24251,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"阊门即事","Comments":[{"Content":"一作柳公权诗","Type":"Text","Index":4}]},"Clauses":[{"Content":"耕夫召募逐楼船，","Comments":[{"Content":"一作占","Type":"Text","Index":3}]},{"Content":"春草青青万顷田。"},{"Content":"试上吴门窥郡郭，"},{"Content":"清明几处有新烟。"}],"Comments":[{"Book":"《精选评注五朝诗学津梁》","Content":"极写乱时情景，与“试向城搂高处望”二句同意。","IsComment":false,"FullPath":"《精选评注五朝诗学津梁》"},{"Book":"《唐人绝句精华》","Content":"此诗因登城眺望，见田野荒芜，人民流散，皆因募农民为水兵也。“春草”句言田园荒芜，“清明”句言人民流散。……唐自天宝乱后，兵源缺乏，募民为兵，以致人民逃亡者多，故当清明之时，举火之户甚少，故曰“清明几处有新烟”。","IsComment":false,"FullPath":"《唐人绝句精华》"}]},{"Id":24241,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"Title":{"Content":"安公房问法"},"Clauses":[{"Content":"流年一日复一日，"},{"Content":"世事何时是了时。"},{"Content":"试向东林问禅伯，"},{"Content":"遣将心地学琉璃。"}]},{"Id":24240,"Allusions":[{"AllusionIndex":3695,"AllusionKey":"一子千年见","SentenceIndex":0}],"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"上清词"},"Clauses":[{"Content":"紫阳宫女捧丹砂，"},{"Content":"王母令过汉帝家。","Comments":[{"Content":"一作今","Type":"Text","Index":3}]},{"Content":"春风不肯停仙驭，"},{"Content":"却向蓬莱看杏花。"}]},{"Id":24246,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"送顾况泗上觐叔父"},"Clauses":[{"Content":"吴乡岁贡足嘉宾，"},{"Content":"后进之中见此人。"},{"Content":"别业更临洙泗上，"},{"Content":"拟将书卷对残春。"}]},{"Id":24245,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"金谷园"},"Clauses":[{"Content":"䌽楼歌馆正融融，"},{"Content":"一骑星飞锦帐空。"},{"Content":"老尽名花春不管，"},{"Content":"年年啼鸟怨东风。"}]},{"Id":24242,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"邮亭","Comments":[{"Content":"（一作邮亭残花）。（一作张祜诗）","Type":"Text","Index":2}]},"Clauses":[{"Content":"云淡山横日欲斜，"},{"Content":"邮亭下马对残花。"},{"Content":"自从身逐征西府，"},{"Content":"每到开时不在家。"}]},{"Id":24248,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"冬","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"宿白马寺"},"Clauses":[{"Content":"白马驮经事已空，"},{"Content":"断碑残刹见遗踪。"},{"Content":"萧萧茅屋秋风起，"},{"Content":"一夜雨声羁思浓。"}]},{"Id":24273,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"12","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"明德宫"},"Clauses":[{"Content":"碧瓦朱楹白昼闲，"},{"Content":"金衣宝扇晓风寒。"},{"Content":"摩云观阁高如许，"},{"Content":"长对河流出断山。"}]},{"Id":24247,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"读峄山碑"},"Clauses":[{"Content":"六国平来四海家，"},{"Content":"相君当代擅才华。"},{"Content":"谁知颂德山头石，"},{"Content":"却与他人戒后车。"}]},{"Id":24270,"Allusions":[{"AllusionIndex":6009,"AllusionKey":"鲁诸生","SentenceIndex":5},{"AllusionIndex":8806,"AllusionKey":"汶阳田","SentenceIndex":1}],"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"排律","TypeDetail":"WuPai","Rhyme":"庚","Rank":0,"Title":{"Content":"送邹判官往陈留","Comments":[{"Content":"一作洪州送郤绍充河南租庸判官","Type":"Text","Index":7}]},"Clauses":[{"Content":"齐宋伤心地，","Comments":[{"Content":"一作鲁","Type":"Text","Index":2},{"Content":"一作分巡","Type":"Text","Index":4}]},{"Content":"频年此用兵。"},{"Content":"女停襄邑杼，"},{"Content":"农废汶阳耕。"},{"Content":"国使乘轺去，","Comments":[{"Content":"一作使者","Type":"Text","Index":2}]},{"Content":"诸侯拥节迎。","Comments":[{"Content":"一作藩","Type":"Text","Index":2}]},{"Content":"深仁荷君子，","Comments":[{"Content":"一作佐，一作赖","Type":"Text","Index":3}]},{"Content":"薄赋恤黎氓。"},{"Content":"火燎原犹热，"},{"Content":"波摇海未平。","Comments":[{"Content":"一作风","Type":"Text","Index":1}]},{"Content":"应将否泰理，"},{"Content":"一问鲁诸生。","Comments":[{"Content":"鲁诸生","Type":"AllusionKey","Index":5}]}],"Comments":[{"Book":"《升庵诗话》","Content":"《国语》：“室无悬耜，野无奥草。”《尉缭子》兵法：“耕有春悬耜，织有日断机。”言用兵之妨于耕织也。唐张继诗：“女停襄邑杵，农废汶阳耕”。盖祖《尉缭子》之语。","IsComment":false,"FullPath":"《升庵诗话》"},{"Book":"《唐诗别裁》","Content":"兵荒之后，以深仁薄赋期之，得“赠人以言”之意。","IsComment":false,"FullPath":"《唐诗别裁》"}]},{"Id":24271,"Allusions":[{"AllusionIndex":2885,"AllusionKey":"飞书","SentenceIndex":4},{"AllusionIndex":3686,"AllusionKey":"海陵粟","SentenceIndex":3},{"AllusionIndex":7952,"AllusionKey":"水衡钱","SentenceIndex":3},{"AllusionIndex":8002,"AllusionKey":"思玄","SentenceIndex":5},{"AllusionIndex":8442,"AllusionKey":"投阁","SentenceIndex":4}],"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"排律","TypeDetail":"WuPai","Rhyme":"先","Rank":0,"Title":{"Content":"酬李书记校书越城秋夜见赠"},"Clauses":[{"Content":"东越秋城夜，"},{"Content":"西人白发年。"},{"Content":"寒城警刁斗，"},{"Content":"孤愤抱龙泉。"},{"Content":"凤辇栖岐下，"},{"Content":"鲸波斗洛川。"},{"Content":"量空海陵粟，","Comments":[{"Content":"海陵粟","Type":"AllusionKey","Index":5}]},{"Content":"赐乏水衡钱。","Comments":[{"Content":"水衡钱","Type":"AllusionKey","Index":5}]},{"Content":"投阁嗤扬子，","Comments":[{"Content":"投阁","Type":"AllusionKey","Index":2}]},{"Content":"飞书代鲁连。","Comments":[{"Content":"飞书","Type":"AllusionKey","Index":2}]},{"Content":"苍苍不可问，"},{"Content":"余亦赋思玄。","Comments":[{"Content":"思玄","Type":"AllusionKey","Index":5}]}]},{"Id":24275,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"郢城西楼吟","Comments":[{"Content":"一作郎士元诗","Type":"Text","Index":5}]},"Clauses":[{"Content":"连山尽塞水萦回，","Comments":[{"Content":"一作处","Type":"Text","Index":4}]},{"Content":"山上戍门临水开。","Comments":[{"Content":"一作城","Type":"Text","Index":3}]},{"Content":"珠帘直下一百丈，","Comments":[{"Content":"一作朱栏","Type":"Text","Index":2}]},{"Content":"日暖游鳞自相向。"},{"Content":"昔人爱险闭层城，","Comments":[{"Content":"一作受","Type":"Text","Index":3}]},{"Content":"今人复爱闲江清。","Comments":[{"Content":"郎集作今日爱闲江复清","Type":"Text","Index":7}]},{"Content":"沙洲枫岸无来客，"},{"Content":"草绿花开山鸟鸣。","Comments":[{"Content":"一作红","Type":"Text","Index":4}]}]},{"Id":24274,"Allusions":[{"AllusionIndex":1783,"AllusionKey":"珠履三千客","SentenceIndex":3}],"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"古风","TypeDetail":"GuFeng","Rank":0,"Title":{"Content":"春申君祠"},"Clauses":[{"Content":"春申祠宇空山里，"},{"Content":"古柏阴阴石泉水。"},{"Content":"日暮江南无主人，"},{"Content":"弥令过客思公子。"},{"Content":"萧条寒景傍山村，"},{"Content":"寂寞谁知楚相尊。"},{"Content":"当时珠履三千客，","Comments":[{"Content":"珠履三千客","Type":"AllusionKey","Index":7}]},{"Content":"赵使怀惭不敢言。"}]},{"Id":24276,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"六言诗","TypeDetail":"LiuYan","Rhyme":"鱼","Rank":0,"Title":{"Content":"奉寄皇甫补阙"},"Clauses":[{"Content":"京口情人别久，"},{"Content":"扬州估客来疏。"},{"Content":"潮至浔阳回去，","Comments":[{"Content":"一作来","Type":"Text","Index":5}]},{"Content":"相思无处通书。"}]},{"Id":24278,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"句","TypeDetail":"Others","Rank":0,"Title":{"Content":"句"},"Clauses":[{"Content":"汉月经时掩，"},{"Content":"胡尘与岁深。","Comments":[{"Content":"《咏镜》，见《诗式》","Type":"Text","Index":5}]}]},{"Id":24279,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"句","TypeDetail":"Others","Rhyme":"尤","Rank":0,"Title":{"Content":"送客"},"Clauses":[{"Content":"频年独对鸳鸯绮，"},{"Content":"计日双飞鹦鹉洲。"}],"Note":"按：（见宋王象之《舆地纪胜》卷六七《鄂州》）。"},{"Id":24277,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"乐府曲辞","TypeDetail":"YueFu","Rhyme":"霰","Rank":0,"Title":{"Content":"杂曲歌辞 长相思"},"Clauses":[{"Content":"辽阳望河县，"},{"Content":"白首无由见。","Comments":[{"Content":"一作人","Type":"Text","Index":4}]},{"Content":"海上珊瑚枝，"},{"Content":"年年寄春燕。"}]}],"Count":37,"PageNo":1,"PageSize":20}