{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11183,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"同耿湋宿陆澧旅舍"},"Clauses":[{"Content":"当轩云月开，"},{"Content":"清夜故人杯。"},{"Content":"拥褐觉霜下，"},{"Content":"抱琴闻雁来。"},{"Content":"迎风君顾步，"},{"Content":"临路我迟回。"},{"Content":"双鬓共如此，"},{"Content":"此欢非易陪。"}]},{"Id":11342,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"题苗员外竹间亭"},"Clauses":[{"Content":"高甃绝行尘，"},{"Content":"开帘似有春。"},{"Content":"风倾竹上雪，"},{"Content":"山对酒边人。"},{"Content":"步暖先逢日，"},{"Content":"书空远见邻。"},{"Content":"还同内斋暇，"},{"Content":"登赏及诸姻。"}]},{"Id":11215,"Classes":["軍旅"],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"齐","Rank":0,"FirstClauseRhyme":"齐","Title":{"Content":"奉陪侍中登白楼","Comments":[{"Content":"一作奉陪浑侍中五日登白鹤楼","Type":"Text","Index":7}]},"Clauses":[{"Content":"高楼倚玉梯，"},{"Content":"朱槛与云齐。"},{"Content":"顾盼亲霄汉，","Comments":[{"Content":"一作临","Type":"Text","Index":3}]},{"Content":"谈谐息鼓鼙。"},{"Content":"洪河斜更直，","Comments":[{"Content":"一作回","Type":"Text","Index":3}]},{"Content":"野雨急仍低。"},{"Content":"今日陪尊俎，"},{"Content":"唯当醉似泥。","Comments":[{"Content":"一作还应","Type":"Text","Index":2}]}]},{"Id":11164,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"FirstClauseRhyme":"文","Title":{"Content":"九日奉陪侍中宴白楼","Comments":[{"Content":"一本有鹤字","Type":"Text","Index":8}]},"Clauses":[{"Content":"露白菊氛氲，"},{"Content":"西楼盛袭文。","Comments":[{"Content":"一作宠盛","Type":"Text","Index":4}]},{"Content":"玉筵秋令节，"},{"Content":"金钺汉元勋。"},{"Content":"说剑风生座，"},{"Content":"抽琴鹤绕云。"},{"Content":"謏儒无以荅，"},{"Content":"愿得备前军。"}]},{"Id":11165,"Allusions":[{"AllusionIndex":6252,"AllusionKey":"枚叟","SentenceIndex":1}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"九日奉陪侍中宴后亭"},"Clauses":[{"Content":"玉壶倾菊酒，"},{"Content":"一顾得淹留。"},{"Content":"彩笔徵枚叟，","Comments":[{"Content":"枚叟","Type":"AllusionKey","Index":5}]},{"Content":"花筵舞莫愁。"},{"Content":"管弦能驻景，"},{"Content":"松桂不停秋。"},{"Content":"为谢蓬蒿辈，"},{"Content":"如何霜霰稠。"}]},{"Id":11163,"Allusions":[{"AllusionIndex":278,"AllusionKey":"报恩环","SentenceIndex":3},{"AllusionIndex":5760,"AllusionKey":"留侯","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"九日奉陪令公登白楼同咏菊"},"Clauses":[{"Content":"琼尊犹有菊，","Comments":[{"Content":"一作有仙","Type":"Text","Index":4}]},{"Content":"可以献留侯。","Comments":[{"Content":"留侯","Type":"AllusionKey","Index":5}]},{"Content":"愿比三花秀，"},{"Content":"非同百卉秋。"},{"Content":"金英分蕊细，","Comments":[{"Content":"一作叶","Type":"Text","Index":4}]},{"Content":"玉露结房稠。"},{"Content":"黄雀知恩在，"},{"Content":"衔飞亦上楼。"}]},{"Id":11216,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"奉陪浑侍中上巳日泛渭河"},"Clauses":[{"Content":"青舸锦帆开，","Comments":[{"Content":"一作素","Type":"Text","Index":1}]},{"Content":"浮天接上台。"},{"Content":"晚莺和玉笛，"},{"Content":"春浪动金罍。"},{"Content":"舟楫方朝海，"},{"Content":"鲸鲵自曝腮。"},{"Content":"应怜似萍者，"},{"Content":"空逐榜人回。"}]},{"Id":11225,"Allusions":[{"AllusionIndex":5741,"AllusionKey":"谢公","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"春日陪李庶子遵善寺东院晓望"},"Clauses":[{"Content":"映竹水田分，"},{"Content":"当山起雁群。"},{"Content":"阳峰高对寺，"},{"Content":"阴井下通云。"},{"Content":"雪昼唯逢鹤，","Comments":[{"Content":"一作尽","Type":"Text","Index":2}]},{"Content":"花时此见君。"},{"Content":"由来禅诵地，"},{"Content":"多有谢公文。","Comments":[{"Content":"谢公","Type":"AllusionKey","Index":4}]}]},{"Id":11339,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"题兴善寺后池"},"Clauses":[{"Content":"隔窗栖白鹤，","Comments":[{"Content":"一作鸟","Type":"Text","Index":5}]},{"Content":"似与镜湖邻。"},{"Content":"月照何年树，"},{"Content":"花逢几遍人。","Comments":[{"Content":"一作世，一作番，一作度","Type":"Text","Index":4}]},{"Content":"岸莎青有路，"},{"Content":"苔径绿无尘。","Comments":[{"Content":"一作径石","Type":"Text","Index":2}]},{"Content":"永愿容依止，"},{"Content":"僧中老此身。","Comments":[{"Content":"一作山","Type":"Text","Index":1}]}]},{"Id":11308,"Allusions":[{"AllusionIndex":772,"AllusionKey":"五湖心","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"陪中书李纾舍人夜泛东池"},"Clauses":[{"Content":"看月复听琴，"},{"Content":"移舟出树阴。"},{"Content":"夜村机杼急，"},{"Content":"秋水芰荷深。"},{"Content":"石静龟潜上，"},{"Content":"萍开果暗沈。","Comments":[{"Content":"一作叶","Type":"Text","Index":3}]},{"Content":"何言奉杯酒，","Comments":[{"Content":"一作杯酒兴","Type":"Text","Index":5}]},{"Content":"得见五湖心。","Comments":[{"Content":"五湖心","Type":"AllusionKey","Index":5}]}]},{"Id":11337,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"题云际寺上方"},"Clauses":[{"Content":"松高萝蔓轻，"},{"Content":"中有石床平。"},{"Content":"下界水长急，"},{"Content":"上方灯自明。"},{"Content":"空门不易启，"},{"Content":"初地本无程。"},{"Content":"回步忽山尽，"},{"Content":"万缘从此生。"}]},{"Id":11162,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"九日同司直九叔崔侍御登宝鸡南楼"},"Clauses":[{"Content":"把菊叹将老，"},{"Content":"上楼悲未还。"},{"Content":"短长新白发，"},{"Content":"重叠旧青山。","Comments":[{"Content":"一作稠","Type":"Text","Index":1}]},{"Content":"霜气清衿袖，"},{"Content":"琴声引醉颜。"},{"Content":"竹林唯七友，"},{"Content":"何幸亦登攀。"}]},{"Id":11184,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"同崔峒补阙慈恩寺避暑"},"Clauses":[{"Content":"寺凉高树合，"},{"Content":"卧石绿阴中。"},{"Content":"伴鹤惭仙侣，"},{"Content":"依僧学老翁。"},{"Content":"鱼沈荷叶露，"},{"Content":"鸟散竹林风。"},{"Content":"始悟尘居者，"},{"Content":"应将火宅同。"}]},{"Id":11233,"Allusions":[{"AllusionIndex":4764,"AllusionKey":"七贤","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"秋夜同畅当宿潭上西亭"},"Clauses":[{"Content":"圆月出山头，"},{"Content":"七贤林下游。","Comments":[{"Content":"七贤","Type":"AllusionKey","Index":2}]},{"Content":"梢梢寒叶坠，"},{"Content":"滟滟月波流。"},{"Content":"凫鹄共思晓，"},{"Content":"菰蒲相与秋。"},{"Content":"明当此中别，"},{"Content":"一为望汀洲。"}]},{"Id":11235,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"秋夜宴集陈翃郎中圃亭美校书郎张正元归乡","Comments":[{"Content":"一作雄","Type":"Text","Index":6}]},"Clauses":[{"Content":"泉清兰菊稠，"},{"Content":"红果落城沟。"},{"Content":"保庆台榭古，"},{"Content":"感时琴瑟秋。"},{"Content":"硕儒欢颇至，"},{"Content":"名士礼能周。"},{"Content":"为谢邑中少，"},{"Content":"无惊池上鸥。"}]},{"Id":11185,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"同薛存诚登栖岩寺"},"Clauses":[{"Content":"衰蹇步难前，"},{"Content":"上山如上天。"},{"Content":"尘泥来自晚，"},{"Content":"猿鹤到何先。"},{"Content":"万壑应孤磬，"},{"Content":"百花通一泉。"},{"Content":"苍苍此明月，"},{"Content":"下界正沈眠。"}]},{"Id":11173,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"FirstClauseRhyme":"文","Title":{"Content":"冬日宴郭监林亭"},"Clauses":[{"Content":"玉勒聚如云，"},{"Content":"森森鸾鹤群。"},{"Content":"据梧花罽接，"},{"Content":"沃盥石泉分。"},{"Content":"华味惭初识，"},{"Content":"新声喜尽闻。"},{"Content":"此山招老贱，"},{"Content":"敢不谢夫君。"}]},{"Id":11182,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"同耿湋司空曙二拾遗题韦员外东斋花树"},"Clauses":[{"Content":"绿砌红花树，"},{"Content":"狂风独未吹。"},{"Content":"光中疑有燄，"},{"Content":"密处似无枝。"},{"Content":"鸟动香轻发，"},{"Content":"人愁影屡移。"},{"Content":"今朝数片落，"},{"Content":"为报汉郎知。"}]},{"Id":11195,"Allusions":[{"AllusionIndex":772,"AllusionKey":"五湖心","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"观袁修侍郎涨新池","Comments":[{"Content":"一作傪","Type":"Text","Index":3},{"Content":"一作崔郎中","Type":"Text","Index":5}]},"Clauses":[{"Content":"引水香山近，","Comments":[{"Content":"一作春","Type":"Text","Index":3}]},{"Content":"穿云复绕林。"},{"Content":"才闻篱外响，"},{"Content":"已觉石边深。"},{"Content":"满处侵苔色，"},{"Content":"澄来见柳阴。"},{"Content":"微风月明夜，"},{"Content":"知有五湖心。","Comments":[{"Content":"五湖心","Type":"AllusionKey","Index":5}]}]},{"Id":11207,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"和徐法曹赠崔洛阳斑竹杖以诗见荅"},"Clauses":[{"Content":"玉干一寻馀，"},{"Content":"苔花锦不如。"},{"Content":"劲堪和醉倚，"},{"Content":"轻好向空书。"},{"Content":"采拂稽山曲，"},{"Content":"因依释氏居。"},{"Content":"方辰将独步，"},{"Content":"岂与此君疏。"}]}],"Count":337,"PageNo":4,"PageSize":20}