{"Authors":{"Names":["晏殊"],"AuthorIds":[27290],"Dynasties":["Song"]},"ShiData":[{"Id":198275,"GroupIndex":9,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"5","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"脸傅朝霞衣剪翠。"},{"Content":"重重占断秋江水。"},{"Content":"一曲采莲风细细。"},{"Content":"人未醉。"},{"Content":"鸳鸯不合惊飞起。","BreakAfter":"1"},{"Content":"欲摘嫩条嫌绿刺。"},{"Content":"闲敲画扇偷金蕊。"},{"Content":"半夜月明珠露坠。"},{"Content":"多少意。"},{"Content":"红腮点点相思泪。"}]},{"Id":198273,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"13","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"越女采莲江北岸。"},{"Content":"轻桡短棹随风便。"},{"Content":"人貌与花相斗艳。"},{"Content":"流水慢。"},{"Content":"时时照影看妆面。","BreakAfter":"1"},{"Content":"莲叶层层张绿伞。"},{"Content":"莲房个个垂金盏。"},{"Content":"一把藕丝牵不断。"},{"Content":"红日晚。"},{"Content":"回头欲去心撩乱。"}]},{"Id":198276,"GroupIndex":11,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"7","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"粉面啼红腰束素，"},{"Content":"当年拾翠曾相遇。"},{"Content":"密意深情谁与诉，"},{"Content":"空怨慕，"},{"Content":"西池夜夜风兼露。","BreakAfter":"1"},{"Content":"池上夕阳笼碧树，"},{"Content":"池中短棹惊微雨。"},{"Content":"水泛落英何处去，"},{"Content":"人不悟，"},{"Content":"东流到了无停住。"}]},{"Id":198278,"GroupIndex":12,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"30","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"幽鹭慢来窥品格，"},{"Content":"双鱼岂解传消息。"},{"Content":"绿柄嫩香频采摘，"},{"Content":"心似织，"},{"Content":"条条不断谁牵役。","BreakAfter":"1"},{"Content":"粉泪暗和清露滴，"},{"Content":"罗衣染尽秋江色。"},{"Content":"对面不言情脉脉，"},{"Content":"烟水隔，"},{"Content":"无人说似长相忆。"}]},{"Id":198269,"GroupIndex":13,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"23","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"楚国细腰元自瘦。"},{"Content":"文君腻脸谁描就。"},{"Content":"日夜鼓声催箭漏。"},{"Content":"昏复昼。"},{"Content":"红颜岂得长如旧。","BreakAfter":"1"},{"Content":"醉折嫩房和蕊嗅。"},{"Content":"天丝不断清香透。"},{"Content":"却傍小阑凝望久。"},{"Content":"风满袖。"},{"Content":"西池月上人归后。"}]},{"Id":198272,"GroupIndex":14,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"13","Rank":0,"Title":{"Content":"渔家傲"},"TuneId":{"Id":328},"Clauses":[{"Content":"嫩绿堪裁红欲绽。"},{"Content":"蜻蜓点水鱼游畔。"},{"Content":"一霎雨声香四散。"},{"Content":"风飐乱。"},{"Content":"高低掩映千千万。","BreakAfter":"1"},{"Content":"总是凋零终有限。"},{"Content":"能无眼下生留恋。"},{"Content":"何似折来妆粉面。"},{"Content":"勤看玩。"},{"Content":"胜如落尽秋江岸。"}]},{"Id":198197,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"13","Rank":0,"Title":{"Content":"玉楼春"},"TuneId":{"Id":273},"Clauses":[{"Content":"东风昨夜回梁苑。"},{"Content":"日脚依稀添一线。"},{"Content":"旋开杨柳绿蛾眉，"},{"Content":"暗拆海棠红粉面。","BreakAfter":"1"},{"Content":"无情一去云中雁。"},{"Content":"有意归来梁上燕。"},{"Content":"有情无意且休论，"},{"Content":"莫向酒杯容易散。"}]},{"Id":198188,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"1","Rank":0,"Title":{"Content":"木兰花"},"TuneId":{"Id":273},"Clauses":[{"Content":"帘旌浪卷金泥凤。"},{"Content":"宿醉醒来长瞢松。"},{"Content":"海棠开后晓寒轻，"},{"Content":"柳絮飞时春睡重。","BreakAfter":"1"},{"Content":"美酒一杯谁与共。"},{"Content":"往事旧欢时节动。"},{"Content":"不如怜取眼前人，"},{"Content":"免更劳魂兼役梦。"}]},{"Id":198195,"GroupIndex":3,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"7","Rank":0,"Title":{"Content":"玉楼春"},"TuneId":{"Id":273},"Clauses":[{"Content":"燕鸿过后莺归去。"},{"Content":"细算浮生千万绪。"},{"Content":"长于春梦几多时，"},{"Content":"散似秋云无觅处。","BreakAfter":"1"},{"Content":"闻琴解佩神仙侣。"},{"Content":"挽断罗衣留不住。"},{"Content":"劝君莫作独醒人，"},{"Content":"烂醉花间应有数。"}],"Comments":[{"Content":"这首词借青春和爱情的消失，感慨美好生活的无常，细腻含蓄而婉转地表达了作者的复杂情感。这是一首优美动人而有寓有深意的词作，为晏殊词的另类作品。<br />起句“燕鸿过后莺归去”写春光消逝：燕子春天自南方来，鸿雁春天往北方飞，黄莺逢春而鸣，这些禽鸟按季节该来的来了，该去的也去了，那春光也来过又走了。这里写的是莺语燕飞的春归时候，恰逢莺燕都稀 ，更觉怅惘 。“莺燕”，兼以喻人，春光易逝，美人相继散去，美好的年华与美好的爱情都不能长保，怎不让人感慨万千。“细算浮生千万绪”一句从客观转到主观，说对着上述现象，千头万绪，细细盘算 ，使人不能不正视的 ，正是人生若水面浮萍之暂起 ，这两句前后相承，又很自然地引出下面两句：“长于春梦几多时？散似秋云无觅处。”这两句改用白居易《花非花》词句“来如春梦几多时？去似朝云无觅处。”但旨意不同。作者此处写的是对于整个人生问题的思考，他把美好的年华、爱情与春梦的短长相比较，把亲爱的人的聚难散易与秋云的留、逝相对照，内涵广阔，感慨深沉。<br />下片“闻琴解佩神仙侣，挽断罗衣留不住。”两句写失去美好爱情的旧事，是对上片感慨的具体申述，又是产生上片感慨的主要因素，这样使上下片的关系交互钩连，自然过渡 。“闻琴”，指汉代的卓文君，她闻司马相如弹琴而爱慕他；“解佩”，指传说中的神女，曾解玉佩赠给情人。这两句是说象卓文君、神女这样的神仙伴侣要离开，挽断她们的罗衣也无法留住。随后作者激动地呼出：“劝君莫作独醒人，烂醉花间应有数。”意思是劝人要趁好花尚开的时候，在花间痛饮消愁。这是受到重大刺激的反应，是对失去美与爱的更大的痛心。联系晏殊的生平来看，他写这件事，应该是别有寄托，非真写男女诀别。宋仁宗庆历三年（1043），晏殊任同中书门下平章事（宰相），兼枢密使，握军政大权 。其时 ，范仲淹为参知政事（副宰相），韩琦、富弼为枢密副使，欧阳修、蔡襄为谏官，人才济济，盛极一时。可惜宋仁宗不能果断明察，又听信反对派的攻击之言，则韩琦先被放出为外官，范仲淹、富弼、欧阳修也相继外放，晏殊则罢相。对于贤才相继离开朝廷，晏殊不能不痛心，他把他们的被贬 ，比作“ 挽断罗衣”而留不住的“神仙侣”。不宜“独醒”、只宜“烂醉”，当是一种愤慨之声。<br />此词化用前人的诗句，信手拈来，自然贴切。词中的复杂的思想，反映了作者的人生态度和襟怀。","IsComment":false}]},{"Id":198183,"GroupIndex":4,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"13","Rank":0,"Title":{"Content":"木兰花"},"TuneId":{"Id":273},"Clauses":[{"Content":"池塘水绿风微暖。"},{"Content":"记得玉真初见面。"},{"Content":"重头歌韵响铮琮，"},{"Content":"入破舞腰红乱旋。","BreakAfter":"1"},{"Content":"玉钩阑下香阶畔。"},{"Content":"醉后不知斜日晚。"},{"Content":"当时共我赏花人，"},{"Content":"点检如今无一半。"}]},{"Id":198196,"GroupIndex":5,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"17","Rank":0,"Title":{"Content":"玉楼春"},"TuneId":{"Id":273},"Clauses":[{"Content":"玉楼朱阁横金锁。"},{"Content":"寒食清明春欲破。"},{"Content":"窗间斜月两眉愁，"},{"Content":"帘外落花双泪堕。","BreakAfter":"1"},{"Content":"朝云聚散真无那。"},{"Content":"百岁相看能几个。"},{"Content":"别来将为不牵情，"},{"Content":"万转千回思想过。"}],"Comments":[{"Content":"这首词虽写离愁别恨这一传统题材，但却别有一番情调，是作者性格的体现，是明澈理智和深厚感情的完美结合。<br />上片首句勾勒出一个豪华、优美的环境：玉楼朱阁，有明窗可以赏月，帘外的庭院里种着好花。但情与境的关系却很复杂 ，处在这个明快环境的主人公，由于与心爱的人分别，对着“横金锁”的楼阁，便有人去楼空之痛。寒食、清明时节，春色最浓，却是将残之候，故云“寒食清明春欲破”。这两句从“横金锁”三字已露出可愁之迹。接下来两句写景与写愁结合，写斜月照着人凝愁的双眉，人看帘外的落花，因触动身世之感而双眼落泪；同时又点染出天上的一勾缺月和窗里人的愁眉相似，帘外花落有如帘里人在垂泪。<br />下片转而以抒情为主，兼带议论。起两句：“朝云聚散真无那，百岁相看能几个？”用典：朝云，用的是宋玉《高唐赋》中巫山神女“旦为朝云，暮为行雨”的典故，以喻美人。无那，无可奈何。“朝云”一句说与心爱的美人的聚合离散，都是不由自主、无可奈何之事，这是对于人力有限、无法左右自己的命运和情绪的感叹，是人之常情。“ 百岁 ”一句说的是：面对这种情况，看透了也就不用过分伤感，自寻烦恼，因为自古以来，有几个人能和他的爱人厮守相看到百年呢？只有看透世事，超脱常情，才能有此议论。这议论是对上面所写感情的否定，然而下面两句接着说 ：“ 别来将为不牵情，万转千回思想过。”<br />“将为”与“将谓”通用。这两句的意思是：主人公以为可以排除离愁别恨的牵缠 ，结果还是“ 万转千回”地思念过了；这表明情不容易被战胜，而且主人公也不甘心放弃它，又回到对情的肯定。这样，理与情、肯定与否定，互相渗透，把一种复杂的感情，处理得单纯而又明净，有“哀而不伤”之致。<br />晏殊词语多浑成，少雕琢。此首“窗问”一联即是情景交融、精工美妙的佳句。还有一些词句，概括了时移物换、悲欢离合方面的感受，即如这首词中的“朝云聚散真无那，百岁相看能几个”，确乎饶有理趣，能使读者产生更多的联想，给人以启迪和回味。","IsComment":false}]},{"Id":198185,"GroupIndex":7,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"23","Rank":0,"Title":{"Content":"木兰花/玉楼春"},"TuneId":{"Id":273},"Clauses":[{"Content":"杏梁归燕双回首。"},{"Content":"黄蜀葵花开应候。"},{"Content":"画堂元是降生辰，"},{"Content":"玉盏更斟长命酒。","BreakAfter":"1"},{"Content":"炉中百和添香兽。"},{"Content":"帘外青蛾回舞袖。"},{"Content":"此时红粉感恩人，"},{"Content":"拜向月宫千岁寿。"}]},{"Id":198186,"GroupIndex":8,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"23","Rank":0,"Title":{"Content":"木兰花/玉楼春"},"TuneId":{"Id":273},"Clauses":[{"Content":"紫薇朱槿繁开后。"},{"Content":"枕簟微凉生玉漏。"},{"Content":"玳筵初启日穿帘，"},{"Content":"檀板欲开香满袖。","BreakAfter":"1"},{"Content":"红衫侍女频倾酒。"},{"Content":"龟鹤仙人来献寿。"},{"Content":"欢声喜气逐时新，"},{"Content":"青鬓玉颜长似旧。"}]},{"Id":198187,"GroupIndex":9,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"13","Rank":0,"Title":{"Content":"木兰花/玉楼春"},"TuneId":{"Id":273},"Clauses":[{"Content":"春葱指甲轻拢撚。"},{"Content":"五彩条垂双袖卷。"},{"Content":"雪香浓透紫檀槽，"},{"Content":"胡语急随红玉腕。","BreakAfter":"1"},{"Content":"当头一曲情无限。"},{"Content":"入破铮鏦金凤战。"},{"Content":"百分芳酒祝长春，"},{"Content":"再拜敛容抬粉面。"}]},{"Id":198177,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"5","Rank":0,"Title":{"Content":"凤衔杯"},"TuneId":{"Id":274},"Clauses":[{"Content":"青蘋昨夜秋风起。"},{"Content":"无限个露莲相倚。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"独凭朱阑愁放晴天际。","Comments":[{"Content":"、","Type":"Text","Index":4}]},{"Content":"空目断遥山翠。","Comments":[{"Content":"、","Type":"Text","Index":3}],"BreakAfter":"1"},{"Content":"彩笺长，"},{"Content":"锦书细。"},{"Content":"谁信道两情难寄。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"可惜良辰好景欢娱地。","Comments":[{"Content":"、","Type":"Text","Index":6}]},{"Content":"只恁空憔悴。"}]},{"Id":198176,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"4","Rank":0,"Title":{"Content":"凤衔杯"},"TuneId":{"Id":274},"Clauses":[{"Content":"留花不住怨花飞。"},{"Content":"向南园情绪依依。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"可惜倒红斜白一枝枝。","Comments":[{"Content":"、","Type":"Text","Index":6}]},{"Content":"经宿雨又离披。","Comments":[{"Content":"、","Type":"Text","Index":3}],"BreakAfter":"1"},{"Content":"凭朱槛，"},{"Content":"把金卮。"},{"Content":"对芳丛惆怅多时。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"何况旧欢新恨阻心期。","Comments":[{"Content":"、","Type":"Text","Index":6}]},{"Content":"空满眼是相思。","Comments":[{"Content":"、","Type":"Text","Index":3}]}]},{"Id":198178,"GroupIndex":3,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"10","Rank":0,"Title":{"Content":"凤衔杯"},"TuneId":{"Id":274},"Clauses":[{"Content":"柳条花颣恼青春。"},{"Content":"更那堪飞絮纷纷。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"一曲细丝清脆倚朱唇。","Comments":[{"Content":"、","Type":"Text","Index":6}]},{"Content":"斟绿酒掩红巾。","Comments":[{"Content":"、","Type":"Text","Index":3}],"BreakAfter":"1"},{"Content":"追往事，"},{"Content":"惜芳辰。"},{"Content":"暂时间留住行云。","Comments":[{"Content":"、","Type":"Text","Index":3}]},{"Content":"端的自家心下眼中人。","Comments":[{"Content":"、","Type":"Text","Index":6}]},{"Content":"到处里觉尖新。","Comments":[{"Content":"、","Type":"Text","Index":3}]}]},{"Id":198291,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rhyme":"5","Rank":0,"Title":{"Content":"鹊踏枝/蝶恋花"},"TuneId":{"Id":304},"Clauses":[{"Content":"紫府群仙名籍秘。"},{"Content":"五色斑龙，"},{"Content":"暂降人间媚。"},{"Content":"海变桑田都不记。"},{"Content":"蟠桃一熟三千岁。","BreakAfter":"1"},{"Content":"露滴彩旌云绕袂。"},{"Content":"谁信壶中，"},{"Content":"别有笙歌地。"},{"Content":"门外落花随水逝。"},{"Content":"相看莫惜尊前醉。"}]},{"Id":198288,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rank":0,"Title":{"Content":"喜迁莺"},"TuneId":{"Id":138},"Clauses":[{"Content":"风转蕙，"},{"Content":"露催莲。"},{"Content":"莺语尚绵蛮。"},{"Content":"尧蓂随月欲团圆。"},{"Content":"真驭降荷兰。","BreakAfter":"1"},{"Content":"褰油幕。"},{"Content":"调清乐。"},{"Content":"四海一家同乐。"},{"Content":"千官心在玉炉香。"},{"Content":"圣寿祝天长。"}]},{"Id":198285,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"词","TypeDetail":"Ci","Rank":0,"Title":{"Content":"喜迁莺"},"TuneId":{"Id":138},"Clauses":[{"Content":"歌敛黛，"},{"Content":"舞萦风。"},{"Content":"迟日象筵中。"},{"Content":"分行珠翠簇繁红。"},{"Content":"云髻袅珑璁。","BreakAfter":"1"},{"Content":"金炉暖。"},{"Content":"龙香远。"},{"Content":"共祝尧龄万万。"},{"Content":"曲终休解画罗衣。"},{"Content":"留伴彩云飞。"}]}],"Count":360,"PageNo":13,"PageSize":20}