{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80903,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"和宋次道西都元日怀不疑并见寄"},"Clauses":[{"Content":"露冕优分竹，"},{"Content":"题舆佐画圻。"},{"Content":"比年携手乐，"},{"Content":"兹日赏心违。"},{"Content":"斋祀春来并，"},{"Content":"娱游别后稀。"},{"Content":"谁怜从窭卒，"},{"Content":"草际犯寒归。"}]},{"Id":81085,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"送周寺丞畋知洛南"},"Clauses":[{"Content":"太华指商于，"},{"Content":"中间百里馀。"},{"Content":"稍行山驿远，"},{"Content":"渐与世尘疏。"},{"Content":"楚塞参差接，"},{"Content":"秦民错杂居。"},{"Content":"惜哉非綮肯，"},{"Content":"不足试投虚。"}]},{"Id":81078,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"萧","Rank":0,"Title":{"Content":"送张景淳知邵武军"},"Clauses":[{"Content":"闽岭窅何在，"},{"Content":"东南千里遥。"},{"Content":"仳离伤草草，"},{"Content":"会合更迢迢。"},{"Content":"隋岸微吹絮，"},{"Content":"吴江欲上潮。"},{"Content":"肯无同舍念，"},{"Content":"回首弭轻桡。"}]},{"Id":81569,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"送章伯镇知湖州"},"Clauses":[{"Content":"江外饶佳郡，"},{"Content":"吴兴天下稀。"},{"Content":"莼羹紫丝滑，"},{"Content":"鲈脍雪花肥。"},{"Content":"星斗寒相照，"},{"Content":"烟波碧四围。"},{"Content":"柳侯还作牧，"},{"Content":"草树转清辉。"}]},{"Id":81038,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"Title":{"Content":"送王伯初通判婺州"},"Clauses":[{"Content":"煜爚屏星驾，"},{"Content":"迢遥婺女区。"},{"Content":"岚光晴向背，"},{"Content":"溪溜暖萦纡。"},{"Content":"万室鸣机杼，"},{"Content":"千艘隘舶舻。"},{"Content":"若逢耆旧问，"},{"Content":"能说隐侯无。"}]},{"Id":81098,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"送昭远兄归陜"},"Clauses":[{"Content":"种种亲头白，"},{"Content":"帝城难少留。"},{"Content":"倚门应有望，"},{"Content":"列鼎本无求。"},{"Content":"清夜多归梦，"},{"Content":"红尘厌久游。"},{"Content":"此行殊捧檄，"},{"Content":"辕下五骅骝。"}]},{"Id":81161,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"寄清逸魏处士"},"Clauses":[{"Content":"乡树三摇落，"},{"Content":"临风歌式微。"},{"Content":"徒嗟俗缘重，"},{"Content":"端使素心违。"},{"Content":"茅阁松杉冷，"},{"Content":"山园药草肥。"},{"Content":"不能如海燕，"},{"Content":"岁岁一西飞。"}]},{"Id":81035,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"送云卿知卫州"},"Clauses":[{"Content":"汗简成新令，"},{"Content":"褰帷刺剧州。"},{"Content":"韦平家法在，"},{"Content":"邵杜治声优。"},{"Content":"野竹交淇水，"},{"Content":"秋瓜蔓帝邱。"},{"Content":"三年归奉计，"},{"Content":"肯顾石渠游。"}]},{"Id":81089,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"送昌言知宿州"},"Clauses":[{"Content":"炜炜符离守，"},{"Content":"中流簇鼓旂。"},{"Content":"柳阴浓不断，"},{"Content":"舟势激如飞。"},{"Content":"魏阙行归奏，"},{"Content":"承明秪暂违。"},{"Content":"星轺晨夜度，"},{"Content":"尺素勿令稀。"}]},{"Id":81100,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"送济川知汉州二首"},"Clauses":[{"Content":"金马从容乐，"},{"Content":"问君何所之。"},{"Content":"客心彯若梗，"},{"Content":"亲发皓如丝。"},{"Content":"旧学已孤陋，"},{"Content":"素交仍别离。"},{"Content":"执经时有问，"},{"Content":"使我复从谁。"}]},{"Id":81099,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"送济川知汉州二首"},"Clauses":[{"Content":"千骑拥朱轓，"},{"Content":"青霞昼绣还。"},{"Content":"复寻题柱迹，"},{"Content":"重过弃繻关。"},{"Content":"晓栈流云湿，"},{"Content":"秋湖脱叶殷。"},{"Content":"久游今得意，"},{"Content":"真不愧江山。"}]},{"Id":81581,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"哭公素"},"Clauses":[{"Content":"负书游上国，"},{"Content":"拾芹取荣名。"},{"Content":"雅度津涯阔，"},{"Content":"高文风雨惊。"},{"Content":"忘怀翻得谤，"},{"Content":"纵酒遂伤生。"},{"Content":"忍使泉台客，"},{"Content":"悁悁不自明。"}]},{"Id":499427,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"哭公素"},"Clauses":[{"Content":"丹旌倚輤车，"},{"Content":"荣辱尽虚无。"},{"Content":"半道骅骝顿，"},{"Content":"先秋兰雨枯。"},{"Content":"儿痴才过龀，"},{"Content":"亲老不胜扶。"},{"Content":"家事今萧瑟，"},{"Content":"宁将未第殊。"}]},{"Id":81111,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"送程端明知成都"},"Clauses":[{"Content":"高阳将幕开，"},{"Content":"濯锦使旌来。"},{"Content":"欲识关头雪，"},{"Content":"正如江上梅。"},{"Content":"宵衣矜远俗，"},{"Content":"露冕寄良才。"},{"Content":"岂待三年最，"},{"Content":"脩梧茂帝台。"}]},{"Id":80727,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"丁尚书挽词二首"},"Clauses":[{"Content":"凤跸游汾曲，"},{"Content":"非熊得伟人。"},{"Content":"闺台尤显重，","Comments":[{"Content":"原作光，据陈本、四库本改","Type":"Text","Index":3}]},{"Content":"训诰愈深淳。"},{"Content":"论道参黄阁，"},{"Content":"横经侍紫宸。"},{"Content":"如何天不整，"},{"Content":"志业未全伸。"}]},{"Id":80726,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"丁尚书挽词二首"},"Clauses":[{"Content":"丹阙晨趋退，"},{"Content":"萧然忘世荣。"},{"Content":"闲斋虚自白，"},{"Content":"永日澹无营。"},{"Content":"脱落簪缨累，"},{"Content":"沈冥丘壑情。"},{"Content":"贪夫诚有激，"},{"Content":"千载素风清。"}]},{"Id":81325,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"小园晚饮","Comments":[{"Content":"赋得春字","Type":"Text","Index":4}]},"Clauses":[{"Content":"公府丰暇豫，"},{"Content":"真成弃掷春。"},{"Content":"招邀俱胜友，"},{"Content":"烂漫醉芳辰。"},{"Content":"花艳秾无敌，"},{"Content":"文锋健有神。"},{"Content":"犹胜拥朱墨，"},{"Content":"终日坐埃尘。"}]},{"Id":80860,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"李花","Comments":[{"Content":"得韵同前。一作董嗣杲诗","Type":"Text","Index":2}]},"Clauses":[{"Content":"嘉李繁相倚，"},{"Content":"园林淡泊春。"},{"Content":"齐纨剪衣薄，"},{"Content":"吴纻下机新。"},{"Content":"色与晴光乱，"},{"Content":"香和露气匀。"},{"Content":"望中皆玉树，"},{"Content":"环堵不为贫。"}]},{"Id":80783,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"东窗"},"Clauses":[{"Content":"临风梳短发，"},{"Content":"萧飒晚凉新。"},{"Content":"不识市朝客，"},{"Content":"何如江海人。"},{"Content":"沈吟凭棐几，"},{"Content":"攲侧带纱巾。"},{"Content":"浊世事无尽，"},{"Content":"东窗聊放神。"}]},{"Id":81280,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"奉和始平公酬大资政吴侍郎"},"Clauses":[{"Content":"道盛经纶业，"},{"Content":"文高翰墨场。"},{"Content":"雍容偃藩地，"},{"Content":"密迩钓璜乡。"},{"Content":"回首红尘远，"},{"Content":"清心白日长。"},{"Content":"山形抱城堞，"},{"Content":"溪影照公堂。"}]}],"Count":1270,"PageNo":9,"PageSize":20}