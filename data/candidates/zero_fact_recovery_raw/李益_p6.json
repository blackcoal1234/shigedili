{"Authors":{"Names":["李益"],"AuthorIds":[15274],"Dynasties":["Tang"]},"ShiData":[{"Id":28391,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"霰","Rank":0,"Title":{"Content":"赋得早燕送别"},"Clauses":[{"Content":"碧草缦如线，","Comments":[{"Content":"一作漫","Type":"Text","Index":3}]},{"Content":"去来双飞燕。"},{"Content":"长门未有春，"},{"Content":"先入班姬殿。"},{"Content":"梁空绕不息，","Comments":[{"Content":"一作复","Type":"Text","Index":4}]},{"Content":"檐寒窥欲遍。"},{"Content":"今至随红萼，","Comments":[{"Content":"一作蕊","Type":"Text","Index":5}]},{"Content":"昔还悲素扇。"},{"Content":"一别与秋鸿，"},{"Content":"差池讵相见。"}],"Comments":[{"Book":"《辍锻录》","Content":"咏物题极难，初唐如李巨山多至百首，但有赋体，绝无比兴，痴肥重浊，止增厌恶。惟子美咏物绝佳，如咏鹰、咏马诸作，有写生家所不到。贞元、大历诸名家，咏物绝少。唯李君虞《早燕》云：“梁空绕复息，檐寒窥欲遍。”直是追魂摄魄之语，馀无所见。元和以后，下逮晚唐，咏物诗极多，纵极巧妙，总不免描眉画角，小家举止，不独求如杜之咏马、咏鹰不可得见，即求如李之《早燕》大方而自然者，亦难之难矣。","IsComment":false,"FullPath":"《辍锻录》"}]},{"Id":28375,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"支","Rank":0,"Title":{"Content":"秋晚溪中寄怀大理齐司直","Comments":[{"Content":"时齐分司洛下，有东山之期。","Type":"Text","Index":11}]},"Clauses":[{"Content":"凤翔属明代，"},{"Content":"羽翼文葳蕤。"},{"Content":"昆崙进琪树，"},{"Content":"飞舞下瑶池。"},{"Content":"振仪自西眷，"},{"Content":"东夏复分釐。"},{"Content":"国典唯平法，"},{"Content":"伊人方在斯。"},{"Content":"荒宁桁杨肃，","Comments":[{"Content":"一作亭","Type":"Text","Index":2}]},{"Content":"芳辉兰玉滋。"},{"Content":"明质鹜高景，"},{"Content":"飘飖服缨绥。"},{"Content":"天寒清洛苑，"},{"Content":"秋夕白云司。"},{"Content":"况复空岩侧，"},{"Content":"苍苍幽桂期。"},{"Content":"岁寒坐流霰，"},{"Content":"山川犹别离。"},{"Content":"浩思凭尊酒，"},{"Content":"氛氲独含辞。"}]},{"Id":28392,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"0","Rank":0,"Title":{"Content":"溪中月下寄杨子尉封亮"},"Clauses":[{"Content":"蘅若夺幽色，"},{"Content":"衔思恍无悰。"},{"Content":"宵长霜雾多，","Comments":[{"Content":"一作霰","Type":"Text","Index":4}]},{"Content":"岁晏淮海风。"},{"Content":"团团山中月，"},{"Content":"三五离夕同。","Comments":[{"Content":"一作席","Type":"Text","Index":4}]},{"Content":"露凝朱弦绝，"},{"Content":"觞至兰玉空。"},{"Content":"清光液流波，"},{"Content":"盛明难再逢。"},{"Content":"尝恐河汉远，"},{"Content":"坐窥烟景穷。"},{"Content":"小人谅处阴，"},{"Content":"君子树大功。","Comments":[{"Content":"一作元","Type":"Text","Index":4}]},{"Content":"永愿厉高翼，"},{"Content":"慰我丹桂丛。"}]},{"Id":28374,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"纸","Rank":0,"Title":{"Content":"春晚赋得馀花落","Comments":[{"Content":"得起字","Type":"Text","Index":7}]},"Clauses":[{"Content":"留春春竟去，"},{"Content":"春去花如此。"},{"Content":"蝶舞绕应稀，"},{"Content":"鸟惊飞讵已。"},{"Content":"衰红辞故萼，"},{"Content":"繁绿扶彫蕊。"},{"Content":"自委不胜愁，"},{"Content":"庭风那更起。"}],"Comments":[{"Book":"《载酒园诗话又编》","Content":"此篇与“应门照绿苔”作体格相似，皆有横波回睇之妙。","IsComment":false,"FullPath":"《载酒园诗话又编》"},{"Book":"《大历诗略》","Content":"次句情韵生于语妙，五六尤细丽绝伦，阴铿、庾信不过是也。","IsComment":false,"FullPath":"《大历诗略》"}]},{"Id":28380,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"31","Rank":0,"Title":{"Content":"校书郎杨凝往年以古镜贶别今追赠以诗"},"Clauses":[{"Content":"明镜出匣时，"},{"Content":"明如云间月。"},{"Content":"一别青春鉴，"},{"Content":"回光照华发。"},{"Content":"美人昔自爱，"},{"Content":"鞶带手中结。","Comments":[{"Content":"一作所","Type":"Text","Index":4}]},{"Content":"愿以三五期，","Comments":[{"Content":"一作似","Type":"Text","Index":2}]},{"Content":"经天无玷缺。"}]},{"Id":28393,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"30","Rank":0,"Title":{"Content":"置酒行","Comments":[{"Content":"一本无行字","Type":"Text","Index":3}]},"Clauses":[{"Content":"置酒命所欢，"},{"Content":"凭觞遂为戚。"},{"Content":"日往不再来，"},{"Content":"兹辰坐成昔。"},{"Content":"百龄非久长，"},{"Content":"五十将半百。"},{"Content":"胡为劳我形，"},{"Content":"已须还复白。","Comments":[{"Content":"一作鬓，又作鬒","Type":"Text","Index":2}]},{"Content":"西山鸾鹤群，","Comments":[{"Content":"一作顾","Type":"Text","Index":5}]},{"Content":"矫矫烟雾翮。"},{"Content":"明霞发金丹，","Comments":[{"Content":"一作诀","Type":"Text","Index":2}]},{"Content":"阴洞潜水碧。"},{"Content":"安得凌风羽，"},{"Content":"崦嵫驻灵魄。"},{"Content":"无然坐衰老，"},{"Content":"惭叹东陵柏。","Comments":[{"Cont