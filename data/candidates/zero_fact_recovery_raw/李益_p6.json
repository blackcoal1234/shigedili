,{"Content":"暗水入寒塘。"},{"Content":"客心定何似，"},{"Content":"馀欢方自长。"}]},{"Id":28359,"Allusions":[{"AllusionIndex":9836,"AllusionKey":"一戎","SentenceIndex":3}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"12","Rank":0,"Title":{"Content":"北至太原"},"Clauses":[{"Content":"炎祚昔昏替，"},{"Content":"皇基此郁盘。"},{"Content":"玄命久已集，"},{"Content":"抚运良乃艰。","Comments":[{"Content":"一作乃良","Type":"Text","Index":4}]},{"Content":"南阨羊肠险，"},{"Content":"北走雁门寒。"},{"Content":"始于一戎定，","Comments":[{"Content":"一戎","Type":"AllusionKey","Index":4}]},{"Content":"垂此亿世安。"},{"Content":"唐风本忧思，"},{"Content":"王业寔艰难。"},{"Content":"中历虽横溃，"},{"Content":"天纪未可干。"},{"Content":"圣明所兴国，"},{"Content":"灵岳固不殚。"},{"Content":"咄咄薄游客，"},{"Content":"斯言殊不刊。"}]},{"Id":28351,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"28","Rank":0,"Title":{"Content":"入华山访隐者经仙人石坛"},"Clauses":[{"Content":"三考四岳下，","Comments":[{"Content":"一作西","Type":"Text","Index":3}]},{"Content":"官曹少休沐。"},{"Content":"久负青山诺，"},{"Content":"今还获所欲。"},{"Content":"尝闻玉清洞，"},{"Content":"金简受玄箓。"},{"Content":"夙驾升天行，"},{"Content":"云游恣霞宿。","Comments":[{"Content":"一作云霞恣游宿","Type":"Text","Index":5}]},{"Content":"平明矫轻策，"},{"Content":"扪石入空曲。"},{"Content":"仙人古石坛，"},{"Content":"苔绕青瑶局。"},{"Content":"阳桂凌烟紫，"},{"Content":"阴萝冒水绿。"},{"Content":"隔世闻丹经，","Comments":[{"Content":"一作山","Type":"Text","Index":2}]},{"Content":"悬泉注明玉。"},{"Content":"前惊羽人会，"},{"Content":"白日天居肃。"},{"Content":"问我将致辞，"},{"Content":"笑之自相目。"},{"Content":"竦身云遂起，"},{"Content":"仰见双白鹄。"},{"Content":"堕其一纸书，"},{"Content":"文字类鸟足。"},{"Content":"视之了不识，"},{"Content":"三返又三复。"},{"Content":"归来问方士，"},{"Content":"举世莫解读。"},{"Content":"何必若蜉蝣，"},{"Content":"然后为跼促。"},{"Content":"鄙哉宦游子，"},{"Content":"身志俱降辱。"},{"Content":"再往不及期，"},{"Content":"劳歌叩山木。"}]},{"Id":28363,"Allusions":[{"AllusionIndex":246,"AllusionKey":"三刖","SentenceIndex":9},{"AllusionIndex":3385,"AllusionKey":"五里仙雾","SentenceIndex":4}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"陌","Rank":0,"Title":{"Content":"华阴东泉同张处士诣藏律师兼简县内同官因寄齐中书"},"Clauses":[{"Content":"苍崖抱寒泉，"},{"Content":"沦照洞金碧。"},{"Content":"潜鳞孕明晦，"},{"Content":"山灵閟幽赜。","Comments":[{"Content":"一作精","Type":"Text","Index":4}]},{"Content":"前峰何其诡，"},{"Content":"万变穷日夕。"},{"Content":"松老风易悲，"},{"Content":"山秋云更白。"},{"Content":"故人邑中吏，"},{"Content":"五里仙雾隔。","Comments":[{"Content":"五里仙雾","Type":"AllusionKey","Index":4}]},{"Content":"美质简琼瑶，"},{"Content":"英声铿金石。"},{"Content":"烦君竟相问，"},{"Content":"问我此何适。"},{"Content":"我因赞时理，"},{"Content":"书寄西飞翮。"},{"Content":"哲匠熙百工，"},{"Content":"日月被光泽。"},{"Content":"大国本多士，"},{"Content":"荆岑无遗璧。"},{"Content":"高网弥八纮，"},{"Content":"皇图明四辟。"},{"Content":"群材既兼畅，"},{"Content":"顾我在草泽。"},{"Content":"贵无身外名，"},{"Content":"贱有区中役。"},{"Content":"忽忽百龄内，"},{"Content":"殷殷千虑迫。"},{"Content":"人生已如寄，"},{"Content":"在寄复为客。"},{"Content":"旧国不得归，"},{"Content":"风尘满阡陌。"}]},{"Id":28389,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"萧","Rank":0,"Title":{"Content":"答郭黄中孤云首章见赠"},"Clauses":[{"Content":"孤云生西北，"},{"Content":"从风东南飘。"},{"Content":"帝乡日已远，"},{"Content":"苍梧无还飙。"},{"Content":"已矣玄凤叹，"},{"Content":"严霜集灵苕。"},{"Content":"君其勉我怀，"},{"Content":"岁暮孰不彫。"}]},{"Id":28365,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"屑","Rank":0,"Title":{"Content":"竹溪"},"Clauses":[{"Content":"访竹越云崖，"},{"Content":"即林若溪绝。"},{"Content":"宁知修干下，"},{"Content":"漠漠秋苔洁。"},{"Content":"清光溢空曲，"},{"Content":"茂色临幽澈。"},{"Content":"采摘愧芳鲜，"},{"Content":"奉君岁暮节。"}]},{"Id":28377,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"宥","Rank":0,"Title":{"Content":"送诸暨王主簿之任"},"Clauses":[{"Content":"别愁已万绪，"},{"Content":"离曲方三奏。"},{"Content":"远宦一辞乡，"},{"Content":"南天异风候。"},{"Content":"秦城岁芳老，"},{"Content":"越国春山秀。"},{"Content":"落日望寒涛，"},{"Content":"公门闭清昼。"},{"Content":"何用慰相思，"},{"Content":"裁书寄关右。"}]},{"Id":28381,"Allusions":[{"AllusionIndex":1012,"AllusionKey":"不死庭","SentenceIndex":1},{"AllusionIndex":8953,"AllusionKey":"五老","SentenceIndex":-1}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"青","Rank":0,"Title":{"Content":"罢秩后入华山采茯苓逢道者"},"Clauses":[{"Content":"委绶来名山，","Comments":[{"Content":"一作采","Type":"Text","Index":3}]},{"Content":"观奇恣所停。"},{"Content":"山中若有闻，"},{"Content":"言此不死庭。","Comments":[{"Content":"不死庭","Type":"AllusionKey","Index":5}]},{"Content":"遂逢五老人，","Comments":[{"Content":"五老","Type":"AllusionKey","Index":4}]},{"Content":"一谓西岳灵。"},{"Content":"或闻樵人语，"},{"Content":"飞去入昴星。"},{"Content":"授我出云路，"},{"Content":"苍然凌石屏。"},{"Content":"视之有文字，"},{"Content":"乃古黄庭经。"},{"Content":"左右长松列，"},{"Content":"动摇风露零。"},{"Content":"上蟠千年枝，"},{"Content":"阴虬负青冥。"},{"Content":"下结九秋霰，"},{"Content":"流膏为茯苓。"},{"Content":"取之砂石间，"},{"Content":"异若龟鹤形。"},{"Content":"况闻秦宫女，"},{"Content":"华发变已青。"},{"Content":"有如上帝心，"},{"Content":"与我千万龄。"},{"Content":"始疑有仙骨，"},{"Content":"鍊魂可永宁。"},{"Content":"何事逐豪游，"},{"Content":"饮啄以膻腥。"},{"Content":"神物亦自閟，"},{"Content":"风雷护此扃。"},{"Content":"欲传山中宝，"},{"Content":"回策忽已暝。"},{"Content":"乃悲世上人，"},{"Content":"求醒终不醒。"}]},{"Id":28366,"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"筱","Rank":0,"Title":{"Content":"自朔方还与郑式瞻崔称郑子周岑赞同会法云寺三门避暑"},"Clauses":[{"Content":"予本疏放士，"},{"Content":"朅来非外矫。"},{"Content":"误落边尘中，"},{"Content":"爱山见山少。"},{"Content":"始投清凉宇，"},{"Content":"门值烟岫表。"},{"Content":"参差互明灭，"},{"Content":"彩翠竟昏晓。"},{"Content":"泠泠远风来，"},{"Content":"过此群木杪。"},{"Content":"英英二三彦，"},{"Content":"襟旷去烦扰。","Comments":[{"Content":"一作挠","Type":"Text","Index":5}]},{"Content":"游川出潜鱼，"},{"Content":"息阴倦飞鸟。"},{"Content":"徇物不可穷，"},{"Content":"唯于此心了。"}]},{"Id":28369,"Classes":["軍旅 軍士"],"Allusions":[{"AllusionIndex":961,"AllusionKey":"不封侯","SentenceIndex":16},{"AllusionIndex":1607,"AllusionKey":"琴下雍门泪","SentenceIndex":12},{"AllusionIndex":2509,"AllusionKey":"窦车骑","SentenceIndex":2},{"AllusionIndex":6693,"AllusionKey":"平乐","SentenceIndex":13}],"Dynasty":"中唐","Author":"李益","AuthorId":15274,"Type":"古风","TypeDetail":"GuFeng","Rhyme":"5","Rank":0,"Title":{"Content":"来从窦车骑行","Comments":[{"Content":"自朔方行作","Type":"Text","Index":6}]},"Clauses":[{"Content":"束发逢世屯，"},{"Content":"怀恩抱明义。"},{"Content":"读书良有感，","Comments":[{"Content":"一作不武","Type":"Text","Index":5}]},{"Content":"学剑惭非智。"},{"Content":"遂别鲁诸生，"},{"Content":"来从窦车骑。","Comments":[{"Content":"窦车骑","Type":"AllusionKey","Index":5}]},{"Content":"追兵赴边急，"},{"Content":"络马黄金辔。"},{"Content":"出入燕南陲，"},{"Content":"由来重意气。"},{"Content":"自经皋兰战，"},{"Content":"又破楼烦地。","Comments":[{"Content":"一作入","Type":"Text","Index":1}]},{"Content":"西北护三边，"},{"Content":"东南留一尉。"},{"Content":"时过歘如云，","Comments":[{"Content":"一作如云雨","Type":"Text","Index":5}]},{"Content":"参差不自意。","Comments":[{"Content":"一作自不","Type":"Text","Index":4}]},{"Content":"将军失恩泽，"},{"Content":"万事从此异。"},{"Content":"置酒高台上，"},{"Content":"薄暮秋风至。"},{"Content":"长戟与我归，"},{"Content":"归来同弃置。"},{"Content":"自酌还自饮，"},{"Content":"非名又非利。"},{"Content":"歌出易水寒，"},{"Content":"琴下雍门泪。","Comments":[{"Content":"琴下雍门泪","Type":"AllusionKey","Index":5}]},{"Content":"出逢平乐旧，","Comments":[{"Content":"平乐","Type":"AllusionKey","Index":4}]},{"Content":"言在天阶侍。"},{"Content":"问我从军苦，"},{"Content":"自陈少年贵。"},{"Content":"丈夫交四海，"},{"Content":"徒论身自致。"},{"Content":"汉将不封侯，","Comments":[{"Content":"不封侯","Type":"AllusionKey","Index":5}]},{"Content":"苏卿劳远使。","Comments":[{"Content":"一作来，又作还","Type":"Text","Index":3}]},{"Content":"今我终此曲，"},{"Content":"此曲诚不易。"},{"Content":"贵人难识心，"},{"Content":"何由知忌讳。"}]}],"Count":169,"PageNo":6,"PageSize":20}