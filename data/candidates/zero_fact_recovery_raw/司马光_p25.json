{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":81049,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"灰","Rank":0,"Title":{"Content":"送仲更归泽州"},"Clauses":[{"Content":"太行横拥巨川回，"},{"Content":"三晋由来产异才。"},{"Content":"展墓乘春走乡陌，"},{"Content":"负书拂晓下兰台。"},{"Content":"河阳路侧花应合，"},{"Content":"天井关头雪未开。"},{"Content":"会使乡人惊六印，"},{"Content":"莫羞今日弊裘来。"}]},{"Id":81198,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"寒食御筵口号二首"},"Clauses":[{"Content":"雨意沉沉泼火馀，"},{"Content":"夔龙盛集退朝初。"},{"Content":"酒殽络绎来丹禁，"},{"Content":"冠剑参差下玉除。"},{"Content":"紫凤归飞云烂漫，"},{"Content":"黄鹂新啭柳扶疏。"},{"Content":"麦禾满野边烽息，"},{"Content":"佳节何妨赋乐胥。"}]},{"Id":81197,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"寒食御筵口号二首"},"Clauses":[{"Content":"圣主褒优鼎轴臣，"},{"Content":"金觞玉醴照青春。"},{"Content":"万家烟火朝来静，"},{"Content":"九陌风光雨后新。"},{"Content":"高燕翔飞惊紫绶，","Comments":[{"Content":"陈本、四库本作翻","Type":"Text","Index":3}]},{"Content":"馀光点缀托朱轮。"},{"Content":"问牛因得观民俗，"},{"Content":"不独嬉游惜令辰。"}]},{"Id":81105,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"送晁校理知怀州","Comments":[{"Content":"仲衍，字子长","Type":"Text","Index":4}]},"Clauses":[{"Content":"鸡犬相闻桑柘春，"},{"Content":"风光明润帝乡邻。"},{"Content":"群峰斜转太行角，"},{"Content":"万谷同趋马颊津。"},{"Content":"簪组倾都邀别袂，"},{"Content":"壶浆满路候行尘。"},{"Content":"非君厌薄承明直，"},{"Content":"天子方今重治人。"}]},{"Id":80732,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"微","Rank":0,"Title":{"Content":"二月三十日与同舍宴李氏园晚归马上赋诗","Comments":[{"Content":"用归字韵","Type":"Text","Index":18}]},"Clauses":[{"Content":"门前蹀躞金羁满，"},{"Content":"坐上连翩玉斝飞。"},{"Content":"数尺游丝留客醉，"},{"Content":"一行垂柳送人归。"},{"Content":"同邀胜友时难得，"},{"Content":"重到名园花已稀。"},{"Content":"莫惜芳辰剩行乐，"},{"Content":"无端风雨横相违。"}]},{"Id":81219,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"答刘原父贺庞公惠炭","Comments":[{"Content":"陈本、四库本作谢","Type":"Text","Index":5}]},"Clauses":[{"Content":"东郭先生履半穿，"},{"Content":"御冬深愧主人贤。"},{"Content":"应怜道上雪欲积，"},{"Content":"意使炉中灰复然。"},{"Content":"曲糵暗添寒酒力，"},{"Content":"图书共免湿薪烟。"},{"Content":"茅斋斗似饶光彩，"},{"Content":"客至何忧腊后天。"}]},{"Id":81171,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"寄题常州东山亭二首"},"Clauses":[{"Content":"谢傅英声高可攀，"},{"Content":"结茅积土想东山。"},{"Content":"常忧胜概一朝尽，"},{"Content":"岂信风流千古还。"},{"Content":"麈尾蒲葵供永日，"},{"Content":"酒樽棋局奉欢颜。"},{"Content":"贤侯心迹遥相望，"},{"Content":"不使兰陵风月闲。"}]},{"Id":81170,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"寄题常州东山亭二首"},"Clauses":[{"Content":"阀阅崔嵬动四方，"},{"Content":"入门鸾鹤自成行。"},{"Content":"青緺旧已临佳郡，"},{"Content":"墨客新归耀故乡。"},{"Content":"醉舞几应摧屐齿，"},{"Content":"对棋正欲赌香囊。"},{"Content":"阶庭玉树寒相照，"},{"Content":"更使东山逸气长。"}]},{"Id":80779,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"王金吾北园"},"Clauses":[{"Content":"丞相后园天籞邻，"},{"Content":"年年分借上林春。"},{"Content":"目前但识禽鱼乐，"},{"Content":"门外何妨车马尘。"},{"Content":"花蘤祗疑名品尽，"},{"Content":"图书方验古今贫。"},{"Content":"将军朝下无馀事，"},{"Content":"端为风烟作主人。"}]},{"Id":81065,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"豪","Rank":0,"FirstClauseRhyme":"豪","Title":{"Content":"送齐学士知荆南","Comments":[{"Content":"廓，字公辟","Type":"Text","Index":4}]},"Clauses":[{"Content":"汉家太守治才高，"},{"Content":"楚国山川气象豪。"},{"Content":"旗旆逶迤蟠梦泽，"},{"Content":"楼船赑屃压江涛。"},{"Content":"雄名谁复知宣武，"},{"Content":"遗爱犹应祀叔敖。"},{"Content":"何必三年求奏计，"},{"Content":"诏书朝夕赐金褒。"}]},{"Id":81458,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"和始平公贻一二宾僚"},"Clauses":[{"Content":"儒冠蔼蔼从平津，"},{"Content":"东阁由来盛众宾。"},{"Content":"终始何尝忘教育，"},{"Content":"高卑曾不间疏亲。"},{"Content":"共陪樽俎无虚日，"},{"Content":"空喜溪山得主人。"},{"Content":"白雪屡歌殊未和，"},{"Content":"自知羞愧后车尘。"}]},{"Id":80936,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"萧","Rank":0,"FirstClauseRhyme":"萧","Title":{"Content":"和始平公长句寄汉州何学士"},"Clauses":[{"Content":"势交倏忽易萧条，"},{"Content":"赖有伊人尚建标。"},{"Content":"须信松筠凌雪茂，"},{"Content":"肯为蒲柳望秋凋。"},{"Content":"钦贤高馆三年别，"},{"Content":"广汉专城百舍遥。"},{"Content":"书纸如云诗叩玉，"},{"Content":"数凭疾翼度青霄。"}]},{"Id":81532,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"济川有书见贻云以亲老须守远郡以便禄养不得如光在主人幕下因以诗答"},"Clauses":[{"Content":"千骑骎骎簇画辀，"},{"Content":"高旌大盖五骅骝。"},{"Content":"斋中酒美连翩醉，"},{"Content":"湖上花繁烂漫游。"},{"Content":"鸡犬相闻通故里，"},{"Content":"旨甘不绝奉晨羞。"},{"Content":"只应朝夕平津阁，"},{"Content":"得向君前立胜筹。"}]},{"Id":80972,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"元","Title":{"Content":"奉和始平公喜闻昌言修注"},"Clauses":[{"Content":"凤口除书下九阍，"},{"Content":"簪绅拭目仰殊恩。"},{"Content":"晓提麟笔依华盖，"},{"Content":"日就螭坳记圣言。"},{"Content":"桃李新阴方蔼蔼，"},{"Content":"骅骝老志更轩轩。"},{"Content":"主人喜见相如达，"},{"Content":"趣召邹枚洗玉樽。","Comments":[{"Content":"自注：光与昌言俱出始平公门下。身亡时年五十九。（四库本作昌言时年五十）","Type":"Text","Index":7}]}]},{"Id":81543,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"秋雨霁倏闻宗圣案伎应之饮酒诗呈宜甫","Comments":[{"Content":"陈本、四库本作萧条","Type":"Text","Index":4}]},"Clauses":[{"Content":"寒风细雨未晴天，"},{"Content":"密似轻尘薄似烟。"},{"Content":"一室独吟图史乱，"},{"Content":"四邻高会绮罗鲜。"},{"Content":"雁飞斜柱弦随指，"},{"Content":"蟹荐新螯酒满船。"},{"Content":"自笑不歌仍不饮，"},{"Content":"昏昏只解枕床眠。"}]},{"Id":80970,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"奉和始平公忆东平"},"Clauses":[{"Content":"相印东临汶水阳，"},{"Content":"两看春叶与秋霜。"},{"Content":"登山置酒延邹湛，"},{"Content":"上马回鞭问葛强。"},{"Content":"溪竹低垂寒滴翠，"},{"Content":"露荷相倚净交香。"},{"Content":"宵衣深念长城固，"},{"Content":"肯得从容傲醉乡。"}]},{"Id":80971,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"奉和始平公忆东平"},"Clauses":[{"Content":"千岩秀色拥晴川，"},{"Content":"万顷陂光上下天。"},{"Content":"委地鱼盐随处市，"},{"Content":"蔽空桑柘不容田。"},{"Content":"讼庭虚静官曹乐，"},{"Content":"儒服宽长邑里贤。"},{"Content":"不为从知方负羽，"},{"Content":"独乘鱼艇老风烟。"}]},{"Id":80931,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"和运使舍人北园饯别行憩三交僧舍冒雪宿百井关见寄"},"Clauses":[{"Content":"骊驹北上雪孱颜，"},{"Content":"韊矢前驱度汉关。"},{"Content":"僧室松杉清照眼，"},{"Content":"驿亭烟火迥依山。"},{"Content":"马衔边草枯犹瘦，"},{"Content":"雁怯胡云冷未还。"},{"Content":"贱子不须回首问，"},{"Content":"鬓毛萧飒簿书间。"}]},{"Id":81150,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"陪始平公燕柳溪"},"Clauses":[{"Content":"溪光不动柳风轻，"},{"Content":"玉帐森沈拥万兵。"},{"Content":"鸥入烟中闲自舞，"},{"Content":"鱼翻波面喜相迎。"},{"Content":"楼船下视晴天碧，"},{"Content":"鼓吹前驱远陌清。"},{"Content":"桃李归时应盛发，"},{"Content":"薰然和气满春城。"}]},{"Id":80957,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"冬","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"和道矩送客汾西村舍杏花盛开置酒其下"},"Clauses":[{"Content":"田家繁杏压枝红，"},{"Content":"远胜桃夭与李秾。"},{"Content":"何事偏宜闲处植，"},{"Content":"无端复向别时逢。"},{"Content":"林间暂系黄金勒，"},{"Content":"花下聊飞码碯钟。"},{"Content":"会待重来醉嘉树，"},{"Content":"只愁风雨不相容。"}]}],"Count":1270,"PageNo":25,"PageSize":20}