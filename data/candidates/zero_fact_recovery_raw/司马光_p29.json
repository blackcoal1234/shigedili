{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":81248,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"题传灯录"},"Clauses":[{"Content":"呷著声闻酒便狂，","Comments":[{"Content":"陈本作更","Type":"Text","Index":6}]},{"Content":"它州浪走不归乡。"},{"Content":"谁曾缚汝安用解，"},{"Content":"彼自无创勿误伤。","Comments":[{"Content":"原作枪，据陈本改","Type":"Text","Index":4}]},{"Content":"探月拾针传妄语，"},{"Content":"安居暇食赖先王。"},{"Content":"但令时世如三代，"},{"Content":"达磨从他面向墙。"}]},{"Id":81014,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"独乐园新春"},"Clauses":[{"Content":"春风与汝不相关，"},{"Content":"何事潜来入我园。"},{"Content":"曲沼揉蓝通底绿，"},{"Content":"新梅剪䌽压枝繁。"},{"Content":"短莎乍见殊堪喜，"},{"Content":"鸣鸟初闻未觉喧。"},{"Content":"凭仗东君徐按辔，"},{"Content":"旋添花卉伴芳樽。"}]},{"Id":80962,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"和潞公真率会诗"},"Clauses":[{"Content":"洛下衣冠爱惜春，"},{"Content":"相从小饮任天真。"},{"Content":"随家所有自可乐，"},{"Content":"为具更微谁笑贫。"},{"Content":"不待珍羞方下箸，"},{"Content":"只将佳景便娱宾。"},{"Content":"庾公此兴知非浅，"},{"Content":"藜藿终难继主人。"}]},{"Id":81205,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"景仁书云去冬因酒病耳病牙遂不入洛以诗寄呈"},"Clauses":[{"Content":"许昌携手尽时英，"},{"Content":"况复新开甲第成。"},{"Content":"醉里都将春作达，"},{"Content":"老来不向酒藏情。"},{"Content":"齿疏无废衔杯趣，"},{"Content":"耳病犹分度曲声。"},{"Content":"旧友昔游浑忘却，"},{"Content":"可怜寂寂洛阳城。"}]},{"Id":80738,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"又云新铸釜斛与今太府寺尺及权衡若合符契复次前韵"},"Clauses":[{"Content":"裁筒累黍久研精，"},{"Content":"况复新修釜斛成。"},{"Content":"岂校忽微争口语，"},{"Content":"本期淳古变人情。"},{"Content":"既言乐律符今尺，","Comments":[{"Content":"原作府，据陈本改","Type":"Text","Index":4}]},{"Content":"但恐箫韶似郑声。"},{"Content":"若欲世人俱信服，"},{"Content":"凤凰再集颍川城。"}]},{"Id":80877,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"其夕宿独乐园诘朝将归赋诗"},"Clauses":[{"Content":"平晓何人汲井华，"},{"Content":"辘轳声急散春鸦。"},{"Content":"开园更有四五日，"},{"Content":"映叶尚馀三两花。"},{"Content":"宿病岑岑犹带酒，"},{"Content":"无眠耿耿不禁茶。","Comments":[{"Content":"自注：平声。","Type":"Text","Index":7}]},{"Content":"自嫌行乐妨年少，"},{"Content":"遽索蓝舆且向家。","Comments":[{"Content":"原作与，据陈本改","Type":"Text","Index":4}]}],"Note":"按：清施诚修乾隆《河南府志》卷一○一"},{"Id":80883,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"Title":{"Content":"和子骏洛中书事"},"Clauses":[{"Content":"西都自古繁华地，"},{"Content":"冠盖优游萃五方。"},{"Content":"比户清风人种竹，"},{"Content":"满川浓绿土宜桑。"},{"Content":"凿龙山断开天阙，"},{"Content":"导洛波回载羽觞。"},{"Content":"况有耆英诗酒乐，"},{"Content":"问君何处不如唐。"}]},{"Id":80880,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"删","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"和子华应天院行香归过洛川"},"Clauses":[{"Content":"印节传呼洛北还，"},{"Content":"府庭无讼不妨闲。"},{"Content":"度桥寒色侵春服，"},{"Content":"按辔晴光露晓山。"},{"Content":"香穗徘徊凝广殿，"},{"Content":"花篮繁会满通阛。"},{"Content":"自知白雪高难和，"},{"Content":"忍愧谁能寄我颜。"}]},{"Id":80905,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"和伯常自郢州见寄"},"Clauses":[{"Content":"西郊去岁揖行人，"},{"Content":"柳暗花浓又一春。"},{"Content":"坐想高风清入骨，"},{"Content":"沉吟佳句健生神。"},{"Content":"潺湲杳霭烟波古，","Comments":[{"Content":"自注：来书云郢西雨多，潺湲杳霭。","Type":"Text","Index":7}]},{"Content":"散诞逍遥兴趣新。"},{"Content":"应笑洛阳车马道，"},{"Content":"缁衣未免化红尘。"}]},{"Id":81412,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"和子华喜潞公入觐归置酒游诸园赏牡丹"},"Clauses":[{"Content":"介圭成礼下中天，"},{"Content":"春物虽阑色尚妍。"},{"Content":"园吏望尘皆辟户，"},{"Content":"肩舆回步即开筵。"},{"Content":"波涛凌乱靴旁锦，"},{"Content":"风雨纵横拨底弦。"},{"Content":"洛邑衣冠陪后乘，"},{"Content":"寻花载酒愿年年。"}]},{"Id":80947,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"Title":{"Content":"和吴朝议同年谢光与景仁同年见过","Comments":[{"Content":"执中，字几圣","Type":"Text","Index":4}]},"Clauses":[{"Content":"结绶东堂同发策，"},{"Content":"白头相值益相亲。"},{"Content":"却思景祐无多日，"},{"Content":"共见元丰有几人。"},{"Content":"天下高名归广受，","Comments":[{"Content":"自注：二公皆致仕。","Type":"Text","Index":7}]},{"Content":"古来交道重雷陈。"},{"Content":"谢公身老才方壮，"},{"Content":"落笔成章字字新。"}]},{"Id":80807,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"伏蒙留守相公赐示陪太师潞公东田宴集诗辄敢属和"},"Clauses":[{"Content":"舞雩新雨浃公田，"},{"Content":"水满东溪上下天。"},{"Content":"行径乍迂初见笋，"},{"Content":"浮舟正好未生莲。"},{"Content":"弦收裂帛胡琴阕，"},{"Content":"袖结清风楚舞妍。"},{"Content":"相国火城光满路，"},{"Content":"夜归不假玉蟾圆。"}]},{"Id":80881,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"和子华招潞公暑饮"},"Clauses":[{"Content":"朱门近在府园东，"},{"Content":"杖屦过从跬步中。"},{"Content":"避暑连翩投辖宴，"},{"Content":"析酲萧洒满襟风。"},{"Content":"闲来高韵浑如鹤，"},{"Content":"醉里朱颜却变童。"},{"Content":"剪烛添香欢未极，"},{"Content":"但惊铜漏太匆匆。"}]},{"Id":80815,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"再和伯常见寄"},"Clauses":[{"Content":"诛茅宋玉宅边人，"},{"Content":"知醉宜城几瓮春。"},{"Content":"细雨短蓑渔向市，"},{"Content":"孤村极浦鼓迎神。"},{"Content":"遍游七泽身忘倦，"},{"Content":"更赋千篇意转新。"},{"Content":"不必沧浪羡清泚，"},{"Content":"向来缨上已无尘。"}]},{"Id":80948,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"冬","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"和留守相公九月八日与潞公宴赵令园有怀去年与景仁秉国游赏"},"Clauses":[{"Content":"今岁台星聚洛中，"},{"Content":"甘棠前后雨阴浓。"},{"Content":"英辞唱和诗千首，"},{"Content":"高宴游陪禄万钟。"},{"Content":"木末霜繁花未落，"},{"Content":"云间字小雁相从。"},{"Content":"西湖在望亲朋远，"},{"Content":"节物那堪处处逢。"}]},{"Id":80559,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"删","Title":{"Content":"和张伯常贺迁资政"},"Clauses":[{"Content":"不驾使车开汉关，","Comments":[{"Content":"相如","Type":"Text","Index":7}]},{"Content":"不栖岩穴鍊金丹。","Comments":[{"Content":"自注：子微。","Type":"Text","Index":7}]},{"Content":"岂无开径三人友，"},{"Content":"分著垂緌五寸冠。","Comments":[{"Content":"自注：惰（四库本作堕）游之士。","Type":"Text","Index":7}]},{"Content":"坐饱太仓犹自愧，"},{"Content":"谬跻秘殿益难安。"},{"Content":"愿同野老嬉尧壤，"},{"Content":"长守先生苜蓿盘。"}]},{"Id":81316,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"又和南园真率会见赠"},"Clauses":[{"Content":"白头难入少年场，"},{"Content":"林下相招莫笑狂。"},{"Content":"绿筱影侵棋局暗，"},{"Content":"黄梅花渍酒卮香。"},{"Content":"任真自愧殽羞薄，"},{"Content":"假寐初便枕簟凉。"},{"Content":"酬应诗豪困牵率，"},{"Content":"从来懒放似稽康。"}]},{"Id":81456,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"和陈殿丞芍药"},"Clauses":[{"Content":"化工馀巧惜春残，"},{"Content":"更发浓芳继牡丹。"},{"Content":"檀点藏心殷胜缬，"},{"Content":"异香迎鼻酷如兰。"},{"Content":"琼楼窈窕仙家宅，"},{"Content":"云叶低垂醉里冠。","Comments":[{"Content":"自注：缬子、楼子、□子、醉西施，皆芍药名品。","Type":"Text","Index":7}]},{"Content":"自有殊功存药录，"},{"Content":"不当独取郑诗看。"}]},{"Id":81203,"Classes":["軍旅 要地","軍旅 太平","軍旅 出鎮","軍旅 送行"],"Froms":["全宋文卷一二三○"],"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"元","Rank":0,"FirstClauseRhyme":"文","Title":{"Content":"御宴送李宣徽知真定府口号","Comments":[{"Content":"昭亮","Type":"Text","Index":6}]},"Clauses":[{"Content":"匈奴旧畏李将军，"},{"Content":"今日重来几代孙。"},{"Content":"旗尾飘扬山烧裂，"},{"Content":"马啼腾踏塞尘昏。"},{"Content":"降王稽颡朝南阙，"},{"Content":"天子垂衣御北门。"},{"Content":"幕府事闲刁斗静，"},{"Content":"碧潭佳景日开樽。"}]},{"Id":80825,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"真","Rank":0,"FirstClauseRhyme":"真","Title":{"Content":"庆文公八十会口号"},"Clauses":[{"Content":"元勋茂德古无伦，"},{"Content":"海内高闲第一人。"},{"Content":"台席已酬调鼎志，"},{"Content":"磻溪还作钓鱼身。"},{"Content":"师臣首冠三旌贵，"},{"Content":"岁历行开九十新。"},{"Content":"愿过期颐跻上寿，"},{"Content":"飞觞四十有馀春。","Comments":[{"Content":"以上同上书卷七五","Type":"Text","Index":7}]}]}],"Count":1270,"PageNo":29,"PageSize":20}