{"Authors":{"Names":["晏殊"],"AuthorIds":[27290],"Dynasties":["Song"]},"ShiData":[{"Id":198061,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"立春日词"},"SubTitle":{"Content":"御阁"},"Clauses":[{"Content":"三素云中晓望时，"},{"Content":"上真軿盖保参差。","Comments":[{"Content":"四库本作绿","Type":"Text","Index":5}]},{"Content":"丹台自有长生籍，"},{"Content":"睿算方延亿万期。"}]},{"Id":198059,"GroupIndex":3,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"立春日词"},"SubTitle":{"Content":"御阁"},"Clauses":[{"Content":"青辂迎春习习来，"},{"Content":"天泉池上晓冰开。"},{"Content":"珠幡已报三阳候，"},{"Content":"柏叶将陈万寿杯。"}]},{"Id":198060,"GroupIndex":4,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"立春日词"},"SubTitle":{"Content":"御阁"},"Clauses":[{"Content":"䌽幡双燕祝春宜，"},{"Content":"献寿迎祥重此时。"},{"Content":"腊雪未消宫树碧，"},{"Content":"早莺声在万年枝。"}]},{"Id":198053,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"萧","Rank":0,"Title":{"Content":"立春日词"},"SubTitle":{"Content":"内廷"},"Clauses":[{"Content":"朱户未闻迎䌽燕，"},{"Content":"东郊先报舞云翘。"},{"Content":"姜任盛德符青史，"},{"Content":"金屋千春奉圣朝。"}]},{"Id":198056,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"立春日词"},"SubTitle":{"Content":"内廷"},"Clauses":[{"Content":"柳燧青青淑气和，"},{"Content":"冰纹初解縠文波。"},{"Content":"淑风殿里黄金屋，"},{"Content":"应候称觞万寿多。","Comments":[{"Content":"四库本作献","Type":"Text","Index":5}]}]},{"Id":198054,"GroupIndex":3,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"鱼","Rank":0,"Title":{"Content":"立春日词"},"SubTitle":{"Content":"内廷"},"Clauses":[{"Content":"才闻太昊行新令，"},{"Content":"更祝元君望景舆。"},{"Content":"白玉龟台资寿历，"},{"Content":