uthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"Title":{"Content":"正月十九日京邑上元收灯日"},"Clauses":[{"Content":"星逐绮罗沉曙色，","Comments":[{"Content":"《岁时广记》作晚","Type":"Text","Index":6}]},{"Content":"月随丝管下层台。","Comments":[{"Content":"《岁时广记》作歌舞","Type":"Text","Index":4}]},{"Content":"千蹄万毂无寻处，","Comments":[{"Content":"四库本作轮","Type":"Text","Index":2}]},{"Content":"祇似华胥一梦回。","Comments":[{"Content":"《岁时广记》作是","Type":"Text","Index":2}]}]},{"Id":198029,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"元","Rank":0,"Title":{"Content":"元夕"},"Clauses":[{"Content":"星粲宝灯连九市，"},{"Content":"水流香毂渡千门。"},{"Content":"姮娥似有随人意，"},{"Content":"柳际花前月半昏。"}]},{"Id":198048,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"次韵和参政陈给事寒食杜门感怀"},"Clauses":[{"Content":"班班疏雨欲晴天，"},{"Content":"回避春风入醉眠。"},{"Content":"新火未来丝阁静，"},{"Content":"砌苔窗树两依然。"}]},{"Id":198047,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"次韵和参政陈给事寒食杜门感怀"},"Clauses":[{"Content":"谢堂新句入清歌，"},{"Content":"雨箔风帘有燕过。"},{"Content":"未免芳辰叹心赏，"},{"Content":"始知犹患陆才多。","Comments":[{"Content":"以上同上书卷一三","Type":"Text","Index":7}]}]},{"Id":198024,"GroupIndex":1,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"侵","Rank":0,"Title":{"Content":"上巳赐宴琼林与二府诸公游水心憩于西轩","Comments":[{"Content":"四库本作浮","Type":"Text","Index":12}]},"Clauses":[{"Content":"三月杨花飞似雪，"},{"Content":"内园桂树绿成阴。"},{"Content":"何妨写尽凭高意，"},{"Content":"十步虹桥彻水心。"}]},{"Id":198023,"GroupIndex":2,"Dynasty":"北宋","Author":"晏殊","AuthorId":27290,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"歌","Rank":0,"Title":{"Content":"上巳赐宴琼林与二府诸公游水心憩于西轩","Comments":[{"Content":"四库本作浮","Type":"Text","Index":12}]},"Clauses":[{"Content":"咽云箫鼓传声沸，"},{"Content":"临水楼台倒影多。"},{"Content":"吟绕曲栏无限思，"},{"Content":"绪风迟日满烟波。"}]},