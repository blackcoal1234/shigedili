{"Authors":{"Names":["张继"],"AuthorIds":[15634],"Dynasties":["Tang"]},"ShiData":[{"Id":24259,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"庚","Rank":0,"Title":{"Content":"春夜皇甫冉宅欢宴","Comments":[{"Content":"一作对酒","Type":"Text","Index":8}]},"Clauses":[{"Content":"流落时相见，"},{"Content":"悲欢共此情。"},{"Content":"兴因尊酒洽，"},{"Content":"愁为故人轻。"},{"Content":"暗滴花茎露，","Comments":[{"Content":"一作垂","Type":"Text","Index":4}]},{"Content":"斜晖月过城。"},{"Content":"那知横吹笛，","Comments":[{"Content":"一作曲","Type":"Text","Index":5}]},{"Content":"江外作边声。"}]},{"Id":24253,"Allusions":[{"AllusionIndex":10147,"AllusionKey":"禹穴","SentenceIndex":2}],"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"会稽秋晚奉呈于太守"},"Clauses":[{"Content":"寂寂讼庭幽，","Comments":[{"Content":"一作寞","Type":"Text","Index":2}]},{"Content":"森森戟户秋。"},{"Content":"山光隐危堞，"},{"Content":"湖色上高楼。"},{"Content":"禹穴探书罢，","Comments":[{"Content":"禹穴","Type":"AllusionKey","Index":2}]},{"Content":"天台作赋游。"},{"Content":"云浮将越客，","Comments":[{"Content":"一作浮云","Type":"Text","Index":2}]},{"Content":"岁晚共淹留。"}]},{"Id":24268,"Allusions":[{"AllusionIndex":2363,"AllusionKey":"客星","SentenceIndex":1}],"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"题严陵钓台"},"Clauses":[{"Content":"旧隐人如在，"},{"Content":"清风亦似秋。"},{"Content":"客星沈夜壑，","Comments":[{"Content":"客星","Type":"AllusionKey","Index":2}]},{"Content":"钓石俯春流。"},{"Content":"鸟向乔枝聚，","Comments":[{"Content":"一作深","Type":"Text","Index":3}]},{"Content":"鱼依浅濑游。"},{"Content":"古来芳饵下，"},{"Content":"谁是不吞钩。"}]},{"Id":24265,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"清明日自西午桥至瓜岩村有怀"},"Clauses":[{"Content":"晚霁龙门雨，"},{"Content":"春生汝穴风。"},{"Content":"鸟啼官路静，"},{"Content":"花发毁垣空。"},{"Content":"鸣玉惭时辈，"},{"Content":"垂丝学老翁。"},{"Content":"旧游人不见，"},{"Content":"惆怅洛城东。"}]},{"Id":24260,"Allusions":[{"AllusionIndex":3205,"AllusionKey":"赋罢为郎","SentenceIndex":2},{"AllusionIndex":6976,"AllusionKey":"逐客","SentenceIndex":2}],"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"洛阳作","Comments":[{"Content":"一作初出徽安门","Type":"Text","Index":3}]},"Clauses":[{"Content":"洛阳天子县，"},{"Content":"金谷石崇乡。","Comments":[{"Content":"一作家","Type":"Text","Index":4}]},{"Content":"草色侵官道，"},{"Content":"花枝出苑墙。"},{"Content":"书成休逐客，","Comments":[{"Content":"逐客","Type":"AllusionKey","Index":5}]},{"Content":"赋罢遂为郎。"},{"Content":"贫贱非吾事，"},{"Content":"西游思自强。","Comments":[{"Content":"一作当","Type":"Text","Index":3}]}]},{"Id":24264,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"删","Rank":0,"Title":{"Content":"晚次淮阳"},"Clauses":[{"Content":"微凉风叶下，"},{"Content":"楚俗转清闲。"},{"Content":"候馆临秋水，"},{"Content":"郊扉掩暮山。"},{"Content":"月明潮渐近，","Comments":[{"Content":"一作满","Type":"Text","Index":5}]},{"Content":"露湿雁初还。"},{"Content":"浮客了无定，"},{"Content":"萍流淮海间。"}]},{"Id":24262,"Allusions":[{"AllusionIndex":1550,"AllusionKey":"乘传","SentenceIndex":1},{"AllusionIndex":5741,"AllusionKey":"谢公","SentenceIndex":2},{"AllusionIndex":9450,"AllusionKey":"徐子","SentenceIndex":2}],"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"东","Rank":0,"Title":{"Content":"送窦十九判官使江南"},"Clauses":[{"Content":"游客淹星纪，","Comments":[{"Content":"一作宦","Type":"Text","Index":2}]},{"Content":"裁诗鍊土风。"},{"Content":"今看乘传去，","Comments":[{"Content":"乘传","Type":"AllusionKey","Index":4}]},{"Content":"那与问津同。"},{"Content":"南郡迎徐子，","Comments":[{"Content":"一作过","Type":"Text","Index":3},{"Content":"一作稚","Type":"Text","Index":5},{"Content":"徐子","Type":"AllusionKey","Index":5}]},{"Content":"临川谒谢公。","Comments":[{"Content":"谢公","Type":"AllusionKey","Index":5}]},{"Content":"思归一惆怅，"},{"Content":"于越古亭中。"}]},{"Id":24256,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"江上送客游庐山"},"Clauses":[{"Content":"楚客自相送，"},{"Content":"沾裳春水边。"},{"Content":"晚来风信好，"},{"Content":"并发上江船。"},{"Content":"花映新林岸，"},{"Content":"云开瀑布泉。"},{"Content":"惬心应在此，"},{"Content":"佳句向谁传。"}]},{"Id":24267,"Allusions":[{"AllusionIndex":5415,"AllusionKey":"冯唐","SentenceIndex":1}],"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"酬张二十员外前国子博士窦叔向"},"Clauses":[{"Content":"故交日零落，"},{"Content":"心赏寄何人。"},{"Content":"幸与冯唐遇，","Comments":[{"Content":"冯唐","Type":"AllusionKey","Index":4}]},{"Content":"心同迹复亲。"},{"Content":"语言未终夕，"},{"Content":"离别又伤春。"},{"Content":"结念湓城下，"},{"Content":"闻猿诗兴新。"}]},{"Id":24272,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"WuLv","Rank":0,"Title":{"Content":"代书索镜"},"Clauses":[{"Content":"情亲留故镜，"},{"Content":"贱子感遗簪。"},{"Content":"汉月经时掩，"},{"Content":"胡尘与岁深。"},{"Content":"珠还仍向浦，"},{"Content":"鹊绕会归林。"},{"Content":"早晚清光至，"},{"Content":"窥予白发亲。"}],"Note":"按：（影印本《诗渊》第二册第一五三二页，所缺二字据《诗式》卷四补）。"},{"Id":24263,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"剡县法台寺灌顶坛诗"},"Clauses":[{"Content":"九灯传像法，"},{"Content":"七夜会龙华。"},{"Content":"月静金田广，"},{"Content":"幡摇银汉斜。"},{"Content":"香坛分地位，"},{"Content":"宝印辨根牙。"},{"Content":"试问因缘者，"},{"Content":"清溪无数沙。"}],"Note":"按：（《剡录》卷八）。"},{"Id":24254,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"会稽郡楼雪霁","Comments":[{"Content":"一作望雪","Type":"Text","Index":6}]},"Clauses":[{"Content":"江城昨夜雪如花，"},{"Content":"郢客登楼齐望华。","Comments":[{"Content":"一作望霁","Type":"Text","Index":6}]},{"Content":"夏禹坛前仍聚玉，","Comments":[{"Content":"一作大","Type":"Text","Index":1}]},{"Content":"西施浦上更飞沙。","Comments":[{"Content":"渚","Type":"Text","Index":3},{"Content":"飘纱","Type":"Text","Index":7}]},{"Content":"帘栊向晚寒风度，"},{"Content":"睥睨初晴落景斜。"},{"Content":"数处微明销不尽，"},{"Content":"湖山清映越人家。","Comments":[{"Content":"一作青","Type":"Text","Index":3}]}],"Comments":[{"Book":"《山满楼笺注唐诗七言律》","Content":"欲写今朝，先写昨夜，自是问水导源之法。三四承一，夏禹、西施，配耦甚奇。“坛前聚玉”，何等高华！“浦上飞纱”何等娟洁！如此咏雪，谢道蕴不当退避三舍乎？下半首俱承二，而五六止及“登楼”，七八才是“望霁华”也。“寒风度”、“落景斜”，不言雪霁，正妙在意在言外。“数处微明”是“消不尽”之处，“湖山青映”是已消尽之处，一起一伏，想其弄笔之姿，真不啻蝶影低回、花枝摇曳也。","IsComment":false,"FullPath":"《山满楼笺注唐诗七言律》"}]},{"Id":24266,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"游灵岩"},"Clauses":[{"Content":"灵岩有路入烟霞，"},{"Content":"台殿高低释子家。"},{"Content":"风满回廊飘坠叶，"},{"Content":"水流绝涧泛秋花。"},{"Content":"青松阅世风霜古，"},{"Content":"翠竹题诗岁月赊。"},{"Content":"谁谓无生真可学，"},{"Content":"山中亦自有年华。"}]},{"Id":24257,"Allusions":[{"AllusionIndex":2047,"AllusionKey":"大风曲","SentenceIndex":3}],"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"河间献王墓"},"Clauses":[{"Content":"汉家宗室独称贤，"},{"Content":"遗事闲中见旧编。"},{"Content":"偶过河间寻往迹，"},{"Content":"却怜荒冢带寒烟。"},{"Content":"频求千古书连帙，"},{"Content":"独对三雍策几篇。"},{"Content":"雅乐未兴人已逝，"},{"Content":"雄歌依旧大风传。"}]},{"Id":24261,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"秋日道中"},"Clauses":[{"Content":"齐鲁西风草树秋，"},{"Content":"川原高下过东州。"},{"Content":"道边白鹤来华表，"},{"Content":"陌上苍麟卧古丘。"},{"Content":"九曲半应非禹迹，"},{"Content":"三山何处是仙洲。"},{"Content":"径行俯仰成今古，"},{"Content":"却忆当年赋远游。"}]},{"Id":24255,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"歌","Rank":0,"FirstClauseRhyme":"歌","Title":{"Content":"华清宫"},"Clauses":[{"Content":"天宝承平奈乐何，"},{"Content":"华清宫殿郁嵯峨。"},{"Content":"朝元阁峻临秦岭，"},{"Content":"羯鼓楼高俯渭河。"},{"Content":"玉树长飘云外曲，"},{"Content":"霓裳闲舞月中歌。"},{"Content":"只今惟有温泉水，"},{"Content":"呜咽声中感慨多。"}]},{"Id":24252,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"元","Rank":0,"Title":{"Content":"感怀","Comments":[{"Content":"一作陆沈诗，题作《上礼部杨侍郎》。","Type":"Text","Index":2}]},"Clauses":[{"Content":"调与时人背，","Comments":[{"Content":"一作等","Type":"Text","Index":5}]},{"Content":"心将静者论。"},{"Content":"终年帝城里，","Comments":[{"Content":"一作在","Type":"Text","Index":3}]},{"Content":"不识五侯门。"}]},{"Id":24243,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"微","Rank":0,"Title":{"Content":"饮李十二宅"},"Clauses":[{"Content":"重门敞春夕，"},{"Content":"灯烛霭馀辉。"},{"Content":"醉我百尊酒，"},{"Content":"留连夜未归。"}]},{"Id":24250,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"先","Rank":0,"Title":{"Content":"望归舟"},"Clauses":[{"Content":"莫莫望归客，"},{"Content":"依依江上船。"},{"Content":"潮落犹有信，"},{"Content":"去楫未知旋。"}],"Note":"按：见《后村先生大全集》卷一七七《诗话续集》引李康成《玉台后集》"},{"Id":24244,"Dynasty":"中唐","Author":"张继","AuthorId":15634,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"枫桥夜泊","Comments":[{"Content":"一作夜泊枫江","Type":"Text","Index":4}]},"Clauses":[{"Content":"月落乌啼霜满天，"},{"Content":"江枫渔父对愁眠。","Comments":[{"Content":"一作火","Type":"Text","Index":4}]},{"Content":"姑苏城外寒山寺，"},{"Content":"夜半钟声到客船。"}],"Comments":[{"Book":"《庚溪诗话》","Content":"六一居士《诗话》谓：“句则佳矣，奈半夜非鸣钟时。”然余昔官姑苏，每三鼓尽，四鼓初，即诸寺钟皆鸣，想自唐时已然也。后观于鹄诗云：“定知别后家中伴，遥听缑山半夜钟。”白乐天云：“新秋松影下，半夜钟声后。”温庭筠云：“悠然旅榜频回首，无复松窗半夜钟。”则前人言之，不独张继也。","IsComment":false,"FullPath":"《庚溪诗话》"},{"Book":"《批点唐诗正声》","Content":"诗佳，效之恐伤气。","IsComment":false,"FullPath":"《批点唐诗正声》"},{"Book":"《诗薮》","Content":"张继“夜半钟声到客船”，谈者纷纷，皆为昔人愚弄。诗流借景立言，惟在声律之调，兴象之合，区区事实，彼岂暇计？无论夜半是非，即钟声闻否，未可知也。","IsComment":false,"FullPath":"《诗薮》"},{"Book":"《唐诗选脉会通评林》","Content":"周敬曰：目未交睫而斋钟声遽至，则客夜恨怀，何假名言？周珽曰：看似口头机锋，却作口头机锋看不得。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《唐风怀》","Content":"南村曰：此诗苍凉欲绝，或多辨夜半钟声有无，亦太拘矣。且释家名幽宾钟者，尝彻夜鸣之。如于鹄“遥听缑山半夜钟”，温庭筠“无复松窗半夜钟”之类，不止此也。","IsComment":false,"FullPath":"《唐风怀》"},{"Book":"《唐诗三集合编》","Content":"全篇诗意自“愁眠”上起，妙在不说出。","IsComment":false,"FullPath":"《唐诗三集合编》"},{"Book":"《唐诗摘钞》","Content":"三句承上起下，深而有力，从夜半无眠至晓，故怨钟声太早，搅人魂梦耳。语脉深深，只“对愁眠”三字略露意。夜半钟声或谓其误，或谓此地故有半夜钟，俱非解人。要之，诗人兴象所至，不可执着。必曰执着者，则“晨钟云外湿”、“钟声和白云”、“落叶满疏钟”皆不可通矣。","IsComment":false,"FullPath":"《唐诗摘钞》"},{"Book":"《笺注唐贤三体诗法》","Content":"何焯评：愁人自不能寐，却咎晓钟，诗人语妙，往往乃尔。","IsComment":false,"FullPath":"《笺注唐贤三体诗法》"},{"Book":"《碛砂唐诗》","Content":"“对愁眠”三字为全章关目。明逗一“愁”字，虚写竟夕光景，转辗反侧之意自见。","IsComment":false,"FullPath":"《碛砂唐诗》"},{"Book":"《唐诗别裁》","Content":"尘市喧阗之处，只闻钟声，荒凉寥寂可知。","IsComment":false,"FullPath":"《唐诗别裁》"},{"Book":"《古唐诗合解》","Content":"此诗装句法最妙，似连而断，似断而连。","IsComment":false,"FullPath":"《古唐诗合解》"},{"Book":"《大历诗略》","Content":"高亮殊特，青莲遗响。","IsComment":false,"FullPath":"《大历诗略》"},{"Book":"《网师园唐诗笺》","Content":"写野景夜景，即不必作离乱荒凉解，亦妙。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"《诗境浅说续编》","Content":"作者不过夜行记事之诗，随手写来，得自然趣味。诗非不佳，然唐人七绝佳作如林，独此诗流传日本，几妇稚皆习诵之。诗之传与不传，亦有幸有不幸耶！","IsComment":false,"FullPath":"《诗境浅说续编》"},{"Book":"《唐人绝句精华》","Content":"此诗所写枫桥泊舟一夜之景，诗中除所见所闻外，只一“愁”字透露心情。半夜钟声，非有旅愁者未必便能听到。后人纷纷辨夜半有无钟声，殊觉可笑。","IsComment":false,"FullPath":"《唐人绝句精华》"},{"Book":"唐诗鉴赏辞典","Content":"一个秋天的夜晚，诗人泊舟苏州城外的枫桥。江南水乡秋夜幽美的景色，吸引着这位怀着旅愁的客子，使他领略到一种情味隽永的诗意美，写下了这首意境清远的小诗。<br /><br />题为“夜泊”，实际上只写“夜半”时分的景象与感受。诗的首句，写了午夜时分三种有密切关连的景象：月落、乌啼、霜满天。上弦月升起得早，半夜时便已沉落下去，整个天宇只剩下一片灰蒙蒙的光影。树上的栖乌大约是因为月落前后光线明暗的变化，被惊醒后发出几声啼鸣。月落夜深，繁霜暗凝。在幽暗静谧的环境中，人对夜凉的感觉变得格外锐敏。“霜满天”的描写，并不符合自然景观的实际（霜华在地而不在天），却完全切合诗人的感受：深夜侵肌砭骨的寒意，从四面八方围向诗人夜泊的小舟，使他感到身外的茫茫夜气中正弥漫着满天霜华。整个一句，月落写所见，乌啼写所闻，霜满天写所感，层次分明地体现出一个先后承接的时间过程和感觉过程。而这一切，又都和谐地统一于水乡秋夜的幽寂清冷氛围和羁旅者的孤孑清寥感受中。从这里可以看出诗人运思的细密。<br /><br />诗的第二句接着描绘“枫桥夜泊”的特征景象和旅人的感受。在朦胧夜色中，江边的树只能看到一个模糊的轮廓，之所以径称“江枫”，也许是因枫桥这个地名引起的一种推想，或者是选用“江枫”这个意象给读者以秋色秋意和离情羁思的暗示。“湛湛江水兮上有枫，目极千里伤春心”，“青枫浦上不胜愁”，这些前人的诗句可以说明“江枫”这个词语中所沉积的感情内容和它给予人的联想。透过雾气茫茫的江面，可以看到星星点点的几处“渔火”，由于周围昏暗迷蒙背景的衬托，显得特别引人注目，动人遐想。“江枫”与“渔火”，一静一动，一暗一明，一江边，一江上，景物的配搭组合颇见用心。写到这里，才正面点出泊舟枫桥的旅人。“愁眠”，当指怀着旅愁躺在船上的旅人。“对愁眠”的“对”字包含了“伴”的意蕴，不过不象“伴”字外露。这里确有孤孑的旅人面对霜夜江枫渔火时萦绕的缕缕轻愁，但同时又隐含着对旅途幽美风物的新鲜感受。我们从那个仿佛很客观的“对”字当中，似乎可以感觉到舟中的旅人和舟外的景物之间一种无言的交融和契合。<br /><br />诗的前幅布景密度很大，十四个字写了六种景象，后幅却特别疏朗，两句诗只写了一件事：卧闻山寺夜钟。这是因为，诗人在枫桥夜泊中所得到的最鲜明深刻、最具诗意美的感觉印象，就是这寒山寺的夜半钟声。月落乌啼、霜天寒夜、江枫渔火、孤舟客子等景象，固然已从各方面显示出枫桥夜泊的特征，但还不足以尽传它的神韵。在暗夜中，人的听觉升居为对外界事物景象感受的首位。而静夜钟声，给予人的印象又特别强烈。这样，“夜半钟声”就不但衬托出了夜的静谧，而且揭示了夜的深永和清寥，而诗人卧听疏钟时的种种难以言传的感受也就尽在不言中了。<br /><br />这里似乎不能忽略“姑苏城外寒山寺”。寒山寺在枫桥西一里，初建于梁代，唐初诗僧寒山曾住于此，因而得名。枫桥的诗意美，有了这所古刹，便带上了历史文化的色泽，而显得更加丰富，动人遐想。因此，这寒山寺的“夜半钟声”也就仿佛回荡着历史的回声，渗透着宗教的情思，而给人以一种古雅庄严之感了。诗人之所以用一句诗来点明钟声的出处，看来不为无因。有了寒山寺的夜半钟声这一笔，“枫桥夜泊”之神韵才得到最完美的表现，这首诗便不再停留在单纯的枫桥秋夜景物画的水平上，而是创造出了情景交融的典型化艺术意境。夜半钟的风习，虽早在《南史》中即有记载，但把它写进诗里，成为诗歌意境的点眼，却是张继的创造。在张继同时或以后，虽也有不少诗人描写过夜半钟，却再也没有达到过张继的水平，更不用说借以创造出完整的艺术意境了。<br /><br />（刘学锴）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]}],"Count":37,"PageNo":0,"PageSize":20}