{"Authors":{"Names":["司马光"],"AuthorIds":[23461],"Dynasties":["Song"]},"ShiData":[{"Id":80784,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"乐"},"Clauses":[{"Content":"吾心自有乐，"},{"Content":"世俗岂能知。"},{"Content":"不及老莱子，"},{"Content":"多于荣启期。"},{"Content":"缊袍宽称体，"},{"Content":"脱粟饱随宜。"},{"Content":"乘兴辄独往，"},{"Content":"携筇任所之。"}]},{"Id":81530,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"柏梯寺"},"Clauses":[{"Content":"凿石开蹊峻，"},{"Content":"登崖置阁危。"},{"Content":"笑谈空谷应，"},{"Content":"步武白云随。"},{"Content":"众壑如翻浪，"},{"Content":"邻州若布棋。"},{"Content":"何当遂栖隐，"},{"Content":"身世两相遗。"}]},{"Id":81124,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"阳","Rank":0,"Title":{"Content":"重过华下"},"Clauses":[{"Content":"昔辞莲幕去，"},{"Content":"三十四炎凉。"},{"Content":"旧物三峰雪，"},{"Content":"新悲一镊霜。"},{"Content":"云低秦野阔，"},{"Content":"木落渭川长。"},{"Content":"欲问当时事，"},{"Content":"无人独叹伤。"}]},{"Id":80912,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"和君锡雪后招探春"},"Clauses":[{"Content":"繁霙回夜色，"},{"Content":"凌乱落春云。"},{"Content":"虚幌寒相袭，"},{"Content":"华堂静不闻。"},{"Content":"玉卮深可敌，"},{"Content":"银烛近微分。"},{"Content":"谁念牛衣客，"},{"Content":"穷经白发纷。"}]},{"Id":81102,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"文","Rank":0,"Title":{"Content":"送祖择之","Comments":[{"Content":"四库本作赠","Type":"Text","Index":1}]},"Clauses":[{"Content":"人生荣与辱，"},{"Content":"百变似浮云。"},{"Content":"自有穷通定，"},{"Content":"徒劳得丧分。"},{"Content":"消愁唯有酒，"},{"Content":"娱意莫如文。"},{"Content":"方寸常萧散，"},{"Content":"其馀何足云。"}]},{"Id":80915,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"和宋子才致仕后岁旦见赠"},"Clauses":[{"Content":"闲官逢献岁，"},{"Content":"拜揖亦纷然。"},{"Content":"须信家居日，"},{"Content":"方为已有年。"},{"Content":"劬劳中外遍，"},{"Content":"名迹始终全。"},{"Content":"伯玉空搔首，"},{"Content":"蹉跎愧在前。"}]},{"Id":80750,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"盐","Rank":0,"Title":{"Content":"上元书怀"},"Clauses":[{"Content":"老去春无味，"},{"Content":"年年觉病添。"},{"Content":"酒因脾积断，"},{"Content":"灯为目阿嫌。"},{"Content":"势位非其好，"},{"Content":"纷华已久厌。"},{"Content":"唯馀读书乐，"},{"Content":"暖日坐前檐。"}]},{"Id":81192,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"微","Rank":0,"Title":{"Content":"喜才元过洛小诗招饮"},"Clauses":[{"Content":"素发各垂领，"},{"Content":"旧交相见稀。"},{"Content":"不唯春物好，"},{"Content":"况是锦衣归。"},{"Content":"洛社冻醪熟，","Comments":[{"Content":"自注：《诗传》：春酒，冻醪也。","Type":"Text","Index":5}]},{"Content":"伊鲂丝鲙肥。","Comments":[{"Content":"自注：唐人谚曰洛鲤伊鲂，贵于牛羊。","Type":"Text","Index":5}]},{"Content":"南轩已洒扫，"},{"Content":"命驾不须违。"}]},{"Id":80806,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"仲庶同年兄自成都移长安以诗寄贺"},"Clauses":[{"Content":"蚕丛龟印解，"},{"Content":"鹑野隼旟新。"},{"Content":"借问锦江乐，"},{"Content":"何如兴庆春。"},{"Content":"骊歌遮去辙，"},{"Content":"竹马望行尘。"},{"Content":"惠政如膏雨，"},{"Content":"遥知彼此均。"}]},{"Id":80954,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"和景仁闻蝉"},"Clauses":[{"Content":"春林满岩绿，"},{"Content":"谁信已鸣蝉。"},{"Content":"叶上正多露，"},{"Content":"山中别有天。"},{"Content":"心闲宁感物，"},{"Content":"道合况忘年。"},{"Content":"坐听生秋思，"},{"Content":"何须膝上弦。"}]},{"Id":81214,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"游山呈景仁","Comments":[{"Content":"景仁年六十三致仕","Type":"Text","Index":5}]},"Clauses":[{"Content":"我禄多龚舍，","Comments":[{"Content":"自注：舍为吏不过六百石，辄自免去。","Type":"Text","Index":5}]},{"Content":"君年少孔戣。","Comments":[{"Content":"自注：戣七十致仕，韩愈留之。","Type":"Text","Index":5}]},{"Content":"道心闲始见，"},{"Content":"世路老方知。"},{"Content":"山水不相厌，"},{"Content":"风光难豫期。"},{"Content":"嬉游不可缓，"},{"Content":"花卉即离披。"}]},{"Id":81195,"GroupIndex":1,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"侵","Rank":0,"Title":{"Content":"喜雨三首呈景仁侍郎兼献大尹宣徽"},"Clauses":[{"Content":"累日增烦暑，"},{"Content":"通宵结薄阴。"},{"Content":"苍茫变风色，"},{"Content":"散漫作春霖。"},{"Content":"野店垂杨重，"},{"Content":"僧房绿筱深。"},{"Content":"疏慵尤得趣，"},{"Content":"闭户拥重衾。"}]},{"Id":81610,"GroupIndex":2,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"尤","Rank":0,"Title":{"Content":"喜雨三首呈景仁侍郎兼献大尹宣徽"},"Clauses":[{"Content":"漠漠春云合，"},{"Content":"爞爞旱气收。"},{"Content":"人心方有望，"},{"Content":"时雨不须求。"},{"Content":"岂独老农喜，"},{"Content":"仍令恶客留。"},{"Content":"洛城花未谢，"},{"Content":"作意更同游。"}]},{"Id":81196,"GroupIndex":3,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"喜雨三首呈景仁侍郎兼献大尹宣徽"},"Clauses":[{"Content":"麦田正尘坌，"},{"Content":"桑径忽滂沱。"},{"Content":"比屋起相告，"},{"Content":"荷锄行且歌。"},{"Content":"园林半扃锁，"},{"Content":"车马绝经过。"},{"Content":"大尹爱民物，"},{"Content":"何妨喜更多。"}]},{"Id":80826,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"豪","Rank":0,"Title":{"Content":"戏书宋子才止足堂"},"Clauses":[{"Content":"举世恋荣禄，"},{"Content":"夜行无乃劳。"},{"Content":"独君年未至，"},{"Content":"止足一何高。"},{"Content":"矮制乌纱帽，"},{"Content":"宽裁白氎袍。"},{"Content":"华榱坐终日，"},{"Content":"闲按紫檀槽。"}]},{"Id":81164,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"支","Rank":0,"Title":{"Content":"寄题宇文中允所居","Comments":[{"Content":"之邵","Type":"Text","Index":6}]},"Clauses":[{"Content":"孤宦行直道，"},{"Content":"栖栖良可悲。"},{"Content":"谁能拂衣去，"},{"Content":"不待挂冠期。"},{"Content":"经史乃吾友，"},{"Content":"云山为已知。"},{"Content":"世间青紫贵，"},{"Content":"尽付两佳儿。"}]},{"Id":80868,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"麻","Rank":0,"Title":{"Content":"还张景昱景昌秀才兄弟诗卷"},"Clauses":[{"Content":"韡韡新诗卷，"},{"Content":"青春映棣华。"},{"Content":"机云今继美，"},{"Content":"载协旧承家。"},{"Content":"幸托仁人里，"},{"Content":"时回长者车。"},{"Content":"白虹光乱眼，"},{"Content":"何敢议瑜瑕。"}]},{"Id":81241,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"真","Rank":0,"Title":{"Content":"酬张二十五秀才南园遣意","Comments":[{"Content":"景昱，字明叔","Type":"Text","Index":11}]},"Clauses":[{"Content":"花卉日相续，"},{"Content":"朝昏兴寄新。"},{"Content":"露荷香入坐，"},{"Content":"风竹净无尘。"},{"Content":"啸咏皆群从，"},{"Content":"喧嚣远四邻。"},{"Content":"须知轩冕客，"},{"Content":"富贵不关身。"}]},{"Id":81242,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"先","Rank":0,"Title":{"Content":"酬张三十秀才见赠","Comments":[{"Content":"景昌，字子京","Type":"Text","Index":8}]},"Clauses":[{"Content":"朴学居人后，"},{"Content":"清涂忝众先。"},{"Content":"瓠因无用弃，"},{"Content":"木为不才全。"},{"Content":"比得林泉趣，"},{"Content":"仍依邑里贤。"},{"Content":"自惭头半白，"},{"Content":"方解赋归田。"}]},{"Id":80733,"Dynasty":"北宋","Author":"司马光","AuthorId":23461,"Type":"律诗","TypeDetail":"WuLv","Rhyme":"歌","Rank":0,"Title":{"Content":"八月十五日夜陪留守宣徽登西楼值雨待月久不见"},"Clauses":[{"Content":"经岁侍佳节，"},{"Content":"无如阴霭何。"},{"Content":"果然时雨足，"},{"Content":"安用月华多。"},{"Content":"未免银缸进，","Comments":[{"Content":"陈本作见","Type":"Text","Index":2}]},{"Content":"空闻玉漏过。"},{"Content":"庾公兴不浅，"},{"Content":"久为驻鸣珂。"}]}],"Count":1270,"PageNo":18,"PageSize":20}