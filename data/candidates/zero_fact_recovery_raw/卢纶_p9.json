{"Authors":{"Names":["卢纶"],"AuthorIds":[13496],"Dynasties":["Tang"]},"ShiData":[{"Id":11273,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"支","Rank":0,"FirstClauseRhyme":"支","Title":{"Content":"送杨皞东归"},"Clauses":[{"Content":"登楼掩泣话归期，"},{"Content":"楚树荆云发远思。"},{"Content":"日里扬帆闻戍鼓，"},{"Content":"舟中酹酒见山祠。","Comments":[{"Content":"一作酌","Type":"Text","Index":3}]},{"Content":"西江风浪何时尽，"},{"Content":"北客音书欲寄谁。","Comments":[{"Content":"一作鱼","Type":"Text","Index":3}]},{"Content":"若说湓城杨司马，"},{"Content":"知君望国有新诗。"}]},{"Id":11191,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"至德中途中书事却寄李僩"},"Clauses":[{"Content":"乱离无处不伤情，"},{"Content":"况复看碑对古城。"},{"Content":"路绕寒山人独去，"},{"Content":"月临秋水雁空惊。"},{"Content":"颜衰重喜归乡国，"},{"Content":"身贱多惭问姓名。"},{"Content":"今日主人还共醉，"},{"Content":"应怜世故一儒生。"}],"Comments":[{"Book":"《东岩草堂评订唐诗鼓吹》","Content":"一先开一笔。二写入本题。三、四巧途中景物：“人独去”，言旅况之凄凉也；“雁空惊”，言时序之惊心也。五、六一“喜”一“惭”；惟衰颜而归，故喜；惟身残而归，故惭。即以起下“共醉”、“应怜”之意，写题中“寄”字耳。","IsComment":false,"FullPath":"《东岩草堂评订唐诗鼓吹》"},{"Book":"《唐诗镜》","Content":"四语凄清，六语哀怨，似带骚情。","IsComment":false,"FullPath":"《唐诗镜》"},{"Book":"《唐律偶评》","Content":"乱后独行，顾见其影，惊为寇盗追道。第四比喻工妙。","IsComment":false,"FullPath":"《唐律偶评》"},{"Book":"《一瓢诗话》","Content":"卢允言“颜衰重喜归乡国”，是自幸语；“身贱多惭问姓名”，是世故语；“估客昼眠知浪静”，是看他得意语；“舟人夜语觉潮生”，是唯我独醒语。余因向老无成，最怕人问尊庚几何，同此可怜。","IsComment":false,"FullPath":"《一瓢诗话》"},{"Book":"《网师园唐诗笺》","Content":"人人意中所有，独能道出（“身贱多惭”句下）。","IsComment":false,"FullPath":"《网师园唐诗笺》"},{"Book":"《小清华园诗谈》","Content":"以句求韵而尚妥适者《“路绕寒山”二句下）。","IsComment":false,"FullPath":"《小清华园诗谈》"}]},{"Id":11213,"Allusions":[{"AllusionIndex":196,"AllusionKey":"巴歌","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"阳","Title":{"Content":"奉和太常王卿酬中书李舍人中书寓直春夜对月见寄"},"Clauses":[{"Content":"露如轻雨月如霜，"},{"Content":"不见星河见雁行。"},{"Content":"虚晕入池波自泛，"},{"Content":"满轮当苑桂多香。"},{"Content":"春台几望黄龙阙，"},{"Content":"云路宁分白玉郎。"},{"Content":"是夜巴歌应金石，","Comments":[{"Content":"巴歌","Type":"AllusionKey","Index":4}]},{"Content":"岂殊萤影对清光。"}]},{"Id":11329,"Allusions":[{"AllusionIndex":1349,"AllusionKey":"相如","SentenceIndex":0},{"AllusionIndex":10951,"AllusionKey":"子虚","SentenceIndex":3}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"鱼","Rank":0,"FirstClauseRhyme":"鱼","Title":{"Content":"詶包佶郎中览拙卷后见寄"},"Clauses":[{"Content":"令伯支离晚读书，"},{"Content":"岂知词赋称相如。","Comments":[{"Content":"相如","Type":"AllusionKey","Index":7}]},{"Content":"枉逢花木无新思，","Comments":[{"Content":"一作狂","Type":"Text","Index":1}]},{"Content":"拙就溪潭损旧居。","Comments":[{"Content":"一作伏","Type":"Text","Index":2},{"Content":"一作源","Type":"Text","Index":4}]},{"Content":"禁路看山歌自缓，","Comments":[{"Content":"一作珂","Type":"Text","Index":5}]},{"Content":"云司玩月漏应疏。","Comments":[{"Content":"一作夜应初","Type":"Text","Index":7}]},{"Content":"沈忧敢望金门召，"},{"Content":"空愧巴歈并子虚。","Comments":[{"Content":"一作问","Type":"Text","Index":5},{"Content":"子虚","Type":"AllusionKey","Index":7}]}]},{"Id":11320,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"寒食"},"Clauses":[{"Content":"孤客飘飘岁载华，"},{"Content":"况逢寒食倍思家。"},{"Content":"莺啼远墅多从柳，"},{"Content":"人哭荒坟亦有花。"},{"Content":"浊水秦渠通渭急，"},{"Content":"黄埃京洛上原斜。"},{"Content":"驱车西近长安好，"},{"Content":"宫观参差半隐霞。"}]},{"Id":34907,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"律诗","TypeDetail":"QiLv","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"长安卧病秋夜言怀","Comments":[{"Content":"（一作长安疾后首秋夜即事）。（一作陈羽诗）","Type":"Text","Index":8}]},"Clauses":[{"Content":"九重门锁禁城秋，"},{"Content":"月过南宫渐映楼。"},{"Content":"紫陌夜深槐露滴，"},{"Content":"碧空云尽火星流。"},{"Content":"风清刻漏传三殿，"},{"Content":"甲第歌钟乐五侯。"},{"Content":"楚客病来乡思苦，"},{"Content":"寂寥灯下不胜愁。"}],"Comments":[{"Book":"《唐诗评选》","Content":"纶七言近体极富，乃全入怆父。世所艳称如“东风吹雨”者，亦蹇薄。唯此作差为条达耳。","IsComment":false,"FullPath":"《唐诗评选》"},{"Book":"《唐律偶评》","Content":"逼出末二句寂寞意（“清风刻漏”句下）。","IsComment":false,"FullPath":"《唐律偶评》"}]},{"Id":11149,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"詶李益端公夜宴见赠"},"Clauses":[{"Content":"戚戚一西东，"},{"Content":"十年今始同。"},{"Content":"可怜歌酒夜，"},{"Content":"相对两衰翁。"}],"Comments":[{"Book":"《容斋随笔》","Content":"李益、卢纶，皆唐大历十才子杰者。纶于益为内兄，尝秋夜同宿，益赠纶诗曰：“世故中年别，馀生此会同。却将愁与病，独对朗陵翁。”纶和曰：“戚戚一西东……”二诗虽绝句，读之使人凄然，皆奇作也。","IsComment":false,"FullPath":"《容斋随笔》"},{"Book":"《汇编唐诗十集》","Content":"唐云：情景惧惨。","IsComment":false,"FullPath":"《汇编唐诗十集》"},{"Book":"《唐风定》","Content":"悲凄含蓄。","IsComment":false,"FullPath":"《唐风定》"},{"Book":"《渌水亭杂识》","Content":"句律凄惋，如出一口（按指李、卢二人赠和之作）。","IsComment":false,"FullPath":"《渌水亭杂识》"}]},{"Id":11148,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"文","Rank":0,"FirstClauseRhyme":"文","Title":{"Content":"詶人失题"},"Clauses":[{"Content":"孤鸾将鹤群，"},{"Content":"晴日丽春云。","Comments":[{"Content":"一作唳","Type":"Text","Index":3}]},{"Content":"何幸晚飞者，"},{"Content":"清音长此闻。"}]},{"Id":11107,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"白发叹"},"Clauses":[{"Content":"发白晓梳头，"},{"Content":"女惊妻泪流。"},{"Content":"不知丝色后，"},{"Content":"堪得几回秋。"}]},{"Id":11118,"Classes":["軍旅 邊關"],"GroupIndex":1,"Allusions":[{"AllusionIndex":4872,"AllusionKey":"金仆姑","SentenceIndex":0},{"AllusionIndex":6228,"AllusionKey":"蝥弧","SentenceIndex":0}],"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"虞","Rank":0,"FirstClauseRhyme":"虞","Title":{"Content":"和张仆射塞下曲"},"Clauses":[{"Content":"鹫翎金仆姑，","Comments":[{"Content":"金仆姑","Type":"AllusionKey","Index":5}]},{"Content":"燕尾绣蝥弧。","Comments":[{"Content":"蝥弧","Type":"AllusionKey","Index":5}]},{"Content":"独立扬新令，"},{"Content":"千营共一呼。"}],"Comments":[{"Book":"《唐诗笺注》","Content":"此首写托装束气概。下二句与“宁为百夫长，胜作一书生”，意趣略同。","IsComment":false,"FullPath":"《唐诗笺注》"},{"Book":"《诗境浅说续编》","Content":"前二句言弓矢精良，见戎容之暨暨，三句状阃帅之尊严，四句状号令之整肃。寥寥二十宇中，有军容荼火之观。","IsComment":false,"FullPath":"《诗境浅说续编》"},{"Content":"蝥弧：旗名。<br/><br/>【简析】：<br/>《塞下曲》为汉乐府旧题，属《横吹曲辞》，内容多写边塞征战。原诗六首，是一个组诗，这里选了四首。通过写将军从发令出征、夜巡射虎、雪夜敌逃、庆功宴舞，表现了将士们英勇无畏的性格，气势雄阔。\n    ","IsComment":false}]},{"Id":11119,"Classes":["軍旅 邊關"],"GroupIndex":2,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"和张仆射塞下曲"},"Clauses":[{"Content":"林暗草惊风，"},{"Content":"将军夜引弓。"},{"Content":"平明寻白羽，"},{"Content":"没在石棱中。"}],"Comments":[{"Book":"《载酒园诗话又编》","Content":"《塞下曲》六首俱有盛唐之音，“平明寻白羽，没在石棱中”一章尤住。人顾称“欲将轻骑逐，大雷满弓刀”，虽亦矫健，然殊有逗遛之态，何如前语雄壮！","IsComment":false,"FullPath":"《载酒园诗话又编》"},{"Book":"《诗法易简录》","Content":"暗用李广事，言外有边防严肃、军咸远振之意。","IsComment":false,"FullPath":"《诗法易简录》"},{"Book":"《养一斋诗话》","Content":"诗之妙全以先天神运，不在后天迹象。……卢纶“林暗草惊风”，起句便全是黑夜射虎之神，不至“将军夜引弓”句矣。大抵能诗者无不知此妙，低手遇题，乃写实迹，故极求清脱，而终欠浑成。","IsComment":false,"FullPath":"《养一斋诗话》"},{"Book":"《诗境浅说续编》","Content":"此借用李广事，见边帅之勇健。李广射虎事，仅言射石没羽，纪载未详。夫弓力虽劲，没镞已属难能，而况没羽。作者特以“石棱”二字表出之，盖发矢适射两石棱缝之中，遂能没羽，于情事始合。卢允言乃读书得间也。","IsComment":false,"FullPath":"《诗境浅说续编》"},{"Book":"唐诗鉴赏辞典","Content":"卢纶《塞下曲》共六首一组，分别写发号施令、射猎破敌、奏凯庆功等等军营生活。因为是和张仆射之作（诗题一作“和张仆射塞下曲”），语多赞美之意。<br /><br />此为组诗的第二首，写将军夜猎，见林深处风吹草动，以为是虎，便弯弓猛射。天亮一看，箭竟然射进一块石头中去了。通过这一典型情节，表现了将军的勇武。诗的取材，出自《史记·李将军列传》。据载，汉代名将李广猿臂善射，在任右北平太守时，就有这样一次富于戏剧性的经历：“广出猎，见草中石，以为虎而射之。中石没镞，视之石也。因复更射之，终不能复入石矣。”<br /><br />首句写将军夜猎场所是幽暗的深林；当时天色已晚，一阵阵疾风刮来，草木为之纷披。这不但交代了具体的时间、地点，而且制造了一种气氛。右北平是多虎地区，深山密林是百兽之王的猛虎藏身之所，而虎又多在黄昏夜分出山，“林暗草惊风”，着一“惊”字，就不仅令人自然联想到其中有虎，呼之欲出，渲染出一片紧张异常的气氛，而且也暗示将军是何等警惕，为下文“引弓”作了铺垫。次句即续写射。但不言“射”而言“引弓”，这不仅是因为诗要押韵的缘故，而且因为“引”是“发”的准备动作，这样写能启示读者从中想象、体味将军临险是何等镇定自若，从容不迫。在一“惊”之后，将军随即搭箭开弓，动作敏捷有力而不仓皇，既具气势，而形象也益鲜明。<br /><br />后二句写“没石饮羽”的奇迹，把时间推迟到翌日清晨（“平明”），将军搜寻猎物，发现中箭者并非猛虎，而是蹲石，令人读之，始而惊异，既而嗟叹，原来箭杆尾部装置着白色羽毛的箭，竟“没在石棱中”，入石三分。这样写不仅更为曲折，有时间、场景变化，而且富于戏剧性。“石棱”为石的突起部分，箭头要钻入殊不可想象。神话般的夸张，为诗歌形象涂上一层浪漫色彩，读来特别尽情够味，只觉其妙，不以为非。<br /><br />清人吴乔曾形象地以米喻“意”，说文则炊米而为饭，诗则酿米而为酒（见《围炉诗话》），其言甚妙。因为诗须诉诸读者的情绪，一般比散文形象更集中，语言更凝炼，更注重意境的创造，从而更令人陶醉，也更象酒。在《史记》中才只是一段普普通通插叙的文字，一经诗人提炼加工，便升华出如此富于艺术魅力的小诗，不正有些象化稻粱为醇醪吗？<br /><br />（周啸天）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]},{"Id":44605,"Classes":["軍旅 邊關"],"GroupIndex":3,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"豪","Rank":0,"FirstClauseRhyme":"豪","Title":{"Content":"和张仆射塞下曲","Comments":[{"Content":"一作钱起诗","Type":"Text","Index":7}]},"Clauses":[{"Content":"月黑雁飞高，"},{"Content":"单于夜遁逃。"},{"Content":"欲将轻骑逐，"},{"Content":"大雪满弓刀。"}],"Comments":[{"Book":"《唐诗训解》","Content":"李攀龙曰：中唐音律柔弱，此独高健，得意之作。此见边威之壮，守备之整，而惜士卒寒苦也。允言语素卑弱，独此绝雄健，堪入盛唐乐府。","IsComment":false,"FullPath":"《唐诗训解》"},{"Book":"《唐诗选脉会通评林》","Content":"周敬曰：中唐高调，句句挺拔。顾璘曰：健。所谓古乐府者，此篇可参。","IsComment":false,"FullPath":"《唐诗选脉会通评林》"},{"Book":"《诗源辨体》","Content":"纶五言绝“月黑雁飞高”一首，气魄音调，中唐所无。","IsComment":false,"FullPath":"《诗源辨体》"},{"Book":"《唐风定》","Content":"音节最古，与《哥舒歌》相似。","IsComment":false,"FullPath":"《唐风定》"},{"Book":"《唐诗摘钞》","Content":"言虽雪满弓刀，犹欲轻骑相逐。一顺看，即似畏寒不出矣，相去何啻天渊！“夜”字一本作“远”，不惟句法不健，且惟乘月黑而夜遁，方见单于久在围中，若远而后逐，则无及矣。止争一字，语意悬远若此，甚矣，书贵善本也！","IsComment":false,"FullPath":"《唐诗摘钞》"},{"Book":"《诗法易简录》","Content":"上二句言匈奴畏威远遁。下二句不肯邀开边之功，而托言大雪，便觉委婉，而边地之苦亦自见。","IsComment":false,"FullPath":"《诗法易简录》"},{"Book":"《诗境浅说续编》","Content":"前二首仅闲叙军中之事，此首始及战事。言兵威所震，强虏远逃，月黑雁飞，写足昏夜潜遁之状。追奔逐北者，宜发轻骑蹑之，而弓刀雪满，未得穷追，见漠北之严寒，防边之不易也。","IsComment":false,"FullPath":"《诗境浅说续编》"},{"Book":"《诗式》","Content":"首句对景兴起。次句入正意。三句追进一层，承次句意。四句确是逐时情景，“雪”字映上“月”字。[品]壮健。","IsComment":false,"FullPath":"《诗式》"},{"Book":"唐诗鉴赏辞典","Content":"《塞下曲》组诗共六首，这是第三首。卢纶虽为中唐诗人，其边塞诗却依旧是盛唐的气象，雄壮豪放，字里行间充溢着英雄气概，读后令人振奋。<br /><br />一二句“月黑雁飞高，单于夜遁逃”，写敌军的溃退。“月黑”，无光也。“雁飞高”，无声也。趁着这样一个漆黑的阒寂的夜晚，敌人悄悄地逃跑了。单于，是古时匈奴最高统治者，这里代指入侵者的最高统帅。夜遁逃，可见他们已经全线崩溃。<br /><br />尽管有夜色掩护，敌人的行动还是被我军察觉了。三、四句“欲将轻骑逐，大雪满弓刀”，写我军准备追击的情形，表现了将士们威武的气概。试想，一支骑兵列队欲出，刹那间弓刀上就落满了大雪，这是一个多么扣人心弦的场面！<br /><br />从这首诗看来，卢纶是很善于捕捉形象、捕捉时机的。他不仅能抓住具有典型意义的形象，而且能把它放到最富有艺术效果的时刻加以表现。诗人不写军队如何出击，也不告诉你追上敌人没有，他只描绘一个准备追击的场面，就把当时的气氛情绪有力地烘托出来了。“欲将轻骑逐，大雪满弓刀”，这并不是战斗的高潮，而是迫近高潮的时刻。这个时刻，犹如箭在弦上，将发未发，最有吸引人的力量。你也许觉得不满足，因为没有把结果交代出来。但惟其如此，才更富有启发性，更能引逗读者的联想和想象，这叫言有尽而意无穷。神龙见首不见尾，并不是没有尾，那尾在云中，若隐若现，更富有意趣和魅力。<br /><br />（袁行霈）","IsComment":false,"FullPath":"唐诗鉴赏辞典"}]},{"Id":11120,"Classes":["軍旅 邊關"],"GroupIndex":4,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"先","Rank":0,"FirstClauseRhyme":"先","Title":{"Content":"和张仆射塞下曲"},"Clauses":[{"Content":"野幕敞琼筵，"},{"Content":"羌戎贺劳旋。"},{"Content":"醉和金甲舞，"},{"Content":"雷鼓动山川。"}],"Comments":[{"Book":"《诗境浅说续编》","Content":"边氛既扫，乃宏开野幕，飨士策勋。醉馀起舞，金甲犹擐，击鼓其镗，雷鸣山应。玉关生入，不须“醉卧沙场”矣。唐人善边塞诗者，推岑嘉州。卢之四诗，音词壮健，可与抗手。宜其在大历十子中，与韩翃、钱起齐名也。","IsComment":false,"FullPath":"《诗境浅说续编》"},{"Book":"唐诗汇评","Section":"总评","IsComment":false,"FullPath":"唐诗汇评·总评"},{"Book":"《唐人万首绝句选评》","Content":"允言《塞下曲》，意警气足，格高语健，读之情景历历在目，中唐五言之高调，此题之名作也。","IsComment":false,"FullPath":"《唐人万首绝句选评》"},{"Book":"《唐人绝句精华》","Content":"此题共六首，乃和张仆射之作，故诗语皆有颂美之意，与他作描写边塞苦寒者不同。","IsComment":false,"FullPath":"《唐人绝句精华》"}]},{"Id":11121,"Classes":["軍旅 邊關"],"GroupIndex":5,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"蒸","Rank":0,"FirstClauseRhyme":"蒸","Title":{"Content":"和张仆射塞下曲"},"Clauses":[{"Content":"调箭又呼鹰，"},{"Content":"俱闻出世能。","Comments":[{"Content":"一作百中","Type":"Text","Index":4}]},{"Content":"奔狐将迸雉，","Comments":[{"Content":"一作猿","Type":"Text","Index":2}]},{"Content":"扫尽古丘陵。"}]},{"Id":11122,"Classes":["軍旅 邊關"],"GroupIndex":6,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"庚","Rank":0,"Title":{"Content":"和张仆射塞下曲"},"Clauses":[{"Content":"亭亭七叶贵，"},{"Content":"荡荡一隅清。"},{"Content":"他日题麟阁，"},{"Content":"唯应独不名。","Comments":[{"Content":"一作谁知独有名","Type":"Text","Index":5}]}]},{"Id":11158,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"微","Rank":0,"Title":{"Content":"赠李果毅"},"Clauses":[{"Content":"向日磨金镞，"},{"Content":"当风著锦衣。"},{"Content":"上城邀贼语，"},{"Content":"走马截雕飞。"}],"Comments":[{"Book":"《精选评注五朝诗学津梁》","Content":"四句皆对偶，且皆褒奖之辞，无深意。","IsComment":false,"FullPath":"《精选评注五朝诗学津梁》"}]},{"Id":11110,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"真","Rank":0,"Title":{"Content":"同钱郎中晚春过慈恩寺"},"Clauses":[{"Content":"不见僧中旧，"},{"Content":"仍逢雨后春。"},{"Content":"惜花将爱寺，"},{"Content":"俱是白头人。"}]},{"Id":11090,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"与畅当夜泛秋潭"},"Clauses":[{"Content":"萤火飏莲丛，"},{"Content":"水凉多夜风。"},{"Content":"离人将落叶，"},{"Content":"俱在一船中。"}]},{"Id":11133,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"麻","Rank":0,"FirstClauseRhyme":"麻","Title":{"Content":"春游东潭"},"Clauses":[{"Content":"移舟试望家，"},{"Content":"漾漾似天涯。"},{"Content":"日暮满潭雪，"},{"Content":"白鸥和柳花。"}]},{"Id":11156,"Dynasty":"中唐","Author":"卢纶","AuthorId":13496,"Type":"绝句","TypeDetail":"WuJue","Rhyme":"支","Rank":0,"Title":{"Content":"赠别司空曙","Comments":[{"Content":"（一作别卢纶）。（一作司空曙诗）","Type":"Text","Index":5}]},"Clauses":[{"Content":"有月曾同赏，"},{"Content":"无秋不共悲。"},{"Content":"如何与君别，"},{"Content":"又是菊花时。"}]}],"Count":337,"PageNo":9,"PageSize":20}