{"Authors":{"Names":["朱淑真"],"AuthorIds":[26895],"Dynasties":["Song"]},"ShiData":[{"Id":536007,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"晚春有感"},"Clauses":[{"Content":"却扇羞花春已空，"},{"Content":"扫红吹白任颠风。"},{"Content":"断肠芳草连天碧，"},{"Content":"春不归来梦不通。"}]},{"Id":96231,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"恨春五首"},"Clauses":[{"Content":"樱桃初荐杏梅酸，","Comments":[{"Content":"原作花，据《后村千家诗》卷一改","Type":"Text","Index":2}]},{"Content":"槐嫩风高麦秀寒。"},{"Content":"惆怅东君太情薄，"},{"Content":"挽留时暂也应难。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】 [题] 《千家诗选》作[春暮]。[槐嫩]《宋元百家诗》作[燕子]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96245,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"微","Rank":0,"FirstClauseRhyme":"微","Title":{"Content":"春归五首","Comments":[{"Content":"原注：元本阙，借黄复翁处钞本校补之，以下三首同。","Type":"Text","Index":4}]},"Clauses":[{"Content":"片片飞花弄晚晖，"},{"Content":"杜鹃啼血诉春归。"},{"Content":"凭谁碍断春归路，"},{"Content":"更且留连伴翠微。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】此五首原无，据艺芸书舍本补。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96246,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"微","Rank":0,"Title":{"Content":"春归五首","Comments":[{"Content":"原注：元本阙，借黄复翁处钞本校补之，以下三首同。","Type":"Text","Index":4}]},"Clauses":[{"Content":"满地落花初过雨，"},{"Content":"一声啼鸟已春归。"},{"Content":"午窗梦觉情怀恶，"},{"Content":"风絮欺人故著衣。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】此五首原无，据艺芸书舍本补。[过风]《武林》本作[雨过]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96247,"GroupIndex":3,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"冬","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"春归五首","Comments":[{"Content":"原注：元本阙，借黄复翁处钞本校补之，以下三首同。","Type":"Text","Index":4}]},"Clauses":[{"Content":"狼藉花因昨夜风，"},{"Content":"春归了不见行踪。"},{"Content":"孤吟茕坐清如水，"},{"Content":"忆得轻离十二峰。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】此五首原无，据艺芸书舍本补。[茕]铁琴铜剑楼钞本作[独]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96248,"GroupIndex":4,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"春归五首","Comments":[{"Content":"原注：元本阙，借黄复翁处钞本校补之，以下三首同。","Type":"Text","Index":4}]},"Clauses":[{"Content":"一点芳心冷若灰，"},{"Content":"寂无梦想惹尘埃。"},{"Content":"东君总领莺花处，"},{"Content":"浪蝶狂蜂不自来。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】此五首原无，据艺芸书舍本补。[处]延客堂钞本作[去]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96249,"GroupIndex":5,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"真","Rank":0,"FirstClauseRhyme":"侵","Title":{"Content":"春归五首","Comments":[{"Content":"原注：元本阙，借黄复翁处钞本校补之，以下三首同。","Type":"Text","Index":4}]},"Clauses":[{"Content":"平畴交绿蔼成阴，"},{"Content":"梅豆初肥酒味新。"},{"Content":"门外好禽情分熟，"},{"Content":"不知春去尚啼春。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】此五首原无，据艺芸书舍本补。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":536011,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"惜春"},"Clauses":[{"Content":"连理枝头花正开，"},{"Content":"妒花风雨苦相催。"},{"Content":"愿教青帝长为主，"},{"Content":"莫遣纷纷落翠苔。"}]},{"Id":96243,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"冬","Title":{"Content":"春日闲坐"},"Clauses":[{"Content":"社燕归来春正浓，"},{"Content":"摧花雨倩一番风。"},{"Content":"倚楼闲省经由处，"},{"Content":"月馆云藏望眼中。"}],"Comments":[{"Book":"朱淑真集","Content":"【校】[雨倩]铁琴　剑楼钞本作[细雨]。[经由] 《名媛诗归》作[经此]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96251,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"支","Rank":0,"Title":{"Content":"春夜"},"Clauses":[{"Content":"半檐斜月人归后，"},{"Content":"一枕清风梦破时。"},{"Content":"无奈梨花春寂寂，"},{"Content":"杜鹃声里祇颦眉。"}]},{"Id":536014,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"元夜遇雨"},"Clauses":[{"Content":"烟火笙歌是处休，"},{"Content":"沉沉春雨暗皇州。"},{"Content":"危楼十二阑干曲，"},{"Content":"一曲阑干一曲愁。"}]},{"Id":96252,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"雨中写怀"},"Clauses":[{"Content":"东风吹雨苦生寒，"},{"Content":"悭涩春光不放宽。"},{"Content":"万紫千红浑未见，"},{"Content":"闲愁先占许多般。"}],"Comments":[{"Book":"朱淑真集","Content":"[朱淑真集]题作[雨中写怀]。<br />【校】[题]《千家诗选》作[春雨]。[万]刘履芬校辑钞本注　[万]一作[百]。[占许]铁琴　剑楼钞本作[许占]。","IsComment":false,"FullPath":"朱淑真集"}]},{"Id":96228,"GroupIndex":1,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"寒","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"夜雨二首"},"Clauses":[{"Content":"抱影无眠坐夜阑，"},{"Content":"窗风战雨下琅玕。"},{"Content":"我将好况供陪梦，"},{"Content":"只恐灯花不耐寒。"}]},{"Id":536015,"GroupIndex":2,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"12","Rank":0,"FirstClauseRhyme":"寒","Title":{"Content":"夜雨二首"},"Clauses":[{"Content":"明朝春在雨中看，"},{"Content":"心碎檐声点滴间。"},{"Content":"踪有酒能消熟恨，"},{"Content":"宁无花解怨生寒。"}]},{"Id":536016,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"庚","Rank":0,"FirstClauseRhyme":"庚","Title":{"Content":"阻雨"},"Clauses":[{"Content":"几度寻芳已不成，"},{"Content":"又还寂寞过清明。"},{"Content":"悭风涩雨颠迷甚，"},{"Content":"十日春无一日晴。"}]},{"Id":96224,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"阳","Rank":0,"FirstClauseRhyme":"江","Title":{"Content":"清昼"},"Clauses":[{"Content":"竹摇清影罩幽窗，"},{"Content":"两两时禽噪夕阳。"},{"Content":"谢却海棠飞尽絮，"},{"Content":"困人天气日初长。"}],"Comments":[{"Content":"（1）即景：眼前的景物。此处以眼前景物为题材作的诗。（2）时禽：燕子之类的候鸟。<br /><br />[朱淑真集]  <br /> (《宋诗精华》　《清昼》，此诗题据张璋　黄畲校注《朱淑真集》。《宋诗纪事》　《宋诗抄补》均作《初夏》。谢枋得《千家诗》作《即景》)<br />(《宋诗精华》广西师范大学出版社 1996年1月第一版)","IsComment":false}]},{"Id":536018,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"尤","Rank":0,"FirstClauseRhyme":"尤","Title":{"Content":"看花"},"Clauses":[{"Content":"欲向花边遣旧愁，"},{"Content":"对花无语祇成羞。"},{"Content":"春光踪好须归去，"},{"Content":"谁伴幽人著意留。"}]},{"Id":536019,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"Title":{"Content":"移花"},"Clauses":[{"Content":"自移红药绕阑栽，"},{"Content":"粉腻香娇逐旋开。","Comments":[{"Content":"《名媛诗归》卷二○作渐","Type":"Text","Index":6}]},{"Content":"且与幽人充近侍，"},{"Content":"莫教风雨苦相催。"}]},{"Id":536020,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"东","Rank":0,"FirstClauseRhyme":"东","Title":{"Content":"小桃叶去偶生数花"},"Clauses":[{"Content":"庭外缃桃一萼红，"},{"Content":"多情特地振春风。"},{"Content":"仙源已露真消息，"},{"Content":"迥作新花发旧丛。"}]},{"Id":96273,"Dynasty":"宋","Author":"朱淑真","AuthorId":26895,"Type":"绝句","TypeDetail":"QiJue","Rhyme":"灰","Rank":0,"FirstClauseRhyme":"灰","Title":{"Content":"窗西桃花盛开"},"Clauses":[{"Content":"尽是刘郎手自栽，"},{"Content":"刘郎去后几番开。"},{"Content":"东君有意能相顾，"},{"Content":"蛱蝶无情更不来。"}],"Comments":[{"Book":"朱淑真集","Content":"[窗西]　《朱淑真集》目录及正文均题作[窗西桃花盛开]，而前言p.3中题作[西窗桃花盛开]，《古典诗词名篇欣赏》　《断草芳草远--朱淑真传》作[西窗]。<br />【校】《千家诗》题作[桃花]。[更不]《千家诗》作[不见]。","IsComment":false,"FullPath":"朱淑真集"}]}],"Count":367,"PageNo":6,"PageSize":20}