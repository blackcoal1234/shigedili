    "韩愈": {
      "source_url": "https://cnkgraph.com/Map/PoetLife?author=%E9%9F%A9%E6%84%88",
      "life_summary": "唐宋文学编年地图 韩愈 年历 地图 人物 专题 唐宋文学编年地图 汉魏六朝文学编年地图 丝绸之路诗词地图",
      "timeline": [
        {
          "year": "768",
          "text": "西安（长安）（768年 - 769年，1-2岁）"
        },
        {
          "year": "768",
          "text": "768年，本年，生于长安。乳抱中，失母。父韩仲卿任秘书郎。"
        },
        {
          "year": "770",
          "text": "孟州（河阳）（770年 - 773年，3-6岁）"
        },
        {
          "year": "770",
          "text": "770年，本年，父亡。由长兄韩会、长嫂郑氏、乳母李氏抚养。韩会携韩愈在故里丁忧"
        },
        {
          "year": "774",
          "text": "西安（长安）（774年 - 776年，7-9岁）"
        },
        {
          "year": "774",
          "text": "774年，本年，韩会赴长安任起居舍人。随兄入长安。已启蒙读书，较聪明"
        },
        {
          "year": "777",
          "text": "韶关（韶州）（777年4月 - 779年，10-12岁）"
        },
        {
          "year": "777",
          "text": "777年4月，四月，长兄韩会由起居舍人贬官岭南任韶州刺史。韩愈随其全家迁往"
        },
        {
          "year": "780",
          "text": "孟州（河阳）（780年 - 783年，13-16岁）"
        },
        {
          "year": "780",
          "text": "780年，本年，居乡。开始学写文章，初有名声"
        },
        {
          "year": "784",
          "text": "宣城（784年 - 786年，17-19岁，作品：1）"
        },
        {
          "year": "784",
          "text": "784年，因中原朱泚、李希烈等兵乱，本年，随家迁往江南宣城庄园避难"
        },
        {
          "year": "786",
          "text": "孟州（河阳）（786年，19岁）"
        },
        {
          "year": "786",
          "text": "786年，冬，由宣城前往长安途中，曾回河阳故居"
        },
        {
          "year": "787",
          "text": "永济（永乐）（787年，20岁，作品：1）"
        },
        {
          "year": "787",
          "text": "787年，年初，赴长安应试，沿黄河西上，途经河中，过中条山，有诗"
        },
        {
          "year": "787",
          "text": "西安（长安）（787年 - 789年，20-22岁，作品：7）"
        },
        {
          "year": "787",
          "text": "787年，年初，抵达长安，参加进士考试，落第"
        },
        {
          "year": "790",
          "text": "宣城（790年，23岁）"
        },
        {
          "year": "790",
          "text": "790年，年初，在宣城。疑在此时与卢氏结婚"
        },
        {
          "year": "790",
          "text": "滑县（白马）（790年，23岁，作品：1）"
        },
        {
          "year": "790",
          "text": "790年，本年，由宣城返长安途经滑州，上书滑州刺史贾耽以自荐"
        },
        {
          "year": "791",
          "text": "西安（长安）（791年 - 793年，24-26岁，作品：7）"
        },
        {
          "year": "791",
          "text": "791年，春，在长安第三次参加进士考试，仍未第"
        },
        {
          "year": "792",
          "text": "792年，本年，在长安。讥刺谏议大夫阳城，有文，作品：《争臣论》"
        },
        {
          "year": "793",
          "text": "岐山（793年，26岁，作品：2）"
        },
        {
          "year": "793",
          "text": "793年，夏，至凤翔谒节度使邢君牙，过岐山下，有诗"
        },
        {
          "year": "793",
          "text": "凤翔（雍县）（793年，26岁，作品：3）"
        },
        {
          "year": "793",
          "text": "793年，夏，曾游凤翔，作寄内诗"
        },
        {
          "year": "793",
          "text": "西安（长安）（793年 - 794年，26-27岁，作品：7）"
        },
        {
          "year": "793",
          "text": "793年，本年，在长安。应博学鸿词科，有论议之文"
        },
        {
          "year": "794",
          "text": "孟州（河阳）（794年4月，27岁，作品：1）"
        },
        {
          "year": "794",
          "text": "794年4月，四月，应博学宏词科落选后，东归河阳扫墓，竟遇老成扶嫂郑氏灵柩来归，作祭文。服小功后，返长安"
        },
        {
          "year": "794",
          "text": "郑州（794年9月，27岁，作品：1）"
        },
        {
          "year": "794",
          "text": "794年9月，九月，或曾去郑州。偶逢早慧张童子，作文赠之"
        },
        {
          "year": "794",
          "text": "西安（长安）（794年 - 795年5月2日，27-28岁，作品：11）"
        },
        {
          "year": "794",
          "text": "794年，在长安。李观有砚一方，使用多年颇有感情，因误坠地损毁，以木匣盛之埋于房后，韩愈感此为之作铭"
        },
        {
          "year": "795",
          "text": "795年1月27日，一月，在长安。三次应博学宏词皆未举，韩愈先后三次向时相赵憬、贾耽、卢迈等上书，自鸣不平。此为第一书，作品：《上宰相书》"
        },
        {
          "year": "795",
          "text": "潼关（华阴）（795年5月7日，28岁，作品：1）"
        },
        {
          "year": "795",
          "text": "795年5月7日，五月七日，出潼关，息于河之阴，见有笼白乌、白鸲鹆而西者，有感而作赋，抒发不遇时之叹，兼批判统治者喜好珍禽异兽之奢靡习气"
        },
        {
          "year": "795",
          "text": "孟州（河阳）（795年5月 - 795年，28岁，作品：1）"
        },
        {
          "year": "795",
          "text": "795年5月，五月，由长安东归洛阳、河阳，闲居"
        },
        {
          "year": "795",
          "text": "偃师（795年9月11日，28岁，作品：1）"
        },
        {
          "year": "795",
          "text": "795年9月11日，九月十一日，自河阳去洛阳。路过洛阳东三十里偃师尸乡田横墓，作文吊田横以寄慨"
        },
        {
          "year": "795",
          "text": "洛阳（795年 - 796年，28-29岁）"
        },
        {
          "year": "795",
          "text": "795年，马燧本年八月卒。得消息后，哭马燧于客舍"
        },
        {
          "year": "796",
          "text": "开封（汴州）（796年7月 - 799年2月6日，29-32岁，作品：31）"
        },
        {
          "year": "796",
          "text": "796年7月，七月，入汴州董晋幕，未任职"
        },
        {
          "year": "799",
          "text": "偃师（799年2月，32岁，作品：2）"
        },
        {
          "year": "799",
          "text": "799年2月，二月中旬初某夜，护丧董晋灵柩西归河中安葬，行至偃师西，闻汴州兵乱，家人已脱险赴徐州。有诗"
        },
        {
          "year": "799",
          "text": "孟津（洛阳）（799年2月，32岁）"
        },
        {
          "year": "799",
          "text": "799年2月，二月中旬，知汴州乱消息后，次日晨由偃师护送董晋丧车至孟津渡河，之后立即骑马东返"
        },
        {
          "year": "799",
          "text": "孟州（河阳）（799年2月，32岁，作品：1）"
        },
        {
          "year": "799",
          "text": "799年2月，二月中旬，由孟津急速东返，当晚入河阳军门，受河阳三城节度使李元款待"
        },
        {
          "year": "799",
          "text": "巩义（汜水）（799年2月，32岁）"
        },
        {
          "year": "799",
          "text": "799年2月，二月中旬，由河阳立即东往徐州，当日黄昏时抵达汜水，夜渡黄河"
        },
        {
          "year": "799",
          "text": "新郑（799年2月20日，32岁）"
        },
        {
          "year": "799",
          "text": "799年2月20日，二月二十日，途经时门（今新郑）时休息"
        },
        {
          "year": "799",
          "text": "宿州（符离）（799年2月30日 - 799年，32岁，作品：4）"
        },
        {
          "year": "799",
          "text": "799年2月30日，二月底，十日内奔行千里，抵达徐州南睢水岸边的符离"
        },
        {
          "year": "799",
          "text": "徐州（彭城）（799年 - 799年12月，32岁，作品：13）"
        },
        {
          "year": "799",
          "text": "799年，本年，在徐州。李翱来信，回复之，有文"
        },
        {
          "year": "799",
          "text": "西安（长安）（799年12月 - 800年1月，32-33岁，作品：1）"
        },
        {
          "year": "799",
          "text": "799年12月，冬，奉张建封之命赴京朝正，时欧阳詹为国子监四门助教，欲推荐韩愈而未果，韩愈作诗赠之以寄意"
        },
        {
          "year": "800",
          "text": "徐州（彭城）（800年2月 - 800年，33岁，作品：4）"
        },
        {
          "year": "800",
          "text": "800年2月，二月，自京朝正归徐州，伤时忧乱，有诗"
        },
        {
          "year": "800",
          "text": "邳州（下邳）（800年5月14日，33岁，作品：1）"
        },
        {
          "year": "800",
          "text": "800年5月14日，五月，离张建封幕与李翱、王涯、侯喜同游，在下邳偶与旧识李平相遇，同游睢阳等地，作文题壁留念。次日徐州即发生兵变，韩愈再次侥幸逃脱"
        },
        {
          "year": "800",
          "text": "洛阳（800年，33岁，作品：5）"
        },
        {
          "year": "800",
          "text": "800年，本年五月后，去徐州、居洛阳，无职事而闲居"
        },
        {
          "year": "800",
          "text": "西安（长安）（800年 - 801年，33-34岁，作品：1）"
        },
        {
          "year": "800",
          "text": "800年，冬，由洛阳赴长安调选"
        },
        {
          "year": "801",
          "text": "洛阳（801年3月 - 801年，34岁，作品：14）"
        },
        {
          "year": "801",
          "text": "801年3月，三月，因调选未成，由长安返洛阳"
        },
        {
          "year": "801",
          "text": "801年，本年，在洛阳。送李愿归盘谷，作序文。盘谷在怀州太行山，属孟州济源县，作品：《送李愿归盘谷序》"
        },
        {
          "year": "801",
          "text": "西安（长安）（801年10月 - 802年，34-35岁，作品：8）"
        },
        {
          "year": "801",
